[{"data":1,"prerenderedAt":189},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":76,"blog-post-slug-blog_4af9831b010008rk":93,"surround-blog_4af9831b010008rk":178},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":38,"meta":50,"navLinks":51,"perPage":16,"prevNextIsExcludeDate":71,"site_description":72,"site_name":73,"stem":74,"__hash__":75},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,26,32],{"text":23},"粉丝自制非官方站点｜素材版权归原权利人所有",{"text":25},"仅兴趣交流、无商业用途｜如有侵权请联系删除",{"text":27,"link":28},"查看",{"href":29,"text":30,"fa_class":31},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":33,"link":34},"如有任何疑问，欢迎",{"href":35,"text":36,"fa_class":37},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[39,42,45,47],{"href":40,"text":41},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":43,"text":44},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":46},"新浪微博备份(2009-2026)",{"href":48,"text":49},"https:\u002F\u002Fmzt999.github.io\u002Fportfolio-chensicheng1978","幕后作品集展示(2012-2026)",{},[52,57,61,65,69],{"path":53,"title":54,"target":55,"fa_class":56},"\u002F","博客首页","internal","fa-home",{"path":58,"title":59,"target":55,"fa_class":60},"\u002Fabout","关于","fa-user",{"path":62,"title":63,"target":55,"fa_class":64},"\u002Fpost","归档","fa-archive",{"path":66,"title":67,"target":55,"fa_class":68},"\u002Fgallery","相册","fa-image",{"path":29,"title":30,"target":70,"fa_class":31},"otherSite",false,"新浪博客内容备份(粉丝自用)","陈思诚的博客","settings","5S7xKt0XLHpkjipbomx4I7pUu50Y7wqtD418LquZj5Q",{"latestBlog":77},[78,81,84,87,90],{"title":79,"slug":80},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":82,"slug":83},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":85,"slug":86},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":88,"slug":89},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":91,"slug":92},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":94,"title":95,"body":96,"categories":167,"description":102,"extension":168,"meta":169,"navigation":171,"path":172,"seo":173,"slug":174,"stem":175,"tags":176,"__hash__":177},"blog\u002Fblog\u002Fblog_4af9831b010008rk.md","对镜梳妆",{"type":97,"value":98,"toc":163},"minimark",[99,103,106,109,112,115,118,121,124,127,130,133,136,139,142,145,148,151,154,157,160],[100,101,102],"p",{},"昨天，镜前画眉，如常。忽然，一个念头无缘由的闪现。镜中人，谁？",[100,104,105],{},"那脸，熟悉却更陌生？他本是男子，怎会每天做女人的勾当？",[100,107,108],{},"演员？明星？戏子？还是下九流？",[100,110,111],{},"恍惚间，她成了你的职业。",[100,113,114],{},"你的职业很特别，就是做别人。",[100,116,117],{},"做的太坏？不行！",[100,119,120],{},"什么职业都得专业。否则，失业事小饿死事大。",[100,122,123],{},"做的太好？仿佛也不行！",[100,125,126],{},"入戏太深，人戏不分，会疯魔。",[100,128,129],{},"想想自己，去年的今时，是个兵。前年的此刻，在为另个女人活……",[100,131,132],{},"惊出一身冷汗，匆匆数年，做别人竞比做自己多！",[100,134,135],{},"自己呢？",[100,137,138],{},"怎么觉得离自己越来越远？",[100,140,141],{},"究竟是我在扮演别人，还是无数的别人组成了自己？",[100,143,144],{},"真做假时？假做真时？亦真亦假？亦假亦真？",[100,146,147],{},"何谓真？又何谓假呢？",[100,149,150],{},"佛说：本来无一物，那就是没有真的真了……",[100,152,153],{},"既然没有真的真，又怎么敢言说真的假呢？",[100,155,156],{},"所以，我是我吗？还是，他是我呢？",[100,158,159],{},"镜中人，沉默。",[100,161,162],{},"镜外人，无言。",{"title":164,"searchDepth":165,"depth":165,"links":166},"",2,[],[6],"md",{"date":170},"2007-06-08 02:13",true,"\u002Fblog\u002Fblog_4af9831b010008rk",{"title":95,"description":102},"blog_4af9831b010008rk","blog\u002Fblog_4af9831b010008rk",[],"EA49pJW7qm_7x_y67FukbePazHkjI2tS4t2lAseyQSk",[179,184],{"title":180,"path":181,"stem":182,"children":-1,"slug":183},"问好","\u002Fblog\u002Fblog_4af9831b010008ri","blog\u002Fblog_4af9831b010008ri","blog_4af9831b010008ri",{"title":185,"path":186,"stem":187,"children":-1,"slug":188},"女人这东西","\u002Fblog\u002Fblog_4af9831b010008rl","blog\u002Fblog_4af9831b010008rl","blog_4af9831b010008rl",1795162026212]
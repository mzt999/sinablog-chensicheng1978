[{"data":1,"prerenderedAt":170},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":57,"blog-post-slug-blog_4af9831b010008rk":74,"surround-blog_4af9831b010008rk":159},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":16,"site_description":54,"stem":55,"__hash__":56},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo","新浪博客内容备份(粉丝自用)","settings","jPD1QWrYwbaIixg6lntppEYe-T3ZGd3EJZxFBkbKY9E",{"latestBlog":58},[59,62,65,68,71],{"title":60,"slug":61},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":63,"slug":64},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":66,"slug":67},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":69,"slug":70},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":72,"slug":73},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":75,"title":76,"body":77,"categories":148,"description":83,"extension":149,"meta":150,"navigation":152,"path":153,"seo":154,"slug":155,"stem":156,"tags":157,"__hash__":158},"blog\u002Fblog\u002Fblog_4af9831b010008rk.md","对镜梳妆",{"type":78,"value":79,"toc":144},"minimark",[80,84,87,90,93,96,99,102,105,108,111,114,117,120,123,126,129,132,135,138,141],[81,82,83],"p",{},"昨天，镜前画眉，如常。忽然，一个念头无缘由的闪现。镜中人，谁？",[81,85,86],{},"那脸，熟悉却更陌生？他本是男子，怎会每天做女人的勾当？",[81,88,89],{},"演员？明星？戏子？还是下九流？",[81,91,92],{},"恍惚间，她成了你的职业。",[81,94,95],{},"你的职业很特别，就是做别人。",[81,97,98],{},"做的太坏？不行！",[81,100,101],{},"什么职业都得专业。否则，失业事小饿死事大。",[81,103,104],{},"做的太好？仿佛也不行！",[81,106,107],{},"入戏太深，人戏不分，会疯魔。",[81,109,110],{},"想想自己，去年的今时，是个兵。前年的此刻，在为另个女人活……",[81,112,113],{},"惊出一身冷汗，匆匆数年，做别人竞比做自己多！",[81,115,116],{},"自己呢？",[81,118,119],{},"怎么觉得离自己越来越远？",[81,121,122],{},"究竟是我在扮演别人，还是无数的别人组成了自己？",[81,124,125],{},"真做假时？假做真时？亦真亦假？亦假亦真？",[81,127,128],{},"何谓真？又何谓假呢？",[81,130,131],{},"佛说：本来无一物，那就是没有真的真了……",[81,133,134],{},"既然没有真的真，又怎么敢言说真的假呢？",[81,136,137],{},"所以，我是我吗？还是，他是我呢？",[81,139,140],{},"镜中人，沉默。",[81,142,143],{},"镜外人，无言。",{"title":145,"searchDepth":146,"depth":146,"links":147},"",2,[],[6],"md",{"date":151},"2007-06-08 02:13",true,"\u002Fblog\u002Fblog_4af9831b010008rk",{"title":76,"description":83},"blog_4af9831b010008rk","blog\u002Fblog_4af9831b010008rk",[],"EA49pJW7qm_7x_y67FukbePazHkjI2tS4t2lAseyQSk",[160,165],{"title":161,"path":162,"stem":163,"children":-1,"slug":164},"问好","\u002Fblog\u002Fblog_4af9831b010008ri","blog\u002Fblog_4af9831b010008ri","blog_4af9831b010008ri",{"title":166,"path":167,"stem":168,"children":-1,"slug":169},"女人这东西","\u002Fblog\u002Fblog_4af9831b010008rl","blog\u002Fblog_4af9831b010008rl","blog_4af9831b010008rl",1794473705893]
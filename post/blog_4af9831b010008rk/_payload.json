[{"data":1,"prerenderedAt":127},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b010008rk":31,"surround-blog_4af9831b010008rk":116},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",151,{"name":9,"len":10},"有图",34,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":105,"description":33,"extension":106,"meta":107,"navigation":109,"path":110,"seo":111,"slug":112,"stem":113,"tags":114,"__hash__":115},"blog\u002Fblog\u002Fblog_4af9831b010008rk.md","对镜梳妆",{"type":35,"value":36,"toc":101},"minimark",[37,41,44,47,50,53,56,59,62,65,68,71,74,77,80,83,86,89,92,95,98],[38,39,40],"p",{},"昨天，镜前画眉，如常。忽然，一个念头无缘由的闪现。镜中人，谁？",[38,42,43],{},"那脸，熟悉却更陌生？他本是男子，怎会每天做女人的勾当？",[38,45,46],{},"演员？明星？戏子？还是下九流？",[38,48,49],{},"恍惚间，她成了你的职业。",[38,51,52],{},"你的职业很特别，就是做别人。",[38,54,55],{},"做的太坏？不行！",[38,57,58],{},"什么职业都得专业。否则，失业事小饿死事大。",[38,60,61],{},"做的太好？仿佛也不行！",[38,63,64],{},"入戏太深，人戏不分，会疯魔。",[38,66,67],{},"想想自己，去年的今时，是个兵。前年的此刻，在为另个女人活……",[38,69,70],{},"惊出一身冷汗，匆匆数年，做别人竞比做自己多！",[38,72,73],{},"自己呢？",[38,75,76],{},"怎么觉得离自己越来越远？",[38,78,79],{},"究竟是我在扮演别人，还是无数的别人组成了自己？",[38,81,82],{},"真做假时？假做真时？亦真亦假？亦假亦真？",[38,84,85],{},"何谓真？又何谓假呢？",[38,87,88],{},"佛说：本来无一物，那就是没有真的真了……",[38,90,91],{},"既然没有真的真，又怎么敢言说真的假呢？",[38,93,94],{},"所以，我是我吗？还是，他是我呢？",[38,96,97],{},"镜中人，沉默。",[38,99,100],{},"镜外人，无言。",{"title":102,"searchDepth":103,"depth":103,"links":104},"",2,[],[6],"md",{"date":108},"2007-06-08 02:13",true,"\u002Fblog\u002Fblog_4af9831b010008rk",{"title":33,"description":33},"blog_4af9831b010008rk","blog\u002Fblog_4af9831b010008rk",[],"t663i4S-NG_gt0zPsHa0YC6pV1Rywd3wV4hwaa29oQw",[117,122],{"title":118,"path":119,"stem":120,"children":-1,"slug":121},"问好","\u002Fblog\u002Fblog_4af9831b010008ri","blog\u002Fblog_4af9831b010008ri","blog_4af9831b010008ri",{"title":123,"path":124,"stem":125,"children":-1,"slug":126},"女人这东西","\u002Fblog\u002Fblog_4af9831b010008rl","blog\u002Fblog_4af9831b010008rl","blog_4af9831b010008rl",1793777045101]
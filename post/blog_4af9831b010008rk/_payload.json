[{"data":1,"prerenderedAt":130},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":17,"blog-post-slug-blog_4af9831b010008rk":34,"surround-blog_4af9831b010008rk":119},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"latestBlog":18},[19,22,25,28,31],{"title":20,"slug":21},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":23,"slug":24},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":26,"slug":27},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":29,"slug":30},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":32,"slug":33},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":35,"title":36,"body":37,"categories":108,"description":43,"extension":109,"meta":110,"navigation":112,"path":113,"seo":114,"slug":115,"stem":116,"tags":117,"__hash__":118},"blog\u002Fblog\u002Fblog_4af9831b010008rk.md","对镜梳妆",{"type":38,"value":39,"toc":104},"minimark",[40,44,47,50,53,56,59,62,65,68,71,74,77,80,83,86,89,92,95,98,101],[41,42,43],"p",{},"昨天，镜前画眉，如常。忽然，一个念头无缘由的闪现。镜中人，谁？",[41,45,46],{},"那脸，熟悉却更陌生？他本是男子，怎会每天做女人的勾当？",[41,48,49],{},"演员？明星？戏子？还是下九流？",[41,51,52],{},"恍惚间，她成了你的职业。",[41,54,55],{},"你的职业很特别，就是做别人。",[41,57,58],{},"做的太坏？不行！",[41,60,61],{},"什么职业都得专业。否则，失业事小饿死事大。",[41,63,64],{},"做的太好？仿佛也不行！",[41,66,67],{},"入戏太深，人戏不分，会疯魔。",[41,69,70],{},"想想自己，去年的今时，是个兵。前年的此刻，在为另个女人活……",[41,72,73],{},"惊出一身冷汗，匆匆数年，做别人竞比做自己多！",[41,75,76],{},"自己呢？",[41,78,79],{},"怎么觉得离自己越来越远？",[41,81,82],{},"究竟是我在扮演别人，还是无数的别人组成了自己？",[41,84,85],{},"真做假时？假做真时？亦真亦假？亦假亦真？",[41,87,88],{},"何谓真？又何谓假呢？",[41,90,91],{},"佛说：本来无一物，那就是没有真的真了……",[41,93,94],{},"既然没有真的真，又怎么敢言说真的假呢？",[41,96,97],{},"所以，我是我吗？还是，他是我呢？",[41,99,100],{},"镜中人，沉默。",[41,102,103],{},"镜外人，无言。",{"title":105,"searchDepth":106,"depth":106,"links":107},"",2,[],[6],"md",{"date":111},"2007-06-08 02:13",true,"\u002Fblog\u002Fblog_4af9831b010008rk",{"title":36,"description":43},"blog_4af9831b010008rk","blog\u002Fblog_4af9831b010008rk",[],"EA49pJW7qm_7x_y67FukbePazHkjI2tS4t2lAseyQSk",[120,125],{"title":121,"path":122,"stem":123,"children":-1,"slug":124},"问好","\u002Fblog\u002Fblog_4af9831b010008ri","blog\u002Fblog_4af9831b010008ri","blog_4af9831b010008ri",{"title":126,"path":127,"stem":128,"children":-1,"slug":129},"女人这东西","\u002Fblog\u002Fblog_4af9831b010008rl","blog\u002Fblog_4af9831b010008rl","blog_4af9831b010008rl",1794043806005]
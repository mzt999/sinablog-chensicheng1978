[{"data":1,"prerenderedAt":171},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":58,"blog-post-slug-blog_4af9831b010008rk":75,"surround-blog_4af9831b010008rk":160},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":54,"site_description":55,"stem":56,"__hash__":57},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo",20,"新浪博客内容备份","settings","hh8X7X6SFDoeJrxIJ4yisZXSc3HwHM1zk206jiQX2XU",{"latestBlog":59},[60,63,66,69,72],{"title":61,"slug":62},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":64,"slug":65},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":67,"slug":68},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":70,"slug":71},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":73,"slug":74},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":76,"title":77,"body":78,"categories":149,"description":84,"extension":150,"meta":151,"navigation":153,"path":154,"seo":155,"slug":156,"stem":157,"tags":158,"__hash__":159},"blog\u002Fblog\u002Fblog_4af9831b010008rk.md","对镜梳妆",{"type":79,"value":80,"toc":145},"minimark",[81,85,88,91,94,97,100,103,106,109,112,115,118,121,124,127,130,133,136,139,142],[82,83,84],"p",{},"昨天，镜前画眉，如常。忽然，一个念头无缘由的闪现。镜中人，谁？",[82,86,87],{},"那脸，熟悉却更陌生？他本是男子，怎会每天做女人的勾当？",[82,89,90],{},"演员？明星？戏子？还是下九流？",[82,92,93],{},"恍惚间，她成了你的职业。",[82,95,96],{},"你的职业很特别，就是做别人。",[82,98,99],{},"做的太坏？不行！",[82,101,102],{},"什么职业都得专业。否则，失业事小饿死事大。",[82,104,105],{},"做的太好？仿佛也不行！",[82,107,108],{},"入戏太深，人戏不分，会疯魔。",[82,110,111],{},"想想自己，去年的今时，是个兵。前年的此刻，在为另个女人活……",[82,113,114],{},"惊出一身冷汗，匆匆数年，做别人竞比做自己多！",[82,116,117],{},"自己呢？",[82,119,120],{},"怎么觉得离自己越来越远？",[82,122,123],{},"究竟是我在扮演别人，还是无数的别人组成了自己？",[82,125,126],{},"真做假时？假做真时？亦真亦假？亦假亦真？",[82,128,129],{},"何谓真？又何谓假呢？",[82,131,132],{},"佛说：本来无一物，那就是没有真的真了……",[82,134,135],{},"既然没有真的真，又怎么敢言说真的假呢？",[82,137,138],{},"所以，我是我吗？还是，他是我呢？",[82,140,141],{},"镜中人，沉默。",[82,143,144],{},"镜外人，无言。",{"title":146,"searchDepth":147,"depth":147,"links":148},"",2,[],[6],"md",{"date":152},"2007-06-08 02:13",true,"\u002Fblog\u002Fblog_4af9831b010008rk",{"title":77,"description":84},"blog_4af9831b010008rk","blog\u002Fblog_4af9831b010008rk",[],"EA49pJW7qm_7x_y67FukbePazHkjI2tS4t2lAseyQSk",[161,166],{"title":162,"path":163,"stem":164,"children":-1,"slug":165},"问好","\u002Fblog\u002Fblog_4af9831b010008ri","blog\u002Fblog_4af9831b010008ri","blog_4af9831b010008ri",{"title":167,"path":168,"stem":169,"children":-1,"slug":170},"女人这东西","\u002Fblog\u002Fblog_4af9831b010008rl","blog\u002Fblog_4af9831b010008rl","blog_4af9831b010008rl",1794412501207]
[{"data":1,"prerenderedAt":183},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":70,"blog-post-slug-blog_4af9831b010008rk":87,"surround-blog_4af9831b010008rk":172},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":45,"navLinks":46,"perPage":16,"prevNextIsExcludeDate":66,"site_description":23,"site_name":67,"stem":68,"__hash__":69},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{},[47,52,56,60,64],{"path":48,"title":49,"target":50,"fa_class":51},"\u002F","博客首页","internal","fa-home",{"path":53,"title":54,"target":50,"fa_class":55},"\u002Fabout","关于","fa-user",{"path":57,"title":58,"target":50,"fa_class":59},"\u002Fpost","归档","fa-archive",{"path":61,"title":62,"target":50,"fa_class":63},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":65,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","jvZHccz2rT-wjVS5GCPgWyhl8WnBIvECPkE5KpKFKCU",{"latestBlog":71},[72,75,78,81,84],{"title":73,"slug":74},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":76,"slug":77},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":79,"slug":80},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":82,"slug":83},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":85,"slug":86},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":88,"title":89,"body":90,"categories":161,"description":96,"extension":162,"meta":163,"navigation":165,"path":166,"seo":167,"slug":168,"stem":169,"tags":170,"__hash__":171},"blog\u002Fblog\u002Fblog_4af9831b010008rk.md","对镜梳妆",{"type":91,"value":92,"toc":157},"minimark",[93,97,100,103,106,109,112,115,118,121,124,127,130,133,136,139,142,145,148,151,154],[94,95,96],"p",{},"昨天，镜前画眉，如常。忽然，一个念头无缘由的闪现。镜中人，谁？",[94,98,99],{},"那脸，熟悉却更陌生？他本是男子，怎会每天做女人的勾当？",[94,101,102],{},"演员？明星？戏子？还是下九流？",[94,104,105],{},"恍惚间，她成了你的职业。",[94,107,108],{},"你的职业很特别，就是做别人。",[94,110,111],{},"做的太坏？不行！",[94,113,114],{},"什么职业都得专业。否则，失业事小饿死事大。",[94,116,117],{},"做的太好？仿佛也不行！",[94,119,120],{},"入戏太深，人戏不分，会疯魔。",[94,122,123],{},"想想自己，去年的今时，是个兵。前年的此刻，在为另个女人活……",[94,125,126],{},"惊出一身冷汗，匆匆数年，做别人竞比做自己多！",[94,128,129],{},"自己呢？",[94,131,132],{},"怎么觉得离自己越来越远？",[94,134,135],{},"究竟是我在扮演别人，还是无数的别人组成了自己？",[94,137,138],{},"真做假时？假做真时？亦真亦假？亦假亦真？",[94,140,141],{},"何谓真？又何谓假呢？",[94,143,144],{},"佛说：本来无一物，那就是没有真的真了……",[94,146,147],{},"既然没有真的真，又怎么敢言说真的假呢？",[94,149,150],{},"所以，我是我吗？还是，他是我呢？",[94,152,153],{},"镜中人，沉默。",[94,155,156],{},"镜外人，无言。",{"title":158,"searchDepth":159,"depth":159,"links":160},"",2,[],[6],"md",{"date":164},"2007-06-08 02:13",true,"\u002Fblog\u002Fblog_4af9831b010008rk",{"title":89,"description":96},"blog_4af9831b010008rk","blog\u002Fblog_4af9831b010008rk",[],"EA49pJW7qm_7x_y67FukbePazHkjI2tS4t2lAseyQSk",[173,178],{"title":174,"path":175,"stem":176,"children":-1,"slug":177},"问好","\u002Fblog\u002Fblog_4af9831b010008ri","blog\u002Fblog_4af9831b010008ri","blog_4af9831b010008ri",{"title":179,"path":180,"stem":181,"children":-1,"slug":182},"女人这东西","\u002Fblog\u002Fblog_4af9831b010008rl","blog\u002Fblog_4af9831b010008rl","blog_4af9831b010008rl",1794544668071]
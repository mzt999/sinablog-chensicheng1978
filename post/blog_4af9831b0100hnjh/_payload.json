[{"data":1,"prerenderedAt":144},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":57,"blog-post-slug-blog_4af9831b0100hnjh":74,"surround-blog_4af9831b0100hnjh":133},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":16,"site_description":54,"stem":55,"__hash__":56},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo","新浪博客内容备份(粉丝自用)","settings","jPD1QWrYwbaIixg6lntppEYe-T3ZGd3EJZxFBkbKY9E",{"latestBlog":58},[59,62,65,68,71],{"title":60,"slug":61},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":63,"slug":64},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":66,"slug":67},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":69,"slug":70},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":72,"slug":73},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":75,"title":76,"body":77,"categories":117,"description":118,"extension":119,"meta":120,"navigation":122,"path":123,"seo":124,"slug":125,"stem":126,"tags":127,"__hash__":132},"blog\u002Fblog\u002Fblog_4af9831b0100hnjh.md","天边外 祭奠",{"type":78,"value":79,"toc":113},"minimark",[80,84,91,94,99,102,105,108],[81,82,83],"p",{},"“天边外祭奠”是我大学时期自编自导自演的一部话剧。改编自奥尼尔的第一部戏剧作品“天边外”。今晚忽然想起这个名字，只为一个人，哥哥……\n拍摄“守望者”的时候，某台每晚深夜总会播哥哥曾经的作品，从“英雄本色”“倩女幽魂”到“霸王别姬”……宛如哥哥的一部成长史，我看到一个青涩少年到倾国倾城的转变……又是4月1日，又是一个愚人节，但愿此后不要再有这样的“玩笑”与我们，与我们这些活着的可怜的人们……我知道，此刻你正在天边外的某处，笑得依旧那么温暖灿烂，可你会否想到，俗世中的我们正在把你想念把你祭奠……哥哥，愿你永生……你已永生……",[81,85,86],{},[87,88],"img",{"alt":89,"src":90},"天边外 祭奠","\u002Fpic\u002F4af9831bt831babcf795f.jpg",[81,92,93],{},"背后的公路延伸于无限，我们的双眼同样未知……困惑的一定不只是我，是所有的世人……",[81,95,96],{},[87,97],{"alt":89,"src":98},"\u002Fpic\u002F4af9831bt831bb5cf6b5d.jpg",[81,100,101],{},"这张照片让我有浮生若梦的感觉和感动，华哥，另一个香港的传奇，那天，我们同样怀念起了哥哥……",[81,103,104],{},"这是个创造传奇的时代，真正的传奇就在我们身边……",[81,106,107],{},"我知道，此刻，你就在天边外，你在听，你在看……",[81,109,110],{},[87,111],{"alt":89,"src":112},"\u002Fpic\u002F4af9831bt831c12840794.jpg",{"title":114,"searchDepth":115,"depth":115,"links":116},"",2,[],[6,9],"“天边外祭奠”是我大学时期自编自导自演的一部话剧。","md",{"date":121},"2010-04-01 00:55",true,"\u002Fblog\u002Fblog_4af9831b0100hnjh",{"title":76,"description":118},"blog_4af9831b0100hnjh","blog\u002Fblog_4af9831b0100hnjh",[128,129,130,131],"张国荣","守望者","电影","传奇","4boXv9NqhMWKbIZg9E7HSyZbKmMvkkxZ-qKrYjo1fHE",[134,139],{"title":135,"path":136,"stem":137,"children":-1,"slug":138},"飞行","\u002Fblog\u002Fblog_4af9831b0100h7nc","blog\u002Fblog_4af9831b0100h7nc","blog_4af9831b0100h7nc",{"title":140,"path":141,"stem":142,"children":-1,"slug":143},"从未披露过的搞笑“命运”照","\u002Fblog\u002Fblog_4af9831b0100hy2b","blog\u002Fblog_4af9831b0100hy2b","blog_4af9831b0100hy2b",1794473704507]
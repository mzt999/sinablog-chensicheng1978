[{"data":1,"prerenderedAt":157},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":70,"blog-post-slug-blog_4af9831b0100hnjh":87,"surround-blog_4af9831b0100hnjh":146},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":45,"navLinks":46,"perPage":16,"prevNextIsExcludeDate":66,"site_description":23,"site_name":67,"stem":68,"__hash__":69},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{},[47,52,56,60,64],{"path":48,"title":49,"target":50,"fa_class":51},"\u002F","博客首页","internal","fa-home",{"path":53,"title":54,"target":50,"fa_class":55},"\u002Fabout","关于","fa-user",{"path":57,"title":58,"target":50,"fa_class":59},"\u002Fpost","归档","fa-archive",{"path":61,"title":62,"target":50,"fa_class":63},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":65,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","jvZHccz2rT-wjVS5GCPgWyhl8WnBIvECPkE5KpKFKCU",{"latestBlog":71},[72,75,78,81,84],{"title":73,"slug":74},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":76,"slug":77},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":79,"slug":80},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":82,"slug":83},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":85,"slug":86},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":88,"title":89,"body":90,"categories":130,"description":131,"extension":132,"meta":133,"navigation":135,"path":136,"seo":137,"slug":138,"stem":139,"tags":140,"__hash__":145},"blog\u002Fblog\u002Fblog_4af9831b0100hnjh.md","天边外 祭奠",{"type":91,"value":92,"toc":126},"minimark",[93,97,104,107,112,115,118,121],[94,95,96],"p",{},"“天边外祭奠”是我大学时期自编自导自演的一部话剧。改编自奥尼尔的第一部戏剧作品“天边外”。今晚忽然想起这个名字，只为一个人，哥哥……\n拍摄“守望者”的时候，某台每晚深夜总会播哥哥曾经的作品，从“英雄本色”“倩女幽魂”到“霸王别姬”……宛如哥哥的一部成长史，我看到一个青涩少年到倾国倾城的转变……又是4月1日，又是一个愚人节，但愿此后不要再有这样的“玩笑”与我们，与我们这些活着的可怜的人们……我知道，此刻你正在天边外的某处，笑得依旧那么温暖灿烂，可你会否想到，俗世中的我们正在把你想念把你祭奠……哥哥，愿你永生……你已永生……",[94,98,99],{},[100,101],"img",{"alt":102,"src":103},"天边外 祭奠","\u002Fpic\u002F4af9831bt831babcf795f.jpg",[94,105,106],{},"背后的公路延伸于无限，我们的双眼同样未知……困惑的一定不只是我，是所有的世人……",[94,108,109],{},[100,110],{"alt":102,"src":111},"\u002Fpic\u002F4af9831bt831bb5cf6b5d.jpg",[94,113,114],{},"这张照片让我有浮生若梦的感觉和感动，华哥，另一个香港的传奇，那天，我们同样怀念起了哥哥……",[94,116,117],{},"这是个创造传奇的时代，真正的传奇就在我们身边……",[94,119,120],{},"我知道，此刻，你就在天边外，你在听，你在看……",[94,122,123],{},[100,124],{"alt":102,"src":125},"\u002Fpic\u002F4af9831bt831c12840794.jpg",{"title":127,"searchDepth":128,"depth":128,"links":129},"",2,[],[6,9],"“天边外祭奠”是我大学时期自编自导自演的一部话剧。","md",{"date":134},"2010-04-01 00:55",true,"\u002Fblog\u002Fblog_4af9831b0100hnjh",{"title":89,"description":131},"blog_4af9831b0100hnjh","blog\u002Fblog_4af9831b0100hnjh",[141,142,143,144],"张国荣","守望者","电影","传奇","4boXv9NqhMWKbIZg9E7HSyZbKmMvkkxZ-qKrYjo1fHE",[147,152],{"title":148,"path":149,"stem":150,"children":-1,"slug":151},"飞行","\u002Fblog\u002Fblog_4af9831b0100h7nc","blog\u002Fblog_4af9831b0100h7nc","blog_4af9831b0100h7nc",{"title":153,"path":154,"stem":155,"children":-1,"slug":156},"从未披露过的搞笑“命运”照","\u002Fblog\u002Fblog_4af9831b0100hy2b","blog\u002Fblog_4af9831b0100hy2b","blog_4af9831b0100hy2b",1794544667048]
[{"data":1,"prerenderedAt":145},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":58,"blog-post-slug-blog_4af9831b0100hnjh":75,"surround-blog_4af9831b0100hnjh":134},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":54,"site_description":55,"stem":56,"__hash__":57},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo",20,"新浪博客内容备份","settings","hh8X7X6SFDoeJrxIJ4yisZXSc3HwHM1zk206jiQX2XU",{"latestBlog":59},[60,63,66,69,72],{"title":61,"slug":62},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":64,"slug":65},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":67,"slug":68},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":70,"slug":71},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":73,"slug":74},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":76,"title":77,"body":78,"categories":118,"description":119,"extension":120,"meta":121,"navigation":123,"path":124,"seo":125,"slug":126,"stem":127,"tags":128,"__hash__":133},"blog\u002Fblog\u002Fblog_4af9831b0100hnjh.md","天边外 祭奠",{"type":79,"value":80,"toc":114},"minimark",[81,85,92,95,100,103,106,109],[82,83,84],"p",{},"“天边外祭奠”是我大学时期自编自导自演的一部话剧。改编自奥尼尔的第一部戏剧作品“天边外”。今晚忽然想起这个名字，只为一个人，哥哥……\n拍摄“守望者”的时候，某台每晚深夜总会播哥哥曾经的作品，从“英雄本色”“倩女幽魂”到“霸王别姬”……宛如哥哥的一部成长史，我看到一个青涩少年到倾国倾城的转变……又是4月1日，又是一个愚人节，但愿此后不要再有这样的“玩笑”与我们，与我们这些活着的可怜的人们……我知道，此刻你正在天边外的某处，笑得依旧那么温暖灿烂，可你会否想到，俗世中的我们正在把你想念把你祭奠……哥哥，愿你永生……你已永生……",[82,86,87],{},[88,89],"img",{"alt":90,"src":91},"天边外 祭奠","\u002Fpic\u002F4af9831bt831babcf795f.jpg",[82,93,94],{},"背后的公路延伸于无限，我们的双眼同样未知……困惑的一定不只是我，是所有的世人……",[82,96,97],{},[88,98],{"alt":90,"src":99},"\u002Fpic\u002F4af9831bt831bb5cf6b5d.jpg",[82,101,102],{},"这张照片让我有浮生若梦的感觉和感动，华哥，另一个香港的传奇，那天，我们同样怀念起了哥哥……",[82,104,105],{},"这是个创造传奇的时代，真正的传奇就在我们身边……",[82,107,108],{},"我知道，此刻，你就在天边外，你在听，你在看……",[82,110,111],{},[88,112],{"alt":90,"src":113},"\u002Fpic\u002F4af9831bt831c12840794.jpg",{"title":115,"searchDepth":116,"depth":116,"links":117},"",2,[],[6,9],"“天边外祭奠”是我大学时期自编自导自演的一部话剧。","md",{"date":122},"2010-04-01 00:55",true,"\u002Fblog\u002Fblog_4af9831b0100hnjh",{"title":77,"description":119},"blog_4af9831b0100hnjh","blog\u002Fblog_4af9831b0100hnjh",[129,130,131,132],"张国荣","守望者","电影","传奇","4boXv9NqhMWKbIZg9E7HSyZbKmMvkkxZ-qKrYjo1fHE",[135,140],{"title":136,"path":137,"stem":138,"children":-1,"slug":139},"飞行","\u002Fblog\u002Fblog_4af9831b0100h7nc","blog\u002Fblog_4af9831b0100h7nc","blog_4af9831b0100h7nc",{"title":141,"path":142,"stem":143,"children":-1,"slug":144},"从未披露过的搞笑“命运”照","\u002Fblog\u002Fblog_4af9831b0100hy2b","blog\u002Fblog_4af9831b0100hy2b","blog_4af9831b0100hy2b",1794412499915]
[{"data":1,"prerenderedAt":105},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b0100hnjh":31,"surround-blog_4af9831b0100hnjh":94},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",151,{"name":9,"len":10},"有图",34,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":79,"description":33,"extension":80,"meta":81,"navigation":83,"path":84,"seo":85,"slug":86,"stem":87,"tags":88,"__hash__":93},"blog\u002Fblog\u002Fblog_4af9831b0100hnjh.md","天边外 祭奠",{"type":35,"value":36,"toc":75},"minimark",[37,41,48,53,56,61,64,67,70],[38,39,40],"p",{},"“天边外祭奠”是我大学时期自编自导自演的一部话剧。改编自奥尼尔的第一部戏剧作品“天边外”。今晚忽然想起这个名字，只为一个人，哥哥……\n拍摄“守望者”的时候，某台每晚深夜总会播哥哥曾经的作品，从“英雄本色”“倩女幽魂”到“霸王别姬”……宛如哥哥的一部成长史，我看到一个青涩少年到倾国倾城的转变……又是4月1日，又是一个愚人节，但愿此后不要再有这样的“玩笑”与我们，与我们这些活着的可怜的人们……我知道，此刻你正在天边外的某处，笑得依旧那么温暖灿烂，可你会否想到，俗世中的我们正在把你想念把你祭奠……哥哥，愿你永生……你已永生……",[38,42,43],{},[44,45],"img",{"alt":46,"src":47},"天边外 祭奠","\u002Fpic\u002F4af9831bt831babcf795f.jpg",[38,49,50],{},[44,51],{"alt":46,"src":52},"http:\u002F\u002Fphoto.blog.sina.com.cn\u002Fshowpic.html#blogid=4af9831b0100hnjh&url=http:\u002F\u002Fs16.sinaimg.cn\u002Forignal\u002F4af9831bt831babcf795f",[38,54,55],{},"背后的公路延伸于无限，我们的双眼同样未知……困惑的一定不只是我，是所有的世人……",[38,57,58],{},[44,59],{"alt":46,"src":60},"\u002Fpic\u002F4af9831bt831bb5cf6b5d.jpg",[38,62,63],{},"这张照片让我有浮生若梦的感觉和感动，华哥，另一个香港的传奇，那天，我们同样怀念起了哥哥……",[38,65,66],{},"这是个创造传奇的时代，真正的传奇就在我们身边……",[38,68,69],{},"我知道，此刻，你就在天边外，你在听，你在看……",[38,71,72],{},[44,73],{"alt":46,"src":74},"\u002Fpic\u002F4af9831bt831c12840794.jpg",{"title":76,"searchDepth":77,"depth":77,"links":78},"",2,[],[6,9],"md",{"date":82},"2010-04-01 00:55",true,"\u002F
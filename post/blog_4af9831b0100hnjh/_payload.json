[{"data":1,"prerenderedAt":104},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":17,"blog-post-slug-blog_4af9831b0100hnjh":34,"surround-blog_4af9831b0100hnjh":93},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"latestBlog":18},[19,22,25,28,31],{"title":20,"slug":21},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":23,"slug":24},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":26,"slug":27},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":29,"slug":30},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":32,"slug":33},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":35,"title":36,"body":37,"categories":77,"description":78,"extension":79,"meta":80,"navigation":82,"path":83,"seo":84,"slug":85,"stem":86,"tags":87,"__hash__":92},"blog\u002Fblog\u002Fblog_4af9831b0100hnjh.md","天边外 祭奠",{"type":38,"value":39,"toc":73},"minimark",[40,44,51,54,59,62,65,68],[41,42,43],"p",{},"“天边外祭奠”是我大学时期自编自导自演的一部话剧。改编自奥尼尔的第一部戏剧作品“天边外”。今晚忽然想起这个名字，只为一个人，哥哥……\n拍摄“守望者”的时候，某台每晚深夜总会播哥哥曾经的作品，从“英雄本色”“倩女幽魂”到“霸王别姬”……宛如哥哥的一部成长史，我看到一个青涩少年到倾国倾城的转变……又是4月1日，又是一个愚人节，但愿此后不要再有这样的“玩笑”与我们，与我们这些活着的可怜的人们……我知道，此刻你正在天边外的某处，笑得依旧那么温暖灿烂，可你会否想到，俗世中的我们正在把你想念把你祭奠……哥哥，愿你永生……你已永生……",[41,45,46],{},[47,48],"img",{"alt":49,"src":50},"天边外 祭奠","\u002Fpic\u002F4af9831bt831babcf795f.jpg",[41,52,53],{},"背后的公路延伸于无限，我们的双眼同样未知……困惑的一定不只是我，是所有的世人……",[41,55,56],{},[47,57],{"alt":49,"src":58},"\u002Fpic\u002F4af9831bt831bb5cf6b5d.jpg",[41,60,61],{},"这张照片让我有浮生若梦的感觉和感动，华哥，另一个香港的传奇，那天，我们同样怀念起了哥哥……",[41,63,64],{},"这是个创造传奇的时代，真正的传奇就在我们身边……",[41,66,67],{},"我知道，此刻，你就在天边外，你在听，你在看……",[41,69,70],{},[47,71],{"alt":49,"src":72},"\u002Fpic\u002F4af9831bt831c12840794.jpg",{"title":74,"searchDepth":75,"depth":75,"links":76},"",2,[],[6,9],"“天边外祭奠”是我大学时期自编自导自演的一部话剧。","md",{"date":81},"2010-04-01 00:55",true,"\u002Fblog\u002Fblog_4af9831b0100hnjh",{"title":36,"description":78},"blog_4af9831b0100hnjh","blog\u002Fblog_4af9831b0100hnjh",[88,89,90,91],"张国荣","守望者","电影","传奇","4boXv9NqhMWKbIZg9E7HSyZbKmMvkkxZ-qKrYjo1fHE",[94,99],{"title":95,"path":96,"stem":97,"children":-1,"slug":98},"飞行","\u002Fblog\u002Fblog_4af9831b0100h7nc","blog\u002Fblog_4af9831b0100h7nc","blog_4af9831b0100h7nc",{"title":100,"path":101,"stem":102,"children":-1,"slug":103},"从未披露过的搞笑“命运”照","\u002Fblog\u002Fblog_4af9831b0100hy2b","blog\u002Fblog_4af9831b0100hy2b","blog_4af9831b0100hy2b",1794049609911]
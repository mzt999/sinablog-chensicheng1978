[{"data":1,"prerenderedAt":90},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b0100kany":31,"surround-blog_4af9831b0100kany":83},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",152,{"name":9,"len":10},"有图",34,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":20,"body":33,"categories":72,"description":20,"extension":73,"meta":74,"navigation":76,"path":77,"seo":78,"slug":21,"stem":79,"tags":80,"__hash__":82},"blog\u002Fblog\u002Fblog_4af9831b0100kany.md",{"type":34,"value":35,"toc":68},"minimark",[36,40,43,46,49,52,55,58,61],[37,38,39],"p",{},"好久没来了，一上来就说狠话不是很好，但没办法，不发泄一下不爽！",[37,41,42],{},"我在现场，听到一些事情觉得特别恼火，就借T姐的电脑发下牢骚————————",[37,44,45],{},"特别逗！我原来以为博客是自己的！可弄了半天，是谁的我就不明白了？？？？？？",[37,47,48],{},"曹老师昨天的一篇博客就这么被删掉了！她是好脾气我可不是！！！就是一次很简单的旅行，没想着宣什么传，本来就是个国内永远无法看到的片子！谢谢！！！",[37,50,51],{},"难道就因为留言里有骂声？就是所谓的不顾及自己形象？？就可以随便勒令我们艺人拿掉博客？？还要烦劳G小姐您亲自动手？？？？我觉得您真的是想的太多了！我们艺人本来就无所谓形象，您的那些形象不过是愚弄大众的假象！！！！",[37,53,54],{},"曹老师是个好孩子，她也许没有还手的力量但我绝不会没有响动——如此不讲情理的经济公司不要也罢！！否则时间长了我怕中国的艺人会效仿韩国自杀热的！我只想问凭什么？？？",[37,56,57],{},"我们不是卖给你们！谢谢！！！！！！！我们应当享有人身自由和私人空间！！！",[37,59,60],{},"今天本来是小罗汉首映的日子，大早晨起来就吃了这么个苍蝇真影响心情！本文纯属个人发泄，如有得罪也就得罪了！但不希望各位乱加猜测联想，更不希望您自己没事找事对号入座！更谢绝其他媒体博友转载，省的又说炒作！怎么就都是炒作呢？？？？真烦！！！！！！！！！！！",[37,62,63,64],{},"  ",[65,66],"img",{"alt":20,"src":67},"\u002Fpic\u002F4af9831bt8c07ef88aa26.jpg",{"title":69,"searchDepth":70,"depth":70,"links":71},"",2,[],[6,9],"md",{"date":75},"2010-07-23 14:09",true,"\u002Fblog\u002Fblog_4af9831b0100kany",{"title":20,"description":20},"blog\u002Fblog_4af9831b0100kany",[81],"杂谈","NoR-lSAFPTu0XbnGmj9Nt3jbubic1BYAQd5L1WuypLA",[84,87],{"title":23,"path":85,"stem":86,"children":-1
[{"data":1,"prerenderedAt":135},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":58,"blog-post-slug-blog_4af9831b0100kany":75,"surround-blog_4af9831b0100kany":128},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":54,"site_description":55,"stem":56,"__hash__":57},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo",20,"新浪博客内容备份","settings","hh8X7X6SFDoeJrxIJ4yisZXSc3HwHM1zk206jiQX2XU",{"latestBlog":59},[60,63,66,69,72],{"title":61,"slug":62},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":64,"slug":65},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":67,"slug":68},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":70,"slug":71},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":73,"slug":74},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":76,"title":64,"body":77,"categories":116,"description":117,"extension":118,"meta":119,"navigation":121,"path":122,"seo":123,"slug":65,"stem":124,"tags":125,"__hash__":127},"blog\u002Fblog\u002Fblog_4af9831b0100kany.md",{"type":78,"value":79,"toc":112},"minimark",[80,84,87,90,93,96,99,102,105],[81,82,83],"p",{},"好久没来了，一上来就说狠话不是很好，但没办法，不发泄一下不爽！",[81,85,86],{},"我在现场，听到一些事情觉得特别恼火，就借T姐的电脑发下牢骚————————",[81,88,89],{},"特别逗！我原来以为博客是自己的！可弄了半天，是谁的我就不明白了？？？？？？",[81,91,92],{},"曹老师昨天的一篇博客就这么被删掉了！她是好脾气我可不是！！！就是一次很简单的旅行，没想着宣什么传，本来就是个国内永远无法看到的片子！谢谢！！！",[81,94,95],{},"难道就因为留言里有骂声？就是所谓的不顾及自己形象？？就可以随便勒令我们艺人拿掉博客？？还要烦劳G小姐您亲自动手？？？？我觉得您真的是想的太多了！我们艺人本来就无所谓形象，您的那些形象不过是愚弄大众的假象！！！！",[81,97,98],{},"曹老师是个好孩子，她也许没有还手的力量但我绝不会没有响动——如此不讲情理的经济公司不要也罢！！否则时间长了我怕中国的艺人会效仿韩国自杀热的！我只想问凭什么？？？",[81,100,101],{},"我们不是卖给你们！谢谢！！！！！！！我们应当享有人身自由和私人空间！！！",[81,103,104],{},"今天本来是小罗汉首映的日子，大早晨起来就吃了这么个苍蝇真影响心情！本文纯属个人发泄，如有得罪也就得罪了！但不希望各位乱加猜测联想，更不希望您自己没事找事对号入座！更谢绝其他媒体博友转载，省的又说炒作！怎么就都是炒作呢？？？？真烦！！！！！！！！！！！",[81,106,107,108],{},"  ",[109,110],"img",{"alt":64,"src":111},"\u002Fpic\u002F4af9831bt8c07ef88aa26.jpg",{"title":113,"searchDepth":114,"depth":114,"links":115},"",2,[],[6,9],"我原来以为博客是自己的！可弄了半天，是谁的我就不明白了？？？？？？","md",{"date":120},"2010-07-23 14:09",true,"\u002Fblog\u002Fblog_4af9831b0100kany",{"title":64,"description":117},"blog\u002Fblog_4af9831b0100kany",[126],"杂谈","cobesycnWxb326ZKWTNmfHhA5_wEz0s1FjkfAbLbx8o",[129,132],{"title":67,"path":130,"stem":131,"children":-1,"slug":68},"\u002Fblog\u002Fblog_4af9831b0100j000","blog\u002Fblog_4af9831b0100j000",{"title":61,"path":133,"stem":134,"children":-1,"slug":62},"\u002Fblog\u002Fblog_4af9831b0100kdse","blog\u002Fblog_4af9831b0100kdse",1794412499640]
[{"data":1,"prerenderedAt":134},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":57,"blog-post-slug-blog_4af9831b0100kany":74,"surround-blog_4af9831b0100kany":127},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":16,"site_description":54,"stem":55,"__hash__":56},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo","新浪博客内容备份(粉丝自用)","settings","jPD1QWrYwbaIixg6lntppEYe-T3ZGd3EJZxFBkbKY9E",{"latestBlog":58},[59,62,65,68,71],{"title":60,"slug":61},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":63,"slug":64},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":66,"slug":67},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":69,"slug":70},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":72,"slug":73},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":75,"title":63,"body":76,"categories":115,"description":116,"extension":117,"meta":118,"navigation":120,"path":121,"seo":122,"slug":64,"stem":123,"tags":124,"__hash__":126},"blog\u002Fblog\u002Fblog_4af9831b0100kany.md",{"type":77,"value":78,"toc":111},"minimark",[79,83,86,89,92,95,98,101,104],[80,81,82],"p",{},"好久没来了，一上来就说狠话不是很好，但没办法，不发泄一下不爽！",[80,84,85],{},"我在现场，听到一些事情觉得特别恼火，就借T姐的电脑发下牢骚————————",[80,87,88],{},"特别逗！我原来以为博客是自己的！可弄了半天，是谁的我就不明白了？？？？？？",[80,90,91],{},"曹老师昨天的一篇博客就这么被删掉了！她是好脾气我可不是！！！就是一次很简单的旅行，没想着宣什么传，本来就是个国内永远无法看到的片子！谢谢！！！",[80,93,94],{},"难道就因为留言里有骂声？就是所谓的不顾及自己形象？？就可以随便勒令我们艺人拿掉博客？？还要烦劳G小姐您亲自动手？？？？我觉得您真的是想的太多了！我们艺人本来就无所谓形象，您的那些形象不过是愚弄大众的假象！！！！",[80,96,97],{},"曹老师是个好孩子，她也许没有还手的力量但我绝不会没有响动——如此不讲情理的经济公司不要也罢！！否则时间长了我怕中国的艺人会效仿韩国自杀热的！我只想问凭什么？？？",[80,99,100],{},"我们不是卖给你们！谢谢！！！！！！！我们应当享有人身自由和私人空间！！！",[80,102,103],{},"今天本来是小罗汉首映的日子，大早晨起来就吃了这么个苍蝇真影响心情！本文纯属个人发泄，如有得罪也就得罪了！但不希望各位乱加猜测联想，更不希望您自己没事找事对号入座！更谢绝其他媒体博友转载，省的又说炒作！怎么就都是炒作呢？？？？真烦！！！！！！！！！！！",[80,105,106,107],{},"  ",[108,109],"img",{"alt":63,"src":110},"\u002Fpic\u002F4af9831bt8c07ef88aa26.jpg",{"title":112,"searchDepth":113,"depth":113,"links":114},"",2,[],[6,9],"我原来以为博客是自己的！可弄了半天，是谁的我就不明白了？？？？？？","md",{"date":119},"2010-07-23 14:09",true,"\u002Fblog\u002Fblog_4af9831b0100kany",{"title":63,"description":116},"blog\u002Fblog_4af9831b0100kany",[125],"杂谈","cobesycnWxb326ZKWTNmfHhA5_wEz0s1FjkfAbLbx8o",[128,131],{"title":66,"path":129,"stem":130,"children":-1,"slug":67},"\u002Fblog\u002Fblog_4af9831b0100j000","blog\u002Fblog_4af9831b0100j000",{"title":60,"path":132,"stem":133,"children":-1,"slug":61},"\u002Fblog\u002Fblog_4af9831b0100kdse","blog\u002Fblog_4af9831b0100kdse",1794473704227]
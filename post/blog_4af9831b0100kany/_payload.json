[{"data":1,"prerenderedAt":147},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":70,"blog-post-slug-blog_4af9831b0100kany":87,"surround-blog_4af9831b0100kany":140},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":45,"navLinks":46,"perPage":16,"prevNextIsExcludeDate":66,"site_description":23,"site_name":67,"stem":68,"__hash__":69},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{},[47,52,56,60,64],{"path":48,"title":49,"target":50,"fa_class":51},"\u002F","博客首页","internal","fa-home",{"path":53,"title":54,"target":50,"fa_class":55},"\u002Fabout","关于","fa-user",{"path":57,"title":58,"target":50,"fa_class":59},"\u002Fpost","归档","fa-archive",{"path":61,"title":62,"target":50,"fa_class":63},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":65,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","jvZHccz2rT-wjVS5GCPgWyhl8WnBIvECPkE5KpKFKCU",{"latestBlog":71},[72,75,78,81,84],{"title":73,"slug":74},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":76,"slug":77},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":79,"slug":80},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":82,"slug":83},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":85,"slug":86},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":88,"title":76,"body":89,"categories":128,"description":129,"extension":130,"meta":131,"navigation":133,"path":134,"seo":135,"slug":77,"stem":136,"tags":137,"__hash__":139},"blog\u002Fblog\u002Fblog_4af9831b0100kany.md",{"type":90,"value":91,"toc":124},"minimark",[92,96,99,102,105,108,111,114,117],[93,94,95],"p",{},"好久没来了，一上来就说狠话不是很好，但没办法，不发泄一下不爽！",[93,97,98],{},"我在现场，听到一些事情觉得特别恼火，就借T姐的电脑发下牢骚————————",[93,100,101],{},"特别逗！我原来以为博客是自己的！可弄了半天，是谁的我就不明白了？？？？？？",[93,103,104],{},"曹老师昨天的一篇博客就这么被删掉了！她是好脾气我可不是！！！就是一次很简单的旅行，没想着宣什么传，本来就是个国内永远无法看到的片子！谢谢！！！",[93,106,107],{},"难道就因为留言里有骂声？就是所谓的不顾及自己形象？？就可以随便勒令我们艺人拿掉博客？？还要烦劳G小姐您亲自动手？？？？我觉得您真的是想的太多了！我们艺人本来就无所谓形象，您的那些形象不过是愚弄大众的假象！！！！",[93,109,110],{},"曹老师是个好孩子，她也许没有还手的力量但我绝不会没有响动——如此不讲情理的经济公司不要也罢！！否则时间长了我怕中国的艺人会效仿韩国自杀热的！我只想问凭什么？？？",[93,112,113],{},"我们不是卖给你们！谢谢！！！！！！！我们应当享有人身自由和私人空间！！！",[93,115,116],{},"今天本来是小罗汉首映的日子，大早晨起来就吃了这么个苍蝇真影响心情！本文纯属个人发泄，如有得罪也就得罪了！但不希望各位乱加猜测联想，更不希望您自己没事找事对号入座！更谢绝其他媒体博友转载，省的又说炒作！怎么就都是炒作呢？？？？真烦！！！！！！！！！！！",[93,118,119,120],{},"  ",[121,122],"img",{"alt":76,"src":123},"\u002Fpic\u002F4af9831bt8c07ef88aa26.jpg",{"title":125,"searchDepth":126,"depth":126,"links":127},"",2,[],[6,9],"我原来以为博客是自己的！可弄了半天，是谁的我就不明白了？？？？？？","md",{"date":132},"2010-07-23 14:09",true,"\u002Fblog\u002Fblog_4af9831b0100kany",{"title":76,"description":129},"blog\u002Fblog_4af9831b0100kany",[138],"杂谈","cobesycnWxb326ZKWTNmfHhA5_wEz0s1FjkfAbLbx8o",[141,144],{"title":79,"path":142,"stem":143,"children":-1,"slug":80},"\u002Fblog\u002Fblog_4af9831b0100j000","blog\u002Fblog_4af9831b0100j000",{"title":73,"path":145,"stem":146,"children":-1,"slug":74},"\u002Fblog\u002Fblog_4af9831b0100kdse","blog\u002Fblog_4af9831b0100kdse",1794544666900]
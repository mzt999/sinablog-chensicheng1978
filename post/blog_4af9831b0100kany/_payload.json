[{"data":1,"prerenderedAt":94},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":17,"blog-post-slug-blog_4af9831b0100kany":34,"surround-blog_4af9831b0100kany":87},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"latestBlog":18},[19,22,25,28,31],{"title":20,"slug":21},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":23,"slug":24},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":26,"slug":27},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":29,"slug":30},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":32,"slug":33},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":35,"title":23,"body":36,"categories":75,"description":76,"extension":77,"meta":78,"navigation":80,"path":81,"seo":82,"slug":24,"stem":83,"tags":84,"__hash__":86},"blog\u002Fblog\u002Fblog_4af9831b0100kany.md",{"type":37,"value":38,"toc":71},"minimark",[39,43,46,49,52,55,58,61,64],[40,41,42],"p",{},"好久没来了，一上来就说狠话不是很好，但没办法，不发泄一下不爽！",[40,44,45],{},"我在现场，听到一些事情觉得特别恼火，就借T姐的电脑发下牢骚————————",[40,47,48],{},"特别逗！我原来以为博客是自己的！可弄了半天，是谁的我就不明白了？？？？？？",[40,50,51],{},"曹老师昨天的一篇博客就这么被删掉了！她是好脾气我可不是！！！就是一次很简单的旅行，没想着宣什么传，本来就是个国内永远无法看到的片子！谢谢！！！",[40,53,54],{},"难道就因为留言里有骂声？就是所谓的不顾及自己形象？？就可以随便勒令我们艺人拿掉博客？？还要烦劳G小姐您亲自动手？？？？我觉得您真的是想的太多了！我们艺人本来就无所谓形象，您的那些形象不过是愚弄大众的假象！！！！",[40,56,57],{},"曹老师是个好孩子，她也许没有还手的力量但我绝不会没有响动——如此不讲情理的经济公司不要也罢！！否则时间长了我怕中国的艺人会效仿韩国自杀热的！我只想问凭什么？？？",[40,59,60],{},"我们不是卖给你们！谢谢！！！！！！！我们应当享有人身自由和私人空间！！！",[40,62,63],{},"今天本来是小罗汉首映的日子，大早晨起来就吃了这么个苍蝇真影响心情！本文纯属个人发泄，如有得罪也就得罪了！但不希望各位乱加猜测联想，更不希望您自己没事找事对号入座！更谢绝其他媒体博友转载，省的又说炒作！怎么就都是炒作呢？？？？真烦！！！！！！！！！！！",[40,65,66,67],{},"  ",[68,69],"img",{"alt":23,"src":70},"\u002Fpic\u002F4af9831bt8c07ef88aa26.jpg",{"title":72,"searchDepth":73,"depth":73,"links":74},"",2,[],[6,9],"我原来以为博客是自己的！可弄了半天，是谁的我就不明白了？？？？？？","md",{"date":79},"2010-07-23 14:09",true,"\u002Fblog\u002Fblog_4af9831b0100kany",{"title":23,"description":76},"blog\u002Fblog_4af9831b0100kany",[85],"杂谈","cobesycnWxb326ZKWTNmfHhA5_wE
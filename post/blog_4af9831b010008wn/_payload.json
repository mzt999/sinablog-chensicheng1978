[{"data":1,"prerenderedAt":159},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":70,"blog-post-slug-blog_4af9831b010008wn":87,"surround-blog_4af9831b010008wn":148},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":45,"navLinks":46,"perPage":16,"prevNextIsExcludeDate":66,"site_description":23,"site_name":67,"stem":68,"__hash__":69},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{},[47,52,56,60,64],{"path":48,"title":49,"target":50,"fa_class":51},"\u002F","博客首页","internal","fa-home",{"path":53,"title":54,"target":50,"fa_class":55},"\u002Fabout","关于","fa-user",{"path":57,"title":58,"target":50,"fa_class":59},"\u002Fpost","归档","fa-archive",{"path":61,"title":62,"target":50,"fa_class":63},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":65,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","jvZHccz2rT-wjVS5GCPgWyhl8WnBIvECPkE5KpKFKCU",{"latestBlog":71},[72,75,78,81,84],{"title":73,"slug":74},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":76,"slug":77},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":79,"slug":80},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":82,"slug":83},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":85,"slug":86},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":88,"title":89,"body":90,"categories":137,"description":96,"extension":138,"meta":139,"navigation":141,"path":142,"seo":143,"slug":144,"stem":145,"tags":146,"__hash__":147},"blog\u002Fblog\u002Fblog_4af9831b010008wn.md","外婆",{"type":91,"value":92,"toc":133},"minimark",[93,97,100,103,106,109,112,115,118,121,124,127,130],[94,95,96],"p",{},"此刻,我在故乡, 沈阳. 为了外婆.",[94,98,99],{},"北方人叫外婆 \"姥\".  由于外婆胖 ,所以一直唤她\"胖姥\"或\"肥姥\".没有丝毫不尊,只是觉得这样的称谓才配得上外婆的可爱.以往每次的相见和暂别,我都会搂着她的脖子,在她肉肉的脸上狠狠亲上一口.外婆也早惯了这样的拥抱这样的\"吻别\",每次都会笑得灿烂如花,我和朋友说过外婆的笑容最像\"向日葵\"...",[94,101,102],{},"  可就在几个小时前,远远的看到病床上的她瘦得成了别人,还没敢走近,就忍不住哭了出来.好久没这样痛快的哭过了...好久...",[94,104,105],{},"爷爷奶奶早逝,我从小就被外婆带大.记忆中的几个情景总不会忘:幼儿园下课后的我会在一排柳树中躲藏穿梭,故意让外婆见不到我.直至偷瞄到她真的着急,四处寻找叫喊的样子才心满意足的走出来...小学时的我总会背着妈妈偷偷的向外婆要零花钱,我会骗她我要吃或要喝,这样每次都会得到2毛钱.我就在不影响\"日常消费\"的情况下把这2毛积攒着,等攒到1元时,再买一种叫\"PIA\nJI\"的玩具去和别的同学斗.那时自己的技术不精,总是先赢后输,就等输光后再向外婆要\"2毛钱\"...初中时印象最深的是块\"生日蛋糕\".北京的亲戚给外婆的生日从北京带来了蛋糕,那蛋糕的好吃无以言表.可孩子多,每人只能分到一小块.我不是老大.也不是老幺,没任何特权,却又最馋.这些外婆都知道.我们眼巴巴的看着剩的不多的蛋糕,她却把盒子盖上,就说剩下的都是自己的了.可第二天我独去的时候,她又悄悄的从床下拉出那盒子,把剩下的蛋糕让我吃.那蛋糕的大小和形状我记得一清二楚,她一口都没碰...我兴奋的把它放入嘴里.可惜,蛋糕放了一夜,酸了...",[94,107,108],{},"  我很清楚外婆要走了,这一别的时间要比以往的每次都长.我不忍,却无能为力.人的渺小在此刻被无限放大,你甚至不能用你的一年或更多的时间来换她的一天...尽管以前就明白,能陪自己走到终点的人只有自己.但真正面对分离还是痛.",[94,110,111],{},"4月15日,外婆的生日.因为\"子弹\"我没有参加.真没想到,这一切突如其来.后悔,无用.子弹!又杀了我一次!",[94,113,114],{},"外婆信基督.所以我深信她要去的地方一定比这世界更温暖更明亮.外婆的善良绝不会消失,我会一直在空气中汲取她留给我的讯息,拼命恪守她\"向善\"的信条.我知道我以后的路她也会陪着我,会用不同世界的关注寄予我同样的关怀...",[94,116,117],{},"明天就要回湖南.我不能也不愿不想等到和她分别的那个时刻.",[94,119,120],{},"我告诉自己说,她没走,不会走.爱我的人我爱的人都不会走.分离,只是暂时的,和以前一样...既然没有永久的相聚,那也不会有永久的分离!!!!!!!!!!!!!!!!!!!!",[94,122,123],{},"定会有轮回,下辈子,还是亲人...",[94,125,126],{},"谁说过,身边的一个人不在了.空中就会多一颗星星.今晚的夜空,星星很多.",[94,128,129],{},"胖姥,不用怕.你不会迷路,外孙会找到你,会看到那颗最亮的星星,因为那颗星星也一定胖得很可爱...",[94,131,132],{},"我爱你,姥姥!见到姥爷给他问好!无论在哪都要幸福啊!答应我!外婆...",{"title":134,"searchDepth":135,"depth":135,"links":136},"",2,[],[6],"md",{"date":140},"2007-06-18 04:08",true,"\u002Fblog\u002Fblog_4af9831b010008wn",{"title":89,"description":96},"blog_4af9831b010008wn","blog\u002Fblog_4af9831b010008wn",[],"WwkCUs96FUeFrnZhDSKLYTRYLnQG1TvXDDhhpCHM2-I",[149,154],{"title":150,"path":151,"stem":152,"children":-1,"slug":153},"女人这东西","\u002Fblog\u002Fblog_4af9831b010008rl","blog\u002Fblog_4af9831b010008rl","blog_4af9831b010008rl",{"title":155,"path":156,"stem":157,"children":-1,"slug":158},"0.03克","\u002Fblog\u002Fblog_4af9831b0100096m","blog\u002Fblog_4af9831b0100096m","blog_4af9831b0100096m",1794544668060]
[{"data":1,"prerenderedAt":165},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":76,"blog-post-slug-blog_4af9831b010008wn":93,"surround-blog_4af9831b010008wn":154},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":38,"meta":50,"navLinks":51,"perPage":16,"prevNextIsExcludeDate":71,"site_description":72,"site_name":73,"stem":74,"__hash__":75},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,26,32],{"text":23},"粉丝自制非官方站点｜素材版权归原权利人所有",{"text":25},"仅兴趣交流、无商业用途｜如有侵权请联系删除",{"text":27,"link":28},"查看",{"href":29,"text":30,"fa_class":31},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":33,"link":34},"如有任何疑问，欢迎",{"href":35,"text":36,"fa_class":37},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[39,42,45,47],{"href":40,"text":41},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":43,"text":44},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":46},"新浪微博备份(2009-2026)",{"href":48,"text":49},"https:\u002F\u002Fmzt999.github.io\u002Fportfolio-chensicheng1978","幕后作品集展示(2012-2026)",{},[52,57,61,65,69],{"path":53,"title":54,"target":55,"fa_class":56},"\u002F","博客首页","internal","fa-home",{"path":58,"title":59,"target":55,"fa_class":60},"\u002Fabout","关于","fa-user",{"path":62,"title":63,"target":55,"fa_class":64},"\u002Fpost","归档","fa-archive",{"path":66,"title":67,"target":55,"fa_class":68},"\u002Fgallery","相册","fa-image",{"path":29,"title":30,"target":70,"fa_class":31},"otherSite",false,"新浪博客内容备份(粉丝自用)","陈思诚的博客","settings","5S7xKt0XLHpkjipbomx4I7pUu50Y7wqtD418LquZj5Q",{"latestBlog":77},[78,81,84,87,90],{"title":79,"slug":80},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":82,"slug":83},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":85,"slug":86},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":88,"slug":89},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":91,"slug":92},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":94,"title":95,"body":96,"categories":143,"description":102,"extension":144,"meta":145,"navigation":147,"path":148,"seo":149,"slug":150,"stem":151,"tags":152,"__hash__":153},"blog\u002Fblog\u002Fblog_4af9831b010008wn.md","外婆",{"type":97,"value":98,"toc":139},"minimark",[99,103,106,109,112,115,118,121,124,127,130,133,136],[100,101,102],"p",{},"此刻,我在故乡, 沈阳. 为了外婆.",[100,104,105],{},"北方人叫外婆 \"姥\".  由于外婆胖 ,所以一直唤她\"胖姥\"或\"肥姥\".没有丝毫不尊,只是觉得这样的称谓才配得上外婆的可爱.以往每次的相见和暂别,我都会搂着她的脖子,在她肉肉的脸上狠狠亲上一口.外婆也早惯了这样的拥抱这样的\"吻别\",每次都会笑得灿烂如花,我和朋友说过外婆的笑容最像\"向日葵\"...",[100,107,108],{},"  可就在几个小时前,远远的看到病床上的她瘦得成了别人,还没敢走近,就忍不住哭了出来.好久没这样痛快的哭过了...好久...",[100,110,111],{},"爷爷奶奶早逝,我从小就被外婆带大.记忆中的几个情景总不会忘:幼儿园下课后的我会在一排柳树中躲藏穿梭,故意让外婆见不到我.直至偷瞄到她真的着急,四处寻找叫喊的样子才心满意足的走出来...小学时的我总会背着妈妈偷偷的向外婆要零花钱,我会骗她我要吃或要喝,这样每次都会得到2毛钱.我就在不影响\"日常消费\"的情况下把这2毛积攒着,等攒到1元时,再买一种叫\"PIA\nJI\"的玩具去和别的同学斗.那时自己的技术不精,总是先赢后输,就等输光后再向外婆要\"2毛钱\"...初中时印象最深的是块\"生日蛋糕\".北京的亲戚给外婆的生日从北京带来了蛋糕,那蛋糕的好吃无以言表.可孩子多,每人只能分到一小块.我不是老大.也不是老幺,没任何特权,却又最馋.这些外婆都知道.我们眼巴巴的看着剩的不多的蛋糕,她却把盒子盖上,就说剩下的都是自己的了.可第二天我独去的时候,她又悄悄的从床下拉出那盒子,把剩下的蛋糕让我吃.那蛋糕的大小和形状我记得一清二楚,她一口都没碰...我兴奋的把它放入嘴里.可惜,蛋糕放了一夜,酸了...",[100,113,114],{},"  我很清楚外婆要走了,这一别的时间要比以往的每次都长.我不忍,却无能为力.人的渺小在此刻被无限放大,你甚至不能用你的一年或更多的时间来换她的一天...尽管以前就明白,能陪自己走到终点的人只有自己.但真正面对分离还是痛.",[100,116,117],{},"4月15日,外婆的生日.因为\"子弹\"我没有参加.真没想到,这一切突如其来.后悔,无用.子弹!又杀了我一次!",[100,119,120],{},"外婆信基督.所以我深信她要去的地方一定比这世界更温暖更明亮.外婆的善良绝不会消失,我会一直在空气中汲取她留给我的讯息,拼命恪守她\"向善\"的信条.我知道我以后的路她也会陪着我,会用不同世界的关注寄予我同样的关怀...",[100,122,123],{},"明天就要回湖南.我不能也不愿不想等到和她分别的那个时刻.",[100,125,126],{},"我告诉自己说,她没走,不会走.爱我的人我爱的人都不会走.分离,只是暂时的,和以前一样...既然没有永久的相聚,那也不会有永久的分离!!!!!!!!!!!!!!!!!!!!",[100,128,129],{},"定会有轮回,下辈子,还是亲人...",[100,131,132],{},"谁说过,身边的一个人不在了.空中就会多一颗星星.今晚的夜空,星星很多.",[100,134,135],{},"胖姥,不用怕.你不会迷路,外孙会找到你,会看到那颗最亮的星星,因为那颗星星也一定胖得很可爱...",[100,137,138],{},"我爱你,姥姥!见到姥爷给他问好!无论在哪都要幸福啊!答应我!外婆...",{"title":140,"searchDepth":141,"depth":141,"links":142},"",2,[],[6],"md",{"date":146},"2007-06-18 04:08",true,"\u002Fblog\u002Fblog_4af9831b010008wn",{"title":95,"description":102},"blog_4af9831b010008wn","blog\u002Fblog_4af9831b010008wn",[],"WwkCUs96FUeFrnZhDSKLYTRYLnQG1TvXDDhhpCHM2-I",[155,160],{"title":156,"path":157,"stem":158,"children":-1,"slug":159},"女人这东西","\u002Fblog\u002Fblog_4af9831b010008rl","blog\u002Fblog_4af9831b010008rl","blog_4af9831b010008rl",{"title":161,"path":162,"stem":163,"children":-1,"slug":164},"0.03克","\u002Fblog\u002Fblog_4af9831b0100096m","blog\u002Fblog_4af9831b0100096m","blog_4af9831b0100096m",1795162026203]
[{"data":1,"prerenderedAt":206},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":70,"blog-post-slug-blog_4af9831b0100de35":87,"surround-blog_4af9831b0100de35":195},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":45,"navLinks":46,"perPage":16,"prevNextIsExcludeDate":66,"site_description":23,"site_name":67,"stem":68,"__hash__":69},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{},[47,52,56,60,64],{"path":48,"title":49,"target":50,"fa_class":51},"\u002F","博客首页","internal","fa-home",{"path":53,"title":54,"target":50,"fa_class":55},"\u002Fabout","关于","fa-user",{"path":57,"title":58,"target":50,"fa_class":59},"\u002Fpost","归档","fa-archive",{"path":61,"title":62,"target":50,"fa_class":63},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":65,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","jvZHccz2rT-wjVS5GCPgWyhl8WnBIvECPkE5KpKFKCU",{"latestBlog":71},[72,75,78,81,84],{"title":73,"slug":74},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":76,"slug":77},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":79,"slug":80},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":82,"slug":83},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":85,"slug":86},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":88,"title":89,"body":90,"categories":180,"description":102,"extension":181,"meta":182,"navigation":184,"path":185,"seo":186,"slug":187,"stem":188,"tags":189,"__hash__":194},"blog\u002Fblog\u002Fblog_4af9831b0100de35.md","背影，前行……",{"type":91,"value":92,"toc":176},"minimark",[93,100,103,106,109,112,115,118,121,124,127],[94,95,96],"p",{},[97,98],"img",{"alt":89,"src":99},"\u002Fpic\u002F4af9831bt6ab72949fc77.jpg",[94,101,102],{},"站在嘎纳电影节的红毯上,梦一般闪亮的瞬间.它会永远定格在我生命的旅程中…",[94,104,105],{},"我更看到了自己的不足,看到了自己终将经历的苦痛.",[94,107,108],{},"真正到达天堂的路,必经过地狱。那是勇者的游戏，很明显,自己做得还不够… 我还有太多要学习，太多要感受……",[94,110,111],{},"此次电影节的海报，如同我的心情，一个梦想的背影让我看到，我必须加倍努力去追逐，否则，只有越来越远，最终会消失在我的视线……",[94,113,114],{},"无论如何，还好……有梦，有朋友。",[94,116,117],{},"感谢“士兵系”的兄弟们为我加油，宝强晨儿张译……更感谢冰冰姐，泉哥，大芸豆和我公司如家人般的团队……",[94,119,120],{},"这座海边小城的一切和电影息息相关,空气中都是静谧的味道。无论如何拥挤，心都是静的，人都是轻的……",[94,122,123],{},"我看不到宿命，不知此生和她有几次交汇，但就自己而言，我是在前行，我更加要前行……",[94,125,126],{},"附：衣食住行IN嘎纳",[94,128,129,130,133,134,136,137,139,140,142,143,145,146,148,149,151,152,154,155,157,158,160,161,163,164,166,167,169,170,172,173,175],{},"贵!",[131,132],"br",{},"\n是到达嘎纳后所有衣食住行消费的第一感受。",[131,135],{},"\n尼斯本就是法国南部的度假天堂、欧洲富人的休闲集散地.港口停泊的各国私人游艇和马路上各式说不出名字的豪华汽车便是最好佐证. ",[131,138],{},"正逢嘎纳电影节期间,各商贩更是憋足劲狠赚一笔世界人民的血汗钱.投机的心理可以理解,如同我们的奥运会宾馆涨价.",[131,141],{},"\n(以下计价单位为折合后的人民币)",[131,144],{},"\n住：我们住的是6000元一晚的公寓.四星.但陈旧.这种规模在国内不会高过5000元，还是一个月.此刻的嘎纳就是如此，爱住不住……露宿街头搭帐篷？好主意！但是不允许！",[131,147],{},"\n食：本着勤俭持家的大方针,刚下飞机的第一餐是经纪人小简煮的康师傅方便面,佐餐的是国内的泡椒凤爪和超市买来5元一个的法兰西鸡蛋。沐浴着嘎纳的春风，在纪总监的提议下,我们还小酌了一瓶30元的啤酒。为了调整心态，我们对自己说全当是在夜场消费。可吃着吃着还是感叹这法国鸡蛋比国内鸡蛋昂贵数倍.我们的鸡真可怜….",[131,150],{},"\n说到酒,有便宜的.法国产红酒,所以超市里能找到30元的红酒,这在国内是不可能的…",[131,153],{},"\n接下来的几天，我们忍受这各种难吃的法国菜，昂贵且味道怪异。就连麦当劳也没有国内的可口。除了电影节几次免费的晚宴还乏善可陈，其他的饭基本引来大家的怨声载道！百般饥饿后去找中餐，四个人吃了1000多块，别以为会有鲍鱼鱼翅，全是最简单的家常菜。宫保鸡丁150元，素炒西兰花120元，爆炒牛肉200元，家常豆腐80元……最便宜的是米饭，20元……一碗……",[131,156],{},"\n嘎纳的中餐还有两大特点有别于国内：一：难吃 二：量小",[131,159],{},"\n但好歹也是中餐，我们已经无欲无求了……",[131,162],{},"\n几天下来后，就吃的方面我们大家的意见基本相近，就是比较同情法国人……看着他们在阳光下，怡然自得品酒吃饭的样子，真是觉得他们在口福方面的造诣与国人们比相差太远……我想到了火锅，想到了烤鸭，想到了四大菜系满汉全席……能香死他们……",[131,165],{},"\n衣：也有便宜的。和国内比，要说便宜的是奢侈品和大名牌。普通的衣服别看，绝不会比动物园秀水街便宜，且搞不好满心欢喜的买回去一看就是made in China……",[131,168],{},"\n要买就买LV，CHANAL,买GUCCI……普遍比国内便宜百分之30到40 ，尤其此刻的经济危机。",[131,171],{},"\n行：要说最便宜的该是行！嘎纳不大，很小。我们所有的交通工具是脚。除了特别的需要是电影节派的车，我们总在走来走去……",[131,174],{},"\n最深刻的印象还是嘎纳的阳光，海滩，和那精密的气质和人们对电影对艺术发自内心的尊重……关于这些，后面再和你们细说……",{"title":177,"searchDepth":178,"depth":178,"links":179},"",2,[],[6,9],"md",{"date":183},"2009-05-25 14:56",true,"\u002Fblog\u002Fblog_4af9831b0100de35",{"title":89,"description":102},"blog_4af9831b0100de35","blog\u002Fblog_4af9831b0100de35",[190,191,192,193],"戛纳","陈思成","春风沉醉的晚上","杂谈","L6-jkyxmgSO6c9LpwV653_9bQbZlQ82TyTibtOQv0j4",[196,201],{"title":197,"path":198,"stem":199,"children":-1,"slug":200},"春风沉醉嘎纳未醒 寒梅续放横店亦然","\u002Fblog\u002Fblog_4af9831b0100dbqn","blog\u002Fblog_4af9831b0100dbqn","blog_4af9831b0100dbqn",{"title":202,"path":203,"stem":204,"children":-1,"slug":205},"《春风》获奖印证华语电影的春天","\u002Fblog\u002Fblog_4af9831b0100dgqa","blog\u002Fblog_4af9831b0100dgqa","blog_4af9831b0100dgqa",1794544667226]
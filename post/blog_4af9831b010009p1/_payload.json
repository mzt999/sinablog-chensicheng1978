[{"data":1,"prerenderedAt":180},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":58,"blog-post-slug-blog_4af9831b010009p1":75,"surround-blog_4af9831b010009p1":169},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":54,"site_description":55,"stem":56,"__hash__":57},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo",20,"新浪博客内容备份","settings","hh8X7X6SFDoeJrxIJ4yisZXSc3HwHM1zk206jiQX2XU",{"latestBlog":59},[60,63,66,69,72],{"title":61,"slug":62},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":64,"slug":65},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":67,"slug":68},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":70,"slug":71},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":73,"slug":74},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":76,"title":77,"body":78,"categories":157,"description":84,"extension":158,"meta":159,"navigation":161,"path":162,"seo":163,"slug":164,"stem":165,"tags":166,"__hash__":168},"blog\u002Fblog\u002Fblog_4af9831b010009p1.md","我",{"type":79,"value":80,"toc":153},"minimark",[81,85,88,91,94,97,100,103,106,109,112,115,118,121,127,132,135,138,141,144,147,150],[82,83,84],"p",{},"上来看到诸多留言,感动.真的,感动.",[82,86,87],{},"刚刚和\"小鬼\"聊了一会儿,也问我同样的问题.",[82,89,90],{},"\"陈思成同学,不觉得自己太张扬了吗?不应该更亲民更朴素更内敛些吗?\"",[82,92,93],{},"哈哈,真的爱你们.喜欢我这样,不喜欢我这样,惟恐我不这样,担心我这样的朋友们.",[82,95,96],{},"还有个朋友今天信息问我:现在更感谢看重我的人,还是那些看轻我的人.",[82,98,99],{},"我的回答,没有看重或看轻,只要看到,就已然是幸福了.至少,你们的眼里有我.",[82,101,102],{},"毕业至今,还是第一次感到那么幸福的可以结识诸多朋友.张译同志在重庆的一次访问中说的一句话当时让我捏汗,可事实那也是我所想:爱\"士兵\"的人不会是坏人!爱\"士兵\"的人一定是有激情有理想有爱的人.否则,怎会爱\"士兵\"?",[82,104,105],{},"所以,只要爱\"士兵\"就好了,为什么一定让别人爱我呢?",[82,107,108],{},"小鬼还说,你不觉得你的博客也太随性太自我了吗?",[82,110,111],{},"我回答,博客不该是如此吗?别人的如何与我无关,我的博客最大的意义是要在N年后的那个我可以随时翻出现在的这个我此时的所思所想,所喜所悲.我的博客写给自己!和那些懂我的人!所以我写的东西没有作秀,完全一气呵成,甚至连错别字都不会检查的.",[82,113,114],{},"有什么比\"真实\"更具力量呢?",[82,116,117],{},"再说回\"我\"的问题:",[82,119,120],{},"以下是两个朋友的在博客的留言:",[82,122,123],{},[124,125,126],"em",{},"1有潜力，还要有机遇，讨人喜欢的性格是块敲门砖，别太自负，至少装出谦虚的样子也好。",[82,128,129],{},[124,130,131],{},"2一直以为你是外在多于内涵的男孩子，包括你的穿着举止无不是偶像派的作风，可是关注你这么久，才发现，真的人不可貌相，海水不可斗量。你的外表内心反差之大，着实少见。",[82,133,134],{},"如果你愿意，完全可以做出多数人渴望的表向:安静、温柔、朴素、细心。会赢得更多的人气。到什么时候，女孩子都喜欢这样的",[82,136,137],{},"真的很感动,感动你们能这样为我着想.真的.现在的世界忙碌的我们能看到周遭就已经很不容易了,你们,还能看到远处的我...谢谢.",[82,139,140],{},"可是,要说可是.我真的要变吗?要装扮吗?你们会喜欢一个粉饰过的人吗?",[82,142,143],{},"我的阳光是我,我的忧郁是我,我的笑是我,我的泪是我,我的举手投足是我,甚至我的装酷扮帅也是我,只要是真的我,不就好了?因为你们讨厌的是我,喜欢的也是我,对吗?",[82,145,146],{},"我们为何来到这个世界?坚持到底具有怎样的力量?我们不是在找我们自己吗?既然找到了,\"他\"又不是很坏,那何必要去装扮\"他\"呢?",[82,148,149],{},"耳边响起偶像张国荣的\"我\"...",[82,151,152],{},"...我就是我,是最不一样的烟火,天空海阔,做最坚强的泡沫...",{"title":154,"searchDepth":155,"depth":155,"links":156},"",2,[],[6],"md",{"date":160},"2007-08-05 02:39",true,"\u002Fblog\u002Fblog_4af9831b010009p1",{"title":77,"description":84},"blog_4af9831b010009p1","blog\u002Fblog_4af9831b010009p1",[167],"随笔\u002F感悟","3wrrbyoqXxEUSQ0Y0RxLrFBdVCnBp4K5NoQ-hqDvshg",[170,175],{"title":171,"path":172,"stem":173,"children":-1,"slug":174},"下楼 吃饭","\u002Fblog\u002Fblog_4af9831b010009nt","blog\u002Fblog_4af9831b010009nt","blog_4af9831b010009nt",{"title":176,"path":177,"stem":178,"children":-1,"slug":179},"下一战...","\u002Fblog\u002Fblog_4af9831b010009q8","blog\u002Fblog_4af9831b010009q8","blog_4af9831b010009q8",1794412501123]
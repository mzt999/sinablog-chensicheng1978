[{"data":1,"prerenderedAt":195},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":73,"blog-post-slug-blog_4af9831b010009p1":90,"surround-blog_4af9831b010009p1":184},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":48,"navLinks":49,"perPage":16,"prevNextIsExcludeDate":69,"site_description":23,"site_name":70,"stem":71,"__hash__":72},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43,45],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{"href":46,"text":47},"https:\u002F\u002Fmzt999.github.io\u002Fportfolio-chensicheng1978","幕后作品集展示(2012-2026)",{},[50,55,59,63,67],{"path":51,"title":52,"target":53,"fa_class":54},"\u002F","博客首页","internal","fa-home",{"path":56,"title":57,"target":53,"fa_class":58},"\u002Fabout","关于","fa-user",{"path":60,"title":61,"target":53,"fa_class":62},"\u002Fpost","归档","fa-archive",{"path":64,"title":65,"target":53,"fa_class":66},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":68,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","LA_7Y82F2zjQ6-R2_tcWHl356krYL76uqQHBCIU8UZk",{"latestBlog":74},[75,78,81,84,87],{"title":76,"slug":77},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":79,"slug":80},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":82,"slug":83},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":85,"slug":86},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":88,"slug":89},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":91,"title":92,"body":93,"categories":172,"description":99,"extension":173,"meta":174,"navigation":176,"path":177,"seo":178,"slug":179,"stem":180,"tags":181,"__hash__":183},"blog\u002Fblog\u002Fblog_4af9831b010009p1.md","我",{"type":94,"value":95,"toc":168},"minimark",[96,100,103,106,109,112,115,118,121,124,127,130,133,136,142,147,150,153,156,159,162,165],[97,98,99],"p",{},"上来看到诸多留言,感动.真的,感动.",[97,101,102],{},"刚刚和\"小鬼\"聊了一会儿,也问我同样的问题.",[97,104,105],{},"\"陈思成同学,不觉得自己太张扬了吗?不应该更亲民更朴素更内敛些吗?\"",[97,107,108],{},"哈哈,真的爱你们.喜欢我这样,不喜欢我这样,惟恐我不这样,担心我这样的朋友们.",[97,110,111],{},"还有个朋友今天信息问我:现在更感谢看重我的人,还是那些看轻我的人.",[97,113,114],{},"我的回答,没有看重或看轻,只要看到,就已然是幸福了.至少,你们的眼里有我.",[97,116,117],{},"毕业至今,还是第一次感到那么幸福的可以结识诸多朋友.张译同志在重庆的一次访问中说的一句话当时让我捏汗,可事实那也是我所想:爱\"士兵\"的人不会是坏人!爱\"士兵\"的人一定是有激情有理想有爱的人.否则,怎会爱\"士兵\"?",[97,119,120],{},"所以,只要爱\"士兵\"就好了,为什么一定让别人爱我呢?",[97,122,123],{},"小鬼还说,你不觉得你的博客也太随性太自我了吗?",[97,125,126],{},"我回答,博客不该是如此吗?别人的如何与我无关,我的博客最大的意义是要在N年后的那个我可以随时翻出现在的这个我此时的所思所想,所喜所悲.我的博客写给自己!和那些懂我的人!所以我写的东西没有作秀,完全一气呵成,甚至连错别字都不会检查的.",[97,128,129],{},"有什么比\"真实\"更具力量呢?",[97,131,132],{},"再说回\"我\"的问题:",[97,134,135],{},"以下是两个朋友的在博客的留言:",[97,137,138],{},[139,140,141],"em",{},"1有潜力，还要有机遇，讨人喜欢的性格是块敲门砖，别太自负，至少装出谦虚的样子也好。",[97,143,144],{},[139,145,146],{},"2一直以为你是外在多于内涵的男孩子，包括你的穿着举止无不是偶像派的作风，可是关注你这么久，才发现，真的人不可貌相，海水不可斗量。你的外表内心反差之大，着实少见。",[97,148,149],{},"如果你愿意，完全可以做出多数人渴望的表向:安静、温柔、朴素、细心。会赢得更多的人气。到什么时候，女孩子都喜欢这样的",[97,151,152],{},"真的很感动,感动你们能这样为我着想.真的.现在的世界忙碌的我们能看到周遭就已经很不容易了,你们,还能看到远处的我...谢谢.",[97,154,155],{},"可是,要说可是.我真的要变吗?要装扮吗?你们会喜欢一个粉饰过的人吗?",[97,157,158],{},"我的阳光是我,我的忧郁是我,我的笑是我,我的泪是我,我的举手投足是我,甚至我的装酷扮帅也是我,只要是真的我,不就好了?因为你们讨厌的是我,喜欢的也是我,对吗?",[97,160,161],{},"我们为何来到这个世界?坚持到底具有怎样的力量?我们不是在找我们自己吗?既然找到了,\"他\"又不是很坏,那何必要去装扮\"他\"呢?",[97,163,164],{},"耳边响起偶像张国荣的\"我\"...",[97,166,167],{},"...我就是我,是最不一样的烟火,天空海阔,做最坚强的泡沫...",{"title":169,"searchDepth":170,"depth":170,"links":171},"",2,[],[6],"md",{"date":175},"2007-08-05 02:39",true,"\u002Fblog\u002Fblog_4af9831b010009p1",{"title":92,"description":99},"blog_4af9831b010009p1","blog\u002Fblog_4af9831b010009p1",[182],"随笔\u002F感悟","3wrrbyoqXxEUSQ0Y0RxLrFBdVCnBp4K5NoQ-hqDvshg",[185,190],{"title":186,"path":187,"stem":188,"children":-1,"slug":189},"下楼 吃饭","\u002Fblog\u002Fblog_4af9831b010009nt","blog\u002Fblog_4af9831b010009nt","blog_4af9831b010009nt",{"title":191,"path":192,"stem":193,"children":-1,"slug":194},"下一战...","\u002Fblog\u002Fblog_4af9831b010009q8","blog\u002Fblog_4af9831b010009q8","blog_4af9831b010009q8",1794760532431]
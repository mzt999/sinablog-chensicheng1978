[{"data":1,"prerenderedAt":192},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":70,"blog-post-slug-blog_4af9831b010009p1":87,"surround-blog_4af9831b010009p1":181},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":45,"navLinks":46,"perPage":16,"prevNextIsExcludeDate":66,"site_description":23,"site_name":67,"stem":68,"__hash__":69},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{},[47,52,56,60,64],{"path":48,"title":49,"target":50,"fa_class":51},"\u002F","博客首页","internal","fa-home",{"path":53,"title":54,"target":50,"fa_class":55},"\u002Fabout","关于","fa-user",{"path":57,"title":58,"target":50,"fa_class":59},"\u002Fpost","归档","fa-archive",{"path":61,"title":62,"target":50,"fa_class":63},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":65,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","jvZHccz2rT-wjVS5GCPgWyhl8WnBIvECPkE5KpKFKCU",{"latestBlog":71},[72,75,78,81,84],{"title":73,"slug":74},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":76,"slug":77},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":79,"slug":80},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":82,"slug":83},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":85,"slug":86},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":88,"title":89,"body":90,"categories":169,"description":96,"extension":170,"meta":171,"navigation":173,"path":174,"seo":175,"slug":176,"stem":177,"tags":178,"__hash__":180},"blog\u002Fblog\u002Fblog_4af9831b010009p1.md","我",{"type":91,"value":92,"toc":165},"minimark",[93,97,100,103,106,109,112,115,118,121,124,127,130,133,139,144,147,150,153,156,159,162],[94,95,96],"p",{},"上来看到诸多留言,感动.真的,感动.",[94,98,99],{},"刚刚和\"小鬼\"聊了一会儿,也问我同样的问题.",[94,101,102],{},"\"陈思成同学,不觉得自己太张扬了吗?不应该更亲民更朴素更内敛些吗?\"",[94,104,105],{},"哈哈,真的爱你们.喜欢我这样,不喜欢我这样,惟恐我不这样,担心我这样的朋友们.",[94,107,108],{},"还有个朋友今天信息问我:现在更感谢看重我的人,还是那些看轻我的人.",[94,110,111],{},"我的回答,没有看重或看轻,只要看到,就已然是幸福了.至少,你们的眼里有我.",[94,113,114],{},"毕业至今,还是第一次感到那么幸福的可以结识诸多朋友.张译同志在重庆的一次访问中说的一句话当时让我捏汗,可事实那也是我所想:爱\"士兵\"的人不会是坏人!爱\"士兵\"的人一定是有激情有理想有爱的人.否则,怎会爱\"士兵\"?",[94,116,117],{},"所以,只要爱\"士兵\"就好了,为什么一定让别人爱我呢?",[94,119,120],{},"小鬼还说,你不觉得你的博客也太随性太自我了吗?",[94,122,123],{},"我回答,博客不该是如此吗?别人的如何与我无关,我的博客最大的意义是要在N年后的那个我可以随时翻出现在的这个我此时的所思所想,所喜所悲.我的博客写给自己!和那些懂我的人!所以我写的东西没有作秀,完全一气呵成,甚至连错别字都不会检查的.",[94,125,126],{},"有什么比\"真实\"更具力量呢?",[94,128,129],{},"再说回\"我\"的问题:",[94,131,132],{},"以下是两个朋友的在博客的留言:",[94,134,135],{},[136,137,138],"em",{},"1有潜力，还要有机遇，讨人喜欢的性格是块敲门砖，别太自负，至少装出谦虚的样子也好。",[94,140,141],{},[136,142,143],{},"2一直以为你是外在多于内涵的男孩子，包括你的穿着举止无不是偶像派的作风，可是关注你这么久，才发现，真的人不可貌相，海水不可斗量。你的外表内心反差之大，着实少见。",[94,145,146],{},"如果你愿意，完全可以做出多数人渴望的表向:安静、温柔、朴素、细心。会赢得更多的人气。到什么时候，女孩子都喜欢这样的",[94,148,149],{},"真的很感动,感动你们能这样为我着想.真的.现在的世界忙碌的我们能看到周遭就已经很不容易了,你们,还能看到远处的我...谢谢.",[94,151,152],{},"可是,要说可是.我真的要变吗?要装扮吗?你们会喜欢一个粉饰过的人吗?",[94,154,155],{},"我的阳光是我,我的忧郁是我,我的笑是我,我的泪是我,我的举手投足是我,甚至我的装酷扮帅也是我,只要是真的我,不就好了?因为你们讨厌的是我,喜欢的也是我,对吗?",[94,157,158],{},"我们为何来到这个世界?坚持到底具有怎样的力量?我们不是在找我们自己吗?既然找到了,\"他\"又不是很坏,那何必要去装扮\"他\"呢?",[94,160,161],{},"耳边响起偶像张国荣的\"我\"...",[94,163,164],{},"...我就是我,是最不一样的烟火,天空海阔,做最坚强的泡沫...",{"title":166,"searchDepth":167,"depth":167,"links":168},"",2,[],[6],"md",{"date":172},"2007-08-05 02:39",true,"\u002Fblog\u002Fblog_4af9831b010009p1",{"title":89,"description":96},"blog_4af9831b010009p1","blog\u002Fblog_4af9831b010009p1",[179],"随笔\u002F感悟","3wrrbyoqXxEUSQ0Y0RxLrFBdVCnBp4K5NoQ-hqDvshg",[182,187],{"title":183,"path":184,"stem":185,"children":-1,"slug":186},"下楼 吃饭","\u002Fblog\u002Fblog_4af9831b010009nt","blog\u002Fblog_4af9831b010009nt","blog_4af9831b010009nt",{"title":188,"path":189,"stem":190,"children":-1,"slug":191},"下一战...","\u002Fblog\u002Fblog_4af9831b010009q8","blog\u002Fblog_4af9831b010009q8","blog_4af9831b010009q8",1794546770362]
[{"data":1,"prerenderedAt":187},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":70,"blog-post-slug-blog_4af9831b0100b4mx":87,"surround-blog_4af9831b0100b4mx":176},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":45,"navLinks":46,"perPage":16,"prevNextIsExcludeDate":66,"site_description":23,"site_name":67,"stem":68,"__hash__":69},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{},[47,52,56,60,64],{"path":48,"title":49,"target":50,"fa_class":51},"\u002F","博客首页","internal","fa-home",{"path":53,"title":54,"target":50,"fa_class":55},"\u002Fabout","关于","fa-user",{"path":57,"title":58,"target":50,"fa_class":59},"\u002Fpost","归档","fa-archive",{"path":61,"title":62,"target":50,"fa_class":63},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":65,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","jvZHccz2rT-wjVS5GCPgWyhl8WnBIvECPkE5KpKFKCU",{"latestBlog":71},[72,75,78,81,84],{"title":73,"slug":74},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":76,"slug":77},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":79,"slug":80},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":82,"slug":83},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":85,"slug":86},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":88,"title":89,"body":90,"categories":164,"description":108,"extension":165,"meta":166,"navigation":168,"path":169,"seo":170,"slug":171,"stem":172,"tags":173,"__hash__":175},"blog\u002Fblog\u002Fblog_4af9831b0100b4mx.md","坚硬的柔软",{"type":91,"value":92,"toc":160},"minimark",[93,97,100,103,106,109,112,115,118,121,124,127,130,133,136,139,142,145,148,151,154,157],[94,95,96],"p",{},"古人云：烟怕发圈，人怕轮奸。",[94,98,99],{},"近一个多星期，我被轮了。心力交瘁，苦不堪言。",[94,101,102],{},"听说雪健老师为了些情况声泪俱下，我更颓了，真不知我们这帮戏子在坚持个什么？……",[94,104,105],{},"  祝他健康！！",[94,107,108],{},"人，都不是坏人。但总是越往后走，同类越少……",[94,110,111],{},"艺术！！靠！你丫说得对！！绝逼对！！！",[94,113,114],{},"没有对错！！但有——————",[94,116,117],{},"  高低…………………………………………！！！！！！！！",[94,119,120],{},"今儿个借着酒劲正式感谢下张纪中老前辈！因为没有他就没有康导的处女“激情”！这世界，对资历和能力的经验判断算是个大谬误！好多人被耽误了，所以伯乐的胆子远比千里马的蹄子更珍贵！！别吹牛＃！大盘股绩优股傻子也会买，你丫有能耐买个潜力股才能赚大钱！巴菲特不是一脸怂样！！",[94,122,123],{},"发掘了个柔软，在看似坚硬的背后……挺难得的……在这么个虚妄的地儿……",[94,125,126],{},"所以我决定去…………",[94,128,129],{},"  软体动物的外壳都是硬的……有的还带刺儿！",[94,131,132],{},"  爱它！",[94,134,135],{},"  看着她那义无反顾的小德行我就高兴！我很欣慰！我代表我全家很欣慰！",[94,137,138],{},"  我们都太假！且越来越！",[94,140,141],{},"  真的几乎没了，每个人都是！",[94,143,144],{},"  但一个道理猪都明白，什么东西才————贵？？？？",[94,146,147],{},"  你丫对了！",[94,149,150],{},"  少的！！",[94,152,153],{},"  别放弃那些！那才是生命的根本！！",[94,155,156],{},"如果你还剩下点儿……告诉你，拼了命的也要去留下！",[94,158,159],{},"  如果已经没了………………那我无奈了，早点收拾收拾，去死吧！",{"title":161,"searchDepth":162,"depth":162,"links":163},"",2,[],[6],"md",{"date":167},"2008-10-31 21:04",true,"\u002Fblog\u002Fblog_4af9831b0100b4mx",{"title":89,"description":108},"blog_4af9831b0100b4mx","blog\u002Fblog_4af9831b0100b4mx",[174],"杂谈","b-HBIsABzW0Dc37ngNjN3_3FfjNaHmguL4KXOgUGMLE",[177,182],{"title":178,"path":179,"stem":180,"children":-1,"slug":181},"那段岁月 那个人","\u002Fblog\u002Fblog_4af9831b0100b075","blog\u002Fblog_4af9831b0100b075","blog_4af9831b0100b075",{"title":183,"path":184,"stem":185,"children":-1,"slug":186},"长相守","\u002Fblog\u002Fblog_4af9831b0100bkca","blog\u002Fblog_4af9831b0100bkca","blog_4af9831b0100bkca",1794546769690]
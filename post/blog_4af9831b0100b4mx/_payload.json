},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":88,"slug":89},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":91,"slug":92},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":94,"title":95,"body":96,"categories":170,"description":114,"extension":171,"meta":172,"navigation":174,"path":175,"seo":176,"slug":177,"stem":178,"tags":179,"__hash__":181},"blog\u002Fblog\u002Fblog_4af9831b0100b4mx.md","坚硬的柔软",{"type":97,"value":98,"toc":166},"minimark",[99,103,106,109,112,115,118,121,124,127,130,133,136,139,142,145,148,151,154,157,160,163],[100,101,102],"p",{},"古人云：烟怕发圈，人怕轮奸。",[100,104,105],{},"近一个多星期，我被轮了。心力交瘁，苦不堪言。",[100,107,108],{},"听说雪健老师为了些情况声泪俱下，我更颓了，真不知我们这帮戏子在坚持个什么？……",[100,110,111],{},"  祝他健康！！",[100,113,114],{},"人，都不是坏人。但总是越往后走，同类越少……",[100,116,117],{},"艺术！！靠！你丫说得对！！绝逼对！！！",[100,119,120],{},"没有对错！！但有——————",[100,122,123],{},"  高低…………………………………………！！！！！！！！",[100,125,126],{},"今儿个借着酒劲正式感谢下张纪中老前辈！因为没有他就没有康导的处女“激情”！这世界，对资历和能力的经验判断算是个大谬误！好多人被耽误了，所以伯乐的胆子远比千里马的蹄子更珍贵！！别吹牛＃！大盘股绩优股傻子也会买，你丫有能耐买个潜力股才能赚大钱！巴菲特不是一脸怂样！！",[100,128,129],{},"发掘了个柔软，在看似坚硬的背后……挺难得的……在这么个虚妄的地儿……",[100,131,132],{},"所以我决定去…………",[100,134,135],{},"  软体动物的外壳都是硬的……有的还带刺儿！",[100,137,138],{},"  爱它！",[100,140,141],{},"  看着她那义无反顾的小德行我就高兴！我很欣慰！我代表我全家很欣慰！",[100,143,144],{},"  我们都太假！且越来越！",[100,146,147],{},"  真的几乎没了，每个人都是！",[100,149,150],{},"  但一个道理猪都明白，什么东西才————贵？？？？",[100,152,153],{},"  你丫对了！",[100,155,156],{},"  少的！！",[100,158,159],{},"  别放弃那些！那才是生命的根本！！",[100,161,162],{},"如果你还剩下点儿……告诉你，拼了命的也要去留下！",[100,164,165],{},"  如果已经没了………………那我无奈了，早点收拾收拾，去死吧！",{"title":167,"searchDepth":168,"depth":168,"links":169},"",2,[],[6],"md",{"date":173},"2008-10-31 21:04",true,"\u002Fblog\u002Fblog_4af9831b0100b4mx",{"title":95,"description":114},"blog_4af9831b0100b4mx","blog\u002Fblog_4af9831b0100b4mx",[180],"杂谈","b-HBIsABzW0Dc37ngNjN3_3FfjNaHmguL4KXOgUGMLE",[183,188],{"title":184,"path":185,"stem":186,"children":-1,"slug":187},"那段岁月 那个人","\u002Fblog\u002Fblog_4af9831b0100b075","blog\u002Fblog_4af9831b0100b075","blog_4af9831b0100b075",{"title":189,"path":190,"stem":191,"children":-1,"slug":192},"长相守","\u002Fblog\u002Fblog_4af9831b0100bkca","blog\u002Fblog_4af9831b0100bkca","blog_4af9831b0100bkca",1795162025802]
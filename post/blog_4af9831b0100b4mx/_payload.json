[{"data":1,"prerenderedAt":175},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":58,"blog-post-slug-blog_4af9831b0100b4mx":75,"surround-blog_4af9831b0100b4mx":164},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":54,"site_description":55,"stem":56,"__hash__":57},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo",20,"新浪博客内容备份","settings","hh8X7X6SFDoeJrxIJ4yisZXSc3HwHM1zk206jiQX2XU",{"latestBlog":59},[60,63,66,69,72],{"title":61,"slug":62},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":64,"slug":65},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":67,"slug":68},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":70,"slug":71},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":73,"slug":74},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":76,"title":77,"body":78,"categories":152,"description":96,"extension":153,"meta":154,"navigation":156,"path":157,"seo":158,"slug":159,"stem":160,"tags":161,"__hash__":163},"blog\u002Fblog\u002Fblog_4af9831b0100b4mx.md","坚硬的柔软",{"type":79,"value":80,"toc":148},"minimark",[81,85,88,91,94,97,100,103,106,109,112,115,118,121,124,127,130,133,136,139,142,145],[82,83,84],"p",{},"古人云：烟怕发圈，人怕轮奸。",[82,86,87],{},"近一个多星期，我被轮了。心力交瘁，苦不堪言。",[82,89,90],{},"听说雪健老师为了些情况声泪俱下，我更颓了，真不知我们这帮戏子在坚持个什么？……",[82,92,93],{},"  祝他健康！！",[82,95,96],{},"人，都不是坏人。但总是越往后走，同类越少……",[82,98,99],{},"艺术！！靠！你丫说得对！！绝逼对！！！",[82,101,102],{},"没有对错！！但有——————",[82,104,105],{},"  高低…………………………………………！！！！！！！！",[82,107,108],{},"今儿个借着酒劲正式感谢下张纪中老前辈！因为没有他就没有康导的处女“激情”！这世界，对资历和能力的经验判断算是个大谬误！好多人被耽误了，所以伯乐的胆子远比千里马的蹄子更珍贵！！别吹牛＃！大盘股绩优股傻子也会买，你丫有能耐买个潜力股才能赚大钱！巴菲特不是一脸怂样！！",[82,110,111],{},"发掘了个柔软，在看似坚硬的背后……挺难得的……在这么个虚妄的地儿……",[82,113,114],{},"所以我决定去…………",[82,116,117],{},"  软体动物的外壳都是硬的……有的还带刺儿！",[82,119,120],{},"  爱它！",[82,122,123],{},"  看着她那义无反顾的小德行我就高兴！我很欣慰！我代表我全家很欣慰！",[82,125,126],{},"  我们都太假！且越来越！",[82,128,129],{},"  真的几乎没了，每个人都是！",[82,131,132],{},"  但一个道理猪都明白，什么东西才————贵？？？？",[82,134,135],{},"  你丫对了！",[82,137,138],{},"  少的！！",[82,140,141],{},"  别放弃那些！那才是生命的根本！！",[82,143,144],{},"如果你还剩下点儿……告诉你，拼了命的也要去留下！",[82,146,147],{},"  如果已经没了………………那我无奈了，早点收拾收拾，去死吧！",{"title":149,"searchDepth":150,"depth":150,"links":151},"",2,[],[6],"md",{"date":155},"2008-10-31 21:04",true,"\u002Fblog\u002Fblog_4af9831b0100b4mx",{"title":77,"description":96},"blog_4af9831b0100b4mx","blog\u002Fblog_4af9831b0100b4mx",[162],"杂谈","b-HBIsABzW0Dc37ngNjN3_3FfjNaHmguL4KXOgUGMLE",[165,170],{"title":166,"path":167,"stem":168,"children":-1,"slug":169},"那段岁月 那个人","\u002Fblog\u002Fblog_4af9831b0100b075","blog\u002Fblog_4af9831b0100b075","blog_4af9831b0100b075",{"title":171,"path":172,"stem":173,"children":-1,"slug":174},"长相守","\u002Fblog\u002Fblog_4af9831b0100bkca","blog\u002Fblog_4af9831b0100bkca","blog_4af9831b0100bkca",1794412500613]
[{"data":1,"prerenderedAt":174},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":57,"blog-post-slug-blog_4af9831b0100b4mx":74,"surround-blog_4af9831b0100b4mx":163},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":16,"site_description":54,"stem":55,"__hash__":56},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo","新浪博客内容备份(粉丝自用)","settings","jPD1QWrYwbaIixg6lntppEYe-T3ZGd3EJZxFBkbKY9E",{"latestBlog":58},[59,62,65,68,71],{"title":60,"slug":61},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":63,"slug":64},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":66,"slug":67},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":69,"slug":70},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":72,"slug":73},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":75,"title":76,"body":77,"categories":151,"description":95,"extension":152,"meta":153,"navigation":155,"path":156,"seo":157,"slug":158,"stem":159,"tags":160,"__hash__":162},"blog\u002Fblog\u002Fblog_4af9831b0100b4mx.md","坚硬的柔软",{"type":78,"value":79,"toc":147},"minimark",[80,84,87,90,93,96,99,102,105,108,111,114,117,120,123,126,129,132,135,138,141,144],[81,82,83],"p",{},"古人云：烟怕发圈，人怕轮奸。",[81,85,86],{},"近一个多星期，我被轮了。心力交瘁，苦不堪言。",[81,88,89],{},"听说雪健老师为了些情况声泪俱下，我更颓了，真不知我们这帮戏子在坚持个什么？……",[81,91,92],{},"  祝他健康！！",[81,94,95],{},"人，都不是坏人。但总是越往后走，同类越少……",[81,97,98],{},"艺术！！靠！你丫说得对！！绝逼对！！！",[81,100,101],{},"没有对错！！但有——————",[81,103,104],{},"  高低…………………………………………！！！！！！！！",[81,106,107],{},"今儿个借着酒劲正式感谢下张纪中老前辈！因为没有他就没有康导的处女“激情”！这世界，对资历和能力的经验判断算是个大谬误！好多人被耽误了，所以伯乐的胆子远比千里马的蹄子更珍贵！！别吹牛＃！大盘股绩优股傻子也会买，你丫有能耐买个潜力股才能赚大钱！巴菲特不是一脸怂样！！",[81,109,110],{},"发掘了个柔软，在看似坚硬的背后……挺难得的……在这么个虚妄的地儿……",[81,112,113],{},"所以我决定去…………",[81,115,116],{},"  软体动物的外壳都是硬的……有的还带刺儿！",[81,118,119],{},"  爱它！",[81,121,122],{},"  看着她那义无反顾的小德行我就高兴！我很欣慰！我代表我全家很欣慰！",[81,124,125],{},"  我们都太假！且越来越！",[81,127,128],{},"  真的几乎没了，每个人都是！",[81,130,131],{},"  但一个道理猪都明白，什么东西才————贵？？？？",[81,133,134],{},"  你丫对了！",[81,136,137],{},"  少的！！",[81,139,140],{},"  别放弃那些！那才是生命的根本！！",[81,142,143],{},"如果你还剩下点儿……告诉你，拼了命的也要去留下！",[81,145,146],{},"  如果已经没了………………那我无奈了，早点收拾收拾，去死吧！",{"title":148,"searchDepth":149,"depth":149,"links":150},"",2,[],[6],"md",{"date":154},"2008-10-31 21:04",true,"\u002Fblog\u002Fblog_4af9831b0100b4mx",{"title":76,"description":95},"blog_4af9831b0100b4mx","blog\u002Fblog_4af9831b0100b4mx",[161],"杂谈","b-HBIsABzW0Dc37ngNjN3_3FfjNaHmguL4KXOgUGMLE",[164,169],{"title":165,"path":166,"stem":167,"children":-1,"slug":168},"那段岁月 那个人","\u002Fblog\u002Fblog_4af9831b0100b075","blog\u002Fblog_4af9831b0100b075","blog_4af9831b0100b075",{"title":170,"path":171,"stem":172,"children":-1,"slug":173},"长相守","\u002Fblog\u002Fblog_4af9831b0100bkca","blog\u002Fblog_4af9831b0100bkca","blog_4af9831b0100bkca",1794473705282]
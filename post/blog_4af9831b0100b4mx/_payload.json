[{"data":1,"prerenderedAt":131},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b0100b4mx":31,"surround-blog_4af9831b0100b4mx":120},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",152,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":108,"description":33,"extension":109,"meta":110,"navigation":112,"path":113,"seo":114,"slug":115,"stem":116,"tags":117,"__hash__":119},"blog\u002Fblog\u002Fblog_4af9831b0100b4mx.md","坚硬的柔软",{"type":35,"value":36,"toc":104},"minimark",[37,41,44,47,50,53,56,59,62,65,68,71,74,77,80,83,86,89,92,95,98,101],[38,39,40],"p",{},"古人云：烟怕发圈，人怕轮奸。",[38,42,43],{},"近一个多星期，我被轮了。心力交瘁，苦不堪言。",[38,45,46],{},"听说雪健老师为了些情况声泪俱下，我更颓了，真不知我们这帮戏子在坚持个什么？……",[38,48,49],{},"  祝他健康！！",[38,51,52],{},"人，都不是坏人。但总是越往后走，同类越少……",[38,54,55],{},"艺术！！靠！你丫说得对！！绝逼对！！！",[38,57,58],{},"没有对错！！但有——————",[38,60,61],{},"  高低…………………………………………！！！！！！！！",[38,63,64],{},"今儿个借着酒劲正式感谢下张纪中老前辈！因为没有他就没有康导的处女“激情”！这世界，对资历和能力的经验判断算是个大谬误！好多人被耽误了，所以伯乐的胆子远比千里马的蹄子更珍贵！！别吹牛＃！大盘股绩优股傻子也会买，你丫有能耐买个潜力股才能赚大钱！巴菲特不是一脸怂样！！",[38,66,67],{},"发掘了个柔软，在看似坚硬的背后……挺难得的……在这么个虚妄的地儿……",[38,69,70],{},"所以我决定去…………",[38,72,73],{},"  软体动物的外壳都是硬的……有的还带刺儿！",[38,75,76],{},"  爱它！",[38,78,79],{},"  看着她那义无反顾的小德行我就高兴！我很欣慰！我代表我全家很欣慰！",[38,81,82],{},"  我们都太假！且越来越！",[38,84,85],{},"  真的几乎没了，每个人都是！",[38,87,88],{},"  但一个道理猪都明白，什么东西才————贵？？？？",[38,90,91],{},"  你丫对了！",[38,93,94],{},"  少的！！",[38,96,97],{},"  别放弃那些！那才是生命的根本！！",[38,99,100],{},"如果你还剩下点儿……告诉你，拼了命的也要去留下！",[38,102,103],{},"  如果已经没了………………那我无奈了，早点收拾收拾，去死吧！",{"title":105,"searchDepth":106,"depth":106,"links":107},"",2,[],[6],"md",{"date":111},"2008-10-31 21:04",true,"\u002Fblog\u002Fblog_4af9831b0100b4mx",{"title":33,"description":33},"blog_4af9831b0100b4mx","blog\u002Fblog_4af9831b0100b4mx",[118],"杂谈","lrAH97HdpDxKQy9fBiXIItHJWIpMhBkJKx5FEK6zB6s",[121,126],{"title":122,"path":123,"stem":124,"children":-1,"slug":125},"那段岁月 那个人","\u002Fblog\u002Fblog_4af9831b0100b075","blog\u002Fblog_4af9831b0100b075","blog_4af9831b0100b075",{"title":127,"path":128,"stem":129,"children":-1,"slug":130},"长相守","\u002Fblog\u002Fblog_4af9831b0100bkca","blog\u002Fblog_4af9831b0100bkca","blog_4af9831b0100bkca",1793969715471]
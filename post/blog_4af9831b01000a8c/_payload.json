[{"data":1,"prerenderedAt":111},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":17,"blog-post-slug-blog_4af9831b01000a8c":34,"surround-blog_4af9831b01000a8c":100},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"latestBlog":18},[19,22,25,28,31],{"title":20,"slug":21},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":23,"slug":24},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":26,"slug":27},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":29,"slug":30},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":32,"slug":33},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":35,"title":36,"body":37,"categories":87,"description":88,"extension":89,"meta":90,"navigation":92,"path":93,"seo":94,"slug":95,"stem":96,"tags":97,"__hash__":99},"blog\u002Fblog\u002Fblog_4af9831b01000a8c.md","秘密",{"type":38,"value":39,"toc":83},"minimark",[40,44,47,50,53,56,59,62,65,68,71,74,77,80],[41,42,43],"p",{},"又是个夜。",[41,45,46],{},"是个适合思念的夜。",[41,48,49],{},"闲逛了一圈，几乎去了所有好友的博，在这里想念变成另种味道，仿佛想念的不是某个人，至少不是他或她的全部。",[41,51,52],{},"人在此刻成了片状不再立体，成了画面且夹杂音乐……那是他们的好他们的善…",[41,54,55],{},"我们生存在三维，但思想绝对可以穿越。",[41,57,58],{},"见到留言板或别的地方那些个熟悉的名字总会有种感动，至少，此刻我们的精神交会于此，人生路漫漫，但有几次是这样的回眸，凝视？",[41,60,61],{},"日子身上总裹着件虚伪的外套！繁腐，不堪，可能别人看上去亮丽光鲜，但每个人穿上它却相同的沉重。就让时光去慢慢脱掉它吧，看看最后一丝不挂的我们还能剩下些什么？看看我们身上究竟留下多少印记？",[41,63,64],{},"我有个秘密，很想和你分享……那你呢？愿拿你的一个秘密来交换吗？我们总在提出要求，尽管这也是自己的需求……但我们总不敢贸然出手，怕唐突怕失败，怕自己的秘密不再秘密，而别人的秘密依旧秘密……",[41,66,67],{},"  离上一个秘密有多久了？多久？",[41,69,70],{},"耳边响起“梦之浮桥”……美好的歌词说美好的生命和爱情必定如琉璃般脆弱！平凡，庸俗或一个人才是久。真爱，只存于想象？……",[41,72,73],{},"  你是否有过秘密？多久？",[41,75,76],{},"是否曾在一张桌子的下面偷偷握住一个女孩的手？她试着挣脱，你抓紧，她不再虚假的抵抗，也紧紧地握住你？桌子上所有的人都在谈笑风生，但没人比你笑的得意，你侧目偷看那女孩，她不敢看你，红着脸也低头笑……秘密，有别人不知情的分享才更刺激……",[41,78,79],{},"那个瞬间，你是精灵，那个夜晚，你是主宰……",[41,81,82],{},"我想拿自己一个秘密和你交换？你愿意吗？没关系，这次，我先说好了……",{"title":84,"searchDepth":85,"depth":85,"links":86},"",2,[],[6],"又是个夜。是个适合思念的夜。","md",{"date":91},"2007-09-08 01:01",true,"\u002Fblog\u002Fblog_4af9831b01000a8c",{"title":36,"description":88},"blog_4af9831b01000a8c","blog\u002Fblog_4af9831b01000a8c",[98],"情感故事","siCPYbmI6SZc3XR0BXnLj7_MN9_BDMdr3DjBWs5stJQ",[101,106],{"title":102,"path":103,"stem":104,"children":-1,"slug":105},"暗战之爱是一颗幸福的子弹","\u002Fblog\u002Fblog_4af9831b01000a7q","blog\u002Fblog_4af9831b01000a7q","blog_4af9831b01000a7q",{"title":107,"path":108,"stem":109,"children":-1,"slug":110},"错爱","\u002Fblog\u002Fblog_4af9831b01000a9u","blog\u002Fblog_4af9831b01000a9u","blog_4af9831b01000a9u",1794043805724]
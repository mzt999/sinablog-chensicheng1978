[{"data":1,"prerenderedAt":167},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":73,"blog-post-slug-blog_4af9831b01000a8c":90,"surround-blog_4af9831b01000a8c":156},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":48,"navLinks":49,"perPage":16,"prevNextIsExcludeDate":69,"site_description":23,"site_name":70,"stem":71,"__hash__":72},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43,45],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{"href":46,"text":47},"https:\u002F\u002Fmzt999.github.io\u002Fportfolio-chensicheng1978","幕后作品集展示(2012-2026)",{},[50,55,59,63,67],{"path":51,"title":52,"target":53,"fa_class":54},"\u002F","博客首页","internal","fa-home",{"path":56,"title":57,"target":53,"fa_class":58},"\u002Fabout","关于","fa-user",{"path":60,"title":61,"target":53,"fa_class":62},"\u002Fpost","归档","fa-archive",{"path":64,"title":65,"target":53,"fa_class":66},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":68,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","LA_7Y82F2zjQ6-R2_tcWHl356krYL76uqQHBCIU8UZk",{"latestBlog":74},[75,78,81,84,87],{"title":76,"slug":77},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":79,"slug":80},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":82,"slug":83},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":85,"slug":86},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":88,"slug":89},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":91,"title":92,"body":93,"categories":143,"description":144,"extension":145,"meta":146,"navigation":148,"path":149,"seo":150,"slug":151,"stem":152,"tags":153,"__hash__":155},"blog\u002Fblog\u002Fblog_4af9831b01000a8c.md","秘密",{"type":94,"value":95,"toc":139},"minimark",[96,100,103,106,109,112,115,118,121,124,127,130,133,136],[97,98,99],"p",{},"又是个夜。",[97,101,102],{},"是个适合思念的夜。",[97,104,105],{},"闲逛了一圈，几乎去了所有好友的博，在这里想念变成另种味道，仿佛想念的不是某个人，至少不是他或她的全部。",[97,107,108],{},"人在此刻成了片状不再立体，成了画面且夹杂音乐……那是他们的好他们的善…",[97,110,111],{},"我们生存在三维，但思想绝对可以穿越。",[97,113,114],{},"见到留言板或别的地方那些个熟悉的名字总会有种感动，至少，此刻我们的精神交会于此，人生路漫漫，但有几次是这样的回眸，凝视？",[97,116,117],{},"日子身上总裹着件虚伪的外套！繁腐，不堪，可能别人看上去亮丽光鲜，但每个人穿上它却相同的沉重。就让时光去慢慢脱掉它吧，看看最后一丝不挂的我们还能剩下些什么？看看我们身上究竟留下多少印记？",[97,119,120],{},"我有个秘密，很想和你分享……那你呢？愿拿你的一个秘密来交换吗？我们总在提出要求，尽管这也是自己的需求……但我们总不敢贸然出手，怕唐突怕失败，怕自己的秘密不再秘密，而别人的秘密依旧秘密……",[97,122,123],{},"  离上一个秘密有多久了？多久？",[97,125,126],{},"耳边响起“梦之浮桥”……美好的歌词说美好的生命和爱情必定如琉璃般脆弱！平凡，庸俗或一个人才是久。真爱，只存于想象？……",[97,128,129],{},"  你是否有过秘密？多久？",[97,131,132],{},"是否曾在一张桌子的下面偷偷握住一个女孩的手？她试着挣脱，你抓紧，她不再虚假的抵抗，也紧紧地握住你？桌子上所有的人都在谈笑风生，但没人比你笑的得意，你侧目偷看那女孩，她不敢看你，红着脸也低头笑……秘密，有别人不知情的分享才更刺激……",[97,134,135],{},"那个瞬间，你是精灵，那个夜晚，你是主宰……",[97,137,138],{},"我想拿自己一个秘密和你交换？你愿意吗？没关系，这次，我先说好了……",{"title":140,"searchDepth":141,"depth":141,"links":142},"",2,[],[6],"又是个夜。是个适合思念的夜。","md",{"date":147},"2007-09-08 01:01",true,"\u002Fblog\u002Fblog_4af9831b01000a8c",{"title":92,"description":144},"blog_4af9831b01000a8c","blog\u002Fblog_4af9831b01000a8c",[154],"情感故事","siCPYbmI6SZc3XR0BXnLj7_MN9_BDMdr3DjBWs5stJQ",[157,162],{"title":158,"path":159,"stem":160,"children":-1,"slug":161},"暗战之爱是一颗幸福的子弹","\u002Fblog\u002Fblog_4af9831b01000a7q","blog\u002Fblog_4af9831b01000a7q","blog_4af9831b01000a7q",{"title":163,"path":164,"stem":165,"children":-1,"slug":166},"错爱","\u002Fblog\u002Fblog_4af9831b01000a9u","blog\u002Fblog_4af9831b01000a9u","blog_4af9831b01000a9u",1794760532310]
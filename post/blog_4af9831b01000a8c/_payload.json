[{"data":1,"prerenderedAt":170},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":76,"blog-post-slug-blog_4af9831b01000a8c":93,"surround-blog_4af9831b01000a8c":159},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":38,"meta":50,"navLinks":51,"perPage":16,"prevNextIsExcludeDate":71,"site_description":72,"site_name":73,"stem":74,"__hash__":75},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,26,32],{"text":23},"粉丝自制非官方站点｜素材版权归原权利人所有",{"text":25},"仅兴趣交流、无商业用途｜如有侵权请联系删除",{"text":27,"link":28},"查看",{"href":29,"text":30,"fa_class":31},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":33,"link":34},"如有任何疑问，欢迎",{"href":35,"text":36,"fa_class":37},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[39,42,45,47],{"href":40,"text":41},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":43,"text":44},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":46},"新浪微博备份(2009-2026)",{"href":48,"text":49},"https:\u002F\u002Fmzt999.github.io\u002Fportfolio-chensicheng1978","幕后作品集展示(2012-2026)",{},[52,57,61,65,69],{"path":53,"title":54,"target":55,"fa_class":56},"\u002F","博客首页","internal","fa-home",{"path":58,"title":59,"target":55,"fa_class":60},"\u002Fabout","关于","fa-user",{"path":62,"title":63,"target":55,"fa_class":64},"\u002Fpost","归档","fa-archive",{"path":66,"title":67,"target":55,"fa_class":68},"\u002Fgallery","相册","fa-image",{"path":29,"title":30,"target":70,"fa_class":31},"otherSite",false,"新浪博客内容备份(粉丝自用)","陈思诚的博客","settings","5S7xKt0XLHpkjipbomx4I7pUu50Y7wqtD418LquZj5Q",{"latestBlog":77},[78,81,84,87,90],{"title":79,"slug":80},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":82,"slug":83},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":85,"slug":86},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":88,"slug":89},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":91,"slug":92},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":94,"title":95,"body":96,"categories":146,"description":147,"extension":148,"meta":149,"navigation":151,"path":152,"seo":153,"slug":154,"stem":155,"tags":156,"__hash__":158},"blog\u002Fblog\u002Fblog_4af9831b01000a8c.md","秘密",{"type":97,"value":98,"toc":142},"minimark",[99,103,106,109,112,115,118,121,124,127,130,133,136,139],[100,101,102],"p",{},"又是个夜。",[100,104,105],{},"是个适合思念的夜。",[100,107,108],{},"闲逛了一圈，几乎去了所有好友的博，在这里想念变成另种味道，仿佛想念的不是某个人，至少不是他或她的全部。",[100,110,111],{},"人在此刻成了片状不再立体，成了画面且夹杂音乐……那是他们的好他们的善…",[100,113,114],{},"我们生存在三维，但思想绝对可以穿越。",[100,116,117],{},"见到留言板或别的地方那些个熟悉的名字总会有种感动，至少，此刻我们的精神交会于此，人生路漫漫，但有几次是这样的回眸，凝视？",[100,119,120],{},"日子身上总裹着件虚伪的外套！繁腐，不堪，可能别人看上去亮丽光鲜，但每个人穿上它却相同的沉重。就让时光去慢慢脱掉它吧，看看最后一丝不挂的我们还能剩下些什么？看看我们身上究竟留下多少印记？",[100,122,123],{},"我有个秘密，很想和你分享……那你呢？愿拿你的一个秘密来交换吗？我们总在提出要求，尽管这也是自己的需求……但我们总不敢贸然出手，怕唐突怕失败，怕自己的秘密不再秘密，而别人的秘密依旧秘密……",[100,125,126],{},"  离上一个秘密有多久了？多久？",[100,128,129],{},"耳边响起“梦之浮桥”……美好的歌词说美好的生命和爱情必定如琉璃般脆弱！平凡，庸俗或一个人才是久。真爱，只存于想象？……",[100,131,132],{},"  你是否有过秘密？多久？",[100,134,135],{},"是否曾在一张桌子的下面偷偷握住一个女孩的手？她试着挣脱，你抓紧，她不再虚假的抵抗，也紧紧地握住你？桌子上所有的人都在谈笑风生，但没人比你笑的得意，你侧目偷看那女孩，她不敢看你，红着脸也低头笑……秘密，有别人不知情的分享才更刺激……",[100,137,138],{},"那个瞬间，你是精灵，那个夜晚，你是主宰……",[100,140,141],{},"我想拿自己一个秘密和你交换？你愿意吗？没关系，这次，我先说好了……",{"title":143,"searchDepth":144,"depth":144,"links":145},"",2,[],[6],"又是个夜。是个适合思念的夜。","md",{"date":150},"2007-09-08 01:01",true,"\u002Fblog\u002Fblog_4af9831b01000a8c",{"title":95,"description":147},"blog_4af9831b01000a8c","blog\u002Fblog_4af9831b01000a8c",[157],"情感故事","siCPYbmI6SZc3XR0BXnLj7_MN9_BDMdr3DjBWs5stJQ",[160,165],{"title":161,"path":162,"stem":163,"children":-1,"slug":164},"暗战之爱是一颗幸福的子弹","\u002Fblog\u002Fblog_4af9831b01000a7q","blog\u002Fblog_4af9831b01000a7q","blog_4af9831b01000a7q",{"title":166,"path":167,"stem":168,"children":-1,"slug":169},"错爱","\u002Fblog\u002Fblog_4af9831b01000a9u","blog\u002Fblog_4af9831b01000a9u","blog_4af9831b01000a9u",1795162026052]
[{"data":1,"prerenderedAt":151},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":57,"blog-post-slug-blog_4af9831b01000a8c":74,"surround-blog_4af9831b01000a8c":140},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":16,"site_description":54,"stem":55,"__hash__":56},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo","新浪博客内容备份(粉丝自用)","settings","jPD1QWrYwbaIixg6lntppEYe-T3ZGd3EJZxFBkbKY9E",{"latestBlog":58},[59,62,65,68,71],{"title":60,"slug":61},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":63,"slug":64},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":66,"slug":67},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":69,"slug":70},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":72,"slug":73},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":75,"title":76,"body":77,"categories":127,"description":128,"extension":129,"meta":130,"navigation":132,"path":133,"seo":134,"slug":135,"stem":136,"tags":137,"__hash__":139},"blog\u002Fblog\u002Fblog_4af9831b01000a8c.md","秘密",{"type":78,"value":79,"toc":123},"minimark",[80,84,87,90,93,96,99,102,105,108,111,114,117,120],[81,82,83],"p",{},"又是个夜。",[81,85,86],{},"是个适合思念的夜。",[81,88,89],{},"闲逛了一圈，几乎去了所有好友的博，在这里想念变成另种味道，仿佛想念的不是某个人，至少不是他或她的全部。",[81,91,92],{},"人在此刻成了片状不再立体，成了画面且夹杂音乐……那是他们的好他们的善…",[81,94,95],{},"我们生存在三维，但思想绝对可以穿越。",[81,97,98],{},"见到留言板或别的地方那些个熟悉的名字总会有种感动，至少，此刻我们的精神交会于此，人生路漫漫，但有几次是这样的回眸，凝视？",[81,100,101],{},"日子身上总裹着件虚伪的外套！繁腐，不堪，可能别人看上去亮丽光鲜，但每个人穿上它却相同的沉重。就让时光去慢慢脱掉它吧，看看最后一丝不挂的我们还能剩下些什么？看看我们身上究竟留下多少印记？",[81,103,104],{},"我有个秘密，很想和你分享……那你呢？愿拿你的一个秘密来交换吗？我们总在提出要求，尽管这也是自己的需求……但我们总不敢贸然出手，怕唐突怕失败，怕自己的秘密不再秘密，而别人的秘密依旧秘密……",[81,106,107],{},"  离上一个秘密有多久了？多久？",[81,109,110],{},"耳边响起“梦之浮桥”……美好的歌词说美好的生命和爱情必定如琉璃般脆弱！平凡，庸俗或一个人才是久。真爱，只存于想象？……",[81,112,113],{},"  你是否有过秘密？多久？",[81,115,116],{},"是否曾在一张桌子的下面偷偷握住一个女孩的手？她试着挣脱，你抓紧，她不再虚假的抵抗，也紧紧地握住你？桌子上所有的人都在谈笑风生，但没人比你笑的得意，你侧目偷看那女孩，她不敢看你，红着脸也低头笑……秘密，有别人不知情的分享才更刺激……",[81,118,119],{},"那个瞬间，你是精灵，那个夜晚，你是主宰……",[81,121,122],{},"我想拿自己一个秘密和你交换？你愿意吗？没关系，这次，我先说好了……",{"title":124,"searchDepth":125,"depth":125,"links":126},"",2,[],[6],"又是个夜。是个适合思念的夜。","md",{"date":131},"2007-09-08 01:01",true,"\u002Fblog\u002Fblog_4af9831b01000a8c",{"title":76,"description":128},"blog_4af9831b01000a8c","blog\u002Fblog_4af9831b01000a8c",[138],"情感故事","siCPYbmI6SZc3XR0BXnLj7_MN9_BDMdr3DjBWs5stJQ",[141,146],{"title":142,"path":143,"stem":144,"children":-1,"slug":145},"暗战之爱是一颗幸福的子弹","\u002Fblog\u002Fblog_4af9831b01000a7q","blog\u002Fblog_4af9831b01000a7q","blog_4af9831b01000a7q",{"title":147,"path":148,"stem":149,"children":-1,"slug":150},"错爱","\u002Fblog\u002Fblog_4af9831b01000a9u","blog\u002Fblog_4af9831b01000a9u","blog_4af9831b01000a9u",1794473705652]
[{"data":1,"prerenderedAt":107},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b01000a8c":31,"surround-blog_4af9831b01000a8c":96},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",152,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":84,"description":33,"extension":85,"meta":86,"navigation":88,"path":89,"seo":90,"slug":91,"stem":92,"tags":93,"__hash__":95},"blog\u002Fblog\u002Fblog_4af9831b01000a8c.md","秘密",{"type":35,"value":36,"toc":80},"minimark",[37,41,44,47,50,53,56,59,62,65,68,71,74,77],[38,39,40],"p",{},"又是个夜。",[38,42,43],{},"是个适合思念的夜。",[38,45,46],{},"闲逛了一圈，几乎去了所有好友的博，在这里想念变成另种味道，仿佛想念的不是某个人，至少不是他或她的全部。",[38,48,49],{},"人在此刻成了片状不再立体，成了画面且夹杂音乐……那是他们的好他们的善…",[38,51,52],{},"我们生存在三维，但思想绝对可以穿越。",[38,54,55],{},"见到留言板或别的地方那些个熟悉的名字总会有种感动，至少，此刻我们的精神交会于此，人生路漫漫，但有几次是这样的回眸，凝视？",[38,57,58],{},"日子身上总裹着件虚伪的外套！繁腐，不堪，可能别人看上去亮丽光鲜，但每个人穿上它却相同的沉重。就让时光去慢慢脱掉它吧，看看最后一丝不挂的我们还能剩下些什么？看看我们身上究竟留下多少印记？",[38,60,61],{},"我有个秘密，很想和你分享……那你呢？愿拿你的一个秘密来交换吗？我们总在提出要求，尽管这也是自己的需求……但我们总不敢贸然出手，怕唐突怕失败，怕自己的秘密不再秘密，而别人的秘密依旧秘密……",[38,63,64],{},"  离上一个秘密有多久了？多久？",[38,66,67],{},"耳边响起“梦之浮桥”……美好的歌词说美好的生命和爱情必定如琉璃般脆弱！平凡，庸俗或一个人才是久。真爱，只存于想象？……",[38,69,70],{},"  你是否有过秘密？多久？",[38,72,73],{},"是否曾在一张桌子的下面偷偷握住一个女孩的手？她试着挣脱，你抓紧，她不再虚假的抵抗，也紧紧地握住你？桌子上所有的人都在谈笑风生，但没人比你笑的得意，你侧目偷看那女孩，她不敢看你，红着脸也低头笑……秘密，有别人不知情的分享才更刺激……",[38,75,76],{},"那个瞬间，你是精灵，那个夜晚，你是主宰……",[38,78,79],{},"我想拿自己一个秘密和你交换？你愿意吗？没关系，这次，我先说好了……",{"title":81,"searchDepth":82,"depth":82,"links":83},"",2,[],[6],"md",{"date":87},"2007-09-08 01:01",true,"\u002Fblog\u002Fblog_4af9831b01000a8c",{"title":33,"description":33},"blog_4af9831b01000a8c","blog\u002Fblog_4af9831b01000a8c",[94],"情感故事","oPzrPqHiSQUrzYiuBFP3bXugPdf8-5GhqPjBvsiQFqY",[97,102],{"title":98,"path":99,"stem":100,"children":-1,"slug":101},"暗战之爱是一颗幸福的子弹","\u002Fblog\u002Fblog_4af9831b01000a7q","blog\u002Fblog_4af9831b01000a7q","blog_4af9831b01000a7q",{"title":103,"path":104,"stem":105,"children":-1,"slug":106},"错爱","\u002Fblog\u002Fblog_4af9831b01000a9u","blog\u002Fblog_4af9831b01000a9u","blog_4af9831b01000a9u",1793967846602]
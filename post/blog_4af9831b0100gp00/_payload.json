[{"data":1,"prerenderedAt":166},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":73,"blog-post-slug-blog_4af9831b0100gp00":90,"surround-blog_4af9831b0100gp00":155},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":48,"navLinks":49,"perPage":16,"prevNextIsExcludeDate":69,"site_description":23,"site_name":70,"stem":71,"__hash__":72},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43,45],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{"href":46,"text":47},"https:\u002F\u002Fmzt999.github.io\u002Fportfolio-chensicheng1978","幕后作品集展示(2012-2026)",{},[50,55,59,63,67],{"path":51,"title":52,"target":53,"fa_class":54},"\u002F","博客首页","internal","fa-home",{"path":56,"title":57,"target":53,"fa_class":58},"\u002Fabout","关于","fa-user",{"path":60,"title":61,"target":53,"fa_class":62},"\u002Fpost","归档","fa-archive",{"path":64,"title":65,"target":53,"fa_class":66},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":68,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","LA_7Y82F2zjQ6-R2_tcWHl356krYL76uqQHBCIU8UZk",{"latestBlog":74},[75,78,81,84,87],{"title":76,"slug":77},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":79,"slug":80},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":82,"slug":83},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":85,"slug":86},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":88,"slug":89},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":91,"title":92,"body":93,"categories":143,"description":111,"extension":144,"meta":145,"navigation":147,"path":148,"seo":149,"slug":150,"stem":151,"tags":152,"__hash__":154},"blog\u002Fblog\u002Fblog_4af9831b0100gp00.md","忍",{"type":94,"value":95,"toc":139},"minimark",[96,100,103,106,109,112,115,118,121,124,127,130,133,136],[97,98,99],"p",{},"此前一篇博，非我所作。",[97,101,102],{},"越发看的触目惊心，所以，还是标注个明白……",[97,104,105],{},"因为临摹的着实很像，怕过个若干年，自己也忘记自己了。",[97,107,108],{},"厦门，生平的第一次踏足。百感交集……",[97,110,111],{},"不会忘记“博客”一词对自己的交代——便是沧海桑田后的一个自省一次自问一翻自怜，所以断不敢变了味道，我还是从于我吧……",[97,113,114],{},"好久没听“北京”了，那是心底隐疼的自己。",[97,116,117],{},"至今，博客的登录密码还是大学女友的手机号码……算是什么？提醒着不要忘记？",[97,119,120],{},"歌词中忽然的一句——“人类的心是个无底洞……”没错，我们的痛楚皆是源自于此——欲望的不满足罢了。",[97,122,123],{},"可欲望若真的满足了呢？",[97,125,126],{},"又怎样？",[97,128,129],{},"那就更没有滋味了……",[97,131,132],{},"所以，我们此生为人——便注定是要痛的……",[97,134,135],{},"佛说：不可说……我们便不再说了吧……",[97,137,138],{},"沉默的前行吧。",{"title":140,"searchDepth":141,"depth":141,"links":142},"",2,[],[6],"md",{"date":146},"2010-01-12 23:44",true,"\u002Fblog\u002Fblog_4af9831b0100gp00",{"title":92,"description":111},"blog_4af9831b0100gp00","blog\u002Fblog_4af9831b0100gp00",[153],"杂谈","Z9tjrq6FrrvTI1iEU4chu5attGL9z4Nsu-re0XEaK8U",[156,161],{"title":157,"path":158,"stem":159,"children":-1,"slug":160},"光影话流年","\u002Fblog\u002Fblog_4af9831b0100gfnc","blog\u002Fblog_4af9831b0100gfnc","blog_4af9831b0100gfnc",{"title":162,"path":163,"stem":164,"children":-1,"slug":165},"人面桃花《大丫鬟》MV","\u002Fblog\u002Fblog_4af9831b0100gpvi","blog\u002Fblog_4af9831b0100gpvi","blog_4af9831b0100gpvi",1794760531883]
[{"data":1,"prerenderedAt":107},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b0100gp00":31,"surround-blog_4af9831b0100gp00":96},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",152,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":84,"description":33,"extension":85,"meta":86,"navigation":88,"path":89,"seo":90,"slug":91,"stem":92,"tags":93,"__hash__":95},"blog\u002Fblog\u002Fblog_4af9831b0100gp00.md","忍",{"type":35,"value":36,"toc":80},"minimark",[37,41,44,47,50,53,56,59,62,65,68,71,74,77],[38,39,40],"p",{},"此前一篇博，非我所作。",[38,42,43],{},"越发看的触目惊心，所以，还是标注个明白……",[38,45,46],{},"因为临摹的着实很像，怕过个若干年，自己也忘记自己了。",[38,48,49],{},"厦门，生平的第一次踏足。百感交集……",[38,51,52],{},"不会忘记“博客”一词对自己的交代——便是沧海桑田后的一个自省一次自问一翻自怜，所以断不敢变了味道，我还是从于我吧……",[38,54,55],{},"好久没听“北京”了，那是心底隐疼的自己。",[38,57,58],{},"至今，博客的登录密码还是大学女友的手机号码……算是什么？提醒着不要忘记？",[38,60,61],{},"歌词中忽然的一句——“人类的心是个无底洞……”没错，我们的痛楚皆是源自于此——欲望的不满足罢了。",[38,63,64],{},"可欲望若真的满足了呢？",[38,66,67],{},"又怎样？",[38,69,70],{},"那就更没有滋味了……",[38,72,73],{},"所以，我们此生为人——便注定是要痛的……",[38,75,76],{},"佛说：不可说……我们便不再说了吧……",[38,78,79],{},"沉默的前行吧。",{"title":81,"searchDepth":82,"depth":82,"links":83},"",2,[],[6],"md",{"date":87},"2010-01-12 23:44",true,"\u002Fblog\u002Fblog_4af9831b0100gp00",{"title":33,"description":33},"blog_4af9831b0100gp00","blog\u002Fblog_4af9831b0100gp00",[94],"杂谈","wikqpiDBT64KMigNVbyadsT67fHy6WhybekYxB476h4",[97,102],{"title":98,"path":99,"stem":100,"children":-1,"slug":101},"光影话流年","\u002Fblog\u002Fblog_4af9831b0100gfnc","blog\u002Fblog_4af9831b0100gfnc","blog_4af9831b0100gfnc",{"title":103,"path":104,"stem":105,"children":-1
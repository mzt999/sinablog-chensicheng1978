[{"data":1,"prerenderedAt":151},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":58,"blog-post-slug-blog_4af9831b0100gp00":75,"surround-blog_4af9831b0100gp00":140},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":54,"site_description":55,"stem":56,"__hash__":57},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo",20,"新浪博客内容备份","settings","hh8X7X6SFDoeJrxIJ4yisZXSc3HwHM1zk206jiQX2XU",{"latestBlog":59},[60,63,66,69,72],{"title":61,"slug":62},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":64,"slug":65},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":67,"slug":68},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":70,"slug":71},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":73,"slug":74},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":76,"title":77,"body":78,"categories":128,"description":96,"extension":129,"meta":130,"navigation":132,"path":133,"seo":134,"slug":135,"stem":136,"tags":137,"__hash__":139},"blog\u002Fblog\u002Fblog_4af9831b0100gp00.md","忍",{"type":79,"value":80,"toc":124},"minimark",[81,85,88,91,94,97,100,103,106,109,112,115,118,121],[82,83,84],"p",{},"此前一篇博，非我所作。",[82,86,87],{},"越发看的触目惊心，所以，还是标注个明白……",[82,89,90],{},"因为临摹的着实很像，怕过个若干年，自己也忘记自己了。",[82,92,93],{},"厦门，生平的第一次踏足。百感交集……",[82,95,96],{},"不会忘记“博客”一词对自己的交代——便是沧海桑田后的一个自省一次自问一翻自怜，所以断不敢变了味道，我还是从于我吧……",[82,98,99],{},"好久没听“北京”了，那是心底隐疼的自己。",[82,101,102],{},"至今，博客的登录密码还是大学女友的手机号码……算是什么？提醒着不要忘记？",[82,104,105],{},"歌词中忽然的一句——“人类的心是个无底洞……”没错，我们的痛楚皆是源自于此——欲望的不满足罢了。",[82,107,108],{},"可欲望若真的满足了呢？",[82,110,111],{},"又怎样？",[82,113,114],{},"那就更没有滋味了……",[82,116,117],{},"所以，我们此生为人——便注定是要痛的……",[82,119,120],{},"佛说：不可说……我们便不再说了吧……",[82,122,123],{},"沉默的前行吧。",{"title":125,"searchDepth":126,"depth":126,"links":127},"",2,[],[6],"md",{"date":131},"2010-01-12 23:44",true,"\u002Fblog\u002Fblog_4af9831b0100gp00",{"title":77,"description":96},"blog_4af9831b0100gp00","blog\u002Fblog_4af9831b0100gp00",[138],"杂谈","Z9tjrq6FrrvTI1iEU4chu5attGL9z4Nsu-re0XEaK8U",[141,146],{"title":142,"path":143,"stem":144,"children":-1,"slug":145},"光影话流年","\u002Fblog\u002Fblog_4af9831b0100gfnc","blog\u002Fblog_4af9831b0100gfnc","blog_4af9831b0100gfnc",{"title":147,"path":148,"stem":149,"children":-1,"slug":150},"人面桃花《大丫鬟》MV","\u002Fblog\u002Fblog_4af9831b0100gpvi","blog\u002Fblog_4af9831b0100gpvi","blog_4af9831b0100gpvi",1794412500480]
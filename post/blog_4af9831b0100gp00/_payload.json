[{"data":1,"prerenderedAt":163},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":70,"blog-post-slug-blog_4af9831b0100gp00":87,"surround-blog_4af9831b0100gp00":152},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":45,"navLinks":46,"perPage":16,"prevNextIsExcludeDate":66,"site_description":23,"site_name":67,"stem":68,"__hash__":69},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{},[47,52,56,60,64],{"path":48,"title":49,"target":50,"fa_class":51},"\u002F","博客首页","internal","fa-home",{"path":53,"title":54,"target":50,"fa_class":55},"\u002Fabout","关于","fa-user",{"path":57,"title":58,"target":50,"fa_class":59},"\u002Fpost","归档","fa-archive",{"path":61,"title":62,"target":50,"fa_class":63},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":65,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","jvZHccz2rT-wjVS5GCPgWyhl8WnBIvECPkE5KpKFKCU",{"latestBlog":71},[72,75,78,81,84],{"title":73,"slug":74},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":76,"slug":77},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":79,"slug":80},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":82,"slug":83},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":85,"slug":86},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":88,"title":89,"body":90,"categories":140,"description":108,"extension":141,"meta":142,"navigation":144,"path":145,"seo":146,"slug":147,"stem":148,"tags":149,"__hash__":151},"blog\u002Fblog\u002Fblog_4af9831b0100gp00.md","忍",{"type":91,"value":92,"toc":136},"minimark",[93,97,100,103,106,109,112,115,118,121,124,127,130,133],[94,95,96],"p",{},"此前一篇博，非我所作。",[94,98,99],{},"越发看的触目惊心，所以，还是标注个明白……",[94,101,102],{},"因为临摹的着实很像，怕过个若干年，自己也忘记自己了。",[94,104,105],{},"厦门，生平的第一次踏足。百感交集……",[94,107,108],{},"不会忘记“博客”一词对自己的交代——便是沧海桑田后的一个自省一次自问一翻自怜，所以断不敢变了味道，我还是从于我吧……",[94,110,111],{},"好久没听“北京”了，那是心底隐疼的自己。",[94,113,114],{},"至今，博客的登录密码还是大学女友的手机号码……算是什么？提醒着不要忘记？",[94,116,117],{},"歌词中忽然的一句——“人类的心是个无底洞……”没错，我们的痛楚皆是源自于此——欲望的不满足罢了。",[94,119,120],{},"可欲望若真的满足了呢？",[94,122,123],{},"又怎样？",[94,125,126],{},"那就更没有滋味了……",[94,128,129],{},"所以，我们此生为人——便注定是要痛的……",[94,131,132],{},"佛说：不可说……我们便不再说了吧……",[94,134,135],{},"沉默的前行吧。",{"title":137,"searchDepth":138,"depth":138,"links":139},"",2,[],[6],"md",{"date":143},"2010-01-12 23:44",true,"\u002Fblog\u002Fblog_4af9831b0100gp00",{"title":89,"description":108},"blog_4af9831b0100gp00","blog\u002Fblog_4af9831b0100gp00",[150],"杂谈","Z9tjrq6FrrvTI1iEU4chu5attGL9z4Nsu-re0XEaK8U",[153,158],{"title":154,"path":155,"stem":156,"children":-1,"slug":157},"光影话流年","\u002Fblog\u002Fblog_4af9831b0100gfnc","blog\u002Fblog_4af9831b0100gfnc","blog_4af9831b0100gfnc",{"title":159,"path":160,"stem":161,"children":-1,"slug":162},"人面桃花《大丫鬟》MV","\u002Fblog\u002Fblog_4af9831b0100gpvi","blog\u002Fblog_4af9831b0100gpvi","blog_4af9831b0100gpvi",1794546769522]
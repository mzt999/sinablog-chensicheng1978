[{"data":1,"prerenderedAt":150},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":57,"blog-post-slug-blog_4af9831b0100gp00":74,"surround-blog_4af9831b0100gp00":139},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":16,"site_description":54,"stem":55,"__hash__":56},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo","新浪博客内容备份(粉丝自用)","settings","jPD1QWrYwbaIixg6lntppEYe-T3ZGd3EJZxFBkbKY9E",{"latestBlog":58},[59,62,65,68,71],{"title":60,"slug":61},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":63,"slug":64},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":66,"slug":67},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":69,"slug":70},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":72,"slug":73},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":75,"title":76,"body":77,"categories":127,"description":95,"extension":128,"meta":129,"navigation":131,"path":132,"seo":133,"slug":134,"stem":135,"tags":136,"__hash__":138},"blog\u002Fblog\u002Fblog_4af9831b0100gp00.md","忍",{"type":78,"value":79,"toc":123},"minimark",[80,84,87,90,93,96,99,102,105,108,111,114,117,120],[81,82,83],"p",{},"此前一篇博，非我所作。",[81,85,86],{},"越发看的触目惊心，所以，还是标注个明白……",[81,88,89],{},"因为临摹的着实很像，怕过个若干年，自己也忘记自己了。",[81,91,92],{},"厦门，生平的第一次踏足。百感交集……",[81,94,95],{},"不会忘记“博客”一词对自己的交代——便是沧海桑田后的一个自省一次自问一翻自怜，所以断不敢变了味道，我还是从于我吧……",[81,97,98],{},"好久没听“北京”了，那是心底隐疼的自己。",[81,100,101],{},"至今，博客的登录密码还是大学女友的手机号码……算是什么？提醒着不要忘记？",[81,103,104],{},"歌词中忽然的一句——“人类的心是个无底洞……”没错，我们的痛楚皆是源自于此——欲望的不满足罢了。",[81,106,107],{},"可欲望若真的满足了呢？",[81,109,110],{},"又怎样？",[81,112,113],{},"那就更没有滋味了……",[81,115,116],{},"所以，我们此生为人——便注定是要痛的……",[81,118,119],{},"佛说：不可说……我们便不再说了吧……",[81,121,122],{},"沉默的前行吧。",{"title":124,"searchDepth":125,"depth":125,"links":126},"",2,[],[6],"md",{"date":130},"2010-01-12 23:44",true,"\u002Fblog\u002Fblog_4af9831b0100gp00",{"title":76,"description":95},"blog_4af9831b0100gp00","blog\u002Fblog_4af9831b0100gp00",[137],"杂谈","Z9tjrq6FrrvTI1iEU4chu5attGL9z4Nsu-re0XEaK8U",[140,145],{"title":141,"path":142,"stem":143,"children":-1,"slug":144},"光影话流年","\u002Fblog\u002Fblog_4af9831b0100gfnc","blog\u002Fblog_4af9831b0100gfnc","blog_4af9831b0100gfnc",{"title":146,"path":147,"stem":148,"children":-1,"slug":149},"人面桃花《大丫鬟》MV","\u002Fblog\u002Fblog_4af9831b0100gpvi","blog\u002Fblog_4af9831b0100gpvi","blog_4af9831b0100gpvi",1794473705144]
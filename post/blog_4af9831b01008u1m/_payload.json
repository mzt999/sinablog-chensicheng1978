[{"data":1,"prerenderedAt":95},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b01008u1m":31,"surround-blog_4af9831b01008u1m":84},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",151,{"name":9,"len":10},"有图",34,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":72,"description":33,"extension":73,"meta":74,"navigation":76,"path":77,"seo":78,"slug":79,"stem":80,"tags":81,"__hash__":83},"blog\u002Fblog\u002Fblog_4af9831b01008u1m.md","爱情",{"type":35,"value":36,"toc":68},"minimark",[37,41,44,47,50,53,56,59,62,65],[38,39,40],"p",{},"初始，一切源于孤独……",[38,42,43],{},"结果，耶和华抽离了亚当的第7根肋骨……",[38,45,46],{},"苹果让他俩明白了欲望，奇怪的东西在伊甸园开始升腾……从此，孕育代表惩罚;宿命就是寻找。",[38,48,49],{},"  基数倍增，创世纪……",[38,51,52],{},"一个体被分成两半，散在各处，独自寻找……",[38,54,55],{},"找什么？还不是我的肋骨你的宿主……",[38,57,58],{},"23+23=46\n如此平等，再简单不过的加法却是生命最根本的仪式，更是造物主的大赦！可我们，屡次背离了最初的意志，满目，尽是体液的融和，缺乏魂灵的交媾……",[38,60,61],{},"神，不是生于腋下，便是出自马厩。唯一昭示，奇迹便难得真实。但如它来，你就该信……很简单，信，不一定会有。不信，一定不会有……",[38,63,64],{},"你看到一个影像，既幻又真，忽远忽近。来得突兀，去深植心髓。握住，便永不想脱离；吻住，便不必呼吸；把它放在你身体里，你唯一的感觉就是感觉不到！却又想嚼碎，吞咽！吃下去便是完全占有！语言，都是音乐！身体，无法表达！只有死去活来！最后，你浮在云中，感受肋骨回到你身上，瞬间，你成了宠儿，神的第一个泥人……",[38,66,67],{},"大默契！芸芸众生中也会感知！无须多言的信任，赠与对方便是满足自己！相视一笑，世间便无疾苦，相对一眼，就是彼此的百年………………神说，这才是我给你们的苹果，它的名字叫：爱情…………",{"title":69,"searchDepth":70,"depth":70,"links":71},"",2,[],[6],"md",{"date":75},"2008-03-29 23:40",true,"\u002Fblog\u002Fblog_4af9831b01008u1m",{"title":33,"description":33},"blog_4af9831b01008u1m","blog\u002Fblog_4af9831b01008u1m",[82],"情感","Y--M51UrT8n0RQUIrM4LmyBhG7eRa4J1SIO-Vp6-jaY",[85,90],{"title":86,"path":87,"stem":88,"children":-1,"slug":89},"走下去","\u002Fblog\u002Fblog_4af9831b01008iat"
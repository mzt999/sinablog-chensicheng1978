[{"data":1,"prerenderedAt":157},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":76,"blog-post-slug-blog_4af9831b01008u1m":93,"surround-blog_4af9831b01008u1m":146},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":38,"meta":50,"navLinks":51,"perPage":16,"prevNextIsExcludeDate":71,"site_description":72,"site_name":73,"stem":74,"__hash__":75},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,26,32],{"text":23},"粉丝自制非官方站点｜素材版权归原权利人所有",{"text":25},"仅兴趣交流、无商业用途｜如有侵权请联系删除",{"text":27,"link":28},"查看",{"href":29,"text":30,"fa_class":31},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":33,"link":34},"如有任何疑问，欢迎",{"href":35,"text":36,"fa_class":37},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[39,42,45,47],{"href":40,"text":41},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":43,"text":44},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":46},"新浪微博备份(2009-2026)",{"href":48,"text":49},"https:\u002F\u002Fmzt999.github.io\u002Fportfolio-chensicheng1978","幕后作品集展示(2012-2026)",{},[52,57,61,65,69],{"path":53,"title":54,"target":55,"fa_class":56},"\u002F","博客首页","internal","fa-home",{"path":58,"title":59,"target":55,"fa_class":60},"\u002Fabout","关于","fa-user",{"path":62,"title":63,"target":55,"fa_class":64},"\u002Fpost","归档","fa-archive",{"path":66,"title":67,"target":55,"fa_class":68},"\u002Fgallery","相册","fa-image",{"path":29,"title":30,"target":70,"fa_class":31},"otherSite",false,"新浪博客内容备份(粉丝自用)","陈思诚的博客","settings","5S7xKt0XLHpkjipbomx4I7pUu50Y7wqtD418LquZj5Q",{"latestBlog":77},[78,81,84,87,90],{"title":79,"slug":80},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":82,"slug":83},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":85,"slug":86},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":88,"slug":89},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":91,"slug":92},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":94,"title":95,"body":96,"categories":134,"description":102,"extension":135,"meta":136,"navigation":138,"path":139,"seo":140,"slug":141,"stem":142,"tags":143,"__hash__":145},"blog\u002Fblog\u002Fblog_4af9831b01008u1m.md","爱情",{"type":97,"value":98,"toc":130},"minimark",[99,103,106,109,112,115,118,121,124,127],[100,101,102],"p",{},"初始，一切源于孤独……",[100,104,105],{},"结果，耶和华抽离了亚当的第7根肋骨……",[100,107,108],{},"苹果让他俩明白了欲望，奇怪的东西在伊甸园开始升腾……从此，孕育代表惩罚;宿命就是寻找。",[100,110,111],{},"  基数倍增，创世纪……",[100,113,114],{},"一个体被分成两半，散在各处，独自寻找……",[100,116,117],{},"找什么？还不是我的肋骨你的宿主……",[100,119,120],{},"23+23=46 如此平等，再简单不过的加法却是生命最根本的仪式，更是造物主的大赦！可我们，屡次背离了最初的意志，满目，尽是体液的融和，缺乏魂灵的交媾……",[100,122,123],{},"神，不是生于腋下，便是出自马厩。唯一昭示，奇迹便难得真实。但如它来，你就该信……很简单，信，不一定会有。不信，一定不会有……",[100,125,126],{},"你看到一个影像，既幻又真，忽远忽近。来得突兀，去深植心髓。握住，便永不想脱离；吻住，便不必呼吸；把它放在你身体里，你唯一的感觉就是感觉不到！却又想嚼碎，吞咽！吃下去便是完全占有！语言，都是音乐！身体，无法表达！只有死去活来！最后，你浮在云中，感受肋骨回到你身上，瞬间，你成了宠儿，神的第一个泥人……",[100,128,129],{},"大默契！芸芸众生中也会感知！无须多言的信任，赠与对方便是满足自己！相视一笑，世间便无疾苦，相对一眼，就是彼此的百年………………神说，这才是我给你们的苹果，它的名字叫：爱情…………",{"title":131,"searchDepth":132,"depth":132,"links":133},"",2,[],[6],"md",{"date":137},"2008-03-29 23:40",true,"\u002Fblog\u002Fblog_4af9831b01008u1m",{"title":95,"description":102},"blog_4af9831b01008u1m","blog\u002Fblog_4af9831b01008u1m",[144],"情感","SrpzEbCwISQQAI9rIbowY5wVdXJa8_BcmiX0voTETGA",[147,152],{"title":148,"path":149,"stem":150,"children":-1,"slug":151},"走下去","\u002Fblog\u002Fblog_4af9831b01008iat","blog\u002Fblog_4af9831b01008iat","blog_4af9831b01008iat",{"title":153,"path":154,"stem":155,"children":-1,"slug":156},"日记 [2008年04月16日]","\u002Fblog\u002Fblog_4af9831b010090eg","blog\u002Fblog_4af9831b010090eg","blog_4af9831b010090eg",1795162025893]
[{"data":1,"prerenderedAt":139},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":58,"blog-post-slug-blog_4af9831b01008u1m":75,"surround-blog_4af9831b01008u1m":128},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":54,"site_description":55,"stem":56,"__hash__":57},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo",20,"新浪博客内容备份","settings","hh8X7X6SFDoeJrxIJ4yisZXSc3HwHM1zk206jiQX2XU",{"latestBlog":59},[60,63,66,69,72],{"title":61,"slug":62},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":64,"slug":65},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":67,"slug":68},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":70,"slug":71},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":73,"slug":74},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":76,"title":77,"body":78,"categories":116,"description":84,"extension":117,"meta":118,"navigation":120,"path":121,"seo":122,"slug":123,"stem":124,"tags":125,"__hash__":127},"blog\u002Fblog\u002Fblog_4af9831b01008u1m.md","爱情",{"type":79,"value":80,"toc":112},"minimark",[81,85,88,91,94,97,100,103,106,109],[82,83,84],"p",{},"初始，一切源于孤独……",[82,86,87],{},"结果，耶和华抽离了亚当的第7根肋骨……",[82,89,90],{},"苹果让他俩明白了欲望，奇怪的东西在伊甸园开始升腾……从此，孕育代表惩罚;宿命就是寻找。",[82,92,93],{},"  基数倍增，创世纪……",[82,95,96],{},"一个体被分成两半，散在各处，独自寻找……",[82,98,99],{},"找什么？还不是我的肋骨你的宿主……",[82,101,102],{},"23+23=46 如此平等，再简单不过的加法却是生命最根本的仪式，更是造物主的大赦！可我们，屡次背离了最初的意志，满目，尽是体液的融和，缺乏魂灵的交媾……",[82,104,105],{},"神，不是生于腋下，便是出自马厩。唯一昭示，奇迹便难得真实。但如它来，你就该信……很简单，信，不一定会有。不信，一定不会有……",[82,107,108],{},"你看到一个影像，既幻又真，忽远忽近。来得突兀，去深植心髓。握住，便永不想脱离；吻住，便不必呼吸；把它放在你身体里，你唯一的感觉就是感觉不到！却又想嚼碎，吞咽！吃下去便是完全占有！语言，都是音乐！身体，无法表达！只有死去活来！最后，你浮在云中，感受肋骨回到你身上，瞬间，你成了宠儿，神的第一个泥人……",[82,110,111],{},"大默契！芸芸众生中也会感知！无须多言的信任，赠与对方便是满足自己！相视一笑，世间便无疾苦，相对一眼，就是彼此的百年………………神说，这才是我给你们的苹果，它的名字叫：爱情…………",{"title":113,"searchDepth":114,"depth":114,"links":115},"",2,[],[6],"md",{"date":119},"2008-03-29 23:40",true,"\u002Fblog\u002Fblog_4af9831b01008u1m",{"title":77,"description":84},"blog_4af9831b01008u1m","blog\u002Fblog_4af9831b01008u1m",[126],"情感","SrpzEbCwISQQAI9rIbowY5wVdXJa8_BcmiX0voTETGA",[129,134],{"title":130,"path":131,"stem":132,"children":-1,"slug":133},"走下去","\u002Fblog\u002Fblog_4af9831b01008iat","blog\u002Fblog_4af9831b01008iat","blog_4af9831b01008iat",{"title":135,"path":136,"stem":137,"children":-1,"slug":138},"日记 [2008年04月16日]","\u002Fblog\u002Fblog_4af9831b010090eg","blog\u002Fblog_4af9831b010090eg","blog_4af9831b010090eg",1794412500730]
[{"data":1,"prerenderedAt":98},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":17,"blog-post-slug-blog_4af9831b01008u1m":34,"surround-blog_4af9831b01008u1m":87},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"latestBlog":18},[19,22,25,28,31],{"title":20,"slug":21},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":23,"slug":24},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":26,"slug":27},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":29,"slug":30},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":32,"slug":33},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":35,"title":36,"body":37,"categories":75,"description":43,"extension":76,"meta":77,"navigation":79,"path":80,"seo":81,"slug":82,"stem":83,"tags":84,"__hash__":86},"blog\u002Fblog\u002Fblog_4af9831b01008u1m.md","爱情",{"type":38,"value":39,"toc":71},"minimark",[40,44,47,50,53,56,59,62,65,68],[41,42,43],"p",{},"初始，一切源于孤独……",[41,45,46],{},"结果，耶和华抽离了亚当的第7根肋骨……",[41,48,49],{},"苹果让他俩明白了欲望，奇怪的东西在伊甸园开始升腾……从此，孕育代表惩罚;宿命就是寻找。",[41,51,52],{},"  基数倍增，创世纪……",[41,54,55],{},"一个体被分成两半，散在各处，独自寻找……",[41,57,58],{},"找什么？还不是我的肋骨你的宿主……",[41,60,61],{},"23+23=46 如此平等，再简单不过的加法却是生命最根本的仪式，更是造物主的大赦！可我们，屡次背离了最初的意志，满目，尽是体液的融和，缺乏魂灵的交媾……",[41,63,64],{},"神，不是生于腋下，便是出自马厩。唯一昭示，奇迹便难得真实。但如它来，你就该信……很简单，信，不一定会有。不信，一定不会有……",[41,66,67],{},"你看到一个影像，既幻又真，忽远忽近。来得突兀，去深植心髓。握住，便永不想脱离；吻住，便不必呼吸；把它放在你身体里，你唯一的感觉就是感觉不到！却又想嚼碎，吞咽！吃下去便是完全占有！语言，都是音乐！身体，无法表达！只有死去活来！最后，你浮在云中，感受肋骨回到你身上，瞬间，你成了宠儿，神的第一个泥人……",[41,69,70],{},"大默契！芸芸众生中也会感知！无须多言的信任，赠与对方便是满足自己！相视一笑，世间便无疾苦，相对一眼，就是彼此的百年………………神说，这才是我给你们的苹果，它的名字叫：爱情…………",{"title":72,"searchDepth":73,"depth":73,"links":74},"",2,[],[6],"md",{"date":78},"2008-03-29 23:40",true,"\u002Fblog\u002Fblog_4af9831b01008u1m",{"title":36,"description":43},"blog_4af9831b01008u1m","blog\u002Fblog_4af9831b01008u1m",[85],"情感","SrpzEbCwISQQAI9rIbowY5wVdXJa8_BcmiX0voTETGA",[88,93],{"title":89,"path":90,"stem":91,"children":-1,"slug":92},"走下去","\u002Fblog\u002Fblog_4af9831b01008iat","blog\u002Fblog_4af9831b01008iat","blog_4af9831b01008iat",{"title":94,"path":95,"stem":96,"children":-1,"slug":97},"日记 [2008年04月16日]","\u002Fblog\u002Fblog_4af9831b010090eg","blog\u002Fblog_4af9831b010090eg","blog_4af9831b010090eg",1794045953839]
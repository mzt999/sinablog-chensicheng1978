[{"data":1,"prerenderedAt":154},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":73,"blog-post-slug-blog_4af9831b01008u1m":90,"surround-blog_4af9831b01008u1m":143},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":48,"navLinks":49,"perPage":16,"prevNextIsExcludeDate":69,"site_description":23,"site_name":70,"stem":71,"__hash__":72},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43,45],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{"href":46,"text":47},"https:\u002F\u002Fmzt999.github.io\u002Fportfolio-chensicheng1978","幕后作品集展示(2012-2026)",{},[50,55,59,63,67],{"path":51,"title":52,"target":53,"fa_class":54},"\u002F","博客首页","internal","fa-home",{"path":56,"title":57,"target":53,"fa_class":58},"\u002Fabout","关于","fa-user",{"path":60,"title":61,"target":53,"fa_class":62},"\u002Fpost","归档","fa-archive",{"path":64,"title":65,"target":53,"fa_class":66},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":68,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","LA_7Y82F2zjQ6-R2_tcWHl356krYL76uqQHBCIU8UZk",{"latestBlog":74},[75,78,81,84,87],{"title":76,"slug":77},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":79,"slug":80},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":82,"slug":83},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":85,"slug":86},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":88,"slug":89},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":91,"title":92,"body":93,"categories":131,"description":99,"extension":132,"meta":133,"navigation":135,"path":136,"seo":137,"slug":138,"stem":139,"tags":140,"__hash__":142},"blog\u002Fblog\u002Fblog_4af9831b01008u1m.md","爱情",{"type":94,"value":95,"toc":127},"minimark",[96,100,103,106,109,112,115,118,121,124],[97,98,99],"p",{},"初始，一切源于孤独……",[97,101,102],{},"结果，耶和华抽离了亚当的第7根肋骨……",[97,104,105],{},"苹果让他俩明白了欲望，奇怪的东西在伊甸园开始升腾……从此，孕育代表惩罚;宿命就是寻找。",[97,107,108],{},"  基数倍增，创世纪……",[97,110,111],{},"一个体被分成两半，散在各处，独自寻找……",[97,113,114],{},"找什么？还不是我的肋骨你的宿主……",[97,116,117],{},"23+23=46 如此平等，再简单不过的加法却是生命最根本的仪式，更是造物主的大赦！可我们，屡次背离了最初的意志，满目，尽是体液的融和，缺乏魂灵的交媾……",[97,119,120],{},"神，不是生于腋下，便是出自马厩。唯一昭示，奇迹便难得真实。但如它来，你就该信……很简单，信，不一定会有。不信，一定不会有……",[97,122,123],{},"你看到一个影像，既幻又真，忽远忽近。来得突兀，去深植心髓。握住，便永不想脱离；吻住，便不必呼吸；把它放在你身体里，你唯一的感觉就是感觉不到！却又想嚼碎，吞咽！吃下去便是完全占有！语言，都是音乐！身体，无法表达！只有死去活来！最后，你浮在云中，感受肋骨回到你身上，瞬间，你成了宠儿，神的第一个泥人……",[97,125,126],{},"大默契！芸芸众生中也会感知！无须多言的信任，赠与对方便是满足自己！相视一笑，世间便无疾苦，相对一眼，就是彼此的百年………………神说，这才是我给你们的苹果，它的名字叫：爱情…………",{"title":128,"searchDepth":129,"depth":129,"links":130},"",2,[],[6],"md",{"date":134},"2008-03-29 23:40",true,"\u002Fblog\u002Fblog_4af9831b01008u1m",{"title":92,"description":99},"blog_4af9831b01008u1m","blog\u002Fblog_4af9831b01008u1m",[141],"情感","SrpzEbCwISQQAI9rIbowY5wVdXJa8_BcmiX0voTETGA",[144,149],{"title":145,"path":146,"stem":147,"children":-1,"slug":148},"走下去","\u002Fblog\u002Fblog_4af9831b01008iat","blog\u002Fblog_4af9831b01008iat","blog_4af9831b01008iat",{"title":150,"path":151,"stem":152,"children":-1,"slug":153},"日记 [2008年04月16日]","\u002Fblog\u002Fblog_4af9831b010090eg","blog\u002Fblog_4af9831b010090eg","blog_4af9831b010090eg",1794760532105]
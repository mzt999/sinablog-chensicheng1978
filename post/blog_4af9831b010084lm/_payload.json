[{"data":1,"prerenderedAt":134},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":58,"blog-post-slug-blog_4af9831b010084lm":75,"surround-blog_4af9831b010084lm":123},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":54,"site_description":55,"stem":56,"__hash__":57},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo",20,"新浪博客内容备份","settings","hh8X7X6SFDoeJrxIJ4yisZXSc3HwHM1zk206jiQX2XU",{"latestBlog":59},[60,63,66,69,72],{"title":61,"slug":62},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":64,"slug":65},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":67,"slug":68},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":70,"slug":71},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":73,"slug":74},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":76,"title":77,"body":78,"categories":110,"description":111,"extension":112,"meta":113,"navigation":115,"path":116,"seo":117,"slug":118,"stem":119,"tags":120,"__hash__":122},"blog\u002Fblog\u002Fblog_4af9831b010084lm.md","牺牲",{"type":79,"value":80,"toc":106},"minimark",[81,85,88,91,94,97,100,103],[82,83,84],"p",{},"躲了些自己,躲了些你们,其实是在躲时间,躲现实.有些时间是必须拿来浪费的.所以我们都成不了鲁迅,因为我们喝咖啡.再不来这里的草会把我的视线遮蔽.其实盲了倒也无妨,但惊恐于谁都看不见我,或我的眼里谁都看不见...SO还是得站着,对吧?尽管站着不如倒着,好吃不如饺子,老人说的..",[82,86,87],{},"脑子乱得很,语焉不详.自己最近很奇怪,因为病?还是别的什么?无迹可查.病就怕差不出病根,一般这样的病都属绝症!我的感觉此次的生理周期比往次都要长...堕落很舒坦,意志在投降,理想缴械,勇气交枪...谁都明白安逸谁都会享用满足...其实我也行...混呗...谁能拒绝得了舒服呢?我又不傻,是吧?或者还没傻到家?",[82,89,90],{},"下午车上的几句寒暄,某译说自己最幸福的瞬间是一个人是两只猫是翻翻书是看看碟...那是他的安乐窝,他的大自在他的小家园.我的在哪?凭什么我的G点就那么高?那么硬?那么钝?凭什么?谁生的?我招谁了?凭什么啊?他妈的!...别和我说什么现世报?靠!滚蛋!...对不起啊,不该说粗口,此段当我没说.",[82,92,93],{},"羡慕,真的没别的.就是羡慕,羡慕到嫉妒!其实我羡慕很多人.经常性的.频繁到自我怀疑.自我否定.所以每次我都需要体力再爬起来.飞了!又开始不知所云了,又不着地了,又得被某些人用高机给我打下来了...",[82,95,96],{},"反正,是一种牺牲!我算发现了,任何事情都有代价,而且,付出往往超出你的预期!得到却只是瞬间的微薄.惨痛!但又不被人知.亮在人前,伤在人后.",[82,98,99],{},"我开始体恤我的同类们.我们的隐秘应该一致,伤口同样清晰,血流不止,止不住,直至死.",[82,101,102],{},"牢骚过去,感觉爽了.原谅我的屡次意淫,把这里当成发泄地,把对象当作你们.请原谅,请宽容,如同赦免个孩子.其实我现在很好,问题越来越少.目标越来越清,越来越知道自己要的是什么...在某个方面,只能说.",[82,104,105],{},"说点开心的吧说什么呢?那就告诉你们一个惊人的发现吧:我发现原来我不是神也不是畜生...我其实是个人.",{"title":107,"searchDepth":108,"depth":108,"links":109},"",2,[],[6],"告诉你们一个惊人的发现吧:我发现原来我不是神也不是畜生...我其实是个人.","md",{"date":114},"2008-01-24 22:12",true,"\u002Fblog\u002Fblog_4af9831b010084lm",{"title":77,"description":111},"blog_4af9831b010084lm","blog\u002Fblog_4af9831b010084lm",[121],"情感","f-yY0DHrNi711mxnowmKA2dkqO-hFl3Tqm-04O2PV10",[124,129],{"title":125,"path":126,"stem":127,"children":-1,"slug":128},"我写给\"电视剧\"的文章","\u002Fblog\u002Fblog_4af9831b01007xpr","blog\u002Fblog_4af9831b01007xpr","blog_4af9831b01007xpr",{"title":130,"path":131,"stem":132,"children":-1,"slug":133},"\u003C我们的故事>","\u002Fblog\u002Fblog_4af9831b01008bl0","blog\u002Fblog_4af9831b01008bl0","blog_4af9831b01008bl0",1794412500798]
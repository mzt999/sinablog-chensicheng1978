[{"data":1,"prerenderedAt":152},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":76,"blog-post-slug-blog_4af9831b010084lm":93,"surround-blog_4af9831b010084lm":141},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":38,"meta":50,"navLinks":51,"perPage":16,"prevNextIsExcludeDate":71,"site_description":72,"site_name":73,"stem":74,"__hash__":75},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,26,32],{"text":23},"粉丝自制非官方站点｜素材版权归原权利人所有",{"text":25},"仅兴趣交流、无商业用途｜如有侵权请联系删除",{"text":27,"link":28},"查看",{"href":29,"text":30,"fa_class":31},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":33,"link":34},"如有任何疑问，欢迎",{"href":35,"text":36,"fa_class":37},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[39,42,45,47],{"href":40,"text":41},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":43,"text":44},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":46},"新浪微博备份(2009-2026)",{"href":48,"text":49},"https:\u002F\u002Fmzt999.github.io\u002Fportfolio-chensicheng1978","幕后作品集展示(2012-2026)",{},[52,57,61,65,69],{"path":53,"title":54,"target":55,"fa_class":56},"\u002F","博客首页","internal","fa-home",{"path":58,"title":59,"target":55,"fa_class":60},"\u002Fabout","关于","fa-user",{"path":62,"title":63,"target":55,"fa_class":64},"\u002Fpost","归档","fa-archive",{"path":66,"title":67,"target":55,"fa_class":68},"\u002Fgallery","相册","fa-image",{"path":29,"title":30,"target":70,"fa_class":31},"otherSite",false,"新浪博客内容备份(粉丝自用)","陈思诚的博客","settings","5S7xKt0XLHpkjipbomx4I7pUu50Y7wqtD418LquZj5Q",{"latestBlog":77},[78,81,84,87,90],{"title":79,"slug":80},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":82,"slug":83},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":85,"slug":86},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":88,"slug":89},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":91,"slug":92},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":94,"title":95,"body":96,"categories":128,"description":129,"extension":130,"meta":131,"navigation":133,"path":134,"seo":135,"slug":136,"stem":137,"tags":138,"__hash__":140},"blog\u002Fblog\u002Fblog_4af9831b010084lm.md","牺牲",{"type":97,"value":98,"toc":124},"minimark",[99,103,106,109,112,115,118,121],[100,101,102],"p",{},"躲了些自己,躲了些你们,其实是在躲时间,躲现实.有些时间是必须拿来浪费的.所以我们都成不了鲁迅,因为我们喝咖啡.再不来这里的草会把我的视线遮蔽.其实盲了倒也无妨,但惊恐于谁都看不见我,或我的眼里谁都看不见...SO还是得站着,对吧?尽管站着不如倒着,好吃不如饺子,老人说的..",[100,104,105],{},"脑子乱得很,语焉不详.自己最近很奇怪,因为病?还是别的什么?无迹可查.病就怕差不出病根,一般这样的病都属绝症!我的感觉此次的生理周期比往次都要长...堕落很舒坦,意志在投降,理想缴械,勇气交枪...谁都明白安逸谁都会享用满足...其实我也行...混呗...谁能拒绝得了舒服呢?我又不傻,是吧?或者还没傻到家?",[100,107,108],{},"下午车上的几句寒暄,某译说自己最幸福的瞬间是一个人是两只猫是翻翻书是看看碟...那是他的安乐窝,他的大自在他的小家园.我的在哪?凭什么我的G点就那么高?那么硬?那么钝?凭什么?谁生的?我招谁了?凭什么啊?他妈的!...别和我说什么现世报?靠!滚蛋!...对不起啊,不该说粗口,此段当我没说.",[100,110,111],{},"羡慕,真的没别的.就是羡慕,羡慕到嫉妒!其实我羡慕很多人.经常性的.频繁到自我怀疑.自我否定.所以每次我都需要体力再爬起来.飞了!又开始不知所云了,又不着地了,又得被某些人用高机给我打下来了...",[100,113,114],{},"反正,是一种牺牲!我算发现了,任何事情都有代价,而且,付出往往超出你的预期!得到却只是瞬间的微薄.惨痛!但又不被人知.亮在人前,伤在人后.",[100,116,117],{},"我开始体恤我的同类们.我们的隐秘应该一致,伤口同样清晰,血流不止,止不住,直至死.",[100,119,120],{},"牢骚过去,感觉爽了.原谅我的屡次意淫,把这里当成发泄地,把对象当作你们.请原谅,请宽容,如同赦免个孩子.其实我现在很好,问题越来越少.目标越来越清,越来越知道自己要的是什么...在某个方面,只能说.",[100,122,123],{},"说点开心的吧说什么呢?那就告诉你们一个惊人的发现吧:我发现原来我不是神也不是畜生...我其实是个人.",{"title":125,"searchDepth":126,"depth":126,"links":127},"",2,[],[6],"告诉你们一个惊人的发现吧:我发现原来我不是神也不是畜生...我其实是个人.","md",{"date":132},"2008-01-24 22:12",true,"\u002Fblog\u002Fblog_4af9831b010084lm",{"title":95,"description":129},"blog_4af9831b010084lm","blog\u002Fblog_4af9831b010084lm",[139],"情感","f-yY0DHrNi711mxnowmKA2dkqO-hFl3Tqm-04O2PV10",[142,147],{"title":143,"path":144,"stem":145,"children":-1,"slug":146},"我写给\"电视剧\"的文章","\u002Fblog\u002Fblog_4af9831b01007xpr","blog\u002Fblog_4af9831b01007xpr","blog_4af9831b01007xpr",{"title":148,"path":149,"stem":150,"children":-1,"slug":151},"\u003C我们的故事>","\u002Fblog\u002Fblog_4af9831b01008bl0","blog\u002Fblog_4af9831b01008bl0","blog_4af9831b01008bl0",1795162025925]
":89,"body":90,"categories":132,"description":133,"extension":134,"meta":135,"navigation":137,"path":138,"seo":139,"slug":140,"stem":141,"tags":142,"__hash__":144},"blog\u002Fblog\u002Fblog_4af9831b010090eg.md","日记 [2008年04月16日]",{"type":91,"value":92,"toc":128},"minimark",[93,97,100,103,106,109,116,122],[94,95,96],"p",{},"正在现场奋斗，室内戏，有电脑，有网络，幸哉！",[94,98,99],{},"上来看大家的留言，有人问“白蛇”的歌词，这是我词创作中比较爱的一个。",[94,101,102],{},"看到大家的揣测，不忍，于是发给你们。",[94,104,105],{},"白 蛇",[94,107,108],{},"词曲：橙子",[94,110,111,112,115],{},"今时残阳如血微斜  往日雷锋夕照湮灭  何年断桥旧梦衔接  几多白堤春晓不觉",[113,114],"br",{},"\n弹指之间  旧梦重演 谁为爱妥协",[94,117,118,119,121],{},"暮鼓晨钟催发如雪  晦涩离别误读圆缺  烟雨江南泪可映月  怎奈拂面相思难绝",[113,120],{},"\n匆匆数眼  前世又现  谁为爱穿越",[94,123,124,125,127],{},"别等到一千年才去遇见  隔世的许仙  也许就在身边  莫负了红颜",[113,126],{},"\n今宵已苦短无须修炼  爱难免危险  它朝露更寒  挥袖撑伞  缘来浅笑着自然",{"title":129,"searchDepth":130,"depth":130,"links":131},"",2,[],[6,12],"正在现场奋斗，室内戏，有电脑，有网络，幸哉！...《白蛇》歌词全文","md",{"date":136},"2008-04-16 19:56",true,"\u002Fblog\u002Fblog_4af9831b010090eg",{"title":89,"description":133},"blog_4af9831b010090eg","blog\u002Fblog_4af9831b010090eg",[143],"杂谈","Ij3AhFTwmebayilhqDWMULLEmF_gjtT8way0HSf8k_g",[146,151],{"title":147,"path":148,"stem":149,"children":-1,"slug":150},"爱情","\u002Fblog\u002Fblog_4af9831b01008u1m","blog\u002Fblog_4af9831b01008u1m","blog_4af9831b01008u1m",{"title":152,"path":153,"stem":154,"children":-1,"slug":155},"寄语腾冲","\u002Fblog\u002Fblog_4af9831b010092dx","blog\u002Fblog_4af9831b010092dx","blog_4af9831b010092dx",1794546769815]
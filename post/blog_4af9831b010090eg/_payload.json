},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":88,"slug":89},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":91,"slug":92},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":94,"title":95,"body":96,"categories":138,"description":139,"extension":140,"meta":141,"navigation":143,"path":144,"seo":145,"slug":146,"stem":147,"tags":148,"__hash__":150},"blog\u002Fblog\u002Fblog_4af9831b010090eg.md","日记 [2008年04月16日]",{"type":97,"value":98,"toc":134},"minimark",[99,103,106,109,112,115,122,128],[100,101,102],"p",{},"正在现场奋斗，室内戏，有电脑，有网络，幸哉！",[100,104,105],{},"上来看大家的留言，有人问“白蛇”的歌词，这是我词创作中比较爱的一个。",[100,107,108],{},"看到大家的揣测，不忍，于是发给你们。",[100,110,111],{},"白 蛇",[100,113,114],{},"词曲：橙子",[100,116,117,118,121],{},"今时残阳如血微斜  往日雷锋夕照湮灭  何年断桥旧梦衔接  几多白堤春晓不觉",[119,120],"br",{},"\n弹指之间  旧梦重演 谁为爱妥协",[100,123,124,125,127],{},"暮鼓晨钟催发如雪  晦涩离别误读圆缺  烟雨江南泪可映月  怎奈拂面相思难绝",[119,126],{},"\n匆匆数眼  前世又现  谁为爱穿越",[100,129,130,131,133],{},"别等到一千年才去遇见  隔世的许仙  也许就在身边  莫负了红颜",[119,132],{},"\n今宵已苦短无须修炼  爱难免危险  它朝露更寒  挥袖撑伞  缘来浅笑着自然",{"title":135,"searchDepth":136,"depth":136,"links":137},"",2,[],[6,12],"正在现场奋斗，室内戏，有电脑，有网络，幸哉！...《白蛇》歌词全文","md",{"date":142},"2008-04-16 19:56",true,"\u002Fblog\u002Fblog_4af9831b010090eg",{"title":95,"description":139},"blog_4af9831b010090eg","blog\u002Fblog_4af9831b010090eg",[149],"杂谈","Ij3AhFTwmebayilhqDWMULLEmF_gjtT8way0HSf8k_g",[152,157],{"title":153,"path":154,"stem":155,"children":-1,"slug":156},"爱情","\u002Fblog\u002Fblog_4af9831b01008u1m","blog\u002Fblog_4af9831b01008u1m","blog_4af9831b01008u1m",{"title":158,"path":159,"stem":160,"children":-1,"slug":161},"寄语腾冲","\u002Fblog\u002Fblog_4af9831b010092dx","blog\u002Fblog_4af9831b010092dx","blog_4af9831b010092dx",1795162025882]
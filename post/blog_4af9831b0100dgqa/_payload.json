[{"data":1,"prerenderedAt":140},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":70,"blog-post-slug-blog_4af9831b0100dgqa":87,"surround-blog_4af9831b0100dgqa":129},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":45,"navLinks":46,"perPage":16,"prevNextIsExcludeDate":66,"site_description":23,"site_name":67,"stem":68,"__hash__":69},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{},[47,52,56,60,64],{"path":48,"title":49,"target":50,"fa_class":51},"\u002F","博客首页","internal","fa-home",{"path":53,"title":54,"target":50,"fa_class":55},"\u002Fabout","关于","fa-user",{"path":57,"title":58,"target":50,"fa_class":59},"\u002Fpost","归档","fa-archive",{"path":61,"title":62,"target":50,"fa_class":63},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":65,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","jvZHccz2rT-wjVS5GCPgWyhl8WnBIvECPkE5KpKFKCU",{"latestBlog":71},[72,75,78,81,84],{"title":73,"slug":74},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":76,"slug":77},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":79,"slug":80},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":82,"slug":83},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":85,"slug":86},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":88,"title":89,"body":90,"categories":113,"description":114,"extension":115,"meta":116,"navigation":118,"path":119,"seo":120,"slug":121,"stem":122,"tags":123,"__hash__":128},"blog\u002Fblog\u002Fblog_4af9831b0100dgqa.md","《春风》获奖印证华语电影的春天",{"type":91,"value":92,"toc":109},"minimark",[93,97,100,103,106],[94,95,96],"p",{},"虽然是最佳编剧奖，虽然没有折到金棕榈，但《春风》还是印证了赛会主席雅各布赛前所说的：“世界电影的中心在向中东甚至远东转移。”",[94,98,99],{},"电影未来的缔造者一定是独立电影、作家电影和小成本电影。所以当此次电影节主竞赛名单公布我发现好莱坞电影遭受过从未有过的冷遇时，当《春风》作为第一部主竞赛影片亮相我和导演等人走上红毯面对全世界关注的目光时，当走到红毯尽头电影宫的入口我迎接着主席雅各布亲切且充满期待的笑容和目光时，当《白丝带》最终折桂金棕榈《春风》获得最佳编剧奖时，我知道雅各布没有说谎，戛纳没有说谎。这更像是对坚持的一种表彰，对不妥协的一种赞誉。电影是商品，商品的背后是艺术，艺术的背后是梦想，而梦想的背后是纯粹。中国电影人东方电影人都需要有最纯粹的姿态，对自我艺术诉求始终如一的贯穿盒和行动，对创作本能契而不舍的尊重和追逐。“春风”希望会为中国电影春天的到来加一把力！也许这是最坏的时代，也许这是最好的时代……当各种诱惑肆无忌惮的在我们面前搔首弄姿的今天，坚持显得尤为重要！",[94,101,102],{},"“意识”才是根本。电影艺术走到今天，几次大的变革，无论是蒙太奇的出现还是新浪潮的诞生，其本质都是电影意识的丰富，对电影语言自身求新求变的不断追求。电影的本质是艺术，其内在价值如果一段时间无法彰显，那它的存在空间就会不断缩小，最终导致消亡。而商业电影，除却商业价值外，只会在技术手段层面丰富和拓宽电影，受益的除了制片方的口袋和观众的感官外，与电影自身的生长并无关连。",[94,104,105],{},"而现在的情况是，与好莱坞比邻的欧洲电影正在更多的遭受着商业细菌的侵蚀，人们越发注重眼前利益，把电影当成生意，只注重投入产出比，各种重片拍和类型片让大家对电影越来越失望。灵光一闪的表达和后记播发的创作越来越少。大家不再思考，不再观察……商业，让我们停下脚步。而东方的商业空间给了未来电影的出路！",[94,107,108],{},"剧本是一切影视作品的基石，其重要性不言而喻。且在戛纳这样的顶级电影节，对单项奖的肯定也是对整部影片的另一种肯定。雅各布是清醒的，戛纳是清醒的。作为世界电影艺术的引领者，其对主流和非主流，艺术和商业之间的选择非常艰难。尤其是在好莱坞电影大行其道的今天，在“电影”这个名字越来越物化、商业性越发凸显、艺术性越发削弱、内在价值越发被忽略、票房数字唯我独尊的今天，电影究竟该走向何处，其实是每一个从业人员都需要冷静思考的问题……",{"title":110,"searchDepth":111,"depth":111,"links":112},"",2,[],[6],"“世界电影的中心在向中东甚至远东转移。”","md",{"date":117},"2009-05-31 18:21",true,"\u002Fblog\u002Fblog_4af9831b0100dgqa",{"title":89,"description":114},"blog_4af9831b0100dgqa","blog\u002Fblog_4af9831b0100dgqa",[124,125,126,127],"戛纳","春风","陈思成","娱乐","N1eQmUGnT_fFYMJusDV_7-HTaiDEZLeeHh9Tou8mHJ4",[130,135],{"title":131,"path":132,"stem":133,"children":-1,"slug":134},"背影，前行……","\u002Fblog\u002Fblog_4af9831b0100de35","blog\u002Fblog_4af9831b0100de35","blog_4af9831b0100de35",{"title":136,"path":137,"stem":138,"children":-1,"slug":139},"疯魔","\u002Fblog\u002Fblog_4af9831b0100dur9","blog\u002Fblog_4af9831b0100dur9","blog_4af9831b0100dur9",1794546769577]
[{"data":1,"prerenderedAt":112},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":58,"blog-post-slug-blog_4af9831b010007jl":75,"surround-blog_4af9831b010007jl":101},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":54,"site_description":55,"stem":56,"__hash__":57},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo",20,"新浪博客内容备份","settings","hh8X7X6SFDoeJrxIJ4yisZXSc3HwHM1zk206jiQX2XU",{"latestBlog":59},[60,63,66,69,72],{"title":61,"slug":62},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":64,"slug":65},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":67,"slug":68},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":70,"slug":71},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":73,"slug":74},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":76,"title":77,"body":78,"categories":89,"description":90,"extension":91,"meta":92,"navigation":94,"path":95,"seo":96,"slug":97,"stem":98,"tags":99,"__hash__":100},"blog\u002Fblog\u002Fblog_4af9831b010007jl.md","最亮丽的风景",{"type":79,"value":80,"toc":85},"minimark",[81],[82,83,84],"p",{},"今天起的早,下午有比较重要的事.外面阳光很好,我的露台光彩照人.对面的斜屋顶上薄薄的积雪还未全部消散,它们想再多留冬天就一点.今天是个特殊的日子,不能不写点什么,给你们.在我不短不长的人生轨迹中,一直有道最亮丽的风景...我开着车向前从未回头,也不知终点在何处,沿途的感动却从未停过.也在想,究竟哪道风景才是我应该真正驻足的地方,却又一次次上路...人在旅途,我是浪子,究竟是漂泊的心不肯停歇,还根本那些风景本就是镜花水月海市蜃楼?但如何都要感谢,感谢一路或多或少的陪伴...在路上,究竟谁是谁的风景谁是谁的过客?...",{"title":86,"searchDepth":87,"depth":87,"links":88},"",2,[],[6],"今天起的早,下午有比较重要的事.外面阳光很好,我的露台光彩照人.","md",{"date":93},"2007-03-08 11:13",true,"\u002Fblog\u002Fblog_4af9831b010007jl",{"title":77,"description":90},"blog_4af9831b010007jl","blog\u002Fblog_4af9831b010007jl",[],"vBYpapc7zH6_nbf0wjBg2UKqT8w_BDC4GAOB4fzKjXA",[102,107],{"title":103,"path":104,"stem":105,"children":-1,"slug":106},"困了","\u002Fblog\u002Fblog_4af9831b010007eu","blog\u002Fblog_4af9831b010007eu","blog_4af9831b010007eu",{"title":108,"path":109,"stem":110,"children":-1,"slug":111},"38 礼物","\u002Fblog\u002Fblog_4af9831b010007jm","blog\u002Fblog_4af9831b010007jm","blog_4af9831b010007jm",1794412501407]
[{"data":1,"prerenderedAt":161},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":58,"blog-post-slug-blog_4af9831b01000a9u":75,"surround-blog_4af9831b01000a9u":150},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":54,"site_description":55,"stem":56,"__hash__":57},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo",20,"新浪博客内容备份","settings","hh8X7X6SFDoeJrxIJ4yisZXSc3HwHM1zk206jiQX2XU",{"latestBlog":59},[60,63,66,69,72],{"title":61,"slug":62},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":64,"slug":65},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":67,"slug":68},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":70,"slug":71},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":73,"slug":74},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":76,"title":77,"body":78,"categories":138,"description":112,"extension":139,"meta":140,"navigation":142,"path":143,"seo":144,"slug":145,"stem":146,"tags":147,"__hash__":149},"blog\u002Fblog\u002Fblog_4af9831b01000a9u.md","错爱",{"type":79,"value":80,"toc":134},"minimark",[81,88,91,94,99,102,107,110,113,116,119,122,125,128,131],[82,83,84],"p",{},[85,86],"img",{"alt":77,"src":87},"\u002Fpic\u002F4af9831b02001565.jpg",[82,89,90],{},"上数左——右（弟弟 晓月 冷涧 LILI\n“思橙群主”船家 橙子 中华 若若 yee）",[82,92,93],{},"下数（窗子 火夫 YOMI 清秋 当晚最大yee妈妈\n最小的“橙汁”小可爱皮皮）",[82,95,96],{},[85,97],{"alt":77,"src":98},"\u002Fpic\u002F4af9831b02001566.jpg",[82,100,101],{},"堆满房间的心意……",[82,103,104],{},[85,105],{"alt":77,"src":106},"\u002Fpic\u002F4af9831b02001567.jpg",[82,108,109],{},"本以为这东西只有男孩给女孩……（想到圣经的一句：赠人玫瑰，手留余香）",[82,111,112],{},"直至此刻心还是暖暖的，为你们，为那夜。",[82,114,115],{},"从来认为“承蒙错爱，不胜感激”和“欢迎惠顾，下次再来”差不多，都是在受惠后既得意又难免的小谦虚。寄到我房间和公司的“信件”和“礼物”与日俱增，包括每次看到这里的留言和字条真的觉得这种分享才是上天的不二馈赠。也是鞭策，监督，告诫，让自己不放弃努力，让自己不同化沉沦。我会尽力去完成自己的梦，你们，是梦想中的部分……",[82,117,118],{},"漫长人生路，其实短短数年。如同部电影，我们置身漆黑专注于荧幕，不过主角换成了自己，过程你也许会觉得晦涩亢长，但真到了头顶的光亮一刻，你才发现那个世界值得诸多留恋。所以，请让我们珍惜。",[82,120,121],{},"我是谁？可有使命？会否夭折？不得而知。但无论那命运背后的手如何的推动，我想我总会笑的！因为，会有人为我守候！在我陨落的一刻，也会有眼泪为我洗涤此前的罪恶！我信。",[82,123,124],{},"不该话题如此沉重，本来该是开心的诉说。但怕是错爱或爱错。因为，我一定不是那个人……一定和你心中的他有或远或近的距离……一定。",[82,126,127],{},"但无妨，交会既是缘。长久和短暂也不过是量化的两端，实质才最重要，体验是唯一财富！",[82,129,130],{},"感谢你们，真的。真的。真的……",[82,132,133],{},"（9月8日照片陆续上传，另：本博客确实本人管理！文章全部本人撰写）",{"title":135,"searchDepth":136,"depth":136,"links":137},"",2,[],[6,9],"md",{"date":141},"2007-09-12 15:26",true,"\u002Fblog\u002Fblog_4af9831b01000a9u",{"title":77,"description":112},"blog_4af9831b01000a9u","blog\u002Fblog_4af9831b01000a9u",[148],"随笔\u002F感悟","QEeK5Grh4vn6DE0vSqwaE7UU_szn4XX5SENH8MP5ldM",[151,156],{"title":152,"path":153,"stem":154,"children":-1,"slug":155},"秘密","\u002Fblog\u002Fblog_4af9831b01000a8c","blog\u002Fblog_4af9831b01000a8c","blog_4af9831b01000a8c",{"title":157,"path":158,"stem":159,"children":-1,"slug":160},"沈阳","\u002Fblog\u002Fblog_4af9831b01000acv","blog\u002Fblog_4af9831b01000acv","blog_4af9831b01000acv",1794412500964]
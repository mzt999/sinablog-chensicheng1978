[{"data":1,"prerenderedAt":86},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b0100bt89":31,"surround-blog_4af9831b0100bt89":75},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",152,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":63,"description":33,"extension":64,"meta":65,"navigation":67,"path":68,"seo":69,"slug":70,"stem":71,"tags":72,"__hash__":74},"blog\u002Fblog\u002Fblog_4af9831b0100bt89.md","海",{"type":35,"value":36,"toc":59},"minimark",[37,44,47,50,53,56],[38,39,40],"p",{},[41,42],"img",{"alt":33,"src":43},"\u002Fpic\u002F4af9831btbc1eaef5e6ea.jpg",[38,45,46],{},"海。",[38,48,49],{},"……人海中相逢相知相守不觉已数载。诸君变化心知自知。感动缘自赤诚，风吹雨打百炼成钢的赤子之心。每每脸上漾起孩童般的笑便是毫无掩饰的一个真男人。",[38,51,52],{},"男人，便是难人。能携手走过一段路，无论叱诧平凡或陨落都不觉唏嘘。千金散尽，黄梁梦醒，又是一片新沧海。举杯共醉，对坐有你，才乃真的慨而慷！",[38,54,55],{},"今朝有酒，便指点江山嬉笑怒骂哪管他人怎个评说，徒自昏噩冷眼世间万种清醒……",[38,57,58],{},"明日上路，看谁可奈何乘风破浪凡尘叹我如此参破，纵横四海举手投足皆成文章……",{"title":60,"searchDepth":61,"depth":61,"links":62},"",2,[],[6,9],"md",{"date":66},"2009-01-11 16:46",true,"\u002Fblog\u002Fblog_4af9831b0100bt89",{"title":33,"description":33},"blog_4af9831b0100bt89","blog\u002Fblog_4af9831b0100bt89",[73],"杂谈","n07iLApzsn31WCDCF7orK4YVmJjamLO6y9YAgmRNevw",[76,81],{"title":77,"path":78,"stem":79,"children":-1,"slug":80},"生个蛋吧","\u002Fblog\u002Fblog_4af9831b0100bo3d","blog\u002Fblog_4af9831b0100bo3d","blog_4af9831b0100bo3d",{"title":82,"path":83,"stem":84,"children":-1,"slug":85},"“予文”——新春寄语","\u002Fblog\u002Fblog_4af9831b0100bx8c","blog\u002Fblog_4af9831b0100bx8c","blog_4af9831b0100bx8c",1793969715448]
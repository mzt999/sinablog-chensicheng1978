[{"data":1,"prerenderedAt":90},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":17,"blog-post-slug-blog_4af9831b0100bt89":34,"surround-blog_4af9831b0100bt89":79},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"latestBlog":18},[19,22,25,28,31],{"title":20,"slug":21},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":23,"slug":24},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":26,"slug":27},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":29,"slug":30},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":32,"slug":33},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":35,"title":36,"body":37,"categories":66,"description":67,"extension":68,"meta":69,"navigation":71,"path":72,"seo":73,"slug":74,"stem":75,"tags":76,"__hash__":78},"blog\u002Fblog\u002Fblog_4af9831b0100bt89.md","海",{"type":38,"value":39,"toc":62},"minimark",[40,47,50,53,56,59],[41,42,43],"p",{},[44,45],"img",{"alt":36,"src":46},"\u002Fpic\u002F4af9831btbc1eaef5e6ea.jpg",[41,48,49],{},"海。",[41,51,52],{},"……人海中相逢相知相守不觉已数载。诸君变化心知自知。感动缘自赤诚，风吹雨打百炼成钢的赤子之心。每每脸上漾起孩童般的笑便是毫无掩饰的一个真男人。",[41,54,55],{},"男人，便是难人。能携手走过一段路，无论叱诧平凡或陨落都不觉唏嘘。千金散尽，黄梁梦醒，又是一片新沧海。举杯共醉，对坐有你，才乃真的慨而慷！",[41,57,58],{},"今朝有酒，便指点江山嬉笑怒骂哪管他人怎个评说，徒自昏噩冷眼世间万种清醒……",[41,60,61],{},"明日上路，看谁可奈何乘风破浪凡尘叹我如此参破，纵横四海举手投足皆成文章……",{"title":63,"searchDepth":64,"depth":64,"links":65},"",2,[],[6,9],"人海中相逢相知相守不觉已数载。","md",{"date":70},"2009-01-11 16:46",true,"\u002Fblog\u002Fblog_4af9831b0100bt89",{"title":36,"description":67},"blog_4af9831b0100bt89","blog\u002Fblog_4af9831b0100bt89",[77],"杂谈","RlALpoQhxw1ko90gIQD5z67wDhtbkymGNZzlpy1nlSc",[80,85],{"title":81,"path":82,"stem":83,"children":-1,"slug":84},"生个蛋吧","\u002Fblog\u002Fblog_4af9831b0100bo3d","blog\u002Fblog_4af9831b0100bo3d","blog_4af9831b0100bo3d",{"title":86,"path":87,"stem":88,"children":-1,"slug":89},"“予文”——新春寄语","\u002Fblog\u002Fblog_4af9831b0100bx8c","blog\u002Fblog_4af9831b0100bx8c","blog_4af9831b0100bx8c",1794049413
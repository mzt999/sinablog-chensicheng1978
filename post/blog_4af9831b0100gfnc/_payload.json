[{"data":1,"prerenderedAt":185},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":73,"blog-post-slug-blog_4af9831b0100gfnc":90,"surround-blog_4af9831b0100gfnc":174},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":48,"navLinks":49,"perPage":16,"prevNextIsExcludeDate":69,"site_description":23,"site_name":70,"stem":71,"__hash__":72},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43,45],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{"href":46,"text":47},"https:\u002F\u002Fmzt999.github.io\u002Fportfolio-chensicheng1978","幕后作品集展示(2012-2026)",{},[50,55,59,63,67],{"path":51,"title":52,"target":53,"fa_class":54},"\u002F","博客首页","internal","fa-home",{"path":56,"title":57,"target":53,"fa_class":58},"\u002Fabout","关于","fa-user",{"path":60,"title":61,"target":53,"fa_class":62},"\u002Fpost","归档","fa-archive",{"path":64,"title":65,"target":53,"fa_class":66},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":68,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","LA_7Y82F2zjQ6-R2_tcWHl356krYL76uqQHBCIU8UZk",{"latestBlog":74},[75,78,81,84,87],{"title":76,"slug":77},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":79,"slug":80},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":82,"slug":83},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":85,"slug":86},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":88,"slug":89},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":91,"title":92,"body":93,"categories":158,"description":159,"extension":160,"meta":161,"navigation":163,"path":164,"seo":165,"slug":166,"stem":167,"tags":168,"__hash__":173},"blog\u002Fblog\u002Fblog_4af9831b0100gfnc.md","光影话流年",{"type":94,"value":95,"toc":154},"minimark",[96,100,103,106,109,112,115,118,121,124,127,130,133,136,139,142,145,148,151],[97,98,99],"p",{},"我是陈思成，",[97,101,102],{},"倒数三百六十五日的黄昏；",[97,104,105],{},"或许我正为拍摄下一场戏而准备；",[97,107,108],{},"或许在为赶一场节目而忙碌",[97,110,111],{},"或许不会想到之后会走上戛纳的地毯，不会想到将以另一种身份坐在摄像机前谈论喜欢的演员和电影。",[97,113,114],{},"或许想到，只是一个目标。",[97,116,117],{},"昨天去录制了《光影星播客》，硕大的屏幕播着我这几年的照片，有些恍然，如梦",[97,119,120],{},"曾经的那些角色历历在目，然后我一路走来，走过哥本哈根的红毯，走过金鹰节的红毯，走上戛纳的红地毯",[97,122,123],{},"那些日子依然记忆犹新",[97,125,126],{},"纠结过，牢骚过，对那些空穴来风风言风语的句子，对那些不实的报道，继而释然，或者说把它们隐藏",[97,128,129],{},"然后只是工作，不想其他。",[97,131,132],{},"节目里我谈到闫妮，谈到孙俪，两个同样优秀却经历截然相反的女星，一个出道后不温不火，近年才藉由《公鸡》成就凤凰；一个从开始就一路坦荡，扶摇直上，如《玉观音》屹立云端。只是却同样隐忍，然后努力，然后勃发，然后循环。",[97,134,135],{},"这就是娱乐圈，抑或这就是规则，隐忍，努力，然后越来越强大，身边的一切越来越清晰，也越来越接近真实。",[97,137,138],{},"谈论演员，谈论电影，和影迷聊天，偶尔闪过的一丝牢骚也在单纯放松的交谈和光影的变幻里消失了",[97,140,141],{},"沉淀心情，像最初一样用婴儿眼睛般清澈的心情寻找某份的记忆，以及对未来的期许。",[97,143,144],{},"出了影棚，夜色初上，和同事共进晚餐。",[97,146,147],{},"绿蚁新醅酒，红泥小火炉，觥筹间思绪开始漫游，又一年将至，过去的得失就过去吧，来年在去沉浸入光影沉淀在那光影，向着那抹红...",[97,149,150],{},"仍要感谢，这年里身边的这些人，以及“光影”带来的点滴。",[97,152,153],{},"最后我的《光影星播客》也将在2010开年1月9-1月15播出，欢迎一起沉溺在光影的世界。",{"title":155,"searchDepth":156,"depth":156,"links":157},"",2,[],[6],"录制了《光影星播客》，硕大的屏幕播着我这几年的照片，有些恍然，如梦","md",{"date":162},"2009-12-23 14:15",true,"\u002Fblog\u002Fblog_4af9831b0100gfnc",{"title":92,"description":159},"blog_4af9831b0100gfnc","blog\u002Fblog_4af9831b0100gfnc",[169,170,171,172],"戛纳","陈思成","娱乐","光影星播客","porcI00266AmW4ddV5FNUdjuQC4P0QYy4ASNkoyMNbo",[175,180],{"title":176,"path":177,"stem":178,"children":-1,"slug":179},"尘缘","\u002Fblog\u002Fblog_4af9831b0100fyqi","blog\u002Fblog_4af9831b0100fyqi","blog_4af9831b0100fyqi",{"title":181,"path":182,"stem":183,"children":-1,"slug":184},"忍","\u002Fblog\u002Fblog_4af9831b0100gp00","blog\u002Fblog_4af9831b0100gp00","blog_4af9831b0100gp00",1794760531894]
[{"data":1,"prerenderedAt":182},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":70,"blog-post-slug-blog_4af9831b0100gfnc":87,"surround-blog_4af9831b0100gfnc":171},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":45,"navLinks":46,"perPage":16,"prevNextIsExcludeDate":66,"site_description":23,"site_name":67,"stem":68,"__hash__":69},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{},[47,52,56,60,64],{"path":48,"title":49,"target":50,"fa_class":51},"\u002F","博客首页","internal","fa-home",{"path":53,"title":54,"target":50,"fa_class":55},"\u002Fabout","关于","fa-user",{"path":57,"title":58,"target":50,"fa_class":59},"\u002Fpost","归档","fa-archive",{"path":61,"title":62,"target":50,"fa_class":63},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":65,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","jvZHccz2rT-wjVS5GCPgWyhl8WnBIvECPkE5KpKFKCU",{"latestBlog":71},[72,75,78,81,84],{"title":73,"slug":74},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":76,"slug":77},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":79,"slug":80},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":82,"slug":83},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":85,"slug":86},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":88,"title":89,"body":90,"categories":155,"description":156,"extension":157,"meta":158,"navigation":160,"path":161,"seo":162,"slug":163,"stem":164,"tags":165,"__hash__":170},"blog\u002Fblog\u002Fblog_4af9831b0100gfnc.md","光影话流年",{"type":91,"value":92,"toc":151},"minimark",[93,97,100,103,106,109,112,115,118,121,124,127,130,133,136,139,142,145,148],[94,95,96],"p",{},"我是陈思成，",[94,98,99],{},"倒数三百六十五日的黄昏；",[94,101,102],{},"或许我正为拍摄下一场戏而准备；",[94,104,105],{},"或许在为赶一场节目而忙碌",[94,107,108],{},"或许不会想到之后会走上戛纳的地毯，不会想到将以另一种身份坐在摄像机前谈论喜欢的演员和电影。",[94,110,111],{},"或许想到，只是一个目标。",[94,113,114],{},"昨天去录制了《光影星播客》，硕大的屏幕播着我这几年的照片，有些恍然，如梦",[94,116,117],{},"曾经的那些角色历历在目，然后我一路走来，走过哥本哈根的红毯，走过金鹰节的红毯，走上戛纳的红地毯",[94,119,120],{},"那些日子依然记忆犹新",[94,122,123],{},"纠结过，牢骚过，对那些空穴来风风言风语的句子，对那些不实的报道，继而释然，或者说把它们隐藏",[94,125,126],{},"然后只是工作，不想其他。",[94,128,129],{},"节目里我谈到闫妮，谈到孙俪，两个同样优秀却经历截然相反的女星，一个出道后不温不火，近年才藉由《公鸡》成就凤凰；一个从开始就一路坦荡，扶摇直上，如《玉观音》屹立云端。只是却同样隐忍，然后努力，然后勃发，然后循环。",[94,131,132],{},"这就是娱乐圈，抑或这就是规则，隐忍，努力，然后越来越强大，身边的一切越来越清晰，也越来越接近真实。",[94,134,135],{},"谈论演员，谈论电影，和影迷聊天，偶尔闪过的一丝牢骚也在单纯放松的交谈和光影的变幻里消失了",[94,137,138],{},"沉淀心情，像最初一样用婴儿眼睛般清澈的心情寻找某份的记忆，以及对未来的期许。",[94,140,141],{},"出了影棚，夜色初上，和同事共进晚餐。",[94,143,144],{},"绿蚁新醅酒，红泥小火炉，觥筹间思绪开始漫游，又一年将至，过去的得失就过去吧，来年在去沉浸入光影沉淀在那光影，向着那抹红...",[94,146,147],{},"仍要感谢，这年里身边的这些人，以及“光影”带来的点滴。",[94,149,150],{},"最后我的《光影星播客》也将在2010开年1月9-1月15播出，欢迎一起沉溺在光影的世界。",{"title":152,"searchDepth":153,"depth":153,"links":154},"",2,[],[6],"录制了《光影星播客》，硕大的屏幕播着我这几年的照片，有些恍然，如梦","md",{"date":159},"2009-12-23 14:15",true,"\u002Fblog\u002Fblog_4af9831b0100gfnc",{"title":89,"description":156},"blog_4af9831b0100gfnc","blog\u002Fblog_4af9831b0100gfnc",[166,167,168,169],"戛纳","陈思成","娱乐","光影星播客","porcI00266AmW4ddV5FNUdjuQC4P0QYy4ASNkoyMNbo",[172,177],{"title":173,"path":174,"stem":175,"children":-1,"slug":176},"尘缘","\u002Fblog\u002Fblog_4af9831b0100fyqi","blog\u002Fblog_4af9831b0100fyqi","blog_4af9831b0100fyqi",{"title":178,"path":179,"stem":180,"children":-1,"slug":181},"忍","\u002Fblog\u002Fblog_4af9831b0100gp00","blog\u002Fblog_4af9831b0100gp00","blog_4af9831b0100gp00",1794544667522]
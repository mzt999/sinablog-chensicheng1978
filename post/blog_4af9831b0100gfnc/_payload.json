[{"data":1,"prerenderedAt":125},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b0100gfnc":31,"surround-blog_4af9831b0100gfnc":114},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",151,{"name":9,"len":10},"有图",34,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":99,"description":33,"extension":100,"meta":101,"navigation":103,"path":104,"seo":105,"slug":106,"stem":107,"tags":108,"__hash__":113},"blog\u002Fblog\u002Fblog_4af9831b0100gfnc.md","光影话流年",{"type":35,"value":36,"toc":95},"minimark",[37,41,44,47,50,53,56,59,62,65,68,71,74,77,80,83,86,89,92],[38,39,40],"p",{},"我是陈思成，",[38,42,43],{},"倒数三百六十五日的黄昏；",[38,45,46],{},"或许我正为拍摄下一场戏而准备；",[38,48,49],{},"或许在为赶一场节目而忙碌",[38,51,52],{},"或许不会想到之后会走上戛纳的地毯，不会想到将以另一种身份坐在摄像机前谈论喜欢的演员和电影。",[38,54,55],{},"或许想到，只是一个目标。",[38,57,58],{},"昨天去录制了《光影星播客》，硕大的屏幕播着我这几年的照片，有些恍然，如梦",[38,60,61],{},"曾经的那些角色历历在目，然后我一路走来，走过哥本哈根的红毯，走过金鹰节的红毯，走上戛纳的红地毯",[38,63,64],{},"那些日子依然记忆犹新",[38,66,67],{},"纠结过，牢骚过，对那些空穴来风风言风语的句子，对那些不实的报道，继而释然，或者说把它们隐藏",[38,69,70],{},"然后只是工作，不想其他。",[38,72,73],{},"节目里我谈到闫妮，谈到孙俪，两个同样优秀却经历截然相反的女星，一个出道后不温不火，近年才藉由《公鸡》成就凤凰；一个从开始就一路坦荡，扶摇直上，如《玉观音》屹立云端。只是却同样隐忍，然后努力，然后勃发，然后循环。",[38,75,76],{},"这就是娱乐圈，抑或这就是规则，隐忍，努力，然后越来越强大，身边的一切越来越清晰，也越来越接近真实。",[38,78,79],{},"谈论演员，谈论电影，和影迷聊天，偶尔闪过的一丝牢骚也在单纯放松的交谈和光影的变幻里消失了",[38,81,82],{},"沉淀心情，像最初一样用婴儿眼睛般清澈的心情寻找某份的记忆，以及对未来的期许。",[38,84,85],{},"出了影棚，夜色初上，和同事共进晚餐。",[38,87,88],{},"绿蚁新醅酒，红泥小火炉，觥筹间思绪开始漫游，又一年将至，过去的得失就过去吧，来年在去沉浸入光影沉淀在那光影，向着那抹红...",[38,90,91],{},"仍要感谢，这年里身边的这些人，以及“光影”带来的点滴。",[38,93,94],{},"最后我的《光影星播客》也将在2010开年1月9-1月15播出，欢迎一起沉溺在光影的世界。",{"title":96,"searchDepth":97,"depth":97,"links":98},"",2,[],[6],"md",{"date":102},"2009-12-23 14:15",true,"\u002Fblog\u002Fblog_4af9831b0100gfnc",{"title":33,"description":33},"blog_4af9831b0100gfnc","blog\u002Fblog_4af9831b0100gfnc",[109,110,111,112],"戛纳","陈思成","娱乐","光影星播客","hTlFL4rt2ERxB4OB32i_DRzYv2Myh7MQFaGeO8mNt1w",[115,120],{"title":116,"path":117,"stem":118,"children":-1,"slug":119},"尘缘","\u002Fblog\u002Fblog_4af9831b0100fyqi","blog\u002Fblog_4af9831b0100fyqi","blog_4af9831b0100fyqi",{"title":121,"path":122,"stem":123,"children":-1,"slug":124},"忍","\u002Fblog\u002Fblog_4af9831b0100gp00","blog\u002Fblog_4af9831b0100gp00","blog_4af9831b0100gp00",1793855957773]
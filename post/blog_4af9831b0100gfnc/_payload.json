[{"data":1,"prerenderedAt":188},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":76,"blog-post-slug-blog_4af9831b0100gfnc":93,"surround-blog_4af9831b0100gfnc":177},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":38,"meta":50,"navLinks":51,"perPage":16,"prevNextIsExcludeDate":71,"site_description":72,"site_name":73,"stem":74,"__hash__":75},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,26,32],{"text":23},"粉丝自制非官方站点｜素材版权归原权利人所有",{"text":25},"仅兴趣交流、无商业用途｜如有侵权请联系删除",{"text":27,"link":28},"查看",{"href":29,"text":30,"fa_class":31},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":33,"link":34},"如有任何疑问，欢迎",{"href":35,"text":36,"fa_class":37},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[39,42,45,47],{"href":40,"text":41},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":43,"text":44},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":46},"新浪微博备份(2009-2026)",{"href":48,"text":49},"https:\u002F\u002Fmzt999.github.io\u002Fportfolio-chensicheng1978","幕后作品集展示(2012-2026)",{},[52,57,61,65,69],{"path":53,"title":54,"target":55,"fa_class":56},"\u002F","博客首页","internal","fa-home",{"path":58,"title":59,"target":55,"fa_class":60},"\u002Fabout","关于","fa-user",{"path":62,"title":63,"target":55,"fa_class":64},"\u002Fpost","归档","fa-archive",{"path":66,"title":67,"target":55,"fa_class":68},"\u002Fgallery","相册","fa-image",{"path":29,"title":30,"target":70,"fa_class":31},"otherSite",false,"新浪博客内容备份(粉丝自用)","陈思诚的博客","settings","5S7xKt0XLHpkjipbomx4I7pUu50Y7wqtD418LquZj5Q",{"latestBlog":77},[78,81,84,87,90],{"title":79,"slug":80},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":82,"slug":83},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":85,"slug":86},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":88,"slug":89},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":91,"slug":92},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":94,"title":95,"body":96,"categories":161,"description":162,"extension":163,"meta":164,"navigation":166,"path":167,"seo":168,"slug":169,"stem":170,"tags":171,"__hash__":176},"blog\u002Fblog\u002Fblog_4af9831b0100gfnc.md","光影话流年",{"type":97,"value":98,"toc":157},"minimark",[99,103,106,109,112,115,118,121,124,127,130,133,136,139,142,145,148,151,154],[100,101,102],"p",{},"我是陈思成，",[100,104,105],{},"倒数三百六十五日的黄昏；",[100,107,108],{},"或许我正为拍摄下一场戏而准备；",[100,110,111],{},"或许在为赶一场节目而忙碌",[100,113,114],{},"或许不会想到之后会走上戛纳的地毯，不会想到将以另一种身份坐在摄像机前谈论喜欢的演员和电影。",[100,116,117],{},"或许想到，只是一个目标。",[100,119,120],{},"昨天去录制了《光影星播客》，硕大的屏幕播着我这几年的照片，有些恍然，如梦",[100,122,123],{},"曾经的那些角色历历在目，然后我一路走来，走过哥本哈根的红毯，走过金鹰节的红毯，走上戛纳的红地毯",[100,125,126],{},"那些日子依然记忆犹新",[100,128,129],{},"纠结过，牢骚过，对那些空穴来风风言风语的句子，对那些不实的报道，继而释然，或者说把它们隐藏",[100,131,132],{},"然后只是工作，不想其他。",[100,134,135],{},"节目里我谈到闫妮，谈到孙俪，两个同样优秀却经历截然相反的女星，一个出道后不温不火，近年才藉由《公鸡》成就凤凰；一个从开始就一路坦荡，扶摇直上，如《玉观音》屹立云端。只是却同样隐忍，然后努力，然后勃发，然后循环。",[100,137,138],{},"这就是娱乐圈，抑或这就是规则，隐忍，努力，然后越来越强大，身边的一切越来越清晰，也越来越接近真实。",[100,140,141],{},"谈论演员，谈论电影，和影迷聊天，偶尔闪过的一丝牢骚也在单纯放松的交谈和光影的变幻里消失了",[100,143,144],{},"沉淀心情，像最初一样用婴儿眼睛般清澈的心情寻找某份的记忆，以及对未来的期许。",[100,146,147],{},"出了影棚，夜色初上，和同事共进晚餐。",[100,149,150],{},"绿蚁新醅酒，红泥小火炉，觥筹间思绪开始漫游，又一年将至，过去的得失就过去吧，来年在去沉浸入光影沉淀在那光影，向着那抹红...",[100,152,153],{},"仍要感谢，这年里身边的这些人，以及“光影”带来的点滴。",[100,155,156],{},"最后我的《光影星播客》也将在2010开年1月9-1月15播出，欢迎一起沉溺在光影的世界。",{"title":158,"searchDepth":159,"depth":159,"links":160},"",2,[],[6],"录制了《光影星播客》，硕大的屏幕播着我这几年的照片，有些恍然，如梦","md",{"date":165},"2009-12-23 14:15",true,"\u002Fblog\u002Fblog_4af9831b0100gfnc",{"title":95,"description":162},"blog_4af9831b0100gfnc","blog\u002Fblog_4af9831b0100gfnc",[172,173,174,175],"戛纳","陈思成","娱乐","光影星播客","porcI00266AmW4ddV5FNUdjuQC4P0QYy4ASNkoyMNbo",[178,183],{"title":179,"path":180,"stem":181,"children":-1,"slug":182},"尘缘","\u002Fblog\u002Fblog_4af9831b0100fyqi","blog\u002Fblog_4af9831b0100fyqi","blog_4af9831b0100fyqi",{"title":184,"path":185,"stem":186,"children":-1,"slug":187},"忍","\u002Fblog\u002Fblog_4af9831b0100gp00","blog\u002Fblog_4af9831b0100gp00","blog_4af9831b0100gp00",1795162025695]
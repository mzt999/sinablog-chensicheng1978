[{"data":1,"prerenderedAt":129},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":17,"blog-post-slug-blog_4af9831b0100gfnc":34,"surround-blog_4af9831b0100gfnc":118},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"latestBlog":18},[19,22,25,28,31],{"title":20,"slug":21},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":23,"slug":24},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":26,"slug":27},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":29,"slug":30},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":32,"slug":33},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":35,"title":36,"body":37,"categories":102,"description":103,"extension":104,"meta":105,"navigation":107,"path":108,"seo":109,"slug":110,"stem":111,"tags":112,"__hash__":117},"blog\u002Fblog\u002Fblog_4af9831b0100gfnc.md","光影话流年",{"type":38,"value":39,"toc":98},"minimark",[40,44,47,50,53,56,59,62,65,68,71,74,77,80,83,86,89,92,95],[41,42,43],"p",{},"我是陈思成，",[41,45,46],{},"倒数三百六十五日的黄昏；",[41,48,49],{},"或许我正为拍摄下一场戏而准备；",[41,51,52],{},"或许在为赶一场节目而忙碌",[41,54,55],{},"或许不会想到之后会走上戛纳的地毯，不会想到将以另一种身份坐在摄像机前谈论喜欢的演员和电影。",[41,57,58],{},"或许想到，只是一个目标。",[41,60,61],{},"昨天去录制了《光影星播客》，硕大的屏幕播着我这几年的照片，有些恍然，如梦",[41,63,64],{},"曾经的那些角色历历在目，然后我一路走来，走过哥本哈根的红毯，走过金鹰节的红毯，走上戛纳的红地毯",[41,66,67],{},"那些日子依然记忆犹新",[41,69,70],{},"纠结过，牢骚过，对那些空穴来风风言风语的句子，对那些不实的报道，继而释然，或者说把它们隐藏",[41,72,73],{},"然后只是工作，不想其他。",[41,75,76],{},"节目里我谈到闫妮，谈到孙俪，两个同样优秀却经历截然相反的女星，一个出道后不温不火，近年才藉由《公鸡》成就凤凰；一个从开始就一路坦荡，扶摇直上，如《玉观音》屹立云端。只是却同样隐忍，然后努力，然后勃发，然后循环。",[41,78,79],{},"这就是娱乐圈，抑或这就是规则，隐忍，努力，然后越来越强大，身边的一切越来越清晰，也越来越接近真实。",[41,81,82],{},"谈论演员，谈论电影，和影迷聊天，偶尔闪过的一丝牢骚也在单纯放松的交谈和光影的变幻里消失了",[41,84,85],{},"沉淀心情，像最初一样用婴儿眼睛般清澈的心情寻找某份的记忆，以及对未来的期许。",[41,87,88],{},"出了影棚，夜色初上，和同事共进晚餐。",[41,90,91],{},"绿蚁新醅酒，红泥小火炉，觥筹间思绪开始漫游，又一年将至，过去的得失就过去吧，来年在去沉浸入光影沉淀在那光影，向着那抹红...",[41,93,94],{},"仍要感谢，这年里身边的这些人，以及“光影”带来的点滴。",[41,96,97],{},"最后我的《光影星播客》也将在2010开年1月9-1月15播出，欢迎一起沉溺在光影的世界。",{"title":99,"searchDepth":100,"depth":100,"links":101},"",2,[],[6],"录制了《光影星播客》，硕大的屏幕播着我这几年的照片，有些恍然，如梦","md",{"date":106},"2009-12-23 14:15",true,"\u002Fblog\u002Fblog_4af9831b0100gfnc",{"title":36,"description":103},"blog_4af9831b0100gfnc","blog\u002Fblog_4af9831b0100gfnc",[113,114,115,116],"戛纳","陈思成","娱乐","光影星播客","porcI00266AmW4ddV5FNUdjuQC4P0QYy4ASNkoyMNbo",[119,124],{"title":120,"path":121,"stem":122,"children":-1,"slug":123},"尘缘","\u002Fblog\u002Fblog_4af9831b0100fyqi","blog\u002Fblog_4af9831b0100fyqi","blog_4af9831b0100fyqi",{"title":125,"path":126,"stem":127,"children":-1,"slug":128},"忍","\u002Fblog\u002Fblog_4af9831b0100gp00","blog\u002Fblog_4af9831b0100gp00","blog_4af9831b0100gp00",1794049413169]
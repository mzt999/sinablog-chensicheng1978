[{"data":1,"prerenderedAt":170},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":58,"blog-post-slug-blog_4af9831b0100gfnc":75,"surround-blog_4af9831b0100gfnc":159},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":54,"site_description":55,"stem":56,"__hash__":57},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo",20,"新浪博客内容备份","settings","hh8X7X6SFDoeJrxIJ4yisZXSc3HwHM1zk206jiQX2XU",{"latestBlog":59},[60,63,66,69,72],{"title":61,"slug":62},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":64,"slug":65},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":67,"slug":68},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":70,"slug":71},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":73,"slug":74},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":76,"title":77,"body":78,"categories":143,"description":144,"extension":145,"meta":146,"navigation":148,"path":149,"seo":150,"slug":151,"stem":152,"tags":153,"__hash__":158},"blog\u002Fblog\u002Fblog_4af9831b0100gfnc.md","光影话流年",{"type":79,"value":80,"toc":139},"minimark",[81,85,88,91,94,97,100,103,106,109,112,115,118,121,124,127,130,133,136],[82,83,84],"p",{},"我是陈思成，",[82,86,87],{},"倒数三百六十五日的黄昏；",[82,89,90],{},"或许我正为拍摄下一场戏而准备；",[82,92,93],{},"或许在为赶一场节目而忙碌",[82,95,96],{},"或许不会想到之后会走上戛纳的地毯，不会想到将以另一种身份坐在摄像机前谈论喜欢的演员和电影。",[82,98,99],{},"或许想到，只是一个目标。",[82,101,102],{},"昨天去录制了《光影星播客》，硕大的屏幕播着我这几年的照片，有些恍然，如梦",[82,104,105],{},"曾经的那些角色历历在目，然后我一路走来，走过哥本哈根的红毯，走过金鹰节的红毯，走上戛纳的红地毯",[82,107,108],{},"那些日子依然记忆犹新",[82,110,111],{},"纠结过，牢骚过，对那些空穴来风风言风语的句子，对那些不实的报道，继而释然，或者说把它们隐藏",[82,113,114],{},"然后只是工作，不想其他。",[82,116,117],{},"节目里我谈到闫妮，谈到孙俪，两个同样优秀却经历截然相反的女星，一个出道后不温不火，近年才藉由《公鸡》成就凤凰；一个从开始就一路坦荡，扶摇直上，如《玉观音》屹立云端。只是却同样隐忍，然后努力，然后勃发，然后循环。",[82,119,120],{},"这就是娱乐圈，抑或这就是规则，隐忍，努力，然后越来越强大，身边的一切越来越清晰，也越来越接近真实。",[82,122,123],{},"谈论演员，谈论电影，和影迷聊天，偶尔闪过的一丝牢骚也在单纯放松的交谈和光影的变幻里消失了",[82,125,126],{},"沉淀心情，像最初一样用婴儿眼睛般清澈的心情寻找某份的记忆，以及对未来的期许。",[82,128,129],{},"出了影棚，夜色初上，和同事共进晚餐。",[82,131,132],{},"绿蚁新醅酒，红泥小火炉，觥筹间思绪开始漫游，又一年将至，过去的得失就过去吧，来年在去沉浸入光影沉淀在那光影，向着那抹红...",[82,134,135],{},"仍要感谢，这年里身边的这些人，以及“光影”带来的点滴。",[82,137,138],{},"最后我的《光影星播客》也将在2010开年1月9-1月15播出，欢迎一起沉溺在光影的世界。",{"title":140,"searchDepth":141,"depth":141,"links":142},"",2,[],[6],"录制了《光影星播客》，硕大的屏幕播着我这几年的照片，有些恍然，如梦","md",{"date":147},"2009-12-23 14:15",true,"\u002Fblog\u002Fblog_4af9831b0100gfnc",{"title":77,"description":144},"blog_4af9831b0100gfnc","blog\u002Fblog_4af9831b0100gfnc",[154,155,156,157],"戛纳","陈思成","娱乐","光影星播客","porcI00266AmW4ddV5FNUdjuQC4P0QYy4ASNkoyMNbo",[160,165],{"title":161,"path":162,"stem":163,"children":-1,"slug":164},"尘缘","\u002Fblog\u002Fblog_4af9831b0100fyqi","blog\u002Fblog_4af9831b0100fyqi","blog_4af9831b0100fyqi",{"title":166,"path":167,"stem":168,"children":-1,"slug":169},"忍","\u002Fblog\u002Fblog_4af9831b0100gp00","blog\u002Fblog_4af9831b0100gp00","blog_4af9831b0100gp00",1794412500484]
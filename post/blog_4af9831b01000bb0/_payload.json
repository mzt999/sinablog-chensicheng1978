[{"data":1,"prerenderedAt":166},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":73,"blog-post-slug-blog_4af9831b01000bb0":90,"surround-blog_4af9831b01000bb0":155},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":48,"navLinks":49,"perPage":16,"prevNextIsExcludeDate":69,"site_description":23,"site_name":70,"stem":71,"__hash__":72},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43,45],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{"href":46,"text":47},"https:\u002F\u002Fmzt999.github.io\u002Fportfolio-chensicheng1978","幕后作品集展示(2012-2026)",{},[50,55,59,63,67],{"path":51,"title":52,"target":53,"fa_class":54},"\u002F","博客首页","internal","fa-home",{"path":56,"title":57,"target":53,"fa_class":58},"\u002Fabout","关于","fa-user",{"path":60,"title":61,"target":53,"fa_class":62},"\u002Fpost","归档","fa-archive",{"path":64,"title":65,"target":53,"fa_class":66},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":68,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","LA_7Y82F2zjQ6-R2_tcWHl356krYL76uqQHBCIU8UZk",{"latestBlog":74},[75,78,81,84,87],{"title":76,"slug":77},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":79,"slug":80},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":82,"slug":83},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":85,"slug":86},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":88,"slug":89},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":91,"title":92,"body":93,"categories":143,"description":99,"extension":144,"meta":145,"navigation":147,"path":148,"seo":149,"slug":150,"stem":151,"tags":152,"__hash__":154},"blog\u002Fblog\u002Fblog_4af9831b01000bb0.md","明天",{"type":94,"value":95,"toc":139},"minimark",[96,100,103,109,112,115,120,123,128,131,136],[97,98,99],"p",{},"明天，早8点 广州飞北京  —— 晚10点15分 北京飞广州",[97,101,102],{},"“着陆”的几个小时要做下列几件事：\n1 和老爸老妈吃顿“家里饭”\n2 为后面的工作和某导演同志“亲密接触”下\n3 为即将播出的“子弹”给河北卫视2进“非常剧星”\n4 “弹头”和“弹片弹药”们再次融合互喷\n5 唱首“我爱你”不知给谁……",[97,104,105],{},[106,107],"img",{"alt":92,"src":108},"\u002Fpic\u002F4af9831b0200176g.jpg",[97,110,111],{},"都要杀青了，不知不靠谱的谁留下的规矩，哪个演员杀青就要请吃“肯德鸡”！最近我的头越发的像“鸡窝”了！靠！行不行？就不能来点创新？",[97,113,114],{},"换成“麦当劳”？",[97,116,117],{},[106,118],{"alt":92,"src":119},"\u002Fpic\u002F4af9831b0200176f.jpg",[97,121,122],{},"现场的我，即兴作画。导演挠着脑袋问我画谁呢？说谁也不像啊？我说:\n你猜……完全画着玩……孩子气的他说也要玩于是拿起笔开始画我，可惜！他真的没我有天赋，画得巨烂……",[97,124,125],{},[106,126],{"alt":92,"src":127},"\u002Fpic\u002F4af9831b0200176e.jpg",[97,129,130],{},"好多人关心我的“狗肉”！今天给大家看！长大点了吧……它真的太帅了！而且据老妈讲，它各方面居然都有我的风范！如聪明，帅哥，淘气，可爱，坚持，早熟……等哈哈不愧为狗中极品，狗王之王“不辣的皮特”！",[97,132,133],{},[106,134],{"alt":92,"src":135},"\u002Fpic\u002F4af9831b0200176d.jpg",[97,137,138],{},"　　　最后，祝大家“重阳节”快乐！还有橙子即将与２５日杀青东莞！船家同志可以转告窗子　ＬＩＬＩ　ＹＯＭＩ等大家……祝快乐！",{"title":140,"searchDepth":141,"depth":141,"links":142},"",2,[],[6,9],"md",{"date":146},"2007-10-19 22:58",true,"\u002Fblog\u002Fblog_4af9831b01000bb0",{"title":92,"description":99},"blog_4af9831b01000bb0","blog\u002Fblog_4af9831b01000bb0",[153],"生活记录","byHTEFBCwG-64Gf9nwiz5wIUHjWvbGIXFLcLqbEwgkc",[156,161],{"title":157,"path":158,"stem":159,"children":-1,"slug":160},"我们都是好孩子","\u002Fblog\u002Fblog_4af9831b01000ba5","blog\u002Fblog_4af9831b01000ba5","blog_4af9831b01000ba5",{"title":162,"path":163,"stem":164,"children":-1,"slug":165},"北京的冬天","\u002Fblog\u002Fblog_4af9831b01000bfv","blog\u002Fblog_4af9831b01000bfv","blog_4af9831b01000bfv",1794760532230]
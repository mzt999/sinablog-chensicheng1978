[{"data":1,"prerenderedAt":110},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b01000bb0":31,"surround-blog_4af9831b01000bb0":99},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",152,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":87,"description":33,"extension":88,"meta":89,"navigation":91,"path":92,"seo":93,"slug":94,"stem":95,"tags":96,"__hash__":98},"blog\u002Fblog\u002Fblog_4af9831b01000bb0.md","明天",{"type":35,"value":36,"toc":83},"minimark",[37,41,44,47,53,56,59,64,67,72,75,80],[38,39,40],"p",{},"明天，早8点 广州飞北京  —— 晚10点15分\n北京飞广州",[38,42,43],{},"“着陆”的几个小时要做下列几件事： 1 和老爸老妈吃顿“家里饭”",[38,45,46],{},"2 为后面的工作和某导演同志“亲密接触”下 3\n为即将播出的“子弹”给河北卫视2进“非常剧星”4\n“弹头”和“弹片弹药”们再次融合互喷 5\n唱首“我爱你”不知给谁……",[38,48,49],{},[50,51],"img",{"alt":33,"src":52},"\u002Fpic\u002F4af9831b0200176g.jpg",[38,54,55],{},"都要杀青了，不知不靠谱的谁留下的规矩，哪个演员杀青就要请吃“肯德鸡”！最近我的头越发的像“鸡窝”了！靠！行不行？就不能来点创新？",[38,57,58],{},"换成“麦当劳”？",[38,60,61],{},[50,62],{"alt":33,"src":63},"\u002Fpic\u002F4af9831b0200176f.jpg",[38,65,66],{},"现场的我，即兴作画。导演挠着脑袋问我画谁呢？说谁也不像啊？我说:\n你猜……完全画着玩……孩子气的他说也要玩于是拿起笔开始画我，可惜！他真的没我有天赋，画得巨烂……",[38,68,69],{},[50,70],{"alt":33,"src":71},"\u002Fpic\u002F4af9831b0200176e.jpg",[38,73,74],{},"好多人关心我的“狗肉”！今天给大家看！长大点了吧……它真的太帅了！而且据老妈讲，它各方面居然都有我的风范！如聪明，帅哥，淘气，可爱，坚持，早熟……等哈哈不愧为狗中极品，狗王之王“不辣的皮特”！",[38,76,77],{},[50,78],{"alt":33,"src":79},"\u002Fpic\u002F4af9831b0200176d.jpg",[38,81,82],{},"　　　最后，祝大家“重阳节”快乐！还有橙子即将与２５日杀青东莞！船家同志可以转告窗子　ＬＩＬＩ　ＹＯＭＩ等大家……祝快乐！",{"title":84,"searchDepth":85,"depth":85,"links":86},"",2,[],[6,9],"md",{"date":90},"2007-10-19 22:58",true,"\u002Fblog\u002Fblog_4af9831b01000bb0",{"title":33,"description":33},"blog_4af9831b01000bb0","blog\u002Fblog_4af9831b01000bb0",[97],"生活记录","YY_zKJdLihN_Z_7JYRvs_CrRP2Rq8YPcBAowmVcQ8F0",[100,105],{"title":101,"path":102,"stem":103,"children":-1,"slug":104},"我们都是好孩子","\u002Fblog\u002Fblog_4af9831b01000ba5","blog\u002Fblog_4af9831b01000ba5","blog_4af9831b01000ba5",{"title":106,"path":107,"stem":108,"children":-1,"slug":109},"北京的冬天","\u002Fblog\u002Fblog_4af9831b01000bfv","blog\u002Fblog_4af9831b01000bfv","blog_4af9831b01000bfv",1793977518526]
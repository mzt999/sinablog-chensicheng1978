[{"data":1,"prerenderedAt":110},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":17,"blog-post-slug-blog_4af9831b01000bb0":34,"surround-blog_4af9831b01000bb0":99},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"latestBlog":18},[19,22,25,28,31],{"title":20,"slug":21},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":23,"slug":24},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":26,"slug":27},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":29,"slug":30},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":32,"slug":33},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":35,"title":36,"body":37,"categories":87,"description":43,"extension":88,"meta":89,"navigation":91,"path":92,"seo":93,"slug":94,"stem":95,"tags":96,"__hash__":98},"blog\u002Fblog\u002Fblog_4af9831b01000bb0.md","明天",{"type":38,"value":39,"toc":83},"minimark",[40,44,47,53,56,59,64,67,72,75,80],[41,42,43],"p",{},"明天，早8点 广州飞北京  —— 晚10点15分 北京飞广州",[41,45,46],{},"“着陆”的几个小时要做下列几件事：\n1 和老爸老妈吃顿“家里饭”\n2 为后面的工作和某导演同志“亲密接触”下\n3 为即将播出的“子弹”给河北卫视2进“非常剧星”\n4 “弹头”和“弹片弹药”们再次融合互喷\n5 唱首“我爱你”不知给谁……",[41,48,49],{},[50,51],"img",{"alt":36,"src":52},"\u002Fpic\u002F4af9831b0200176g.jpg",[41,54,55],{},"都要杀青了，不知不靠谱的谁留下的规矩，哪个演员杀青就要请吃“肯德鸡”！最近我的头越发的像“鸡窝”了！靠！行不行？就不能来点创新？",[41,57,58],{},"换成“麦当劳”？",[41,60,61],{},[50,62],{"alt":36,"src":63},"\u002Fpic\u002F4af9831b0200176f.jpg",[41,65,66],{},"现场的我，即兴作画。导演挠着脑袋问我画谁呢？说谁也不像啊？我说:\n你猜……完全画着玩……孩子气的他说也要玩于是拿起笔开始画我，可惜！他真的没我有天赋，画得巨烂……",[41,68,69],{},[50,70],{"alt":36,"src":71},"\u002Fpic\u002F4af9831b0200176e.jpg",[41,73,74],{},"好多人关心我的“狗肉”！今天给大家看！长大点了吧……它真的太帅了！而且据老妈讲，它各方面居然都有我的风范！如聪明，帅哥，淘气，可爱，坚持，早熟……等哈哈不愧为狗中极品，狗王之王“不辣的皮特”！",[41,76,77],{},[50,78],{"alt":36,"src":79},"\u002Fpic\u002F4af9831b0200176d.jpg",[41,81,82],{},"　　　最后，祝大家“重阳节”快乐！还有橙子即将与２５日杀青东莞！船家同志可以转告窗子　ＬＩＬＩ　ＹＯＭＩ等大家……祝快乐！",{"title":84,"searchDepth":85,"depth":85,"links":86},"",2,[],[6,9],"md",{"date":90},"2007-10-19 22:58",true,"\u002Fblog\u002Fblog_4af9831b01000bb0",{"title":36,"description":43},"blog_4af9831b01000bb0","blog\u002Fblog_4af9831b01000bb0",[97],"生活记录","byHTEFBCwG-64Gf9nwiz5wIUHjWvbGIXFLcLqbEwgkc",[100,105],{"title":101,"path":102,"stem":103,"children":-1,"slug":104},"我们都是好孩子","\u002Fblog\u002Fblog_4af9831b01000ba5","blog\u002Fblog_4af9831b01000ba5","blog_4af9831b01000ba5",{"title":106,"path":107,"stem":108,"children":-1,"slug":109},"北京的冬天","\u002Fblog\u002Fblog_4af9831b01000bfv","blog\u002Fblog_4af9831b01000bfv","blog_4af9831b01000bfv",1794049611102]
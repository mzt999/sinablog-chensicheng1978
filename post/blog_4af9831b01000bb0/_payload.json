[{"data":1,"prerenderedAt":151},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":58,"blog-post-slug-blog_4af9831b01000bb0":75,"surround-blog_4af9831b01000bb0":140},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":54,"site_description":55,"stem":56,"__hash__":57},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo",20,"新浪博客内容备份","settings","hh8X7X6SFDoeJrxIJ4yisZXSc3HwHM1zk206jiQX2XU",{"latestBlog":59},[60,63,66,69,72],{"title":61,"slug":62},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":64,"slug":65},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":67,"slug":68},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":70,"slug":71},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":73,"slug":74},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":76,"title":77,"body":78,"categories":128,"description":84,"extension":129,"meta":130,"navigation":132,"path":133,"seo":134,"slug":135,"stem":136,"tags":137,"__hash__":139},"blog\u002Fblog\u002Fblog_4af9831b01000bb0.md","明天",{"type":79,"value":80,"toc":124},"minimark",[81,85,88,94,97,100,105,108,113,116,121],[82,83,84],"p",{},"明天，早8点 广州飞北京  —— 晚10点15分 北京飞广州",[82,86,87],{},"“着陆”的几个小时要做下列几件事：\n1 和老爸老妈吃顿“家里饭”\n2 为后面的工作和某导演同志“亲密接触”下\n3 为即将播出的“子弹”给河北卫视2进“非常剧星”\n4 “弹头”和“弹片弹药”们再次融合互喷\n5 唱首“我爱你”不知给谁……",[82,89,90],{},[91,92],"img",{"alt":77,"src":93},"\u002Fpic\u002F4af9831b0200176g.jpg",[82,95,96],{},"都要杀青了，不知不靠谱的谁留下的规矩，哪个演员杀青就要请吃“肯德鸡”！最近我的头越发的像“鸡窝”了！靠！行不行？就不能来点创新？",[82,98,99],{},"换成“麦当劳”？",[82,101,102],{},[91,103],{"alt":77,"src":104},"\u002Fpic\u002F4af9831b0200176f.jpg",[82,106,107],{},"现场的我，即兴作画。导演挠着脑袋问我画谁呢？说谁也不像啊？我说:\n你猜……完全画着玩……孩子气的他说也要玩于是拿起笔开始画我，可惜！他真的没我有天赋，画得巨烂……",[82,109,110],{},[91,111],{"alt":77,"src":112},"\u002Fpic\u002F4af9831b0200176e.jpg",[82,114,115],{},"好多人关心我的“狗肉”！今天给大家看！长大点了吧……它真的太帅了！而且据老妈讲，它各方面居然都有我的风范！如聪明，帅哥，淘气，可爱，坚持，早熟……等哈哈不愧为狗中极品，狗王之王“不辣的皮特”！",[82,117,118],{},[91,119],{"alt":77,"src":120},"\u002Fpic\u002F4af9831b0200176d.jpg",[82,122,123],{},"　　　最后，祝大家“重阳节”快乐！还有橙子即将与２５日杀青东莞！船家同志可以转告窗子　ＬＩＬＩ　ＹＯＭＩ等大家……祝快乐！",{"title":125,"searchDepth":126,"depth":126,"links":127},"",2,[],[6,9],"md",{"date":131},"2007-10-19 22:58",true,"\u002Fblog\u002Fblog_4af9831b01000bb0",{"title":77,"description":84},"blog_4af9831b01000bb0","blog\u002Fblog_4af9831b01000bb0",[138],"生活记录","byHTEFBCwG-64Gf9nwiz5wIUHjWvbGIXFLcLqbEwgkc",[141,146],{"title":142,"path":143,"stem":144,"children":-1,"slug":145},"我们都是好孩子","\u002Fblog\u002Fblog_4af9831b01000ba5","blog\u002Fblog_4af9831b01000ba5","blog_4af9831b01000ba5",{"title":147,"path":148,"stem":149,"children":-1,"slug":150},"北京的冬天","\u002Fblog\u002Fblog_4af9831b01000bfv","blog\u002Fblog_4af9831b01000bfv","blog_4af9831b01000bfv",1794412500892]
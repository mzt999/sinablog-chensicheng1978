[{"data":1,"prerenderedAt":169},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":76,"blog-post-slug-blog_4af9831b01000bb0":93,"surround-blog_4af9831b01000bb0":158},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":38,"meta":50,"navLinks":51,"perPage":16,"prevNextIsExcludeDate":71,"site_description":72,"site_name":73,"stem":74,"__hash__":75},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,26,32],{"text":23},"粉丝自制非官方站点｜素材版权归原权利人所有",{"text":25},"仅兴趣交流、无商业用途｜如有侵权请联系删除",{"text":27,"link":28},"查看",{"href":29,"text":30,"fa_class":31},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":33,"link":34},"如有任何疑问，欢迎",{"href":35,"text":36,"fa_class":37},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[39,42,45,47],{"href":40,"text":41},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":43,"text":44},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":46},"新浪微博备份(2009-2026)",{"href":48,"text":49},"https:\u002F\u002Fmzt999.github.io\u002Fportfolio-chensicheng1978","幕后作品集展示(2012-2026)",{},[52,57,61,65,69],{"path":53,"title":54,"target":55,"fa_class":56},"\u002F","博客首页","internal","fa-home",{"path":58,"title":59,"target":55,"fa_class":60},"\u002Fabout","关于","fa-user",{"path":62,"title":63,"target":55,"fa_class":64},"\u002Fpost","归档","fa-archive",{"path":66,"title":67,"target":55,"fa_class":68},"\u002Fgallery","相册","fa-image",{"path":29,"title":30,"target":70,"fa_class":31},"otherSite",false,"新浪博客内容备份(粉丝自用)","陈思诚的博客","settings","5S7xKt0XLHpkjipbomx4I7pUu50Y7wqtD418LquZj5Q",{"latestBlog":77},[78,81,84,87,90],{"title":79,"slug":80},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":82,"slug":83},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":85,"slug":86},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":88,"slug":89},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":91,"slug":92},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":94,"title":95,"body":96,"categories":146,"description":102,"extension":147,"meta":148,"navigation":150,"path":151,"seo":152,"slug":153,"stem":154,"tags":155,"__hash__":157},"blog\u002Fblog\u002Fblog_4af9831b01000bb0.md","明天",{"type":97,"value":98,"toc":142},"minimark",[99,103,106,112,115,118,123,126,131,134,139],[100,101,102],"p",{},"明天，早8点 广州飞北京  —— 晚10点15分 北京飞广州",[100,104,105],{},"“着陆”的几个小时要做下列几件事：\n1 和老爸老妈吃顿“家里饭”\n2 为后面的工作和某导演同志“亲密接触”下\n3 为即将播出的“子弹”给河北卫视2进“非常剧星”\n4 “弹头”和“弹片弹药”们再次融合互喷\n5 唱首“我爱你”不知给谁……",[100,107,108],{},[109,110],"img",{"alt":95,"src":111},"\u002Fpic\u002F4af9831b0200176g.jpg",[100,113,114],{},"都要杀青了，不知不靠谱的谁留下的规矩，哪个演员杀青就要请吃“肯德鸡”！最近我的头越发的像“鸡窝”了！靠！行不行？就不能来点创新？",[100,116,117],{},"换成“麦当劳”？",[100,119,120],{},[109,121],{"alt":95,"src":122},"\u002Fpic\u002F4af9831b0200176f.jpg",[100,124,125],{},"现场的我，即兴作画。导演挠着脑袋问我画谁呢？说谁也不像啊？我说:\n你猜……完全画着玩……孩子气的他说也要玩于是拿起笔开始画我，可惜！他真的没我有天赋，画得巨烂……",[100,127,128],{},[109,129],{"alt":95,"src":130},"\u002Fpic\u002F4af9831b0200176e.jpg",[100,132,133],{},"好多人关心我的“狗肉”！今天给大家看！长大点了吧……它真的太帅了！而且据老妈讲，它各方面居然都有我的风范！如聪明，帅哥，淘气，可爱，坚持，早熟……等哈哈不愧为狗中极品，狗王之王“不辣的皮特”！",[100,135,136],{},[109,137],{"alt":95,"src":138},"\u002Fpic\u002F4af9831b0200176d.jpg",[100,140,141],{},"　　　最后，祝大家“重阳节”快乐！还有橙子即将与２５日杀青东莞！船家同志可以转告窗子　ＬＩＬＩ　ＹＯＭＩ等大家……祝快乐！",{"title":143,"searchDepth":144,"depth":144,"links":145},"",2,[],[6,9],"md",{"date":149},"2007-10-19 22:58",true,"\u002Fblog\u002Fblog_4af9831b01000bb0",{"title":95,"description":102},"blog_4af9831b01000bb0","blog\u002Fblog_4af9831b01000bb0",[156],"生活记录","byHTEFBCwG-64Gf9nwiz5wIUHjWvbGIXFLcLqbEwgkc",[159,164],{"title":160,"path":161,"stem":162,"children":-1,"slug":163},"我们都是好孩子","\u002Fblog\u002Fblog_4af9831b01000ba5","blog\u002Fblog_4af9831b01000ba5","blog_4af9831b01000ba5",{"title":165,"path":166,"stem":167,"children":-1,"slug":168},"北京的冬天","\u002Fblog\u002Fblog_4af9831b01000bfv","blog\u002Fblog_4af9831b01000bfv","blog_4af9831b01000bfv",1795162025989]
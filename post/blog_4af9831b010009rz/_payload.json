[{"data":1,"prerenderedAt":80},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b010009rz":31,"surround-blog_4af9831b010009rz":69},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",151,{"name":9,"len":10},"有图",34,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":57,"description":33,"extension":58,"meta":59,"navigation":61,"path":62,"seo":63,"slug":64,"stem":65,"tags":66,"__hash__":68},"blog\u002Fblog\u002Fblog_4af9831b010009rz.md","广告",{"type":35,"value":36,"toc":53},"minimark",[37,41,44,47,50],[38,39,40],"p",{},"1\n希望大家加入\"绿水晶\"给我建立的博客圈子.尽管我都不知道那是做什么的!",[38,42,43],{},"本人十足电脑白痴,还好有几个好友在帮我打理!所以隆重感谢\"小鬼\"\"77\"\"猫\"\"芝麻\"等人!但文章和照片绝对真实!",[38,45,46],{},"2\n感谢现在所有的朋友!因为你们的喜欢是真的喜欢!所以我在空闲时间一定尽力回复每个朋友的话!但过些时间,我的博客也会被\"外挂\"到\"新浪\"娱乐什么的,那时候就真的不能再加好友了,请见谅!",[38,48,49],{},"3\n橙子要去吃饭了.时间真的很紧张,巨多事情要解决!但是\"不抛弃不放弃\"一定贯穿始终!所以,留言和纸条挑这回了几个...没回的别怒啊!",[38,51,52],{},"4\n感谢每一个留言给我的朋友,因为真实的感动总缘于最初!所以,我们会一直走下去!",{"title":54,"searchDepth":55,"depth":55,"links":56},"",2,[],[6],"md",{"date":60},"2007-08-10 17:31",true,"\u002Fblog\u002Fblog_4af9831b010009rz",{"title":33,"description":33},"blog_4af9831b010009rz","blog\u002Fblog_4af9831b010009rz",[67],"情感故事","eq1-Shkp2_W8nGucOwaBC-dUIb8ANpF4YFh_B56pG7I",[70,75],{"title":71,"path":72,"stem":73,"children":-1,"slug":74},"他不是李白","\u002Fblog\u002Fblog_4af9831b010009r6","blog\u002Fblog_4af9831b010009r6","blog_4af9831b010009r6",{"title":76,"path":77,"stem":78,"children":-1,"slug":79},"晚不安","\u002Fblog\u002Fblog_4af9831b010009t5","blog\u002Fblog_4af9831b010009t5","blog_4af9831b010009t5",1793773698232]
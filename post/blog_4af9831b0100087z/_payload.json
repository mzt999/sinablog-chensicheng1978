[{"data":1,"prerenderedAt":104},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":17,"blog-post-slug-blog_4af9831b0100087z":34,"surround-blog_4af9831b0100087z":93},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"latestBlog":18},[19,22,25,28,31],{"title":20,"slug":21},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":23,"slug":24},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":26,"slug":27},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":29,"slug":30},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":32,"slug":33},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":35,"title":36,"body":37,"categories":81,"description":82,"extension":83,"meta":84,"navigation":86,"path":87,"seo":88,"slug":89,"stem":90,"tags":91,"__hash__":92},"blog\u002Fblog\u002Fblog_4af9831b0100087z.md","无题",{"type":38,"value":39,"toc":77},"minimark",[40,44,47,50,53,56,59,62,65,68,71,74],[41,42,43],"p",{},"前晚喝大了,因为来了故人,导演系的一个才子.江边,微雨,醇酒,好鱼,朋友和美女...那个瞬间是完美的,但太匆匆.借着酒劲写了一堆东西用铁民的电脑.但生于操练,又全没了...于是某个同志帮我写了个\"太久\n太久\"还大言不惭的说是应该留白.",[41,45,46],{},"忙是第一个原因.可这不是现在才来的理由.其实,就是想遁世.想沉浸在故事和角色里更多些...所以怕上来,不知该怎么面对你们.因为面对你们的时候,我是我.可有时候我不想是自己...",[41,48,49],{},"故事虽然悲壮,但最少雄浑真实,温暖得轰轰烈烈爱得死去活来!拥有即便短暂可毕竟算是拥有.",[41,51,52],{},"你们好吗?小狼的心情可有恢复?77,XY,猫,雨婷,水儿,燃燃,妖妖...当然还有鬼.你们不会不好,我信的.因为平淡也是很好.",[41,54,55],{},"我很好,但也怕这种好的逝去...我仿佛借着这部戏回到了大学时代.有什么比青春更好?",[41,57,58],{},"戏演了不少.真正让我爱的不多.\u003C士兵>\u003C民工>和现在的\u003C子弹>.因为她们有个共性,就是都让我动了心.或者说她们改变过或正在改变着我.",[41,60,61],{},"  在等化装,夜戏.江边打架.",[41,63,64],{},"身后的一个同志在补觉...我在用此人的电脑...隔壁和对面的房间有师妹们的笑,走廊上有哥们的喊叫\"走了!该你化妆了!...\"",[41,66,67],{},"又一个夜晚,又一段故事里的生活...",[41,69,70],{},"究竟是我在演绎别人?还是无数个角色演绎自己?",[41,72,73],{},"  走了,别让人等太久.",[41,75,76],{},"祝愿你们都好,如今夜...如我...",{"title":78,"searchDepth":79,"depth":79,"links":80},"",2,[],[6],"前晚喝大了,因为来了故人,导演系的一个才子.","md",{"date":85},"2007-04-24 19:35",true,"\u002Fblog\u002Fblog_4af9831b0100087z",{"title":36,"description":82},"blog_4af9831b0100087z","blog\u002Fblog_4af9831b0100087z",[],"HXljM_R3E9gflMreCE1HL7ZWbNAPiPo1xGuN97twlZw",[94,99],{"title":95,"path":96,"stem":97,"children":-1,"slug":98},"太久  太久......","\u002Fblog\u002Fblog_4af9831b0100086d","blog\u002Fblog_4af9831b0100086d","blog_4af9831b0100086d",{"title":100,"path":101,"stem":102,"children":-1,"slug":103},"爱上梦中人","\u002Fblog\u002Fblog_4af9831b0100088s","blog\u002Fblog_4af9831b0100088s","blog_4af9831b0100088s",1794059574466]
[{"data":1,"prerenderedAt":144},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":57,"blog-post-slug-blog_4af9831b0100087z":74,"surround-blog_4af9831b0100087z":133},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":16,"site_description":54,"stem":55,"__hash__":56},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo","新浪博客内容备份(粉丝自用)","settings","jPD1QWrYwbaIixg6lntppEYe-T3ZGd3EJZxFBkbKY9E",{"latestBlog":58},[59,62,65,68,71],{"title":60,"slug":61},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":63,"slug":64},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":66,"slug":67},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":69,"slug":70},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":72,"slug":73},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":75,"title":76,"body":77,"categories":121,"description":122,"extension":123,"meta":124,"navigation":126,"path":127,"seo":128,"slug":129,"stem":130,"tags":131,"__hash__":132},"blog\u002Fblog\u002Fblog_4af9831b0100087z.md","无题",{"type":78,"value":79,"toc":117},"minimark",[80,84,87,90,93,96,99,102,105,108,111,114],[81,82,83],"p",{},"前晚喝大了,因为来了故人,导演系的一个才子.江边,微雨,醇酒,好鱼,朋友和美女...那个瞬间是完美的,但太匆匆.借着酒劲写了一堆东西用铁民的电脑.但生于操练,又全没了...于是某个同志帮我写了个\"太久\n太久\"还大言不惭的说是应该留白.",[81,85,86],{},"忙是第一个原因.可这不是现在才来的理由.其实,就是想遁世.想沉浸在故事和角色里更多些...所以怕上来,不知该怎么面对你们.因为面对你们的时候,我是我.可有时候我不想是自己...",[81,88,89],{},"故事虽然悲壮,但最少雄浑真实,温暖得轰轰烈烈爱得死去活来!拥有即便短暂可毕竟算是拥有.",[81,91,92],{},"你们好吗?小狼的心情可有恢复?77,XY,猫,雨婷,水儿,燃燃,妖妖...当然还有鬼.你们不会不好,我信的.因为平淡也是很好.",[81,94,95],{},"我很好,但也怕这种好的逝去...我仿佛借着这部戏回到了大学时代.有什么比青春更好?",[81,97,98],{},"戏演了不少.真正让我爱的不多.\u003C士兵>\u003C民工>和现在的\u003C子弹>.因为她们有个共性,就是都让我动了心.或者说她们改变过或正在改变着我.",[81,100,101],{},"  在等化装,夜戏.江边打架.",[81,103,104],{},"身后的一个同志在补觉...我在用此人的电脑...隔壁和对面的房间有师妹们的笑,走廊上有哥们的喊叫\"走了!该你化妆了!...\"",[81,106,107],{},"又一个夜晚,又一段故事里的生活...",[81,109,110],{},"究竟是我在演绎别人?还是无数个角色演绎自己?",[81,112,113],{},"  走了,别让人等太久.",[81,115,116],{},"祝愿你们都好,如今夜...如我...",{"title":118,"searchDepth":119,"depth":119,"links":120},"",2,[],[6],"前晚喝大了,因为来了故人,导演系的一个才子.","md",{"date":125},"2007-04-24 19:35",true,"\u002Fblog\u002Fblog_4af9831b0100087z",{"title":76,"description":122},"blog_4af9831b0100087z","blog\u002Fblog_4af9831b0100087z",[],"HXljM_R3E9gflMreCE1HL7ZWbNAPiPo1xGuN97twlZw",[134,139],{"title":135,"path":136,"stem":137,"children":-1,"slug":138},"太久  太久......","\u002Fblog\u002Fblog_4af9831b0100086d","blog\u002Fblog_4af9831b0100086d","blog_4af9831b0100086d",{"title":140,"path":141,"stem":142,"children":-1,"slug":143},"爱上梦中人","\u002Fblog\u002Fblog_4af9831b0100088s","blog\u002Fblog_4af9831b0100088s","blog_4af9831b0100088s",1794473705967]
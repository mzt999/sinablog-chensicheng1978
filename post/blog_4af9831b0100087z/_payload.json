[{"data":1,"prerenderedAt":145},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":58,"blog-post-slug-blog_4af9831b0100087z":75,"surround-blog_4af9831b0100087z":134},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":54,"site_description":55,"stem":56,"__hash__":57},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo",20,"新浪博客内容备份","settings","hh8X7X6SFDoeJrxIJ4yisZXSc3HwHM1zk206jiQX2XU",{"latestBlog":59},[60,63,66,69,72],{"title":61,"slug":62},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":64,"slug":65},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":67,"slug":68},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":70,"slug":71},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":73,"slug":74},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":76,"title":77,"body":78,"categories":122,"description":123,"extension":124,"meta":125,"navigation":127,"path":128,"seo":129,"slug":130,"stem":131,"tags":132,"__hash__":133},"blog\u002Fblog\u002Fblog_4af9831b0100087z.md","无题",{"type":79,"value":80,"toc":118},"minimark",[81,85,88,91,94,97,100,103,106,109,112,115],[82,83,84],"p",{},"前晚喝大了,因为来了故人,导演系的一个才子.江边,微雨,醇酒,好鱼,朋友和美女...那个瞬间是完美的,但太匆匆.借着酒劲写了一堆东西用铁民的电脑.但生于操练,又全没了...于是某个同志帮我写了个\"太久\n太久\"还大言不惭的说是应该留白.",[82,86,87],{},"忙是第一个原因.可这不是现在才来的理由.其实,就是想遁世.想沉浸在故事和角色里更多些...所以怕上来,不知该怎么面对你们.因为面对你们的时候,我是我.可有时候我不想是自己...",[82,89,90],{},"故事虽然悲壮,但最少雄浑真实,温暖得轰轰烈烈爱得死去活来!拥有即便短暂可毕竟算是拥有.",[82,92,93],{},"你们好吗?小狼的心情可有恢复?77,XY,猫,雨婷,水儿,燃燃,妖妖...当然还有鬼.你们不会不好,我信的.因为平淡也是很好.",[82,95,96],{},"我很好,但也怕这种好的逝去...我仿佛借着这部戏回到了大学时代.有什么比青春更好?",[82,98,99],{},"戏演了不少.真正让我爱的不多.\u003C士兵>\u003C民工>和现在的\u003C子弹>.因为她们有个共性,就是都让我动了心.或者说她们改变过或正在改变着我.",[82,101,102],{},"  在等化装,夜戏.江边打架.",[82,104,105],{},"身后的一个同志在补觉...我在用此人的电脑...隔壁和对面的房间有师妹们的笑,走廊上有哥们的喊叫\"走了!该你化妆了!...\"",[82,107,108],{},"又一个夜晚,又一段故事里的生活...",[82,110,111],{},"究竟是我在演绎别人?还是无数个角色演绎自己?",[82,113,114],{},"  走了,别让人等太久.",[82,116,117],{},"祝愿你们都好,如今夜...如我...",{"title":119,"searchDepth":120,"depth":120,"links":121},"",2,[],[6],"前晚喝大了,因为来了故人,导演系的一个才子.","md",{"date":126},"2007-04-24 19:35",true,"\u002Fblog\u002Fblog_4af9831b0100087z",{"title":77,"description":123},"blog_4af9831b0100087z","blog\u002Fblog_4af9831b0100087z",[],"HXljM_R3E9gflMreCE1HL7ZWbNAPiPo1xGuN97twlZw",[135,140],{"title":136,"path":137,"stem":138,"children":-1,"slug":139},"太久  太久......","\u002Fblog\u002Fblog_4af9831b0100086d","blog\u002Fblog_4af9831b0100086d","blog_4af9831b0100086d",{"title":141,"path":142,"stem":143,"children":-1,"slug":144},"爱上梦中人","\u002Fblog\u002Fblog_4af9831b0100088s","blog\u002Fblog_4af9831b0100088s","blog_4af9831b0100088s",1794412501280]
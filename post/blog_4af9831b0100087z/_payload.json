[{"data":1,"prerenderedAt":160},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":73,"blog-post-slug-blog_4af9831b0100087z":90,"surround-blog_4af9831b0100087z":149},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":48,"navLinks":49,"perPage":16,"prevNextIsExcludeDate":69,"site_description":23,"site_name":70,"stem":71,"__hash__":72},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43,45],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{"href":46,"text":47},"https:\u002F\u002Fmzt999.github.io\u002Fportfolio-chensicheng1978","幕后作品集展示(2012-2026)",{},[50,55,59,63,67],{"path":51,"title":52,"target":53,"fa_class":54},"\u002F","博客首页","internal","fa-home",{"path":56,"title":57,"target":53,"fa_class":58},"\u002Fabout","关于","fa-user",{"path":60,"title":61,"target":53,"fa_class":62},"\u002Fpost","归档","fa-archive",{"path":64,"title":65,"target":53,"fa_class":66},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":68,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","LA_7Y82F2zjQ6-R2_tcWHl356krYL76uqQHBCIU8UZk",{"latestBlog":74},[75,78,81,84,87],{"title":76,"slug":77},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":79,"slug":80},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":82,"slug":83},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":85,"slug":86},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":88,"slug":89},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":91,"title":92,"body":93,"categories":137,"description":138,"extension":139,"meta":140,"navigation":142,"path":143,"seo":144,"slug":145,"stem":146,"tags":147,"__hash__":148},"blog\u002Fblog\u002Fblog_4af9831b0100087z.md","无题",{"type":94,"value":95,"toc":133},"minimark",[96,100,103,106,109,112,115,118,121,124,127,130],[97,98,99],"p",{},"前晚喝大了,因为来了故人,导演系的一个才子.江边,微雨,醇酒,好鱼,朋友和美女...那个瞬间是完美的,但太匆匆.借着酒劲写了一堆东西用铁民的电脑.但生于操练,又全没了...于是某个同志帮我写了个\"太久\n太久\"还大言不惭的说是应该留白.",[97,101,102],{},"忙是第一个原因.可这不是现在才来的理由.其实,就是想遁世.想沉浸在故事和角色里更多些...所以怕上来,不知该怎么面对你们.因为面对你们的时候,我是我.可有时候我不想是自己...",[97,104,105],{},"故事虽然悲壮,但最少雄浑真实,温暖得轰轰烈烈爱得死去活来!拥有即便短暂可毕竟算是拥有.",[97,107,108],{},"你们好吗?小狼的心情可有恢复?77,XY,猫,雨婷,水儿,燃燃,妖妖...当然还有鬼.你们不会不好,我信的.因为平淡也是很好.",[97,110,111],{},"我很好,但也怕这种好的逝去...我仿佛借着这部戏回到了大学时代.有什么比青春更好?",[97,113,114],{},"戏演了不少.真正让我爱的不多.\u003C士兵>\u003C民工>和现在的\u003C子弹>.因为她们有个共性,就是都让我动了心.或者说她们改变过或正在改变着我.",[97,116,117],{},"  在等化装,夜戏.江边打架.",[97,119,120],{},"身后的一个同志在补觉...我在用此人的电脑...隔壁和对面的房间有师妹们的笑,走廊上有哥们的喊叫\"走了!该你化妆了!...\"",[97,122,123],{},"又一个夜晚,又一段故事里的生活...",[97,125,126],{},"究竟是我在演绎别人?还是无数个角色演绎自己?",[97,128,129],{},"  走了,别让人等太久.",[97,131,132],{},"祝愿你们都好,如今夜...如我...",{"title":134,"searchDepth":135,"depth":135,"links":136},"",2,[],[6],"前晚喝大了,因为来了故人,导演系的一个才子.","md",{"date":141},"2007-04-24 19:35",true,"\u002Fblog\u002Fblog_4af9831b0100087z",{"title":92,"description":138},"blog_4af9831b0100087z","blog\u002Fblog_4af9831b0100087z",[],"HXljM_R3E9gflMreCE1HL7ZWbNAPiPo1xGuN97twlZw",[150,155],{"title":151,"path":152,"stem":153,"children":-1,"slug":154},"太久  太久......","\u002Fblog\u002Fblog_4af9831b0100086d","blog\u002Fblog_4af9831b0100086d","blog_4af9831b0100086d",{"title":156,"path":157,"stem":158,"children":-1,"slug":159},"爱上梦中人","\u002Fblog\u002Fblog_4af9831b0100088s","blog\u002Fblog_4af9831b0100088s","blog_4af9831b0100088s",1794760532559]
[{"data":1,"prerenderedAt":100},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b0100087z":31,"surround-blog_4af9831b0100087z":89},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",152,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":78,"description":33,"extension":79,"meta":80,"navigation":82,"path":83,"seo":84,"slug":85,"stem":86,"tags":87,"__hash__":88},"blog\u002Fblog\u002Fblog_4af9831b0100087z.md","无题",{"type":35,"value":36,"toc":74},"minimark",[37,41,44,47,50,53,56,59,62,65,68,71],[38,39,40],"p",{},"前晚喝大了,因为来了故人,导演系的一个才子.江边,微雨,醇酒,好鱼,朋友和美女...那个瞬间是完美的,但太匆匆.借着酒劲写了一堆东西用铁民的电脑.但生于操练,又全没了...于是某个同志帮我写了个\"太久\n太久\"还大言不惭的说是应该留白.",[38,42,43],{},"忙是第一个原因.可这不是现在才来的理由.其实,就是想遁世.想沉浸在故事和角色里更多些...所以怕上来,不知该怎么面对你们.因为面对你们的时候,我是我.可有时候我不想是自己...",[38,45,46],{},"故事虽然悲壮,但最少雄浑真实,温暖得轰轰烈烈爱得死去活来!拥有即便短暂可毕竟算是拥有.",[38,48,49],{},"你们好吗?小狼的心情可有恢复?77,XY,猫,雨婷,水儿,燃燃,妖妖...当然还有鬼.你们不会不好,我信的.因为平淡也是很好.",[38,51,52],{},"我很好,但也怕这种好的逝去...我仿佛借着这部戏回到了大学时代.有什么比青春更好?",[38,54,55],{},"戏演了不少.真正让我爱的不多.\u003C士兵>\u003C民工>和现在的\u003C子弹>.因为她们有个共性,就是都让我动了心.或者说她们改变过或正在改变着我.",[38,57,58],{},"  在等化装,夜戏.江边打架.",[38,60,61],{},"身后的一个同志在补觉...我在用此人的电脑...隔壁和对面的房间有师妹们的笑,走廊上有哥们的喊叫\"走了!该你化妆了!...\"",[38,63,64],{},"又一个夜晚,又一段故事里的生活...",[38,66,67],{},"究竟是我在演绎别人?还是无数个角色演绎自己?",[38,69,70],{},"  走了,别让人等太久.",[38,72,73],{},"祝愿你们都好,如今夜...如我...",{"title":75,"searchDepth":76,"depth":76,"links":77},"",2,[],[6],"md",{"date":81},"2007-04-24 19:35",true,"\u002Fblog\u002Fblog_4af9831b0100087z",{"title":33,"description":33},"blog_4af9831b0100087z","blog\u002Fblog_4af9831b0100087z",[],"O6cQAEPEKfoavjAWQ6mhMhDP-um5xmjVQhPL0wPvkZs",[90,95],{"title":91,"path":92,"stem":93,"children":-1,"slug":94},"太久  太久......","\u002Fblog\u002Fblog_4af9831b0100086d","blog\u002Fblog_4af9831b0100086d","blog_4af9831b0100086d",{"title":96,"path":97,"stem":98,"children":-1,"slug":99},"爱上梦中人","\u002Fblog\u002Fblog_4af9831b0100088s","blog\u002Fblog_4af9831b0100088s","blog_4af9831b0100088s",1793967846897]
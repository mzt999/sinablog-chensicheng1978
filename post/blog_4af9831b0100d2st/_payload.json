[{"data":1,"prerenderedAt":138},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b0100d2st":31,"surround-blog_4af9831b0100d2st":127},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",151,{"name":9,"len":10},"有图",34,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":110,"description":33,"extension":111,"meta":112,"navigation":114,"path":115,"seo":116,"slug":117,"stem":118,"tags":119,"__hash__":126},"blog\u002Fblog\u002Fblog_4af9831b0100d2st.md","我爱你   中国",{"type":35,"value":36,"toc":106},"minimark",[37,44,49,54,58,63,67,70,73,76,79,82,85,88,91,94,97,100,103],[38,39,40],"p",{},[41,42],"img",{"alt":33,"src":43},"\u002Fpic\u002F4af9831bt695f695bf16c.jpg",[38,45,46],{},[41,47],{"alt":33,"src":48},"\u002Fpic\u002F4af9831bt695f6895661a.jpg",[38,50,51],{},[41,52],{"alt":33,"src":53},"\u002Fpic\u002F4af9831bt695f682ea395.jpg",[38,55,56],{},[41,57],{"alt":33,"src":48},[38,59,60],{},[41,61],{"alt":33,"src":62},"\u002Fpic\u002F4af9831bt695f68f43b57.jpg",[38,64,65],{},[41,66],{"alt":33,"src":43},[38,68,69],{},"那天。",[38,71,72],{},"鸟巢。",[38,74,75],{},"龙的传人及其他……",[38,77,78],{},"  开始，硕大的屏幕上在播放着成龙大哥的艺术历程的VCR。我看到了他的一路走来，一路艰难和荣光交相辉映。感动的同时，更哽咽于他的坚持。坚持，这说来容易的两个字，在人生这条不归路上在我看来愈发的重要了……往往都在于那最后的一刻坚持，坚持……",[38,80,81],{},"中国，今生我们同为中国人……",[38,83,84],{},"这不是我们的选择，是宿命。对此，你是怎样的感觉？",[38,86,87],{},"  与我，百感交集后是莫大的庆幸。这个时代，风起云涌，这个中国，正面临前所未有的挑战与机遇……",[38,89,90],{},"  而此刻，我们就是中国。",[38,92,93],{},"  最新的“参考消息”刊登了一篇“中国青年一代，愤青的一代，民族的一代”看后让我感动，这个古老的名字让世界侧目太久，我们该为她证明，为她正名。",[38,95,96],{},"我们要为了这个我们共有的名字更加努力了，国强则民荣，这个道理谁都明白……",[38,98,99],{},"  让我们的心胸都再开阔一些吧。",[38,101,102],{},"5月13日，我会在法兰西追梦中国……",[38,104,105],{},"  中国，我爱你。因为，我们就是你。",{"title":107,"searchDepth":108,"depth":108,"links":109},"",2,[],[6,9],"md",{"date":113},"2009-05-08 12:15",true,"\u002Fblog\u002Fblog_4af9831b0100d2st",{"title":33,"description":33},"blog_4af9831b0100d2st","blog\u002Fblog_4af9831b0100d2st",[120,121,122,123,124,125],"鸟巢","成龙","演唱会","士兵突击","中国","杂谈","S-8Qdh8Opk1MkKNOucQItuKo9oLxYBbsBNb6KP-Yy3A",[128,133],{"title":129,"path":130,"stem":131,"children":-1,"slug":132},"梦","\u002Fblog\u002Fblog_4af9831b0100cva5","blog\u002Fblog_4af9831b0100cva5","blog_4af9831b0100cva5",{"title":134,"path":135,"stem":136,"children":-1,"slug":137},"临行","\u002Fblog\u002Fblog_4af9831b0100d6ps","blog\u002Fblog_4af9831b0100d6ps","blog_4af9831b0100d6ps",1793775558167]
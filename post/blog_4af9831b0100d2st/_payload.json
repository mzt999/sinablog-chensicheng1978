[{"data":1,"prerenderedAt":182},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":58,"blog-post-slug-blog_4af9831b0100d2st":75,"surround-blog_4af9831b0100d2st":171},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":54,"site_description":55,"stem":56,"__hash__":57},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo",20,"新浪博客内容备份","settings","hh8X7X6SFDoeJrxIJ4yisZXSc3HwHM1zk206jiQX2XU",{"latestBlog":59},[60,63,66,69,72],{"title":61,"slug":62},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":64,"slug":65},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":67,"slug":68},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":70,"slug":71},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":73,"slug":74},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":76,"title":77,"body":78,"categories":154,"description":119,"extension":155,"meta":156,"navigation":158,"path":159,"seo":160,"slug":161,"stem":162,"tags":163,"__hash__":170},"blog\u002Fblog\u002Fblog_4af9831b0100d2st.md","我爱你   中国",{"type":79,"value":80,"toc":150},"minimark",[81,88,93,98,102,107,111,114,117,120,123,126,129,132,135,138,141,144,147],[82,83,84],"p",{},[85,86],"img",{"alt":77,"src":87},"\u002Fpic\u002F4af9831bt695f695bf16c.jpg",[82,89,90],{},[85,91],{"alt":77,"src":92},"\u002Fpic\u002F4af9831bt695f6895661a.jpg",[82,94,95],{},[85,96],{"alt":77,"src":97},"\u002Fpic\u002F4af9831bt695f682ea395.jpg",[82,99,100],{},[85,101],{"alt":77,"src":92},[82,103,104],{},[85,105],{"alt":77,"src":106},"\u002Fpic\u002F4af9831bt695f68f43b57.jpg",[82,108,109],{},[85,110],{"alt":77,"src":87},[82,112,113],{},"那天。",[82,115,116],{},"鸟巢。",[82,118,119],{},"龙的传人及其他……",[82,121,122],{},"  开始，硕大的屏幕上在播放着成龙大哥的艺术历程的VCR。我看到了他的一路走来，一路艰难和荣光交相辉映。感动的同时，更哽咽于他的坚持。坚持，这说来容易的两个字，在人生这条不归路上在我看来愈发的重要了……往往都在于那最后的一刻坚持，坚持……",[82,124,125],{},"中国，今生我们同为中国人……",[82,127,128],{},"这不是我们的选择，是宿命。对此，你是怎样的感觉？",[82,130,131],{},"  与我，百感交集后是莫大的庆幸。这个时代，风起云涌，这个中国，正面临前所未有的挑战与机遇……",[82,133,134],{},"  而此刻，我们就是中国。",[82,136,137],{},"  最新的“参考消息”刊登了一篇“中国青年一代，愤青的一代，民族的一代”看后让我感动，这个古老的名字让世界侧目太久，我们该为她证明，为她正名。",[82,139,140],{},"我们要为了这个我们共有的名字更加努力了，国强则民荣，这个道理谁都明白……",[82,142,143],{},"  让我们的心胸都再开阔一些吧。",[82,145,146],{},"5月13日，我会在法兰西追梦中国……",[82,148,149],{},"  中国，我爱你。因为，我们就是你。",{"title":151,"searchDepth":152,"depth":152,"links":153},"",2,[],[6,9],"md",{"date":157},"2009-05-08 12:15",true,"\u002Fblog\u002Fblog_4af9831b0100d2st",{"title":77,"description":119},"blog_4af9831b0100d2st","blog\u002Fblog_4af9831b0100d2st",[164,165,166,167,168,169],"鸟巢","成龙","演唱会","士兵突击","中国","杂谈","_5ewDePcKn6mPvRjVQW9HD-9k9bgbxci1UAEcd80Qqk",[172,177],{"title":173,"path":174,"stem":175,"children":-1,"slug":176},"梦","\u002Fblog\u002Fblog_4af9831b0100cva5","blog\u002Fblog_4af9831b0100cva5","blog_4af9831b0100cva5",{"title":178,"path":179,"stem":180,"children":-1,"slug":181},"临行","\u002Fblog\u002Fblog_4af9831b0100d6ps","blog\u002Fblog_4af9831b0100d6ps","blog_4af9831b0100d6ps",1794412500555]
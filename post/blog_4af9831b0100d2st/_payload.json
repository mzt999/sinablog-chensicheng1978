":89,"body":90,"categories":166,"description":131,"extension":167,"meta":168,"navigation":170,"path":171,"seo":172,"slug":173,"stem":174,"tags":175,"__hash__":182},"blog\u002Fblog\u002Fblog_4af9831b0100d2st.md","我爱你   中国",{"type":91,"value":92,"toc":162},"minimark",[93,100,105,110,114,119,123,126,129,132,135,138,141,144,147,150,153,156,159],[94,95,96],"p",{},[97,98],"img",{"alt":89,"src":99},"\u002Fpic\u002F4af9831bt695f695bf16c.jpg",[94,101,102],{},[97,103],{"alt":89,"src":104},"\u002Fpic\u002F4af9831bt695f6895661a.jpg",[94,106,107],{},[97,108],{"alt":89,"src":109},"\u002Fpic\u002F4af9831bt695f682ea395.jpg",[94,111,112],{},[97,113],{"alt":89,"src":104},[94,115,116],{},[97,117],{"alt":89,"src":118},"\u002Fpic\u002F4af9831bt695f68f43b57.jpg",[94,120,121],{},[97,122],{"alt":89,"src":99},[94,124,125],{},"那天。",[94,127,128],{},"鸟巢。",[94,130,131],{},"龙的传人及其他……",[94,133,134],{},"  开始，硕大的屏幕上在播放着成龙大哥的艺术历程的VCR。我看到了他的一路走来，一路艰难和荣光交相辉映。感动的同时，更哽咽于他的坚持。坚持，这说来容易的两个字，在人生这条不归路上在我看来愈发的重要了……往往都在于那最后的一刻坚持，坚持……",[94,136,137],{},"中国，今生我们同为中国人……",[94,139,140],{},"这不是我们的选择，是宿命。对此，你是怎样的感觉？",[94,142,143],{},"  与我，百感交集后是莫大的庆幸。这个时代，风起云涌，这个中国，正面临前所未有的挑战与机遇……",[94,145,146],{},"  而此刻，我们就是中国。",[94,148,149],{},"  最新的“参考消息”刊登了一篇“中国青年一代，愤青的一代，民族的一代”看后让我感动，这个古老的名字让世界侧目太久，我们该为她证明，为她正名。",[94,151,152],{},"我们要为了这个我们共有的名字更加努力了，国强则民荣，这个道理谁都明白……",[94,154,155],{},"  让我们的心胸都再开阔一些吧。",[94,157,158],{},"5月13日，我会在法兰西追梦中国……",[94,160,161],{},"  中国，我爱你。因为，我们就是你。",{"title":163,"searchDepth":164,"depth":164,"links":165},"",2,[],[6,9],"md",{"date":169},"2009-05-08 12:15",true,"\u002Fblog\u002Fblog_4af9831b0100d2st",{"title":89,"description":131},"blog_4af9831b0100d2st","blog\u002Fblog_4af9831b0100d2st",[176,177,178,179,180,181],"鸟巢","成龙","演唱会","士兵突击","中国","杂谈","_5ewDePcKn6mPvRjVQW9HD-9k9bgbxci1UAEcd80Qqk",[184,189],{"title":185,"path":186,"stem":187,"children":-1,"slug":188},"梦","\u002Fblog\u002Fblog_4af9831b0100cva5","blog\u002Fblog_4af9831b0100cva5","blog_4af9831b0100cva5",{"title":190,"path":191,"stem":192,"children":-1,"slug":193},"临行","\u002Fblog\u002Fblog_4af9831b0100d6ps","blog\u002Fblog_4af9831b0100d6ps","blog_4af9831b0100d6ps",1794546769605]
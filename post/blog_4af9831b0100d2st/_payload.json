[{"data":1,"prerenderedAt":181},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":57,"blog-post-slug-blog_4af9831b0100d2st":74,"surround-blog_4af9831b0100d2st":170},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":16,"site_description":54,"stem":55,"__hash__":56},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo","新浪博客内容备份(粉丝自用)","settings","jPD1QWrYwbaIixg6lntppEYe-T3ZGd3EJZxFBkbKY9E",{"latestBlog":58},[59,62,65,68,71],{"title":60,"slug":61},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":63,"slug":64},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":66,"slug":67},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":69,"slug":70},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":72,"slug":73},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":75,"title":76,"body":77,"categories":153,"description":118,"extension":154,"meta":155,"navigation":157,"path":158,"seo":159,"slug":160,"stem":161,"tags":162,"__hash__":169},"blog\u002Fblog\u002Fblog_4af9831b0100d2st.md","我爱你   中国",{"type":78,"value":79,"toc":149},"minimark",[80,87,92,97,101,106,110,113,116,119,122,125,128,131,134,137,140,143,146],[81,82,83],"p",{},[84,85],"img",{"alt":76,"src":86},"\u002Fpic\u002F4af9831bt695f695bf16c.jpg",[81,88,89],{},[84,90],{"alt":76,"src":91},"\u002Fpic\u002F4af9831bt695f6895661a.jpg",[81,93,94],{},[84,95],{"alt":76,"src":96},"\u002Fpic\u002F4af9831bt695f682ea395.jpg",[81,98,99],{},[84,100],{"alt":76,"src":91},[81,102,103],{},[84,104],{"alt":76,"src":105},"\u002Fpic\u002F4af9831bt695f68f43b57.jpg",[81,107,108],{},[84,109],{"alt":76,"src":86},[81,111,112],{},"那天。",[81,114,115],{},"鸟巢。",[81,117,118],{},"龙的传人及其他……",[81,120,121],{},"  开始，硕大的屏幕上在播放着成龙大哥的艺术历程的VCR。我看到了他的一路走来，一路艰难和荣光交相辉映。感动的同时，更哽咽于他的坚持。坚持，这说来容易的两个字，在人生这条不归路上在我看来愈发的重要了……往往都在于那最后的一刻坚持，坚持……",[81,123,124],{},"中国，今生我们同为中国人……",[81,126,127],{},"这不是我们的选择，是宿命。对此，你是怎样的感觉？",[81,129,130],{},"  与我，百感交集后是莫大的庆幸。这个时代，风起云涌，这个中国，正面临前所未有的挑战与机遇……",[81,132,133],{},"  而此刻，我们就是中国。",[81,135,136],{},"  最新的“参考消息”刊登了一篇“中国青年一代，愤青的一代，民族的一代”看后让我感动，这个古老的名字让世界侧目太久，我们该为她证明，为她正名。",[81,138,139],{},"我们要为了这个我们共有的名字更加努力了，国强则民荣，这个道理谁都明白……",[81,141,142],{},"  让我们的心胸都再开阔一些吧。",[81,144,145],{},"5月13日，我会在法兰西追梦中国……",[81,147,148],{},"  中国，我爱你。因为，我们就是你。",{"title":150,"searchDepth":151,"depth":151,"links":152},"",2,[],[6,9],"md",{"date":156},"2009-05-08 12:15",true,"\u002Fblog\u002Fblog_4af9831b0100d2st",{"title":76,"description":118},"blog_4af9831b0100d2st","blog\u002Fblog_4af9831b0100d2st",[163,164,165,166,167,168],"鸟巢","成龙","演唱会","士兵突击","中国","杂谈","_5ewDePcKn6mPvRjVQW9HD-9k9bgbxci1UAEcd80Qqk",[171,176],{"title":172,"path":173,"stem":174,"children":-1,"slug":175},"梦","\u002Fblog\u002Fblog_4af9831b0100cva5","blog\u002Fblog_4af9831b0100cva5","blog_4af9831b0100cva5",{"title":177,"path":178,"stem":179,"children":-1,"slug":180},"临行","\u002Fblog\u002Fblog_4af9831b0100d6ps","blog\u002Fblog_4af9831b0100d6ps","blog_4af9831b0100d6ps",1794473705205]
[{"data":1,"prerenderedAt":141},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":17,"blog-post-slug-blog_4af9831b0100d2st":34,"surround-blog_4af9831b0100d2st":130},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"latestBlog":18},[19,22,25,28,31],{"title":20,"slug":21},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":23,"slug":24},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":26,"slug":27},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":29,"slug":30},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":32,"slug":33},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":35,"title":36,"body":37,"categories":113,"description":78,"extension":114,"meta":115,"navigation":117,"path":118,"seo":119,"slug":120,"stem":121,"tags":122,"__hash__":129},"blog\u002Fblog\u002Fblog_4af9831b0100d2st.md","我爱你   中国",{"type":38,"value":39,"toc":109},"minimark",[40,47,52,57,61,66,70,73,76,79,82,85,88,91,94,97,100,103,106],[41,42,43],"p",{},[44,45],"img",{"alt":36,"src":46},"\u002Fpic\u002F4af9831bt695f695bf16c.jpg",[41,48,49],{},[44,50],{"alt":36,"src":51},"\u002Fpic\u002F4af9831bt695f6895661a.jpg",[41,53,54],{},[44,55],{"alt":36,"src":56},"\u002Fpic\u002F4af9831bt695f682ea395.jpg",[41,58,59],{},[44,60],{"alt":36,"src":51},[41,62,63],{},[44,64],{"alt":36,"src":65},"\u002Fpic\u002F4af9831bt695f68f43b57.jpg",[41,67,68],{},[44,69],{"alt":36,"src":46},[41,71,72],{},"那天。",[41,74,75],{},"鸟巢。",[41,77,78],{},"龙的传人及其他……",[41,80,81],{},"  开始，硕大的屏幕上在播放着成龙大哥的艺术历程的VCR。我看到了他的一路走来，一路艰难和荣光交相辉映。感动的同时，更哽咽于他的坚持。坚持，这说来容易的两个字，在人生这条不归路上在我看来愈发的重要了……往往都在于那最后的一刻坚持，坚持……",[41,83,84],{},"中国，今生我们同为中国人……",[41,86,87],{},"这不是我们的选择，是宿命。对此，你是怎样的感觉？",[41,89,90],{},"  与我，百感交集后是莫大的庆幸。这个时代，风起云涌，这个中国，正面临前所未有的挑战与机遇……",[41,92,93],{},"  而此刻，我们就是中国。",[41,95,96],{},"  最新的“参考消息”刊登了一篇“中国青年一代，愤青的一代，民族的一代”看后让我感动，这个古老的名字让世界侧目太久，我们该为她证明，为她正名。",[41,98,99],{},"我们要为了这个我们共有的名字更加努力了，国强则民荣，这个道理谁都明白……",[41,101,102],{},"  让我们的心胸都再开阔一些吧。",[41,104,105],{},"5月13日，我会在法兰西追梦中国……",[41,107,108],{},"  中国，我爱你。因为，我们就是你。",{"title":110,"searchDepth":111,"depth":111,"links":112},"",2,[],[6,9],"md",{"date":116},"2009-05-08 12:15",true,"\u002Fblog\u002Fblog_4af9831b0100d2st",{"title":36,"description":78},"blog_4af9831b0100d2st","blog\u002Fblog_4af9831b0100d2st",[123,124,125,126,127,128],"鸟巢","成龙","演唱会","士兵突击","中国","杂谈","_5ewDePcKn6mPvRjVQW9HD-9k9bgbxci1UAEcd80Qqk",[131,136],{"title":132,"path":133,"stem":134,"children":-1,"slug":135},"梦","\u002Fblog\u002Fblog_4af9831b0100cva5","blog\u002Fblog_4af9831b0100cva5","blog_4af9831b0100cva5",{"title":137,"path":138,"stem":139,"children":-1,"slug":140},"临行","\u002Fblog\u002Fblog_4af9831b0100d6ps","blog\u002Fblog_4af9831b0100d6ps","blog_4af9831b0100d6ps",1794049413233]
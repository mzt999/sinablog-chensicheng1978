":89,"body":90,"categories":169,"description":96,"extension":170,"meta":171,"navigation":173,"path":174,"seo":175,"slug":176,"stem":177,"tags":178,"__hash__":180},"blog\u002Fblog\u002Fblog_4af9831b01007v66.md","2008 - 1 - 1 开始",{"type":91,"value":92,"toc":165},"minimark",[93,97,100,103,106,109,112,115,118,121,124,127,130,133,136,139,142,144,146,148,150,152,154,156,159,162],[94,95,96],"p",{},"2007成了过去,变为历史.2008真的来了,真的.",[94,98,99],{},"惶恐吗?",[94,101,102],{},"你?",[94,104,105],{},"又老了一岁?",[94,107,108],{},"离终点又近了一步?",[94,110,111],{},"怕吗?",[94,113,114],{},"我?",[94,116,117],{},"......",[94,119,120],{},"总不敢看自己写的东西,尽管写这些东西主要为了自己.总觉得那是种分裂,一个我审视另外一个,会反感会讥笑会不屑会自责...",[94,122,123],{},"乱七八糟这四个字是形容自己的最好词语.",[94,125,126],{},"分析了自己近30年,现在得出了唯一的结论:放弃!因为还是不明白!这人实在难懂!精神良莠不齐品质毁誉参半!",[94,128,129],{},"所幸,遇见了你们.懂得包容的人们.每次见到房间里满满的礼物,和留言版上的只字片语唯一的感受是感动.",[94,131,132],{},"那一刻,我纯净无比...",[94,134,135],{},"你们,已经是我的一部分...尽管\"习惯\"的毛病另人发指!但没办法,脸上是爱爱的护肤品,脖子上的CC的CSC,墙上挂着小茹的画和天涯的照片,衣柜里满载心静梦梦等等的围巾...上来就是老鬼老芝麻老猫老77弄的网站...温暖无处不在,让我逃无可逃.",[94,137,138],{},"2008,什么样子?不知道!但我会选择坚强!奋斗!不死!继续!死了!涅磐!",[94,140,141],{},"1月1日:开始!",[94,143,96],{},[94,145,99],{},[94,147,102],{},[94,149,105],{},[94,151,108],{},[94,153,111],{},[94,155,114],{},[94,157,158],{},"  ......",[94,160,161],{},"   别怕!",[94,163,164],{},"                      这世界,哪怕只有一个人爱我,就是我生存和战斗下去的理由...",{"title":166,"searchDepth":167,"depth":167,"links":168},"",2,[],[6],"md",{"date":172},"2008-01-01 17:02",true,"\u002Fblog\u002Fblog_4af9831b01007v66",{"title":89,"description":96},"blog_4af9831b01007v66","blog\u002Fblog_4af9831b01007v66",[179],"文化","go-twnkTEOq1YDUxXinV8aZcQqMTxMB0qr47hJqRons",[182,187],{"title":183,"path":184,"stem":185,"children":-1,"slug":186},"平安夜","\u002Fblog\u002Fblog_4af9831b01007sio","blog\u002Fblog_4af9831b01007sio","blog_4af9831b01007sio",{"title":188,"path":189,"stem":190,"children":-1,"slug":191},"我写给\"电视剧\"的文章","\u002Fblog\u002Fblog_4af9831b01007xpr","blog\u002Fblog_4af9831b01007xpr","blog_4af9831b01007xpr",1794546769888]
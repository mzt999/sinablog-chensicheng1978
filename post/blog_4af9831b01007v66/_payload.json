120,123,126,129,131,133,135,137,139,141,143,146,149],[81,82,83],"p",{},"2007成了过去,变为历史.2008真的来了,真的.",[81,85,86],{},"惶恐吗?",[81,88,89],{},"你?",[81,91,92],{},"又老了一岁?",[81,94,95],{},"离终点又近了一步?",[81,97,98],{},"怕吗?",[81,100,101],{},"我?",[81,103,104],{},"......",[81,106,107],{},"总不敢看自己写的东西,尽管写这些东西主要为了自己.总觉得那是种分裂,一个我审视另外一个,会反感会讥笑会不屑会自责...",[81,109,110],{},"乱七八糟这四个字是形容自己的最好词语.",[81,112,113],{},"分析了自己近30年,现在得出了唯一的结论:放弃!因为还是不明白!这人实在难懂!精神良莠不齐品质毁誉参半!",[81,115,116],{},"所幸,遇见了你们.懂得包容的人们.每次见到房间里满满的礼物,和留言版上的只字片语唯一的感受是感动.",[81,118,119],{},"那一刻,我纯净无比...",[81,121,122],{},"你们,已经是我的一部分...尽管\"习惯\"的毛病另人发指!但没办法,脸上是爱爱的护肤品,脖子上的CC的CSC,墙上挂着小茹的画和天涯的照片,衣柜里满载心静梦梦等等的围巾...上来就是老鬼老芝麻老猫老77弄的网站...温暖无处不在,让我逃无可逃.",[81,124,125],{},"2008,什么样子?不知道!但我会选择坚强!奋斗!不死!继续!死了!涅磐!",[81,127,128],{},"1月1日:开始!",[81,130,83],{},[81,132,86],{},[81,134,89],{},[81,136,92],{},[81,138,95],{},[81,140,98],{},[81,142,101],{},[81,144,145],{},"  ......",[81,147,148],{},"   别怕!",[81,150,151],{},"                      这世界,哪怕只有一个人爱我,就是我生存和战斗下去的理由...",{"title":153,"searchDepth":154,"depth":154,"links":155},"",2,[],[6],"md",{"date":159},"2008-01-01 17:02",true,"\u002Fblog\u002Fblog_4af9831b01007v66",{"title":76,"description":83},"blog_4af9831b01007v66","blog\u002Fblog_4af9831b01007v66",[166],"文化","go-twnkTEOq1YDUxXinV8aZcQqMTxMB0qr47hJqRons",[169,174],{"title":170,"path":171,"stem":172,"children":-1,"slug":173},"平安夜","\u002Fblog\u002Fblog_4af9831b01007sio","blog\u002Fblog_4af9831b01007sio","blog_4af9831b01007sio",{"title":175,"path":176,"stem":177,"children":-1,"slug":178},"我写给\"电视剧\"的文章","\u002Fblog\u002Fblog_4af9831b01007xpr","blog\u002Fblog_4af9831b01007xpr","blog_4af9831b01007xpr",1794473705469]
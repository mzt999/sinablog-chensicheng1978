[{"data":1,"prerenderedAt":126},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":58,"blog-post-slug-blog_4af9831b010006pp":75,"surround-blog_4af9831b010006pp":115},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":54,"site_description":55,"stem":56,"__hash__":57},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo",20,"新浪博客内容备份","settings","hh8X7X6SFDoeJrxIJ4yisZXSc3HwHM1zk206jiQX2XU",{"latestBlog":59},[60,63,66,69,72],{"title":61,"slug":62},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":64,"slug":65},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":67,"slug":68},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":70,"slug":71},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":73,"slug":74},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":76,"title":77,"body":78,"categories":104,"description":84,"extension":105,"meta":106,"navigation":108,"path":109,"seo":110,"slug":111,"stem":112,"tags":113,"__hash__":114},"blog\u002Fblog\u002Fblog_4af9831b010006pp.md","七 上八下的新年致辞",{"type":79,"value":80,"toc":100},"minimark",[81,85,88,91,94,97],[82,83,84],"p",{},"哈哈!!!!!看着时间提示都爽!!!2007了 终于!!",[82,86,87],{},"刚从同学家回来 还是觉得亲切 曾经的同学们 以前喜欢的就更喜欢\n以前讨厌的现在看着也可爱起来了 我们都无法回避一个事实\n就像经过卫生检疫的猪身上的蓝章一样醒目的事实\n那就是我们都拥有过那样的一个集体 那样的一段岁月\n那样的一段共同的回忆 青春 经历 我们都有过一个共同的名字 ---\n中央戏剧学院表演系九九本科班 这个名字只能属于我们十六个人 十男六女\n多谁也不行 少谁也没戏!",[82,89,90],{},"可能是喝了点酒?反正有点酒壮怂人胆 此刻只想喊\n表九九万岁!!!!表九九牛逼!!!!也许现在你没觉得怎么着 可是你看吧\n表九九不会比80 85 87 90 96 等等差的\n我们会有我们的辉煌!一定!!!!!",[82,92,93],{},"2007 我就在你的身上了?怎么着?来吧?????我想\n偶放阙词还是可以生津止渴的 那么陈思成就说: 2007\n让暴风雨来的更猛烈些吧!!!!",[82,95,96],{},"洗洗睡了 还是希望你们都好 最少 每个看过这东西的人都好\n还有新年给我的几个偶像也问好:恰巧前些时候接连看了他们各自出的几本书\n百度李彦宏 阿里巴巴马云 万科王石 祝你们也好!",[82,98,99],{},"2007 希望不止邦德 我们都会和幸运联姻",{"title":101,"searchDepth":102,"depth":102,"links":103},"",2,[],[6],"md",{"date":107},"2007-01-01 03:27",true,"\u002Fblog\u002Fblog_4af9831b010006pp",{"title":77,"description":84},"blog_4af9831b010006pp","blog\u002Fblog_4af9831b010006pp",[],"w3y4LCSKKqsKCjFy-X1E2NjPvLDGzRFU1D8ls41N3Sw",[116,121],{"title":117,"path":118,"stem":119,"children":-1,"slug":120},"在 200六 的最后一天","\u002Fblog\u002Fblog_4af9831b010006p2","blog\u002Fblog_4af9831b010006p2","blog_4af9831b010006p2",{"title":122,"path":123,"stem":124,"children":-1,"slug":125},"等等我就来","\u002Fblog\u002Fblog_4af9831b010006zw","blog\u002Fblog_4af9831b010006zw","blog_4af9831b010006zw",1794412501516]
[{"data":1,"prerenderedAt":85},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":17,"blog-post-slug-blog_4af9831b010006pp":34,"surround-blog_4af9831b010006pp":74},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"latestBlog":18},[19,22,25,28,31],{"title":20,"slug":21},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":23,"slug":24},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":26,"slug":27},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":29,"slug":30},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":32,"slug":33},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":35,"title":36,"body":37,"categories":63,"description":43,"extension":64,"meta":65,"navigation":67,"path":68,"seo":69,"slug":70,"stem":71,"tags":72,"__hash__":73},"blog\u002Fblog\u002Fblog_4af9831b010006pp.md","七 上八下的新年致辞",{"type":38,"value":39,"toc":59},"minimark",[40,44,47,50,53,56],[41,42,43],"p",{},"哈哈!!!!!看着时间提示都爽!!!2007了 终于!!",[41,45,46],{},"刚从同学家回来 还是觉得亲切 曾经的同学们 以前喜欢的就更喜欢\n以前讨厌的现在看着也可爱起来了 我们都无法回避一个事实\n就像经过卫生检疫的猪身上的蓝章一样醒目的事实\n那就是我们都拥有过那样的一个集体 那样的一段岁月\n那样的一段共同的回忆 青春 经历 我们都有过一个共同的名字 ---\n中央戏剧学院表演系九九本科班 这个名字只能属于我们十六个人 十男六女\n多谁也不行 少谁也没戏!",[41,48,49],{},"可能是喝了点酒?反正有点酒壮怂人胆 此刻只想喊\n表九九万岁!!!!表九九牛逼!!!!也许现在你没觉得怎么着 可是你看吧\n表九九不会比80 85 87 90 96 等等差的\n我们会有我们的辉煌!一定!!!!!",[41,51,52],{},"2007 我就在你的身上了?怎么着?来吧?????我想\n偶放阙词还是可以生津止渴的 那么陈思成就说: 2007\n让暴风雨来的更猛烈些吧!!!!",[41,54,55],{},"洗洗睡了 还是希望你们都好 最少 每个看过这东西的人都好\n还有新年给我的几个偶像也问好:恰巧前些时候接连看了他们各自出的几本书\n百度李彦宏 阿里巴巴马云 万科王石 祝你们也好!",[41,57,58],{},"2007 希望不止邦德 我们都会和幸运联姻",{"title":60,"searchDepth":61,"depth":61,"links":62},"",2,[],[6],"md",{"date":66},"2007-01-01 03:27",true,"\u002Fblog\u002Fblog_4af9831b010006pp",{"title":36,"description":43},"blog_4af9831b010006pp","blog\u002Fblog_4af9831b010006pp",[],"w3y4LCSKKqsKCjFy-X1E2NjPvLDGzRFU1D8ls41N3Sw",[75,80],{"title":76,"path":77,"stem":78,"children":-1,"slug":79},"在 200六 的最后一天","\u002Fblog\u002Fblog_4af9831b010006p2","blog\u002Fblog_4af983
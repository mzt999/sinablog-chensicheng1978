[{"data":1,"prerenderedAt":82},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b010006pp":31,"surround-blog_4af9831b010006pp":71},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",152,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":60,"description":33,"extension":61,"meta":62,"navigation":64,"path":65,"seo":66,"slug":67,"stem":68,"tags":69,"__hash__":70},"blog\u002Fblog\u002Fblog_4af9831b010006pp.md","七 上八下的新年致辞",{"type":35,"value":36,"toc":56},"minimark",[37,41,44,47,50,53],[38,39,40],"p",{},"哈哈!!!!!看着时间提示都爽!!!2007了 终于!!",[38,42,43],{},"刚从同学家回来 还是觉得亲切 曾经的同学们 以前喜欢的就更喜欢\n以前讨厌的现在看着也可爱起来了 我们都无法回避一个事实\n就像经过卫生检疫的猪身上的蓝章一样醒目的事实\n那就是我们都拥有过那样的一个集体 那样的一段岁月\n那样的一段共同的回忆 青春 经历 我们都有过一个共同的名字 ---\n中央戏剧学院表演系九九本科班 这个名字只能属于我们十六个人 十男六女\n多谁也不行 少谁也没戏!",[38,45,46],{},"可能是喝了点酒?反正有点酒壮怂人胆 此刻只想喊\n表九九万岁!!!!表九九牛逼!!!!也许现在你没觉得怎么着 可是你看吧\n表九九不会比80 85 87 90 96 等等差的\n我们会有我们的辉煌!一定!!!!!",[38,48,49],{},"2007 我就在你的身上了?怎么着?来吧?????我想\n偶放阙词还是可以生津止渴的 那么陈思成就说: 2007\n让暴风雨来的更猛烈些吧!!!!",[38,51,52],{},"洗洗睡了 还是希望你们都好 最少 每个看过这东西的人都好\n还有新年给我的几个偶像也问好:恰巧前些时候接连看了他们各自出的几本书\n百度李彦宏 阿里巴巴马云 万科王石 祝你们也好!",[38,54,55],{},"2007 希望不止邦德 我们都会和幸运联姻",{"title":57,"searchDepth":58,"depth":58,"links":59},"",2,[],[6],"md",{"date":63},"2007-01-01 03:27",true,"\u002Fblog\u002Fblog_4af9831b010006pp",{"title":33,"description":33},"blog_4af9831b010006pp","blog\u002Fblog_4af9831b010006pp",[],"BpKHSNiiBTXRt2OBPud90t1VLVv1dlcauC0ZM3XelLs",[72,77],{"title":73,"path":74,"stem":75,"children":-1,"slug":76},"在 200六 的最后一天","\u002Fblog\u002Fblog_4af9831b010006p2","blog\u002Fblog_4af9831b010006p2","blog_4af9831b010006p2
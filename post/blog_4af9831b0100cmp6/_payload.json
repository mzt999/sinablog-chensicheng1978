[{"data":1,"prerenderedAt":152},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":58,"blog-post-slug-blog_4af9831b0100cmp6":75,"surround-blog_4af9831b0100cmp6":141},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":54,"site_description":55,"stem":56,"__hash__":57},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo",20,"新浪博客内容备份","settings","hh8X7X6SFDoeJrxIJ4yisZXSc3HwHM1zk206jiQX2XU",{"latestBlog":59},[60,63,66,69,72],{"title":61,"slug":62},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":64,"slug":65},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":67,"slug":68},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":70,"slug":71},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":73,"slug":74},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":76,"title":77,"body":78,"categories":125,"description":126,"extension":127,"meta":128,"navigation":130,"path":131,"seo":132,"slug":133,"stem":134,"tags":135,"__hash__":140},"blog\u002Fblog\u002Fblog_4af9831b0100cmp6.md","好的？坏的?",{"type":79,"value":80,"toc":121},"minimark",[81,85,88,91,94,97,100,103,106,109,112,115,118],[82,83,84],"p",{},"物竟天择……",[82,86,87],{},"知道我要去拍个戏，好多人问，演的是那个好的还是坏的？遭此问题，总是哽咽，总是无言…………",[82,89,90],{},"明天出发，好的？坏的？不知道。谁又知道呢？",[82,92,93],{},"  好的，不尽然好。坏的，藏着好的玄机。所以，在短短的我们生命的旅程，何谓好又何谓坏呢？",[82,95,96],{},"今天见到翼龙姐等人，其实是心怀感动的……但我会表现的若无其事，因为？因为，我伪坚强啊……",[82,98,99],{},"好的？坏的？对的？错的？……其实本没有答案，我们在不停追问，其实早被这个过程给裹挟了 。",[82,101,102],{},"没有强者，面对生命自身无法替代的脆弱谁敢说自己是不可战胜的呢？",[82,104,105],{},"  导口中那个伟大的母亲去了，逝者如斯……我们又能怎样言说？电话那头他的语调依旧沉稳，但千丝万缕的脆弱早把他的无奈与痛楚出卖了……哭吧。我们终将面临这样的别离，不是吗？从此后，他更是个孩子了……但。心中有爱的人，会穿越你知道的那些，在远比这个世界之外的美好相见的……",[82,107,108],{},"其实，本没有好的坏的，只有你认为的。值得或不值得的………………………………",[82,110,111],{},"明天，相见在下一个未知的十字路口……",[82,113,114],{},"我就站在那中央，选择着，徘徊着，停留着……",[82,116,117],{},"  因为我明白。",[82,119,120],{},"除了这样，是不可能永久的……………………………………………………………………………………",{"title":122,"searchDepth":123,"depth":123,"links":124},"",2,[],[6],"拍个戏，好多人问，演的是那个好的还是坏的？遭此问题，总是哽咽，总是无言…………","md",{"date":129},"2009-04-07 01:27",true,"\u002Fblog\u002Fblog_4af9831b0100cmp6",{"title":77,"description":126},"blog_4af9831b0100cmp6","blog\u002Fblog_4af9831b0100cmp6",[136,137,138,139],"情感","天择","语调","十字路口","qMJwODzkz02AkY0pta48r9Z5lyvoHaPUGoA35tMh5DU",[142,147],{"title":143,"path":144,"stem":145,"children":-1,"slug":146},"失眠……","\u002Fblog\u002Fblog_4af9831b0100cdig","blog\u002Fblog_4af9831b0100cdig","blog_4af9831b0100cdig",{"title":148,"path":149,"stem":150,"children":-1,"slug":151},"一剪梅","\u002Fblog\u002Fblog_4af9831b0100coqo","blog\u002Fblog_4af9831b0100coqo","blog_4af9831b0100coqo",1794412500567]
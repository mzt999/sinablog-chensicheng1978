[{"data":1,"prerenderedAt":164},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":70,"blog-post-slug-blog_4af9831b0100cmp6":87,"surround-blog_4af9831b0100cmp6":153},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":45,"navLinks":46,"perPage":16,"prevNextIsExcludeDate":66,"site_description":23,"site_name":67,"stem":68,"__hash__":69},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{},[47,52,56,60,64],{"path":48,"title":49,"target":50,"fa_class":51},"\u002F","博客首页","internal","fa-home",{"path":53,"title":54,"target":50,"fa_class":55},"\u002Fabout","关于","fa-user",{"path":57,"title":58,"target":50,"fa_class":59},"\u002Fpost","归档","fa-archive",{"path":61,"title":62,"target":50,"fa_class":63},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":65,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","jvZHccz2rT-wjVS5GCPgWyhl8WnBIvECPkE5KpKFKCU",{"latestBlog":71},[72,75,78,81,84],{"title":73,"slug":74},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":76,"slug":77},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":79,"slug":80},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":82,"slug":83},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":85,"slug":86},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":88,"title":89,"body":90,"categories":137,"description":138,"extension":139,"meta":140,"navigation":142,"path":143,"seo":144,"slug":145,"stem":146,"tags":147,"__hash__":152},"blog\u002Fblog\u002Fblog_4af9831b0100cmp6.md","好的？坏的?",{"type":91,"value":92,"toc":133},"minimark",[93,97,100,103,106,109,112,115,118,121,124,127,130],[94,95,96],"p",{},"物竟天择……",[94,98,99],{},"知道我要去拍个戏，好多人问，演的是那个好的还是坏的？遭此问题，总是哽咽，总是无言…………",[94,101,102],{},"明天出发，好的？坏的？不知道。谁又知道呢？",[94,104,105],{},"  好的，不尽然好。坏的，藏着好的玄机。所以，在短短的我们生命的旅程，何谓好又何谓坏呢？",[94,107,108],{},"今天见到翼龙姐等人，其实是心怀感动的……但我会表现的若无其事，因为？因为，我伪坚强啊……",[94,110,111],{},"好的？坏的？对的？错的？……其实本没有答案，我们在不停追问，其实早被这个过程给裹挟了 。",[94,113,114],{},"没有强者，面对生命自身无法替代的脆弱谁敢说自己是不可战胜的呢？",[94,116,117],{},"  导口中那个伟大的母亲去了，逝者如斯……我们又能怎样言说？电话那头他的语调依旧沉稳，但千丝万缕的脆弱早把他的无奈与痛楚出卖了……哭吧。我们终将面临这样的别离，不是吗？从此后，他更是个孩子了……但。心中有爱的人，会穿越你知道的那些，在远比这个世界之外的美好相见的……",[94,119,120],{},"其实，本没有好的坏的，只有你认为的。值得或不值得的………………………………",[94,122,123],{},"明天，相见在下一个未知的十字路口……",[94,125,126],{},"我就站在那中央，选择着，徘徊着，停留着……",[94,128,129],{},"  因为我明白。",[94,131,132],{},"除了这样，是不可能永久的……………………………………………………………………………………",{"title":134,"searchDepth":135,"depth":135,"links":136},"",2,[],[6],"拍个戏，好多人问，演的是那个好的还是坏的？遭此问题，总是哽咽，总是无言…………","md",{"date":141},"2009-04-07 01:27",true,"\u002Fblog\u002Fblog_4af9831b0100cmp6",{"title":89,"description":138},"blog_4af9831b0100cmp6","blog\u002Fblog_4af9831b0100cmp6",[148,149,150,151],"情感","天择","语调","十字路口","qMJwODzkz02AkY0pta48r9Z5lyvoHaPUGoA35tMh5DU",[154,159],{"title":155,"path":156,"stem":157,"children":-1,"slug":158},"失眠……","\u002Fblog\u002Fblog_4af9831b0100cdig","blog\u002Fblog_4af9831b0100cdig","blog_4af9831b0100cdig",{"title":160,"path":161,"stem":162,"children":-1,"slug":163},"一剪梅","\u002Fblog\u002Fblog_4af9831b0100coqo","blog\u002Fblog_4af9831b0100coqo","blog_4af9831b0100coqo",1794544667593]
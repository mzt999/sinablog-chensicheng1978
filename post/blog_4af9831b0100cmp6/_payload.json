[{"data":1,"prerenderedAt":107},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b0100cmp6":31,"surround-blog_4af9831b0100cmp6":96},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",152,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":81,"description":33,"extension":82,"meta":83,"navigation":85,"path":86,"seo":87,"slug":88,"stem":89,"tags":90,"__hash__":95},"blog\u002Fblog\u002Fblog_4af9831b0100cmp6.md","好的？坏的?",{"type":35,"value":36,"toc":77},"minimark",[37,41,44,47,50,53,56,59,62,65,68,71,74],[38,39,40],"p",{},"物竟天择……",[38,42,43],{},"知道我要去拍个戏，好多人问，演的是那个好的还是坏的？遭此问题，总是哽咽，总是无言…………",[38,45,46],{},"明天出发，好的？坏的？不知道。谁又知道呢？",[38,48,49],{},"  好的，不尽然好。坏的，藏着好的玄机。所以，在短短的我们生命的旅程，何谓好又何谓坏呢？",[38,51,52],{},"今天见到翼龙姐等人，其实是心怀感动的……但我会表现的若无其事，因为？因为，我伪坚强啊……",[38,54,55],{},"好的？坏的？对的？错的？……其实本没有答案，我们在不停追问，其实早被这个过程给裹挟了 。",[38,57,58],{},"没有强者，面对生命自身无法替代的脆弱谁敢说自己是不可战胜的呢？",[38,60,61],{},"  导口中那个伟大的母亲去了，逝者如斯……我们又能怎样言说？电话那头他的语调依旧沉稳，但千丝万缕的脆弱早把他的无奈与痛楚出卖了……哭吧。我们终将面临这样的别离，不是吗？从此后，他更是个孩子了……但。心中有爱的人，会穿越你知道的那些，在远比这个世界之外的美好相见的……",[38,63,64],{},"其实，本没有好的坏的，只有你认为的。值得或不值得的………………………………",[38,66,67],{},"明天，相见在下一个未知的十字路口……",[38,69,70],{},"我就站在那中央，选择着，徘徊着，停留着……",[38,72,73],{},"  因为我明白。",[38,75,76],{},"除了这样，是不可能永久的……………………………………………………………………………………",{"title":78,"searchDepth":79,"depth":79,"links":80},"",2,[],[6],"md",{"date":84},"2009-04-07 01:27",true,"\u002Fblog\u002Fblog_4af9831b0100cmp6",{"title":33,"description":33},"blog_4af9831b0100cmp6","blog\u002Fblog_4af9831b0100cmp6",[91,92,93,94],"情感","天择","语调","十字路口","1qoGHrE2WIUBMbdv3SLyM-CwwMkIj24kBeMXjZ6cfqE",[97,102],{"title":98,"pa
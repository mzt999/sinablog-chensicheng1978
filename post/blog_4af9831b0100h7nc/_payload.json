":89,"body":90,"categories":137,"description":96,"extension":138,"meta":139,"navigation":141,"path":142,"seo":143,"slug":144,"stem":145,"tags":146,"__hash__":148},"blog\u002Fblog\u002Fblog_4af9831b0100h7nc.md","飞行",{"type":91,"value":92,"toc":133},"minimark",[93,97,100,103,106,109,112,115,118,121,124,127,130],[94,95,96],"p",{},"完成了第一天的拍摄。",[94,98,99],{},"很好。",[94,101,102],{},"所有都很好。",[94,104,105],{},"遇到了一个人，于我有很多的接近，同样的一个“老男孩”同样的一个梦想家……",[94,107,108],{},"人和人是微妙的，无论男人和女人或男人和男人。",[94,110,111],{},"道不同不相与谋，会有你的同志在路上和你并肩走！",[94,113,114],{},"如同云南的阳光和风，此刻我的心情无比舒畅，便记录下此刻的感受，待到若干年后再独自回味……",[94,116,117],{},"能遇到知音是此生幸事！",[94,119,120],{},"丽江，我的福地。两次行程两种圆满……",[94,122,123],{},"我想飞！",[94,125,126],{},"飞行！",[94,128,129],{},"飞行于守望！",[94,131,132],{},"守望于飞行！",{"title":134,"searchDepth":135,"depth":135,"links":136},"",2,[],[6],"md",{"date":140},"2010-03-03 19:12",true,"\u002Fblog\u002Fblog_4af9831b0100h7nc",{"title":89,"description":96},"blog_4af9831b0100h7nc","blog\u002Fblog_4af9831b0100h7nc",[147],"杂谈","ZuY5-PMmJQbYIp9irLLBFuRXm4mVyfEYv-8-LNZWQVA",[150,155],{"title":151,"path":152,"stem":153,"children":-1,"slug":154},"守望","\u002Fblog\u002Fblog_4af9831b0100h6ee","blog\u002Fblog_4af9831b0100h6ee","blog_4af9831b0100h6ee",{"title":156,"path":157,"stem":158,"children":-1,"slug":159},"天边外 祭奠","\u002Fblog\u002Fblog_4af9831b0100hnjh","blog\u002Fblog_4af9831b0100hnjh","blog_4af9831b0100hnjh",1794546768855]
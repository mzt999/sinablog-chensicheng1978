[{"data":1,"prerenderedAt":134},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":58,"blog-post-slug-blog_4af9831b0100bx8c":75,"surround-blog_4af9831b0100bx8c":123},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":54,"site_description":55,"stem":56,"__hash__":57},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo",20,"新浪博客内容备份","settings","hh8X7X6SFDoeJrxIJ4yisZXSc3HwHM1zk206jiQX2XU",{"latestBlog":59},[60,63,66,69,72],{"title":61,"slug":62},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":64,"slug":65},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":67,"slug":68},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":70,"slug":71},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":73,"slug":74},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":76,"title":77,"body":78,"categories":110,"description":111,"extension":112,"meta":113,"navigation":115,"path":116,"seo":117,"slug":118,"stem":119,"tags":120,"__hash__":122},"blog\u002Fblog\u002Fblog_4af9831b0100bx8c.md","“予文”——新春寄语",{"type":79,"value":80,"toc":106},"minimark",[81,85,88,91,94,97,100,103],[82,83,84],"p",{},"话说08年底的某天，在某人的怂恿下一起去拜会了个精通“周易”的某人。某人对我生辰八字等掐指一算，口中道出的我和正襟危坐于某人对面的我倒确实十分相近……优点缺点脾气秉性都八九不离十……听得我出了一身汗。还好，某人说我的命不错，很不错。但还可以更好，就帮我取个几个名字，让我挑选。说这样才是真的好……",[82,86,87],{},"几个名字都很琼瑶或港剧，只有“予文”二字让我眼前一亮！所以从此以后本人便是姓陈名思成字予文了。今天公布此事，是希望大伙有事没事多念叨念叨这个“予文”……总是有利无害的事……",[82,89,90],{},"予文………………好名字……………………",[82,92,93],{},"08年真的过去了，无论西算中算，都过去了。此刻，我独坐在电脑桌前，反复听着“北京北京”，安静……刚刚的喧嚣已经过去，仿佛从没发生。其实没错，生活便是如此。一切浮华终究泡影，最后都会化做平淡静谧。",[82,95,96],{},"我想说什么？想说，08年又长大了一岁。我说长大而没用苍老，聪明如你定会明白我骨子里还是孩子的。08年于中国于世界都是多事之秋，但她过去了，也如同没来过。有何收获或失去？其实……我想说收获未必是你渴望，失去也未必会不复得……",[82,98,99],{},"09年，猝然而至。尽管不信我的祝愿有多大用处，还是把最好的祝福送给所有看过这篇博文的人……09年，中国人的牛年，都牛一点！都开心多一点吧！",[82,101,102],{},"我会继续努力，继续走自己的路，生命不息，战斗不止！",[82,104,105],{},"  公元2009年，我来了！",{"title":107,"searchDepth":108,"depth":108,"links":109},"",2,[],[6],"从此以后本人便是姓陈名思成字予文了。","md",{"date":114},"2009-01-26 00:26",true,"\u002Fblog\u002Fblog_4af9831b0100bx8c",{"title":77,"description":111},"blog_4af9831b0100bx8c","blog\u002Fblog_4af9831b0100bx8c",[121],"杂谈","OQx0bhkemnQBtMb3TuDOcUsUpW9bzUfliCKLHnbciS8",[124,129],{"title":125,"path":126,"stem":127,"children":-1,"slug":128},"海","\u002Fblog\u002Fblog_4af9831b0100bt89","blog\u002Fblog_4af9831b0100bt89","blog_4af9831b0100bt89",{"title":130,"path":131,"stem":132,"children":-1,"slug":133},"失眠……","\u002Fblog\u002Fblog_4af9831b0100cdig","blog\u002Fblog_4af9831b0100cdig","blog_4af9831b0100cdig",1794412500591]
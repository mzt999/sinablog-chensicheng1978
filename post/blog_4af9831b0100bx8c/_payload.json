[{"data":1,"prerenderedAt":146},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":70,"blog-post-slug-blog_4af9831b0100bx8c":87,"surround-blog_4af9831b0100bx8c":135},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":45,"navLinks":46,"perPage":16,"prevNextIsExcludeDate":66,"site_description":23,"site_name":67,"stem":68,"__hash__":69},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{},[47,52,56,60,64],{"path":48,"title":49,"target":50,"fa_class":51},"\u002F","博客首页","internal","fa-home",{"path":53,"title":54,"target":50,"fa_class":55},"\u002Fabout","关于","fa-user",{"path":57,"title":58,"target":50,"fa_class":59},"\u002Fpost","归档","fa-archive",{"path":61,"title":62,"target":50,"fa_class":63},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":65,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","jvZHccz2rT-wjVS5GCPgWyhl8WnBIvECPkE5KpKFKCU",{"latestBlog":71},[72,75,78,81,84],{"title":73,"slug":74},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":76,"slug":77},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":79,"slug":80},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":82,"slug":83},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":85,"slug":86},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":88,"title":89,"body":90,"categories":122,"description":123,"extension":124,"meta":125,"navigation":127,"path":128,"seo":129,"slug":130,"stem":131,"tags":132,"__hash__":134},"blog\u002Fblog\u002Fblog_4af9831b0100bx8c.md","“予文”——新春寄语",{"type":91,"value":92,"toc":118},"minimark",[93,97,100,103,106,109,112,115],[94,95,96],"p",{},"话说08年底的某天，在某人的怂恿下一起去拜会了个精通“周易”的某人。某人对我生辰八字等掐指一算，口中道出的我和正襟危坐于某人对面的我倒确实十分相近……优点缺点脾气秉性都八九不离十……听得我出了一身汗。还好，某人说我的命不错，很不错。但还可以更好，就帮我取个几个名字，让我挑选。说这样才是真的好……",[94,98,99],{},"几个名字都很琼瑶或港剧，只有“予文”二字让我眼前一亮！所以从此以后本人便是姓陈名思成字予文了。今天公布此事，是希望大伙有事没事多念叨念叨这个“予文”……总是有利无害的事……",[94,101,102],{},"予文………………好名字……………………",[94,104,105],{},"08年真的过去了，无论西算中算，都过去了。此刻，我独坐在电脑桌前，反复听着“北京北京”，安静……刚刚的喧嚣已经过去，仿佛从没发生。其实没错，生活便是如此。一切浮华终究泡影，最后都会化做平淡静谧。",[94,107,108],{},"我想说什么？想说，08年又长大了一岁。我说长大而没用苍老，聪明如你定会明白我骨子里还是孩子的。08年于中国于世界都是多事之秋，但她过去了，也如同没来过。有何收获或失去？其实……我想说收获未必是你渴望，失去也未必会不复得……",[94,110,111],{},"09年，猝然而至。尽管不信我的祝愿有多大用处，还是把最好的祝福送给所有看过这篇博文的人……09年，中国人的牛年，都牛一点！都开心多一点吧！",[94,113,114],{},"我会继续努力，继续走自己的路，生命不息，战斗不止！",[94,116,117],{},"  公元2009年，我来了！",{"title":119,"searchDepth":120,"depth":120,"links":121},"",2,[],[6],"从此以后本人便是姓陈名思成字予文了。","md",{"date":126},"2009-01-26 00:26",true,"\u002Fblog\u002Fblog_4af9831b0100bx8c",{"title":89,"description":123},"blog_4af9831b0100bx8c","blog\u002Fblog_4af9831b0100bx8c",[133],"杂谈","OQx0bhkemnQBtMb3TuDOcUsUpW9bzUfliCKLHnbciS8",[136,141],{"title":137,"path":138,"stem":139,"children":-1,"slug":140},"海","\u002Fblog\u002Fblog_4af9831b0100bt89","blog\u002Fblog_4af9831b0100bt89","blog_4af9831b0100bt89",{"title":142,"path":143,"stem":144,"children":-1,"slug":145},"失眠……","\u002Fblog\u002Fblog_4af9831b0100cdig","blog\u002Fblog_4af9831b0100cdig","blog_4af9831b0100cdig",1794546769656]
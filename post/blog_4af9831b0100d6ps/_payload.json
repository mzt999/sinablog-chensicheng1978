":89,"body":90,"categories":131,"description":132,"extension":133,"meta":134,"navigation":136,"path":137,"seo":138,"slug":139,"stem":140,"tags":141,"__hash__":143},"blog\u002Fblog\u002Fblog_4af9831b0100d6ps.md","临行",{"type":91,"value":92,"toc":127},"minimark",[93,97,100,103,106,109,112,115,118,121,124],[94,95,96],"p",{},"明天一早启程于横店。",[94,98,99],{},"北京——法兰克福——尼斯",[94,101,102],{},"一天的戏，从早到晚。我在扮演着那个人格分裂的可怜之人……",[94,104,105],{},"我又在出卖自己，那个没见过的我……也是一部分的我……",[94,107,108],{},"  劳累困顿的有些恍悟，仰望夜空，星若凡尘……",[94,110,111],{},"我在活着？活在何处？今昔何夕？……",[94,113,114],{},"我的工作是造梦还是我本来就在梦中？……",[94,116,117],{},"总想看破，到头来却是最沉溺的一个……",[94,119,120],{},"  临行，未知。",[94,122,123],{},"揣测着自己下次到这儿来的心情……",[94,125,126],{},"  只愿，还好……",{"title":128,"searchDepth":129,"depth":129,"links":130},"",2,[],[6],"我在扮演着那个人格分裂的可怜之人……","md",{"date":135},"2009-05-11 23:05",true,"\u002Fblog\u002Fblog_4af9831b0100d6ps",{"title":89,"description":132},"blog_4af9831b0100d6ps","blog\u002Fblog_4af9831b0100d6ps",[142],"杂谈","zQTnzoijUpuXWv-q0MVqmyEzf3HBGlZRZMbS1PbZY3o",[145,150],{"title":146,"path":147,"stem":148,"children":-1,"slug":149},"我爱你   中国","\u002Fblog\u002Fblog_4af9831b0100d2st","blog\u002Fblog_4af9831b0100d2st","blog_4af9831b0100d2st",{"title":151,"path":152,"stem":153,"children":-1,"slug":154},"戛纳电影节的中国之夜","\u002Fblog\u002Fblog_4af9831b0100da82","blog\u002Fblog_4af9831b0100da82","blog_4af9831b0100da82",1794546769601]
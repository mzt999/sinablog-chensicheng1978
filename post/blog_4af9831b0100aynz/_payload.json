[{"data":1,"prerenderedAt":104},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":17,"blog-post-slug-blog_4af9831b0100aynz":34,"surround-blog_4af9831b0100aynz":93},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"latestBlog":18},[19,22,25,28,31],{"title":20,"slug":21},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":23,"slug":24},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":26,"slug":27},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":29,"slug":30},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":32,"slug":33},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":35,"title":36,"body":37,"categories":81,"description":49,"extension":82,"meta":83,"navigation":85,"path":86,"seo":87,"slug":88,"stem":89,"tags":90,"__hash__":92},"blog\u002Fblog\u002Fblog_4af9831b0100aynz.md","无言",{"type":38,"value":39,"toc":77},"minimark",[40,44,47,50,53,56,59,62,65,68,71,74],[41,42,43],"p",{},"十二日。又见了你们。",[41,45,46],{},"尤其是中华，相隔一年，她还在……感动。",[41,48,49],{},"都说时间是一切情感的大敌，所以……我小心翼翼的拥有，从没渴求永远。",[41,51,52],{},"但是，我越来越信，会有些人，可以伴着我，直至最后……",[41,54,55],{},"我居然收到了自己的“专辑”和“小说”……万分难得的礼物。会是我挚爱的收藏。",[41,57,58],{},"你们是我的动力，真的。",[41,60,61],{},"今天的心情不是很好，特别想出去走走……",[41,63,64],{},"但身边居然找不到个合适的人，算不算可怜？",[41,66,67],{},"  上来也不知继续写点什么……因为明白再写下去，不会明媚……",[41,69,70],{},"  不想你们担心。",[41,72,73],{},"于是，我决定一个人……",[41,75,76],{},"  去扮演今夜，这城市孤独的游神……",{"title":78,"searchDepth":79,"depth":79,"links":80},"",2,[],[6],"md",{"date":84},"2008-10-14 23:41",true,"\u002Fblog\u002Fblog_4af9831b0100aynz",{"title":36,"description":49},"blog_4af9831b0100aynz","blog\u002Fblog_4af9831b0100aynz",[91],"杂谈","SoLOjmItw5-o9sLmiHTGcGnIMhzdtzpHKkwWuGxuMp8",[94,99],{"title":95,"path":96,"stem":97,"children":-1,"slug":98},"痕迹","\u002Fblog\u002Fblog_4af9831b0100ar4i","blog\u002Fblog_4af9831b0100ar4i","blog_4af9831b0100ar4i",{"title":100,"path":101,"stem":102,"children":-1,"slug":103},"那段岁月 那个人","\u002Fblog\u002Fblog_4af9831b0100b075","blog\u002Fb
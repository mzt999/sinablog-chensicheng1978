[{"data":1,"prerenderedAt":157},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":70,"blog-post-slug-blog_4af9831b0100aynz":87,"surround-blog_4af9831b0100aynz":146},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":45,"navLinks":46,"perPage":16,"prevNextIsExcludeDate":66,"site_description":23,"site_name":67,"stem":68,"__hash__":69},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{},[47,52,56,60,64],{"path":48,"title":49,"target":50,"fa_class":51},"\u002F","博客首页","internal","fa-home",{"path":53,"title":54,"target":50,"fa_class":55},"\u002Fabout","关于","fa-user",{"path":57,"title":58,"target":50,"fa_class":59},"\u002Fpost","归档","fa-archive",{"path":61,"title":62,"target":50,"fa_class":63},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":65,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","jvZHccz2rT-wjVS5GCPgWyhl8WnBIvECPkE5KpKFKCU",{"latestBlog":71},[72,75,78,81,84],{"title":73,"slug":74},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":76,"slug":77},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":79,"slug":80},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":82,"slug":83},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":85,"slug":86},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":88,"title":89,"body":90,"categories":134,"description":102,"extension":135,"meta":136,"navigation":138,"path":139,"seo":140,"slug":141,"stem":142,"tags":143,"__hash__":145},"blog\u002Fblog\u002Fblog_4af9831b0100aynz.md","无言",{"type":91,"value":92,"toc":130},"minimark",[93,97,100,103,106,109,112,115,118,121,124,127],[94,95,96],"p",{},"十二日。又见了你们。",[94,98,99],{},"尤其是中华，相隔一年，她还在……感动。",[94,101,102],{},"都说时间是一切情感的大敌，所以……我小心翼翼的拥有，从没渴求永远。",[94,104,105],{},"但是，我越来越信，会有些人，可以伴着我，直至最后……",[94,107,108],{},"我居然收到了自己的“专辑”和“小说”……万分难得的礼物。会是我挚爱的收藏。",[94,110,111],{},"你们是我的动力，真的。",[94,113,114],{},"今天的心情不是很好，特别想出去走走……",[94,116,117],{},"但身边居然找不到个合适的人，算不算可怜？",[94,119,120],{},"  上来也不知继续写点什么……因为明白再写下去，不会明媚……",[94,122,123],{},"  不想你们担心。",[94,125,126],{},"于是，我决定一个人……",[94,128,129],{},"  去扮演今夜，这城市孤独的游神……",{"title":131,"searchDepth":132,"depth":132,"links":133},"",2,[],[6],"md",{"date":137},"2008-10-14 23:41",true,"\u002Fblog\u002Fblog_4af9831b0100aynz",{"title":89,"description":102},"blog_4af9831b0100aynz","blog\u002Fblog_4af9831b0100aynz",[144],"杂谈","SoLOjmItw5-o9sLmiHTGcGnIMhzdtzpHKkwWuGxuMp8",[147,152],{"title":148,"path":149,"stem":150,"children":-1,"slug":151},"痕迹","\u002Fblog\u002Fblog_4af9831b0100ar4i","blog\u002Fblog_4af9831b0100ar4i","blog_4af9831b0100ar4i",{"title":153,"path":154,"stem":155,"children":-1,"slug":156},"那段岁月 那个人","\u002Fblog\u002Fblog_4af9831b0100b075","blog\u002Fblog_4af9831b0100b075","blog_4af9831b0100b075",1794546769708]
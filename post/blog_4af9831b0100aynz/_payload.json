[{"data":1,"prerenderedAt":101},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b0100aynz":31,"surround-blog_4af9831b0100aynz":90},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",152,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":78,"description":33,"extension":79,"meta":80,"navigation":82,"path":83,"seo":84,"slug":85,"stem":86,"tags":87,"__hash__":89},"blog\u002Fblog\u002Fblog_4af9831b0100aynz.md","无言",{"type":35,"value":36,"toc":74},"minimark",[37,41,44,47,50,53,56,59,62,65,68,71],[38,39,40],"p",{},"十二日。又见了你们。",[38,42,43],{},"尤其是中华，相隔一年，她还在……感动。",[38,45,46],{},"都说时间是一切情感的大敌，所以……我小心翼翼的拥有，从没渴求永远。",[38,48,49],{},"但是，我越来越信，会有些人，可以伴着我，直至最后……",[38,51,52],{},"我居然收到了自己的“专辑”和“小说”……万分难得的礼物。会是我挚爱的收藏。",[38,54,55],{},"你们是我的动力，真的。",[38,57,58],{},"今天的心情不是很好，特别想出去走走……",[38,60,61],{},"但身边居然找不到个合适的人，算不算可怜？",[38,63,64],{},"  上来也不知继续写点什么……因为明白再写下去，不会明媚……",[38,66,67],{},"  不想你们担心。",[38,69,70],{},"于是，我决定一个人……",[38,72,73],{},"  去扮演今夜，这城市孤独的游神……",{"title":75,"searchDepth":76,"depth":76,"links":77},"",2,[],[6],"md",{"date":81},"2008-10-14 23:41",true,"\u002Fblog\u002Fblog_4af9831b0100aynz",{"title":33,"description":33},"blog_4af9831b0100aynz","blog\u002Fblog_4af9831b0100aynz",[88],"杂谈","kz-B9j0PPGNjxVTta-sCOrHebE2H17dUhX_EgwwYYic",[91,96],{"title":92,"path":93,"stem":94,"children":-1,"slug":95},"痕迹","\u002Fblog\u002Fblog_4af9831b0100ar4i","blog\u002Fblog_4af9831b0100ar4i","blog_4af9831b0100ar4i",{"title":97,"path":98,"stem":99,"children":-1,"slug":100},"那段岁月 那个人","\u002Fblog\u002Fblog_4af9831b0100b075","blog\u002Fblog_4af9831b0100b075","blog_4af9831b0
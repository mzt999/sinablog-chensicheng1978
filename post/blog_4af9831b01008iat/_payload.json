[{"data":1,"prerenderedAt":163},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":58,"blog-post-slug-blog_4af9831b01008iat":75,"surround-blog_4af9831b01008iat":152},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":54,"site_description":55,"stem":56,"__hash__":57},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo",20,"新浪博客内容备份","settings","hh8X7X6SFDoeJrxIJ4yisZXSc3HwHM1zk206jiQX2XU",{"latestBlog":59},[60,63,66,69,72],{"title":61,"slug":62},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":64,"slug":65},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":67,"slug":68},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":70,"slug":71},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":73,"slug":74},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":76,"title":77,"body":78,"categories":140,"description":96,"extension":141,"meta":142,"navigation":144,"path":145,"seo":146,"slug":147,"stem":148,"tags":149,"__hash__":151},"blog\u002Fblog\u002Fblog_4af9831b01008iat.md","走下去",{"type":79,"value":80,"toc":136},"minimark",[81,85,88,91,94,97,100,103,106,109,112,115,118,121,124,127,130,133],[82,83,84],"p",{},"如无意外,明天上路.",[82,86,87],{},"又一段旅程,又一次未知.",[82,89,90],{},"这次的选择无比艰难,等待也万分漫长.最终是什么让我决定?",[82,92,93],{},"我也自问,答案:体验!",[82,95,96],{},"我们买的都是单程票,一路的风景不会重复.去尝试更多是否就是更好?",[82,98,99],{},"又是一年,时间真不是东西.我们没法回头,所以就算后悔我也要去冒险!憧憬着此刻云南的春光,热烈.那该是很美的光景,如同\"士兵\"!但那毕竟有过,虽不酣畅但余韵十足,足以用此生回味...但我的前路?...我们在演别人,就是这样,别人们成了自己...",[82,101,102],{},"此次的创作,不愿多谈也不便多谈,我的一次剑走偏锋,我不是孩子了,虽然总拿自己当孩子.但毕竟不是了,你们也不是了...",[82,104,105],{},"外面阳光很好,期盼你们永远在这周围.最感动的礼物是樱桃整理的BLOG,那绝对是限量版的藏书,对我,弥足珍贵.爱爱的CSC很漂亮,电影会陪我度过这两个月...",[82,107,108],{},"羸弱的我,乏力的我,困顿的我,迷失的我...此刻,只想,在你身边,靠一靠...",[82,110,111],{},"我想,小憩片刻的我一定又会烈火重生,斗志昂扬,战无不胜!",[82,113,114],{},"路",[82,116,117],{},"眼前",[82,119,120],{},"前景",[82,122,123],{},"未知",[82,125,126],{},"荆途?歧路?",[82,128,129],{},"还是美好的阳光普照",[82,131,132],{},"有你",[82,134,135],{},"走下去!",{"title":137,"searchDepth":138,"depth":138,"links":139},"",2,[],[6],"md",{"date":143},"2008-03-05 16:54",true,"\u002Fblog\u002Fblog_4af9831b01008iat",{"title":77,"description":96},"blog_4af9831b01008iat","blog\u002Fblog_4af9831b01008iat",[150],"情感","V08xl0dRF-kV27lJMWJTEEEfqAz5jrzBAGrlRxyhOtI",[153,158],{"title":154,"path":155,"stem":156,"children":-1,"slug":157},"感谢1群~~最初的感动~~永远的相守~~","\u002Fblog\u002Fblog_4af9831b01008er0","blog\u002Fblog_4af9831b01008er0","blog_4af9831b01008er0",{"title":159,"path":160,"stem":161,"children":-1,"slug":162},"爱情","\u002Fblog\u002Fblog_4af9831b01008u1m","blog\u002Fblog_4af9831b01008u1m","blog_4af9831b01008u1m",1794412500733]
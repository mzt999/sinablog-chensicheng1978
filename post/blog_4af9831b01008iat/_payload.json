[{"data":1,"prerenderedAt":178},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":73,"blog-post-slug-blog_4af9831b01008iat":90,"surround-blog_4af9831b01008iat":167},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":48,"navLinks":49,"perPage":16,"prevNextIsExcludeDate":69,"site_description":23,"site_name":70,"stem":71,"__hash__":72},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43,45],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{"href":46,"text":47},"https:\u002F\u002Fmzt999.github.io\u002Fportfolio-chensicheng1978","幕后作品集展示(2012-2026)",{},[50,55,59,63,67],{"path":51,"title":52,"target":53,"fa_class":54},"\u002F","博客首页","internal","fa-home",{"path":56,"title":57,"target":53,"fa_class":58},"\u002Fabout","关于","fa-user",{"path":60,"title":61,"target":53,"fa_class":62},"\u002Fpost","归档","fa-archive",{"path":64,"title":65,"target":53,"fa_class":66},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":68,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","LA_7Y82F2zjQ6-R2_tcWHl356krYL76uqQHBCIU8UZk",{"latestBlog":74},[75,78,81,84,87],{"title":76,"slug":77},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":79,"slug":80},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":82,"slug":83},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":85,"slug":86},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":88,"slug":89},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":91,"title":92,"body":93,"categories":155,"description":111,"extension":156,"meta":157,"navigation":159,"path":160,"seo":161,"slug":162,"stem":163,"tags":164,"__hash__":166},"blog\u002Fblog\u002Fblog_4af9831b01008iat.md","走下去",{"type":94,"value":95,"toc":151},"minimark",[96,100,103,106,109,112,115,118,121,124,127,130,133,136,139,142,145,148],[97,98,99],"p",{},"如无意外,明天上路.",[97,101,102],{},"又一段旅程,又一次未知.",[97,104,105],{},"这次的选择无比艰难,等待也万分漫长.最终是什么让我决定?",[97,107,108],{},"我也自问,答案:体验!",[97,110,111],{},"我们买的都是单程票,一路的风景不会重复.去尝试更多是否就是更好?",[97,113,114],{},"又是一年,时间真不是东西.我们没法回头,所以就算后悔我也要去冒险!憧憬着此刻云南的春光,热烈.那该是很美的光景,如同\"士兵\"!但那毕竟有过,虽不酣畅但余韵十足,足以用此生回味...但我的前路?...我们在演别人,就是这样,别人们成了自己...",[97,116,117],{},"此次的创作,不愿多谈也不便多谈,我的一次剑走偏锋,我不是孩子了,虽然总拿自己当孩子.但毕竟不是了,你们也不是了...",[97,119,120],{},"外面阳光很好,期盼你们永远在这周围.最感动的礼物是樱桃整理的BLOG,那绝对是限量版的藏书,对我,弥足珍贵.爱爱的CSC很漂亮,电影会陪我度过这两个月...",[97,122,123],{},"羸弱的我,乏力的我,困顿的我,迷失的我...此刻,只想,在你身边,靠一靠...",[97,125,126],{},"我想,小憩片刻的我一定又会烈火重生,斗志昂扬,战无不胜!",[97,128,129],{},"路",[97,131,132],{},"眼前",[97,134,135],{},"前景",[97,137,138],{},"未知",[97,140,141],{},"荆途?歧路?",[97,143,144],{},"还是美好的阳光普照",[97,146,147],{},"有你",[97,149,150],{},"走下去!",{"title":152,"searchDepth":153,"depth":153,"links":154},"",2,[],[6],"md",{"date":158},"2008-03-05 16:54",true,"\u002Fblog\u002Fblog_4af9831b01008iat",{"title":92,"description":111},"blog_4af9831b01008iat","blog\u002Fblog_4af9831b01008iat",[165],"情感","V08xl0dRF-kV27lJMWJTEEEfqAz5jrzBAGrlRxyhOtI",[168,173],{"title":169,"path":170,"stem":171,"children":-1,"slug":172},"感谢1群~~最初的感动~~永远的相守~~","\u002Fblog\u002Fblog_4af9831b01008er0","blog\u002Fblog_4af9831b01008er0","blog_4af9831b01008er0",{"title":174,"path":175,"stem":176,"children":-1,"slug":177},"爱情","\u002Fblog\u002Fblog_4af9831b01008u1m","blog\u002Fblog_4af9831b01008u1m","blog_4af9831b01008u1m",1794760532108]
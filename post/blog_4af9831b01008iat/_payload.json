[{"data":1,"prerenderedAt":162},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":57,"blog-post-slug-blog_4af9831b01008iat":74,"surround-blog_4af9831b01008iat":151},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":16,"site_description":54,"stem":55,"__hash__":56},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo","新浪博客内容备份(粉丝自用)","settings","jPD1QWrYwbaIixg6lntppEYe-T3ZGd3EJZxFBkbKY9E",{"latestBlog":58},[59,62,65,68,71],{"title":60,"slug":61},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":63,"slug":64},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":66,"slug":67},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":69,"slug":70},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":72,"slug":73},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":75,"title":76,"body":77,"categories":139,"description":95,"extension":140,"meta":141,"navigation":143,"path":144,"seo":145,"slug":146,"stem":147,"tags":148,"__hash__":150},"blog\u002Fblog\u002Fblog_4af9831b01008iat.md","走下去",{"type":78,"value":79,"toc":135},"minimark",[80,84,87,90,93,96,99,102,105,108,111,114,117,120,123,126,129,132],[81,82,83],"p",{},"如无意外,明天上路.",[81,85,86],{},"又一段旅程,又一次未知.",[81,88,89],{},"这次的选择无比艰难,等待也万分漫长.最终是什么让我决定?",[81,91,92],{},"我也自问,答案:体验!",[81,94,95],{},"我们买的都是单程票,一路的风景不会重复.去尝试更多是否就是更好?",[81,97,98],{},"又是一年,时间真不是东西.我们没法回头,所以就算后悔我也要去冒险!憧憬着此刻云南的春光,热烈.那该是很美的光景,如同\"士兵\"!但那毕竟有过,虽不酣畅但余韵十足,足以用此生回味...但我的前路?...我们在演别人,就是这样,别人们成了自己...",[81,100,101],{},"此次的创作,不愿多谈也不便多谈,我的一次剑走偏锋,我不是孩子了,虽然总拿自己当孩子.但毕竟不是了,你们也不是了...",[81,103,104],{},"外面阳光很好,期盼你们永远在这周围.最感动的礼物是樱桃整理的BLOG,那绝对是限量版的藏书,对我,弥足珍贵.爱爱的CSC很漂亮,电影会陪我度过这两个月...",[81,106,107],{},"羸弱的我,乏力的我,困顿的我,迷失的我...此刻,只想,在你身边,靠一靠...",[81,109,110],{},"我想,小憩片刻的我一定又会烈火重生,斗志昂扬,战无不胜!",[81,112,113],{},"路",[81,115,116],{},"眼前",[81,118,119],{},"前景",[81,121,122],{},"未知",[81,124,125],{},"荆途?歧路?",[81,127,128],{},"还是美好的阳光普照",[81,130,131],{},"有你",[81,133,134],{},"走下去!",{"title":136,"searchDepth":137,"depth":137,"links":138},"",2,[],[6],"md",{"date":142},"2008-03-05 16:54",true,"\u002Fblog\u002Fblog_4af9831b01008iat",{"title":76,"description":95},"blog_4af9831b01008iat","blog\u002Fblog_4af9831b01008iat",[149],"情感","V08xl0dRF-kV27lJMWJTEEEfqAz5jrzBAGrlRxyhOtI",[152,157],{"title":153,"path":154,"stem":155,"children":-1,"slug":156},"感谢1群~~最初的感动~~永远的相守~~","\u002Fblog\u002Fblog_4af9831b01008er0","blog\u002Fblog_4af9831b01008er0","blog_4af9831b01008er0",{"title":158,"path":159,"stem":160,"children":-1,"slug":161},"爱情","\u002Fblog\u002Fblog_4af9831b01008u1m","blog\u002Fblog_4af9831b01008u1m","blog_4af9831b01008u1m",1794473705421]
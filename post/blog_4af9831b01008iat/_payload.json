[{"data":1,"prerenderedAt":122},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":17,"blog-post-slug-blog_4af9831b01008iat":34,"surround-blog_4af9831b01008iat":111},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"latestBlog":18},[19,22,25,28,31],{"title":20,"slug":21},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":23,"slug":24},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":26,"slug":27},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":29,"slug":30},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":32,"slug":33},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":35,"title":36,"body":37,"categories":99,"description":55,"extension":100,"meta":101,"navigation":103,"path":104,"seo":105,"slug":106,"stem":107,"tags":108,"__hash__":110},"blog\u002Fblog\u002Fblog_4af9831b01008iat.md","走下去",{"type":38,"value":39,"toc":95},"minimark",[40,44,47,50,53,56,59,62,65,68,71,74,77,80,83,86,89,92],[41,42,43],"p",{},"如无意外,明天上路.",[41,45,46],{},"又一段旅程,又一次未知.",[41,48,49],{},"这次的选择无比艰难,等待也万分漫长.最终是什么让我决定?",[41,51,52],{},"我也自问,答案:体验!",[41,54,55],{},"我们买的都是单程票,一路的风景不会重复.去尝试更多是否就是更好?",[41,57,58],{},"又是一年,时间真不是东西.我们没法回头,所以就算后悔我也要去冒险!憧憬着此刻云南的春光,热烈.那该是很美的光景,如同\"士兵\"!但那毕竟有过,虽不酣畅但余韵十足,足以用此生回味...但我的前路?...我们在演别人,就是这样,别人们成了自己...",[41,60,61],{},"此次的创作,不愿多谈也不便多谈,我的一次剑走偏锋,我不是孩子了,虽然总拿自己当孩子.但毕竟不是了,你们也不是了...",[41,63,64],{},"外面阳光很好,期盼你们永远在这周围.最感动的礼物是樱桃整理的BLOG,那绝对是限量版的藏书,对我,弥足珍贵.爱爱的CSC很漂亮,电影会陪我度过这两个月...",[41,66,67],{},"羸弱的我,乏力的我,困顿的我,迷失的我...此刻,只想,在你身边,靠一靠...",[41,69,70],{},"我想,小憩片刻的我一定又会烈火重生,斗志昂扬,战无不胜!",[41,72,73],{},"路",[41,75,76],{},"眼前",[41,78,79],{},"前景",[41,81,82],{},"未知",[41,84,85],{},"荆途?歧路?",[41,87,88],{},"还是美好的阳光普照",[41,90,91],{},"有你",[41,93,94],{},"走下去!",{"title":96,"searchDepth":97,"depth":97,"links":98},"",2,[],[6],"md",{"date":102},"2008-03-05 16:54",true,"\u002Fblog\u002Fblog_4af9831b01008iat",{"title":36,"description":55},"blog_4af9831b01008iat","blog\u002Fblog_4af9831b01008iat",[109],"情感","
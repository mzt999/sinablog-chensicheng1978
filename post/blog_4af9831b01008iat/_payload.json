[{"data":1,"prerenderedAt":119},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b01008iat":31,"surround-blog_4af9831b01008iat":108},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",151,{"name":9,"len":10},"有图",34,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":96,"description":33,"extension":97,"meta":98,"navigation":100,"path":101,"seo":102,"slug":103,"stem":104,"tags":105,"__hash__":107},"blog\u002Fblog\u002Fblog_4af9831b01008iat.md","走下去",{"type":35,"value":36,"toc":92},"minimark",[37,41,44,47,50,53,56,59,62,65,68,71,74,77,80,83,86,89],[38,39,40],"p",{},"如无意外,明天上路.",[38,42,43],{},"又一段旅程,又一次未知.",[38,45,46],{},"这次的选择无比艰难,等待也万分漫长.最终是什么让我决定?",[38,48,49],{},"我也自问,答案:体验!",[38,51,52],{},"我们买的都是单程票,一路的风景不会重复.去尝试更多是否就是更好?",[38,54,55],{},"又是一年,时间真不是东西.我们没法回头,所以就算后悔我也要去冒险!憧憬着此刻云南的春光,热烈.那该是很美的光景,如同\"士兵\"!但那毕竟有过,虽不酣畅但余韵十足,足以用此生回味...但我的前路?...我们在演别人,就是这样,别人们成了自己...",[38,57,58],{},"此次的创作,不愿多谈也不便多谈,我的一次剑走偏锋,我不是孩子了,虽然总拿自己当孩子.但毕竟不是了,你们也不是了...",[38,60,61],{},"外面阳光很好,期盼你们永远在这周围.最感动的礼物是樱桃整理的BLOG,那绝对是限量版的藏书,对我,弥足珍贵.爱爱的CSC很漂亮,电影会陪我度过这两个月...",[38,63,64],{},"羸弱的我,乏力的我,困顿的我,迷失的我...此刻,只想,在你身边,靠一靠...",[38,66,67],{},"我想,小憩片刻的我一定又会烈火重生,斗志昂扬,战无不胜!",[38,69,70],{},"路",[38,72,73],{},"眼前",[38,75,76],{},"前景",[38,78,79],{},"未知",[38,81,82],{},"荆途?歧路?",[38,84,85],{},"还是美好的阳光普照",[38,87,88],{},"有你",[38,90,91],{},"走下去!",{"title":93,"searchDepth":94,"depth":94,"links":95},"",2,[],[6],"md",{"date":99},"2008-03-05 16:54",true,"\u002Fblog\u002Fblog_4af9831b01008iat",{"title":33,"description":33},"blog_4af9831b01008iat","blog\u002Fblog_4af9831b01008iat",[106],"情感","ZXiXH6bIrCz91yAw0q0zay79XqvhJuhnP3WgT
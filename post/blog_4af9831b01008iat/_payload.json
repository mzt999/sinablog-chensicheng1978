[{"data":1,"prerenderedAt":175},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":70,"blog-post-slug-blog_4af9831b01008iat":87,"surround-blog_4af9831b01008iat":164},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":45,"navLinks":46,"perPage":16,"prevNextIsExcludeDate":66,"site_description":23,"site_name":67,"stem":68,"__hash__":69},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{},[47,52,56,60,64],{"path":48,"title":49,"target":50,"fa_class":51},"\u002F","博客首页","internal","fa-home",{"path":53,"title":54,"target":50,"fa_class":55},"\u002Fabout","关于","fa-user",{"path":57,"title":58,"target":50,"fa_class":59},"\u002Fpost","归档","fa-archive",{"path":61,"title":62,"target":50,"fa_class":63},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":65,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","jvZHccz2rT-wjVS5GCPgWyhl8WnBIvECPkE5KpKFKCU",{"latestBlog":71},[72,75,78,81,84],{"title":73,"slug":74},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":76,"slug":77},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":79,"slug":80},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":82,"slug":83},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":85,"slug":86},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":88,"title":89,"body":90,"categories":152,"description":108,"extension":153,"meta":154,"navigation":156,"path":157,"seo":158,"slug":159,"stem":160,"tags":161,"__hash__":163},"blog\u002Fblog\u002Fblog_4af9831b01008iat.md","走下去",{"type":91,"value":92,"toc":148},"minimark",[93,97,100,103,106,109,112,115,118,121,124,127,130,133,136,139,142,145],[94,95,96],"p",{},"如无意外,明天上路.",[94,98,99],{},"又一段旅程,又一次未知.",[94,101,102],{},"这次的选择无比艰难,等待也万分漫长.最终是什么让我决定?",[94,104,105],{},"我也自问,答案:体验!",[94,107,108],{},"我们买的都是单程票,一路的风景不会重复.去尝试更多是否就是更好?",[94,110,111],{},"又是一年,时间真不是东西.我们没法回头,所以就算后悔我也要去冒险!憧憬着此刻云南的春光,热烈.那该是很美的光景,如同\"士兵\"!但那毕竟有过,虽不酣畅但余韵十足,足以用此生回味...但我的前路?...我们在演别人,就是这样,别人们成了自己...",[94,113,114],{},"此次的创作,不愿多谈也不便多谈,我的一次剑走偏锋,我不是孩子了,虽然总拿自己当孩子.但毕竟不是了,你们也不是了...",[94,116,117],{},"外面阳光很好,期盼你们永远在这周围.最感动的礼物是樱桃整理的BLOG,那绝对是限量版的藏书,对我,弥足珍贵.爱爱的CSC很漂亮,电影会陪我度过这两个月...",[94,119,120],{},"羸弱的我,乏力的我,困顿的我,迷失的我...此刻,只想,在你身边,靠一靠...",[94,122,123],{},"我想,小憩片刻的我一定又会烈火重生,斗志昂扬,战无不胜!",[94,125,126],{},"路",[94,128,129],{},"眼前",[94,131,132],{},"前景",[94,134,135],{},"未知",[94,137,138],{},"荆途?歧路?",[94,140,141],{},"还是美好的阳光普照",[94,143,144],{},"有你",[94,146,147],{},"走下去!",{"title":149,"searchDepth":150,"depth":150,"links":151},"",2,[],[6],"md",{"date":155},"2008-03-05 16:54",true,"\u002Fblog\u002Fblog_4af9831b01008iat",{"title":89,"description":108},"blog_4af9831b01008iat","blog\u002Fblog_4af9831b01008iat",[162],"情感","V08xl0dRF-kV27lJMWJTEEEfqAz5jrzBAGrlRxyhOtI",[165,170],{"title":166,"path":167,"stem":168,"children":-1,"slug":169},"感谢1群~~最初的感动~~永远的相守~~","\u002Fblog\u002Fblog_4af9831b01008er0","blog\u002Fblog_4af9831b01008er0","blog_4af9831b01008er0",{"title":171,"path":172,"stem":173,"children":-1,"slug":174},"爱情","\u002Fblog\u002Fblog_4af9831b01008u1m","blog\u002Fblog_4af9831b01008u1m","blog_4af9831b01008u1m",1794546769831]
[{"data":1,"prerenderedAt":79},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b010007zh":31,"surround-blog_4af9831b010007zh":68},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",152,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":57,"description":33,"extension":58,"meta":59,"navigation":61,"path":62,"seo":63,"slug":64,"stem":65,"tags":66,"__hash__":67},"blog\u002Fblog\u002Fblog_4af9831b010007zh.md","母校归来",{"type":35,"value":36,"toc":53},"minimark",[37,41,44,47,50],[38,39,40],"p",{},"刚刚回来,心情还好.回了一页大家的留言,没回到的见谅吧.晚上回母校看了恩师的老公另一个恩师毕业班的大戏\u003C捕鼠记>,这个剧本我们在校的时候班上同学也搞过,可我是今天才看到,觉得不错.看到台上满眼的青春真是很羡慕那种曾有的飞扬.每次心情不好都愿回学校看看,有的时候甚至是一个人悄悄的去...把车停在光的背面,蹑手蹑脚,心虚于这里已不属于自己...然后偷偷的四处走走各处看看...看曾经的校园曾经的寝室曾经的窗想曾经的故事曾经的感动曾经的人仿佛听得到曾经的台词曾经的欢笑曾经的歌...心情会阑珊记忆会班驳眼眶会模糊...但随即人也会塌实和开心许多...两年前的一次酒后和两个好友在学校门口干过件特别荒唐的事...惭愧,想想还是不说!但无论怎样的表现,都只能说明我爱她...",[38,42,43],{},"我们都是经过卫生检验的猪,无论愿意与否,但凡合格都会被盖上了\"中戏\"的蓝章,这辈子是抹不掉的...",[38,45,46],{},"又见了\"咱妈\",还是不知该说什么...汗颜于今天的我依旧辜负着她的重望...安啦!我们跑的是马拉松!暂时的落后不一定是最后的名次...久久的辉煌?我们会有!",[38,48,49],{},"每次看到师弟妹的演出和汇报就仿佛给自己充电,我们都有一个名字,但我们也有各自的名字.那么,我们该为这些名字做点什么?...",[38,51,52],{},"同学?好奇怪的称呼,你可以说这称呼一钱不值,也可以视作千金...该是如何?见心!反正在这样的一个夜晚,我要祝我的15个同学今晚会有个好梦...",{"title":54,"searchDepth":55,"depth":55,"links":56},"",2,[],[6],"md",{"date":60},"2007-04-10 01:11",true,"\u002Fblog\u002Fblog_4af9831b010007zh",{"title":33,"description":33},"blog_4af9831b010007zh","blog\u002Fblog_4af9831b010007zh",[],"p-bS4XiskIgmBMRDlyYcGypQoLjtLvVqbNfOKhiQCd4",[69,74],{"title":70,"path":71,"stem":72,"children":-1,"slug":73},"回来","\u002Fblog\u002Fblog_4af9831b010007yw","blog\u002Fblog_4af9831b010007yw","blog_4af9831b010007yw",{"title":75,"path":76,"stem":77,"children":-1,"slug":78},"雷志明","\u002Fblog\u002Fblog_4af9831b0100080v","blog\u002Fblog_4af9831b0100080v","blog_4af9831b0100080v",1793968538672]
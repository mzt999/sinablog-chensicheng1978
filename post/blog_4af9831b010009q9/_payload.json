":89,"body":90,"categories":128,"description":129,"extension":130,"meta":131,"navigation":133,"path":134,"seo":135,"slug":136,"stem":137,"tags":138,"__hash__":140},"blog\u002Fblog\u002Fblog_4af9831b010009q9.md","好人 好梦",{"type":91,"value":92,"toc":124},"minimark",[93,97,100,103,106,109,112,115,118,121],[94,95,96],"p",{},"明知道一会有活动,可偏偏精神着.就上来胡说.月底去广东拍摄新戏了,但这次会常上来!因为实在发现不舍了.(听说现在已经有宽带的移动网卡了?)",[94,98,99],{},"\"暗战\"是几年前的戏了,发得还不错,于是续.但内容无关属噱头.",[94,101,102],{},"本子不错,悬念会引着看下去,直至谜底.",[94,104,105],{},"又是个警察,但不同已往.这个叫\"黄涛\"的很有趣.又是这个戏的灵魂,如同\"子弹\"的雷志明!于是,在\"团长\"前抽空再拍一个!",[94,107,108],{},"很多朋友关心\"团长\"橙子上不上.",[94,110,111],{},"答:必上!",[94,113,114],{},"所以!大家一起加油吧!",[94,116,117],{},"革命尚未成功,同志仍需努力!",[94,119,120],{},"给今夜的你们问好!",[94,122,123],{},"此刻,好人,好梦.",{"title":125,"searchDepth":126,"depth":126,"links":127},"",2,[],[6],"明知道一会有活动,可偏偏精神着.就上来胡说.","md",{"date":132},"2007-08-07 04:01",true,"\u002Fblog\u002Fblog_4af9831b010009q9",{"title":89,"description":129},"blog_4af9831b010009q9","blog\u002Fblog_4af9831b010009q9",[139],"生活记录","5AWf1uqCzJr_nFQ4Ih-U3Yp6fQYTQUzyoxeFTMSoJA4",[142,147],{"title":143,"path":144,"stem":145,"children":-1,"slug":146},"下一战...","\u002Fblog\u002Fblog_4af9831b010009q8","blog\u002Fblog_4af9831b010009q8","blog_4af9831b010009q8",{"title":148,"path":149,"stem":150,"children":-1,"slug":151},"他不是李白","\u002Fblog\u002Fblog_4af9831b010009r6","blog\u002Fblog_4af9831b010009r6","blog_4af9831b010009r6",1794544668001]
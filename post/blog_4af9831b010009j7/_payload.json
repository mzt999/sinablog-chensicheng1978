[{"data":1,"prerenderedAt":124},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":57,"blog-post-slug-blog_4af9831b010009j7":74,"surround-blog_4af9831b010009j7":113},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":16,"site_description":54,"stem":55,"__hash__":56},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo","新浪博客内容备份(粉丝自用)","settings","jPD1QWrYwbaIixg6lntppEYe-T3ZGd3EJZxFBkbKY9E",{"latestBlog":58},[59,62,65,68,71],{"title":60,"slug":61},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":63,"slug":64},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":66,"slug":67},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":69,"slug":70},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":72,"slug":73},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":75,"title":76,"body":77,"categories":100,"description":101,"extension":102,"meta":103,"navigation":105,"path":106,"seo":107,"slug":109,"stem":110,"tags":111,"__hash__":112},"blog\u002Fblog\u002Fblog_4af9831b010009j7.md","2046",{"type":78,"value":79,"toc":96},"minimark",[80,84,87,90,93],[81,82,83],"p",{},"回到家里,不巧,又有点醉.不过该偷笑,比晨儿强,他又吐了!伟大的我是把他送回家才回家回到这里的,索性上来醒酒,反正身边又没别的人...",[81,85,86],{},"百感交集,今天.太复杂,索性不说,说点简单的.",[81,88,89],{},"先说小鬼吧,给我发了信息,等我回电时,你已关机!此种行为另人发指,难以容忍!(靠!外面天居然亮了!)还有小狼,不接电话,简直该死!!!!!猫的失踪可以归结为对北京城的无意识,太茫然,乱了套...77呢????嘛呢?给你三天时间出来!不是威胁啊!!小样的!!!!!怎么看我72般变化你也没个态度????????雪扬好像去了北极?在酷热的此刻对我说舒服的也该打屁股!!!欢子没见到,也不是我的错!谁让三个月你不来偏在杀青那天添乱的?......反正还是想念你们几个老东西!这里的老东西!要不我停博算了??或也像沈佳妮同学般自说自话?也挺好?\n欲练神功 挥剑自宫?\n张歆艺同学此刻睡熟了,她是我们这里唯一马不停蹄的奔向下个岗位的!此女...此女...此女...哎!!!!!!!想到句不得体的话:此物本该天上有,不知何故在人间??还好!庆幸是活了这么大也就遇见一个她!这丫头!又一个......哎!......服了!!祝她好梦吧...",[81,91,92],{},"\"士兵\"们也是该都睡了,一帮好人啊!老康今天也开了!效仿王小丫了!249就更别说了,现在看他居然不猥琐了!其实真挺汉子的,从来不差酒,喝大了也能像单田芳似的吸引着各种拥趸围绕他身边听他布道.外型欠缺说服力本不是他的错,看来人后天的努力才是最重要的...",[81,94,95],{},"得!又呲出去了,也不知哪哪了...反正,今天说到的都是好人,有一个算一个!好人一生平安.不是我说的,大家都这样说.所以就信大家的吧,准没错!大家好才是真的好,也不是我说的.",{"title":97,"searchDepth":98,"depth":98,"links":99},"",2,[],[6],"回到家里,不巧,又有点醉.","md",{"date":104},"2007-07-25 04:39",true,"\u002Fblog\u002Fblog_4af9831b010009j7",{"title":108,"description":101},2046,"blog_4af9831b010009j7","blog\u002Fblog_4af9831b010009j7",[],"NMaLVCFuHOblpIqBpHl7B4KB2eMWizC_PUU-4WlzSE8",[114,119],{"title":115,"path":116,"stem":117,"children":-1,"slug":118},"成才","\u002Fblog\u002Fblog_4af9831b010009in","blog\u002Fblog_4af9831b010009in","blog_4af9831b010009in",{"title":120,"path":121,"stem":122,"children":-1,"slug":123},"祝福77   生日快乐","\u002Fblog\u002Fblog_4af9831b010009jz","blog\u002Fblog_4af9831b010009jz","blog_4af9831b010009jz",1794473705816]
[{"data":1,"prerenderedAt":143},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":76,"blog-post-slug-blog_4af9831b010009j7":93,"surround-blog_4af9831b010009j7":132},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":38,"meta":50,"navLinks":51,"perPage":16,"prevNextIsExcludeDate":71,"site_description":72,"site_name":73,"stem":74,"__hash__":75},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,26,32],{"text":23},"粉丝自制非官方站点｜素材版权归原权利人所有",{"text":25},"仅兴趣交流、无商业用途｜如有侵权请联系删除",{"text":27,"link":28},"查看",{"href":29,"text":30,"fa_class":31},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":33,"link":34},"如有任何疑问，欢迎",{"href":35,"text":36,"fa_class":37},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[39,42,45,47],{"href":40,"text":41},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":43,"text":44},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":46},"新浪微博备份(2009-2026)",{"href":48,"text":49},"https:\u002F\u002Fmzt999.github.io\u002Fportfolio-chensicheng1978","幕后作品集展示(2012-2026)",{},[52,57,61,65,69],{"path":53,"title":54,"target":55,"fa_class":56},"\u002F","博客首页","internal","fa-home",{"path":58,"title":59,"target":55,"fa_class":60},"\u002Fabout","关于","fa-user",{"path":62,"title":63,"target":55,"fa_class":64},"\u002Fpost","归档","fa-archive",{"path":66,"title":67,"target":55,"fa_class":68},"\u002Fgallery","相册","fa-image",{"path":29,"title":30,"target":70,"fa_class":31},"otherSite",false,"新浪博客内容备份(粉丝自用)","陈思诚的博客","settings","5S7xKt0XLHpkjipbomx4I7pUu50Y7wqtD418LquZj5Q",{"latestBlog":77},[78,81,84,87,90],{"title":79,"slug":80},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":82,"slug":83},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":85,"slug":86},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":88,"slug":89},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":91,"slug":92},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":94,"title":95,"body":96,"categories":119,"description":120,"extension":121,"meta":122,"navigation":124,"path":125,"seo":126,"slug":128,"stem":129,"tags":130,"__hash__":131},"blog\u002Fblog\u002Fblog_4af9831b010009j7.md","2046",{"type":97,"value":98,"toc":115},"minimark",[99,103,106,109,112],[100,101,102],"p",{},"回到家里,不巧,又有点醉.不过该偷笑,比晨儿强,他又吐了!伟大的我是把他送回家才回家回到这里的,索性上来醒酒,反正身边又没别的人...",[100,104,105],{},"百感交集,今天.太复杂,索性不说,说点简单的.",[100,107,108],{},"先说小鬼吧,给我发了信息,等我回电时,你已关机!此种行为另人发指,难以容忍!(靠!外面天居然亮了!)还有小狼,不接电话,简直该死!!!!!猫的失踪可以归结为对北京城的无意识,太茫然,乱了套...77呢????嘛呢?给你三天时间出来!不是威胁啊!!小样的!!!!!怎么看我72般变化你也没个态度????????雪扬好像去了北极?在酷热的此刻对我说舒服的也该打屁股!!!欢子没见到,也不是我的错!谁让三个月你不来偏在杀青那天添乱的?......反正还是想念你们几个老东西!这里的老东西!要不我停博算了??或也像沈佳妮同学般自说自话?也挺好?\n欲练神功 挥剑自宫?\n张歆艺同学此刻睡熟了,她是我们这里唯一马不停蹄的奔向下个岗位的!此女...此女...此女...哎!!!!!!!想到句不得体的话:此物本该天上有,不知何故在人间??还好!庆幸是活了这么大也就遇见一个她!这丫头!又一个......哎!......服了!!祝她好梦吧...",[100,110,111],{},"\"士兵\"们也是该都睡了,一帮好人啊!老康今天也开了!效仿王小丫了!249就更别说了,现在看他居然不猥琐了!其实真挺汉子的,从来不差酒,喝大了也能像单田芳似的吸引着各种拥趸围绕他身边听他布道.外型欠缺说服力本不是他的错,看来人后天的努力才是最重要的...",[100,113,114],{},"得!又呲出去了,也不知哪哪了...反正,今天说到的都是好人,有一个算一个!好人一生平安.不是我说的,大家都这样说.所以就信大家的吧,准没错!大家好才是真的好,也不是我说的.",{"title":116,"searchDepth":117,"depth":117,"links":118},"",2,[],[6],"回到家里,不巧,又有点醉.","md",{"date":123},"2007-07-25 04:39",true,"\u002Fblog\u002Fblog_4af9831b010009j7",{"title":127,"description":120},2046,"blog_4af9831b010009j7","blog\u002Fblog_4af9831b010009j7",[],"NMaLVCFuHOblpIqBpHl7B4KB2eMWizC_PUU-4WlzSE8",[133,138],{"title":134,"path":135,"stem":136,"children":-1,"slug":137},"成才","\u002Fblog\u002Fblog_4af9831b010009in","blog\u002Fblog_4af9831b010009in","blog_4af9831b010009in",{"title":139,"path":140,"stem":141,"children":-1,"slug":142},"祝福77   生日快乐","\u002Fblog\u002Fblog_4af9831b010009jz","blog\u002Fblog_4af9831b010009jz","blog_4af9831b010009jz",1795162026160]
[{"data":1,"prerenderedAt":140},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":73,"blog-post-slug-blog_4af9831b010009j7":90,"surround-blog_4af9831b010009j7":129},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":48,"navLinks":49,"perPage":16,"prevNextIsExcludeDate":69,"site_description":23,"site_name":70,"stem":71,"__hash__":72},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43,45],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{"href":46,"text":47},"https:\u002F\u002Fmzt999.github.io\u002Fportfolio-chensicheng1978","幕后作品集展示(2012-2026)",{},[50,55,59,63,67],{"path":51,"title":52,"target":53,"fa_class":54},"\u002F","博客首页","internal","fa-home",{"path":56,"title":57,"target":53,"fa_class":58},"\u002Fabout","关于","fa-user",{"path":60,"title":61,"target":53,"fa_class":62},"\u002Fpost","归档","fa-archive",{"path":64,"title":65,"target":53,"fa_class":66},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":68,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","LA_7Y82F2zjQ6-R2_tcWHl356krYL76uqQHBCIU8UZk",{"latestBlog":74},[75,78,81,84,87],{"title":76,"slug":77},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":79,"slug":80},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":82,"slug":83},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":85,"slug":86},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":88,"slug":89},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":91,"title":92,"body":93,"categories":116,"description":117,"extension":118,"meta":119,"navigation":121,"path":122,"seo":123,"slug":125,"stem":126,"tags":127,"__hash__":128},"blog\u002Fblog\u002Fblog_4af9831b010009j7.md","2046",{"type":94,"value":95,"toc":112},"minimark",[96,100,103,106,109],[97,98,99],"p",{},"回到家里,不巧,又有点醉.不过该偷笑,比晨儿强,他又吐了!伟大的我是把他送回家才回家回到这里的,索性上来醒酒,反正身边又没别的人...",[97,101,102],{},"百感交集,今天.太复杂,索性不说,说点简单的.",[97,104,105],{},"先说小鬼吧,给我发了信息,等我回电时,你已关机!此种行为另人发指,难以容忍!(靠!外面天居然亮了!)还有小狼,不接电话,简直该死!!!!!猫的失踪可以归结为对北京城的无意识,太茫然,乱了套...77呢????嘛呢?给你三天时间出来!不是威胁啊!!小样的!!!!!怎么看我72般变化你也没个态度????????雪扬好像去了北极?在酷热的此刻对我说舒服的也该打屁股!!!欢子没见到,也不是我的错!谁让三个月你不来偏在杀青那天添乱的?......反正还是想念你们几个老东西!这里的老东西!要不我停博算了??或也像沈佳妮同学般自说自话?也挺好?\n欲练神功 挥剑自宫?\n张歆艺同学此刻睡熟了,她是我们这里唯一马不停蹄的奔向下个岗位的!此女...此女...此女...哎!!!!!!!想到句不得体的话:此物本该天上有,不知何故在人间??还好!庆幸是活了这么大也就遇见一个她!这丫头!又一个......哎!......服了!!祝她好梦吧...",[97,107,108],{},"\"士兵\"们也是该都睡了,一帮好人啊!老康今天也开了!效仿王小丫了!249就更别说了,现在看他居然不猥琐了!其实真挺汉子的,从来不差酒,喝大了也能像单田芳似的吸引着各种拥趸围绕他身边听他布道.外型欠缺说服力本不是他的错,看来人后天的努力才是最重要的...",[97,110,111],{},"得!又呲出去了,也不知哪哪了...反正,今天说到的都是好人,有一个算一个!好人一生平安.不是我说的,大家都这样说.所以就信大家的吧,准没错!大家好才是真的好,也不是我说的.",{"title":113,"searchDepth":114,"depth":114,"links":115},"",2,[],[6],"回到家里,不巧,又有点醉.","md",{"date":120},"2007-07-25 04:39",true,"\u002Fblog\u002Fblog_4af9831b010009j7",{"title":124,"description":117},2046,"blog_4af9831b010009j7","blog\u002Fblog_4af9831b010009j7",[],"NMaLVCFuHOblpIqBpHl7B4KB2eMWizC_PUU-4WlzSE8",[130,135],{"title":131,"path":132,"stem":133,"children":-1,"slug":134},"成才","\u002Fblog\u002Fblog_4af9831b010009in","blog\u002Fblog_4af9831b010009in","blog_4af9831b010009in",{"title":136,"path":137,"stem":138,"children":-1,"slug":139},"祝福77   生日快乐","\u002Fblog\u002Fblog_4af9831b010009jz","blog\u002Fblog_4af9831b010009jz","blog_4af9831b010009jz",1794760532448]
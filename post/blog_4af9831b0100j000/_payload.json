[{"data":1,"prerenderedAt":124},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b0100j000":31,"surround-blog_4af9831b0100j000":117},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",152,{"name":9,"len":10},"有图",34,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":23,"body":33,"categories":106,"description":23,"extension":107,"meta":108,"navigation":110,"path":111,"seo":112,"slug":24,"stem":113,"tags":114,"__hash__":116},"blog\u002Fblog\u002Fblog_4af9831b0100j000.md",{"type":34,"value":35,"toc":102},"minimark",[36,40,43,46,52,57,60,63,66,71,76,81,86,89,92,97],[37,38,39],"p",{},"《爱是一颗幸福的子弹》快播完了，看着曾经的作品，心情抑制不住的激荡...",[37,41,42],{},"好吧，此刻就让我们试着一起回忆……",[37,44,45],{},"耳边，回荡着的“子弹”的插曲，再一次把我带回了那个夏天。",[37,47,48],{},[49,50],"img",{"alt":23,"src":51},"\u002Fpic\u002F4af9831bt86f5fae9a495.jpg",[37,53,54],{},[49,55],{"alt":23,"src":56},"\u002Fpic\u002F4af9831bt86f5fb8232c6.jpg",[37,58,59],{},"湘江边的空气中总有一种青草的味道，风懒洋洋的盖在身上，我们坐在岸边，没有话语，一切如你眼波般安详……夕阳，如一副油墨画，把我们和对岸染成了金黄……光芒中，你们几个的脸上都挂着浅浅的笑，同样出神的遥望远方，不知在醉着什么……那美好忽让我感伤，要能永远这样多好，青春便可不老……我想。远处的汽笛声踟蹰而至，伴随我目光悠然前行的旧船便把一切带进了故事……",[37,61,62],{},"那是80年代，远比我们此刻的世界浓郁简单澄净……那是可以手牵手在岸边相对无语从清晨到日落的岁月，那是诗歌伴随着口琴声和白衬衫在风中飘扬的日子，那是炙热的情欲裹杂在羞涩的表达懵懂的情感与满心的期盼和憧憬的年代，那时的我们，无论欣喜或感伤都是如此无尘……",[37,64,65],{},"眼泪，是成长的代价。如哪天，你的泪不再流了，想说，那不是你大了，而是，你的心已经死了。",[37,67,68],{},[49,69],{"alt":23,"src":70},"\u002Fpic\u002F4af9831bt86f5fe30d6f2.jpg",[37,72,73],{},[49,74],{"alt":23,"src":75},"\u002Fpic\u002F4af9831bt86f5fcf06d74.jpg",[37,77,78],{},[49,79],{"alt":23,"src":80},"\u002Fpic\u002F4af9831bt86f5fbfc4632.jpg",[37,82,83],{},[49,84],{"alt":23,"src":85},"\u002Fpic\u002F4af9831bt86f5fc764347.jpg",[37,87,88],{},"“子弹”这个戏也许真的是名字不好吧，才会如此多舛。三年后，才在这样的一个时段播出。但我想，“子弹”的纯净和不同是有违绝大部分影视剧的，她会让所有“有心人”都过目难忘……尤其是我们，被“子弹”穿越的我们，每一个人对这部作品的情感都是深刻而异样的。",[37,90,91],{},"爱，是一颗幸福的子弹！被它击中，幸或不幸答案会有不同。所幸，有这样的一个夜晚，这样的一个契机，我可以时隔三年后，重温那如梦的五月，并再一次问问自己……我是否仍有身躯去迎接那幸福的死亡？……",[37,93,94],{},[49,95],{"alt":23,"src":96},"\u002Fpic\u002F4af9831bt86f5fd88f90d.jpg",[37,98,99],{},[49,100],{"alt":23,"src":101},"\u002Fpic\u002F4af9831bt86f5fa04aa68.jpg",{"title":103,"searchDepth":104,"depth":104,"links":105},"",2,[],[6,9],"md",{"date":109},"2010-06-03 16:45",true,"\u002Fblog\u002Fblog_4af9831b0100j000",{"title":23,"description":23},"blog\u002Fblog_4af9831b0100j000",[115],"娱乐","0BIMsQn6CRksom-mGwyy9uE8koZFXfCn0MP4hhvOr1o",[118,121],{"title":26,"path":119,"stem":120,"children":-1,"slug":27},"\u002Fblog\u002Fblog_4af9831b0100i4l0","blog\u002Fblog_4af9831b0100i4l0",{"title":20,"path":122,"stem":123,"children":-1,"slug":21},"\u002Fblog\u002Fblog_4af9831b0100kany","blog\u002Fblog_4af9831b0100kany",1793872627067]
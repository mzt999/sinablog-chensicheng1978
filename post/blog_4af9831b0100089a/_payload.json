[{"data":1,"prerenderedAt":123},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":17,"blog-post-slug-blog_4af9831b0100089a":34,"surround-blog_4af9831b0100089a":112},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"latestBlog":18},[19,22,25,28,31],{"title":20,"slug":21},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":23,"slug":24},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":26,"slug":27},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":29,"slug":30},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":32,"slug":33},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":35,"title":36,"body":37,"categories":101,"description":52,"extension":102,"meta":103,"navigation":105,"path":106,"seo":107,"slug":108,"stem":109,"tags":110,"__hash__":111},"blog\u002Fblog\u002Fblog_4af9831b0100089a.md","也许,放弃调侃,夭折了念头,在了,",{"type":38,"value":39,"toc":97},"minimark",[40,47,53,58,63,68,73,78,83,88,94],[41,42,43],"p",{},[44,45],"a",{"href":46},"file:\u002F\u002F\u002FC:\u002FDocuments%20and%20Settings\u002Fjj\u002F%C3%97%C3%80%C3%83%C3%A6\u002Fyong%201.bmp",[41,48,49],{},[50,51,52],"em",{},"刚刚转贴了一个叫\"业余弗洛依德\"的朋友的帖子,因为实在觉得有趣.看你说的话,好象不业余啊?",[41,54,55],{},[50,56,57],{},"这两天湖南连雨,所以上来的时间可能会多点了.11点了快,走廊里居然有几个人在跳绳,全是拜我所赐.我在状态和心情好的时候会引导剧组的同志走向运动的光明大道...但也有很糟的时候会引领别的剧组的同僚酗酒胡闹...以前太任性了我,以后,俺改.",[41,59,60],{},[50,61,62],{},"今天说点什么呢?留言还是没有勇气回...为什么,你们懂吗?",[41,64,65],{},[50,66,67],{},"刚刚吃饭的时候和大大大师妹言辞激烈的辩驳了许久关于\"爱情\"的这个话题...不同的看法现在想想只能说明我们还年轻.我们的口中还会有这个词,还会为了它真正的意义和最终的归属而发表不同的见解,不说谁对谁错,只能说明我们都还没对\"爱情\"失望或不屑.我们还年轻,只有年轻才会说这个词,对吧.",[41,69,70],{},[50,71,72],{},"发现今天的自己不知该说些什么.词穷.我总是这样,像段誉的六脉神剑...有时绵绵不绝到自己都觉得自己话唠,有时却真的...汗颜.",[41,74,75],{},[50,76,77],{},"又有写的了.有人在幸福的通着电话,爱人的电话...可我很怀疑,是否我们都明白什么是真正的爱情...",[41,79,80],{},[50,81,82],{},"爱情如鬼魂,我们都听过,可谁真正的见过?你?还是我?...",[41,84,85],{},[50,86,87],{},"不说了,说不下去了.干该干的事去了...",[41,89,90,92],{},[44,91],{"href":46},[44,93,46],{"href":46},[41,95,96],{},"六个点......",{"title":98,"searchDepth":99,"depth":99,"links":100},"",2,[],[6],"md",{"date":104},"2007-04-28 00:01",true,"\u002Fblog\u002Fblog_4af9831b0100089a",{"title":36,"description":52},"blog_4af9831b0100089a","blog\u002Fblog_4af9831b0100089a",[],"m_QsZzthR5b8BYiiDUqcJUF8i9n74WMMXqk6QJZlTb0",[113,118],{"title":114,"path":115,"stem":116,"children":-1,"slug":117},"zhuan tie","\u002Fblog\u002Fblog_4af9831b01000899","blog\u002Fblog_4af9831b01000899","blog_4af9831b01000899",{"title":119,"path":120,"stem":121,"children":-1,"slug":122},"节日快乐","\u002Fblog\u002Fblog_4af9831b010008bh","blog\u002Fblog_4af9831b010008bh","blog_4af9831b010008bh",1794043806039]
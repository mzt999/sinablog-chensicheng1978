[{"data":1,"prerenderedAt":101},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b0100089a":31,"surround-blog_4af9831b0100089a":90},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",151,{"name":9,"len":10},"有图",34,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":79,"description":33,"extension":80,"meta":81,"navigation":83,"path":84,"seo":85,"slug":86,"stem":87,"tags":88,"__hash__":89},"blog\u002Fblog\u002Fblog_4af9831b0100089a.md","也许,放弃调侃,夭折了念头,在了,",{"type":35,"value":36,"toc":75},"minimark",[37,45,48,51,54,57,60,63,66,72],[38,39,40,44],"p",{},[41,42],"a",{"href":43},"file:\u002F\u002F\u002FC:\u002FDocuments%20and%20Settings\u002Fjj\u002F%C3%97%C3%80%C3%83%C3%A6\u002Fyong%201.bmp","\n刚刚转贴了一个叫\"业余弗洛依德\"的朋友的帖子,因为实在觉得有趣.看你说的话,好象不业余啊?",[38,46,47],{},"这两天湖南连雨,所以上来的时间可能会多点了.11点了快,走廊里居然有几个人在跳绳,全是拜我所赐.我在状态和心情好的时候会引导剧组的同志走向运动的光明大道...但也有很糟的时候会引领别的剧组的同僚酗酒胡闹...以前太任性了我,以后,俺改.",[38,49,50],{},"今天说点什么呢?留言还是没有勇气回...为什么,你们懂吗?",[38,52,53],{},"刚刚吃饭的时候和大大大师妹言辞激烈的辩驳了许久关于\"爱情\"的这个话题...不同的看法现在想想只能说明我们还年轻.我们的口中还会有这个词,还会为了它真正的意义和最终的归属而发表不同的见解,不说谁对谁错,只能说明我们都还没对\"爱情\"失望或不屑.我们还年轻,只有年轻才会说这个词,对吧.",[38,55,56],{},"发现今天的自己不知该说些什么.词穷.我总是这样,像段誉的六脉神剑...有时绵绵不绝到自己都觉得自己话唠,有时却真的...汗颜.",[38,58,59],{},"又有写的了.有人在幸福的通着电话,爱人的电话...可我很怀疑,是否我们都明白什么是真正的爱情...",[38,61,62],{},"爱情如鬼魂,我们都听过,可谁真正的见过?你?还是我?...",[38,64,65],{},"不说了,说不下去了.干该干的事去了...",[38,67,68,70],{},[41,69],{"href":43},[41,71,43],{"href":43},[38,73,74],{},"六个点......",{"title":76,"searchDepth":77,"depth":77,"links":78},"",2,[],[6],"md",{"date":82},"2007-04-28 00:01",true,"\u002Fblog\u002Fblog_4af9831b0100089a",{"title":33,"description":33},"blog_4af9831b0100089a","blog\u002Fblog_4af9831b0100089a",[],"XpH0lQriylM_4IJRDS_aMXk_o1kWSYB9ciaTokaLIG8",[91,96],{"title":92,"path":93,"stem":94,"children":-1,"slug":95},"zhuan tie","\u002Fblog\u002Fblog_4af9831b01000899","blog\u002Fblog_4af9831b01000899","blog_4af9831b01000899",{"title":97,"path":98,"stem":99,"children":-1,"slug":100},"节日快乐","\u002Fblog\u002Fblog_4af9831b010008bh","blog\u002Fblog_4af9831b010008bh","blog_4af9831b010008bh",1793800807861]
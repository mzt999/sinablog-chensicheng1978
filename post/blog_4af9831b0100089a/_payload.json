[{"data":1,"prerenderedAt":120},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b0100089a":31,"surround-blog_4af9831b0100089a":109},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",152,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":98,"description":33,"extension":99,"meta":100,"navigation":102,"path":103,"seo":104,"slug":105,"stem":106,"tags":107,"__hash__":108},"blog\u002Fblog\u002Fblog_4af9831b0100089a.md","也许,放弃调侃,夭折了念头,在了,",{"type":35,"value":36,"toc":94},"minimark",[37,44,50,55,60,65,70,75,80,85,91],[38,39,40],"p",{},[41,42],"a",{"href":43},"file:\u002F\u002F\u002FC:\u002FDocuments%20and%20Settings\u002Fjj\u002F%C3%97%C3%80%C3%83%C3%A6\u002Fyong%201.bmp",[38,45,46],{},[47,48,49],"em",{},"刚刚转贴了一个叫\"业余弗洛依德\"的朋友的帖子,因为实在觉得有趣.看你说的话,好象不业余啊?",[38,51,52],{},[47,53,54],{},"这两天湖南连雨,所以上来的时间可能会多点了.11点了快,走廊里居然有几个人在跳绳,全是拜我所赐.我在状态和心情好的时候会引导剧组的同志走向运动的光明大道...但也有很糟的时候会引领别的剧组的同僚酗酒胡闹...以前太任性了我,以后,俺改.",[38,56,57],{},[47,58,59],{},"今天说点什么呢?留言还是没有勇气回...为什么,你们懂吗?",[38,61,62],{},[47,63,64],{},"刚刚吃饭的时候和大大大师妹言辞激烈的辩驳了许久关于\"爱情\"的这个话题...不同的看法现在想想只能说明我们还年轻.我们的口中还会有这个词,还会为了它真正的意义和最终的归属而发表不同的见解,不说谁对谁错,只能说明我们都还没对\"爱情\"失望或不屑.我们还年轻,只有年轻才会说这个词,对吧.",[38,66,67],{},[47,68,69],{},"发现今天的自己不知该说些什么.词穷.我总是这样,像段誉的六脉神剑...有时绵绵不绝到自己都觉得自己话唠,有时却真的...汗颜.",[38,71,72],{},[47,73,74],{},"又有写的了.有人在幸福的通着电话,爱人的电话...可我很怀疑,是否我们都明白什么是真正的爱情...",[38,76,77],{},[47,78,79],{},"爱情如鬼魂,我们都听过,可谁真正的见过?你?还是我?...",[38,81,82],{},[47,83,84],{},"不说了,说不下去了.干该干的事去了...",[38,86,87,89],{},[41,88],{"href":43},[41,90,43],{"href":43},[38,92,93],{},"六个点......",{"title":95,"searchDepth":96,"depth":96,"links":97},"",2,[],[6],"md",{"date":101},"2007-04-28 00:01",true,"\u002Fblog\u002Fblog_4af9831b0100089a",{"title":33,"description":33},"blog_4af9831b0100089a","blog\u002Fblog_4af9831b0100089a",[],"ueI-InpKuyziOB_y7LbYtTHJcqduLFSz6l2WEoz0tJo",[110,115],{"title":111,"path":112,"stem":113,"children":-1,"slug":114},"zhuan tie","\u002Fblog\u002Fblog_4af9831b01000899","blog\u002Fblog_4af9831b01000899","blog_4af9831b01000899",{"title":116,"path":117,"stem":118,"children":-1,"slug":119},"节日快乐","\u002Fblog\u002Fblog_4af9831b010008bh","blog\u002Fblog_4af9831b010008bh","blog_4af9831b010008bh",1793968538596]
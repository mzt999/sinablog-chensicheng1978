[{"data":1,"prerenderedAt":164},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":58,"blog-post-slug-blog_4af9831b0100089a":75,"surround-blog_4af9831b0100089a":153},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":54,"site_description":55,"stem":56,"__hash__":57},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo",20,"新浪博客内容备份","settings","hh8X7X6SFDoeJrxIJ4yisZXSc3HwHM1zk206jiQX2XU",{"latestBlog":59},[60,63,66,69,72],{"title":61,"slug":62},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":64,"slug":65},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":67,"slug":68},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":70,"slug":71},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":73,"slug":74},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":76,"title":77,"body":78,"categories":142,"description":93,"extension":143,"meta":144,"navigation":146,"path":147,"seo":148,"slug":149,"stem":150,"tags":151,"__hash__":152},"blog\u002Fblog\u002Fblog_4af9831b0100089a.md","也许,放弃调侃,夭折了念头,在了,",{"type":79,"value":80,"toc":138},"minimark",[81,88,94,99,104,109,114,119,124,129,135],[82,83,84],"p",{},[85,86],"a",{"href":87},"file:\u002F\u002F\u002FC:\u002FDocuments%20and%20Settings\u002Fjj\u002F%C3%97%C3%80%C3%83%C3%A6\u002Fyong%201.bmp",[82,89,90],{},[91,92,93],"em",{},"刚刚转贴了一个叫\"业余弗洛依德\"的朋友的帖子,因为实在觉得有趣.看你说的话,好象不业余啊?",[82,95,96],{},[91,97,98],{},"这两天湖南连雨,所以上来的时间可能会多点了.11点了快,走廊里居然有几个人在跳绳,全是拜我所赐.我在状态和心情好的时候会引导剧组的同志走向运动的光明大道...但也有很糟的时候会引领别的剧组的同僚酗酒胡闹...以前太任性了我,以后,俺改.",[82,100,101],{},[91,102,103],{},"今天说点什么呢?留言还是没有勇气回...为什么,你们懂吗?",[82,105,106],{},[91,107,108],{},"刚刚吃饭的时候和大大大师妹言辞激烈的辩驳了许久关于\"爱情\"的这个话题...不同的看法现在想想只能说明我们还年轻.我们的口中还会有这个词,还会为了它真正的意义和最终的归属而发表不同的见解,不说谁对谁错,只能说明我们都还没对\"爱情\"失望或不屑.我们还年轻,只有年轻才会说这个词,对吧.",[82,110,111],{},[91,112,113],{},"发现今天的自己不知该说些什么.词穷.我总是这样,像段誉的六脉神剑...有时绵绵不绝到自己都觉得自己话唠,有时却真的...汗颜.",[82,115,116],{},[91,117,118],{},"又有写的了.有人在幸福的通着电话,爱人的电话...可我很怀疑,是否我们都明白什么是真正的爱情...",[82,120,121],{},[91,122,123],{},"爱情如鬼魂,我们都听过,可谁真正的见过?你?还是我?...",[82,125,126],{},[91,127,128],{},"不说了,说不下去了.干该干的事去了...",[82,130,131,133],{},[85,132],{"href":87},[85,134,87],{"href":87},[82,136,137],{},"六个点......",{"title":139,"searchDepth":140,"depth":140,"links":141},"",2,[],[6],"md",{"date":145},"2007-04-28 00:01",true,"\u002Fblog\u002Fblog_4af9831b0100089a",{"title":77,"description":93},"blog_4af9831b0100089a","blog\u002Fblog_4af9831b0100089a",[],"m_QsZzthR5b8BYiiDUqcJUF8i9n74WMMXqk6QJZlTb0",[154,159],{"title":155,"path":156,"stem":157,"children":-1,"slug":158},"zhuan tie","\u002Fblog\u002Fblog_4af9831b01000899","blog\u002Fblog_4af9831b01000899","blog_4af9831b01000899",{"title":160,"path":161,"stem":162,"children":-1,"slug":163},"节日快乐","\u002Fblog\u002Fblog_4af9831b010008bh","blog\u002Fblog_4af9831b010008bh","blog_4af9831b010008bh",1794412501266]
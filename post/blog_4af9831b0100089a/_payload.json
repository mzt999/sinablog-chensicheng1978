[{"data":1,"prerenderedAt":179},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":73,"blog-post-slug-blog_4af9831b0100089a":90,"surround-blog_4af9831b0100089a":168},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":48,"navLinks":49,"perPage":16,"prevNextIsExcludeDate":69,"site_description":23,"site_name":70,"stem":71,"__hash__":72},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43,45],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{"href":46,"text":47},"https:\u002F\u002Fmzt999.github.io\u002Fportfolio-chensicheng1978","幕后作品集展示(2012-2026)",{},[50,55,59,63,67],{"path":51,"title":52,"target":53,"fa_class":54},"\u002F","博客首页","internal","fa-home",{"path":56,"title":57,"target":53,"fa_class":58},"\u002Fabout","关于","fa-user",{"path":60,"title":61,"target":53,"fa_class":62},"\u002Fpost","归档","fa-archive",{"path":64,"title":65,"target":53,"fa_class":66},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":68,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","LA_7Y82F2zjQ6-R2_tcWHl356krYL76uqQHBCIU8UZk",{"latestBlog":74},[75,78,81,84,87],{"title":76,"slug":77},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":79,"slug":80},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":82,"slug":83},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":85,"slug":86},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":88,"slug":89},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":91,"title":92,"body":93,"categories":157,"description":108,"extension":158,"meta":159,"navigation":161,"path":162,"seo":163,"slug":164,"stem":165,"tags":166,"__hash__":167},"blog\u002Fblog\u002Fblog_4af9831b0100089a.md","也许,放弃调侃,夭折了念头,在了,",{"type":94,"value":95,"toc":153},"minimark",[96,103,109,114,119,124,129,134,139,144,150],[97,98,99],"p",{},[100,101],"a",{"href":102},"file:\u002F\u002F\u002FC:\u002FDocuments%20and%20Settings\u002Fjj\u002F%C3%97%C3%80%C3%83%C3%A6\u002Fyong%201.bmp",[97,104,105],{},[106,107,108],"em",{},"刚刚转贴了一个叫\"业余弗洛依德\"的朋友的帖子,因为实在觉得有趣.看你说的话,好象不业余啊?",[97,110,111],{},[106,112,113],{},"这两天湖南连雨,所以上来的时间可能会多点了.11点了快,走廊里居然有几个人在跳绳,全是拜我所赐.我在状态和心情好的时候会引导剧组的同志走向运动的光明大道...但也有很糟的时候会引领别的剧组的同僚酗酒胡闹...以前太任性了我,以后,俺改.",[97,115,116],{},[106,117,118],{},"今天说点什么呢?留言还是没有勇气回...为什么,你们懂吗?",[97,120,121],{},[106,122,123],{},"刚刚吃饭的时候和大大大师妹言辞激烈的辩驳了许久关于\"爱情\"的这个话题...不同的看法现在想想只能说明我们还年轻.我们的口中还会有这个词,还会为了它真正的意义和最终的归属而发表不同的见解,不说谁对谁错,只能说明我们都还没对\"爱情\"失望或不屑.我们还年轻,只有年轻才会说这个词,对吧.",[97,125,126],{},[106,127,128],{},"发现今天的自己不知该说些什么.词穷.我总是这样,像段誉的六脉神剑...有时绵绵不绝到自己都觉得自己话唠,有时却真的...汗颜.",[97,130,131],{},[106,132,133],{},"又有写的了.有人在幸福的通着电话,爱人的电话...可我很怀疑,是否我们都明白什么是真正的爱情...",[97,135,136],{},[106,137,138],{},"爱情如鬼魂,我们都听过,可谁真正的见过?你?还是我?...",[97,140,141],{},[106,142,143],{},"不说了,说不下去了.干该干的事去了...",[97,145,146,148],{},[100,147],{"href":102},[100,149,102],{"href":102},[97,151,152],{},"六个点......",{"title":154,"searchDepth":155,"depth":155,"links":156},"",2,[],[6],"md",{"date":160},"2007-04-28 00:01",true,"\u002Fblog\u002Fblog_4af9831b0100089a",{"title":92,"description":108},"blog_4af9831b0100089a","blog\u002Fblog_4af9831b0100089a",[],"m_QsZzthR5b8BYiiDUqcJUF8i9n74WMMXqk6QJZlTb0",[169,174],{"title":170,"path":171,"stem":172,"children":-1,"slug":173},"zhuan tie","\u002Fblog\u002Fblog_4af9831b01000899","blog\u002Fblog_4af9831b01000899","blog_4af9831b01000899",{"title":175,"path":176,"stem":177,"children":-1,"slug":178},"节日快乐","\u002Fblog\u002Fblog_4af9831b010008bh","blog\u002Fblog_4af9831b010008bh","blog_4af9831b010008bh",1794760532549]
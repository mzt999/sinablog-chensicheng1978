},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":88,"slug":89},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":91,"slug":92},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":94,"title":95,"body":96,"categories":158,"description":102,"extension":159,"meta":160,"navigation":162,"path":163,"seo":164,"slug":165,"stem":166,"tags":167,"__hash__":168},"blog\u002Fblog\u002Fblog_4af9831b010008bh.md","节日快乐",{"type":97,"value":98,"toc":154},"minimark",[99,110,122,128,137,146,152],[100,101,102,103,106,107,109],"p",{},"有人走了 回家了 说是为了亲情",[104,105],"br",{},"\n有人也走了 另个城市了 说是为了爱情",[104,108],{},"\n  我还在坚守 在节日里 不为什么 为自己",[100,111,112,113,115,116,118,119,121],{},"  组里的一些变动让我郁闷万分 为何美好总会被冲淡",[104,114],{},"\n  期望我们的领导早点回来 那个和我很像的 执着 任性 梦想不灭 又容易受伤的",[104,117],{},"\n  孩子",[104,120],{},"\n  早点回到我们身边",[100,123,124,125,127],{},"  没有这个孩子",[104,126],{},"\n  子弹将是被弹弓射出去的",[100,129,130,131,133,134,136],{},"  我也是个孩子",[104,132],{},"\n  节日让我想家",[104,135],{},"\n  想爸爸 妈妈",[100,138,139,140,142,143,145],{},"  第三个师妹的电脑 她正没心没肺的和另个女孩玩自拍",[104,141],{},"\n  没有戏拍的日子 平淡",[104,144],{},"\n  但换做节日 就 伤感",[100,147,148,149,151],{},"  勇敢下去吧 在奔跑的孩子们",[104,150],{},"\n祝此刻所有不在爱人家人身边的孩子",[100,153,95],{},{"title":155,"searchDepth":156,"depth":156,"links":157},"",2,[],[6],"md",{"date":161},"2007-05-02 17:59",true,"\u002Fblog\u002Fblog_4af9831b010008bh",{"title":95,"description":102},"blog_4af9831b010008bh","blog\u002Fblog_4af9831b010008bh",[],"0eqkH5VT89_LXmLjChs51mTU0chCpEG_bWUdguAqOHM",[170,175],{"title":171,"path":172,"stem":173,"children":-1,"slug":174},"也许,放弃调侃,夭折了念头,在了,","\u002Fblog\u002Fblog_4af9831b0100089a","blog\u002Fblog_4af9831b0100089a","blog_4af9831b0100089a",{"title":176,"path":177,"stem":178,"children":-1,"slug":179},"不疯魔 不成活","\u002Fblog\u002Fblog_4af9831b010008dh","blog\u002Fblog_4af9831b010008dh","blog_4af9831b010008dh",1795162026242]
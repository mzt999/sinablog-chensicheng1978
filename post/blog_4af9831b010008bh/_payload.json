":89,"body":90,"categories":152,"description":96,"extension":153,"meta":154,"navigation":156,"path":157,"seo":158,"slug":159,"stem":160,"tags":161,"__hash__":162},"blog\u002Fblog\u002Fblog_4af9831b010008bh.md","节日快乐",{"type":91,"value":92,"toc":148},"minimark",[93,104,116,122,131,140,146],[94,95,96,97,100,101,103],"p",{},"有人走了 回家了 说是为了亲情",[98,99],"br",{},"\n有人也走了 另个城市了 说是为了爱情",[98,102],{},"\n  我还在坚守 在节日里 不为什么 为自己",[94,105,106,107,109,110,112,113,115],{},"  组里的一些变动让我郁闷万分 为何美好总会被冲淡",[98,108],{},"\n  期望我们的领导早点回来 那个和我很像的 执着 任性 梦想不灭 又容易受伤的",[98,111],{},"\n  孩子",[98,114],{},"\n  早点回到我们身边",[94,117,118,119,121],{},"  没有这个孩子",[98,120],{},"\n  子弹将是被弹弓射出去的",[94,123,124,125,127,128,130],{},"  我也是个孩子",[98,126],{},"\n  节日让我想家",[98,129],{},"\n  想爸爸 妈妈",[94,132,133,134,136,137,139],{},"  第三个师妹的电脑 她正没心没肺的和另个女孩玩自拍",[98,135],{},"\n  没有戏拍的日子 平淡",[98,138],{},"\n  但换做节日 就 伤感",[94,141,142,143,145],{},"  勇敢下去吧 在奔跑的孩子们",[98,144],{},"\n祝此刻所有不在爱人家人身边的孩子",[94,147,89],{},{"title":149,"searchDepth":150,"depth":150,"links":151},"",2,[],[6],"md",{"date":155},"2007-05-02 17:59",true,"\u002Fblog\u002Fblog_4af9831b010008bh",{"title":89,"description":96},"blog_4af9831b010008bh","blog\u002Fblog_4af9831b010008bh",[],"0eqkH5VT89_LXmLjChs51mTU0chCpEG_bWUdguAqOHM",[164,169],{"title":165,"path":166,"stem":167,"children":-1,"slug":168},"也许,放弃调侃,夭折了念头,在了,","\u002Fblog\u002Fblog_4af9831b0100089a","blog\u002Fblog_4af9831b0100089a","blog_4af9831b0100089a",{"title":170,"path":171,"stem":172,"children":-1,"slug":173},"不疯魔 不成活","\u002Fblog\u002Fblog_4af9831b010008dh","blog\u002Fblog_4af9831b010008dh","blog_4af9831b010008dh",1794544668113]
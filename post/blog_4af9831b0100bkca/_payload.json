[{"data":1,"prerenderedAt":145},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":70,"blog-post-slug-blog_4af9831b0100bkca":87,"surround-blog_4af9831b0100bkca":134},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":45,"navLinks":46,"perPage":16,"prevNextIsExcludeDate":66,"site_description":23,"site_name":67,"stem":68,"__hash__":69},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{},[47,52,56,60,64],{"path":48,"title":49,"target":50,"fa_class":51},"\u002F","博客首页","internal","fa-home",{"path":53,"title":54,"target":50,"fa_class":55},"\u002Fabout","关于","fa-user",{"path":57,"title":58,"target":50,"fa_class":59},"\u002Fpost","归档","fa-archive",{"path":61,"title":62,"target":50,"fa_class":63},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":65,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","jvZHccz2rT-wjVS5GCPgWyhl8WnBIvECPkE5KpKFKCU",{"latestBlog":71},[72,75,78,81,84],{"title":73,"slug":74},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":76,"slug":77},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":79,"slug":80},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":82,"slug":83},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":85,"slug":86},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":88,"title":89,"body":90,"categories":122,"description":111,"extension":123,"meta":124,"navigation":126,"path":127,"seo":128,"slug":129,"stem":130,"tags":131,"__hash__":133},"blog\u002Fblog\u002Fblog_4af9831b0100bkca.md","长相守",{"type":91,"value":92,"toc":118},"minimark",[93,97,100,103,106,109,112,115],[94,95,96],"p",{},"兰小龙同学借用袁朗和老段的嘴说出了句迄今为止最让我感同身受的台词：长相守，是个考验。",[94,98,99],{},"“命运”暂时告一段落，但我信，后面还有故事。",[94,101,102],{},"深圳的驻地没有网线，致使此地长草，今夜偶眠郑州，得以做回园丁。",[94,104,105],{},"关于“命运”，感言过密，以至词穷。就如你真爱上一个人，千言万语都会只化做一句“我爱你”。",[94,107,108],{},"现抄录白天“资方老爸”的“命题作文”，留做纪念。",[94,110,111],{},"《小陈同学参与创作“命运”的小小感言》",[94,113,114],{},"曾几何时就“宿命论”和朋友有过数次激辩。但共识必有其一：人无论唯物或唯心，无论有无信仰或信仰为何，可“命运”这两个字却是万生万物都逃不过的……不知来世不问往生这辈子的我的命运是注定要和“命运”有次深刻的交融的。在我的少年梦里，侠之大者为国为民，感谢命运让我活在中国这风云激荡的30年里，让我见证共同成长。更感谢“命运”一剧让我亲历，为国家民族的再次崛起尽一份绵薄……感激命运的馈赠能相识同为“命运”集结下的你们，我信这是不止五百年前的同船渡。因为我们齐心协力在重塑着一座共和国的丰碑……我们会被时间记载历史汲取……我深信因为“命运”此生已不枉生……",[94,116,117],{},"我想，长相守，不仅是个考验。更该是命运。",{"title":119,"searchDepth":120,"depth":120,"links":121},"",2,[],[6],"md",{"date":125},"2008-12-16 23:28",true,"\u002Fblog\u002Fblog_4af9831b0100bkca",{"title":89,"description":111},"blog_4af9831b0100bkca","blog\u002Fblog_4af9831b0100bkca",[132],"杂谈","F6Z3Cs6wwN7Q9SJtgpOvxX7CdjBUNzlDCjk-wkRNkwU",[135,140],{"title":136,"path":137,"stem":138,"children":-1,"slug":139},"坚硬的柔软","\u002Fblog\u002Fblog_4af9831b0100b4mx","blog\u002Fblog_4af9831b0100b4mx","blog_4af9831b0100b4mx",{"title":141,"path":142,"stem":143,"children":-1,"slug":144},"生个蛋吧","\u002Fblog\u002Fblog_4af9831b0100bo3d","blog\u002Fblog_4af9831b0100bo3d","blog_4af9831b0100bo3d",1794546769681]
[{"data":1,"prerenderedAt":177},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":73,"blog-post-slug-blog_4af9831b010009nt":90,"surround-blog_4af9831b010009nt":166},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":48,"navLinks":49,"perPage":16,"prevNextIsExcludeDate":69,"site_description":23,"site_name":70,"stem":71,"__hash__":72},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43,45],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{"href":46,"text":47},"https:\u002F\u002Fmzt999.github.io\u002Fportfolio-chensicheng1978","幕后作品集展示(2012-2026)",{},[50,55,59,63,67],{"path":51,"title":52,"target":53,"fa_class":54},"\u002F","博客首页","internal","fa-home",{"path":56,"title":57,"target":53,"fa_class":58},"\u002Fabout","关于","fa-user",{"path":60,"title":61,"target":53,"fa_class":62},"\u002Fpost","归档","fa-archive",{"path":64,"title":65,"target":53,"fa_class":66},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":68,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","LA_7Y82F2zjQ6-R2_tcWHl356krYL76uqQHBCIU8UZk",{"latestBlog":74},[75,78,81,84,87],{"title":76,"slug":77},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":79,"slug":80},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":82,"slug":83},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":85,"slug":86},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":88,"slug":89},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":91,"title":92,"body":93,"categories":155,"description":99,"extension":156,"meta":157,"navigation":159,"path":160,"seo":161,"slug":162,"stem":163,"tags":164,"__hash__":165},"blog\u002Fblog\u002Fblog_4af9831b010009nt.md","下楼 吃饭",{"type":94,"value":95,"toc":151},"minimark",[96,100,103,106,109,112,115,118,121,124,127,130,133,136,139,142,145,148],[97,98,99],"p",{},"刚从重庆回来,昨天.",[97,101,102],{},"这几天将会面临几个重大的\"谈判\",其中的一个或两个又会影响我很久乃至一生.",[97,104,105],{},"请祝我好运.",[97,107,108],{},"总觉得是在迷雾中行走,还好,身边有几个朋友...",[97,110,111],{},"能陪我醉,可以接受我的任性和放纵.",[97,113,114],{},"真是觉得我们生活的世界挺虚幻的,身边的人们穿梭游走,面目时而清晰时而模糊...",[97,116,117],{},"昨夜,陪人又看了两集\"民工\",三年前的事,说远不远,怎么竟会有已是百年的感觉?",[97,119,120],{},"那时的康导,那时的张译,那时的我...",[97,122,123],{},"有位同志很认真的对我说,希望我再厚重些,再隐忍些,再深邃些,再沉默些...",[97,125,126],{},"那些是表象,是方式,是外化.",[97,128,129],{},"其中自己的成长,艰辛,与痛苦,自知.",[97,131,132],{},"一位大师对告诉他弟子的一段话,被我牢记.因为此大师的弟子总是有同样的毛病:要学会谦卑,学会把傲气埋在心里,让一个个鲜活的人物去傲视世界,你要躲在后面笑,那是最得意的,懂吗?傻X!",[97,134,135],{},"(对了,在此招呼下\"业余弗洛依德\",因为实在很想和你多聊聊,所以请把你的MSN或别的什么联系方式给我)",[137,138],"hr",{},[97,140,141],{},"又不知该说什么了,很多事要做,又不知该先做那一件...",[97,143,144],{},"经过慎重考虑最终决定:还是先挑个简单的做 -- --",[97,146,147],{},"下楼",[97,149,150],{},"吃饭!!",{"title":152,"searchDepth":153,"depth":153,"links":154},"",2,[],[6],"md",{"date":158},"2007-08-03 11:58",true,"\u002Fblog\u002Fblog_4af9831b010009nt",{"title":92,"description":99},"blog_4af9831b010009nt","blog\u002Fblog_4af9831b010009nt",[],"Khwv4IkF3KOS6rCzDFBM124E2HVbQ-hL7X4XgffaZFs",[167,172],{"title":168,"path":169,"stem":170,"children":-1,"slug":171},"祝福77   生日快乐","\u002Fblog\u002Fblog_4af9831b010009jz","blog\u002Fblog_4af9831b010009jz","blog_4af9831b010009jz",{"title":173,"path":174,"stem":175,"children":-1,"slug":176},"我","\u002Fblog\u002Fblog_4af9831b010009p1","blog\u002Fblog_4af9831b010009p1","blog_4af9831b010009p1",1794760532437]
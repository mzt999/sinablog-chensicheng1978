[{"data":1,"prerenderedAt":174},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":70,"blog-post-slug-blog_4af9831b010009nt":87,"surround-blog_4af9831b010009nt":163},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":45,"navLinks":46,"perPage":16,"prevNextIsExcludeDate":66,"site_description":23,"site_name":67,"stem":68,"__hash__":69},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{},[47,52,56,60,64],{"path":48,"title":49,"target":50,"fa_class":51},"\u002F","博客首页","internal","fa-home",{"path":53,"title":54,"target":50,"fa_class":55},"\u002Fabout","关于","fa-user",{"path":57,"title":58,"target":50,"fa_class":59},"\u002Fpost","归档","fa-archive",{"path":61,"title":62,"target":50,"fa_class":63},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":65,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","jvZHccz2rT-wjVS5GCPgWyhl8WnBIvECPkE5KpKFKCU",{"latestBlog":71},[72,75,78,81,84],{"title":73,"slug":74},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":76,"slug":77},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":79,"slug":80},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":82,"slug":83},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":85,"slug":86},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":88,"title":89,"body":90,"categories":152,"description":96,"extension":153,"meta":154,"navigation":156,"path":157,"seo":158,"slug":159,"stem":160,"tags":161,"__hash__":162},"blog\u002Fblog\u002Fblog_4af9831b010009nt.md","下楼 吃饭",{"type":91,"value":92,"toc":148},"minimark",[93,97,100,103,106,109,112,115,118,121,124,127,130,133,136,139,142,145],[94,95,96],"p",{},"刚从重庆回来,昨天.",[94,98,99],{},"这几天将会面临几个重大的\"谈判\",其中的一个或两个又会影响我很久乃至一生.",[94,101,102],{},"请祝我好运.",[94,104,105],{},"总觉得是在迷雾中行走,还好,身边有几个朋友...",[94,107,108],{},"能陪我醉,可以接受我的任性和放纵.",[94,110,111],{},"真是觉得我们生活的世界挺虚幻的,身边的人们穿梭游走,面目时而清晰时而模糊...",[94,113,114],{},"昨夜,陪人又看了两集\"民工\",三年前的事,说远不远,怎么竟会有已是百年的感觉?",[94,116,117],{},"那时的康导,那时的张译,那时的我...",[94,119,120],{},"有位同志很认真的对我说,希望我再厚重些,再隐忍些,再深邃些,再沉默些...",[94,122,123],{},"那些是表象,是方式,是外化.",[94,125,126],{},"其中自己的成长,艰辛,与痛苦,自知.",[94,128,129],{},"一位大师对告诉他弟子的一段话,被我牢记.因为此大师的弟子总是有同样的毛病:要学会谦卑,学会把傲气埋在心里,让一个个鲜活的人物去傲视世界,你要躲在后面笑,那是最得意的,懂吗?傻X!",[94,131,132],{},"(对了,在此招呼下\"业余弗洛依德\",因为实在很想和你多聊聊,所以请把你的MSN或别的什么联系方式给我)",[134,135],"hr",{},[94,137,138],{},"又不知该说什么了,很多事要做,又不知该先做那一件...",[94,140,141],{},"经过慎重考虑最终决定:还是先挑个简单的做 -- --",[94,143,144],{},"下楼",[94,146,147],{},"吃饭!!",{"title":149,"searchDepth":150,"depth":150,"links":151},"",2,[],[6],"md",{"date":155},"2007-08-03 11:58",true,"\u002Fblog\u002Fblog_4af9831b010009nt",{"title":89,"description":96},"blog_4af9831b010009nt","blog\u002Fblog_4af9831b010009nt",[],"Khwv4IkF3KOS6rCzDFBM124E2HVbQ-hL7X4XgffaZFs",[164,169],{"title":165,"path":166,"stem":167,"children":-1,"slug":168},"祝福77   生日快乐","\u002Fblog\u002Fblog_4af9831b010009jz","blog\u002Fblog_4af9831b010009jz","blog_4af9831b010009jz",{"title":170,"path":171,"stem":172,"children":-1,"slug":173},"我","\u002Fblog\u002Fblog_4af9831b010009p1","blog\u002Fblog_4af9831b010009p1","blog_4af9831b010009p1",1794546770371]
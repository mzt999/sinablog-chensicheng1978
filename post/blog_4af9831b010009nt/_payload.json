[{"data":1,"prerenderedAt":161},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":57,"blog-post-slug-blog_4af9831b010009nt":74,"surround-blog_4af9831b010009nt":150},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":16,"site_description":54,"stem":55,"__hash__":56},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo","新浪博客内容备份(粉丝自用)","settings","jPD1QWrYwbaIixg6lntppEYe-T3ZGd3EJZxFBkbKY9E",{"latestBlog":58},[59,62,65,68,71],{"title":60,"slug":61},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":63,"slug":64},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":66,"slug":67},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":69,"slug":70},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":72,"slug":73},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":75,"title":76,"body":77,"categories":139,"description":83,"extension":140,"meta":141,"navigation":143,"path":144,"seo":145,"slug":146,"stem":147,"tags":148,"__hash__":149},"blog\u002Fblog\u002Fblog_4af9831b010009nt.md","下楼 吃饭",{"type":78,"value":79,"toc":135},"minimark",[80,84,87,90,93,96,99,102,105,108,111,114,117,120,123,126,129,132],[81,82,83],"p",{},"刚从重庆回来,昨天.",[81,85,86],{},"这几天将会面临几个重大的\"谈判\",其中的一个或两个又会影响我很久乃至一生.",[81,88,89],{},"请祝我好运.",[81,91,92],{},"总觉得是在迷雾中行走,还好,身边有几个朋友...",[81,94,95],{},"能陪我醉,可以接受我的任性和放纵.",[81,97,98],{},"真是觉得我们生活的世界挺虚幻的,身边的人们穿梭游走,面目时而清晰时而模糊...",[81,100,101],{},"昨夜,陪人又看了两集\"民工\",三年前的事,说远不远,怎么竟会有已是百年的感觉?",[81,103,104],{},"那时的康导,那时的张译,那时的我...",[81,106,107],{},"有位同志很认真的对我说,希望我再厚重些,再隐忍些,再深邃些,再沉默些...",[81,109,110],{},"那些是表象,是方式,是外化.",[81,112,113],{},"其中自己的成长,艰辛,与痛苦,自知.",[81,115,116],{},"一位大师对告诉他弟子的一段话,被我牢记.因为此大师的弟子总是有同样的毛病:要学会谦卑,学会把傲气埋在心里,让一个个鲜活的人物去傲视世界,你要躲在后面笑,那是最得意的,懂吗?傻X!",[81,118,119],{},"(对了,在此招呼下\"业余弗洛依德\",因为实在很想和你多聊聊,所以请把你的MSN或别的什么联系方式给我)",[121,122],"hr",{},[81,124,125],{},"又不知该说什么了,很多事要做,又不知该先做那一件...",[81,127,128],{},"经过慎重考虑最终决定:还是先挑个简单的做 -- --",[81,130,131],{},"下楼",[81,133,134],{},"吃饭!!",{"title":136,"searchDepth":137,"depth":137,"links":138},"",2,[],[6],"md",{"date":142},"2007-08-03 11:58",true,"\u002Fblog\u002Fblog_4af9831b010009nt",{"title":76,"description":83},"blog_4af9831b010009nt","blog\u002Fblog_4af9831b010009nt",[],"Khwv4IkF3KOS6rCzDFBM124E2HVbQ-hL7X4XgffaZFs",[151,156],{"title":152,"path":153,"stem":154,"children":-1,"slug":155},"祝福77   生日快乐","\u002Fblog\u002Fblog_4af9831b010009jz","blog\u002Fblog_4af9831b010009jz","blog_4af9831b010009jz",{"title":157,"path":158,"stem":159,"children":-1,"slug":160},"我","\u002Fblog\u002Fblog_4af9831b010009p1","blog\u002Fblog_4af9831b010009p1","blog_4af9831b010009p1",1794473705810]
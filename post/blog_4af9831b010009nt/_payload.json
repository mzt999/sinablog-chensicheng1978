[{"data":1,"prerenderedAt":121},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":17,"blog-post-slug-blog_4af9831b010009nt":34,"surround-blog_4af9831b010009nt":110},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"latestBlog":18},[19,22,25,28,31],{"title":20,"slug":21},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":23,"slug":24},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":26,"slug":27},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":29,"slug":30},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":32,"slug":33},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":35,"title":36,"body":37,"categories":99,"description":43,"extension":100,"meta":101,"navigation":103,"path":104,"seo":105,"slug":106,"stem":107,"tags":108,"__hash__":109},"blog\u002Fblog\u002Fblog_4af9831b010009nt.md","下楼 吃饭",{"type":38,"value":39,"toc":95},"minimark",[40,44,47,50,53,56,59,62,65,68,71,74,77,80,83,86,89,92],[41,42,43],"p",{},"刚从重庆回来,昨天.",[41,45,46],{},"这几天将会面临几个重大的\"谈判\",其中的一个或两个又会影响我很久乃至一生.",[41,48,49],{},"请祝我好运.",[41,51,52],{},"总觉得是在迷雾中行走,还好,身边有几个朋友...",[41,54,55],{},"能陪我醉,可以接受我的任性和放纵.",[41,57,58],{},"真是觉得我们生活的世界挺虚幻的,身边的人们穿梭游走,面目时而清晰时而模糊...",[41,60,61],{},"昨夜,陪人又看了两集\"民工\",三年前的事,说远不远,怎么竟会有已是百年的感觉?",[41,63,64],{},"那时的康导,那时的张译,那时的我...",[41,66,67],{},"有位同志很认真的对我说,希望我再厚重些,再隐忍些,再深邃些,再沉默些...",[41,69,70],{},"那些是表象,是方式,是外化.",[41,72,73],{},"其中自己的成长,艰辛,与痛苦,自知.",[41,75,76],{},"一位大师对告诉他弟子的一段话,被我牢记.因为此大师的弟子总是有同样的毛病:要学会谦卑,学会把傲气埋在心里,让一个个鲜活的人物去傲视世界,你要躲在后面笑,那是最得意的,懂吗?傻X!",[41,78,79],{},"(对了,在此招呼下\"业余弗洛依德\",因为实在很想和你多聊聊,所以请把你的MSN或别的什么联系方式给我)",[81,82],"hr",{},[41,84,85],{},"又不知该说什么了,很多事要做,又不知该先做那一件...",[41,87,88],{},"经过慎重考虑最终决定:还是先挑个简单的做 -- --",[41,90,91],{},"下楼",[41,93,94],{},"吃饭!!",{"title":96,"searchDepth":97,"depth":97,"links":98},"",2,[],[6],"md",{"date":102},"2007-08-03 11:58",true,"\u002Fblog\u002Fblog_4af9831b010009nt",{"title":36,"description":43},"blog_4af9831b010009nt","blog\u002Fblog_4af9831b010
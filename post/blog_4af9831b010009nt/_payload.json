[{"data":1,"prerenderedAt":118},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b010009nt":31,"surround-blog_4af9831b010009nt":107},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",151,{"name":9,"len":10},"有图",34,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":96,"description":33,"extension":97,"meta":98,"navigation":100,"path":101,"seo":102,"slug":103,"stem":104,"tags":105,"__hash__":106},"blog\u002Fblog\u002Fblog_4af9831b010009nt.md","下楼 吃饭",{"type":35,"value":36,"toc":92},"minimark",[37,41,44,47,50,53,56,59,62,65,68,71,74,77,80,83,86,89],[38,39,40],"p",{},"刚从重庆回来,昨天.",[38,42,43],{},"这几天将会面临几个重大的\"谈判\",其中的一个或两个又会影响我很久乃至一生.",[38,45,46],{},"请祝我好运.",[38,48,49],{},"总觉得是在迷雾中行走,还好,身边有几个朋友...",[38,51,52],{},"能陪我醉,可以接受我的任性和放纵.",[38,54,55],{},"真是觉得我们生活的世界挺虚幻的,身边的人们穿梭游走,面目时而清晰时而模糊...",[38,57,58],{},"昨夜,陪人又看了两集\"民工\",三年前的事,说远不远,怎么竟会有已是百年的感觉?",[38,60,61],{},"那时的康导,那时的张译,那时的我...",[38,63,64],{},"有位同志很认真的对我说,希望我再厚重些,再隐忍些,再深邃些,再沉默些...",[38,66,67],{},"那些是表象,是方式,是外化.",[38,69,70],{},"其中自己的成长,艰辛,与痛苦,自知.",[38,72,73],{},"一位大师对告诉他弟子的一段话,被我牢记.因为此大师的弟子总是有同样的毛病:要学会谦卑,学会把傲气埋在心里,让一个个鲜活的人物去傲视世界,你要躲在后面笑,那是最得意的,懂吗?傻X!",[38,75,76],{},"(对了,在此招呼下\"业余弗洛依德\",因为实在很想和你多聊聊,所以请把你的MSN或别的什么联系方式给我)",[78,79],"hr",{},[38,81,82],{},"又不知该说什么了,很多事要做,又不知该先做那一件...",[38,84,85],{},"经过慎重考虑最终决定:还是先挑个简单的做 -- --",[38,87,88],{},"下楼",[38,90,91],{},"吃饭!!",{"title":93,"searchDepth":94,"depth":94,"links":95},"",2,[],[6],"md",{"date":99},"2007-08-03 11:58",true,"\u002Fblog\u002Fblog_4af9831b010009nt",{"title":33,"description":33},"blog_4af9831b010009nt","blog\u002Fblog_4af9831b010009nt",[],"RgfgmYThCGJYoDu-fXy-1WrtI0
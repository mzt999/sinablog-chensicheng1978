[{"data":1,"prerenderedAt":162},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":58,"blog-post-slug-blog_4af9831b010009nt":75,"surround-blog_4af9831b010009nt":151},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":54,"site_description":55,"stem":56,"__hash__":57},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo",20,"新浪博客内容备份","settings","hh8X7X6SFDoeJrxIJ4yisZXSc3HwHM1zk206jiQX2XU",{"latestBlog":59},[60,63,66,69,72],{"title":61,"slug":62},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":64,"slug":65},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":67,"slug":68},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":70,"slug":71},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":73,"slug":74},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":76,"title":77,"body":78,"categories":140,"description":84,"extension":141,"meta":142,"navigation":144,"path":145,"seo":146,"slug":147,"stem":148,"tags":149,"__hash__":150},"blog\u002Fblog\u002Fblog_4af9831b010009nt.md","下楼 吃饭",{"type":79,"value":80,"toc":136},"minimark",[81,85,88,91,94,97,100,103,106,109,112,115,118,121,124,127,130,133],[82,83,84],"p",{},"刚从重庆回来,昨天.",[82,86,87],{},"这几天将会面临几个重大的\"谈判\",其中的一个或两个又会影响我很久乃至一生.",[82,89,90],{},"请祝我好运.",[82,92,93],{},"总觉得是在迷雾中行走,还好,身边有几个朋友...",[82,95,96],{},"能陪我醉,可以接受我的任性和放纵.",[82,98,99],{},"真是觉得我们生活的世界挺虚幻的,身边的人们穿梭游走,面目时而清晰时而模糊...",[82,101,102],{},"昨夜,陪人又看了两集\"民工\",三年前的事,说远不远,怎么竟会有已是百年的感觉?",[82,104,105],{},"那时的康导,那时的张译,那时的我...",[82,107,108],{},"有位同志很认真的对我说,希望我再厚重些,再隐忍些,再深邃些,再沉默些...",[82,110,111],{},"那些是表象,是方式,是外化.",[82,113,114],{},"其中自己的成长,艰辛,与痛苦,自知.",[82,116,117],{},"一位大师对告诉他弟子的一段话,被我牢记.因为此大师的弟子总是有同样的毛病:要学会谦卑,学会把傲气埋在心里,让一个个鲜活的人物去傲视世界,你要躲在后面笑,那是最得意的,懂吗?傻X!",[82,119,120],{},"(对了,在此招呼下\"业余弗洛依德\",因为实在很想和你多聊聊,所以请把你的MSN或别的什么联系方式给我)",[122,123],"hr",{},[82,125,126],{},"又不知该说什么了,很多事要做,又不知该先做那一件...",[82,128,129],{},"经过慎重考虑最终决定:还是先挑个简单的做 -- --",[82,131,132],{},"下楼",[82,134,135],{},"吃饭!!",{"title":137,"searchDepth":138,"depth":138,"links":139},"",2,[],[6],"md",{"date":143},"2007-08-03 11:58",true,"\u002Fblog\u002Fblog_4af9831b010009nt",{"title":77,"description":84},"blog_4af9831b010009nt","blog\u002Fblog_4af9831b010009nt",[],"Khwv4IkF3KOS6rCzDFBM124E2HVbQ-hL7X4XgffaZFs",[152,157],{"title":153,"path":154,"stem":155,"children":-1,"slug":156},"祝福77   生日快乐","\u002Fblog\u002Fblog_4af9831b010009jz","blog\u002Fblog_4af9831b010009jz","blog_4af9831b010009jz",{"title":158,"path":159,"stem":160,"children":-1,"slug":161},"我","\u002Fblog\u002Fblog_4af9831b010009p1","blog\u002Fblog_4af9831b010009p1","blog_4af9831b010009p1",1794412501129]
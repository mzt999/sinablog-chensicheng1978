[{"data":1,"prerenderedAt":143},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":70,"blog-post-slug-blog_4af9831b0100bo3d":87,"surround-blog_4af9831b0100bo3d":132},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":45,"navLinks":46,"perPage":16,"prevNextIsExcludeDate":66,"site_description":23,"site_name":67,"stem":68,"__hash__":69},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{},[47,52,56,60,64],{"path":48,"title":49,"target":50,"fa_class":51},"\u002F","博客首页","internal","fa-home",{"path":53,"title":54,"target":50,"fa_class":55},"\u002Fabout","关于","fa-user",{"path":57,"title":58,"target":50,"fa_class":59},"\u002Fpost","归档","fa-archive",{"path":61,"title":62,"target":50,"fa_class":63},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":65,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","jvZHccz2rT-wjVS5GCPgWyhl8WnBIvECPkE5KpKFKCU",{"latestBlog":71},[72,75,78,81,84],{"title":73,"slug":74},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":76,"slug":77},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":79,"slug":80},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":82,"slug":83},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":85,"slug":86},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":88,"title":89,"body":90,"categories":119,"description":120,"extension":121,"meta":122,"navigation":124,"path":125,"seo":126,"slug":127,"stem":128,"tags":129,"__hash__":131},"blog\u002Fblog\u002Fblog_4af9831b0100bo3d.md","生个蛋吧",{"type":91,"value":92,"toc":115},"minimark",[93,97,100,103,106,109,112],[94,95,96],"p",{},"圣诞节还是生蛋节？既然不是生蛋节我们为什么过要？圣诞和我们有什么关系吗？可我们还是过了，且很认真的过了。所以，过着过着我又不明白了……",[94,98,99],{},"    弟买了棵圣诞树，我还兴致盎然的好一翻装扮，其实从没指望那白胡子小老头从我家哪个缝隙里钻出来，估计就是真出来了，也让我以为恐怖片看多了一顿大笤帚大拖把劈头盖脸的给丫掀出去了！可谁让我偏偏是个热爱生活的人呢？所以，我还是把绿漆塑料树给各种闪亮上了……",[94,101,102],{},"    有些秘密想说出来和大家分享，可总有人说我说话太没顾忌，人和人之间为什么总要那么多的顾忌呢？？顾忌多了就是难免的孤寂了……我们，我们都被自己弄复杂了……",[94,104,105],{},"    最近很好。这是我要说的。那种好就是脚踏实地的感觉。反正不再那么慌恐了焦虑了。无所了，事儿过得多了，颓了不敢说，厚了是真的。",[94,107,108],{},"    不知你们的今天过得怎样？有没有和家人在一起？有没有爱人在身边？……一切绚烂皆是虚妄，过后，剩下的只是他们了……所以，我们该珍惜……",[94,110,111],{},"    我们的圣诞比不过地球另一边。那是人家的节日。可正因为如此，我们刚好可以借着这种舶来的浪漫发生些自己的故事了……",[94,113,114],{},"    祝愿你们，今晚有个美好的故事上演了…………",{"title":116,"searchDepth":117,"depth":117,"links":118},"",2,[],[6],"圣诞和我们有什么关系吗？可我们还是过了","md",{"date":123},"2008-12-26 00:25",true,"\u002Fblog\u002Fblog_4af9831b0100bo3d",{"title":89,"description":120},"blog_4af9831b0100bo3d","blog\u002Fblog_4af9831b0100bo3d",[130],"杂谈","tnDw-JXEWc2ib6mnT5Vb79fxFl-w392Gm3R9xth3_SU",[133,138],{"title":134,"path":135,"stem":136,"children":-1,"slug":137},"长相守","\u002Fblog\u002Fblog_4af9831b0100bkca","blog\u002Fblog_4af9831b0100bkca","blog_4af9831b0100bkca",{"title":139,"path":140,"stem":141,"children":-1,"slug":142},"海","\u002Fblog\u002Fblog_4af9831b0100bt89","blog\u002Fblog_4af9831b0100bt89","blog_4af9831b0100bt89",1794544667616]
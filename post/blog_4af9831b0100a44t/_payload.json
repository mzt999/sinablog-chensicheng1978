[{"data":1,"prerenderedAt":163},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":57,"blog-post-slug-blog_4af9831b0100a44t":74,"surround-blog_4af9831b0100a44t":152},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":16,"site_description":54,"stem":55,"__hash__":56},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo","新浪博客内容备份(粉丝自用)","settings","jPD1QWrYwbaIixg6lntppEYe-T3ZGd3EJZxFBkbKY9E",{"latestBlog":58},[59,62,65,68,71],{"title":60,"slug":61},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":63,"slug":64},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":66,"slug":67},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":69,"slug":70},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":72,"slug":73},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":75,"title":76,"body":77,"categories":139,"description":140,"extension":141,"meta":142,"navigation":144,"path":145,"seo":146,"slug":147,"stem":148,"tags":149,"__hash__":151},"blog\u002Fblog\u002Fblog_4af9831b0100a44t.md","分享",{"type":78,"value":79,"toc":135},"minimark",[80,84,87,90,93,96,99,102,105,108,111,114,117,120,123,126,129,132],[81,82,83],"p",{},"脸上挂着妆。就挂着吧。从早晨7点直到此刻，它都挂在上边。",[81,85,86],{},"两天前大脸猫出了题目给我说叫：分享。",[81,88,89],{},"结果是“纷想”了这个庞大的人生命题后，我颓了……",[81,91,92],{},"命运，是风。我们，风里的沙。自顾自的坚硬，其实早被它裹挟着吹远……",[81,94,95],{},"我们盼望着分享，一个人的精彩无非自说自话，久了，会疯。",[81,97,98],{},"脑子里常有一副画：荒漠，烈日，",[81,100,101],{},"在路上……一个人走着……漫长……",[81,103,104],{},"身边多了一个……",[81,106,107],{},"牵手走着……漫长……",[81,109,110],{},"又多了几个……",[81,112,113],{},"并肩走着……漫长……",[81,115,116],{},"我们都以为……",[81,118,119],{},"永远漫长……",[81,121,122],{},"可岔路就在前方……",[81,124,125],{},"心中总有种悲凉，想你明白。也许孤独和痛苦才是生命本质。体验和拥有无非是要舍弃和失去。没有什么能永远，才是我心底最隐秘的伤口。",[81,127,128],{},"一分？ 一秒？ 一生？ 一世？究竟有无区别？ 在永恒面前，量词只是量词……",[81,130,131],{},"分享吧！笑与泪。能久就让它久些……也许真正的理解可以穿越时空，在暗物质的世界达到不朽……",[81,133,134],{},"分享？不如…………分担……",{"title":136,"searchDepth":137,"depth":137,"links":138},"",2,[],[6],"也许孤独和痛苦才是生命本质。体验和拥有无非是要舍弃和失去。","md",{"date":143},"2008-07-25 22:33",true,"\u002Fblog\u002Fblog_4af9831b0100a44t",{"title":76,"description":140},"blog_4af9831b0100a44t","blog\u002Fblog_4af9831b0100a44t",[150],"杂谈","rF9YhowQeHJsy39nBmKxddJBOsFbovKMbUNOpp6bHzs",[153,158],{"title":154,"path":155,"stem":156,"children":-1,"slug":157},"写真：水泥森林里的刚毅柔情","\u002Fblog\u002Fblog_4af9831b01009zgq","blog\u002Fblog_4af9831b01009zgq","blog_4af9831b01009zgq",{"title":159,"path":160,"stem":161,"children":-1,"slug":162},"命运","\u002Fblog\u002Fblog_4af9831b0100aiz0","blog\u002Fblog_4af9831b0100aiz0","blog_4af9831b0100aiz0",1794473705328]
[{"data":1,"prerenderedAt":164},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":58,"blog-post-slug-blog_4af9831b0100a44t":75,"surround-blog_4af9831b0100a44t":153},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":54,"site_description":55,"stem":56,"__hash__":57},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo",20,"新浪博客内容备份","settings","hh8X7X6SFDoeJrxIJ4yisZXSc3HwHM1zk206jiQX2XU",{"latestBlog":59},[60,63,66,69,72],{"title":61,"slug":62},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":64,"slug":65},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":67,"slug":68},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":70,"slug":71},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":73,"slug":74},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":76,"title":77,"body":78,"categories":140,"description":141,"extension":142,"meta":143,"navigation":145,"path":146,"seo":147,"slug":148,"stem":149,"tags":150,"__hash__":152},"blog\u002Fblog\u002Fblog_4af9831b0100a44t.md","分享",{"type":79,"value":80,"toc":136},"minimark",[81,85,88,91,94,97,100,103,106,109,112,115,118,121,124,127,130,133],[82,83,84],"p",{},"脸上挂着妆。就挂着吧。从早晨7点直到此刻，它都挂在上边。",[82,86,87],{},"两天前大脸猫出了题目给我说叫：分享。",[82,89,90],{},"结果是“纷想”了这个庞大的人生命题后，我颓了……",[82,92,93],{},"命运，是风。我们，风里的沙。自顾自的坚硬，其实早被它裹挟着吹远……",[82,95,96],{},"我们盼望着分享，一个人的精彩无非自说自话，久了，会疯。",[82,98,99],{},"脑子里常有一副画：荒漠，烈日，",[82,101,102],{},"在路上……一个人走着……漫长……",[82,104,105],{},"身边多了一个……",[82,107,108],{},"牵手走着……漫长……",[82,110,111],{},"又多了几个……",[82,113,114],{},"并肩走着……漫长……",[82,116,117],{},"我们都以为……",[82,119,120],{},"永远漫长……",[82,122,123],{},"可岔路就在前方……",[82,125,126],{},"心中总有种悲凉，想你明白。也许孤独和痛苦才是生命本质。体验和拥有无非是要舍弃和失去。没有什么能永远，才是我心底最隐秘的伤口。",[82,128,129],{},"一分？ 一秒？ 一生？ 一世？究竟有无区别？ 在永恒面前，量词只是量词……",[82,131,132],{},"分享吧！笑与泪。能久就让它久些……也许真正的理解可以穿越时空，在暗物质的世界达到不朽……",[82,134,135],{},"分享？不如…………分担……",{"title":137,"searchDepth":138,"depth":138,"links":139},"",2,[],[6],"也许孤独和痛苦才是生命本质。体验和拥有无非是要舍弃和失去。","md",{"date":144},"2008-07-25 22:33",true,"\u002Fblog\u002Fblog_4af9831b0100a44t",{"title":77,"description":141},"blog_4af9831b0100a44t","blog\u002Fblog_4af9831b0100a44t",[151],"杂谈","rF9YhowQeHJsy39nBmKxddJBOsFbovKMbUNOpp6bHzs",[154,159],{"title":155,"path":156,"stem":157,"children":-1,"slug":158},"写真：水泥森林里的刚毅柔情","\u002Fblog\u002Fblog_4af9831b01009zgq","blog\u002Fblog_4af9831b01009zgq","blog_4af9831b01009zgq",{"title":160,"path":161,"stem":162,"children":-1,"slug":163},"命运","\u002Fblog\u002Fblog_4af9831b0100aiz0","blog\u002Fblog_4af9831b0100aiz0","blog_4af9831b0100aiz0",1794412500669]
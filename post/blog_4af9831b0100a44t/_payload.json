[{"data":1,"prerenderedAt":119},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b0100a44t":31,"surround-blog_4af9831b0100a44t":108},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",152,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":96,"description":33,"extension":97,"meta":98,"navigation":100,"path":101,"seo":102,"slug":103,"stem":104,"tags":105,"__hash__":107},"blog\u002Fblog\u002Fblog_4af9831b0100a44t.md","分享",{"type":35,"value":36,"toc":92},"minimark",[37,41,44,47,50,53,56,59,62,65,68,71,74,77,80,83,86,89],[38,39,40],"p",{},"脸上挂着妆。就挂着吧。从早晨7点直到此刻，它都挂在上边。",[38,42,43],{},"两天前大脸猫出了题目给我说叫：分享。",[38,45,46],{},"结果是“纷想”了这个庞大的人生命题后，我颓了……",[38,48,49],{},"命运，是风。我们，风里的沙。自顾自的坚硬，其实早被它裹挟着吹远……",[38,51,52],{},"我们盼望着分享，一个人的精彩无非自说自话，久了，会疯。",[38,54,55],{},"脑子里常有一副画：荒漠，烈日，",[38,57,58],{},"在路上……一个人走着……漫长……",[38,60,61],{},"身边多了一个……",[38,63,64],{},"牵手走着……漫长……",[38,66,67],{},"又多了几个……",[38,69,70],{},"并肩走着……漫长……",[38,72,73],{},"我们都以为……",[38,75,76],{},"永远漫长……",[38,78,79],{},"可岔路就在前方……",[38,81,82],{},"心中总有种悲凉，想你明白。也许孤独和痛苦才是生命本质。体验和拥有无非是要舍弃和失去。没有什么能永远，才是我心底最隐秘的伤口。",[38,84,85],{},"一分？ 一秒？ 一生？ 一世？究竟有无区别？ 在永恒面前，量词只是量词……",[38,87,88],{},"分享吧！笑与泪。能久就让它久些……也许真正的理解可以穿越时空，在暗物质的世界达到不朽……",[38,90,91],{},"分享？不如…………分担……",{"title":93,"searchDepth":94,"depth":94,"links":95},"",2,[],[6],"md",{"date":99},"2008-07-25 22:33",true,"\u002Fblog\u002Fblog_4af9831b0100a44t",{"title":33,"description":33},"blog_4af9831b0100a44t","blog\u002Fblog_4af9831b0100a44t",[106],"杂谈","HDmw33R4IR6mVV1sx0ACqt5IYhHJltnbI0QQ8EL3Tcs",[109,114],{"title":110,"path":111,"stem":112,"children":-1,"slug":113},"写真：水泥森林里的刚毅柔情","\u002Fblog\u002Fblog_4af9831b01009zgq","blog\u002Fblog_4af9831b01009zgq","blog_4af9831b01009zgq",{"title":115,"path":116,"stem":117,"children":-1,"slug":118},"命运","\u002Fblog\u002Fblog_4af9831b0100aiz0","blog\u002Fblog_4af9831b0100aiz0","blog_4af9831b0100aiz0",1793971358273]
[{"data":1,"prerenderedAt":182},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":76,"blog-post-slug-blog_4af9831b0100a44t":93,"surround-blog_4af9831b0100a44t":171},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":38,"meta":50,"navLinks":51,"perPage":16,"prevNextIsExcludeDate":71,"site_description":72,"site_name":73,"stem":74,"__hash__":75},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,26,32],{"text":23},"粉丝自制非官方站点｜素材版权归原权利人所有",{"text":25},"仅兴趣交流、无商业用途｜如有侵权请联系删除",{"text":27,"link":28},"查看",{"href":29,"text":30,"fa_class":31},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":33,"link":34},"如有任何疑问，欢迎",{"href":35,"text":36,"fa_class":37},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[39,42,45,47],{"href":40,"text":41},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":43,"text":44},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":46},"新浪微博备份(2009-2026)",{"href":48,"text":49},"https:\u002F\u002Fmzt999.github.io\u002Fportfolio-chensicheng1978","幕后作品集展示(2012-2026)",{},[52,57,61,65,69],{"path":53,"title":54,"target":55,"fa_class":56},"\u002F","博客首页","internal","fa-home",{"path":58,"title":59,"target":55,"fa_class":60},"\u002Fabout","关于","fa-user",{"path":62,"title":63,"target":55,"fa_class":64},"\u002Fpost","归档","fa-archive",{"path":66,"title":67,"target":55,"fa_class":68},"\u002Fgallery","相册","fa-image",{"path":29,"title":30,"target":70,"fa_class":31},"otherSite",false,"新浪博客内容备份(粉丝自用)","陈思诚的博客","settings","5S7xKt0XLHpkjipbomx4I7pUu50Y7wqtD418LquZj5Q",{"latestBlog":77},[78,81,84,87,90],{"title":79,"slug":80},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":82,"slug":83},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":85,"slug":86},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":88,"slug":89},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":91,"slug":92},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":94,"title":95,"body":96,"categories":158,"description":159,"extension":160,"meta":161,"navigation":163,"path":164,"seo":165,"slug":166,"stem":167,"tags":168,"__hash__":170},"blog\u002Fblog\u002Fblog_4af9831b0100a44t.md","分享",{"type":97,"value":98,"toc":154},"minimark",[99,103,106,109,112,115,118,121,124,127,130,133,136,139,142,145,148,151],[100,101,102],"p",{},"脸上挂着妆。就挂着吧。从早晨7点直到此刻，它都挂在上边。",[100,104,105],{},"两天前大脸猫出了题目给我说叫：分享。",[100,107,108],{},"结果是“纷想”了这个庞大的人生命题后，我颓了……",[100,110,111],{},"命运，是风。我们，风里的沙。自顾自的坚硬，其实早被它裹挟着吹远……",[100,113,114],{},"我们盼望着分享，一个人的精彩无非自说自话，久了，会疯。",[100,116,117],{},"脑子里常有一副画：荒漠，烈日，",[100,119,120],{},"在路上……一个人走着……漫长……",[100,122,123],{},"身边多了一个……",[100,125,126],{},"牵手走着……漫长……",[100,128,129],{},"又多了几个……",[100,131,132],{},"并肩走着……漫长……",[100,134,135],{},"我们都以为……",[100,137,138],{},"永远漫长……",[100,140,141],{},"可岔路就在前方……",[100,143,144],{},"心中总有种悲凉，想你明白。也许孤独和痛苦才是生命本质。体验和拥有无非是要舍弃和失去。没有什么能永远，才是我心底最隐秘的伤口。",[100,146,147],{},"一分？ 一秒？ 一生？ 一世？究竟有无区别？ 在永恒面前，量词只是量词……",[100,149,150],{},"分享吧！笑与泪。能久就让它久些……也许真正的理解可以穿越时空，在暗物质的世界达到不朽……",[100,152,153],{},"分享？不如…………分担……",{"title":155,"searchDepth":156,"depth":156,"links":157},"",2,[],[6],"也许孤独和痛苦才是生命本质。体验和拥有无非是要舍弃和失去。","md",{"date":162},"2008-07-25 22:33",true,"\u002Fblog\u002Fblog_4af9831b0100a44t",{"title":95,"description":159},"blog_4af9831b0100a44t","blog\u002Fblog_4af9831b0100a44t",[169],"杂谈","rF9YhowQeHJsy39nBmKxddJBOsFbovKMbUNOpp6bHzs",[172,177],{"title":173,"path":174,"stem":175,"children":-1,"slug":176},"写真：水泥森林里的刚毅柔情","\u002Fblog\u002Fblog_4af9831b01009zgq","blog\u002Fblog_4af9831b01009zgq","blog_4af9831b01009zgq",{"title":178,"path":179,"stem":180,"children":-1,"slug":181},"命运","\u002Fblog\u002Fblog_4af9831b0100aiz0","blog\u002Fblog_4af9831b0100aiz0","blog_4af9831b0100aiz0",1795162025823]
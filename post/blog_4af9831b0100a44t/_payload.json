[{"data":1,"prerenderedAt":179},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":73,"blog-post-slug-blog_4af9831b0100a44t":90,"surround-blog_4af9831b0100a44t":168},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":48,"navLinks":49,"perPage":16,"prevNextIsExcludeDate":69,"site_description":23,"site_name":70,"stem":71,"__hash__":72},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43,45],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{"href":46,"text":47},"https:\u002F\u002Fmzt999.github.io\u002Fportfolio-chensicheng1978","幕后作品集展示(2012-2026)",{},[50,55,59,63,67],{"path":51,"title":52,"target":53,"fa_class":54},"\u002F","博客首页","internal","fa-home",{"path":56,"title":57,"target":53,"fa_class":58},"\u002Fabout","关于","fa-user",{"path":60,"title":61,"target":53,"fa_class":62},"\u002Fpost","归档","fa-archive",{"path":64,"title":65,"target":53,"fa_class":66},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":68,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","LA_7Y82F2zjQ6-R2_tcWHl356krYL76uqQHBCIU8UZk",{"latestBlog":74},[75,78,81,84,87],{"title":76,"slug":77},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":79,"slug":80},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":82,"slug":83},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":85,"slug":86},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":88,"slug":89},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":91,"title":92,"body":93,"categories":155,"description":156,"extension":157,"meta":158,"navigation":160,"path":161,"seo":162,"slug":163,"stem":164,"tags":165,"__hash__":167},"blog\u002Fblog\u002Fblog_4af9831b0100a44t.md","分享",{"type":94,"value":95,"toc":151},"minimark",[96,100,103,106,109,112,115,118,121,124,127,130,133,136,139,142,145,148],[97,98,99],"p",{},"脸上挂着妆。就挂着吧。从早晨7点直到此刻，它都挂在上边。",[97,101,102],{},"两天前大脸猫出了题目给我说叫：分享。",[97,104,105],{},"结果是“纷想”了这个庞大的人生命题后，我颓了……",[97,107,108],{},"命运，是风。我们，风里的沙。自顾自的坚硬，其实早被它裹挟着吹远……",[97,110,111],{},"我们盼望着分享，一个人的精彩无非自说自话，久了，会疯。",[97,113,114],{},"脑子里常有一副画：荒漠，烈日，",[97,116,117],{},"在路上……一个人走着……漫长……",[97,119,120],{},"身边多了一个……",[97,122,123],{},"牵手走着……漫长……",[97,125,126],{},"又多了几个……",[97,128,129],{},"并肩走着……漫长……",[97,131,132],{},"我们都以为……",[97,134,135],{},"永远漫长……",[97,137,138],{},"可岔路就在前方……",[97,140,141],{},"心中总有种悲凉，想你明白。也许孤独和痛苦才是生命本质。体验和拥有无非是要舍弃和失去。没有什么能永远，才是我心底最隐秘的伤口。",[97,143,144],{},"一分？ 一秒？ 一生？ 一世？究竟有无区别？ 在永恒面前，量词只是量词……",[97,146,147],{},"分享吧！笑与泪。能久就让它久些……也许真正的理解可以穿越时空，在暗物质的世界达到不朽……",[97,149,150],{},"分享？不如…………分担……",{"title":152,"searchDepth":153,"depth":153,"links":154},"",2,[],[6],"也许孤独和痛苦才是生命本质。体验和拥有无非是要舍弃和失去。","md",{"date":159},"2008-07-25 22:33",true,"\u002Fblog\u002Fblog_4af9831b0100a44t",{"title":92,"description":156},"blog_4af9831b0100a44t","blog\u002Fblog_4af9831b0100a44t",[166],"杂谈","rF9YhowQeHJsy39nBmKxddJBOsFbovKMbUNOpp6bHzs",[169,174],{"title":170,"path":171,"stem":172,"children":-1,"slug":173},"写真：水泥森林里的刚毅柔情","\u002Fblog\u002Fblog_4af9831b01009zgq","blog\u002Fblog_4af9831b01009zgq","blog_4af9831b01009zgq",{"title":175,"path":176,"stem":177,"children":-1,"slug":178},"命运","\u002Fblog\u002Fblog_4af9831b0100aiz0","blog\u002Fblog_4af9831b0100aiz0","blog_4af9831b0100aiz0",1794760532038]
[{"data":1,"prerenderedAt":123},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":17,"blog-post-slug-blog_4af9831b0100a44t":34,"surround-blog_4af9831b0100a44t":112},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"latestBlog":18},[19,22,25,28,31],{"title":20,"slug":21},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":23,"slug":24},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":26,"slug":27},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":29,"slug":30},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":32,"slug":33},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":35,"title":36,"body":37,"categories":99,"description":100,"extension":101,"meta":102,"navigation":104,"path":105,"seo":106,"slug":107,"stem":108,"tags":109,"__hash__":111},"blog\u002Fblog\u002Fblog_4af9831b0100a44t.md","分享",{"type":38,"value":39,"toc":95},"minimark",[40,44,47,50,53,56,59,62,65,68,71,74,77,80,83,86,89,92],[41,42,43],"p",{},"脸上挂着妆。就挂着吧。从早晨7点直到此刻，它都挂在上边。",[41,45,46],{},"两天前大脸猫出了题目给我说叫：分享。",[41,48,49],{},"结果是“纷想”了这个庞大的人生命题后，我颓了……",[41,51,52],{},"命运，是风。我们，风里的沙。自顾自的坚硬，其实早被它裹挟着吹远……",[41,54,55],{},"我们盼望着分享，一个人的精彩无非自说自话，久了，会疯。",[41,57,58],{},"脑子里常有一副画：荒漠，烈日，",[41,60,61],{},"在路上……一个人走着……漫长……",[41,63,64],{},"身边多了一个……",[41,66,67],{},"牵手走着……漫长……",[41,69,70],{},"又多了几个……",[41,72,73],{},"并肩走着……漫长……",[41,75,76],{},"我们都以为……",[41,78,79],{},"永远漫长……",[41,81,82],{},"可岔路就在前方……",[41,84,85],{},"心中总有种悲凉，想你明白。也许孤独和痛苦才是生命本质。体验和拥有无非是要舍弃和失去。没有什么能永远，才是我心底最隐秘的伤口。",[41,87,88],{},"一分？ 一秒？ 一生？ 一世？究竟有无区别？ 在永恒面前，量词只是量词……",[41,90,91],{},"分享吧！笑与泪。能久就让它久些……也许真正的理解可以穿越时空，在暗物质的世界达到不朽……",[41,93,94],{},"分享？不如…………分担……",{"title":96,"searchDepth":97,"depth":97,"links":98},"",2,[],[6],"也许孤独和痛苦才是生命本质。体验和拥有无非是要舍弃和失去。","md",{"date":103},"2008-07-25 22:33",true,"\u002Fblog\u002Fblog_4af9831b0100a44t",{"title":36,"description":100},"blog_4af9831b0100a44t","blog\u002Fblog_4af9831b0100a44t",[110],"杂谈","rF9YhowQeHJsy39nBmKxddJBOsFbovKMbUNOpp6b
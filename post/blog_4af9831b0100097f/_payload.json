[{"data":1,"prerenderedAt":189},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":17,"blog-post-slug-blog_4af9831b0100097f":34,"surround-blog_4af9831b0100097f":178},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"latestBlog":18},[19,22,25,28,31],{"title":20,"slug":21},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":23,"slug":24},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":26,"slug":27},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":29,"slug":30},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":32,"slug":33},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":35,"title":36,"body":37,"categories":166,"description":167,"extension":168,"meta":169,"navigation":171,"path":172,"seo":173,"slug":174,"stem":175,"tags":176,"__hash__":177},"blog\u002Fblog\u002Fblog_4af9831b0100097f.md","不知所云",{"type":38,"value":39,"toc":162},"minimark",[40,47,52,57,62,67,72,75,78,81,84,87,90,93,96,99,102,105,108,111,114,117,120,123,126,129,132,135,138,141,144,147,150,153,156,159],[41,42,43],"p",{},[44,45],"img",{"alt":36,"src":46},"\u002Fpic\u002F4af9831b02000xv0.jpg",[41,48,49],{},[44,50],{"alt":36,"src":51},"\u002Fpic\u002F4af9831b02000xv1.jpg",[41,53,54],{},[44,55],{"alt":36,"src":56},"\u002Fpic\u002F4af9831b02000xv2.jpg",[41,58,59],{},[44,60],{"alt":36,"src":61},"\u002Fpic\u002F4af9831b02000xuz.jpg",[41,63,64],{},[44,65],{"alt":36,"src":66},"\u002Fpic\u002F4af9831b02000xuy.jpg",[41,68,69],{},[44,70],{"alt":36,"src":71},"\u002Fpic\u002F4af9831b02000xux.jpg",[41,73,74],{},"  快杀青了，子弹。",[41,76,77],{},"SO任何幸福和痛苦与时间相比都是瞬间，生命亦然",[41,79,80],{},"贴几张照片，自然排列，没有章法",[41,82,83],{},"反正是我的一段青春，三个女人，和经历后的沧桑小脸",[41,85,86],{},"这戏的前景不明，但却是我迄今付出最多的一部",[41,88,89],{},"  无论身心",[41,91,92],{},"  所以我祝福她",[41,94,95],{},"  也信，只要你看，就会感动",[41,97,98],{},"‘士兵’的日子近了，很遗憾12日没法和众兄弟畅饮‘云南红’了，实在要把‘子弹’坚持完",[41,100,101],{},"还好，有20几号的重庆火锅能吃",[41,103,104],{},"  真想兄弟们",[41,106,107],{},"  ‘士兵’让我们成了战友",[41,109,110],{},"  最近狂拍导致巨累",[41,112,113],{},"以为这里长草了，就穿高跟鞋给新朋旧友问好",[41,115,116],{},"会信守诺言，回京请几个‘老人’吃顿好的",[41,118,119],{},"每次见到你们，无论在哪，还是亲近……",[41,121,122],{},"最近在现场抽空看王朔的‘千岁寒’，又服了",[41,124,125],{},"他成精了，超脱了，拿自己当佛了……",[41,127,128],{},"真佩服哥哥的想象力和胆魄，阅读快感大行其道的今天他又逼我们咬文嚼字了",[41,130,131],{},"‘时间简史’和‘金刚经’繁殖出的不是‘人’需要的营养",[41,133,134],{},"不知对错，反正我认为我看懂了",[41,136,137],{},"  想说的多，时间少，有点乱",[41,139,140],{},"  反正",[41,142,143],{},"橙子又长大了，可以上初中了",[41,145,146],{},"都是这戏的催促和生活他妈",[41,148,149],{},"  逼的",[41,151,152],{},"  以后会更认真……",[41,154,155],{},"  包括吃喝",[41,157,158],{},"既然圣人云：朝闻道，夕死可亦",[41,160,161],{},"我就不再惧怕自己大器晚成了……",{"title":163,"searchDepth":164,"depth":164,"links":165},"",2,[],[6,9],"快杀青了，子弹。","md",{"date":170},"2007-07-06 21:20",true,"\u002Fblog\u002Fblog_4af9831b0100097f",{"title":36,"description":167},"blog_4af9831b0100097f","blog\u002Fblog_4af9831b0100097f",[],"G3h0IA6D5_5ske81G9FmOg2PWvjy1mXJm_Cj9nSKIwU",[179,184],{"title":180,"path":181,"stem":182,"children":-1,"slug":183},"0.03克","\u002Fblog\u002Fblog_4af9831b0100096m","blog\u002Fblog_4af9831b0100096m","blog_4af9831b0100096m",{"title":185,"path":186,"stem":187,"children":-1,"slug":188},"死去   活来","\u002Fblog\u002Fblog_4af9831b010009g3","blog\u002Fblog_4af9831b010009g3","blog_4af9831b010009g3",1794043805956]
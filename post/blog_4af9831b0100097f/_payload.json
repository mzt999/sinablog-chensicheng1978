},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":88,"slug":89},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":91,"slug":92},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":94,"title":95,"body":96,"categories":225,"description":226,"extension":227,"meta":228,"navigation":230,"path":231,"seo":232,"slug":233,"stem":234,"tags":235,"__hash__":236},"blog\u002Fblog\u002Fblog_4af9831b0100097f.md","不知所云",{"type":97,"value":98,"toc":221},"minimark",[99,106,111,116,121,126,131,134,137,140,143,146,149,152,155,158,161,164,167,170,173,176,179,182,185,188,191,194,197,200,203,206,209,212,215,218],[100,101,102],"p",{},[103,104],"img",{"alt":95,"src":105},"\u002Fpic\u002F4af9831b02000xv0.jpg",[100,107,108],{},[103,109],{"alt":95,"src":110},"\u002Fpic\u002F4af9831b02000xv1.jpg",[100,112,113],{},[103,114],{"alt":95,"src":115},"\u002Fpic\u002F4af9831b02000xv2.jpg",[100,117,118],{},[103,119],{"alt":95,"src":120},"\u002Fpic\u002F4af9831b02000xuz.jpg",[100,122,123],{},[103,124],{"alt":95,"src":125},"\u002Fpic\u002F4af9831b02000xuy.jpg",[100,127,128],{},[103,129],{"alt":95,"src":130},"\u002Fpic\u002F4af9831b02000xux.jpg",[100,132,133],{},"  快杀青了，子弹。",[100,135,136],{},"SO任何幸福和痛苦与时间相比都是瞬间，生命亦然",[100,138,139],{},"贴几张照片，自然排列，没有章法",[100,141,142],{},"反正是我的一段青春，三个女人，和经历后的沧桑小脸",[100,144,145],{},"这戏的前景不明，但却是我迄今付出最多的一部",[100,147,148],{},"  无论身心",[100,150,151],{},"  所以我祝福她",[100,153,154],{},"  也信，只要你看，就会感动",[100,156,157],{},"‘士兵’的日子近了，很遗憾12日没法和众兄弟畅饮‘云南红’了，实在要把‘子弹’坚持完",[100,159,160],{},"还好，有20几号的重庆火锅能吃",[100,162,163],{},"  真想兄弟们",[100,165,166],{},"  ‘士兵’让我们成了战友",[100,168,169],{},"  最近狂拍导致巨累",[100,171,172],{},"以为这里长草了，就穿高跟鞋给新朋旧友问好",[100,174,175],{},"会信守诺言，回京请几个‘老人’吃顿好的",[100,177,178],{},"每次见到你们，无论在哪，还是亲近……",[100,180,181],{},"最近在现场抽空看王朔的‘千岁寒’，又服了",[100,183,184],{},"他成精了，超脱了，拿自己当佛了……",[100,186,187],{},"真佩服哥哥的想象力和胆魄，阅读快感大行其道的今天他又逼我们咬文嚼字了",[100,189,190],{},"‘时间简史’和‘金刚经’繁殖出的不是‘人’需要的营养",[100,192,193],{},"不知对错，反正我认为我看懂了",[100,195,196],{},"  想说的多，时间少，有点乱",[100,198,199],{},"  反正",[100,201,202],{},"橙子又长大了，可以上初中了",[100,204,205],{},"都是这戏的催促和生活他妈",[100,207,208],{},"  逼的",[100,210,211],{},"  以后会更认真……",[100,213,214],{},"  包括吃喝",[100,216,217],{},"既然圣人云：朝闻道，夕死可亦",[100,219,220],{},"我就不再惧怕自己大器晚成了……",{"title":222,"searchDepth":223,"depth":223,"links":224},"",2,[],[6,9],"快杀青了，子弹。","md",{"date":229},"2007-07-06 21:20",true,"\u002Fblog\u002Fblog_4af9831b0100097f",{"title":95,"description":226},"blog_4af9831b0100097f","blog\u002Fblog_4af9831b0100097f",[],"G3h0IA6D5_5ske81G9FmOg2PWvjy1mXJm_Cj9nSKIwU",[238,243],{"title":239,"path":240,"stem":241,"children":-1,"slug":242},"0.03克","\u002Fblog\u002Fblog_4af9831b0100096m","blog\u002Fblog_4af9831b0100096m","blog_4af9831b0100096m",{"title":244,"path":245,"stem":246,"children":-1,"slug":247},"死去   活来","\u002Fblog\u002Fblog_4af9831b010009g3","blog\u002Fblog_4af9831b010009g3","blog_4af9831b010009g3",1795162026190]
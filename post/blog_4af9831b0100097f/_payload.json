[{"data":1,"prerenderedAt":177},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b0100097f":31,"surround-blog_4af9831b0100097f":166},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",151,{"name":9,"len":10},"有图",34,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":155,"description":33,"extension":156,"meta":157,"navigation":159,"path":160,"seo":161,"slug":162,"stem":163,"tags":164,"__hash__":165},"blog\u002Fblog\u002Fblog_4af9831b0100097f.md","不知所云",{"type":35,"value":36,"toc":151},"minimark",[37,47,61,64,67,70,73,76,79,82,85,88,91,94,97,100,103,106,109,112,115,118,121,124,127,130,133,136,139,142,145,148],[38,39,40,44],"p",{},[41,42],"img",{"alt":33,"src":43},"\u002Fpic\u002F4af9831b02000xv0.jpg",[41,45],{"alt":33,"src":46},"\u002Fpic\u002F4af9831b02000xv1.jpg",[38,48,49,52,55,58],{},[41,50],{"alt":33,"src":51},"\u002Fpic\u002F4af9831b02000xv2.jpg",[41,53],{"alt":33,"src":54},"\u002Fpic\u002F4af9831b02000xuz.jpg",[41,56],{"alt":33,"src":57},"\u002Fpic\u002F4af9831b02000xuy.jpg",[41,59],{"alt":33,"src":60},"\u002Fpic\u002F4af9831b02000xux.jpg",[38,62,63],{},"快杀青了，子弹。",[38,65,66],{},"SO任何幸福和痛苦与时间相比都是瞬间，生命亦然",[38,68,69],{},"贴几张照片，自然排列，没有章法",[38,71,72],{},"反正是我的一段青春，三个女人，和经历后的沧桑小脸",[38,74,75],{},"这戏的前景不明，但却是我迄今付出最多的一部",[38,77,78],{},"无论身心",[38,80,81],{},"所以我祝福她",[38,83,84],{},"也信，只要你看，就会感动",[38,86,87],{},"‘士兵’的日子近了，很遗憾12日没法和众兄弟畅饮‘云南红’了，实在要把‘子弹’坚持完",[38,89,90],{},"还好，有20几号的重庆火锅能吃",[38,92,93],{},"真想兄弟们",[38,95,96],{},"‘士兵’让我们成了战友",[38,98,99],{},"最近狂拍导致巨累",[38,101,102],{},"以为这里长草了，就穿高跟鞋给新朋旧友问好",[38,104,105],{},"会信守诺言，回京请几个‘老人’吃顿好的",[38,107,108],{},"每次见到你们，无论在哪，还是亲近……",[38,110,111],{},"最近在现场抽空看王朔的‘千岁寒’，又服了",[38,113,114],{},"他成精了，超脱了，拿自己当佛了……",[38,116,117],{},"真佩服哥哥的想象力和胆魄，阅读快感大行其道的今天他又逼我们咬文嚼字了",[38,119,120],{},"‘时间简史’和‘金刚经’繁殖出的不是‘人’需要的营养",[38,122,123],{},"不知对错，反正我认为我看懂了",[38,125,126],{},"想说的多，时间少，有点乱",[38,128,129],{},"反正",[38,131,132],{},"橙子又长大了，可以上初中了",[38,134,135],{},"都是这戏的催促和生活他妈",[38,137,138],{},"逼的",[38,140,141],{},"以后会更认真……",[38,143,144],{},"包括吃喝",[38,146,147],{},"既然圣人云：朝闻道，夕死可亦",[38,149,150],{},"我就不再惧怕自己大器晚成了……",{"title":152,"searchDepth":153,"depth":153,"links":154},"",2,[],[6,9],"md",{"date":158},"2007-07-06 21:20",true,"\u002Fblog\u002Fblog_4af9831b0100097f",{"title":33,"description":33},"blog_4af9831b0100097f","blog\u002Fblog_4af9831b0100097f",[],"PzDNlKQQW2uKdUBKpMLMv7ALzlAThIyfGOR12HQbUcg",[167,172],{"title":168,"path":169,"stem":170,"children":-1,"slug":171},"0.03克","\u002Fblog\u002Fblog_4af9831b0100096m","blog\u002Fblog_4af9831b0100096m","blog_4af9831b0100096m",{"title":173,"path":174,"stem":175,"children":-1,"slug":176},"死去   活来","\u002Fblog\u002Fblog_4af9831b010009g3","blog\u002Fblog_4af9831b010009g3","blog_4af9831b010009g3",1793777045081]
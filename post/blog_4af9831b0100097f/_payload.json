[{"data":1,"prerenderedAt":230},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":58,"blog-post-slug-blog_4af9831b0100097f":75,"surround-blog_4af9831b0100097f":219},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":54,"site_description":55,"stem":56,"__hash__":57},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo",20,"新浪博客内容备份","settings","hh8X7X6SFDoeJrxIJ4yisZXSc3HwHM1zk206jiQX2XU",{"latestBlog":59},[60,63,66,69,72],{"title":61,"slug":62},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":64,"slug":65},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":67,"slug":68},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":70,"slug":71},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":73,"slug":74},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":76,"title":77,"body":78,"categories":207,"description":208,"extension":209,"meta":210,"navigation":212,"path":213,"seo":214,"slug":215,"stem":216,"tags":217,"__hash__":218},"blog\u002Fblog\u002Fblog_4af9831b0100097f.md","不知所云",{"type":79,"value":80,"toc":203},"minimark",[81,88,93,98,103,108,113,116,119,122,125,128,131,134,137,140,143,146,149,152,155,158,161,164,167,170,173,176,179,182,185,188,191,194,197,200],[82,83,84],"p",{},[85,86],"img",{"alt":77,"src":87},"\u002Fpic\u002F4af9831b02000xv0.jpg",[82,89,90],{},[85,91],{"alt":77,"src":92},"\u002Fpic\u002F4af9831b02000xv1.jpg",[82,94,95],{},[85,96],{"alt":77,"src":97},"\u002Fpic\u002F4af9831b02000xv2.jpg",[82,99,100],{},[85,101],{"alt":77,"src":102},"\u002Fpic\u002F4af9831b02000xuz.jpg",[82,104,105],{},[85,106],{"alt":77,"src":107},"\u002Fpic\u002F4af9831b02000xuy.jpg",[82,109,110],{},[85,111],{"alt":77,"src":112},"\u002Fpic\u002F4af9831b02000xux.jpg",[82,114,115],{},"  快杀青了，子弹。",[82,117,118],{},"SO任何幸福和痛苦与时间相比都是瞬间，生命亦然",[82,120,121],{},"贴几张照片，自然排列，没有章法",[82,123,124],{},"反正是我的一段青春，三个女人，和经历后的沧桑小脸",[82,126,127],{},"这戏的前景不明，但却是我迄今付出最多的一部",[82,129,130],{},"  无论身心",[82,132,133],{},"  所以我祝福她",[82,135,136],{},"  也信，只要你看，就会感动",[82,138,139],{},"‘士兵’的日子近了，很遗憾12日没法和众兄弟畅饮‘云南红’了，实在要把‘子弹’坚持完",[82,141,142],{},"还好，有20几号的重庆火锅能吃",[82,144,145],{},"  真想兄弟们",[82,147,148],{},"  ‘士兵’让我们成了战友",[82,150,151],{},"  最近狂拍导致巨累",[82,153,154],{},"以为这里长草了，就穿高跟鞋给新朋旧友问好",[82,156,157],{},"会信守诺言，回京请几个‘老人’吃顿好的",[82,159,160],{},"每次见到你们，无论在哪，还是亲近……",[82,162,163],{},"最近在现场抽空看王朔的‘千岁寒’，又服了",[82,165,166],{},"他成精了，超脱了，拿自己当佛了……",[82,168,169],{},"真佩服哥哥的想象力和胆魄，阅读快感大行其道的今天他又逼我们咬文嚼字了",[82,171,172],{},"‘时间简史’和‘金刚经’繁殖出的不是‘人’需要的营养",[82,174,175],{},"不知对错，反正我认为我看懂了",[82,177,178],{},"  想说的多，时间少，有点乱",[82,180,181],{},"  反正",[82,183,184],{},"橙子又长大了，可以上初中了",[82,186,187],{},"都是这戏的催促和生活他妈",[82,189,190],{},"  逼的",[82,192,193],{},"  以后会更认真……",[82,195,196],{},"  包括吃喝",[82,198,199],{},"既然圣人云：朝闻道，夕死可亦",[82,201,202],{},"我就不再惧怕自己大器晚成了……",{"title":204,"searchDepth":205,"depth":205,"links":206},"",2,[],[6,9],"快杀青了，子弹。","md",{"date":211},"2007-07-06 21:20",true,"\u002Fblog\u002Fblog_4af9831b0100097f",{"title":77,"description":208},"blog_4af9831b0100097f","blog\u002Fblog_4af9831b0100097f",[],"G3h0IA6D5_5ske81G9FmOg2PWvjy1mXJm_Cj9nSKIwU",[220,225],{"title":221,"path":222,"stem":223,"children":-1,"slug":224},"0.03克","\u002Fblog\u002Fblog_4af9831b0100096m","blog\u002Fblog_4af9831b0100096m","blog_4af9831b0100096m",{"title":226,"path":227,"stem":228,"children":-1,"slug":229},"死去   活来","\u002Fblog\u002Fblog_4af9831b010009g3","blog\u002Fblog_4af9831b010009g3","blog_4af9831b010009g3",1794412501167]
[{"data":1,"prerenderedAt":185},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b0100097f":31,"surround-blog_4af9831b0100097f":174},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",152,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":163,"description":33,"extension":164,"meta":165,"navigation":167,"path":168,"seo":169,"slug":170,"stem":171,"tags":172,"__hash__":173},"blog\u002Fblog\u002Fblog_4af9831b0100097f.md","不知所云",{"type":35,"value":36,"toc":159},"minimark",[37,44,49,54,59,64,69,72,75,78,81,84,87,90,93,96,99,102,105,108,111,114,117,120,123,126,129,132,135,138,141,144,147,150,153,156],[38,39,40],"p",{},[41,42],"img",{"alt":33,"src":43},"\u002Fpic\u002F4af9831b02000xv0.jpg",[38,45,46],{},[41,47],{"alt":33,"src":48},"\u002Fpic\u002F4af9831b02000xv1.jpg",[38,50,51],{},[41,52],{"alt":33,"src":53},"\u002Fpic\u002F4af9831b02000xv2.jpg",[38,55,56],{},[41,57],{"alt":33,"src":58},"\u002Fpic\u002F4af9831b02000xuz.jpg",[38,60,61],{},[41,62],{"alt":33,"src":63},"\u002Fpic\u002F4af9831b02000xuy.jpg",[38,65,66],{},[41,67],{"alt":33,"src":68},"\u002Fpic\u002F4af9831b02000xux.jpg",[38,70,71],{},"  快杀青了，子弹。",[38,73,74],{},"SO任何幸福和痛苦与时间相比都是瞬间，生命亦然",[38,76,77],{},"贴几张照片，自然排列，没有章法",[38,79,80],{},"反正是我的一段青春，三个女人，和经历后的沧桑小脸",[38,82,83],{},"这戏的前景不明，但却是我迄今付出最多的一部",[38,85,86],{},"  无论身心",[38,88,89],{},"  所以我祝福她",[38,91,92],{},"  也信，只要你看，就会感动",[38,94,95],{},"‘士兵’的日子近了，很遗憾12日没法和众兄弟畅饮‘云南红’了，实在要把‘子弹’坚持完",[38,97,98],{},"还好，有20几号的重庆火锅能吃",[38,100,101],{},"  真想兄弟们",[38,103,104],{},"  ‘士兵’让我们成了战友",[38,106,107],{},"  最近狂拍导致巨累",[38,109,110],{},"以为这里长草了，就穿高跟鞋给新朋旧友问好",[38,112,113],{},"会信守诺言，回京请几个‘老人’吃顿好的",[38,115,116],{},"每次见到你们，无论在哪，还是亲近……",[38,118,119],{},"最近在现场抽空看王朔的‘千岁寒’，又服了",[38,121,122],{},"他成精了，超脱了，拿自己当佛了……",[38,124,125],{},"真佩服哥哥的想象力和胆魄，阅读快感大行其道的今天他又逼我们咬文嚼字了",[38,127,128],{},"‘时间简史’和‘金刚经’繁殖出的不是‘人’需要的营养",[38,130,131],{},"不知对错，反正我认为我看懂了",[38,133,134],{},"  想说的多，时间少，有点乱",[38,136,137],{},"  反正",[38,139,140],{},"橙子又长大了，可以上初中了",[38,142,143],{},"都是这戏的催促和生活他妈",[38,145,146],{},"  逼的",[38,148,149],{},"  以后会更认真……",[38,151,152],{},"  包括吃喝",[38,154,155],{},"既然圣人云：朝闻道，夕死可亦",[38,157,158],{},"我就不再惧怕自己大器晚成了……",{"title":160,"searchDepth":161,"depth":161,"links":162},"",2,[],[6,9],"md",{"date":166},"2007-07-06 21:20",true,"\u002Fblog\u002Fblog_4af9831b0100097f",{"title":33,"description":33},"blog_4af9831b0100097f","blog\u002Fblog_4af9831b0100097f",[],"3H1CiDYccT3rGrBq5FX2bPyTbrUX_ApFyLKbu9yBk8Q",[175,180],{"title":176,"path":177,"stem":178,"children":-1,"slug":179},"0.03克","\u002Fblog\u002Fblog_4af9831b0100096m","blog\u002Fblog_4af9831b0100096m","blog_4af9831b0100096m",{"title":181,"path":182,"stem":183,"children":-1,"slug":184},"死去   活来","\u002Fblog\u002Fblog_4af9831b010009g3","blog\u002Fblog_4af9831b010009g3","blog_4af9831b010009g3",1793972060092]
":89,"body":90,"categories":219,"description":220,"extension":221,"meta":222,"navigation":224,"path":225,"seo":226,"slug":227,"stem":228,"tags":229,"__hash__":230},"blog\u002Fblog\u002Fblog_4af9831b0100097f.md","不知所云",{"type":91,"value":92,"toc":215},"minimark",[93,100,105,110,115,120,125,128,131,134,137,140,143,146,149,152,155,158,161,164,167,170,173,176,179,182,185,188,191,194,197,200,203,206,209,212],[94,95,96],"p",{},[97,98],"img",{"alt":89,"src":99},"\u002Fpic\u002F4af9831b02000xv0.jpg",[94,101,102],{},[97,103],{"alt":89,"src":104},"\u002Fpic\u002F4af9831b02000xv1.jpg",[94,106,107],{},[97,108],{"alt":89,"src":109},"\u002Fpic\u002F4af9831b02000xv2.jpg",[94,111,112],{},[97,113],{"alt":89,"src":114},"\u002Fpic\u002F4af9831b02000xuz.jpg",[94,116,117],{},[97,118],{"alt":89,"src":119},"\u002Fpic\u002F4af9831b02000xuy.jpg",[94,121,122],{},[97,123],{"alt":89,"src":124},"\u002Fpic\u002F4af9831b02000xux.jpg",[94,126,127],{},"  快杀青了，子弹。",[94,129,130],{},"SO任何幸福和痛苦与时间相比都是瞬间，生命亦然",[94,132,133],{},"贴几张照片，自然排列，没有章法",[94,135,136],{},"反正是我的一段青春，三个女人，和经历后的沧桑小脸",[94,138,139],{},"这戏的前景不明，但却是我迄今付出最多的一部",[94,141,142],{},"  无论身心",[94,144,145],{},"  所以我祝福她",[94,147,148],{},"  也信，只要你看，就会感动",[94,150,151],{},"‘士兵’的日子近了，很遗憾12日没法和众兄弟畅饮‘云南红’了，实在要把‘子弹’坚持完",[94,153,154],{},"还好，有20几号的重庆火锅能吃",[94,156,157],{},"  真想兄弟们",[94,159,160],{},"  ‘士兵’让我们成了战友",[94,162,163],{},"  最近狂拍导致巨累",[94,165,166],{},"以为这里长草了，就穿高跟鞋给新朋旧友问好",[94,168,169],{},"会信守诺言，回京请几个‘老人’吃顿好的",[94,171,172],{},"每次见到你们，无论在哪，还是亲近……",[94,174,175],{},"最近在现场抽空看王朔的‘千岁寒’，又服了",[94,177,178],{},"他成精了，超脱了，拿自己当佛了……",[94,180,181],{},"真佩服哥哥的想象力和胆魄，阅读快感大行其道的今天他又逼我们咬文嚼字了",[94,183,184],{},"‘时间简史’和‘金刚经’繁殖出的不是‘人’需要的营养",[94,186,187],{},"不知对错，反正我认为我看懂了",[94,189,190],{},"  想说的多，时间少，有点乱",[94,192,193],{},"  反正",[94,195,196],{},"橙子又长大了，可以上初中了",[94,198,199],{},"都是这戏的催促和生活他妈",[94,201,202],{},"  逼的",[94,204,205],{},"  以后会更认真……",[94,207,208],{},"  包括吃喝",[94,210,211],{},"既然圣人云：朝闻道，夕死可亦",[94,213,214],{},"我就不再惧怕自己大器晚成了……",{"title":216,"searchDepth":217,"depth":217,"links":218},"",2,[],[6,9],"快杀青了，子弹。","md",{"date":223},"2007-07-06 21:20",true,"\u002Fblog\u002Fblog_4af9831b0100097f",{"title":89,"description":220},"blog_4af9831b0100097f","blog\u002Fblog_4af9831b0100097f",[],"G3h0IA6D5_5ske81G9FmOg2PWvjy1mXJm_Cj9nSKIwU",[232,237],{"title":233,"path":234,"stem":235,"children":-1,"slug":236},"0.03克","\u002Fblog\u002Fblog_4af9831b0100096m","blog\u002Fblog_4af9831b0100096m","blog_4af9831b0100096m",{"title":238,"path":239,"stem":240,"children":-1,"slug":241},"死去   活来","\u002Fblog\u002Fblog_4af9831b010009g3","blog\u002Fblog_4af9831b010009g3","blog_4af9831b010009g3",1794546770414]
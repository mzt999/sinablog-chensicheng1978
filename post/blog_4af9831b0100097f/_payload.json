[{"data":1,"prerenderedAt":229},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":57,"blog-post-slug-blog_4af9831b0100097f":74,"surround-blog_4af9831b0100097f":218},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":16,"site_description":54,"stem":55,"__hash__":56},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo","新浪博客内容备份(粉丝自用)","settings","jPD1QWrYwbaIixg6lntppEYe-T3ZGd3EJZxFBkbKY9E",{"latestBlog":58},[59,62,65,68,71],{"title":60,"slug":61},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":63,"slug":64},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":66,"slug":67},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":69,"slug":70},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":72,"slug":73},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":75,"title":76,"body":77,"categories":206,"description":207,"extension":208,"meta":209,"navigation":211,"path":212,"seo":213,"slug":214,"stem":215,"tags":216,"__hash__":217},"blog\u002Fblog\u002Fblog_4af9831b0100097f.md","不知所云",{"type":78,"value":79,"toc":202},"minimark",[80,87,92,97,102,107,112,115,118,121,124,127,130,133,136,139,142,145,148,151,154,157,160,163,166,169,172,175,178,181,184,187,190,193,196,199],[81,82,83],"p",{},[84,85],"img",{"alt":76,"src":86},"\u002Fpic\u002F4af9831b02000xv0.jpg",[81,88,89],{},[84,90],{"alt":76,"src":91},"\u002Fpic\u002F4af9831b02000xv1.jpg",[81,93,94],{},[84,95],{"alt":76,"src":96},"\u002Fpic\u002F4af9831b02000xv2.jpg",[81,98,99],{},[84,100],{"alt":76,"src":101},"\u002Fpic\u002F4af9831b02000xuz.jpg",[81,103,104],{},[84,105],{"alt":76,"src":106},"\u002Fpic\u002F4af9831b02000xuy.jpg",[81,108,109],{},[84,110],{"alt":76,"src":111},"\u002Fpic\u002F4af9831b02000xux.jpg",[81,113,114],{},"  快杀青了，子弹。",[81,116,117],{},"SO任何幸福和痛苦与时间相比都是瞬间，生命亦然",[81,119,120],{},"贴几张照片，自然排列，没有章法",[81,122,123],{},"反正是我的一段青春，三个女人，和经历后的沧桑小脸",[81,125,126],{},"这戏的前景不明，但却是我迄今付出最多的一部",[81,128,129],{},"  无论身心",[81,131,132],{},"  所以我祝福她",[81,134,135],{},"  也信，只要你看，就会感动",[81,137,138],{},"‘士兵’的日子近了，很遗憾12日没法和众兄弟畅饮‘云南红’了，实在要把‘子弹’坚持完",[81,140,141],{},"还好，有20几号的重庆火锅能吃",[81,143,144],{},"  真想兄弟们",[81,146,147],{},"  ‘士兵’让我们成了战友",[81,149,150],{},"  最近狂拍导致巨累",[81,152,153],{},"以为这里长草了，就穿高跟鞋给新朋旧友问好",[81,155,156],{},"会信守诺言，回京请几个‘老人’吃顿好的",[81,158,159],{},"每次见到你们，无论在哪，还是亲近……",[81,161,162],{},"最近在现场抽空看王朔的‘千岁寒’，又服了",[81,164,165],{},"他成精了，超脱了，拿自己当佛了……",[81,167,168],{},"真佩服哥哥的想象力和胆魄，阅读快感大行其道的今天他又逼我们咬文嚼字了",[81,170,171],{},"‘时间简史’和‘金刚经’繁殖出的不是‘人’需要的营养",[81,173,174],{},"不知对错，反正我认为我看懂了",[81,176,177],{},"  想说的多，时间少，有点乱",[81,179,180],{},"  反正",[81,182,183],{},"橙子又长大了，可以上初中了",[81,185,186],{},"都是这戏的催促和生活他妈",[81,188,189],{},"  逼的",[81,191,192],{},"  以后会更认真……",[81,194,195],{},"  包括吃喝",[81,197,198],{},"既然圣人云：朝闻道，夕死可亦",[81,200,201],{},"我就不再惧怕自己大器晚成了……",{"title":203,"searchDepth":204,"depth":204,"links":205},"",2,[],[6,9],"快杀青了，子弹。","md",{"date":210},"2007-07-06 21:20",true,"\u002Fblog\u002Fblog_4af9831b0100097f",{"title":76,"description":207},"blog_4af9831b0100097f","blog\u002Fblog_4af9831b0100097f",[],"G3h0IA6D5_5ske81G9FmOg2PWvjy1mXJm_Cj9nSKIwU",[219,224],{"title":220,"path":221,"stem":222,"children":-1,"slug":223},"0.03克","\u002Fblog\u002Fblog_4af9831b0100096m","blog\u002Fblog_4af9831b0100096m","blog_4af9831b0100096m",{"title":225,"path":226,"stem":227,"children":-1,"slug":228},"死去   活来","\u002Fblog\u002Fblog_4af9831b010009g3","blog\u002Fblog_4af9831b010009g3","blog_4af9831b010009g3",1794473705851]
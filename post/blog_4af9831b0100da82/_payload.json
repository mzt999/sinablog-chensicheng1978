[{"data":1,"prerenderedAt":181},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":70,"blog-post-slug-blog_4af9831b0100da82":87,"surround-blog_4af9831b0100da82":170},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":45,"navLinks":46,"perPage":16,"prevNextIsExcludeDate":66,"site_description":23,"site_name":67,"stem":68,"__hash__":69},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{},[47,52,56,60,64],{"path":48,"title":49,"target":50,"fa_class":51},"\u002F","博客首页","internal","fa-home",{"path":53,"title":54,"target":50,"fa_class":55},"\u002Fabout","关于","fa-user",{"path":57,"title":58,"target":50,"fa_class":59},"\u002Fpost","归档","fa-archive",{"path":61,"title":62,"target":50,"fa_class":63},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":65,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","jvZHccz2rT-wjVS5GCPgWyhl8WnBIvECPkE5KpKFKCU",{"latestBlog":71},[72,75,78,81,84],{"title":73,"slug":74},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":76,"slug":77},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":79,"slug":80},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":82,"slug":83},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":85,"slug":86},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":88,"title":89,"body":90,"categories":158,"description":159,"extension":160,"meta":161,"navigation":163,"path":164,"seo":165,"slug":166,"stem":167,"tags":168,"__hash__":169},"blog\u002Fblog\u002Fblog_4af9831b0100da82.md","戛纳电影节的中国之夜",{"type":91,"value":92,"toc":154},"minimark",[93,97,100,103,110,113,118,121,126,129,134,137,142,145,148,151],[94,95,96],"p",{},"今年的戛纳，希望是真正的“预言家”。因为四位华人导演的入围，仿佛预言着中国电影的春天即将到来。",[94,98,99],{},"曾经，我们有香港电影，它的繁荣是所有华人的骄傲。昨天的记录片中我看到了张国荣，哥哥的音容笑貌依旧清晰……是的很多人也许不在了，但他们永存在那光影的世界中，在那些胶片里重生，每一次重放便是一次涅槃……这才是这个职业最有意义的事吧……",[94,101,102],{},"希望下一次的春天能快点到来。中国需要好的电影，且等得太久了……",[94,104,105,106],{},"  ",[107,108],"img",{"alt":89,"src":109},"\u002Fpic\u002F4af9831bx6a2367abddd1.jpg",[94,111,112],{},"李安导演身上具有强烈的中国儒家气质，平和中庸深厚博大……",[94,114,105,115],{},[107,116],{"alt":89,"src":117},"\u002Fpic\u002F4af9831bx6a236c890f11.jpg",[94,119,120],{},"李安太太的亲切让我想到了自己的母亲，更证明了那句：一个成功男人的背后一定会有一个伟大的女人……",[94,122,105,123],{},[107,124],{"alt":89,"src":125},"\u002Fpic\u002F4af9831bx6a23726a28fd.jpg",[94,127,128],{},"  梁朝伟，我从小的偶像，最爱的华人演员，终于戛纳相见……",[94,130,105,131],{},[107,132],{"alt":89,"src":133},"\u002Fpic\u002F4af9831bx6a2375f50ca8.jpg",[94,135,136],{},"舒淇，岁月并没有在她身上过多的雕琢，风华不改且越来越浓，女人，也可以从时间手中赢回自己……",[94,138,105,139],{},[107,140],{"alt":89,"src":141},"\u002Fpic\u002F4af9831bx6a2379a9efb8.jpg",[94,143,144],{},"李安新片“制造伍德斯托克”男主演迪米特里马丁也是个大男孩……",[94,146,147],{},"p\u002Fs:看到橙汁在百度说今天的服装很好看，谢谢Dior homme赞助的《制造伍德斯托克》红毯服装。谢谢雪姐帮我不辞辛苦亲自拎到戛纳……还有你们，每天都来这里看我的橙汁们……",[94,149,150],{},"早安。中国！",[94,152,153],{},"晚安，我的戛纳最后一夜……",{"title":155,"searchDepth":156,"depth":156,"links":157},"",2,[],[6,9],"四位华人导演的入围，仿佛预言着中国电影的春天即将到来。","md",{"date":162},"2009-05-18 06:11",true,"\u002Fblog\u002Fblog_4af9831b0100da82",{"title":89,"description":159},"blog_4af9831b0100da82","blog\u002Fblog_4af9831b0100da82",[],"QJyTq3W_WLN7SKW263Ai98vSCKj-PtFa8rzb3t6j4Rs",[171,176],{"title":172,"path":173,"stem":174,"children":-1,"slug":175},"临行","\u002Fblog\u002Fblog_4af9831b0100d6ps","blog\u002Fblog_4af9831b0100d6ps","blog_4af9831b0100d6ps",{"title":177,"path":178,"stem":179,"children":-1,"slug":180},"春风沉醉嘎纳未醒 寒梅续放横店亦然","\u002Fblog\u002Fblog_4af9831b0100dbqn","blog\u002Fblog_4af9831b0100dbqn","blog_4af9831b0100dbqn",1794544667549]
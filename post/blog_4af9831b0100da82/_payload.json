[{"data":1,"prerenderedAt":169},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":58,"blog-post-slug-blog_4af9831b0100da82":75,"surround-blog_4af9831b0100da82":158},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":54,"site_description":55,"stem":56,"__hash__":57},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo",20,"新浪博客内容备份","settings","hh8X7X6SFDoeJrxIJ4yisZXSc3HwHM1zk206jiQX2XU",{"latestBlog":59},[60,63,66,69,72],{"title":61,"slug":62},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":64,"slug":65},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":67,"slug":68},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":70,"slug":71},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":73,"slug":74},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":76,"title":77,"body":78,"categories":146,"description":147,"extension":148,"meta":149,"navigation":151,"path":152,"seo":153,"slug":154,"stem":155,"tags":156,"__hash__":157},"blog\u002Fblog\u002Fblog_4af9831b0100da82.md","戛纳电影节的中国之夜",{"type":79,"value":80,"toc":142},"minimark",[81,85,88,91,98,101,106,109,114,117,122,125,130,133,136,139],[82,83,84],"p",{},"今年的戛纳，希望是真正的“预言家”。因为四位华人导演的入围，仿佛预言着中国电影的春天即将到来。",[82,86,87],{},"曾经，我们有香港电影，它的繁荣是所有华人的骄傲。昨天的记录片中我看到了张国荣，哥哥的音容笑貌依旧清晰……是的很多人也许不在了，但他们永存在那光影的世界中，在那些胶片里重生，每一次重放便是一次涅槃……这才是这个职业最有意义的事吧……",[82,89,90],{},"希望下一次的春天能快点到来。中国需要好的电影，且等得太久了……",[82,92,93,94],{},"  ",[95,96],"img",{"alt":77,"src":97},"\u002Fpic\u002F4af9831bx6a2367abddd1.jpg",[82,99,100],{},"李安导演身上具有强烈的中国儒家气质，平和中庸深厚博大……",[82,102,93,103],{},[95,104],{"alt":77,"src":105},"\u002Fpic\u002F4af9831bx6a236c890f11.jpg",[82,107,108],{},"李安太太的亲切让我想到了自己的母亲，更证明了那句：一个成功男人的背后一定会有一个伟大的女人……",[82,110,93,111],{},[95,112],{"alt":77,"src":113},"\u002Fpic\u002F4af9831bx6a23726a28fd.jpg",[82,115,116],{},"  梁朝伟，我从小的偶像，最爱的华人演员，终于戛纳相见……",[82,118,93,119],{},[95,120],{"alt":77,"src":121},"\u002Fpic\u002F4af9831bx6a2375f50ca8.jpg",[82,123,124],{},"舒淇，岁月并没有在她身上过多的雕琢，风华不改且越来越浓，女人，也可以从时间手中赢回自己……",[82,126,93,127],{},[95,128],{"alt":77,"src":129},"\u002Fpic\u002F4af9831bx6a2379a9efb8.jpg",[82,131,132],{},"李安新片“制造伍德斯托克”男主演迪米特里马丁也是个大男孩……",[82,134,135],{},"p\u002Fs:看到橙汁在百度说今天的服装很好看，谢谢Dior homme赞助的《制造伍德斯托克》红毯服装。谢谢雪姐帮我不辞辛苦亲自拎到戛纳……还有你们，每天都来这里看我的橙汁们……",[82,137,138],{},"早安。中国！",[82,140,141],{},"晚安，我的戛纳最后一夜……",{"title":143,"searchDepth":144,"depth":144,"links":145},"",2,[],[6,9],"四位华人导演的入围，仿佛预言着中国电影的春天即将到来。","md",{"date":150},"2009-05-18 06:11",true,"\u002Fblog\u002Fblog_4af9831b0100da82",{"title":77,"description":147},"blog_4af9831b0100da82","blog\u002Fblog_4af9831b0100da82",[],"QJyTq3W_WLN7SKW263Ai98vSCKj-PtFa8rzb3t6j4Rs",[159,164],{"title":160,"path":161,"stem":162,"children":-1,"slug":163},"临行","\u002Fblog\u002Fblog_4af9831b0100d6ps","blog\u002Fblog_4af9831b0100d6ps","blog_4af9831b0100d6ps",{"title":165,"path":166,"stem":167,"children":-1,"slug":168},"春风沉醉嘎纳未醒 寒梅续放横店亦然","\u002Fblog\u002Fblog_4af9831b0100dbqn","blog\u002Fblog_4af9831b0100dbqn","blog_4af9831b0100dbqn",1794412500545]
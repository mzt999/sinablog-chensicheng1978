[{"data":1,"prerenderedAt":128},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":17,"blog-post-slug-blog_4af9831b0100da82":34,"surround-blog_4af9831b0100da82":117},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"latestBlog":18},[19,22,25,28,31],{"title":20,"slug":21},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":23,"slug":24},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":26,"slug":27},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":29,"slug":30},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":32,"slug":33},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":35,"title":36,"body":37,"categories":105,"description":106,"extension":107,"meta":108,"navigation":110,"path":111,"seo":112,"slug":113,"stem":114,"tags":115,"__hash__":116},"blog\u002Fblog\u002Fblog_4af9831b0100da82.md","戛纳电影节的中国之夜",{"type":38,"value":39,"toc":101},"minimark",[40,44,47,50,57,60,65,68,73,76,81,84,89,92,95,98],[41,42,43],"p",{},"今年的戛纳，希望是真正的“预言家”。因为四位华人导演的入围，仿佛预言着中国电影的春天即将到来。",[41,45,46],{},"曾经，我们有香港电影，它的繁荣是所有华人的骄傲。昨天的记录片中我看到了张国荣，哥哥的音容笑貌依旧清晰……是的很多人也许不在了，但他们永存在那光影的世界中，在那些胶片里重生，每一次重放便是一次涅槃……这才是这个职业最有意义的事吧……",[41,48,49],{},"希望下一次的春天能快点到来。中国需要好的电影，且等得太久了……",[41,51,52,53],{},"  ",[54,55],"img",{"alt":36,"src":56},"\u002Fpic\u002F4af9831bx6a2367abddd1.jpg",[41,58,59],{},"李安导演身上具有强烈的中国儒家气质，平和中庸深厚博大……",[41,61,52,62],{},[54,63],{"alt":36,"src":64},"\u002Fpic\u002F4af9831bx6a236c890f11.jpg",[41,66,67],{},"李安太太的亲切让我想到了自己的母亲，更证明了那句：一个成功男人的背后一定会有一个伟大的女人……",[41,69,52,70],{},[54,71],{"alt":36,"src":72},"\u002Fpic\u002F4af9831bx6a23726a28fd.jpg",[41,74,75],{},"  梁朝伟，我从小的偶像，最爱的华人演员，终于戛纳相见……",[41,77,52,78],{},[54,79],{"alt":36,"src":80},"\u002Fpic\u002F4af9831bx6a2375f50ca8.jpg",[41,82,83],{},"舒淇，岁月并没有在她身上过多的雕琢，风华不改且越来越浓，女人，也可以从时间手中赢回自己……",[41,85,52,86],{},[54,87],{"alt":36,"src":88},"\u002Fpic\u002F4af9831bx6a2379a9efb8.jpg",[41,90,91],{},"李安新片“制造伍德斯托克”男主演迪米特里马丁也是个大男孩……",[41,93,94],{},"p\u002Fs:看到橙汁在百度说今天的服装很好看，谢谢Dior homme赞助的《制造伍德斯托克》红毯服装。谢谢雪姐帮我不辞辛苦亲自拎到戛纳……还有你们，每天都来这里看我的橙汁们……",[41,96,97],{},"早安。中国！",[41,99,100],{},"晚安，我的戛纳最后一夜……",{"title":102,"searchDepth":103,"depth":103,"links":104},"",2,[],[6,9],"四位华人导演的入围，仿佛预言着中国电影的春天即将到来。","md",{"date":109},"2009-05-18 06:11",true,"\u002Fblog\u002Fblog_4af9831b0100da82",{"title":36,"description":106},"blog_4af9831b0100da82","blog\u002Fblog_4af9831b0100da82",[],"QJyTq3W_WLN7SKW263Ai98vSCKj-PtFa8rzb3t6j4Rs",[118,123],{"title":119,"path":120,"stem":121,"children":-1,"slug":122},"临行","\u002Fblog\u002Fblog_4af9831b0100d6ps","blog\u002Fblog_4af9831b0100d6ps","blog_4af9831b0100d6ps",{"title":124,"path":125,"stem":126,"children":-1,"slug":127},"春风沉醉嘎纳未醒 寒梅续放横店亦然","\u002Fblog\u002Fblog_4af9831b0100dbqn","blog\u002Fblog_4af9831b0100dbqn","blog_4af9831b0100dbqn",1794045953593]
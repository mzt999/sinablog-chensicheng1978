[{"data":1,"prerenderedAt":187},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":76,"blog-post-slug-blog_4af9831b0100da82":93,"surround-blog_4af9831b0100da82":176},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":38,"meta":50,"navLinks":51,"perPage":16,"prevNextIsExcludeDate":71,"site_description":72,"site_name":73,"stem":74,"__hash__":75},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,26,32],{"text":23},"粉丝自制非官方站点｜素材版权归原权利人所有",{"text":25},"仅兴趣交流、无商业用途｜如有侵权请联系删除",{"text":27,"link":28},"查看",{"href":29,"text":30,"fa_class":31},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":33,"link":34},"如有任何疑问，欢迎",{"href":35,"text":36,"fa_class":37},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[39,42,45,47],{"href":40,"text":41},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":43,"text":44},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":46},"新浪微博备份(2009-2026)",{"href":48,"text":49},"https:\u002F\u002Fmzt999.github.io\u002Fportfolio-chensicheng1978","幕后作品集展示(2012-2026)",{},[52,57,61,65,69],{"path":53,"title":54,"target":55,"fa_class":56},"\u002F","博客首页","internal","fa-home",{"path":58,"title":59,"target":55,"fa_class":60},"\u002Fabout","关于","fa-user",{"path":62,"title":63,"target":55,"fa_class":64},"\u002Fpost","归档","fa-archive",{"path":66,"title":67,"target":55,"fa_class":68},"\u002Fgallery","相册","fa-image",{"path":29,"title":30,"target":70,"fa_class":31},"otherSite",false,"新浪博客内容备份(粉丝自用)","陈思诚的博客","settings","5S7xKt0XLHpkjipbomx4I7pUu50Y7wqtD418LquZj5Q",{"latestBlog":77},[78,81,84,87,90],{"title":79,"slug":80},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":82,"slug":83},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":85,"slug":86},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":88,"slug":89},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":91,"slug":92},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":94,"title":95,"body":96,"categories":164,"description":165,"extension":166,"meta":167,"navigation":169,"path":170,"seo":171,"slug":172,"stem":173,"tags":174,"__hash__":175},"blog\u002Fblog\u002Fblog_4af9831b0100da82.md","戛纳电影节的中国之夜",{"type":97,"value":98,"toc":160},"minimark",[99,103,106,109,116,119,124,127,132,135,140,143,148,151,154,157],[100,101,102],"p",{},"今年的戛纳，希望是真正的“预言家”。因为四位华人导演的入围，仿佛预言着中国电影的春天即将到来。",[100,104,105],{},"曾经，我们有香港电影，它的繁荣是所有华人的骄傲。昨天的记录片中我看到了张国荣，哥哥的音容笑貌依旧清晰……是的很多人也许不在了，但他们永存在那光影的世界中，在那些胶片里重生，每一次重放便是一次涅槃……这才是这个职业最有意义的事吧……",[100,107,108],{},"希望下一次的春天能快点到来。中国需要好的电影，且等得太久了……",[100,110,111,112],{},"  ",[113,114],"img",{"alt":95,"src":115},"\u002Fpic\u002F4af9831bx6a2367abddd1.jpg",[100,117,118],{},"李安导演身上具有强烈的中国儒家气质，平和中庸深厚博大……",[100,120,111,121],{},[113,122],{"alt":95,"src":123},"\u002Fpic\u002F4af9831bx6a236c890f11.jpg",[100,125,126],{},"李安太太的亲切让我想到了自己的母亲，更证明了那句：一个成功男人的背后一定会有一个伟大的女人……",[100,128,111,129],{},[113,130],{"alt":95,"src":131},"\u002Fpic\u002F4af9831bx6a23726a28fd.jpg",[100,133,134],{},"  梁朝伟，我从小的偶像，最爱的华人演员，终于戛纳相见……",[100,136,111,137],{},[113,138],{"alt":95,"src":139},"\u002Fpic\u002F4af9831bx6a2375f50ca8.jpg",[100,141,142],{},"舒淇，岁月并没有在她身上过多的雕琢，风华不改且越来越浓，女人，也可以从时间手中赢回自己……",[100,144,111,145],{},[113,146],{"alt":95,"src":147},"\u002Fpic\u002F4af9831bx6a2379a9efb8.jpg",[100,149,150],{},"李安新片“制造伍德斯托克”男主演迪米特里马丁也是个大男孩……",[100,152,153],{},"p\u002Fs:看到橙汁在百度说今天的服装很好看，谢谢Dior homme赞助的《制造伍德斯托克》红毯服装。谢谢雪姐帮我不辞辛苦亲自拎到戛纳……还有你们，每天都来这里看我的橙汁们……",[100,155,156],{},"早安。中国！",[100,158,159],{},"晚安，我的戛纳最后一夜……",{"title":161,"searchDepth":162,"depth":162,"links":163},"",2,[],[6,9],"四位华人导演的入围，仿佛预言着中国电影的春天即将到来。","md",{"date":168},"2009-05-18 06:11",true,"\u002Fblog\u002Fblog_4af9831b0100da82",{"title":95,"description":165},"blog_4af9831b0100da82","blog\u002Fblog_4af9831b0100da82",[],"QJyTq3W_WLN7SKW263Ai98vSCKj-PtFa8rzb3t6j4Rs",[177,182],{"title":178,"path":179,"stem":180,"children":-1,"slug":181},"临行","\u002Fblog\u002Fblog_4af9831b0100d6ps","blog\u002Fblog_4af9831b0100d6ps","blog_4af9831b0100d6ps",{"title":183,"path":184,"stem":185,"children":-1,"slug":186},"春风沉醉嘎纳未醒 寒梅续放横店亦然","\u002Fblog\u002Fblog_4af9831b0100dbqn","blog\u002Fblog_4af9831b0100dbqn","blog_4af9831b0100dbqn",1795162025728]
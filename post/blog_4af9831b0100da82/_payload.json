[{"data":1,"prerenderedAt":124},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b0100da82":31,"surround-blog_4af9831b0100da82":113},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",151,{"name":9,"len":10},"有图",34,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":102,"description":33,"extension":103,"meta":104,"navigation":106,"path":107,"seo":108,"slug":109,"stem":110,"tags":111,"__hash__":112},"blog\u002Fblog\u002Fblog_4af9831b0100da82.md","戛纳电影节的中国之夜",{"type":35,"value":36,"toc":98},"minimark",[37,41,44,47,54,57,62,65,70,73,78,81,86,89,92,95],[38,39,40],"p",{},"今年的戛纳，希望是真正的“预言家”。因为四位华人导演的入围，仿佛预言着中国电影的春天即将到来。",[38,42,43],{},"曾经，我们有香港电影，它的繁荣是所有华人的骄傲。昨天的记录片中我看到了张国荣，哥哥的音容笑貌依旧清晰……是的很多人也许不在了，但他们永存在那光影的世界中，在那些胶片里重生，每一次重放便是一次涅槃……这才是这个职业最有意义的事吧……",[38,45,46],{},"希望下一次的春天能快点到来。中国需要好的电影，且等得太久了……",[38,48,49,50],{},"  ",[51,52],"img",{"alt":33,"src":53},"\u002Fpic\u002F4af9831bx6a2367abddd1.jpg",[38,55,56],{},"李安导演身上具有强烈的中国儒家气质，平和中庸深厚博大……",[38,58,49,59],{},[51,60],{"alt":33,"src":61},"\u002Fpic\u002F4af9831bx6a236c890f11.jpg",[38,63,64],{},"李安太太的亲切让我想到了自己的母亲，更证明了那句：一个成功男人的背后一定会有一个伟大的女人……",[38,66,49,67],{},[51,68],{"alt":33,"src":69},"\u002Fpic\u002F4af9831bx6a23726a28fd.jpg",[38,71,72],{},"  梁朝伟，我从小的偶像，最爱的华人演员，终于戛纳相见……",[38,74,49,75],{},[51,76],{"alt":33,"src":77},"\u002Fpic\u002F4af9831bx6a2375f50ca8.jpg",[38,79,80],{},"舒淇，岁月并没有在她身上过多的雕琢，风华不改且越来越浓，女人，也可以从时间手中赢回自己……",[38,82,49,83],{},[51,84],{"alt":33,"src":85},"\u002Fpic\u002F4af9831bx6a2379a9efb8.jpg",[38,87,88],{},"李安新片“制造伍德斯托克”男主演迪米特里马丁也是个大男孩……",[38,90,91],{},"p\u002Fs:看到橙汁在百度说今天的服装很好看，谢谢Dior homme赞助的《制造伍德斯托克》红毯服装。谢谢雪姐帮我不辞辛苦亲自拎到戛纳……还有你们，每天都来这里看我的橙汁们……",[38,93,94],{},"早安。中国！",[38,96,97],{},"晚安，我的戛纳最后一夜……",{"title":99,"searchDepth":100,"depth":100,"links":101},"",2,[],[6,9],"md",{"date":105},"2009-05-18 06:11",true,"\u002Fblog\u002Fblog_4af9831b0100da82",{"title":33,"description":33},"blog_4af9831b0100da82","blog\u002Fblog_4af9831b0100da82",[],"Z5EmYc5e4eSpJt2njqO8XDes3f6XaMe1-HRfFkmHH-s",[114,119],{"title":115,"path":116,"stem":117,"children":-1,"slug":118},"临行","\u002Fblog\u002Fblog_4af9831b0100d6ps","blog\u002Fblog_4af9831b0100d6ps","blog_4af9831b0100d6ps",{"title":120,"path":121,"stem":122,"children":-1,"slug":123},"春风沉醉嘎纳未醒 寒梅续放横店亦…","\u002Fblog\u002Fblog_4af9831b0100dbqn","blog\u002Fblog_4af9831b0100dbqn","blog_4af9831b0100dbqn",1793800806917]
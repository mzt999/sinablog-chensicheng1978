[{"data":1,"prerenderedAt":156},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":57,"blog-post-slug-blog_4af9831b0100aiz0":74,"surround-blog_4af9831b0100aiz0":145},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":16,"site_description":54,"stem":55,"__hash__":56},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo","新浪博客内容备份(粉丝自用)","settings","jPD1QWrYwbaIixg6lntppEYe-T3ZGd3EJZxFBkbKY9E",{"latestBlog":58},[59,62,65,68,71],{"title":60,"slug":61},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":63,"slug":64},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":66,"slug":67},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":69,"slug":70},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":72,"slug":73},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":75,"title":76,"body":77,"categories":133,"description":83,"extension":134,"meta":135,"navigation":137,"path":138,"seo":139,"slug":140,"stem":141,"tags":142,"__hash__":144},"blog\u002Fblog\u002Fblog_4af9831b0100aiz0.md","命运",{"type":78,"value":79,"toc":129},"minimark",[80,84,87,90,93,96,99,102,105,108,111,114,117,120,123,126],[81,82,83],"p",{},"长沙回京的飞机上,看完了蔷薇写的\"薇园之恋\".感动于你们的梦想.没错,有梦的人就是幸者.",[81,85,86],{},"近两个月的蛰伏只为证明一件事情...命运,究竟归谁掌控...",[81,88,89],{},"总认为人定胜天,渐渐才发现,我们依旧站在地上.",[81,91,92],{},"奇迹终究没能发生.它随着08奥运的闭幕也收起了梦想的翅膀.",[81,94,95],{},"金鹰节如同新的哨令枪,兄弟们又站在了各自的起跑线...新的征程,新的想聚,新的体验,新的分离...",[81,97,98],{},"命运.我后面工作的名字.如同启示,让我感知.",[81,100,101],{},"我站在路上,前方无限延伸,时间,分秒流逝...我几乎无力把握住任何东西...前方的面孔愈发模糊,甚至没了具像...",[81,103,104],{},"  歌声远比从前悦耳,却没了灵魂.我们总让自己更加苍白,用时间的板擦把生命的色彩一一抹去.快乐,越来越少...成长确是如此,跋涉,到了彼岸,丢了最初的珍贵.",[81,106,107],{},"  我想我该晒晒太阳...",[81,109,110],{},"命运.向我召唤.",[81,112,113],{},"我只能目不转睛,专注着心无旁骛的和它对视...",[81,115,116],{},"至此,我开始一步一步的前行...",[81,118,119],{},"我会像世界证明:",[81,121,122],{},"断了杂念的我该有多么可怕...",[81,124,125],{},"  命运.",[81,127,128],{},"  我来了...",{"title":130,"searchDepth":131,"depth":131,"links":132},"",2,[],[6],"md",{"date":136},"2008-09-02 14:04",true,"\u002Fblog\u002Fblog_4af9831b0100aiz0",{"title":76,"description":83},"blog_4af9831b0100aiz0","blog\u002Fblog_4af9831b0100aiz0",[143],"杂谈","PmpzdxwDEjWyA5lioxRjMsiy40jldfpwrdySNNyAEYk",[146,151],{"title":147,"path":148,"stem":149,"children":-1,"slug":150},"分享","\u002Fblog\u002Fblog_4af9831b0100a44t","blog\u002Fblog_4af9831b0100a44t","blog_4af9831b0100a44t",{"title":152,"path":153,"stem":154,"children":-1,"slug":155},"祝福 献给“命运”","\u002Fblog\u002Fblog_4af9831b0100aof0","blog\u002Fblog_4af9831b0100aof0","blog_4af9831b0100aof0",1794473705319]
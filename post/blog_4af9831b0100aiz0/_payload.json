[{"data":1,"prerenderedAt":169},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":70,"blog-post-slug-blog_4af9831b0100aiz0":87,"surround-blog_4af9831b0100aiz0":158},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":45,"navLinks":46,"perPage":16,"prevNextIsExcludeDate":66,"site_description":23,"site_name":67,"stem":68,"__hash__":69},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{},[47,52,56,60,64],{"path":48,"title":49,"target":50,"fa_class":51},"\u002F","博客首页","internal","fa-home",{"path":53,"title":54,"target":50,"fa_class":55},"\u002Fabout","关于","fa-user",{"path":57,"title":58,"target":50,"fa_class":59},"\u002Fpost","归档","fa-archive",{"path":61,"title":62,"target":50,"fa_class":63},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":65,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","jvZHccz2rT-wjVS5GCPgWyhl8WnBIvECPkE5KpKFKCU",{"latestBlog":71},[72,75,78,81,84],{"title":73,"slug":74},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":76,"slug":77},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":79,"slug":80},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":82,"slug":83},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":85,"slug":86},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":88,"title":89,"body":90,"categories":146,"description":96,"extension":147,"meta":148,"navigation":150,"path":151,"seo":152,"slug":153,"stem":154,"tags":155,"__hash__":157},"blog\u002Fblog\u002Fblog_4af9831b0100aiz0.md","命运",{"type":91,"value":92,"toc":142},"minimark",[93,97,100,103,106,109,112,115,118,121,124,127,130,133,136,139],[94,95,96],"p",{},"长沙回京的飞机上,看完了蔷薇写的\"薇园之恋\".感动于你们的梦想.没错,有梦的人就是幸者.",[94,98,99],{},"近两个月的蛰伏只为证明一件事情...命运,究竟归谁掌控...",[94,101,102],{},"总认为人定胜天,渐渐才发现,我们依旧站在地上.",[94,104,105],{},"奇迹终究没能发生.它随着08奥运的闭幕也收起了梦想的翅膀.",[94,107,108],{},"金鹰节如同新的哨令枪,兄弟们又站在了各自的起跑线...新的征程,新的想聚,新的体验,新的分离...",[94,110,111],{},"命运.我后面工作的名字.如同启示,让我感知.",[94,113,114],{},"我站在路上,前方无限延伸,时间,分秒流逝...我几乎无力把握住任何东西...前方的面孔愈发模糊,甚至没了具像...",[94,116,117],{},"  歌声远比从前悦耳,却没了灵魂.我们总让自己更加苍白,用时间的板擦把生命的色彩一一抹去.快乐,越来越少...成长确是如此,跋涉,到了彼岸,丢了最初的珍贵.",[94,119,120],{},"  我想我该晒晒太阳...",[94,122,123],{},"命运.向我召唤.",[94,125,126],{},"我只能目不转睛,专注着心无旁骛的和它对视...",[94,128,129],{},"至此,我开始一步一步的前行...",[94,131,132],{},"我会像世界证明:",[94,134,135],{},"断了杂念的我该有多么可怕...",[94,137,138],{},"  命运.",[94,140,141],{},"  我来了...",{"title":143,"searchDepth":144,"depth":144,"links":145},"",2,[],[6],"md",{"date":149},"2008-09-02 14:04",true,"\u002Fblog\u002Fblog_4af9831b0100aiz0",{"title":89,"description":96},"blog_4af9831b0100aiz0","blog\u002Fblog_4af9831b0100aiz0",[156],"杂谈","PmpzdxwDEjWyA5lioxRjMsiy40jldfpwrdySNNyAEYk",[159,164],{"title":160,"path":161,"stem":162,"children":-1,"slug":163},"分享","\u002Fblog\u002Fblog_4af9831b0100a44t","blog\u002Fblog_4af9831b0100a44t","blog_4af9831b0100a44t",{"title":165,"path":166,"stem":167,"children":-1,"slug":168},"祝福 献给“命运”","\u002Fblog\u002Fblog_4af9831b0100aof0","blog\u002Fblog_4af9831b0100aof0","blog_4af9831b0100aof0",1794544667650]
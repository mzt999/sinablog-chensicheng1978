[{"data":1,"prerenderedAt":168},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":70,"blog-post-slug-blog_4af9831b01007q66":87,"surround-blog_4af9831b01007q66":157},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":45,"navLinks":46,"perPage":16,"prevNextIsExcludeDate":66,"site_description":23,"site_name":67,"stem":68,"__hash__":69},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{},[47,52,56,60,64],{"path":48,"title":49,"target":50,"fa_class":51},"\u002F","博客首页","internal","fa-home",{"path":53,"title":54,"target":50,"fa_class":55},"\u002Fabout","关于","fa-user",{"path":57,"title":58,"target":50,"fa_class":59},"\u002Fpost","归档","fa-archive",{"path":61,"title":62,"target":50,"fa_class":63},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":65,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","jvZHccz2rT-wjVS5GCPgWyhl8WnBIvECPkE5KpKFKCU",{"latestBlog":71},[72,75,78,81,84],{"title":73,"slug":74},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":76,"slug":77},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":79,"slug":80},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":82,"slug":83},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":85,"slug":86},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":88,"title":89,"body":90,"categories":146,"description":96,"extension":147,"meta":148,"navigation":150,"path":151,"seo":152,"slug":153,"stem":154,"tags":155,"__hash__":156},"blog\u002Fblog\u002Fblog_4af9831b01007q66.md","现实照进梦想 --- 望月",{"type":91,"value":92,"toc":142},"minimark",[93,97,100,103,106,109,112,115,118,121,124,127,130,133,136,139],[94,95,96],"p",{},"下午录制了北京台的\"名人堂\"喜欢和\"非本专业人士\"的融合互喷!比较带劲!",[94,98,99],{},"大前天还录了\"夫妻天下\",居然!我这个八字另外一撇还不见踪影的家伙也舔着脸去谈\"婚后\"谈\"爱情\"谈\"子女\"...乍听振振有辞,其实胡说八道!",[94,101,102],{},"现在3点,本该睡了.但是为了个承诺,所以上来.",[94,104,105],{},"  下午又再谈\"三多\"谈\"成才\"!我的身边多了个\"超级成才拥趸\"上市公司\"慧聪网的\"CEO\"郭凡声生先生!其实他就是个成才,比成才还成才的成才!",[94,107,108],{},"  不想说这个访谈,节目自己去看!还是在这样的夜里抒情比较合适...",[110,111],"hr",{},[94,113,114],{},"                   (以上为若干天前由于困意未发表部分)",[94,116,117],{},"  说什么呢?说现实.",[94,119,120],{},"  现实是一道光,照进了我梦想的领地!我不正常!我本末倒置!我的世界梦想占领着大处,但是,一道光闯了进来!是现实的光!现在也许微弱,但我看得清楚!着实!不是别的光!是月光!",[94,122,123],{},"  我想当太阳,所以我是个孩子,我不成熟,我不事故,我狂,我呆,我倔,我弱智我承认!可谁又不想当太阳?点燃自己,照亮大地?只是有城府的人不说只做...可我不行,我肤浅,我藏不住事,我得疯狂叫嚣四处卖弄,总让人觉着特别有病特别招摇最好吸引各种流弹的出头鸟其实不过就是为了给自己增加点心理暗示鼓个小劲儿加个小油儿什么的小伎小俩罢了...",[94,125,126],{},"所以,我不是太阳.谁也不是,太阳就是太阳!其实我就是个手电筒.",[94,128,129],{},"手电筒还是充电式的,照度特别有限,在很久的以前勉强能充混家用电器,现在最大的功能是频繁显身于各种法制节目里抓嫖抓赌的现场中...",[94,131,132],{},"光和光----最暗的地方见!",[94,134,135],{},"天黑,我才算找到了自己!开始发功!牛X!射哪哪清楚,照哪哪舒服!正自得,就感觉到头上有个比我更大的发光体!我当即翻脸向天怒目而视,准备趁机找茬搓架泻私愤,照到对方,却发现是个姑娘!",[94,137,138],{},"这姑娘脸挺圆,眼睛也圆,周身都圆,看着眼熟,忽让我想起\"太阳\"!就立马舔脸谄媚一副奴才像的凑过去问对方是不是我偶像的近亲或旁支!可丫眨了眨圆眼睛只简单的回了四个字\"太阳谁啊?...\"靠!!漂亮!!!美!!!!只瞬间,各种大俗词从我脑子里不断涌现!可没办法,按都按不住!此刻只有这种最俗的词才能表达我波澜壮阔的心情!!!废了!功力全失!毫无抵抗!电筒立马被征服,准备献出爱情...",[94,140,141],{},"(未完,待续)",{"title":143,"searchDepth":144,"depth":144,"links":145},"",2,[],[6],"md",{"date":149},"2007-12-25 00:48",true,"\u002Fblog\u002Fblog_4af9831b01007q66",{"title":89,"description":96},"blog_4af9831b01007q66","blog\u002Fblog_4af9831b01007q66",[],"I9sq1hwIF_hGuilLaOVVZNzkpLOw89N2Q3D9ERbElGo",[158,163],{"title":159,"path":160,"stem":161,"children":-1,"slug":162},"温暖","\u002Fblog\u002Fblog_4af9831b01007ntv","blog\u002Fblog_4af9831b01007ntv","blog_4af9831b01007ntv",{"title":164,"path":165,"stem":166,"children":-1,"slug":167},"平安夜","\u002Fblog\u002Fblog_4af9831b01007sio","blog\u002Fblog_4af9831b01007sio","blog_4af9831b01007sio",1794544667790]
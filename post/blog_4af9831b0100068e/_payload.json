":89,"body":90,"categories":110,"description":111,"extension":112,"meta":113,"navigation":115,"path":116,"seo":117,"slug":118,"stem":119,"tags":120,"__hash__":121},"blog\u002Fblog\u002Fblog_4af9831b0100068e.md","想告别三心二意的岁月",{"type":91,"value":92,"toc":106},"minimark",[93,97,100,103],[94,95,96],"p",{},"几天前还在想\n以后的博客也要找人代写 作为未来宣传的一部分\n因为实在觉得一切和网络有关的东西都很复杂很乱很烦\n但从11月27日郁闷的那晚开始\n就决定以后把这里当作最好的和自己交流的地方 就像日记\n可以在老去后还能从文字中寻觅以往种种心情的流失",[94,98,99],{},"这可能也是这里以后会和别人不同的地方 在这里的我一定是最真实的\n最感性的 最状态的",[94,101,102],{},"我一直很浮躁\n好多了解我的人都这样说 就这样浮躁的一转眼到了决不该再浮躁的年龄\n有越来越多的事要去担当 再不是只为了自己活着\n我想生活的砂石是没有什么磨不平的吧 我真的应该脚踏实地了\n不是吗",[94,104,105],{},"想告别三心二意的岁月\n这包括太多 最少此刻的我是这样想的",{"title":107,"searchDepth":108,"depth":108,"links":109},"",2,[],[6],"几天前还在想 以后的博客也要找人代写 作为未来宣传的一部分","md",{"date":114},"2006-12-01 00:20",true,"\u002Fblog\u002Fblog_4af9831b0100068e",{"title":89,"description":111},"blog_4af9831b0100068e","blog\u002Fblog_4af9831b0100068e",[],"ZjgoaQ8jVHWaVD04QEWkUrSUvzY3Aq_ldNEeHxcpyPE",[123,128],{"title":124,"path":125,"stem":126,"children":-1,"slug":127},"猜猜哪个是我？","\u002Fblog\u002Fblog_4af9831b0100067c","blog\u002Fblog_4af9831b0100067c","blog_4af9831b0100067c",{"title":129,"path":130,"stem":131,"children":-1,"slug":132},"第四晚 心情","\u002Fblog\u002Fblog_4af9831b010006b2","blog\u002Fblog_4af9831b010006b2","blog_4af9831b010006b2",1794546770806]
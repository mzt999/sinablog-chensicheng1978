[{"data":1,"prerenderedAt":110},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":17,"blog-post-slug-blog_4af9831b0100h0o9":34,"surround-blog_4af9831b0100h0o9":99},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"latestBlog":18},[19,22,25,28,31],{"title":20,"slug":21},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":23,"slug":24},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":26,"slug":27},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":29,"slug":30},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":32,"slug":33},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":35,"title":36,"body":37,"categories":87,"description":58,"extension":88,"meta":89,"navigation":91,"path":92,"seo":93,"slug":94,"stem":95,"tags":96,"__hash__":98},"blog\u002Fblog\u002Fblog_4af9831b0100h0o9.md","仰视天堂",{"type":38,"value":39,"toc":83},"minimark",[40,47,50,53,56,59,62,65,68,71,74,77,80],[41,42,43],"p",{},[44,45],"img",{"alt":36,"src":46},"\u002Fpic\u002F4af9831bt7f69886655fd.jpg",[41,48,49],{},"中国传统的阴历年计，今天，才是这年的最后一天。",[41,51,52],{},"明天，一切又是个开始。新的一年，新的启程……",[41,54,55],{},"09年不想说太多，相对回首此时我更愿展望。",[41,57,58],{},"‘仰视天堂’是03年我为班里写的一个毕业大戏，后因校方干预无疾而终……",[41,60,61],{},"艺术创作上不存在孤注一掷，任何心血都不会付之东流。如同我的‘奇迹’，那些影响都深植于我的骨格血脉与我融会贯通于一处，所以我不绝望，艺术，不存在流产。",[41,63,64],{},"请允许我说‘艺术’，相对于现在的浮躁。",[41,66,67],{},"再一次的仰视天堂是于09年中，我身后的苍穹青山云朵霞光都仿佛是那上万间僧舍的映衬——甘孜州阿坝州的藏区，团坐着全世界最大的佛学院——五明。",[41,69,70],{},"在那里你的心会澄清的透明，想大喊，想默念，想倾吐，想忏悔……心向往之，甚至愿化青烟一缕浅挂天边片刻俯瞰——芸芸众生，其实和那白云苍狗没有两样，聚散终如一曲毕，并无绕梁三日音……",[41,72,73],{},"我信佛，也信有天堂，更信我们那7克重量不会无的放矢，尘归尘土归土，一切机缘终究都会有个去处。",[41,75,76],{},"且让我们静坐菩提岸，笑看时光转，一杯酒一盏茶，一个吻一滴泪，一首歌一场梦，一世痴迷一生荒唐的走过吧……",[41,78,79],{},"不愿你别的，只想你善良……",[41,81,82],{},"新的一年就要来了，祈福所有此篇观者，下一年中幸福安康……阿弥陀佛虎年吉祥……",{"title":84,"searchDepth":85,"depth":85,"links":86},"",2,[],[6,9],"md",{"date":90},"2010-02-13 00:10",true,"\u002Fblog\u002Fblog_4af9831b0100h0o9",{"title":36,"description":58},"blog_4af9831b0100h0o9","blog\u002Fblog_4af9831b0100h0o9",[97],"杂谈","mgXJ_hoLbJWHehiACBmoRBquTB3yDES2hRJIfrjXyH4",[100,105],{"title":101,"path":102,"stem":103,"children":-1,"slug":104},"李晨这个人","\u002Fblog\u002Fblog_4af9831b0100gvim","blog\u002Fblog_4af9831b0100gvim","blog_4af9831b0100gvim",{"title":106,"path":107,"stem":108,"children":-1,"slug":109},"守望","\u002Fblog\u002Fblog_4af9831b0100h6ee","blog\u002Fblog_4af9831b0100h6ee","blog_4af9831b0100h6ee",1794059572573]
[{"data":1,"prerenderedAt":169},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":76,"blog-post-slug-blog_4af9831b0100h0o9":93,"surround-blog_4af9831b0100h0o9":158},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":38,"meta":50,"navLinks":51,"perPage":16,"prevNextIsExcludeDate":71,"site_description":72,"site_name":73,"stem":74,"__hash__":75},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,26,32],{"text":23},"粉丝自制非官方站点｜素材版权归原权利人所有",{"text":25},"仅兴趣交流、无商业用途｜如有侵权请联系删除",{"text":27,"link":28},"查看",{"href":29,"text":30,"fa_class":31},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":33,"link":34},"如有任何疑问，欢迎",{"href":35,"text":36,"fa_class":37},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[39,42,45,47],{"href":40,"text":41},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":43,"text":44},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":46},"新浪微博备份(2009-2026)",{"href":48,"text":49},"https:\u002F\u002Fmzt999.github.io\u002Fportfolio-chensicheng1978","幕后作品集展示(2012-2026)",{},[52,57,61,65,69],{"path":53,"title":54,"target":55,"fa_class":56},"\u002F","博客首页","internal","fa-home",{"path":58,"title":59,"target":55,"fa_class":60},"\u002Fabout","关于","fa-user",{"path":62,"title":63,"target":55,"fa_class":64},"\u002Fpost","归档","fa-archive",{"path":66,"title":67,"target":55,"fa_class":68},"\u002Fgallery","相册","fa-image",{"path":29,"title":30,"target":70,"fa_class":31},"otherSite",false,"新浪博客内容备份(粉丝自用)","陈思诚的博客","settings","5S7xKt0XLHpkjipbomx4I7pUu50Y7wqtD418LquZj5Q",{"latestBlog":77},[78,81,84,87,90],{"title":79,"slug":80},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":82,"slug":83},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":85,"slug":86},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":88,"slug":89},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":91,"slug":92},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":94,"title":95,"body":96,"categories":146,"description":117,"extension":147,"meta":148,"navigation":150,"path":151,"seo":152,"slug":153,"stem":154,"tags":155,"__hash__":157},"blog\u002Fblog\u002Fblog_4af9831b0100h0o9.md","仰视天堂",{"type":97,"value":98,"toc":142},"minimark",[99,106,109,112,115,118,121,124,127,130,133,136,139],[100,101,102],"p",{},[103,104],"img",{"alt":95,"src":105},"\u002Fpic\u002F4af9831bt7f69886655fd.jpg",[100,107,108],{},"中国传统的阴历年计，今天，才是这年的最后一天。",[100,110,111],{},"明天，一切又是个开始。新的一年，新的启程……",[100,113,114],{},"09年不想说太多，相对回首此时我更愿展望。",[100,116,117],{},"‘仰视天堂’是03年我为班里写的一个毕业大戏，后因校方干预无疾而终……",[100,119,120],{},"艺术创作上不存在孤注一掷，任何心血都不会付之东流。如同我的‘奇迹’，那些影响都深植于我的骨格血脉与我融会贯通于一处，所以我不绝望，艺术，不存在流产。",[100,122,123],{},"请允许我说‘艺术’，相对于现在的浮躁。",[100,125,126],{},"再一次的仰视天堂是于09年中，我身后的苍穹青山云朵霞光都仿佛是那上万间僧舍的映衬——甘孜州阿坝州的藏区，团坐着全世界最大的佛学院——五明。",[100,128,129],{},"在那里你的心会澄清的透明，想大喊，想默念，想倾吐，想忏悔……心向往之，甚至愿化青烟一缕浅挂天边片刻俯瞰——芸芸众生，其实和那白云苍狗没有两样，聚散终如一曲毕，并无绕梁三日音……",[100,131,132],{},"我信佛，也信有天堂，更信我们那7克重量不会无的放矢，尘归尘土归土，一切机缘终究都会有个去处。",[100,134,135],{},"且让我们静坐菩提岸，笑看时光转，一杯酒一盏茶，一个吻一滴泪，一首歌一场梦，一世痴迷一生荒唐的走过吧……",[100,137,138],{},"不愿你别的，只想你善良……",[100,140,141],{},"新的一年就要来了，祈福所有此篇观者，下一年中幸福安康……阿弥陀佛虎年吉祥……",{"title":143,"searchDepth":144,"depth":144,"links":145},"",2,[],[6,9],"md",{"date":149},"2010-02-13 00:10",true,"\u002Fblog\u002Fblog_4af9831b0100h0o9",{"title":95,"description":117},"blog_4af9831b0100h0o9","blog\u002Fblog_4af9831b0100h0o9",[156],"杂谈","mgXJ_hoLbJWHehiACBmoRBquTB3yDES2hRJIfrjXyH4",[159,164],{"title":160,"path":161,"stem":162,"children":-1,"slug":163},"李晨这个人","\u002Fblog\u002Fblog_4af9831b0100gvim","blog\u002Fblog_4af9831b0100gvim","blog_4af9831b0100gvim",{"title":165,"path":166,"stem":167,"children":-1,"slug":168},"守望","\u002Fblog\u002Fblog_4af9831b0100h6ee","blog\u002Fblog_4af9831b0100h6ee","blog_4af9831b0100h6ee",1795162025260]
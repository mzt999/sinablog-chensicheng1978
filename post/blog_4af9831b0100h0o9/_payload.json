[{"data":1,"prerenderedAt":107},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b0100h0o9":31,"surround-blog_4af9831b0100h0o9":96},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",152,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":84,"description":33,"extension":85,"meta":86,"navigation":88,"path":89,"seo":90,"slug":91,"stem":92,"tags":93,"__hash__":95},"blog\u002Fblog\u002Fblog_4af9831b0100h0o9.md","仰视天堂",{"type":35,"value":36,"toc":80},"minimark",[37,44,47,50,53,56,59,62,65,68,71,74,77],[38,39,40],"p",{},[41,42],"img",{"alt":33,"src":43},"\u002Fpic\u002F4af9831bt7f69886655fd.jpg",[38,45,46],{},"中国传统的阴历年计，今天，才是这年的最后一天。",[38,48,49],{},"明天，一切又是个开始。新的一年，新的启程……",[38,51,52],{},"09年不想说太多，相对回首此时我更愿展望。",[38,54,55],{},"‘仰视天堂’是03年我为班里写的一个毕业大戏，后因校方干预无疾而终……",[38,57,58],{},"艺术创作上不存在孤注一掷，任何心血都不会付之东流。如同我的‘奇迹’，那些影响都深植于我的骨格血脉与我融会贯通于一处，所以我不绝望，艺术，不存在流产。",[38,60,61],{},"请允许我说‘艺术’，相对于现在的浮躁。",[38,63,64],{},"再一次的仰视天堂是于09年中，我身后的苍穹青山云朵霞光都仿佛是那上万间僧舍的映衬——甘孜州阿坝州的藏区，团坐着全世界最大的佛学院——五明。",[38,66,67],{},"在那里你的心会澄清的透明，想大喊，想默念，想倾吐，想忏悔……心向往之，甚至愿化青烟一缕浅挂天边片刻俯瞰——芸芸众生，其实和那白云苍狗没有两样，聚散终如一曲毕，并无绕梁三日音……",[38,69,70],{},"我信佛，也信有天堂，更信我们那7克重量不会无的放矢，尘归尘土归土，一切机缘终究都会有个去处。",[38,72,73],{},"且让我们静坐菩提岸，笑看时光转，一杯酒一盏茶，一个吻一滴泪，一首歌一场梦，一世痴迷一生荒唐的走过吧……",[38,75,76],{},"不愿你别的，只想你善良……",[38,78,79],{},"新的一年就要来了，祈福所有此篇观者，下一年中幸福安康……阿弥陀佛虎年吉祥……",{"title":81,"searchDepth":82,"depth":82,"links":83},"",2,[],[6,9],"md",{"date":87},"2010-02-13 00:10",true,"\u002Fblog\u002Fblog_4af9831b0100h0o9",{"title":33,"description":33},"blog_4af9831b0100h0o9","blog\u002Fblog_4af9831b0100h0o9",[94],"杂谈","h7h-ZshbwVYpcnSHS7xYF-SOmefK4wC2zW9IGHl_r90",[97,102],{"title":98,"path":99,"stem":100,"children":-1,"slug":101},"李晨这个人","\u002Fblog\u002Fblog_4af9831b0100gvim","blog\u002Fblog_4af9831b0100gvim","blog_4af9831b0100gvim",{"title":103,"path":104,"stem":105,"children":-1,"slug":106},"守望","\u002Fblog\u002Fblog_4af9831b0100h6ee","blog\u002Fblog_4af9831b0100h6ee","blog_4af9831b0100h6ee",1793971357828]
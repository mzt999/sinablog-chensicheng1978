[{"data":1,"prerenderedAt":151},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":58,"blog-post-slug-blog_4af9831b0100h0o9":75,"surround-blog_4af9831b0100h0o9":140},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":54,"site_description":55,"stem":56,"__hash__":57},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo",20,"新浪博客内容备份","settings","hh8X7X6SFDoeJrxIJ4yisZXSc3HwHM1zk206jiQX2XU",{"latestBlog":59},[60,63,66,69,72],{"title":61,"slug":62},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":64,"slug":65},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":67,"slug":68},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":70,"slug":71},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":73,"slug":74},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":76,"title":77,"body":78,"categories":128,"description":99,"extension":129,"meta":130,"navigation":132,"path":133,"seo":134,"slug":135,"stem":136,"tags":137,"__hash__":139},"blog\u002Fblog\u002Fblog_4af9831b0100h0o9.md","仰视天堂",{"type":79,"value":80,"toc":124},"minimark",[81,88,91,94,97,100,103,106,109,112,115,118,121],[82,83,84],"p",{},[85,86],"img",{"alt":77,"src":87},"\u002Fpic\u002F4af9831bt7f69886655fd.jpg",[82,89,90],{},"中国传统的阴历年计，今天，才是这年的最后一天。",[82,92,93],{},"明天，一切又是个开始。新的一年，新的启程……",[82,95,96],{},"09年不想说太多，相对回首此时我更愿展望。",[82,98,99],{},"‘仰视天堂’是03年我为班里写的一个毕业大戏，后因校方干预无疾而终……",[82,101,102],{},"艺术创作上不存在孤注一掷，任何心血都不会付之东流。如同我的‘奇迹’，那些影响都深植于我的骨格血脉与我融会贯通于一处，所以我不绝望，艺术，不存在流产。",[82,104,105],{},"请允许我说‘艺术’，相对于现在的浮躁。",[82,107,108],{},"再一次的仰视天堂是于09年中，我身后的苍穹青山云朵霞光都仿佛是那上万间僧舍的映衬——甘孜州阿坝州的藏区，团坐着全世界最大的佛学院——五明。",[82,110,111],{},"在那里你的心会澄清的透明，想大喊，想默念，想倾吐，想忏悔……心向往之，甚至愿化青烟一缕浅挂天边片刻俯瞰——芸芸众生，其实和那白云苍狗没有两样，聚散终如一曲毕，并无绕梁三日音……",[82,113,114],{},"我信佛，也信有天堂，更信我们那7克重量不会无的放矢，尘归尘土归土，一切机缘终究都会有个去处。",[82,116,117],{},"且让我们静坐菩提岸，笑看时光转，一杯酒一盏茶，一个吻一滴泪，一首歌一场梦，一世痴迷一生荒唐的走过吧……",[82,119,120],{},"不愿你别的，只想你善良……",[82,122,123],{},"新的一年就要来了，祈福所有此篇观者，下一年中幸福安康……阿弥陀佛虎年吉祥……",{"title":125,"searchDepth":126,"depth":126,"links":127},"",2,[],[6,9],"md",{"date":131},"2010-02-13 00:10",true,"\u002Fblog\u002Fblog_4af9831b0100h0o9",{"title":77,"description":99},"blog_4af9831b0100h0o9","blog\u002Fblog_4af9831b0100h0o9",[138],"杂谈","mgXJ_hoLbJWHehiACBmoRBquTB3yDES2hRJIfrjXyH4",[141,146],{"title":142,"path":143,"stem":144,"children":-1,"slug":145},"李晨这个人","\u002Fblog\u002Fblog_4af9831b0100gvim","blog\u002Fblog_4af9831b0100gvim","blog_4af9831b0100gvim",{"title":147,"path":148,"stem":149,"children":-1,"slug":150},"守望","\u002Fblog\u002Fblog_4af9831b0100h6ee","blog\u002Fblog_4af9831b0100h6ee","blog_4af9831b0100h6ee",1794412499932]
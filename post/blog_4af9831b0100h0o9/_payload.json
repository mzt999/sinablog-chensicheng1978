[{"data":1,"prerenderedAt":150},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":57,"blog-post-slug-blog_4af9831b0100h0o9":74,"surround-blog_4af9831b0100h0o9":139},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":16,"site_description":54,"stem":55,"__hash__":56},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo","新浪博客内容备份(粉丝自用)","settings","jPD1QWrYwbaIixg6lntppEYe-T3ZGd3EJZxFBkbKY9E",{"latestBlog":58},[59,62,65,68,71],{"title":60,"slug":61},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":63,"slug":64},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":66,"slug":67},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":69,"slug":70},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":72,"slug":73},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":75,"title":76,"body":77,"categories":127,"description":98,"extension":128,"meta":129,"navigation":131,"path":132,"seo":133,"slug":134,"stem":135,"tags":136,"__hash__":138},"blog\u002Fblog\u002Fblog_4af9831b0100h0o9.md","仰视天堂",{"type":78,"value":79,"toc":123},"minimark",[80,87,90,93,96,99,102,105,108,111,114,117,120],[81,82,83],"p",{},[84,85],"img",{"alt":76,"src":86},"\u002Fpic\u002F4af9831bt7f69886655fd.jpg",[81,88,89],{},"中国传统的阴历年计，今天，才是这年的最后一天。",[81,91,92],{},"明天，一切又是个开始。新的一年，新的启程……",[81,94,95],{},"09年不想说太多，相对回首此时我更愿展望。",[81,97,98],{},"‘仰视天堂’是03年我为班里写的一个毕业大戏，后因校方干预无疾而终……",[81,100,101],{},"艺术创作上不存在孤注一掷，任何心血都不会付之东流。如同我的‘奇迹’，那些影响都深植于我的骨格血脉与我融会贯通于一处，所以我不绝望，艺术，不存在流产。",[81,103,104],{},"请允许我说‘艺术’，相对于现在的浮躁。",[81,106,107],{},"再一次的仰视天堂是于09年中，我身后的苍穹青山云朵霞光都仿佛是那上万间僧舍的映衬——甘孜州阿坝州的藏区，团坐着全世界最大的佛学院——五明。",[81,109,110],{},"在那里你的心会澄清的透明，想大喊，想默念，想倾吐，想忏悔……心向往之，甚至愿化青烟一缕浅挂天边片刻俯瞰——芸芸众生，其实和那白云苍狗没有两样，聚散终如一曲毕，并无绕梁三日音……",[81,112,113],{},"我信佛，也信有天堂，更信我们那7克重量不会无的放矢，尘归尘土归土，一切机缘终究都会有个去处。",[81,115,116],{},"且让我们静坐菩提岸，笑看时光转，一杯酒一盏茶，一个吻一滴泪，一首歌一场梦，一世痴迷一生荒唐的走过吧……",[81,118,119],{},"不愿你别的，只想你善良……",[81,121,122],{},"新的一年就要来了，祈福所有此篇观者，下一年中幸福安康……阿弥陀佛虎年吉祥……",{"title":124,"searchDepth":125,"depth":125,"links":126},"",2,[],[6,9],"md",{"date":130},"2010-02-13 00:10",true,"\u002Fblog\u002Fblog_4af9831b0100h0o9",{"title":76,"description":98},"blog_4af9831b0100h0o9","blog\u002Fblog_4af9831b0100h0o9",[137],"杂谈","mgXJ_hoLbJWHehiACBmoRBquTB3yDES2hRJIfrjXyH4",[140,145],{"title":141,"path":142,"stem":143,"children":-1,"slug":144},"李晨这个人","\u002Fblog\u002Fblog_4af9831b0100gvim","blog\u002Fblog_4af9831b0100gvim","blog_4af9831b0100gvim",{"title":146,"path":147,"stem":148,"children":-1,"slug":149},"守望","\u002Fblog\u002Fblog_4af9831b0100h6ee","blog\u002Fblog_4af9831b0100h6ee","blog_4af9831b0100h6ee",1794473704525]
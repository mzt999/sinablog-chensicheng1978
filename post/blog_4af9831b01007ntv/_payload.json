,155,158,161,164,167,170,173,176,179,182],[81,82,83],"p",{},[84,85],"a",{"href":86,"rel":87},"http:\u002F\u002Falbum.sina.com.cn\u002Fpic\u002F4af9831b441238b6c08c5",[88],"nofollow",[81,90,91],{},"明天一早六点就要起来.去济南.算了算,又没几个小时好睡...",[81,93,94],{},"本不该来,不该写.但为了今冬的初雪,纪念,值得.",[81,96,97],{},"下午寒风很特别,因为有雪,还因为参加了个新车试驾 --\n泥泞,崎岖,颠簸...无谓!",[81,99,100],{},"教练说的很好\"越野\"---英文\"OFFLAND\"本来就该在没有路的路上踩出路!一个车的态度!如同人生!",[81,102,103],{},"更坚定了我换车的想法!LAND  OFF",[81,105,106],{},[107,108],"img",{"alt":76,"src":109},"\u002Fpic\u002F4af9831b4412336420c07.jpg",[81,111,112],{},[107,113],{"alt":76,"src":114},"\u002Fpic\u002F4af9831b441233653c79d.jpg",[81,116,117],{},[107,118],{"alt":76,"src":119},"\u002Fpic\u002F4af9831b441233654114b.jpg",[81,121,122],{},[107,123],{"alt":76,"src":124},"\u002Fpic\u002F4af9831b44123364de6a8.jpg",[81,126,127],{},[107,128],{"alt":76,"src":129},"\u002Fpic\u002F4af9831b441238b5ac09d.jpg",[81,131,132],{},[107,133],{"alt":76,"src":134},"\u002Fpic\u002F4af9831b441238b5aa9c9.jpg",[81,136,137],{},[107,138],{"alt":76,"src":139},"\u002Fpic\u002F4af9831b441238b6c08c5.jpg",[81,141,142],{},[84,143],{"href":144,"rel":145},"http:\u002F\u002Falbum.sina.com.cn\u002Fpic\u002F4af9831b44123365e16cc",[88],[81,147,148],{},[84,149],{"href":150,"rel":151},"http:\u002F\u002Falbum.sina.com.cn\u002Fpic\u002F4af9831b4412336420c07",[88],[81,153,154],{},"前两天,一个人,深夜,驱车,回家...孤独,无以名状.想到了即将到来的节日...孤独陷得更深!如果没有点雪,那么这个圣诞会更加的失色了吧......",[81,156,157],{},"还好,她来了.突然得促不及防.早晨醒来,隔窗忘去,已是满眼的雪银了...",[81,159,160],{},"北方就该这样,没有这点雪,此刻的北方还算是北方吗?",[81,162,163],{},"北国风光,千里冰封,万里雪飘...毛爷爷爱雪如同爱女人爱江山...",[81,165,166],{},"又一次馈赠!",[81,168,169],{},"她像个礼物,从天而降,落在身上,却温暖了别处...",[81,171,172],{},"看到雪,你会觉得自己是个诗人...",[81,174,175],{},"用手盛住,或直用身体迎接!她们无论在你的哪儿,都会悄悄消融,是你体温的一部分,是你脸夹的那片红.",[81,177,178],{},"你会觉得感动.",[81,180,181],{},"会觉得---",[81,183,184],{},"活着,真好...",{"title":186,"searchDepth":187,"depth":187,"links":188},"",2,[],[6,9],"md",{"date":192},"2007-12-11 01:05",true,"\u002Fblog\u002Fblog_4af9831b01007ntv",{"title":76,"description":91},"blog_4af9831b01007ntv","blog\u002Fblog_4af9831b01007ntv",[199],"随笔\u002F感悟","2_UuyMK2JKAAniVlD2yBYkzb75RppgfUhyUYXTlFAhI",[202,207],{"title":203,"path":204,"stem":205,"children":-1,"slug":206},"实话实说?","\u002Fblog\u002Fblog_4af9831b01000bs5","blog\u002Fblog_4af9831b01000bs5","blog_4af9831b01000bs5",{"title":208,"path":209,"stem":210,"children":-1,"slug":211},"现实照进梦想 --- 望月","\u002Fblog\u002Fblog_4af9831b01007q66","blog\u002Fblog_4af9831b01007q66","blog_4af9831b01007q66",1794473705519]
":89,"body":90,"categories":202,"description":104,"extension":203,"meta":204,"navigation":206,"path":207,"seo":208,"slug":209,"stem":210,"tags":211,"__hash__":213},"blog\u002Fblog\u002Fblog_4af9831b01007ntv.md","温暖",{"type":91,"value":92,"toc":198},"minimark",[93,102,105,108,111,114,117,123,128,133,138,143,148,153,159,165,168,171,174,177,180,183,186,189,192,195],[94,95,96],"p",{},[97,98],"a",{"href":99,"rel":100},"http:\u002F\u002Falbum.sina.com.cn\u002Fpic\u002F4af9831b441238b6c08c5",[101],"nofollow",[94,103,104],{},"明天一早六点就要起来.去济南.算了算,又没几个小时好睡...",[94,106,107],{},"本不该来,不该写.但为了今冬的初雪,纪念,值得.",[94,109,110],{},"下午寒风很特别,因为有雪,还因为参加了个新车试驾 --\n泥泞,崎岖,颠簸...无谓!",[94,112,113],{},"教练说的很好\"越野\"---英文\"OFFLAND\"本来就该在没有路的路上踩出路!一个车的态度!如同人生!",[94,115,116],{},"更坚定了我换车的想法!LAND  OFF",[94,118,119],{},[120,121],"img",{"alt":89,"src":122},"\u002Fpic\u002F4af9831b4412336420c07.jpg",[94,124,125],{},[120,126],{"alt":89,"src":127},"\u002Fpic\u002F4af9831b441233653c79d.jpg",[94,129,130],{},[120,131],{"alt":89,"src":132},"\u002Fpic\u002F4af9831b441233654114b.jpg",[94,134,135],{},[120,136],{"alt":89,"src":137},"\u002Fpic\u002F4af9831b44123364de6a8.jpg",[94,139,140],{},[120,141],{"alt":89,"src":142},"\u002Fpic\u002F4af9831b441238b5ac09d.jpg",[94,144,145],{},[120,146],{"alt":89,"src":147},"\u002Fpic\u002F4af9831b441238b5aa9c9.jpg",[94,149,150],{},[120,151],{"alt":89,"src":152},"\u002Fpic\u002F4af9831b441238b6c08c5.jpg",[94,154,155],{},[97,156],{"href":157,"rel":158},"http:\u002F\u002Falbum.sina.com.cn\u002Fpic\u002F4af9831b44123365e16cc",[101],[94,160,161],{},[97,162],{"href":163,"rel":164},"http:\u002F\u002Falbum.sina.com.cn\u002Fpic\u002F4af9831b4412336420c07",[101],[94,166,167],{},"前两天,一个人,深夜,驱车,回家...孤独,无以名状.想到了即将到来的节日...孤独陷得更深!如果没有点雪,那么这个圣诞会更加的失色了吧......",[94,169,170],{},"还好,她来了.突然得促不及防.早晨醒来,隔窗忘去,已是满眼的雪银了...",[94,172,173],{},"北方就该这样,没有这点雪,此刻的北方还算是北方吗?",[94,175,176],{},"北国风光,千里冰封,万里雪飘...毛爷爷爱雪如同爱女人爱江山...",[94,178,179],{},"又一次馈赠!",[94,181,182],{},"她像个礼物,从天而降,落在身上,却温暖了别处...",[94,184,185],{},"看到雪,你会觉得自己是个诗人...",[94,187,188],{},"用手盛住,或直用身体迎接!她们无论在你的哪儿,都会悄悄消融,是你体温的一部分,是你脸夹的那片红.",[94,190,191],{},"你会觉得感动.",[94,193,194],{},"会觉得---",[94,196,197],{},"活着,真好...",{"title":199,"searchDepth":200,"depth":200,"links":201},"",2,[],[6,9],"md",{"date":205},"2007-12-11 01:05",true,"\u002Fblog\u002Fblog_4af9831b01007ntv",{"title":89,"description":104},"blog_4af9831b01007ntv","blog\u002Fblog_4af9831b01007ntv",[212],"随笔\u002F感悟","2_UuyMK2JKAAniVlD2yBYkzb75RppgfUhyUYXTlFAhI",[215,220],{"title":216,"path":217,"stem":218,"children":-1,"slug":219},"实话实说?","\u002Fblog\u002Fblog_4af9831b01000bs5","blog\u002Fblog_4af9831b01000bs5","blog_4af9831b01000bs5",{"title":221,"path":222,"stem":223,"children":-1,"slug":224},"现实照进梦想 --- 望月","\u002Fblog\u002Fblog_4af9831b01007q66","blog\u002Fblog_4af9831b01007q66","blog_4af9831b01007q66",1794544667796]
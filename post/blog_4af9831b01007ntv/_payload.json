6,159,162,165,168,171,174,177,180,183],[82,83,84],"p",{},[85,86],"a",{"href":87,"rel":88},"http:\u002F\u002Falbum.sina.com.cn\u002Fpic\u002F4af9831b441238b6c08c5",[89],"nofollow",[82,91,92],{},"明天一早六点就要起来.去济南.算了算,又没几个小时好睡...",[82,94,95],{},"本不该来,不该写.但为了今冬的初雪,纪念,值得.",[82,97,98],{},"下午寒风很特别,因为有雪,还因为参加了个新车试驾 --\n泥泞,崎岖,颠簸...无谓!",[82,100,101],{},"教练说的很好\"越野\"---英文\"OFFLAND\"本来就该在没有路的路上踩出路!一个车的态度!如同人生!",[82,103,104],{},"更坚定了我换车的想法!LAND  OFF",[82,106,107],{},[108,109],"img",{"alt":77,"src":110},"\u002Fpic\u002F4af9831b4412336420c07.jpg",[82,112,113],{},[108,114],{"alt":77,"src":115},"\u002Fpic\u002F4af9831b441233653c79d.jpg",[82,117,118],{},[108,119],{"alt":77,"src":120},"\u002Fpic\u002F4af9831b441233654114b.jpg",[82,122,123],{},[108,124],{"alt":77,"src":125},"\u002Fpic\u002F4af9831b44123364de6a8.jpg",[82,127,128],{},[108,129],{"alt":77,"src":130},"\u002Fpic\u002F4af9831b441238b5ac09d.jpg",[82,132,133],{},[108,134],{"alt":77,"src":135},"\u002Fpic\u002F4af9831b441238b5aa9c9.jpg",[82,137,138],{},[108,139],{"alt":77,"src":140},"\u002Fpic\u002F4af9831b441238b6c08c5.jpg",[82,142,143],{},[85,144],{"href":145,"rel":146},"http:\u002F\u002Falbum.sina.com.cn\u002Fpic\u002F4af9831b44123365e16cc",[89],[82,148,149],{},[85,150],{"href":151,"rel":152},"http:\u002F\u002Falbum.sina.com.cn\u002Fpic\u002F4af9831b4412336420c07",[89],[82,154,155],{},"前两天,一个人,深夜,驱车,回家...孤独,无以名状.想到了即将到来的节日...孤独陷得更深!如果没有点雪,那么这个圣诞会更加的失色了吧......",[82,157,158],{},"还好,她来了.突然得促不及防.早晨醒来,隔窗忘去,已是满眼的雪银了...",[82,160,161],{},"北方就该这样,没有这点雪,此刻的北方还算是北方吗?",[82,163,164],{},"北国风光,千里冰封,万里雪飘...毛爷爷爱雪如同爱女人爱江山...",[82,166,167],{},"又一次馈赠!",[82,169,170],{},"她像个礼物,从天而降,落在身上,却温暖了别处...",[82,172,173],{},"看到雪,你会觉得自己是个诗人...",[82,175,176],{},"用手盛住,或直用身体迎接!她们无论在你的哪儿,都会悄悄消融,是你体温的一部分,是你脸夹的那片红.",[82,178,179],{},"你会觉得感动.",[82,181,182],{},"会觉得---",[82,184,185],{},"活着,真好...",{"title":187,"searchDepth":188,"depth":188,"links":189},"",2,[],[6,9],"md",{"date":193},"2007-12-11 01:05",true,"\u002Fblog\u002Fblog_4af9831b01007ntv",{"title":77,"description":92},"blog_4af9831b01007ntv","blog\u002Fblog_4af9831b01007ntv",[200],"随笔\u002F感悟","2_UuyMK2JKAAniVlD2yBYkzb75RppgfUhyUYXTlFAhI",[203,208],{"title":204,"path":205,"stem":206,"children":-1,"slug":207},"实话实说?","\u002Fblog\u002Fblog_4af9831b01000bs5","blog\u002Fblog_4af9831b01000bs5","blog_4af9831b01000bs5",{"title":209,"path":210,"stem":211,"children":-1,"slug":212},"现实照进梦想 --- 望月","\u002Fblog\u002Fblog_4af9831b01007q66","blog\u002Fblog_4af9831b01007q66","blog_4af9831b01007q66",1794412500837]
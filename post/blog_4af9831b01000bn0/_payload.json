[{"data":1,"prerenderedAt":130},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":57,"blog-post-slug-blog_4af9831b01000bn0":74,"surround-blog_4af9831b01000bn0":119},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":16,"site_description":54,"stem":55,"__hash__":56},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo","新浪博客内容备份(粉丝自用)","settings","jPD1QWrYwbaIixg6lntppEYe-T3ZGd3EJZxFBkbKY9E",{"latestBlog":58},[59,62,65,68,71],{"title":60,"slug":61},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":63,"slug":64},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":66,"slug":67},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":69,"slug":70},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":72,"slug":73},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":75,"title":76,"body":77,"categories":106,"description":107,"extension":108,"meta":109,"navigation":111,"path":112,"seo":113,"slug":114,"stem":115,"tags":116,"__hash__":118},"blog\u002Fblog\u002Fblog_4af9831b01000bn0.md","勇往直前",{"type":78,"value":79,"toc":102},"minimark",[80,84,87,90,93,96,99],[81,82,83],"p",{},"相机丢了.但是感谢所有为我曾经或继续寻找的人们.我其实挺怕麻烦的.所以这事就算了吧不提了过去了...为所有惦记过这事的朋友鞠一躬啦...继续的就免了吧...",[81,85,86],{},"但是关于\"勇往直前\"也就没照片发上来了.还好我的贴吧里有,不闲麻烦的就去那看看吧,也为那里增加点儿点击率.",[81,88,89],{},"此刻的我又有点犯\"痞气\",也不知又受了哪方面的刺激,反正就是想在这里堕落一下,发发牢骚.没办法,身边没人的人就这样,小小在这儿神经一下省得失眠!所以我说我的,不好听的你就当我没说罢...",[81,91,92],{},"\"电影\"月底开机,为了她推了几部戏,马内的损失事儿小,但这样的创作却是头遭.所以心里一直没底.(难道这也是我空落落的原因?)不是!立马给自己否了!那是什么呢?怎么此刻又不接地气了呢...?",[81,94,95],{},"频繁的几次活动,唯一的感触就是想说----靠!!!(对不起!请允许我靠在你们身上一会儿)真的有你们在身边太好了.看着你们,我确定自己还活着.所以就觉得自己变得不再只是自己了.我的身体里充满着你们,你们是我的汁液.",[81,97,98],{},"\"勇往直前\"这名字起的挺好的.像是送给我的.会更加让我\"混不吝\".多大点事儿?头掉了碗大的疤,小爷30年后又一条好汉!",[81,100,101],{},"有点困意了,可以洗洗睡了.明天还一个什么节目.管它呢?...勇往直前好了...",{"title":103,"searchDepth":104,"depth":104,"links":105},"",2,[],[6],"相机丢了.但是感谢所有为我曾经或继续寻找的人们.","md",{"date":110},"2007-11-18 01:27",true,"\u002Fblog\u002Fblog_4af9831b01000bn0",{"title":76,"description":107},"blog_4af9831b01000bn0","blog\u002Fblog_4af9831b01000bn0",[117],"随笔\u002F感悟","AAQZI-V9s8_Zve08lx1f_sq1GvSYgMUHIN5NPkpjYEw",[120,125],{"title":121,"path":122,"stem":123,"children":-1,"slug":124},"王婆卖瓜","\u002Fblog\u002Fblog_4af9831b01000blk","blog\u002Fblog_4af9831b01000blk","blog_4af9831b01000blk",{"title":126,"path":127,"stem":128,"children":-1,"slug":129},"星梦奇缘","\u002Fblog\u002Fblog_4af9831b01000bok","blog\u002Fblog_4af9831b01000bok","blog_4af9831b01000bok",1794473705536]
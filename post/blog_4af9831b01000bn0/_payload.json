[{"data":1,"prerenderedAt":90},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":17,"blog-post-slug-blog_4af9831b01000bn0":34,"surround-blog_4af9831b01000bn0":79},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"latestBlog":18},[19,22,25,28,31],{"title":20,"slug":21},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":23,"slug":24},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":26,"slug":27},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":29,"slug":30},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":32,"slug":33},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":35,"title":36,"body":37,"categories":66,"description":67,"extension":68,"meta":69,"navigation":71,"path":72,"seo":73,"slug":74,"stem":75,"tags":76,"__hash__":78},"blog\u002Fblog\u002Fblog_4af9831b01000bn0.md","勇往直前",{"type":38,"value":39,"toc":62},"minimark",[40,44,47,50,53,56,59],[41,42,43],"p",{},"相机丢了.但是感谢所有为我曾经或继续寻找的人们.我其实挺怕麻烦的.所以这事就算了吧不提了过去了...为所有惦记过这事的朋友鞠一躬啦...继续的就免了吧...",[41,45,46],{},"但是关于\"勇往直前\"也就没照片发上来了.还好我的贴吧里有,不闲麻烦的就去那看看吧,也为那里增加点儿点击率.",[41,48,49],{},"此刻的我又有点犯\"痞气\",也不知又受了哪方面的刺激,反正就是想在这里堕落一下,发发牢骚.没办法,身边没人的人就这样,小小在这儿神经一下省得失眠!所以我说我的,不好听的你就当我没说罢...",[41,51,52],{},"\"电影\"月底开机,为了她推了几部戏,马内的损失事儿小,但这样的创作却是头遭.所以心里一直没底.(难道这也是我空落落的原因?)不是!立马给自己否了!那是什么呢?怎么此刻又不接地气了呢...?",[41,54,55],{},"频繁的几次活动,唯一的感触就是想说----靠!!!(对不起!请允许我靠在你们身上一会儿)真的有你们在身边太好了.看着你们,我确定自己还活着.所以就觉得自己变得不再只是自己了.我的身体里充满着你们,你们是我的汁液.",[41,57,58],{},"\"勇往直前\"这名字起的挺好的.像是送给我的.会更加让我\"混不吝\".多大点事儿?头掉了碗大的疤,小爷30年后又一条好汉!",[41,60,61],{},"有点困意了,可以洗洗睡了.明天还一个什么节目.管它呢?...勇往直前好了...",{"title":63,"searchDepth":64,"depth":64,"links":65},"",2,[],[6],"相机丢了.但是感谢所有为我曾经或继续寻找的人们.","md",{"date":70},"2007-11-18 01:27",true,"\u002Fblog\u002Fblog_4af9831b01000bn0",{"title":36,"description":67},"blog_4af9831b01000bn0","blog\u002Fblog_4af9831b01000bn0",[77],"随笔\u002F感悟","AAQZI-V9s8_Zve08lx1f_sq1GvSYgMUHIN5NPkpjYEw",[80,85],{"title":81,"path":82,"stem":83,"children":-1,"slug":84},"王婆卖瓜","\u002Fblog\u002Fblog_4af9831b01000blk","blog\u002Fblog_4af9831b01000blk","blog_4af9831b01000blk",{"title":86,"path":87,"stem":88,"children":-1,"slug":89},"星梦奇缘","\u002Fblog\u002Fblog_4af9831b01000bok","blog\u002Fblog_4af9831b01000bok","blog_4af9831b01000bok",1794397912940]
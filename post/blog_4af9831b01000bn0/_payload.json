[{"data":1,"prerenderedAt":143},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":70,"blog-post-slug-blog_4af9831b01000bn0":87,"surround-blog_4af9831b01000bn0":132},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":45,"navLinks":46,"perPage":16,"prevNextIsExcludeDate":66,"site_description":23,"site_name":67,"stem":68,"__hash__":69},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{},[47,52,56,60,64],{"path":48,"title":49,"target":50,"fa_class":51},"\u002F","博客首页","internal","fa-home",{"path":53,"title":54,"target":50,"fa_class":55},"\u002Fabout","关于","fa-user",{"path":57,"title":58,"target":50,"fa_class":59},"\u002Fpost","归档","fa-archive",{"path":61,"title":62,"target":50,"fa_class":63},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":65,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","jvZHccz2rT-wjVS5GCPgWyhl8WnBIvECPkE5KpKFKCU",{"latestBlog":71},[72,75,78,81,84],{"title":73,"slug":74},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":76,"slug":77},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":79,"slug":80},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":82,"slug":83},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":85,"slug":86},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":88,"title":89,"body":90,"categories":119,"description":120,"extension":121,"meta":122,"navigation":124,"path":125,"seo":126,"slug":127,"stem":128,"tags":129,"__hash__":131},"blog\u002Fblog\u002Fblog_4af9831b01000bn0.md","勇往直前",{"type":91,"value":92,"toc":115},"minimark",[93,97,100,103,106,109,112],[94,95,96],"p",{},"相机丢了.但是感谢所有为我曾经或继续寻找的人们.我其实挺怕麻烦的.所以这事就算了吧不提了过去了...为所有惦记过这事的朋友鞠一躬啦...继续的就免了吧...",[94,98,99],{},"但是关于\"勇往直前\"也就没照片发上来了.还好我的贴吧里有,不闲麻烦的就去那看看吧,也为那里增加点儿点击率.",[94,101,102],{},"此刻的我又有点犯\"痞气\",也不知又受了哪方面的刺激,反正就是想在这里堕落一下,发发牢骚.没办法,身边没人的人就这样,小小在这儿神经一下省得失眠!所以我说我的,不好听的你就当我没说罢...",[94,104,105],{},"\"电影\"月底开机,为了她推了几部戏,马内的损失事儿小,但这样的创作却是头遭.所以心里一直没底.(难道这也是我空落落的原因?)不是!立马给自己否了!那是什么呢?怎么此刻又不接地气了呢...?",[94,107,108],{},"频繁的几次活动,唯一的感触就是想说----靠!!!(对不起!请允许我靠在你们身上一会儿)真的有你们在身边太好了.看着你们,我确定自己还活着.所以就觉得自己变得不再只是自己了.我的身体里充满着你们,你们是我的汁液.",[94,110,111],{},"\"勇往直前\"这名字起的挺好的.像是送给我的.会更加让我\"混不吝\".多大点事儿?头掉了碗大的疤,小爷30年后又一条好汉!",[94,113,114],{},"有点困意了,可以洗洗睡了.明天还一个什么节目.管它呢?...勇往直前好了...",{"title":116,"searchDepth":117,"depth":117,"links":118},"",2,[],[6],"相机丢了.但是感谢所有为我曾经或继续寻找的人们.","md",{"date":123},"2007-11-18 01:27",true,"\u002Fblog\u002Fblog_4af9831b01000bn0",{"title":89,"description":120},"blog_4af9831b01000bn0","blog\u002Fblog_4af9831b01000bn0",[130],"随笔\u002F感悟","AAQZI-V9s8_Zve08lx1f_sq1GvSYgMUHIN5NPkpjYEw",[133,138],{"title":134,"path":135,"stem":136,"children":-1,"slug":137},"王婆卖瓜","\u002Fblog\u002Fblog_4af9831b01000blk","blog\u002Fblog_4af9831b01000blk","blog_4af9831b01000blk",{"title":139,"path":140,"stem":141,"children":-1,"slug":142},"星梦奇缘","\u002Fblog\u002Fblog_4af9831b01000bok","blog\u002Fblog_4af9831b01000bok","blog_4af9831b01000bok",1794546769953]
[{"data":1,"prerenderedAt":131},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":58,"blog-post-slug-blog_4af9831b01000bn0":75,"surround-blog_4af9831b01000bn0":120},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":54,"site_description":55,"stem":56,"__hash__":57},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo",20,"新浪博客内容备份","settings","hh8X7X6SFDoeJrxIJ4yisZXSc3HwHM1zk206jiQX2XU",{"latestBlog":59},[60,63,66,69,72],{"title":61,"slug":62},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":64,"slug":65},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":67,"slug":68},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":70,"slug":71},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":73,"slug":74},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":76,"title":77,"body":78,"categories":107,"description":108,"extension":109,"meta":110,"navigation":112,"path":113,"seo":114,"slug":115,"stem":116,"tags":117,"__hash__":119},"blog\u002Fblog\u002Fblog_4af9831b01000bn0.md","勇往直前",{"type":79,"value":80,"toc":103},"minimark",[81,85,88,91,94,97,100],[82,83,84],"p",{},"相机丢了.但是感谢所有为我曾经或继续寻找的人们.我其实挺怕麻烦的.所以这事就算了吧不提了过去了...为所有惦记过这事的朋友鞠一躬啦...继续的就免了吧...",[82,86,87],{},"但是关于\"勇往直前\"也就没照片发上来了.还好我的贴吧里有,不闲麻烦的就去那看看吧,也为那里增加点儿点击率.",[82,89,90],{},"此刻的我又有点犯\"痞气\",也不知又受了哪方面的刺激,反正就是想在这里堕落一下,发发牢骚.没办法,身边没人的人就这样,小小在这儿神经一下省得失眠!所以我说我的,不好听的你就当我没说罢...",[82,92,93],{},"\"电影\"月底开机,为了她推了几部戏,马内的损失事儿小,但这样的创作却是头遭.所以心里一直没底.(难道这也是我空落落的原因?)不是!立马给自己否了!那是什么呢?怎么此刻又不接地气了呢...?",[82,95,96],{},"频繁的几次活动,唯一的感触就是想说----靠!!!(对不起!请允许我靠在你们身上一会儿)真的有你们在身边太好了.看着你们,我确定自己还活着.所以就觉得自己变得不再只是自己了.我的身体里充满着你们,你们是我的汁液.",[82,98,99],{},"\"勇往直前\"这名字起的挺好的.像是送给我的.会更加让我\"混不吝\".多大点事儿?头掉了碗大的疤,小爷30年后又一条好汉!",[82,101,102],{},"有点困意了,可以洗洗睡了.明天还一个什么节目.管它呢?...勇往直前好了...",{"title":104,"searchDepth":105,"depth":105,"links":106},"",2,[],[6],"相机丢了.但是感谢所有为我曾经或继续寻找的人们.","md",{"date":111},"2007-11-18 01:27",true,"\u002Fblog\u002Fblog_4af9831b01000bn0",{"title":77,"description":108},"blog_4af9831b01000bn0","blog\u002Fblog_4af9831b01000bn0",[118],"随笔\u002F感悟","AAQZI-V9s8_Zve08lx1f_sq1GvSYgMUHIN5NPkpjYEw",[121,126],{"title":122,"path":123,"stem":124,"children":-1,"slug":125},"王婆卖瓜","\u002Fblog\u002Fblog_4af9831b01000blk","blog\u002Fblog_4af9831b01000blk","blog_4af9831b01000blk",{"title":127,"path":128,"stem":129,"children":-1,"slug":130},"星梦奇缘","\u002Fblog\u002Fblog_4af9831b01000bok","blog\u002Fblog_4af9831b01000bok","blog_4af9831b01000bok",1794412500849]
[{"data":1,"prerenderedAt":91},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b01000b6e":31,"surround-blog_4af9831b01000b6e":80},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",152,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":69,"description":33,"extension":70,"meta":71,"navigation":73,"path":74,"seo":75,"slug":76,"stem":77,"tags":78,"__hash__":79},"blog\u002Fblog\u002Fblog_4af9831b01000b6e.md","3 重轻",{"type":35,"value":36,"toc":65},"minimark",[37,41,44,47,50,53,56,59,62],[38,39,40],"p",{},"又回来了，这次不再走。",[38,42,43],{},"最近，我床边的书是“米兰昆德拉”的《不能承受的生命之轻》。真的很好！好得及时。若放在一年前的我，还会不懂。",[38,45,46],{},"  最沉重的负担压迫我们，让我们屈服，把我们压倒在地。但从来的爱情故事里，女人总渴望承受一个男性身体的重量。于是，最沉重的负担同时成了最强盛的生命力。负担越重，我们的生命越贴近大地，它就越真实存在。",[38,48,49],{},"  相反，当负担完全消失，人会轻过空气，会远离大地和地上的生命，人也就是一个半真的存在，其运动也会变得自由而没有意义。",[38,51,52],{},"  那么，我们该如何选择？重还是轻？",[38,54,55],{},"                      ——　给　四姨",[38,57,58],{},"                      一个很重的朋友",[38,60,61],{},"                        祝她幸福",[38,63,64],{},"  大家都拍完了，该洗洗睡了。明天中午起来，然后又是一天……再几个日落日出后，太阳不知又是什么颜色了……",{"title":66,"searchDepth":67,"depth":67,"links":68},"",2,[],[6],"md",{"date":72},"2007-10-10 03:41",true,"\u002Fblog\u002Fblog_4af9831b01000b6e",{"title":33,"description":33},"blog_4af9831b01000b6e","blog\u002Fblog_4af9831b01000b6e",[],"K1J_LCrrtbvkgaDjd17meTniiubOpctk_aj_fbj87iA",[81,86],{"title":82,"path":83,"stem":84,"children":-1,"slug":85},"1 等待","\u002Fblog\u002Fblog_4af9831b01000b6d","blog\u002Fblog_4af9831b01000b6d","blog_4af9831b01000b6d",{"title":87,"path":88,"stem":89,"children":-1,"slug":90},"2 选择","\u002Fblog\u002Fblog_4
[{"data":1,"prerenderedAt":148},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":70,"blog-post-slug-blog_4af9831b01000b6e":87,"surround-blog_4af9831b01000b6e":137},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":45,"navLinks":46,"perPage":16,"prevNextIsExcludeDate":66,"site_description":23,"site_name":67,"stem":68,"__hash__":69},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{},[47,52,56,60,64],{"path":48,"title":49,"target":50,"fa_class":51},"\u002F","博客首页","internal","fa-home",{"path":53,"title":54,"target":50,"fa_class":55},"\u002Fabout","关于","fa-user",{"path":57,"title":58,"target":50,"fa_class":59},"\u002Fpost","归档","fa-archive",{"path":61,"title":62,"target":50,"fa_class":63},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":65,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","jvZHccz2rT-wjVS5GCPgWyhl8WnBIvECPkE5KpKFKCU",{"latestBlog":71},[72,75,78,81,84],{"title":73,"slug":74},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":76,"slug":77},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":79,"slug":80},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":82,"slug":83},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":85,"slug":86},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":88,"title":89,"body":90,"categories":125,"description":126,"extension":127,"meta":128,"navigation":130,"path":131,"seo":132,"slug":133,"stem":134,"tags":135,"__hash__":136},"blog\u002Fblog\u002Fblog_4af9831b01000b6e.md","3 重轻",{"type":91,"value":92,"toc":121},"minimark",[93,97,100,103,106,109,112,115,118],[94,95,96],"p",{},"又回来了，这次不再走。",[94,98,99],{},"最近，我床边的书是“米兰昆德拉”的《不能承受的生命之轻》。真的很好！好得及时。若放在一年前的我，还会不懂。",[94,101,102],{},"  最沉重的负担压迫我们，让我们屈服，把我们压倒在地。但从来的爱情故事里，女人总渴望承受一个男性身体的重量。于是，最沉重的负担同时成了最强盛的生命力。负担越重，我们的生命越贴近大地，它就越真实存在。",[94,104,105],{},"  相反，当负担完全消失，人会轻过空气，会远离大地和地上的生命，人也就是一个半真的存在，其运动也会变得自由而没有意义。",[94,107,108],{},"  那么，我们该如何选择？重还是轻？",[94,110,111],{},"                      ——　给　四姨",[94,113,114],{},"                      一个很重的朋友",[94,116,117],{},"                        祝她幸福",[94,119,120],{},"  大家都拍完了，该洗洗睡了。明天中午起来，然后又是一天……再几个日落日出后，太阳不知又是什么颜色了……",{"title":122,"searchDepth":123,"depth":123,"links":124},"",2,[],[6],"我床边的书是“米兰昆德拉”的《不能承受的生命之轻》。真的很好！","md",{"date":129},"2007-10-10 03:41",true,"\u002Fblog\u002Fblog_4af9831b01000b6e",{"title":89,"description":126},"blog_4af9831b01000b6e","blog\u002Fblog_4af9831b01000b6e",[],"SGbGg87Tc5Fr4SlhmPJIlxRMSxk45efIpEMMy8lhpbs",[138,143],{"title":139,"path":140,"stem":141,"children":-1,"slug":142},"1 等待","\u002Fblog\u002Fblog_4af9831b01000b6d","blog\u002Fblog_4af9831b01000b6d","blog_4af9831b01000b6d",{"title":144,"path":145,"stem":146,"children":-1,"slug":147},"2 选择","\u002Fblog\u002Fblog_4af9831b01000b6f","blog\u002Fblog_4af9831b01000b6f","blog_4af9831b01000b6f",1794546770010]
[{"data":1,"prerenderedAt":95},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":17,"blog-post-slug-blog_4af9831b01000b6e":34,"surround-blog_4af9831b01000b6e":84},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"latestBlog":18},[19,22,25,28,31],{"title":20,"slug":21},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":23,"slug":24},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":26,"slug":27},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":29,"slug":30},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":32,"slug":33},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":35,"title":36,"body":37,"categories":72,"description":73,"extension":74,"meta":75,"navigation":77,"path":78,"seo":79,"slug":80,"stem":81,"tags":82,"__hash__":83},"blog\u002Fblog\u002Fblog_4af9831b01000b6e.md","3 重轻",{"type":38,"value":39,"toc":68},"minimark",[40,44,47,50,53,56,59,62,65],[41,42,43],"p",{},"又回来了，这次不再走。",[41,45,46],{},"最近，我床边的书是“米兰昆德拉”的《不能承受的生命之轻》。真的很好！好得及时。若放在一年前的我，还会不懂。",[41,48,49],{},"  最沉重的负担压迫我们，让我们屈服，把我们压倒在地。但从来的爱情故事里，女人总渴望承受一个男性身体的重量。于是，最沉重的负担同时成了最强盛的生命力。负担越重，我们的生命越贴近大地，它就越真实存在。",[41,51,52],{},"  相反，当负担完全消失，人会轻过空气，会远离大地和地上的生命，人也就是一个半真的存在，其运动也会变得自由而没有意义。",[41,54,55],{},"  那么，我们该如何选择？重还是轻？",[41,57,58],{},"                      ——　给　四姨",[41,60,61],{},"                      一个很重的朋友",[41,63,64],{},"                        祝她幸福",[41,66,67],{},"  大家都拍完了，该洗洗睡了。明天中午起来，然后又是一天……再几个日落日出后，太阳不知又是什么颜色了……",{"title":69,"searchDepth":70,"depth":70,"links":71},"",2,[],[6],"我床边的书是“米兰昆德拉”的《不能承受的生命之轻》。真的很好！","md",{"date":76},"2007-10-10 03:41",true,"\u002Fblog\u002Fblog_4af9831b01000b6e",{"title":36,"description":73},"blog_4af9831b01000b6e","blog\u002Fblog_4af9831b01000b6e",[],"SGbGg87Tc5Fr4SlhmPJIlxRMSxk45efIpEMMy8lhpbs",[85,90],{"title":86,"path":87,"stem":88,"children":-1,"slug":89},"1 等待","\u002Fblog\u002Fblog_4af9831b01000b6d","blog\u002Fblog_4af9831b01000b6d","blog_4af9831b01000b6d",{"title":91,"path":
[{"data":1,"prerenderedAt":136},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":58,"blog-post-slug-blog_4af9831b01000b6e":75,"surround-blog_4af9831b01000b6e":125},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":54,"site_description":55,"stem":56,"__hash__":57},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo",20,"新浪博客内容备份","settings","hh8X7X6SFDoeJrxIJ4yisZXSc3HwHM1zk206jiQX2XU",{"latestBlog":59},[60,63,66,69,72],{"title":61,"slug":62},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":64,"slug":65},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":67,"slug":68},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":70,"slug":71},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":73,"slug":74},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":76,"title":77,"body":78,"categories":113,"description":114,"extension":115,"meta":116,"navigation":118,"path":119,"seo":120,"slug":121,"stem":122,"tags":123,"__hash__":124},"blog\u002Fblog\u002Fblog_4af9831b01000b6e.md","3 重轻",{"type":79,"value":80,"toc":109},"minimark",[81,85,88,91,94,97,100,103,106],[82,83,84],"p",{},"又回来了，这次不再走。",[82,86,87],{},"最近，我床边的书是“米兰昆德拉”的《不能承受的生命之轻》。真的很好！好得及时。若放在一年前的我，还会不懂。",[82,89,90],{},"  最沉重的负担压迫我们，让我们屈服，把我们压倒在地。但从来的爱情故事里，女人总渴望承受一个男性身体的重量。于是，最沉重的负担同时成了最强盛的生命力。负担越重，我们的生命越贴近大地，它就越真实存在。",[82,92,93],{},"  相反，当负担完全消失，人会轻过空气，会远离大地和地上的生命，人也就是一个半真的存在，其运动也会变得自由而没有意义。",[82,95,96],{},"  那么，我们该如何选择？重还是轻？",[82,98,99],{},"                      ——　给　四姨",[82,101,102],{},"                      一个很重的朋友",[82,104,105],{},"                        祝她幸福",[82,107,108],{},"  大家都拍完了，该洗洗睡了。明天中午起来，然后又是一天……再几个日落日出后，太阳不知又是什么颜色了……",{"title":110,"searchDepth":111,"depth":111,"links":112},"",2,[],[6],"我床边的书是“米兰昆德拉”的《不能承受的生命之轻》。真的很好！","md",{"date":117},"2007-10-10 03:41",true,"\u002Fblog\u002Fblog_4af9831b01000b6e",{"title":77,"description":114},"blog_4af9831b01000b6e","blog\u002Fblog_4af9831b01000b6e",[],"SGbGg87Tc5Fr4SlhmPJIlxRMSxk45efIpEMMy8lhpbs",[126,131],{"title":127,"path":128,"stem":129,"children":-1,"slug":130},"1 等待","\u002Fblog\u002Fblog_4af9831b01000b6d","blog\u002Fblog_4af9831b01000b6d","blog_4af9831b01000b6d",{"title":132,"path":133,"stem":134,"children":-1,"slug":135},"2 选择","\u002Fblog\u002Fblog_4af9831b01000b6f","blog\u002Fblog_4af9831b01000b6f","blog_4af9831b01000b6f",1794412500915]
[{"data":1,"prerenderedAt":137},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":58,"blog-post-slug-blog_4af9831b010009r6":75,"surround-blog_4af9831b010009r6":126},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":54,"site_description":55,"stem":56,"__hash__":57},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo",20,"新浪博客内容备份","settings","hh8X7X6SFDoeJrxIJ4yisZXSc3HwHM1zk206jiQX2XU",{"latestBlog":59},[60,63,66,69,72],{"title":61,"slug":62},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":64,"slug":65},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":67,"slug":68},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":70,"slug":71},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":73,"slug":74},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":76,"title":77,"body":78,"categories":113,"description":114,"extension":115,"meta":116,"navigation":118,"path":119,"seo":120,"slug":121,"stem":122,"tags":123,"__hash__":125},"blog\u002Fblog\u002Fblog_4af9831b010009r6.md","他不是李白",{"type":79,"value":80,"toc":109},"minimark",[81,85,88,91,94,97,100,103,106],[82,83,84],"p",{},"难忘的昨夜.一个小我两岁的兄弟,居然厚颜无耻的领了结婚证!他主演的话剧\"我不是李白\"很好!喜欢!学生气足但却是正统.话剧不可过分杂交,否则那仅存的神圣与尊严也会同化与此刻的纷扰.",[82,86,87],{},"他的求婚方式超浪漫!就在某次演出的结束!当着所有观众的面,献上百朵玫瑰...很多女观众流了泪,感动与此种壮举!小子还成,喜欢话剧,把自己的第一次求婚也就给了舞台!希望这也是他最后一次!祝福这对找到了彼此并能勇敢献出自己的新人!从此,他们不在是一个人...",[82,89,90],{},"我的爱情呢?在哪里?真想看看自己未来老婆到底什么样,省得现在每天和黑猫警长一样瞪着大眼睛漫世界寻找...孩儿他妈,哪混呢?...我要向你求婚的时候,我那兄弟的浪漫绝对是小菜!他不是李白,可我是!",[82,92,93],{},"看了两遍的我,还是为这话剧流了泪.发现自己越活越感伤,真怕再这样下去会成了男版黛玉.",[82,95,96],{},"  我不是夜猫子,事实这两天事情狂多,现在的我巨累超困.但只要上来就想和你们聊聊.也怕自己月底开了机没有那么多时间回复...倒时别说我忘记你们...",[82,98,99],{},"脑子有点混沌...想说什么又忘记了...真的困了...要睡了...",[82,101,102],{},"睡了...",[82,104,105],{},"把口水留在键盘上.",[82,107,108],{},"  把梦留给你...",{"title":110,"searchDepth":111,"depth":111,"links":112},"",2,[],[6],"难忘的昨夜.一个小我两岁的兄弟,居然厚颜无耻的领了结婚证!","md",{"date":117},"2007-08-09 02:48",true,"\u002Fblog\u002Fblog_4af9831b010009r6",{"title":77,"description":114},"blog_4af9831b010009r6","blog\u002Fblog_4af9831b010009r6",[124],"情感故事","lNUBqaIMIIDiJ0oODlCy8J3dsWep-f4bhZ5bxJ9vROo",[127,132],{"title":128,"path":129,"stem":130,"children":-1,"slug":131},"好人 好梦","\u002Fblog\u002Fblog_4af9831b010009q9","blog\u002Fblog_4af9831b010009q9","blog_4af9831b010009q9",{"title":133,"path":134,"stem":135,"children":-1,"slug":136},"广告","\u002Fblog\u002Fblog_4af9831b010009rz","blog\u002Fblog_4af9831b010009rz","blog_4af9831b010009rz",1794412501097]
[{"data":1,"prerenderedAt":96},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":17,"blog-post-slug-blog_4af9831b010009r6":34,"surround-blog_4af9831b010009r6":85},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"latestBlog":18},[19,22,25,28,31],{"title":20,"slug":21},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":23,"slug":24},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":26,"slug":27},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":29,"slug":30},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":32,"slug":33},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":35,"title":36,"body":37,"categories":72,"description":73,"extension":74,"meta":75,"navigation":77,"path":78,"seo":79,"slug":80,"stem":81,"tags":82,"__hash__":84},"blog\u002Fblog\u002Fblog_4af9831b010009r6.md","他不是李白",{"type":38,"value":39,"toc":68},"minimark",[40,44,47,50,53,56,59,62,65],[41,42,43],"p",{},"难忘的昨夜.一个小我两岁的兄弟,居然厚颜无耻的领了结婚证!他主演的话剧\"我不是李白\"很好!喜欢!学生气足但却是正统.话剧不可过分杂交,否则那仅存的神圣与尊严也会同化与此刻的纷扰.",[41,45,46],{},"他的求婚方式超浪漫!就在某次演出的结束!当着所有观众的面,献上百朵玫瑰...很多女观众流了泪,感动与此种壮举!小子还成,喜欢话剧,把自己的第一次求婚也就给了舞台!希望这也是他最后一次!祝福这对找到了彼此并能勇敢献出自己的新人!从此,他们不在是一个人...",[41,48,49],{},"我的爱情呢?在哪里?真想看看自己未来老婆到底什么样,省得现在每天和黑猫警长一样瞪着大眼睛漫世界寻找...孩儿他妈,哪混呢?...我要向你求婚的时候,我那兄弟的浪漫绝对是小菜!他不是李白,可我是!",[41,51,52],{},"看了两遍的我,还是为这话剧流了泪.发现自己越活越感伤,真怕再这样下去会成了男版黛玉.",[41,54,55],{},"  我不是夜猫子,事实这两天事情狂多,现在的我巨累超困.但只要上来就想和你们聊聊.也怕自己月底开了机没有那么多时间回复...倒时别说我忘记你们...",[41,57,58],{},"脑子有点混沌...想说什么又忘记了...真的困了...要睡了...",[41,60,61],{},"睡了...",[41,63,64],{},"把口水留在键盘上.",[41,66,67],{},"  把梦留给你...",{"title":69,"searchDepth":70,"depth":70,"links":71},"",2,[],[6],"难忘的昨夜.一个小我两岁的兄弟,居然厚颜无耻的领了结婚证!","md",{"date":76},"2007-08-09 02:48",true,"\u002Fblog\u002Fblog_4af9831b010009r6",{"title":36,"description":73},"blog_4af9831b010009r6","blog\u002Fblog_4af9831b010009r6",[83],"情感故事","lNUBqaIMIIDiJ0oODlCy8J3dsWep-f4bhZ5bxJ9vROo",[86,91],{"title":87,"path":88,"stem":89,"children":-1,"slug":90},"好人 好梦","\u002Fblog\u002Fblog_4af9831b010009q9","blog\u002Fblog_4af9831b010009q9","blog_4af9831b010009q9",{"title":92,"path":93,"stem":94,"children":-1,"slug":95},"广告","\u002Fblog\u002Fblog_4af9831b010009rz","blog\u002Fblog_4af9831b010009rz","blog_4af9831b010009rz",1794059574214]
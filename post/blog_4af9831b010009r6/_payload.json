[{"data":1,"prerenderedAt":136},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":57,"blog-post-slug-blog_4af9831b010009r6":74,"surround-blog_4af9831b010009r6":125},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":16,"site_description":54,"stem":55,"__hash__":56},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo","新浪博客内容备份(粉丝自用)","settings","jPD1QWrYwbaIixg6lntppEYe-T3ZGd3EJZxFBkbKY9E",{"latestBlog":58},[59,62,65,68,71],{"title":60,"slug":61},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":63,"slug":64},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":66,"slug":67},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":69,"slug":70},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":72,"slug":73},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":75,"title":76,"body":77,"categories":112,"description":113,"extension":114,"meta":115,"navigation":117,"path":118,"seo":119,"slug":120,"stem":121,"tags":122,"__hash__":124},"blog\u002Fblog\u002Fblog_4af9831b010009r6.md","他不是李白",{"type":78,"value":79,"toc":108},"minimark",[80,84,87,90,93,96,99,102,105],[81,82,83],"p",{},"难忘的昨夜.一个小我两岁的兄弟,居然厚颜无耻的领了结婚证!他主演的话剧\"我不是李白\"很好!喜欢!学生气足但却是正统.话剧不可过分杂交,否则那仅存的神圣与尊严也会同化与此刻的纷扰.",[81,85,86],{},"他的求婚方式超浪漫!就在某次演出的结束!当着所有观众的面,献上百朵玫瑰...很多女观众流了泪,感动与此种壮举!小子还成,喜欢话剧,把自己的第一次求婚也就给了舞台!希望这也是他最后一次!祝福这对找到了彼此并能勇敢献出自己的新人!从此,他们不在是一个人...",[81,88,89],{},"我的爱情呢?在哪里?真想看看自己未来老婆到底什么样,省得现在每天和黑猫警长一样瞪着大眼睛漫世界寻找...孩儿他妈,哪混呢?...我要向你求婚的时候,我那兄弟的浪漫绝对是小菜!他不是李白,可我是!",[81,91,92],{},"看了两遍的我,还是为这话剧流了泪.发现自己越活越感伤,真怕再这样下去会成了男版黛玉.",[81,94,95],{},"  我不是夜猫子,事实这两天事情狂多,现在的我巨累超困.但只要上来就想和你们聊聊.也怕自己月底开了机没有那么多时间回复...倒时别说我忘记你们...",[81,97,98],{},"脑子有点混沌...想说什么又忘记了...真的困了...要睡了...",[81,100,101],{},"睡了...",[81,103,104],{},"把口水留在键盘上.",[81,106,107],{},"  把梦留给你...",{"title":109,"searchDepth":110,"depth":110,"links":111},"",2,[],[6],"难忘的昨夜.一个小我两岁的兄弟,居然厚颜无耻的领了结婚证!","md",{"date":116},"2007-08-09 02:48",true,"\u002Fblog\u002Fblog_4af9831b010009r6",{"title":76,"description":113},"blog_4af9831b010009r6","blog\u002Fblog_4af9831b010009r6",[123],"情感故事","lNUBqaIMIIDiJ0oODlCy8J3dsWep-f4bhZ5bxJ9vROo",[126,131],{"title":127,"path":128,"stem":129,"children":-1,"slug":130},"好人 好梦","\u002Fblog\u002Fblog_4af9831b010009q9","blog\u002Fblog_4af9831b010009q9","blog_4af9831b010009q9",{"title":132,"path":133,"stem":134,"children":-1,"slug":135},"广告","\u002Fblog\u002Fblog_4af9831b010009rz","blog\u002Fblog_4af9831b010009rz","blog_4af9831b010009rz",1794473705782]
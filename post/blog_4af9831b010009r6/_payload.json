[{"data":1,"prerenderedAt":149},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":70,"blog-post-slug-blog_4af9831b010009r6":87,"surround-blog_4af9831b010009r6":138},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":45,"navLinks":46,"perPage":16,"prevNextIsExcludeDate":66,"site_description":23,"site_name":67,"stem":68,"__hash__":69},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{},[47,52,56,60,64],{"path":48,"title":49,"target":50,"fa_class":51},"\u002F","博客首页","internal","fa-home",{"path":53,"title":54,"target":50,"fa_class":55},"\u002Fabout","关于","fa-user",{"path":57,"title":58,"target":50,"fa_class":59},"\u002Fpost","归档","fa-archive",{"path":61,"title":62,"target":50,"fa_class":63},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":65,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","jvZHccz2rT-wjVS5GCPgWyhl8WnBIvECPkE5KpKFKCU",{"latestBlog":71},[72,75,78,81,84],{"title":73,"slug":74},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":76,"slug":77},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":79,"slug":80},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":82,"slug":83},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":85,"slug":86},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":88,"title":89,"body":90,"categories":125,"description":126,"extension":127,"meta":128,"navigation":130,"path":131,"seo":132,"slug":133,"stem":134,"tags":135,"__hash__":137},"blog\u002Fblog\u002Fblog_4af9831b010009r6.md","他不是李白",{"type":91,"value":92,"toc":121},"minimark",[93,97,100,103,106,109,112,115,118],[94,95,96],"p",{},"难忘的昨夜.一个小我两岁的兄弟,居然厚颜无耻的领了结婚证!他主演的话剧\"我不是李白\"很好!喜欢!学生气足但却是正统.话剧不可过分杂交,否则那仅存的神圣与尊严也会同化与此刻的纷扰.",[94,98,99],{},"他的求婚方式超浪漫!就在某次演出的结束!当着所有观众的面,献上百朵玫瑰...很多女观众流了泪,感动与此种壮举!小子还成,喜欢话剧,把自己的第一次求婚也就给了舞台!希望这也是他最后一次!祝福这对找到了彼此并能勇敢献出自己的新人!从此,他们不在是一个人...",[94,101,102],{},"我的爱情呢?在哪里?真想看看自己未来老婆到底什么样,省得现在每天和黑猫警长一样瞪着大眼睛漫世界寻找...孩儿他妈,哪混呢?...我要向你求婚的时候,我那兄弟的浪漫绝对是小菜!他不是李白,可我是!",[94,104,105],{},"看了两遍的我,还是为这话剧流了泪.发现自己越活越感伤,真怕再这样下去会成了男版黛玉.",[94,107,108],{},"  我不是夜猫子,事实这两天事情狂多,现在的我巨累超困.但只要上来就想和你们聊聊.也怕自己月底开了机没有那么多时间回复...倒时别说我忘记你们...",[94,110,111],{},"脑子有点混沌...想说什么又忘记了...真的困了...要睡了...",[94,113,114],{},"睡了...",[94,116,117],{},"把口水留在键盘上.",[94,119,120],{},"  把梦留给你...",{"title":122,"searchDepth":123,"depth":123,"links":124},"",2,[],[6],"难忘的昨夜.一个小我两岁的兄弟,居然厚颜无耻的领了结婚证!","md",{"date":129},"2007-08-09 02:48",true,"\u002Fblog\u002Fblog_4af9831b010009r6",{"title":89,"description":126},"blog_4af9831b010009r6","blog\u002Fblog_4af9831b010009r6",[136],"情感故事","lNUBqaIMIIDiJ0oODlCy8J3dsWep-f4bhZ5bxJ9vROo",[139,144],{"title":140,"path":141,"stem":142,"children":-1,"slug":143},"好人 好梦","\u002Fblog\u002Fblog_4af9831b010009q9","blog\u002Fblog_4af9831b010009q9","blog_4af9831b010009q9",{"title":145,"path":146,"stem":147,"children":-1,"slug":148},"广告","\u002Fblog\u002Fblog_4af9831b010009rz","blog\u002Fblog_4af9831b010009rz","blog_4af9831b010009rz",1794546770232]
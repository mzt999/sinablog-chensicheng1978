[{"data":1,"prerenderedAt":92},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b010009r6":31,"surround-blog_4af9831b010009r6":81},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",152,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":69,"description":33,"extension":70,"meta":71,"navigation":73,"path":74,"seo":75,"slug":76,"stem":77,"tags":78,"__hash__":80},"blog\u002Fblog\u002Fblog_4af9831b010009r6.md","他不是李白",{"type":35,"value":36,"toc":65},"minimark",[37,41,44,47,50,53,56,59,62],[38,39,40],"p",{},"难忘的昨夜.一个小我两岁的兄弟,居然厚颜无耻的领了结婚证!他主演的话剧\"我不是李白\"很好!喜欢!学生气足但却是正统.话剧不可过分杂交,否则那仅存的神圣与尊严也会同化与此刻的纷扰.",[38,42,43],{},"他的求婚方式超浪漫!就在某次演出的结束!当着所有观众的面,献上百朵玫瑰...很多女观众流了泪,感动与此种壮举!小子还成,喜欢话剧,把自己的第一次求婚也就给了舞台!希望这也是他最后一次!祝福这对找到了彼此并能勇敢献出自己的新人!从此,他们不在是一个人...",[38,45,46],{},"我的爱情呢?在哪里?真想看看自己未来老婆到底什么样,省得现在每天和黑猫警长一样瞪着大眼睛漫世界寻找...孩儿他妈,哪混呢?...我要向你求婚的时候,我那兄弟的浪漫绝对是小菜!他不是李白,可我是!",[38,48,49],{},"看了两遍的我,还是为这话剧流了泪.发现自己越活越感伤,真怕再这样下去会成了男版黛玉.",[38,51,52],{},"  我不是夜猫子,事实这两天事情狂多,现在的我巨累超困.但只要上来就想和你们聊聊.也怕自己月底开了机没有那么多时间回复...倒时别说我忘记你们...",[38,54,55],{},"脑子有点混沌...想说什么又忘记了...真的困了...要睡了...",[38,57,58],{},"睡了...",[38,60,61],{},"把口水留在键盘上.",[38,63,64],{},"  把梦留给你...",{"title":66,"searchDepth":67,"depth":67,"links":68},"",2,[],[6],"md",{"date":72},"2007-08-09 02:48",true,"\u002Fblog\u002Fblog_4af9831b010009r6",{"title":33,"description":33},"blog_4af9831b010009r6","blog\u002Fblog_4af9831b010009r6",[79],"情感故事","u8SYi8N3bktdx5kbrl9j77kYlC2l4HnbiRJBOra8p6o",[82,87],{"title":83,"path":84,"stem":85,"children":-1,"slug":86},"好人 好梦","\u002Fblog\u002Fblog_4af9831b010009q9","blog\u002Fblog_4af9831b010009q9","blog_4af9831b010009q9",{"title":88,"path":89,"stem":90,"children":-1,"slug":91},"广告","\u002Fblog\u002Fblog_4af9831b010009rz","blog\u002Fblog_4af9831b010009rz","blog_4af9831b010009rz",1793969716015]
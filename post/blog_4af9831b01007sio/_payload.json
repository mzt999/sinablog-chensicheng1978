[{"data":1,"prerenderedAt":148},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":73,"blog-post-slug-blog_4af9831b01007sio":90,"surround-blog_4af9831b01007sio":137},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":48,"navLinks":49,"perPage":16,"prevNextIsExcludeDate":69,"site_description":23,"site_name":70,"stem":71,"__hash__":72},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43,45],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{"href":46,"text":47},"https:\u002F\u002Fmzt999.github.io\u002Fportfolio-chensicheng1978","幕后作品集展示(2012-2026)",{},[50,55,59,63,67],{"path":51,"title":52,"target":53,"fa_class":54},"\u002F","博客首页","internal","fa-home",{"path":56,"title":57,"target":53,"fa_class":58},"\u002Fabout","关于","fa-user",{"path":60,"title":61,"target":53,"fa_class":62},"\u002Fpost","归档","fa-archive",{"path":64,"title":65,"target":53,"fa_class":66},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":68,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","LA_7Y82F2zjQ6-R2_tcWHl356krYL76uqQHBCIU8UZk",{"latestBlog":74},[75,78,81,84,87],{"title":76,"slug":77},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":79,"slug":80},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":82,"slug":83},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":85,"slug":86},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":88,"slug":89},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":91,"title":92,"body":93,"categories":125,"description":99,"extension":126,"meta":127,"navigation":129,"path":130,"seo":131,"slug":132,"stem":133,"tags":134,"__hash__":136},"blog\u002Fblog\u002Fblog_4af9831b01007sio.md","平安夜",{"type":94,"value":95,"toc":121},"minimark",[96,100,103,106,109,112,115,118],[97,98,99],"p",{},"每当节日的时候,人总容易感受孤单.所以此时的人们尽量避免独处.节日,是我们相互慰寄的一个绝佳借口.",[97,101,102],{},"昨夜,我很伤心.为了一个兄弟.他伤害了我,在情感上.我们走着走着,真的会遗失很多.尽管有的遗失让你倍感痛苦,但你却无能为力.我不想失去一个朋友,其实又怎么能失去?他已经在我心里那么多年了,只是以后,他恐怕出现的也只是我的心里了...这就是所谓的无奈吧...可就是昨夜，我又长大了．．．",[97,104,105],{},"说点开心的,刚刚和爸妈还有\"康师傅\"等人一同吃了饭,很温暖的聚会.我把一条自认为最漂亮的围巾转送给了老康,因为我也想让他体会下你们给我的温暖...现在我收到的围巾真的可以开个铺子了...好多还是亲手织的...怎么说呢?感动?你们会不会觉得俗了点?可这是事实!上次录节目带了一条,以后有机会再陆续的带在身上,希望你们见得到!",[97,107,108],{},"刚接到一个久违的朋友从美国达拉斯打来的祝福电话，那里是上午十点多，她还记得这里的时差，选了这个时间打过来，真的是个惊喜了！更让这节日凭添了一道温暖！３年没见，她的混血小宝宝已经可以满地跑了．听得出电话那头她洋溢的幸福．．．是啊，幸福其实离我们很近．．．想想自己，真的不要总忧虑了．．．",[97,110,111],{},"还有，在传媒大学遗失的相机居然也＂跑＂了回来！真的要感谢另一个＂她＂，想法子联系到了我．在我已经遗忘的时候忽又失而复得，用老康的话说＂看！这世界还是好人多吧．．．＂",[97,113,114],{},"是啊，都是好人，好孩子，都会感恩，都会怀念．．．",[97,116,117],{},"平安夜...很美的名字...希望你们平安...也一定会平安的．．．因为我们都相信着爱，并为了她而在不断的追寻，心中有梦，就不算贫穷！对吗？有爱有梦的人，就是个好人！",[97,119,120],{},"谁说过的？好人．．．一生平安．．．",{"title":122,"searchDepth":123,"depth":123,"links":124},"",2,[],[6],"md",{"date":128},"2007-12-24 23:51",true,"\u002Fblog\u002Fblog_4af9831b01007sio",{"title":92,"description":99},"blog_4af9831b01007sio","blog\u002Fblog_4af9831b01007sio",[135],"文化","65M1gi-F70TbdUJvBe6WBKVtY0CWXRVh9AETe7h6Pvo",[138,143],{"title":139,"path":140,"stem":141,"children":-1,"slug":142},"现实照进梦想 --- 望月","\u002Fblog\u002Fblog_4af9831b01007q66","blog\u002Fblog_4af9831b01007q66","blog_4af9831b01007q66",{"title":144,"path":145,"stem":146,"children":-1,"slug":147},"2008 - 1 - 1 开始","\u002Fblog\u002Fblog_4af9831b01007v66","blog\u002Fblog_4af9831b01007v66","blog_4af9831b01007v66",1794760532163]
[{"data":1,"prerenderedAt":151},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":76,"blog-post-slug-blog_4af9831b01007sio":93,"surround-blog_4af9831b01007sio":140},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":38,"meta":50,"navLinks":51,"perPage":16,"prevNextIsExcludeDate":71,"site_description":72,"site_name":73,"stem":74,"__hash__":75},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,26,32],{"text":23},"粉丝自制非官方站点｜素材版权归原权利人所有",{"text":25},"仅兴趣交流、无商业用途｜如有侵权请联系删除",{"text":27,"link":28},"查看",{"href":29,"text":30,"fa_class":31},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":33,"link":34},"如有任何疑问，欢迎",{"href":35,"text":36,"fa_class":37},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[39,42,45,47],{"href":40,"text":41},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":43,"text":44},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":46},"新浪微博备份(2009-2026)",{"href":48,"text":49},"https:\u002F\u002Fmzt999.github.io\u002Fportfolio-chensicheng1978","幕后作品集展示(2012-2026)",{},[52,57,61,65,69],{"path":53,"title":54,"target":55,"fa_class":56},"\u002F","博客首页","internal","fa-home",{"path":58,"title":59,"target":55,"fa_class":60},"\u002Fabout","关于","fa-user",{"path":62,"title":63,"target":55,"fa_class":64},"\u002Fpost","归档","fa-archive",{"path":66,"title":67,"target":55,"fa_class":68},"\u002Fgallery","相册","fa-image",{"path":29,"title":30,"target":70,"fa_class":31},"otherSite",false,"新浪博客内容备份(粉丝自用)","陈思诚的博客","settings","5S7xKt0XLHpkjipbomx4I7pUu50Y7wqtD418LquZj5Q",{"latestBlog":77},[78,81,84,87,90],{"title":79,"slug":80},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":82,"slug":83},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":85,"slug":86},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":88,"slug":89},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":91,"slug":92},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":94,"title":95,"body":96,"categories":128,"description":102,"extension":129,"meta":130,"navigation":132,"path":133,"seo":134,"slug":135,"stem":136,"tags":137,"__hash__":139},"blog\u002Fblog\u002Fblog_4af9831b01007sio.md","平安夜",{"type":97,"value":98,"toc":124},"minimark",[99,103,106,109,112,115,118,121],[100,101,102],"p",{},"每当节日的时候,人总容易感受孤单.所以此时的人们尽量避免独处.节日,是我们相互慰寄的一个绝佳借口.",[100,104,105],{},"昨夜,我很伤心.为了一个兄弟.他伤害了我,在情感上.我们走着走着,真的会遗失很多.尽管有的遗失让你倍感痛苦,但你却无能为力.我不想失去一个朋友,其实又怎么能失去?他已经在我心里那么多年了,只是以后,他恐怕出现的也只是我的心里了...这就是所谓的无奈吧...可就是昨夜，我又长大了．．．",[100,107,108],{},"说点开心的,刚刚和爸妈还有\"康师傅\"等人一同吃了饭,很温暖的聚会.我把一条自认为最漂亮的围巾转送给了老康,因为我也想让他体会下你们给我的温暖...现在我收到的围巾真的可以开个铺子了...好多还是亲手织的...怎么说呢?感动?你们会不会觉得俗了点?可这是事实!上次录节目带了一条,以后有机会再陆续的带在身上,希望你们见得到!",[100,110,111],{},"刚接到一个久违的朋友从美国达拉斯打来的祝福电话，那里是上午十点多，她还记得这里的时差，选了这个时间打过来，真的是个惊喜了！更让这节日凭添了一道温暖！３年没见，她的混血小宝宝已经可以满地跑了．听得出电话那头她洋溢的幸福．．．是啊，幸福其实离我们很近．．．想想自己，真的不要总忧虑了．．．",[100,113,114],{},"还有，在传媒大学遗失的相机居然也＂跑＂了回来！真的要感谢另一个＂她＂，想法子联系到了我．在我已经遗忘的时候忽又失而复得，用老康的话说＂看！这世界还是好人多吧．．．＂",[100,116,117],{},"是啊，都是好人，好孩子，都会感恩，都会怀念．．．",[100,119,120],{},"平安夜...很美的名字...希望你们平安...也一定会平安的．．．因为我们都相信着爱，并为了她而在不断的追寻，心中有梦，就不算贫穷！对吗？有爱有梦的人，就是个好人！",[100,122,123],{},"谁说过的？好人．．．一生平安．．．",{"title":125,"searchDepth":126,"depth":126,"links":127},"",2,[],[6],"md",{"date":131},"2007-12-24 23:51",true,"\u002Fblog\u002Fblog_4af9831b01007sio",{"title":95,"description":102},"blog_4af9831b01007sio","blog\u002Fblog_4af9831b01007sio",[138],"文化","65M1gi-F70TbdUJvBe6WBKVtY0CWXRVh9AETe7h6Pvo",[141,146],{"title":142,"path":143,"stem":144,"children":-1,"slug":145},"现实照进梦想 --- 望月","\u002Fblog\u002Fblog_4af9831b01007q66","blog\u002Fblog_4af9831b01007q66","blog_4af9831b01007q66",{"title":147,"path":148,"stem":149,"children":-1,"slug":150},"2008 - 1 - 1 开始","\u002Fblog\u002Fblog_4af9831b01007v66","blog\u002Fblog_4af9831b01007v66","blog_4af9831b01007v66",1795162025937]
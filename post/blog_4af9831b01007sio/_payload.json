[{"data":1,"prerenderedAt":133},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":58,"blog-post-slug-blog_4af9831b01007sio":75,"surround-blog_4af9831b01007sio":122},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":54,"site_description":55,"stem":56,"__hash__":57},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo",20,"新浪博客内容备份","settings","hh8X7X6SFDoeJrxIJ4yisZXSc3HwHM1zk206jiQX2XU",{"latestBlog":59},[60,63,66,69,72],{"title":61,"slug":62},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":64,"slug":65},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":67,"slug":68},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":70,"slug":71},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":73,"slug":74},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":76,"title":77,"body":78,"categories":110,"description":84,"extension":111,"meta":112,"navigation":114,"path":115,"seo":116,"slug":117,"stem":118,"tags":119,"__hash__":121},"blog\u002Fblog\u002Fblog_4af9831b01007sio.md","平安夜",{"type":79,"value":80,"toc":106},"minimark",[81,85,88,91,94,97,100,103],[82,83,84],"p",{},"每当节日的时候,人总容易感受孤单.所以此时的人们尽量避免独处.节日,是我们相互慰寄的一个绝佳借口.",[82,86,87],{},"昨夜,我很伤心.为了一个兄弟.他伤害了我,在情感上.我们走着走着,真的会遗失很多.尽管有的遗失让你倍感痛苦,但你却无能为力.我不想失去一个朋友,其实又怎么能失去?他已经在我心里那么多年了,只是以后,他恐怕出现的也只是我的心里了...这就是所谓的无奈吧...可就是昨夜，我又长大了．．．",[82,89,90],{},"说点开心的,刚刚和爸妈还有\"康师傅\"等人一同吃了饭,很温暖的聚会.我把一条自认为最漂亮的围巾转送给了老康,因为我也想让他体会下你们给我的温暖...现在我收到的围巾真的可以开个铺子了...好多还是亲手织的...怎么说呢?感动?你们会不会觉得俗了点?可这是事实!上次录节目带了一条,以后有机会再陆续的带在身上,希望你们见得到!",[82,92,93],{},"刚接到一个久违的朋友从美国达拉斯打来的祝福电话，那里是上午十点多，她还记得这里的时差，选了这个时间打过来，真的是个惊喜了！更让这节日凭添了一道温暖！３年没见，她的混血小宝宝已经可以满地跑了．听得出电话那头她洋溢的幸福．．．是啊，幸福其实离我们很近．．．想想自己，真的不要总忧虑了．．．",[82,95,96],{},"还有，在传媒大学遗失的相机居然也＂跑＂了回来！真的要感谢另一个＂她＂，想法子联系到了我．在我已经遗忘的时候忽又失而复得，用老康的话说＂看！这世界还是好人多吧．．．＂",[82,98,99],{},"是啊，都是好人，好孩子，都会感恩，都会怀念．．．",[82,101,102],{},"平安夜...很美的名字...希望你们平安...也一定会平安的．．．因为我们都相信着爱，并为了她而在不断的追寻，心中有梦，就不算贫穷！对吗？有爱有梦的人，就是个好人！",[82,104,105],{},"谁说过的？好人．．．一生平安．．．",{"title":107,"searchDepth":108,"depth":108,"links":109},"",2,[],[6],"md",{"date":113},"2007-12-24 23:51",true,"\u002Fblog\u002Fblog_4af9831b01007sio",{"title":77,"description":84},"blog_4af9831b01007sio","blog\u002Fblog_4af9831b01007sio",[120],"文化","65M1gi-F70TbdUJvBe6WBKVtY0CWXRVh9AETe7h6Pvo",[123,128],{"title":124,"path":125,"stem":126,"children":-1,"slug":127},"现实照进梦想 --- 望月","\u002Fblog\u002Fblog_4af9831b01007q66","blog\u002Fblog_4af9831b01007q66","blog_4af9831b01007q66",{"title":129,"path":130,"stem":131,"children":-1,"slug":132},"2008 - 1 - 1 开始","\u002Fblog\u002Fblog_4af9831b01007v66","blog\u002Fblog_4af9831b01007v66","blog_4af9831b01007v66",1794412500815]
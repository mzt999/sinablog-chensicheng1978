[{"data":1,"prerenderedAt":165},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":58,"blog-post-slug-blog_4af9831b0100096m":75,"surround-blog_4af9831b0100096m":154},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":54,"site_description":55,"stem":56,"__hash__":57},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo",20,"新浪博客内容备份","settings","hh8X7X6SFDoeJrxIJ4yisZXSc3HwHM1zk206jiQX2XU",{"latestBlog":59},[60,63,66,69,72],{"title":61,"slug":62},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":64,"slug":65},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":67,"slug":68},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":70,"slug":71},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":73,"slug":74},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":76,"title":77,"body":78,"categories":143,"description":93,"extension":144,"meta":145,"navigation":147,"path":148,"seo":149,"slug":150,"stem":151,"tags":152,"__hash__":153},"blog\u002Fblog\u002Fblog_4af9831b0100096m.md","0.03克",{"type":79,"value":80,"toc":139},"minimark",[81,88,91,94,97,100,103,106,109,112,115,118,121,124,127,130,133,136],[82,83,84],"p",{},[85,86],"img",{"alt":77,"src":87},"\u002Fpic\u002F4af9831b02000xoy.jpg",[82,89,90],{},"(从左到右:我最爱的女人妈妈,最想念的女人外婆,橙子,大姨)",[82,92,93],{},"一直没勇气上来,也没有时间.怕说到外婆的事,她走了...",[82,95,96],{},"6月21日的上午 8点,外婆走的很平静.在我回到湘潭后的第二天.",[82,98,99],{},"一个最亲近的人忽然离开,永久的离开,你除了接受还能怎样?生活唯一的行为是:妥协.",[82,101,102],{},"三年前太行山的一次经历,我就明白了一个道理:没有谁会陪我们走到最后.一切都是过客.",[82,104,105],{},"可一个人,说不见就不见了...?",[82,107,108],{},"忽然觉得,其实最短的距离不是量词,竟是生死.",[82,110,111],{},"据说,人生前死后的体重差为:0.03克,所以有人说那是灵魂的重量.",[82,113,114],{},"我信.否则我们的爱恨都可灰飞,可思想呢?",[82,116,117],{},"不会凭的消失...",[82,119,120],{},"一定去向何处,等待下次光亮乍现.",[82,122,123],{},"外婆最后的日子看到了我,是我最大的欣慰.",[82,125,126],{},"她一定会好,因为她是好人.",[82,128,129],{},"胖姥,来生咱们再续此缘...",[82,131,132],{},"我信来世,如信前生.",[82,134,135],{},"剩下的,还在这个世界的我们,好好爱身边的人吧,",[82,137,138],{},"时日无多...",{"title":140,"searchDepth":141,"depth":141,"links":142},"",2,[],[6,9],"md",{"date":146},"2007-07-05 19:07",true,"\u002Fblog\u002Fblog_4af9831b0100096m",{"title":77,"description":93},"blog_4af9831b0100096m","blog\u002Fblog_4af9831b0100096m",[],"J3qPJ-QCK8dXBmkneAQFtKgfyQMz3rHaN6lvHXjtDwc",[155,160],{"title":156,"path":157,"stem":158,"children":-1,"slug":159},"外婆","\u002Fblog\u002Fblog_4af9831b010008wn","blog\u002Fblog_4af9831b010008wn","blog_4af9831b010008wn",{"title":161,"path":162,"stem":163,"children":-1,"slug":164},"不知所云","\u002Fblog\u002Fblog_4af9831b0100097f","blog\u002Fblog_4af9831b0100097f","blog_4af9831b0100097f",1794412501179]
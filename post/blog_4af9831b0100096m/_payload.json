[{"data":1,"prerenderedAt":164},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":57,"blog-post-slug-blog_4af9831b0100096m":74,"surround-blog_4af9831b0100096m":153},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":16,"site_description":54,"stem":55,"__hash__":56},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo","新浪博客内容备份(粉丝自用)","settings","jPD1QWrYwbaIixg6lntppEYe-T3ZGd3EJZxFBkbKY9E",{"latestBlog":58},[59,62,65,68,71],{"title":60,"slug":61},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":63,"slug":64},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":66,"slug":67},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":69,"slug":70},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":72,"slug":73},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":75,"title":76,"body":77,"categories":142,"description":92,"extension":143,"meta":144,"navigation":146,"path":147,"seo":148,"slug":149,"stem":150,"tags":151,"__hash__":152},"blog\u002Fblog\u002Fblog_4af9831b0100096m.md","0.03克",{"type":78,"value":79,"toc":138},"minimark",[80,87,90,93,96,99,102,105,108,111,114,117,120,123,126,129,132,135],[81,82,83],"p",{},[84,85],"img",{"alt":76,"src":86},"\u002Fpic\u002F4af9831b02000xoy.jpg",[81,88,89],{},"(从左到右:我最爱的女人妈妈,最想念的女人外婆,橙子,大姨)",[81,91,92],{},"一直没勇气上来,也没有时间.怕说到外婆的事,她走了...",[81,94,95],{},"6月21日的上午 8点,外婆走的很平静.在我回到湘潭后的第二天.",[81,97,98],{},"一个最亲近的人忽然离开,永久的离开,你除了接受还能怎样?生活唯一的行为是:妥协.",[81,100,101],{},"三年前太行山的一次经历,我就明白了一个道理:没有谁会陪我们走到最后.一切都是过客.",[81,103,104],{},"可一个人,说不见就不见了...?",[81,106,107],{},"忽然觉得,其实最短的距离不是量词,竟是生死.",[81,109,110],{},"据说,人生前死后的体重差为:0.03克,所以有人说那是灵魂的重量.",[81,112,113],{},"我信.否则我们的爱恨都可灰飞,可思想呢?",[81,115,116],{},"不会凭的消失...",[81,118,119],{},"一定去向何处,等待下次光亮乍现.",[81,121,122],{},"外婆最后的日子看到了我,是我最大的欣慰.",[81,124,125],{},"她一定会好,因为她是好人.",[81,127,128],{},"胖姥,来生咱们再续此缘...",[81,130,131],{},"我信来世,如信前生.",[81,133,134],{},"剩下的,还在这个世界的我们,好好爱身边的人吧,",[81,136,137],{},"时日无多...",{"title":139,"searchDepth":140,"depth":140,"links":141},"",2,[],[6,9],"md",{"date":145},"2007-07-05 19:07",true,"\u002Fblog\u002Fblog_4af9831b0100096m",{"title":76,"description":92},"blog_4af9831b0100096m","blog\u002Fblog_4af9831b0100096m",[],"J3qPJ-QCK8dXBmkneAQFtKgfyQMz3rHaN6lvHXjtDwc",[154,159],{"title":155,"path":156,"stem":157,"children":-1,"slug":158},"外婆","\u002Fblog\u002Fblog_4af9831b010008wn","blog\u002Fblog_4af9831b010008wn","blog_4af9831b010008wn",{"title":160,"path":161,"stem":162,"children":-1,"slug":163},"不知所云","\u002Fblog\u002Fblog_4af9831b0100097f","blog\u002Fblog_4af9831b0100097f","blog_4af9831b0100097f",1794473705854]
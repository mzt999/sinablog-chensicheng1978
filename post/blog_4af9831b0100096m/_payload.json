[{"data":1,"prerenderedAt":177},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":70,"blog-post-slug-blog_4af9831b0100096m":87,"surround-blog_4af9831b0100096m":166},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":45,"navLinks":46,"perPage":16,"prevNextIsExcludeDate":66,"site_description":23,"site_name":67,"stem":68,"__hash__":69},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{},[47,52,56,60,64],{"path":48,"title":49,"target":50,"fa_class":51},"\u002F","博客首页","internal","fa-home",{"path":53,"title":54,"target":50,"fa_class":55},"\u002Fabout","关于","fa-user",{"path":57,"title":58,"target":50,"fa_class":59},"\u002Fpost","归档","fa-archive",{"path":61,"title":62,"target":50,"fa_class":63},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":65,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","jvZHccz2rT-wjVS5GCPgWyhl8WnBIvECPkE5KpKFKCU",{"latestBlog":71},[72,75,78,81,84],{"title":73,"slug":74},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":76,"slug":77},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":79,"slug":80},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":82,"slug":83},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":85,"slug":86},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":88,"title":89,"body":90,"categories":155,"description":105,"extension":156,"meta":157,"navigation":159,"path":160,"seo":161,"slug":162,"stem":163,"tags":164,"__hash__":165},"blog\u002Fblog\u002Fblog_4af9831b0100096m.md","0.03克",{"type":91,"value":92,"toc":151},"minimark",[93,100,103,106,109,112,115,118,121,124,127,130,133,136,139,142,145,148],[94,95,96],"p",{},[97,98],"img",{"alt":89,"src":99},"\u002Fpic\u002F4af9831b02000xoy.jpg",[94,101,102],{},"(从左到右:我最爱的女人妈妈,最想念的女人外婆,橙子,大姨)",[94,104,105],{},"一直没勇气上来,也没有时间.怕说到外婆的事,她走了...",[94,107,108],{},"6月21日的上午 8点,外婆走的很平静.在我回到湘潭后的第二天.",[94,110,111],{},"一个最亲近的人忽然离开,永久的离开,你除了接受还能怎样?生活唯一的行为是:妥协.",[94,113,114],{},"三年前太行山的一次经历,我就明白了一个道理:没有谁会陪我们走到最后.一切都是过客.",[94,116,117],{},"可一个人,说不见就不见了...?",[94,119,120],{},"忽然觉得,其实最短的距离不是量词,竟是生死.",[94,122,123],{},"据说,人生前死后的体重差为:0.03克,所以有人说那是灵魂的重量.",[94,125,126],{},"我信.否则我们的爱恨都可灰飞,可思想呢?",[94,128,129],{},"不会凭的消失...",[94,131,132],{},"一定去向何处,等待下次光亮乍现.",[94,134,135],{},"外婆最后的日子看到了我,是我最大的欣慰.",[94,137,138],{},"她一定会好,因为她是好人.",[94,140,141],{},"胖姥,来生咱们再续此缘...",[94,143,144],{},"我信来世,如信前生.",[94,146,147],{},"剩下的,还在这个世界的我们,好好爱身边的人吧,",[94,149,150],{},"时日无多...",{"title":152,"searchDepth":153,"depth":153,"links":154},"",2,[],[6,9],"md",{"date":158},"2007-07-05 19:07",true,"\u002Fblog\u002Fblog_4af9831b0100096m",{"title":89,"description":105},"blog_4af9831b0100096m","blog\u002Fblog_4af9831b0100096m",[],"J3qPJ-QCK8dXBmkneAQFtKgfyQMz3rHaN6lvHXjtDwc",[167,172],{"title":168,"path":169,"stem":170,"children":-1,"slug":171},"外婆","\u002Fblog\u002Fblog_4af9831b010008wn","blog\u002Fblog_4af9831b010008wn","blog_4af9831b010008wn",{"title":173,"path":174,"stem":175,"children":-1,"slug":176},"不知所云","\u002Fblog\u002Fblog_4af9831b0100097f","blog\u002Fblog_4af9831b0100097f","blog_4af9831b0100097f",1794546770417]
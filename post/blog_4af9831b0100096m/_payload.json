[{"data":1,"prerenderedAt":121},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b0100096m":31,"surround-blog_4af9831b0100096m":110},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",152,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":99,"description":33,"extension":100,"meta":101,"navigation":103,"path":104,"seo":105,"slug":106,"stem":107,"tags":108,"__hash__":109},"blog\u002Fblog\u002Fblog_4af9831b0100096m.md","0.03克",{"type":35,"value":36,"toc":95},"minimark",[37,44,47,50,53,56,59,62,65,68,71,74,77,80,83,86,89,92],[38,39,40],"p",{},[41,42],"img",{"alt":33,"src":43},"\u002Fpic\u002F4af9831b02000xoy.jpg",[38,45,46],{},"(从左到右:我最爱的女人妈妈,最想念的女人外婆,橙子,大姨)",[38,48,49],{},"一直没勇气上来,也没有时间.怕说到外婆的事,她走了...",[38,51,52],{},"6月21日的上午 8点,外婆走的很平静.在我回到湘潭后的第二天.",[38,54,55],{},"一个最亲近的人忽然离开,永久的离开,你除了接受还能怎样?生活唯一的行为是:妥协.",[38,57,58],{},"三年前太行山的一次经历,我就明白了一个道理:没有谁会陪我们走到最后.一切都是过客.",[38,60,61],{},"可一个人,说不见就不见了...?",[38,63,64],{},"忽然觉得,其实最短的距离不是量词,竟是生死.",[38,66,67],{},"据说,人生前死后的体重差为:0.03克,所以有人说那是灵魂的重量.",[38,69,70],{},"我信.否则我们的爱恨都可灰飞,可思想呢?",[38,72,73],{},"不会凭的消失...",[38,75,76],{},"一定去向何处,等待下次光亮乍现.",[38,78,79],{},"外婆最后的日子看到了我,是我最大的欣慰.",[38,81,82],{},"她一定会好,因为她是好人.",[38,84,85],{},"胖姥,来生咱们再续此缘...",[38,87,88],{},"我信来世,如信前生.",[38,90,91],{},"剩下的,还在这个世界的我们,好好爱身边的人吧,",[38,93,94],{},"时日无多...",{"title":96,"searchDepth":97,"depth":97,"links":98},"",2,[],[6,9],"md",{"date":102},"2007-07-05 19:07",true,"\u002Fblog\u002Fblog_4af9831b0100096m",{"title":33,"description":33},"blog_4af9831b0100096m","blog\u002Fblog_4af9831b0100096m",[],"lBqvTnYzG5BxtfnOtYHCDQU0Oo1uykJo9HobqCDLA48",[111,116],{"title":112,"path":113,"stem":114,"children":-1,"slug":115},"外婆","\u002Fblog\u002Fblog_4af9831b010008wn","blog\u002Fblog_4af9831b010008wn","blog_4af9831b010008wn",{"title":117,"path":118,"stem":119,"children":-1,"slug":120},"不知所云","\u002Fblog\u002Fblog_4af9831b0100097f","blog\u002Fblog_4af9831b0100097f","blog_4af9831b0100097f",1793969716119]
[{"data":1,"prerenderedAt":124},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":17,"blog-post-slug-blog_4af9831b0100096m":34,"surround-blog_4af9831b0100096m":113},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"latestBlog":18},[19,22,25,28,31],{"title":20,"slug":21},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":23,"slug":24},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":26,"slug":27},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":29,"slug":30},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":32,"slug":33},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":35,"title":36,"body":37,"categories":102,"description":52,"extension":103,"meta":104,"navigation":106,"path":107,"seo":108,"slug":109,"stem":110,"tags":111,"__hash__":112},"blog\u002Fblog\u002Fblog_4af9831b0100096m.md","0.03克",{"type":38,"value":39,"toc":98},"minimark",[40,47,50,53,56,59,62,65,68,71,74,77,80,83,86,89,92,95],[41,42,43],"p",{},[44,45],"img",{"alt":36,"src":46},"\u002Fpic\u002F4af9831b02000xoy.jpg",[41,48,49],{},"(从左到右:我最爱的女人妈妈,最想念的女人外婆,橙子,大姨)",[41,51,52],{},"一直没勇气上来,也没有时间.怕说到外婆的事,她走了...",[41,54,55],{},"6月21日的上午 8点,外婆走的很平静.在我回到湘潭后的第二天.",[41,57,58],{},"一个最亲近的人忽然离开,永久的离开,你除了接受还能怎样?生活唯一的行为是:妥协.",[41,60,61],{},"三年前太行山的一次经历,我就明白了一个道理:没有谁会陪我们走到最后.一切都是过客.",[41,63,64],{},"可一个人,说不见就不见了...?",[41,66,67],{},"忽然觉得,其实最短的距离不是量词,竟是生死.",[41,69,70],{},"据说,人生前死后的体重差为:0.03克,所以有人说那是灵魂的重量.",[41,72,73],{},"我信.否则我们的爱恨都可灰飞,可思想呢?",[41,75,76],{},"不会凭的消失...",[41,78,79],{},"一定去向何处,等待下次光亮乍现.",[41,81,82],{},"外婆最后的日子看到了我,是我最大的欣慰.",[41,84,85],{},"她一定会好,因为她是好人.",[41,87,88],{},"胖姥,来生咱们再续此缘...",[41,90,91],{},"我信来世,如信前生.",[41,93,94],{},"剩下的,还在这个世界的我们,好好爱身边的人吧,",[41,96,97],{},"时日无多...",{"title":99,"searchDepth":100,"depth":100,"links":101},"",2,[],[6,9],"md",{"date":105},"2007-07-05 19:07",true,"\u002Fblog\u002Fblog_4af9831b0100096m",{"title":36,"description":52},"blog_4af9831b0100096m","blog\u002Fblog_4af9831b0100096m",[],"J3qPJ-QCK8dXBmkneAQFtKgfyQMz3rHaN6lvHXjtDwc",[114,119],{"title":115,"path":116,"stem":117,"children":-1,"slug":118},"外婆","\u002Fblog\u002Fblog_4af9831b010008wn","blog\u002Fblog_4af9831b010008wn","blog_4af9831b010008wn",{"title":120,"path":121,"stem":122,"children":-1,"slug":123},"不知所云","\u002Fblog\u002Fblog_4af9831b0100097f","blog\u002Fblog_4af9831b0100097f","blog_4af9831b0100097f",1794397913275]
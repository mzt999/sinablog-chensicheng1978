[{"data":1,"prerenderedAt":98},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":17,"blog-post-slug-blog_4af9831b010006p2":34,"surround-blog_4af9831b010006p2":87},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"latestBlog":18},[19,22,25,28,31],{"title":20,"slug":21},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":23,"slug":24},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":26,"slug":27},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":29,"slug":30},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":32,"slug":33},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":35,"title":36,"body":37,"categories":75,"description":76,"extension":77,"meta":78,"navigation":80,"path":81,"seo":82,"slug":83,"stem":84,"tags":85,"__hash__":86},"blog\u002Fblog\u002Fblog_4af9831b010006p2.md","在 200六 的最后一天",{"type":38,"value":39,"toc":71},"minimark",[40,44,47,50,53,56,59,62,65,68],[41,42,43],"p",{},"马上就要进入2006的最后一天了 还有几分钟 又是一年 时间匆忙的像是玩笑\n我们又老了一岁",[41,45,46],{},"任谁都没法和时间大爷叫板 在这一法则上伟人和白痴同样平等 嘿嘿\n其实仔细想想 时光长河烟波浩淼 前有历史后有未来\n我们生存在同一个时代也算是种缘分呢 不能相互温暖至少能彼此感知?\n上来看到你们的留言很感动 这些从没见过的朋友 有一天\n一定会有一天要把你们都叫到一起\n就在我家的院子里 看看星星 喝点酒 谈谈彼此的经历\n分享下各自的人生 把精彩拿出来让大家一起笑\n把痛苦摆桌上让大家一起哭\n我会用自己的努力尽快促成这样的一夜\n因为我相信善良的人们在一起\n会有那种无名的默契  明天你们会怎么过?\n我的大学同学会相约到班长家迎接2007  走出校园后\n很多人会怀念 会回味 甚至会后悔\n因为曾经的那些朴素的感情只有走出校园和社会的人情冷暖相交错后才显得分外的弥足珍贵\n(SO小狼 你还在校园一定要珍惜啊)  又是一年了\n真的又是一年了 2006 那些不顺和烦脑都见鬼去吧!!!!! 2007\n我会拿出全部的勇气来面对你 来吧\n没什么了不起!!!!!!!!希望你们和我一样大声的喊出来!!!!!",[41,48,49],{},"希望所有看过这片文章的你们 都可以在2007顺利 健康!!!!!!",[41,51,52],{},"２００７　爱情来吧＾＾＾＾＾＾＾＾＾＾＾",[41,54,55],{},"２００７　幸福来吧＾＾＾＾＾＾＾＾＾＾＾",[41,57,58],{},"２００７　快乐来吧＾＾＾＾＾＾＾＾＾＾＾",[41,60,61],{},"２００７　我最爱的爸爸妈妈要健康　我所有的朋友要健康　咱妈和所有的同学要健康",[41,63,64],{},"所有我爱的人都要幸福健康＾＾＾＾＾＾＾＾＾",[41,66,67],{},"2007\n我会在这里一直等你……",[41,69,70],{},"已经是１２月３１日了　妈的　２００６终于要走了　好的坏的都不会回来了＾＾＾　呵呵",{"title":72,"searchDepth":73,"depth":73,"links":74},"",2,[],[6],"马上就要进入2006的最后一天了 还有几分钟 又是一年 时间匆忙的像是玩笑","md",{"date":79},"2006-12-30 23:50"
[{"data":1,"prerenderedAt":105},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b01008e2i":31,"surround-blog_4af9831b01008e2i":94},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",152,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":81,"description":33,"extension":82,"meta":83,"navigation":85,"path":86,"seo":87,"slug":88,"stem":89,"tags":90,"__hash__":93},"blog\u002Fblog\u002Fblog_4af9831b01008e2i.md","奇迹---祝福",{"type":35,"value":36,"toc":77},"minimark",[37,41,44,47,50,53,56,59,62,65,68,71,74],[38,39,40],"p",{},"刚看了2群的视频\"烟花\",差点留下鳄鱼泪。",[38,42,43],{},"和很多人比无疑我是幸者，因为有你们。很多人想我明天来，所以今天来了，总能被你们看穿这事不太成熟。",[38,45,46],{},"我已学会走，所以最近想跑想飞，虽不知结果如何，但深信谋事在人。",[38,48,49],{},"必须声明最近没来不是懒惰，而是把时间用在别处，期望这时间以后你们会看到。",[38,51,52],{},"给自己一个祝福，关于一个，梦。",[38,54,55],{},"小午说，赢是一切！没错，我们可以输给命运但绝不能败给自己。",[38,57,58],{},"他起飞了，悬空于什刹海。我的梦想也在那里，未知的只能交给个家伙叫时间。",[38,60,61],{},"感谢最早给我生日祝福的一个小公主，我知道你在看着，因为我们都是好孩子。",[38,63,64],{},"还是不想说什么，姜文期待太阳照常升起，我却想它落下，这样夜才会走近，月亮才会爬上来。",[38,66,67],{},"爱爱爱，是我的冥想，他的轮回。今生是无数个前世的怨与缘，若干个来世的换与还。今生我们一起，来世同样相逢。一个擦肩一次拥吻一夜同眠，回首，皆是百年孪。谁说该有恨？无常便知无偿……",[38,69,70],{},"感谢爸爸妈妈，祝他们都好。",[38,72,73],{},"感谢生命，让我体验。",[38,75,76],{},"期望下个轮回，同样精彩。",{"title":78,"searchDepth":79,"depth":79,"links":80},"",2,[],[6],"md",{"date":84},"2008-02-21 14:48",true,"\u002Fblog\u002Fblog_4af9831b01008e2i",{"title":33,"description":33},"blog_4af9831b01008e2i","blog\u002Fblog_4af9831b01008e2i",[91,92],"不是娱乐","情感","Oa7DHqOtp0tb3VPbJpL48HZMfMTbberb3J9wLEcImDE",[95,100],{"title":96,"path":97,"stem":98,"children":-1,"slug":99},"\u003C我们的故事>","\u002Fblog\u002Fblog_4af9831b01008bl0","blog\u002Fblog_4af9831b01008bl0","blog_4af9831b01008bl0",{"title":101,"path":102,"stem":103,"children":-1,"slug":104},"感谢二群","\u002Fblog\u002Fblog_4af9831b01008e8a","blog\u002Fblog_4af9831b01008e8a","blog_4af9831b01008e8a",1793978004087]
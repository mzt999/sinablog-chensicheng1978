[{"data":1,"prerenderedAt":164},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":73,"blog-post-slug-blog_4af9831b01008e2i":90,"surround-blog_4af9831b01008e2i":153},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":48,"navLinks":49,"perPage":16,"prevNextIsExcludeDate":69,"site_description":23,"site_name":70,"stem":71,"__hash__":72},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43,45],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{"href":46,"text":47},"https:\u002F\u002Fmzt999.github.io\u002Fportfolio-chensicheng1978","幕后作品集展示(2012-2026)",{},[50,55,59,63,67],{"path":51,"title":52,"target":53,"fa_class":54},"\u002F","博客首页","internal","fa-home",{"path":56,"title":57,"target":53,"fa_class":58},"\u002Fabout","关于","fa-user",{"path":60,"title":61,"target":53,"fa_class":62},"\u002Fpost","归档","fa-archive",{"path":64,"title":65,"target":53,"fa_class":66},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":68,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","LA_7Y82F2zjQ6-R2_tcWHl356krYL76uqQHBCIU8UZk",{"latestBlog":74},[75,78,81,84,87],{"title":76,"slug":77},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":79,"slug":80},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":82,"slug":83},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":85,"slug":86},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":88,"slug":89},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":91,"title":92,"body":93,"categories":140,"description":99,"extension":141,"meta":142,"navigation":144,"path":145,"seo":146,"slug":147,"stem":148,"tags":149,"__hash__":152},"blog\u002Fblog\u002Fblog_4af9831b01008e2i.md","奇迹---祝福",{"type":94,"value":95,"toc":136},"minimark",[96,100,103,106,109,112,115,118,121,124,127,130,133],[97,98,99],"p",{},"刚看了2群的视频\"烟花\",差点留下鳄鱼泪。",[97,101,102],{},"和很多人比无疑我是幸者，因为有你们。很多人想我明天来，所以今天来了，总能被你们看穿这事不太成熟。",[97,104,105],{},"我已学会走，所以最近想跑想飞，虽不知结果如何，但深信谋事在人。",[97,107,108],{},"必须声明最近没来不是懒惰，而是把时间用在别处，期望这时间以后你们会看到。",[97,110,111],{},"给自己一个祝福，关于一个，梦。",[97,113,114],{},"小午说，赢是一切！没错，我们可以输给命运但绝不能败给自己。",[97,116,117],{},"他起飞了，悬空于什刹海。我的梦想也在那里，未知的只能交给个家伙叫时间。",[97,119,120],{},"感谢最早给我生日祝福的一个小公主，我知道你在看着，因为我们都是好孩子。",[97,122,123],{},"还是不想说什么，姜文期待太阳照常升起，我却想它落下，这样夜才会走近，月亮才会爬上来。",[97,125,126],{},"爱爱爱，是我的冥想，他的轮回。今生是无数个前世的怨与缘，若干个来世的换与还。今生我们一起，来世同样相逢。一个擦肩一次拥吻一夜同眠，回首，皆是百年孪。谁说该有恨？无常便知无偿……",[97,128,129],{},"感谢爸爸妈妈，祝他们都好。",[97,131,132],{},"感谢生命，让我体验。",[97,134,135],{},"期望下个轮回，同样精彩。",{"title":137,"searchDepth":138,"depth":138,"links":139},"",2,[],[6],"md",{"date":143},"2008-02-21 14:48",true,"\u002Fblog\u002Fblog_4af9831b01008e2i",{"title":92,"description":99},"blog_4af9831b01008e2i","blog\u002Fblog_4af9831b01008e2i",[150,151],"不是娱乐","情感","HK8Oz9a-1_2GG71VCLpYbmlRI2idJBkeQZ3dqcJ20TY",[154,159],{"title":155,"path":156,"stem":157,"children":-1,"slug":158},"\u003C我们的故事>","\u002Fblog\u002Fblog_4af9831b01008bl0","blog\u002Fblog_4af9831b01008bl0","blog_4af9831b01008bl0",{"title":160,"path":161,"stem":162,"children":-1,"slug":163},"感谢二群","\u002Fblog\u002Fblog_4af9831b01008e8a","blog\u002Fblog_4af9831b01008e8a","blog_4af9831b01008e8a",1794760532134]
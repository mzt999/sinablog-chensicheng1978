[{"data":1,"prerenderedAt":161},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":70,"blog-post-slug-blog_4af9831b01008e2i":87,"surround-blog_4af9831b01008e2i":150},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":45,"navLinks":46,"perPage":16,"prevNextIsExcludeDate":66,"site_description":23,"site_name":67,"stem":68,"__hash__":69},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{},[47,52,56,60,64],{"path":48,"title":49,"target":50,"fa_class":51},"\u002F","博客首页","internal","fa-home",{"path":53,"title":54,"target":50,"fa_class":55},"\u002Fabout","关于","fa-user",{"path":57,"title":58,"target":50,"fa_class":59},"\u002Fpost","归档","fa-archive",{"path":61,"title":62,"target":50,"fa_class":63},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":65,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","jvZHccz2rT-wjVS5GCPgWyhl8WnBIvECPkE5KpKFKCU",{"latestBlog":71},[72,75,78,81,84],{"title":73,"slug":74},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":76,"slug":77},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":79,"slug":80},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":82,"slug":83},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":85,"slug":86},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":88,"title":89,"body":90,"categories":137,"description":96,"extension":138,"meta":139,"navigation":141,"path":142,"seo":143,"slug":144,"stem":145,"tags":146,"__hash__":149},"blog\u002Fblog\u002Fblog_4af9831b01008e2i.md","奇迹---祝福",{"type":91,"value":92,"toc":133},"minimark",[93,97,100,103,106,109,112,115,118,121,124,127,130],[94,95,96],"p",{},"刚看了2群的视频\"烟花\",差点留下鳄鱼泪。",[94,98,99],{},"和很多人比无疑我是幸者，因为有你们。很多人想我明天来，所以今天来了，总能被你们看穿这事不太成熟。",[94,101,102],{},"我已学会走，所以最近想跑想飞，虽不知结果如何，但深信谋事在人。",[94,104,105],{},"必须声明最近没来不是懒惰，而是把时间用在别处，期望这时间以后你们会看到。",[94,107,108],{},"给自己一个祝福，关于一个，梦。",[94,110,111],{},"小午说，赢是一切！没错，我们可以输给命运但绝不能败给自己。",[94,113,114],{},"他起飞了，悬空于什刹海。我的梦想也在那里，未知的只能交给个家伙叫时间。",[94,116,117],{},"感谢最早给我生日祝福的一个小公主，我知道你在看着，因为我们都是好孩子。",[94,119,120],{},"还是不想说什么，姜文期待太阳照常升起，我却想它落下，这样夜才会走近，月亮才会爬上来。",[94,122,123],{},"爱爱爱，是我的冥想，他的轮回。今生是无数个前世的怨与缘，若干个来世的换与还。今生我们一起，来世同样相逢。一个擦肩一次拥吻一夜同眠，回首，皆是百年孪。谁说该有恨？无常便知无偿……",[94,125,126],{},"感谢爸爸妈妈，祝他们都好。",[94,128,129],{},"感谢生命，让我体验。",[94,131,132],{},"期望下个轮回，同样精彩。",{"title":134,"searchDepth":135,"depth":135,"links":136},"",2,[],[6],"md",{"date":140},"2008-02-21 14:48",true,"\u002Fblog\u002Fblog_4af9831b01008e2i",{"title":89,"description":96},"blog_4af9831b01008e2i","blog\u002Fblog_4af9831b01008e2i",[147,148],"不是娱乐","情感","HK8Oz9a-1_2GG71VCLpYbmlRI2idJBkeQZ3dqcJ20TY",[151,156],{"title":152,"path":153,"stem":154,"children":-1,"slug":155},"\u003C我们的故事>","\u002Fblog\u002Fblog_4af9831b01008bl0","blog\u002Fblog_4af9831b01008bl0","blog_4af9831b01008bl0",{"title":157,"path":158,"stem":159,"children":-1,"slug":160},"感谢二群","\u002Fblog\u002Fblog_4af9831b01008e8a","blog\u002Fblog_4af9831b01008e8a","blog_4af9831b01008e8a",1794546769860]
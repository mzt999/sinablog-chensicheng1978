[{"data":1,"prerenderedAt":108},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":17,"blog-post-slug-blog_4af9831b01008e2i":34,"surround-blog_4af9831b01008e2i":97},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"latestBlog":18},[19,22,25,28,31],{"title":20,"slug":21},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":23,"slug":24},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":26,"slug":27},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":29,"slug":30},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":32,"slug":33},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":35,"title":36,"body":37,"categories":84,"description":43,"extension":85,"meta":86,"navigation":88,"path":89,"seo":90,"slug":91,"stem":92,"tags":93,"__hash__":96},"blog\u002Fblog\u002Fblog_4af9831b01008e2i.md","奇迹---祝福",{"type":38,"value":39,"toc":80},"minimark",[40,44,47,50,53,56,59,62,65,68,71,74,77],[41,42,43],"p",{},"刚看了2群的视频\"烟花\",差点留下鳄鱼泪。",[41,45,46],{},"和很多人比无疑我是幸者，因为有你们。很多人想我明天来，所以今天来了，总能被你们看穿这事不太成熟。",[41,48,49],{},"我已学会走，所以最近想跑想飞，虽不知结果如何，但深信谋事在人。",[41,51,52],{},"必须声明最近没来不是懒惰，而是把时间用在别处，期望这时间以后你们会看到。",[41,54,55],{},"给自己一个祝福，关于一个，梦。",[41,57,58],{},"小午说，赢是一切！没错，我们可以输给命运但绝不能败给自己。",[41,60,61],{},"他起飞了，悬空于什刹海。我的梦想也在那里，未知的只能交给个家伙叫时间。",[41,63,64],{},"感谢最早给我生日祝福的一个小公主，我知道你在看着，因为我们都是好孩子。",[41,66,67],{},"还是不想说什么，姜文期待太阳照常升起，我却想它落下，这样夜才会走近，月亮才会爬上来。",[41,69,70],{},"爱爱爱，是我的冥想，他的轮回。今生是无数个前世的怨与缘，若干个来世的换与还。今生我们一起，来世同样相逢。一个擦肩一次拥吻一夜同眠，回首，皆是百年孪。谁说该有恨？无常便知无偿……",[41,72,73],{},"感谢爸爸妈妈，祝他们都好。",[41,75,76],{},"感谢生命，让我体验。",[41,78,79],{},"期望下个轮回，同样精彩。",{"title":81,"searchDepth":82,"depth":82,"links":83},"",2,[],[6],"md",{"date":87},"2008-02-21 14:48",true,"\u002Fblog\u002Fblog_4af9831b01008e2i",{"title":36,"description":43},"blog_4af9831b01008e2i","blog\u002Fblog_4af9831b01008e2i",[94,95],"不是娱乐","情感","HK8Oz9a-1_2GG71VCLpYbmlRI2idJBkeQZ3dqcJ20TY",[98,103],{"title":99,"path":100,"stem":101,"children":-1,"slug":102},"\u003C我们的故事>","\u002Fblog\u002Fblog_4af9831b01008bl0","blog\u002Fblog_4af9831b01008bl0","blog_4af9831b01008bl0",{"title":104,"path":105,"stem":106,"children":-1,"slug":107},"感谢二群","\u002Fblog\u002Fblog_4af9831b01008e8a","blog\u002Fblog_4af9831b01008e8a","blog_4af9831b01008e8a",1794397912853]
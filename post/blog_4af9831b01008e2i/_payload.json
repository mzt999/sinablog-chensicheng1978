[{"data":1,"prerenderedAt":149},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":58,"blog-post-slug-blog_4af9831b01008e2i":75,"surround-blog_4af9831b01008e2i":138},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":54,"site_description":55,"stem":56,"__hash__":57},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo",20,"新浪博客内容备份","settings","hh8X7X6SFDoeJrxIJ4yisZXSc3HwHM1zk206jiQX2XU",{"latestBlog":59},[60,63,66,69,72],{"title":61,"slug":62},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":64,"slug":65},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":67,"slug":68},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":70,"slug":71},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":73,"slug":74},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":76,"title":77,"body":78,"categories":125,"description":84,"extension":126,"meta":127,"navigation":129,"path":130,"seo":131,"slug":132,"stem":133,"tags":134,"__hash__":137},"blog\u002Fblog\u002Fblog_4af9831b01008e2i.md","奇迹---祝福",{"type":79,"value":80,"toc":121},"minimark",[81,85,88,91,94,97,100,103,106,109,112,115,118],[82,83,84],"p",{},"刚看了2群的视频\"烟花\",差点留下鳄鱼泪。",[82,86,87],{},"和很多人比无疑我是幸者，因为有你们。很多人想我明天来，所以今天来了，总能被你们看穿这事不太成熟。",[82,89,90],{},"我已学会走，所以最近想跑想飞，虽不知结果如何，但深信谋事在人。",[82,92,93],{},"必须声明最近没来不是懒惰，而是把时间用在别处，期望这时间以后你们会看到。",[82,95,96],{},"给自己一个祝福，关于一个，梦。",[82,98,99],{},"小午说，赢是一切！没错，我们可以输给命运但绝不能败给自己。",[82,101,102],{},"他起飞了，悬空于什刹海。我的梦想也在那里，未知的只能交给个家伙叫时间。",[82,104,105],{},"感谢最早给我生日祝福的一个小公主，我知道你在看着，因为我们都是好孩子。",[82,107,108],{},"还是不想说什么，姜文期待太阳照常升起，我却想它落下，这样夜才会走近，月亮才会爬上来。",[82,110,111],{},"爱爱爱，是我的冥想，他的轮回。今生是无数个前世的怨与缘，若干个来世的换与还。今生我们一起，来世同样相逢。一个擦肩一次拥吻一夜同眠，回首，皆是百年孪。谁说该有恨？无常便知无偿……",[82,113,114],{},"感谢爸爸妈妈，祝他们都好。",[82,116,117],{},"感谢生命，让我体验。",[82,119,120],{},"期望下个轮回，同样精彩。",{"title":122,"searchDepth":123,"depth":123,"links":124},"",2,[],[6],"md",{"date":128},"2008-02-21 14:48",true,"\u002Fblog\u002Fblog_4af9831b01008e2i",{"title":77,"description":84},"blog_4af9831b01008e2i","blog\u002Fblog_4af9831b01008e2i",[135,136],"不是娱乐","情感","HK8Oz9a-1_2GG71VCLpYbmlRI2idJBkeQZ3dqcJ20TY",[139,144],{"title":140,"path":141,"stem":142,"children":-1,"slug":143},"\u003C我们的故事>","\u002Fblog\u002Fblog_4af9831b01008bl0","blog\u002Fblog_4af9831b01008bl0","blog_4af9831b01008bl0",{"title":145,"path":146,"stem":147,"children":-1,"slug":148},"感谢二群","\u002Fblog\u002Fblog_4af9831b01008e8a","blog\u002Fblog_4af9831b01008e8a","blog_4af9831b01008e8a",1794412500786]
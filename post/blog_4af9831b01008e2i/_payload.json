[{"data":1,"prerenderedAt":148},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":57,"blog-post-slug-blog_4af9831b01008e2i":74,"surround-blog_4af9831b01008e2i":137},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":16,"site_description":54,"stem":55,"__hash__":56},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo","新浪博客内容备份(粉丝自用)","settings","jPD1QWrYwbaIixg6lntppEYe-T3ZGd3EJZxFBkbKY9E",{"latestBlog":58},[59,62,65,68,71],{"title":60,"slug":61},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":63,"slug":64},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":66,"slug":67},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":69,"slug":70},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":72,"slug":73},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":75,"title":76,"body":77,"categories":124,"description":83,"extension":125,"meta":126,"navigation":128,"path":129,"seo":130,"slug":131,"stem":132,"tags":133,"__hash__":136},"blog\u002Fblog\u002Fblog_4af9831b01008e2i.md","奇迹---祝福",{"type":78,"value":79,"toc":120},"minimark",[80,84,87,90,93,96,99,102,105,108,111,114,117],[81,82,83],"p",{},"刚看了2群的视频\"烟花\",差点留下鳄鱼泪。",[81,85,86],{},"和很多人比无疑我是幸者，因为有你们。很多人想我明天来，所以今天来了，总能被你们看穿这事不太成熟。",[81,88,89],{},"我已学会走，所以最近想跑想飞，虽不知结果如何，但深信谋事在人。",[81,91,92],{},"必须声明最近没来不是懒惰，而是把时间用在别处，期望这时间以后你们会看到。",[81,94,95],{},"给自己一个祝福，关于一个，梦。",[81,97,98],{},"小午说，赢是一切！没错，我们可以输给命运但绝不能败给自己。",[81,100,101],{},"他起飞了，悬空于什刹海。我的梦想也在那里，未知的只能交给个家伙叫时间。",[81,103,104],{},"感谢最早给我生日祝福的一个小公主，我知道你在看着，因为我们都是好孩子。",[81,106,107],{},"还是不想说什么，姜文期待太阳照常升起，我却想它落下，这样夜才会走近，月亮才会爬上来。",[81,109,110],{},"爱爱爱，是我的冥想，他的轮回。今生是无数个前世的怨与缘，若干个来世的换与还。今生我们一起，来世同样相逢。一个擦肩一次拥吻一夜同眠，回首，皆是百年孪。谁说该有恨？无常便知无偿……",[81,112,113],{},"感谢爸爸妈妈，祝他们都好。",[81,115,116],{},"感谢生命，让我体验。",[81,118,119],{},"期望下个轮回，同样精彩。",{"title":121,"searchDepth":122,"depth":122,"links":123},"",2,[],[6],"md",{"date":127},"2008-02-21 14:48",true,"\u002Fblog\u002Fblog_4af9831b01008e2i",{"title":76,"description":83},"blog_4af9831b01008e2i","blog\u002Fblog_4af9831b01008e2i",[134,135],"不是娱乐","情感","HK8Oz9a-1_2GG71VCLpYbmlRI2idJBkeQZ3dqcJ20TY",[138,143],{"title":139,"path":140,"stem":141,"children":-1,"slug":142},"\u003C我们的故事>","\u002Fblog\u002Fblog_4af9831b01008bl0","blog\u002Fblog_4af9831b01008bl0","blog_4af9831b01008bl0",{"title":144,"path":145,"stem":146,"children":-1,"slug":147},"感谢二群","\u002Fblog\u002Fblog_4af9831b01008e8a","blog\u002Fblog_4af9831b01008e8a","blog_4af9831b01008e8a",1794473705448]
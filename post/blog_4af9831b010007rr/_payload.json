[{"data":1,"prerenderedAt":73},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b010007rr":31,"surround-blog_4af9831b010007rr":62},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",151,{"name":9,"len":10},"有图",34,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":51,"description":33,"extension":52,"meta":53,"navigation":55,"path":56,"seo":57,"slug":58,"stem":59,"tags":60,"__hash__":61},"blog\u002Fblog\u002Fblog_4af9831b010007rr.md","橙子同学的留言板",{"type":35,"value":36,"toc":47},"minimark",[37,41,44],[38,39,40],"p",{},"几天没上来了,很想你们.77回来了应该不会走了,小鬼又要消失几天.可是她会和我在泰国相见.橙子同学偕老爸老妈本月28日去泰国马来西亚新加坡旅游10天.这10天是一定上不来的,请大家原谅吧.回来以后就要进组了.",[38,42,43],{},"昨晚导演请我们几个吃饭和唱卡拉,真的感觉这两个师妹太贴近角色了.如同男人生命中的红玫瑰和白玫瑰(请原谅我泛酸)但如此迥异且强烈的感觉却实实在在的影响我整晚.同样花般美好可爱的女孩,佳妮如同她扮演的角色安静恬淡外表柔弱却内心坚强.而歆艺却恰好相反张扬热闹感觉咄咄逼人却暗藏纤细的情感和容易受伤的心...看到她们知道这部戏的前景应该很美好,最少等我们老去的时候,可以用它重温我们逝去的青春...",[38,45,46],{},"上来这里,觉得真像留言板.看到你们,倍感温暖.这里是我的一个家,而你们无疑是家的一员...走下去吧,不知这条路有多长,但希望你们能陪我走到终点...",{"title":48,"searchDepth":49,"depth":49,"links":50},"",2,[],[6],"md",{"date":54},"2007-03-23 15:47",true,"\u002Fblog\u002Fblog_4af9831b010007rr",{"title":33,"description":33},"blog_4af9831b010007rr","blog\u002Fblog_4af9831b010007rr",[],"22yCpRd3yk98goccZ9qxNHyezcQQXqeGw1NW_1leIWc",[63,68],{"title":64,"path":65,"stem":66,"children":-1,"slug":67},"最新的公告","\u002Fblog\u002Fblog_4af9831b010007ov","blog\u002Fblog_4af9831b010007ov","blog_4af9831b010007ov",{"title":69,"path":70,"stem":71,"children":-1,"slug":72},"匆匆一别","\u002Fblog\u002Fblog_4af9831b010007tp","blog\u002Fblog_4af9831b010007tp","blog_4af9831b010007tp",1793849575846]
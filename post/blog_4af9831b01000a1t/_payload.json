[{"data":1,"prerenderedAt":159},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":70,"blog-post-slug-blog_4af9831b01000a1t":87,"surround-blog_4af9831b01000a1t":148},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":45,"navLinks":46,"perPage":16,"prevNextIsExcludeDate":66,"site_description":23,"site_name":67,"stem":68,"__hash__":69},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{},[47,52,56,60,64],{"path":48,"title":49,"target":50,"fa_class":51},"\u002F","博客首页","internal","fa-home",{"path":53,"title":54,"target":50,"fa_class":55},"\u002Fabout","关于","fa-user",{"path":57,"title":58,"target":50,"fa_class":59},"\u002Fpost","归档","fa-archive",{"path":61,"title":62,"target":50,"fa_class":63},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":65,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","jvZHccz2rT-wjVS5GCPgWyhl8WnBIvECPkE5KpKFKCU",{"latestBlog":71},[72,75,78,81,84],{"title":73,"slug":74},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":76,"slug":77},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":79,"slug":80},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":82,"slug":83},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":85,"slug":86},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":88,"title":89,"body":90,"categories":134,"description":96,"extension":135,"meta":136,"navigation":138,"path":139,"seo":140,"slug":141,"stem":142,"tags":143,"__hash__":147},"blog\u002Fblog\u002Fblog_4af9831b01000a1t.md","东莞，今夜请将我遗忘。。。",{"type":91,"value":92,"toc":130},"minimark",[93,97,100,103,106,109,112,115,118,121,124,127],[94,95,96],"p",{},"又是如此晚,没错.无论北京或此刻的东莞。因为我越夜越美丽!怎样?",[94,98,99],{},"那是吹!其实已经强弩之末,不过真的夜会让我冷静沉溺感伤和想抒情。靠！",[94,101,102],{},"一切都好,明天中午起床下午的戏。此刻，一个误打开的博客里播发出的歌正伴着我，别人的精心编排到我这里变成一个个惊喜，这种快感也是我回纸条和留言的最大动力！生活需要惊喜！如果你愿意，我恨不得变成打家劫舍的圣诞老人，每晚出现在不同的你们的床头，在你对我傻笑的时候偷走你的梦。",[94,104,105],{},"今天的郁闷缘自一个处心积虑要尽我博客的同志找了半天后的无疾而终！",[94,107,108],{},"谁能告诉我如何可以解决此问题，让这里不再成为百转千回的柳暗花明？百渡那个我名字的闲置地怎能废除？！！？",[94,110,111],{},"SO也就觉得今天来的都不是客!客都被耐心劝回去了。所以你们比我牛X，我自己要不是用最简单的连接也不会废尽周折爬上来看某人发牢骚。",[94,113,114],{},"“雨婷们”莅临，给橙子送来了\"橙子\"，还不让吃，其心可诛！东莞还没来得及仔细辨认，只是觉得“士兵”居然在“出了广东都是北方”的广东人中间也有了诸多拥趸足以证明“好东西”的好是无谓地域之分。",[94,116,117],{},"今天的24个小时除了宝贵的睡觉吃饭还有很宝贵的一个半给了《成都晚报》的“何佳惠”，一个名字和秉性都很“琼瑶”的姑娘。聊了许久士兵和人生。喜欢这样的交流和比较浪漫的新闻工作者。套用老话，喜欢士兵的人不会坏到哪去，一个话题也就让彼此成了一个战壕，也就省了揣摩隐藏遮掩官方，简单直接只击要害，有比爽更爽的感觉吗？",[94,119,120],{},"“晨儿”不是文盲，真的！咱不能觉得一个人词穷，就说他一脑子糨糊！很多人在语言表达方面和自己的思维逻辑及文化底蕴不成正比！也就是俗称的茶壶煮饺子！咱们应该怀揣宽泛的心容忍和接纳一个完人的某些小短处！所以请接纳他在博客里的不着四六！因为他感性，一见我易激动！士兵组好多人都落下这毛病，比如“晨儿”见我好胡言乱语，张毅见老段好抽搐，国强见宝强就手脚发软，口吐白沫什么的……但还是感谢兄弟“晨儿”对我的祝贺！谁说他文盲我和谁急！他就是吴哲！不折不扣的光电双学士！光着身子还放电的学士！",[94,122,123],{},"都说东莞市等同于夜生活？没感觉，目前只是觉得人少绿化多哪哪都是树！",[94,125,126],{},"请东莞大叔今晚让我睡个好觉，4星的宾馆却没让我在这做一天好梦！",[94,128,129],{},"SO。睡吧，东莞 ，今夜请将我遗忘。。。",{"title":131,"searchDepth":132,"depth":132,"links":133},"",2,[],[6],"md",{"date":137},"2007-08-27 03:19",true,"\u002Fblog\u002Fblog_4af9831b01000a1t",{"title":89,"description":96},"blog_4af9831b01000a1t","blog\u002Fblog_4af9831b01000a1t",[144,145,146],"文学\u002F原创","士兵突击","成才","6h4EEaMsCU1Iu3Llh1Yo10QT3X--r_Hq09RFdUFSJDc",[149,154],{"title":150,"path":151,"stem":152,"children":-1,"slug":153},"柿饼土鸡","\u002Fblog\u002Fblog_4af9831b01000a0c","blog\u002Fblog_4af9831b01000a0c","blog_4af9831b01000a0c",{"title":155,"path":156,"stem":157,"children":-1,"slug":158},"速上速下!谅!","\u002Fblog\u002Fblog_4af9831b01000a3w","blog\u002Fblog_4af9831b01000a3w","blog_4af9831b01000a3w",1794546770138]
[{"data":1,"prerenderedAt":118},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b010009g3":31,"surround-blog_4af9831b010009g3":107},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",151,{"name":9,"len":10},"有图",34,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":96,"description":33,"extension":97,"meta":98,"navigation":100,"path":101,"seo":102,"slug":103,"stem":104,"tags":105,"__hash__":106},"blog\u002Fblog\u002Fblog_4af9831b010009g3.md","死去   活来",{"type":35,"value":36,"toc":92},"minimark",[37,41,44,47,50,53,56,59,62,65,68,71,74,77,80,83,86,89],[38,39,40],"p",{},"回京了几天,休息了几天,荒唐了几天,放纵了几天...",[38,42,43],{},"  雷志明死去",[38,45,46],{},"  我",[38,48,49],{},"  活了过来.",[38,51,52],{},"  刚看完最后一点\"千岁寒\",巧,正是21号,又一个月,快.",[38,54,55],{},"王朔什么人,不知道,没见过.",[38,57,58],{},"  但",[38,60,61],{},"自认见了本性,和你想的一样.",[38,63,64],{},"有情又多情的人,此刻,就是想抄书.",[38,66,67],{},"书中说:\n有情种下觉悟这棵种子,因为多情才结出果子,无情也就没有种子,不见本性活百岁也不叫生长.",[38,69,70],{},"  忽然觉得很好,安全感充足",[38,72,73],{},"自己认知了自己,武装了自己,安抚了自己,顺畅了自己,有种小通透,还绽出小光芒...",[38,75,76],{},"剩下的就是等待吧,一定会笑着,没什么可以把此种力量摧毁了.",[38,78,79],{},"  佛说:菩提本无树 明镜亦非台\n本来无一物\n何处惹尘埃   本无佛",[38,81,82],{},"  佛说:一花一世界\n一叶一菩提\n你便是佛",[38,84,85],{},"  佛说:旗未动 风亦未动\n仁者心动\n万物唯心而造\n我便是佛",[38,87,88],{},"书中说:知识,本地信息汇编;真相,三届关系推演;智慧,史前画卷;慈悲,是物质流露的唯一情感;文明,一片空地,自醉自饮.",[38,90,91],{},"    灵魂,每秒三十万公里;轮回,地球吸引力;涅磐,黑色粒子云,热均衡,孤独的坚持,直至无量无劫无边黑暗中那一声无人听到的自颓.",{"title":93,"searchDepth":94,"depth":94,"links":95},"",2,[],[6],"md",{"date":99},"2007-07-21 01:28",true,"\u002Fblog\u002Fblog_4af9831b010009g3",{"title":33,"description":33},"blog_4af9831b010009g3","blog\u002Fblog_4af9831b010009g3",[],"7MEMGoHVrwBDx_yr
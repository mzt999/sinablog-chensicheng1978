[{"data":1,"prerenderedAt":161},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":57,"blog-post-slug-blog_4af9831b010009g3":74,"surround-blog_4af9831b010009g3":150},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":16,"site_description":54,"stem":55,"__hash__":56},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo","新浪博客内容备份(粉丝自用)","settings","jPD1QWrYwbaIixg6lntppEYe-T3ZGd3EJZxFBkbKY9E",{"latestBlog":58},[59,62,65,68,71],{"title":60,"slug":61},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":63,"slug":64},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":66,"slug":67},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":69,"slug":70},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":72,"slug":73},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":75,"title":76,"body":77,"categories":139,"description":83,"extension":140,"meta":141,"navigation":143,"path":144,"seo":145,"slug":146,"stem":147,"tags":148,"__hash__":149},"blog\u002Fblog\u002Fblog_4af9831b010009g3.md","死去   活来",{"type":78,"value":79,"toc":135},"minimark",[80,84,87,90,93,96,99,102,105,108,111,114,117,120,123,126,129,132],[81,82,83],"p",{},"回京了几天,休息了几天,荒唐了几天,放纵了几天...",[81,85,86],{},"  雷志明死去",[81,88,89],{},"  我",[81,91,92],{},"  活了过来.",[81,94,95],{},"  刚看完最后一点\"千岁寒\",巧,正是21号,又一个月,快.",[81,97,98],{},"王朔什么人,不知道,没见过.",[81,100,101],{},"  但",[81,103,104],{},"自认见了本性,和你想的一样.",[81,106,107],{},"有情又多情的人,此刻,就是想抄书.",[81,109,110],{},"书中说:有情种下觉悟这棵种子,因为多情才结出果子,无情也就没有种子,不见本性活百岁也不叫生长.",[81,112,113],{},"  忽然觉得很好,安全感充足",[81,115,116],{},"自己认知了自己,武装了自己,安抚了自己,顺畅了自己,有种小通透,还绽出小光芒...",[81,118,119],{},"剩下的就是等待吧,一定会笑着,没什么可以把此种力量摧毁了.",[81,121,122],{},"  佛说:菩提本无树 明镜亦非台 本来无一物 何处惹尘埃   本无佛",[81,124,125],{},"  佛说:一花一世界 一叶一菩提   你便是佛",[81,127,128],{},"  佛说:旗未动 风亦未动 仁者心动 万物唯心而造   我便是佛",[81,130,131],{},"书中说:知识,本地信息汇编;真相,三届关系推演;智慧,史前画卷;慈悲,是物质流露的唯一情感;文明,一片空地,自醉自饮.",[81,133,134],{},"    灵魂,每秒三十万公里;轮回,地球吸引力;涅磐,黑色粒子云,热均衡,孤独的坚持,直至无量无劫无边黑暗中那一声无人听到的自颓.",{"title":136,"searchDepth":137,"depth":137,"links":138},"",2,[],[6],"md",{"date":142},"2007-07-21 01:28",true,"\u002Fblog\u002Fblog_4af9831b010009g3",{"title":76,"description":83},"blog_4af9831b010009g3","blog\u002Fblog_4af9831b010009g3",[],"t00ogt_XZffIx28YBegn6_92U0O7gVyHw45be_OXb10",[151,156],{"title":152,"path":153,"stem":154,"children":-1,"slug":155},"不知所云","\u002Fblog\u002Fblog_4af9831b0100097f","blog\u002Fblog_4af9831b0100097f","blog_4af9831b0100097f",{"title":157,"path":158,"stem":159,"children":-1,"slug":160},"答案","\u002Fblog\u002Fblog_4af9831b010009gx","blog\u002Fblog_4af9831b010009gx","blog_4af9831b010009gx",1794473705847]
[{"data":1,"prerenderedAt":162},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":58,"blog-post-slug-blog_4af9831b010009g3":75,"surround-blog_4af9831b010009g3":151},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":54,"site_description":55,"stem":56,"__hash__":57},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo",20,"新浪博客内容备份","settings","hh8X7X6SFDoeJrxIJ4yisZXSc3HwHM1zk206jiQX2XU",{"latestBlog":59},[60,63,66,69,72],{"title":61,"slug":62},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":64,"slug":65},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":67,"slug":68},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":70,"slug":71},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":73,"slug":74},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":76,"title":77,"body":78,"categories":140,"description":84,"extension":141,"meta":142,"navigation":144,"path":145,"seo":146,"slug":147,"stem":148,"tags":149,"__hash__":150},"blog\u002Fblog\u002Fblog_4af9831b010009g3.md","死去   活来",{"type":79,"value":80,"toc":136},"minimark",[81,85,88,91,94,97,100,103,106,109,112,115,118,121,124,127,130,133],[82,83,84],"p",{},"回京了几天,休息了几天,荒唐了几天,放纵了几天...",[82,86,87],{},"  雷志明死去",[82,89,90],{},"  我",[82,92,93],{},"  活了过来.",[82,95,96],{},"  刚看完最后一点\"千岁寒\",巧,正是21号,又一个月,快.",[82,98,99],{},"王朔什么人,不知道,没见过.",[82,101,102],{},"  但",[82,104,105],{},"自认见了本性,和你想的一样.",[82,107,108],{},"有情又多情的人,此刻,就是想抄书.",[82,110,111],{},"书中说:有情种下觉悟这棵种子,因为多情才结出果子,无情也就没有种子,不见本性活百岁也不叫生长.",[82,113,114],{},"  忽然觉得很好,安全感充足",[82,116,117],{},"自己认知了自己,武装了自己,安抚了自己,顺畅了自己,有种小通透,还绽出小光芒...",[82,119,120],{},"剩下的就是等待吧,一定会笑着,没什么可以把此种力量摧毁了.",[82,122,123],{},"  佛说:菩提本无树 明镜亦非台 本来无一物 何处惹尘埃   本无佛",[82,125,126],{},"  佛说:一花一世界 一叶一菩提   你便是佛",[82,128,129],{},"  佛说:旗未动 风亦未动 仁者心动 万物唯心而造   我便是佛",[82,131,132],{},"书中说:知识,本地信息汇编;真相,三届关系推演;智慧,史前画卷;慈悲,是物质流露的唯一情感;文明,一片空地,自醉自饮.",[82,134,135],{},"    灵魂,每秒三十万公里;轮回,地球吸引力;涅磐,黑色粒子云,热均衡,孤独的坚持,直至无量无劫无边黑暗中那一声无人听到的自颓.",{"title":137,"searchDepth":138,"depth":138,"links":139},"",2,[],[6],"md",{"date":143},"2007-07-21 01:28",true,"\u002Fblog\u002Fblog_4af9831b010009g3",{"title":77,"description":84},"blog_4af9831b010009g3","blog\u002Fblog_4af9831b010009g3",[],"t00ogt_XZffIx28YBegn6_92U0O7gVyHw45be_OXb10",[152,157],{"title":153,"path":154,"stem":155,"children":-1,"slug":156},"不知所云","\u002Fblog\u002Fblog_4af9831b0100097f","blog\u002Fblog_4af9831b0100097f","blog_4af9831b0100097f",{"title":158,"path":159,"stem":160,"children":-1,"slug":161},"答案","\u002Fblog\u002Fblog_4af9831b010009gx","blog\u002Fblog_4af9831b010009gx","blog_4af9831b010009gx",1794412501158]
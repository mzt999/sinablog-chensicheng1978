[{"data":1,"prerenderedAt":174},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":70,"blog-post-slug-blog_4af9831b010009g3":87,"surround-blog_4af9831b010009g3":163},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":45,"navLinks":46,"perPage":16,"prevNextIsExcludeDate":66,"site_description":23,"site_name":67,"stem":68,"__hash__":69},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{},[47,52,56,60,64],{"path":48,"title":49,"target":50,"fa_class":51},"\u002F","博客首页","internal","fa-home",{"path":53,"title":54,"target":50,"fa_class":55},"\u002Fabout","关于","fa-user",{"path":57,"title":58,"target":50,"fa_class":59},"\u002Fpost","归档","fa-archive",{"path":61,"title":62,"target":50,"fa_class":63},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":65,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","jvZHccz2rT-wjVS5GCPgWyhl8WnBIvECPkE5KpKFKCU",{"latestBlog":71},[72,75,78,81,84],{"title":73,"slug":74},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":76,"slug":77},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":79,"slug":80},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":82,"slug":83},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":85,"slug":86},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":88,"title":89,"body":90,"categories":152,"description":96,"extension":153,"meta":154,"navigation":156,"path":157,"seo":158,"slug":159,"stem":160,"tags":161,"__hash__":162},"blog\u002Fblog\u002Fblog_4af9831b010009g3.md","死去   活来",{"type":91,"value":92,"toc":148},"minimark",[93,97,100,103,106,109,112,115,118,121,124,127,130,133,136,139,142,145],[94,95,96],"p",{},"回京了几天,休息了几天,荒唐了几天,放纵了几天...",[94,98,99],{},"  雷志明死去",[94,101,102],{},"  我",[94,104,105],{},"  活了过来.",[94,107,108],{},"  刚看完最后一点\"千岁寒\",巧,正是21号,又一个月,快.",[94,110,111],{},"王朔什么人,不知道,没见过.",[94,113,114],{},"  但",[94,116,117],{},"自认见了本性,和你想的一样.",[94,119,120],{},"有情又多情的人,此刻,就是想抄书.",[94,122,123],{},"书中说:有情种下觉悟这棵种子,因为多情才结出果子,无情也就没有种子,不见本性活百岁也不叫生长.",[94,125,126],{},"  忽然觉得很好,安全感充足",[94,128,129],{},"自己认知了自己,武装了自己,安抚了自己,顺畅了自己,有种小通透,还绽出小光芒...",[94,131,132],{},"剩下的就是等待吧,一定会笑着,没什么可以把此种力量摧毁了.",[94,134,135],{},"  佛说:菩提本无树 明镜亦非台 本来无一物 何处惹尘埃   本无佛",[94,137,138],{},"  佛说:一花一世界 一叶一菩提   你便是佛",[94,140,141],{},"  佛说:旗未动 风亦未动 仁者心动 万物唯心而造   我便是佛",[94,143,144],{},"书中说:知识,本地信息汇编;真相,三届关系推演;智慧,史前画卷;慈悲,是物质流露的唯一情感;文明,一片空地,自醉自饮.",[94,146,147],{},"    灵魂,每秒三十万公里;轮回,地球吸引力;涅磐,黑色粒子云,热均衡,孤独的坚持,直至无量无劫无边黑暗中那一声无人听到的自颓.",{"title":149,"searchDepth":150,"depth":150,"links":151},"",2,[],[6],"md",{"date":155},"2007-07-21 01:28",true,"\u002Fblog\u002Fblog_4af9831b010009g3",{"title":89,"description":96},"blog_4af9831b010009g3","blog\u002Fblog_4af9831b010009g3",[],"t00ogt_XZffIx28YBegn6_92U0O7gVyHw45be_OXb10",[164,169],{"title":165,"path":166,"stem":167,"children":-1,"slug":168},"不知所云","\u002Fblog\u002Fblog_4af9831b0100097f","blog\u002Fblog_4af9831b0100097f","blog_4af9831b0100097f",{"title":170,"path":171,"stem":172,"children":-1,"slug":173},"答案","\u002Fblog\u002Fblog_4af9831b010009gx","blog\u002Fblog_4af9831b010009gx","blog_4af9831b010009gx",1794544668040]
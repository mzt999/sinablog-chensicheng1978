[{"data":1,"prerenderedAt":182},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":57,"blog-post-slug-blog_4af9831b0100gpvi":74,"surround-blog_4af9831b0100gpvi":171},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":16,"site_description":54,"stem":55,"__hash__":56},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo","新浪博客内容备份(粉丝自用)","settings","jPD1QWrYwbaIixg6lntppEYe-T3ZGd3EJZxFBkbKY9E",{"latestBlog":58},[59,62,65,68,71],{"title":60,"slug":61},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":63,"slug":64},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":66,"slug":67},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":69,"slug":70},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":72,"slug":73},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":75,"title":76,"body":77,"categories":159,"description":117,"extension":160,"meta":161,"navigation":163,"path":164,"seo":165,"slug":166,"stem":167,"tags":168,"__hash__":170},"blog\u002Fblog\u002Fblog_4af9831b0100gpvi.md","人面桃花《大丫鬟》MV",{"type":78,"value":79,"toc":155},"minimark",[80,87,90,93,98,101,104,107,110,115,118,121,124,129,132,135,138,143,146,149,152],[81,82,83],"p",{},[84,85],"img",{"alt":76,"src":86},"\u002Fpic\u002F4af9831bt7d2e79b5c771.jpg",[81,88,89],{},"其实不喜欢贴图。必须承认。",[81,91,92],{},"因为懒，更觉得图像会局限想象。连最爱的藏区都没贴，改天补上，一并恶补所有的爱图。",[81,94,95],{},[84,96],{"alt":76,"src":97},"\u002Fpic\u002F4af9831bt7d2e79e38a6d.jpg",[81,99,100],{},"我知道现在看有点雷。",[81,102,103],{},"舞台就是如此，加上光影就不觉得做作了。",[81,105,106],{},"所以演员是不容易的。",[81,108,109],{},"明明是假的，不但自己要当真，更要捎带着骗取别人的信任，没有非常结实的念力是不行的。",[81,111,112],{},[84,113],{"alt":76,"src":114},"\u002Fpic\u002F4af9831bt7d2e7a20835a.jpg",[81,116,117],{},"一间布景 一袭梦 一场游戏 一首歌",[81,119,120],{},"又是一次讲述一回经历一种穿越……",[81,122,123],{},"另一个我",[81,125,126],{},[84,127],{"alt":76,"src":128},"\u002Fpic\u002F4af9831bt7d2e7a2fd60a.jpg",[81,130,131],{},"去年今日此门中 人面桃花相映红 人面不知何处去 红桃花依旧笑春风",[81,133,134],{},"很喜欢的几句，会偶尔触景生情脱口而出……",[81,136,137],{},"是的，在万物的轮回里，唯有我们自己是那般的感伤……因为，我们不知去向何处……",[81,139,140],{},[84,141],{"alt":76,"src":142},"\u002Fpic\u002F4af9831bt7d2e7a5d99b5.jpg",[81,144,145],{},"感谢你们的守候。",[81,147,148],{},"我会用不同的自己在不同的时间和空间里和你们相遇。",[81,150,151],{},"故事，",[81,153,154],{},"我们就是……",{"title":156,"searchDepth":157,"depth":157,"links":158},"",2,[],[6,9],"md",{"date":162},"2010-01-15 15:01",true,"\u002Fblog\u002Fblog_4af9831b0100gpvi",{"title":76,"description":117},"blog_4af9831b0100gpvi","blog\u002Fblog_4af9831b0100gpvi",[169],"杂谈","IVKCQ_Kn3xpnx-CZvvFXrji-eNcyZMiMelXVLG_CSnA",[172,177],{"title":173,"path":174,"stem":175,"children":-1,"slug":176},"忍","\u002Fblog\u002Fblog_4af9831b0100gp00","blog\u002Fblog_4af9831b0100gp00","blog_4af9831b0100gp00",{"title":178,"path":179,"stem":180,"children":-1,"slug":181},"李晨这个人","\u002Fblog\u002Fblog_4af9831b0100gvim","blog\u002Fblog_4af9831b0100gvim","blog_4af9831b0100gvim",1794473705135]
[{"data":1,"prerenderedAt":195},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":70,"blog-post-slug-blog_4af9831b0100gpvi":87,"surround-blog_4af9831b0100gpvi":184},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":45,"navLinks":46,"perPage":16,"prevNextIsExcludeDate":66,"site_description":23,"site_name":67,"stem":68,"__hash__":69},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{},[47,52,56,60,64],{"path":48,"title":49,"target":50,"fa_class":51},"\u002F","博客首页","internal","fa-home",{"path":53,"title":54,"target":50,"fa_class":55},"\u002Fabout","关于","fa-user",{"path":57,"title":58,"target":50,"fa_class":59},"\u002Fpost","归档","fa-archive",{"path":61,"title":62,"target":50,"fa_class":63},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":65,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","jvZHccz2rT-wjVS5GCPgWyhl8WnBIvECPkE5KpKFKCU",{"latestBlog":71},[72,75,78,81,84],{"title":73,"slug":74},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":76,"slug":77},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":79,"slug":80},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":82,"slug":83},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":85,"slug":86},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":88,"title":89,"body":90,"categories":172,"description":130,"extension":173,"meta":174,"navigation":176,"path":177,"seo":178,"slug":179,"stem":180,"tags":181,"__hash__":183},"blog\u002Fblog\u002Fblog_4af9831b0100gpvi.md","人面桃花《大丫鬟》MV",{"type":91,"value":92,"toc":168},"minimark",[93,100,103,106,111,114,117,120,123,128,131,134,137,142,145,148,151,156,159,162,165],[94,95,96],"p",{},[97,98],"img",{"alt":89,"src":99},"\u002Fpic\u002F4af9831bt7d2e79b5c771.jpg",[94,101,102],{},"其实不喜欢贴图。必须承认。",[94,104,105],{},"因为懒，更觉得图像会局限想象。连最爱的藏区都没贴，改天补上，一并恶补所有的爱图。",[94,107,108],{},[97,109],{"alt":89,"src":110},"\u002Fpic\u002F4af9831bt7d2e79e38a6d.jpg",[94,112,113],{},"我知道现在看有点雷。",[94,115,116],{},"舞台就是如此，加上光影就不觉得做作了。",[94,118,119],{},"所以演员是不容易的。",[94,121,122],{},"明明是假的，不但自己要当真，更要捎带着骗取别人的信任，没有非常结实的念力是不行的。",[94,124,125],{},[97,126],{"alt":89,"src":127},"\u002Fpic\u002F4af9831bt7d2e7a20835a.jpg",[94,129,130],{},"一间布景 一袭梦 一场游戏 一首歌",[94,132,133],{},"又是一次讲述一回经历一种穿越……",[94,135,136],{},"另一个我",[94,138,139],{},[97,140],{"alt":89,"src":141},"\u002Fpic\u002F4af9831bt7d2e7a2fd60a.jpg",[94,143,144],{},"去年今日此门中 人面桃花相映红 人面不知何处去 红桃花依旧笑春风",[94,146,147],{},"很喜欢的几句，会偶尔触景生情脱口而出……",[94,149,150],{},"是的，在万物的轮回里，唯有我们自己是那般的感伤……因为，我们不知去向何处……",[94,152,153],{},[97,154],{"alt":89,"src":155},"\u002Fpic\u002F4af9831bt7d2e7a5d99b5.jpg",[94,157,158],{},"感谢你们的守候。",[94,160,161],{},"我会用不同的自己在不同的时间和空间里和你们相遇。",[94,163,164],{},"故事，",[94,166,167],{},"我们就是……",{"title":169,"searchDepth":170,"depth":170,"links":171},"",2,[],[6,9],"md",{"date":175},"2010-01-15 15:01",true,"\u002Fblog\u002Fblog_4af9831b0100gpvi",{"title":89,"description":130},"blog_4af9831b0100gpvi","blog\u002Fblog_4af9831b0100gpvi",[182],"杂谈","IVKCQ_Kn3xpnx-CZvvFXrji-eNcyZMiMelXVLG_CSnA",[185,190],{"title":186,"path":187,"stem":188,"children":-1,"slug":189},"忍","\u002Fblog\u002Fblog_4af9831b0100gp00","blog\u002Fblog_4af9831b0100gp00","blog_4af9831b0100gp00",{"title":191,"path":192,"stem":193,"children":-1,"slug":194},"李晨这个人","\u002Fblog\u002Fblog_4af9831b0100gvim","blog\u002Fblog_4af9831b0100gvim","blog_4af9831b0100gvim",1794546769512]
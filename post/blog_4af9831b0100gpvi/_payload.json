[{"data":1,"prerenderedAt":183},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":58,"blog-post-slug-blog_4af9831b0100gpvi":75,"surround-blog_4af9831b0100gpvi":172},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":54,"site_description":55,"stem":56,"__hash__":57},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo",20,"新浪博客内容备份","settings","hh8X7X6SFDoeJrxIJ4yisZXSc3HwHM1zk206jiQX2XU",{"latestBlog":59},[60,63,66,69,72],{"title":61,"slug":62},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":64,"slug":65},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":67,"slug":68},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":70,"slug":71},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":73,"slug":74},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":76,"title":77,"body":78,"categories":160,"description":118,"extension":161,"meta":162,"navigation":164,"path":165,"seo":166,"slug":167,"stem":168,"tags":169,"__hash__":171},"blog\u002Fblog\u002Fblog_4af9831b0100gpvi.md","人面桃花《大丫鬟》MV",{"type":79,"value":80,"toc":156},"minimark",[81,88,91,94,99,102,105,108,111,116,119,122,125,130,133,136,139,144,147,150,153],[82,83,84],"p",{},[85,86],"img",{"alt":77,"src":87},"\u002Fpic\u002F4af9831bt7d2e79b5c771.jpg",[82,89,90],{},"其实不喜欢贴图。必须承认。",[82,92,93],{},"因为懒，更觉得图像会局限想象。连最爱的藏区都没贴，改天补上，一并恶补所有的爱图。",[82,95,96],{},[85,97],{"alt":77,"src":98},"\u002Fpic\u002F4af9831bt7d2e79e38a6d.jpg",[82,100,101],{},"我知道现在看有点雷。",[82,103,104],{},"舞台就是如此，加上光影就不觉得做作了。",[82,106,107],{},"所以演员是不容易的。",[82,109,110],{},"明明是假的，不但自己要当真，更要捎带着骗取别人的信任，没有非常结实的念力是不行的。",[82,112,113],{},[85,114],{"alt":77,"src":115},"\u002Fpic\u002F4af9831bt7d2e7a20835a.jpg",[82,117,118],{},"一间布景 一袭梦 一场游戏 一首歌",[82,120,121],{},"又是一次讲述一回经历一种穿越……",[82,123,124],{},"另一个我",[82,126,127],{},[85,128],{"alt":77,"src":129},"\u002Fpic\u002F4af9831bt7d2e7a2fd60a.jpg",[82,131,132],{},"去年今日此门中 人面桃花相映红 人面不知何处去 红桃花依旧笑春风",[82,134,135],{},"很喜欢的几句，会偶尔触景生情脱口而出……",[82,137,138],{},"是的，在万物的轮回里，唯有我们自己是那般的感伤……因为，我们不知去向何处……",[82,140,141],{},[85,142],{"alt":77,"src":143},"\u002Fpic\u002F4af9831bt7d2e7a5d99b5.jpg",[82,145,146],{},"感谢你们的守候。",[82,148,149],{},"我会用不同的自己在不同的时间和空间里和你们相遇。",[82,151,152],{},"故事，",[82,154,155],{},"我们就是……",{"title":157,"searchDepth":158,"depth":158,"links":159},"",2,[],[6,9],"md",{"date":163},"2010-01-15 15:01",true,"\u002Fblog\u002Fblog_4af9831b0100gpvi",{"title":77,"description":118},"blog_4af9831b0100gpvi","blog\u002Fblog_4af9831b0100gpvi",[170],"杂谈","IVKCQ_Kn3xpnx-CZvvFXrji-eNcyZMiMelXVLG_CSnA",[173,178],{"title":174,"path":175,"stem":176,"children":-1,"slug":177},"忍","\u002Fblog\u002Fblog_4af9831b0100gp00","blog\u002Fblog_4af9831b0100gp00","blog_4af9831b0100gp00",{"title":179,"path":180,"stem":181,"children":-1,"slug":182},"李晨这个人","\u002Fblog\u002Fblog_4af9831b0100gvim","blog\u002Fblog_4af9831b0100gvim","blog_4af9831b0100gvim",1794412500464]
[{"data":1,"prerenderedAt":135},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b0100gpvi":31,"surround-blog_4af9831b0100gpvi":124},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",152,{"name":9,"len":10},"有图",34,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":112,"description":33,"extension":113,"meta":114,"navigation":116,"path":117,"seo":118,"slug":119,"stem":120,"tags":121,"__hash__":123},"blog\u002Fblog\u002Fblog_4af9831b0100gpvi.md","人面桃花《大丫鬟》MV",{"type":35,"value":36,"toc":108},"minimark",[37,44,47,50,55,58,61,64,67,73,76,79,85,88,91,96,99,102,105],[38,39,40],"p",{},[41,42],"img",{"alt":33,"src":43},"\u002Fpic\u002F4af9831bt7d2e79b5c771.jpg",[38,45,46],{},"其实不喜欢贴图。必须承认。",[38,48,49],{},"因为懒，更觉得图像会局限想象。连最爱的藏区都没贴，改天补上，一并恶补所有的爱图。",[38,51,52],{},[41,53],{"alt":33,"src":54},"\u002Fpic\u002F4af9831bt7d2e79e38a6d.jpg",[38,56,57],{},"我知道现在看有点雷。",[38,59,60],{},"舞台就是如此，加上光影就不觉得做作了。",[38,62,63],{},"所以演员是不容易的。",[38,65,66],{},"明明是假的，不但自己要当真，更要捎带着骗取别人的信任，没有非常结实的念力是不行的。",[38,68,69,72],{},[41,70],{"alt":33,"src":71},"\u002Fpic\u002F4af9831bt7d2e7a20835a.jpg"," 一间布景 一袭梦 一场游戏 一首歌",[38,74,75],{},"又是一次讲述一回经历一种穿越……",[38,77,78],{},"另一个我",[38,80,81,84],{},[41,82],{"alt":33,"src":83},"\u002Fpic\u002F4af9831bt7d2e7a2fd60a.jpg"," 去年今日此门中 人面桃花相映红 人面不知何处去 红桃花依旧笑春风",[38,86,87],{},"很喜欢的几句，会偶尔触景生情脱口而出……",[38,89,90],{},"是的，在万物的轮回里，唯有我们自己是那般的感伤……因为，我们不知去向何处……",[38,92,93],{},[41,94],{"alt":33,"src":95},"\u002Fpic\u002F4af9831bt7d2e7a5d99b5.jpg",[38,97,98],{},"感谢你们的守候。",[38,100,101],{},"我会用不同的自己在不同的时间和空间里和你们相遇。",[38,103,104],{},"故事，",[38,106,107],{},"我们就是……",{"title":109,"searchDepth":110,"depth":110,"links":111},"",2,[],[6,9],"md",{"date":115},"2010-01-15 15:01",true,"\u002Fblog\u002Fblog_4af9831b0100gpvi",{"title":33,"description":33},"blog_4af9831b0100gpvi","blog\u002Fblog_4af9831b0100gpvi",[122],"杂谈","bC3ajJO0YSJUyotwFLJNMIkrQoKFj5i2WZRarusvBLQ",[125,130],{"title":126,"path":127,"stem":128,"children":-1,"slug":129},"忍","\u002Fblog\u002Fblog_4af9831b0100gp00","blog\u002Fblog_4af9831b0100gp00","blog_4af9831b0100gp00",{"title":131,"path":132,"stem":133,"children":-1,"slug":134},"李晨这个人","\u002Fblog\u002Fblog_4af9831b0100gvim","blog\u002Fblog_4af9831b0100gvim","blog_4af9831b0100gvim",1793940843937]
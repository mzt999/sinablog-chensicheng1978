[{"data":1,"prerenderedAt":142},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":17,"blog-post-slug-blog_4af9831b0100gpvi":34,"surround-blog_4af9831b0100gpvi":131},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"latestBlog":18},[19,22,25,28,31],{"title":20,"slug":21},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":23,"slug":24},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":26,"slug":27},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":29,"slug":30},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":32,"slug":33},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":35,"title":36,"body":37,"categories":119,"description":77,"extension":120,"meta":121,"navigation":123,"path":124,"seo":125,"slug":126,"stem":127,"tags":128,"__hash__":130},"blog\u002Fblog\u002Fblog_4af9831b0100gpvi.md","人面桃花《大丫鬟》MV",{"type":38,"value":39,"toc":115},"minimark",[40,47,50,53,58,61,64,67,70,75,78,81,84,89,92,95,98,103,106,109,112],[41,42,43],"p",{},[44,45],"img",{"alt":36,"src":46},"\u002Fpic\u002F4af9831bt7d2e79b5c771.jpg",[41,48,49],{},"其实不喜欢贴图。必须承认。",[41,51,52],{},"因为懒，更觉得图像会局限想象。连最爱的藏区都没贴，改天补上，一并恶补所有的爱图。",[41,54,55],{},[44,56],{"alt":36,"src":57},"\u002Fpic\u002F4af9831bt7d2e79e38a6d.jpg",[41,59,60],{},"我知道现在看有点雷。",[41,62,63],{},"舞台就是如此，加上光影就不觉得做作了。",[41,65,66],{},"所以演员是不容易的。",[41,68,69],{},"明明是假的，不但自己要当真，更要捎带着骗取别人的信任，没有非常结实的念力是不行的。",[41,71,72],{},[44,73],{"alt":36,"src":74},"\u002Fpic\u002F4af9831bt7d2e7a20835a.jpg",[41,76,77],{},"一间布景 一袭梦 一场游戏 一首歌",[41,79,80],{},"又是一次讲述一回经历一种穿越……",[41,82,83],{},"另一个我",[41,85,86],{},[44,87],{"alt":36,"src":88},"\u002Fpic\u002F4af9831bt7d2e7a2fd60a.jpg",[41,90,91],{},"去年今日此门中 人面桃花相映红 人面不知何处去 红桃花依旧笑春风",[41,93,94],{},"很喜欢的几句，会偶尔触景生情脱口而出……",[41,96,97],{},"是的，在万物的轮回里，唯有我们自己是那般的感伤……因为，我们不知去向何处……",[41,99,100],{},[44,101],{"alt":36,"src":102},"\u002Fpic\u002F4af9831bt7d2e7a5d99b5.jpg",[41,104,105],{},"感谢你们的守候。",[41,107,108],{},"我会用不同的自己在不同的时间和空间里和你们相遇。",[41,110,111],{},"故事，",[41,113,114],{},"我们就是……",{"title":116,"searchDepth":117,"depth":117,"links":118},"",2,[],[6,9],"md",{"date":122},"2010-01-15 15:01",true,"\u002Fblog\u002Fblog_4af9831b0100gpvi",{"title":36,"description":77},"blog_4af9831b0100gpvi","blog\u002Fblog_4af9831b0100gpvi",[129],"杂谈","IVKCQ_Kn3xpnx-CZvvFXrji-eNcyZMiMelXVLG_CSnA",[132,137],{"title":133,"path":134,"stem":135,"children":-1,"slug":136},"忍","\u002Fblog\u002Fblog_4af9831b0100gp00","blog\u002Fblog_4af9831b0100gp00","blog_4af9831b0100gp00",{"title":138,"path":139,"stem":140,"children":-1,"slug":141},"李晨这个人","\u002Fblog\u002Fblog_4af9831b0100gvim","blog\u002Fblog_4af9831b0100gvim","blog_4af9831b0100gvim",1794143531661]
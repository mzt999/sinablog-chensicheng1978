},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":88,"slug":89},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":91,"slug":92},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":94,"title":95,"body":96,"categories":178,"description":136,"extension":179,"meta":180,"navigation":182,"path":183,"seo":184,"slug":185,"stem":186,"tags":187,"__hash__":189},"blog\u002Fblog\u002Fblog_4af9831b0100gpvi.md","人面桃花《大丫鬟》MV",{"type":97,"value":98,"toc":174},"minimark",[99,106,109,112,117,120,123,126,129,134,137,140,143,148,151,154,157,162,165,168,171],[100,101,102],"p",{},[103,104],"img",{"alt":95,"src":105},"\u002Fpic\u002F4af9831bt7d2e79b5c771.jpg",[100,107,108],{},"其实不喜欢贴图。必须承认。",[100,110,111],{},"因为懒，更觉得图像会局限想象。连最爱的藏区都没贴，改天补上，一并恶补所有的爱图。",[100,113,114],{},[103,115],{"alt":95,"src":116},"\u002Fpic\u002F4af9831bt7d2e79e38a6d.jpg",[100,118,119],{},"我知道现在看有点雷。",[100,121,122],{},"舞台就是如此，加上光影就不觉得做作了。",[100,124,125],{},"所以演员是不容易的。",[100,127,128],{},"明明是假的，不但自己要当真，更要捎带着骗取别人的信任，没有非常结实的念力是不行的。",[100,130,131],{},[103,132],{"alt":95,"src":133},"\u002Fpic\u002F4af9831bt7d2e7a20835a.jpg",[100,135,136],{},"一间布景 一袭梦 一场游戏 一首歌",[100,138,139],{},"又是一次讲述一回经历一种穿越……",[100,141,142],{},"另一个我",[100,144,145],{},[103,146],{"alt":95,"src":147},"\u002Fpic\u002F4af9831bt7d2e7a2fd60a.jpg",[100,149,150],{},"去年今日此门中 人面桃花相映红 人面不知何处去 红桃花依旧笑春风",[100,152,153],{},"很喜欢的几句，会偶尔触景生情脱口而出……",[100,155,156],{},"是的，在万物的轮回里，唯有我们自己是那般的感伤……因为，我们不知去向何处……",[100,158,159],{},[103,160],{"alt":95,"src":161},"\u002Fpic\u002F4af9831bt7d2e7a5d99b5.jpg",[100,163,164],{},"感谢你们的守候。",[100,166,167],{},"我会用不同的自己在不同的时间和空间里和你们相遇。",[100,169,170],{},"故事，",[100,172,173],{},"我们就是……",{"title":175,"searchDepth":176,"depth":176,"links":177},"",2,[],[6,9],"md",{"date":181},"2010-01-15 15:01",true,"\u002Fblog\u002Fblog_4af9831b0100gpvi",{"title":95,"description":136},"blog_4af9831b0100gpvi","blog\u002Fblog_4af9831b0100gpvi",[188],"杂谈","IVKCQ_Kn3xpnx-CZvvFXrji-eNcyZMiMelXVLG_CSnA",[191,196],{"title":192,"path":193,"stem":194,"children":-1,"slug":195},"忍","\u002Fblog\u002Fblog_4af9831b0100gp00","blog\u002Fblog_4af9831b0100gp00","blog_4af9831b0100gp00",{"title":197,"path":198,"stem":199,"children":-1,"slug":200},"李晨这个人","\u002Fblog\u002Fblog_4af9831b0100gvim","blog\u002Fblog_4af9831b0100gvim","blog_4af9831b0100gvim",1795162025687]
":89,"body":90,"categories":170,"description":171,"extension":172,"meta":173,"navigation":175,"path":176,"seo":177,"slug":178,"stem":179,"tags":180,"__hash__":185},"blog\u002Fblog\u002Fblog_4af9831b0100cva5.md","梦",{"type":91,"value":92,"toc":166},"minimark",[93,97,100,103,106,109,112,115,118,121,124,127,130,133,136,139,142,145,148,151,154,157,160,163],[94,95,96],"p",{},"2009 4 24",[94,98,99],{},"浙江 横店",[94,101,102],{},"雨",[94,104,105],{},"一早画好了妆 因为 雨 等待",[94,107,108],{},"从昨晚开始就收到祝贺的信息",[94,110,111],{},"春风沉醉的晚上",[94,113,114],{},"去年此时的 南京 梦想开始",[94,116,117],{},"今年5月的嘎纳",[94,119,120],{},"梦想绽放",[94,122,123],{},"最初的选择 遭到很多朋友的质疑",[94,125,126],{},"因为那不是一条捷径",[94,128,129],{},"在他们看来 把握 比什么都重要",[94,131,132],{},"可对于我",[94,134,135],{},"一切新的尝试于未知却是人生路上最大的吸引",[94,137,138],{},"因为总认为 白驹过隙后 只有回忆 只剩回忆",[94,140,141],{},"又一个梦开始",[94,143,144],{},"它为我打开另一扇窗",[94,146,147],{},"我会更加端视自己",[94,149,150],{},"能走到何处 不得而知",[94,152,153],{},"但我明白",[94,155,156],{},"生命不息 行走不止",[94,158,159],{},"没有什么",[94,161,162],{},"能阻挡我追逐梦想的",[94,164,165],{},"脚步",{"title":167,"searchDepth":168,"depth":168,"links":169},"",2,[],[6],"今年5月的嘎纳 梦想绽放","md",{"date":174},"2009-04-24 09:50",true,"\u002Fblog\u002Fblog_4af9831b0100cva5",{"title":89,"description":171},"blog_4af9831b0100cva5","blog\u002Fblog_4af9831b0100cva5",[181,111,182,183,184],"62届嘎纳电影节","娄烨","陈思成","金棕榈","mLtvBC2ZvXWGArUe656m8WLoNch48IwrTX4EPH5AATI",[187,192],{"title":188,"path":189,"stem":190,"children":-1,"slug":191},"一剪梅","\u002Fblog\u002Fblog_4af9831b0100coqo","blog\u002Fblog_4af9831b0100coqo","blog_4af9831b0100coqo",{"title":193,"path":194,"stem":195,"children":-1,"slug":196},"我爱你   中国","\u002Fblog\u002Fblog_4af9831b0100d2st","blog\u002Fblog_4af9831b0100d2st","blog_4af9831b0100d2st",1794544667578]
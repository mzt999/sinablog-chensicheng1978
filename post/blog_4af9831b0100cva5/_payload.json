,133,136,139,142,145,148,151],[82,83,84],"p",{},"2009 4 24",[82,86,87],{},"浙江 横店",[82,89,90],{},"雨",[82,92,93],{},"一早画好了妆 因为 雨 等待",[82,95,96],{},"从昨晚开始就收到祝贺的信息",[82,98,99],{},"春风沉醉的晚上",[82,101,102],{},"去年此时的 南京 梦想开始",[82,104,105],{},"今年5月的嘎纳",[82,107,108],{},"梦想绽放",[82,110,111],{},"最初的选择 遭到很多朋友的质疑",[82,113,114],{},"因为那不是一条捷径",[82,116,117],{},"在他们看来 把握 比什么都重要",[82,119,120],{},"可对于我",[82,122,123],{},"一切新的尝试于未知却是人生路上最大的吸引",[82,125,126],{},"因为总认为 白驹过隙后 只有回忆 只剩回忆",[82,128,129],{},"又一个梦开始",[82,131,132],{},"它为我打开另一扇窗",[82,134,135],{},"我会更加端视自己",[82,137,138],{},"能走到何处 不得而知",[82,140,141],{},"但我明白",[82,143,144],{},"生命不息 行走不止",[82,146,147],{},"没有什么",[82,149,150],{},"能阻挡我追逐梦想的",[82,152,153],{},"脚步",{"title":155,"searchDepth":156,"depth":156,"links":157},"",2,[],[6],"今年5月的嘎纳 梦想绽放","md",{"date":162},"2009-04-24 09:50",true,"\u002Fblog\u002Fblog_4af9831b0100cva5",{"title":77,"description":159},"blog_4af9831b0100cva5","blog\u002Fblog_4af9831b0100cva5",[169,99,170,171,172],"62届嘎纳电影节","娄烨","陈思成","金棕榈","mLtvBC2ZvXWGArUe656m8WLoNch48IwrTX4EPH5AATI",[175,180],{"title":176,"path":177,"stem":178,"children":-1,"slug":179},"一剪梅","\u002Fblog\u002Fblog_4af9831b0100coqo","blog\u002Fblog_4af9831b0100coqo","blog_4af9831b0100coqo",{"title":181,"path":182,"stem":183,"children":-1,"slug":184},"我爱你   中国","\u002Fblog\u002Fblog_4af9831b0100d2st","blog\u002Fblog_4af9831b0100d2st","blog_4af9831b0100d2st",1794412500560]
29,132,135,138,141,144,147,150],[81,82,83],"p",{},"2009 4 24",[81,85,86],{},"浙江 横店",[81,88,89],{},"雨",[81,91,92],{},"一早画好了妆 因为 雨 等待",[81,94,95],{},"从昨晚开始就收到祝贺的信息",[81,97,98],{},"春风沉醉的晚上",[81,100,101],{},"去年此时的 南京 梦想开始",[81,103,104],{},"今年5月的嘎纳",[81,106,107],{},"梦想绽放",[81,109,110],{},"最初的选择 遭到很多朋友的质疑",[81,112,113],{},"因为那不是一条捷径",[81,115,116],{},"在他们看来 把握 比什么都重要",[81,118,119],{},"可对于我",[81,121,122],{},"一切新的尝试于未知却是人生路上最大的吸引",[81,124,125],{},"因为总认为 白驹过隙后 只有回忆 只剩回忆",[81,127,128],{},"又一个梦开始",[81,130,131],{},"它为我打开另一扇窗",[81,133,134],{},"我会更加端视自己",[81,136,137],{},"能走到何处 不得而知",[81,139,140],{},"但我明白",[81,142,143],{},"生命不息 行走不止",[81,145,146],{},"没有什么",[81,148,149],{},"能阻挡我追逐梦想的",[81,151,152],{},"脚步",{"title":154,"searchDepth":155,"depth":155,"links":156},"",2,[],[6],"今年5月的嘎纳 梦想绽放","md",{"date":161},"2009-04-24 09:50",true,"\u002Fblog\u002Fblog_4af9831b0100cva5",{"title":76,"description":158},"blog_4af9831b0100cva5","blog\u002Fblog_4af9831b0100cva5",[168,98,169,170,171],"62届嘎纳电影节","娄烨","陈思成","金棕榈","mLtvBC2ZvXWGArUe656m8WLoNch48IwrTX4EPH5AATI",[174,179],{"title":175,"path":176,"stem":177,"children":-1,"slug":178},"一剪梅","\u002Fblog\u002Fblog_4af9831b0100coqo","blog\u002Fblog_4af9831b0100coqo","blog_4af9831b0100coqo",{"title":180,"path":181,"stem":182,"children":-1,"slug":183},"我爱你   中国","\u002Fblog\u002Fblog_4af9831b0100d2st","blog\u002Fblog_4af9831b0100d2st","blog_4af9831b0100d2st",1794473705224]
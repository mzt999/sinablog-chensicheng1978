},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":88,"slug":89},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":91,"slug":92},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":94,"title":95,"body":96,"categories":176,"description":177,"extension":178,"meta":179,"navigation":181,"path":182,"seo":183,"slug":184,"stem":185,"tags":186,"__hash__":191},"blog\u002Fblog\u002Fblog_4af9831b0100cva5.md","梦",{"type":97,"value":98,"toc":172},"minimark",[99,103,106,109,112,115,118,121,124,127,130,133,136,139,142,145,148,151,154,157,160,163,166,169],[100,101,102],"p",{},"2009 4 24",[100,104,105],{},"浙江 横店",[100,107,108],{},"雨",[100,110,111],{},"一早画好了妆 因为 雨 等待",[100,113,114],{},"从昨晚开始就收到祝贺的信息",[100,116,117],{},"春风沉醉的晚上",[100,119,120],{},"去年此时的 南京 梦想开始",[100,122,123],{},"今年5月的嘎纳",[100,125,126],{},"梦想绽放",[100,128,129],{},"最初的选择 遭到很多朋友的质疑",[100,131,132],{},"因为那不是一条捷径",[100,134,135],{},"在他们看来 把握 比什么都重要",[100,137,138],{},"可对于我",[100,140,141],{},"一切新的尝试于未知却是人生路上最大的吸引",[100,143,144],{},"因为总认为 白驹过隙后 只有回忆 只剩回忆",[100,146,147],{},"又一个梦开始",[100,149,150],{},"它为我打开另一扇窗",[100,152,153],{},"我会更加端视自己",[100,155,156],{},"能走到何处 不得而知",[100,158,159],{},"但我明白",[100,161,162],{},"生命不息 行走不止",[100,164,165],{},"没有什么",[100,167,168],{},"能阻挡我追逐梦想的",[100,170,171],{},"脚步",{"title":173,"searchDepth":174,"depth":174,"links":175},"",2,[],[6],"今年5月的嘎纳 梦想绽放","md",{"date":180},"2009-04-24 09:50",true,"\u002Fblog\u002Fblog_4af9831b0100cva5",{"title":95,"description":177},"blog_4af9831b0100cva5","blog\u002Fblog_4af9831b0100cva5",[187,117,188,189,190],"62届嘎纳电影节","娄烨","陈思成","金棕榈","mLtvBC2ZvXWGArUe656m8WLoNch48IwrTX4EPH5AATI",[193,198],{"title":194,"path":195,"stem":196,"children":-1,"slug":197},"一剪梅","\u002Fblog\u002Fblog_4af9831b0100coqo","blog\u002Fblog_4af9831b0100coqo","blog_4af9831b0100coqo",{"title":199,"path":200,"stem":201,"children":-1,"slug":202},"我爱你   中国","\u002Fblog\u002Fblog_4af9831b0100d2st","blog\u002Fblog_4af9831b0100d2st","blog_4af9831b0100d2st",1795162025754]
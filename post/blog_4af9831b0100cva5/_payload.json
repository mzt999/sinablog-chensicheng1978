“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":88,"slug":89},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":91,"title":92,"body":93,"categories":173,"description":174,"extension":175,"meta":176,"navigation":178,"path":179,"seo":180,"slug":181,"stem":182,"tags":183,"__hash__":188},"blog\u002Fblog\u002Fblog_4af9831b0100cva5.md","梦",{"type":94,"value":95,"toc":169},"minimark",[96,100,103,106,109,112,115,118,121,124,127,130,133,136,139,142,145,148,151,154,157,160,163,166],[97,98,99],"p",{},"2009 4 24",[97,101,102],{},"浙江 横店",[97,104,105],{},"雨",[97,107,108],{},"一早画好了妆 因为 雨 等待",[97,110,111],{},"从昨晚开始就收到祝贺的信息",[97,113,114],{},"春风沉醉的晚上",[97,116,117],{},"去年此时的 南京 梦想开始",[97,119,120],{},"今年5月的嘎纳",[97,122,123],{},"梦想绽放",[97,125,126],{},"最初的选择 遭到很多朋友的质疑",[97,128,129],{},"因为那不是一条捷径",[97,131,132],{},"在他们看来 把握 比什么都重要",[97,134,135],{},"可对于我",[97,137,138],{},"一切新的尝试于未知却是人生路上最大的吸引",[97,140,141],{},"因为总认为 白驹过隙后 只有回忆 只剩回忆",[97,143,144],{},"又一个梦开始",[97,146,147],{},"它为我打开另一扇窗",[97,149,150],{},"我会更加端视自己",[97,152,153],{},"能走到何处 不得而知",[97,155,156],{},"但我明白",[97,158,159],{},"生命不息 行走不止",[97,161,162],{},"没有什么",[97,164,165],{},"能阻挡我追逐梦想的",[97,167,168],{},"脚步",{"title":170,"searchDepth":171,"depth":171,"links":172},"",2,[],[6],"今年5月的嘎纳 梦想绽放","md",{"date":177},"2009-04-24 09:50",true,"\u002Fblog\u002Fblog_4af9831b0100cva5",{"title":92,"description":174},"blog_4af9831b0100cva5","blog\u002Fblog_4af9831b0100cva5",[184,114,185,186,187],"62届嘎纳电影节","娄烨","陈思成","金棕榈","mLtvBC2ZvXWGArUe656m8WLoNch48IwrTX4EPH5AATI",[190,195],{"title":191,"path":192,"stem":193,"children":-1,"slug":194},"一剪梅","\u002Fblog\u002Fblog_4af9831b0100coqo","blog\u002Fblog_4af9831b0100coqo","blog_4af9831b0100coqo",{"title":196,"path":197,"stem":198,"children":-1,"slug":199},"我爱你   中国","\u002Fblog\u002Fblog_4af9831b0100d2st","blog\u002Fblog_4af9831b0100d2st","blog_4af9831b0100d2st",1794760531955]
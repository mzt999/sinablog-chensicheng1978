[{"data":1,"prerenderedAt":160},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":57,"blog-post-slug-blog_4af9831b0100ffuh":74,"surround-blog_4af9831b0100ffuh":149},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":16,"site_description":54,"stem":55,"__hash__":56},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo","新浪博客内容备份(粉丝自用)","settings","jPD1QWrYwbaIixg6lntppEYe-T3ZGd3EJZxFBkbKY9E",{"latestBlog":58},[59,62,65,68,71],{"title":60,"slug":61},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":63,"slug":64},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":66,"slug":67},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":69,"slug":70},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":72,"slug":73},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":75,"title":76,"body":77,"categories":136,"description":137,"extension":138,"meta":139,"navigation":141,"path":142,"seo":143,"slug":144,"stem":145,"tags":146,"__hash__":148},"blog\u002Fblog\u002Fblog_4af9831b0100ffuh.md","无题1",{"type":78,"value":79,"toc":132},"minimark",[80,84,87,90,93,96,99,102,105,108,111,114,117,120,123,126,129],[81,82,83],"p",{},"久没来了，把原因都推给时间，显然是托辞。",[81,85,86],{},"心情使然吧……没那么多牢骚了，或是牢骚更精深了。",[81,88,89],{},"今天拍了“大”戏结局的一场戏，我很喜欢。",[81,91,92],{},"“此情只待成追忆，但觉当时已惘然……”",[81,94,95],{},"命运总是如此，在你不相信的时候，它才不期而至……",[81,97,98],{},"现在发现，“唏嘘”这个词怕是对爱情，对人生，对所有过往最好的一个诠释。",[81,100,101],{},"世事万物，生不带来死不带去，所谓悲喜，浮光掠影……",[81,103,104],{},"对这戏的感觉是爱恨交织，如此“纯爱”倒是头次。",[81,106,107],{},"“萧清羽”又成了一个我自愧不如终生只能望其项背的人物……",[81,109,110],{},"或者那种为爱舍生忘死的感觉也曾有过？但何年何月不见的呢？回首来时路，没有答案……",[81,112,113],{},"如果真用古人对爱情的解释“情不知所起，一往情深，生者可以死，死可以生。生而不可与死，死而不可复生者，皆非情之至也！”那此刻，我们的身边又会有几个“爱情”呢？",[81,115,116],{},"这戏和桃花有缘。前几天，在“桃花庵”外想起唐伯虎的“桃花诗”，便即兴也随了一首只头尾的七言。",[81,118,119],{},"“桃花仙子桃花脸，桃花脸上桃花眼，桃花眼生桃花意，意到浓时万花浅。",[81,121,122],{},"莫言我心徒高远，他日许把乾坤转，待到寒风冷露时，笑傲独撑桃花伞。”",[81,124,125],{},"唐寅的心怀本是我一直神往的，但现在，我嗅到了他的痛苦。",[81,127,128],{},"看来，真正的笑傲江湖，不是在眼花耳热后义气素霓生之时，就只能在洗尽铅华冷眼了然浮生若梦以后了……",[81,130,131],{},"悲凉，有点点悲凉……",{"title":133,"searchDepth":134,"depth":134,"links":135},"",2,[],[6],"今天拍了《大丫鬟》结局的一场戏，我很喜欢。","md",{"date":140},"2009-10-10 21:56",true,"\u002Fblog\u002Fblog_4af9831b0100ffuh",{"title":76,"description":137},"blog_4af9831b0100ffuh","blog\u002Fblog_4af9831b0100ffuh",[147],"杂谈","6IYbBuaLHqTOtLDojDn6dJY9FApcRRVm6F0eWnXwkZ4",[150,155],{"title":151,"path":152,"stem":153,"children":-1,"slug":154},"疯魔","\u002Fblog\u002Fblog_4af9831b0100dur9","blog\u002Fblog_4af9831b0100dur9","blog_4af9831b0100dur9",{"title":156,"path":157,"stem":158,"children":-1,"slug":159},"尘缘","\u002Fblog\u002Fblog_4af9831b0100fyqi","blog\u002Fblog_4af9831b0100fyqi","blog_4af9831b0100fyqi",1794473705155]
[{"data":1,"prerenderedAt":179},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":76,"blog-post-slug-blog_4af9831b0100ffuh":93,"surround-blog_4af9831b0100ffuh":168},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":38,"meta":50,"navLinks":51,"perPage":16,"prevNextIsExcludeDate":71,"site_description":72,"site_name":73,"stem":74,"__hash__":75},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,26,32],{"text":23},"粉丝自制非官方站点｜素材版权归原权利人所有",{"text":25},"仅兴趣交流、无商业用途｜如有侵权请联系删除",{"text":27,"link":28},"查看",{"href":29,"text":30,"fa_class":31},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":33,"link":34},"如有任何疑问，欢迎",{"href":35,"text":36,"fa_class":37},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[39,42,45,47],{"href":40,"text":41},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":43,"text":44},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":46},"新浪微博备份(2009-2026)",{"href":48,"text":49},"https:\u002F\u002Fmzt999.github.io\u002Fportfolio-chensicheng1978","幕后作品集展示(2012-2026)",{},[52,57,61,65,69],{"path":53,"title":54,"target":55,"fa_class":56},"\u002F","博客首页","internal","fa-home",{"path":58,"title":59,"target":55,"fa_class":60},"\u002Fabout","关于","fa-user",{"path":62,"title":63,"target":55,"fa_class":64},"\u002Fpost","归档","fa-archive",{"path":66,"title":67,"target":55,"fa_class":68},"\u002Fgallery","相册","fa-image",{"path":29,"title":30,"target":70,"fa_class":31},"otherSite",false,"新浪博客内容备份(粉丝自用)","陈思诚的博客","settings","5S7xKt0XLHpkjipbomx4I7pUu50Y7wqtD418LquZj5Q",{"latestBlog":77},[78,81,84,87,90],{"title":79,"slug":80},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":82,"slug":83},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":85,"slug":86},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":88,"slug":89},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":91,"slug":92},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":94,"title":95,"body":96,"categories":155,"description":156,"extension":157,"meta":158,"navigation":160,"path":161,"seo":162,"slug":163,"stem":164,"tags":165,"__hash__":167},"blog\u002Fblog\u002Fblog_4af9831b0100ffuh.md","无题1",{"type":97,"value":98,"toc":151},"minimark",[99,103,106,109,112,115,118,121,124,127,130,133,136,139,142,145,148],[100,101,102],"p",{},"久没来了，把原因都推给时间，显然是托辞。",[100,104,105],{},"心情使然吧……没那么多牢骚了，或是牢骚更精深了。",[100,107,108],{},"今天拍了“大”戏结局的一场戏，我很喜欢。",[100,110,111],{},"“此情只待成追忆，但觉当时已惘然……”",[100,113,114],{},"命运总是如此，在你不相信的时候，它才不期而至……",[100,116,117],{},"现在发现，“唏嘘”这个词怕是对爱情，对人生，对所有过往最好的一个诠释。",[100,119,120],{},"世事万物，生不带来死不带去，所谓悲喜，浮光掠影……",[100,122,123],{},"对这戏的感觉是爱恨交织，如此“纯爱”倒是头次。",[100,125,126],{},"“萧清羽”又成了一个我自愧不如终生只能望其项背的人物……",[100,128,129],{},"或者那种为爱舍生忘死的感觉也曾有过？但何年何月不见的呢？回首来时路，没有答案……",[100,131,132],{},"如果真用古人对爱情的解释“情不知所起，一往情深，生者可以死，死可以生。生而不可与死，死而不可复生者，皆非情之至也！”那此刻，我们的身边又会有几个“爱情”呢？",[100,134,135],{},"这戏和桃花有缘。前几天，在“桃花庵”外想起唐伯虎的“桃花诗”，便即兴也随了一首只头尾的七言。",[100,137,138],{},"“桃花仙子桃花脸，桃花脸上桃花眼，桃花眼生桃花意，意到浓时万花浅。",[100,140,141],{},"莫言我心徒高远，他日许把乾坤转，待到寒风冷露时，笑傲独撑桃花伞。”",[100,143,144],{},"唐寅的心怀本是我一直神往的，但现在，我嗅到了他的痛苦。",[100,146,147],{},"看来，真正的笑傲江湖，不是在眼花耳热后义气素霓生之时，就只能在洗尽铅华冷眼了然浮生若梦以后了……",[100,149,150],{},"悲凉，有点点悲凉……",{"title":152,"searchDepth":153,"depth":153,"links":154},"",2,[],[6],"今天拍了《大丫鬟》结局的一场戏，我很喜欢。","md",{"date":159},"2009-10-10 21:56",true,"\u002Fblog\u002Fblog_4af9831b0100ffuh",{"title":95,"description":156},"blog_4af9831b0100ffuh","blog\u002Fblog_4af9831b0100ffuh",[166],"杂谈","6IYbBuaLHqTOtLDojDn6dJY9FApcRRVm6F0eWnXwkZ4",[169,174],{"title":170,"path":171,"stem":172,"children":-1,"slug":173},"疯魔","\u002Fblog\u002Fblog_4af9831b0100dur9","blog\u002Fblog_4af9831b0100dur9","blog_4af9831b0100dur9",{"title":175,"path":176,"stem":177,"children":-1,"slug":178},"尘缘","\u002Fblog\u002Fblog_4af9831b0100fyqi","blog\u002Fblog_4af9831b0100fyqi","blog_4af9831b0100fyqi",1795162025718]
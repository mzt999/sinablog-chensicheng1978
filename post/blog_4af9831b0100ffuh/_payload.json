[{"data":1,"prerenderedAt":173},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":70,"blog-post-slug-blog_4af9831b0100ffuh":87,"surround-blog_4af9831b0100ffuh":162},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":45,"navLinks":46,"perPage":16,"prevNextIsExcludeDate":66,"site_description":23,"site_name":67,"stem":68,"__hash__":69},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{},[47,52,56,60,64],{"path":48,"title":49,"target":50,"fa_class":51},"\u002F","博客首页","internal","fa-home",{"path":53,"title":54,"target":50,"fa_class":55},"\u002Fabout","关于","fa-user",{"path":57,"title":58,"target":50,"fa_class":59},"\u002Fpost","归档","fa-archive",{"path":61,"title":62,"target":50,"fa_class":63},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":65,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","jvZHccz2rT-wjVS5GCPgWyhl8WnBIvECPkE5KpKFKCU",{"latestBlog":71},[72,75,78,81,84],{"title":73,"slug":74},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":76,"slug":77},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":79,"slug":80},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":82,"slug":83},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":85,"slug":86},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":88,"title":89,"body":90,"categories":149,"description":150,"extension":151,"meta":152,"navigation":154,"path":155,"seo":156,"slug":157,"stem":158,"tags":159,"__hash__":161},"blog\u002Fblog\u002Fblog_4af9831b0100ffuh.md","无题1",{"type":91,"value":92,"toc":145},"minimark",[93,97,100,103,106,109,112,115,118,121,124,127,130,133,136,139,142],[94,95,96],"p",{},"久没来了，把原因都推给时间，显然是托辞。",[94,98,99],{},"心情使然吧……没那么多牢骚了，或是牢骚更精深了。",[94,101,102],{},"今天拍了“大”戏结局的一场戏，我很喜欢。",[94,104,105],{},"“此情只待成追忆，但觉当时已惘然……”",[94,107,108],{},"命运总是如此，在你不相信的时候，它才不期而至……",[94,110,111],{},"现在发现，“唏嘘”这个词怕是对爱情，对人生，对所有过往最好的一个诠释。",[94,113,114],{},"世事万物，生不带来死不带去，所谓悲喜，浮光掠影……",[94,116,117],{},"对这戏的感觉是爱恨交织，如此“纯爱”倒是头次。",[94,119,120],{},"“萧清羽”又成了一个我自愧不如终生只能望其项背的人物……",[94,122,123],{},"或者那种为爱舍生忘死的感觉也曾有过？但何年何月不见的呢？回首来时路，没有答案……",[94,125,126],{},"如果真用古人对爱情的解释“情不知所起，一往情深，生者可以死，死可以生。生而不可与死，死而不可复生者，皆非情之至也！”那此刻，我们的身边又会有几个“爱情”呢？",[94,128,129],{},"这戏和桃花有缘。前几天，在“桃花庵”外想起唐伯虎的“桃花诗”，便即兴也随了一首只头尾的七言。",[94,131,132],{},"“桃花仙子桃花脸，桃花脸上桃花眼，桃花眼生桃花意，意到浓时万花浅。",[94,134,135],{},"莫言我心徒高远，他日许把乾坤转，待到寒风冷露时，笑傲独撑桃花伞。”",[94,137,138],{},"唐寅的心怀本是我一直神往的，但现在，我嗅到了他的痛苦。",[94,140,141],{},"看来，真正的笑傲江湖，不是在眼花耳热后义气素霓生之时，就只能在洗尽铅华冷眼了然浮生若梦以后了……",[94,143,144],{},"悲凉，有点点悲凉……",{"title":146,"searchDepth":147,"depth":147,"links":148},"",2,[],[6],"今天拍了《大丫鬟》结局的一场戏，我很喜欢。","md",{"date":153},"2009-10-10 21:56",true,"\u002Fblog\u002Fblog_4af9831b0100ffuh",{"title":89,"description":150},"blog_4af9831b0100ffuh","blog\u002Fblog_4af9831b0100ffuh",[160],"杂谈","6IYbBuaLHqTOtLDojDn6dJY9FApcRRVm6F0eWnXwkZ4",[163,168],{"title":164,"path":165,"stem":166,"children":-1,"slug":167},"疯魔","\u002Fblog\u002Fblog_4af9831b0100dur9","blog\u002Fblog_4af9831b0100dur9","blog_4af9831b0100dur9",{"title":169,"path":170,"stem":171,"children":-1,"slug":172},"尘缘","\u002Fblog\u002Fblog_4af9831b0100fyqi","blog\u002Fblog_4af9831b0100fyqi","blog_4af9831b0100fyqi",1794546769558]
[{"data":1,"prerenderedAt":116},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b0100ffuh":31,"surround-blog_4af9831b0100ffuh":105},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",151,{"name":9,"len":10},"有图",34,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":93,"description":33,"extension":94,"meta":95,"navigation":97,"path":98,"seo":99,"slug":100,"stem":101,"tags":102,"__hash__":104},"blog\u002Fblog\u002Fblog_4af9831b0100ffuh.md","无题1",{"type":35,"value":36,"toc":89},"minimark",[37,41,44,47,50,53,56,59,62,65,68,71,74,77,80,83,86],[38,39,40],"p",{},"久没来了，把原因都推给时间，显然是托辞。",[38,42,43],{},"心情使然吧……没那么多牢骚了，或是牢骚更精深了。",[38,45,46],{},"今天拍了“大”戏结局的一场戏，我很喜欢。",[38,48,49],{},"“此情只待成追忆，但觉当时已惘然……”",[38,51,52],{},"命运总是如此，在你不相信的时候，它才不期而至……",[38,54,55],{},"现在发现，“唏嘘”这个词怕是对爱情，对人生，对所有过往最好的一个诠释。",[38,57,58],{},"世事万物，生不带来死不带去，所谓悲喜，浮光掠影……",[38,60,61],{},"对这戏的感觉是爱恨交织，如此“纯爱”倒是头次。",[38,63,64],{},"“萧清羽”又成了一个我自愧不如终生只能望其项背的人物……",[38,66,67],{},"或者那种为爱舍生忘死的感觉也曾有过？但何年何月不见的呢？回首来时路，没有答案……",[38,69,70],{},"如果真用古人对爱情的解释“情不知所起，一往情深，生者可以死，死可以生。生而不可与死，死而不可复生者，皆非情之至也！”那此刻，我们的身边又会有几个“爱情”呢？",[38,72,73],{},"这戏和桃花有缘。前几天，在“桃花庵”外想起唐伯虎的“桃花诗”，便即兴也随了一首只头尾的七言。",[38,75,76],{},"“桃花仙子桃花脸，桃花脸上桃花眼，桃花眼生桃花意，意到浓时万花浅。",[38,78,79],{},"莫言我心徒高远，他日许把乾坤转，待到寒风冷露时，笑傲独撑桃花伞。”",[38,81,82],{},"唐寅的心怀本是我一直神往的，但现在，我嗅到了他的痛苦。",[38,84,85],{},"看来，真正的笑傲江湖，不是在眼花耳热后义气素霓生之时，就只能在洗尽铅华冷眼了然浮生若梦以后了……",[38,87,88],{},"悲凉，有点点悲凉……",{"title":90,"searchDepth":91,"depth":91,"links":92},"",2,[],[6],"md",{"date":96},"2009-10-10 21:56",true,"\u002Fblog\u002Fblog_4af9831b0100ffuh",{"title":33,"description":33},"blog_4af9831b0100ffuh","blog\u002Fblog_4af9831b0100ffuh",[103],"杂谈","PPtmZfmQuarbqHcWFU8ZlN6RF1-jdtFVWc3yMY6mCTI",[106,111],{"title":107,"path":108,"stem":109,"children":-1,"slug":110},"疯魔","\u002Fblog\u002Fblog_4af9831b0100dur9","blog\u002Fblog_4af9831b0100dur9","blog_4af9831b0100dur9",{"title":112,"path":113,"stem":114,"children":-1,"slug":115},"尘缘","\u002Fblog\u002Fblog_4af9831b0100fyqi","blog\u002Fblog_4af9831b0100fyqi","blog_4af9831b0100fyqi",1793775558106]
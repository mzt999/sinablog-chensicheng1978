[{"data":1,"prerenderedAt":120},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":17,"blog-post-slug-blog_4af9831b0100ffuh":34,"surround-blog_4af9831b0100ffuh":109},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"latestBlog":18},[19,22,25,28,31],{"title":20,"slug":21},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":23,"slug":24},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":26,"slug":27},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":29,"slug":30},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":32,"slug":33},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":35,"title":36,"body":37,"categories":96,"description":97,"extension":98,"meta":99,"navigation":101,"path":102,"seo":103,"slug":104,"stem":105,"tags":106,"__hash__":108},"blog\u002Fblog\u002Fblog_4af9831b0100ffuh.md","无题1",{"type":38,"value":39,"toc":92},"minimark",[40,44,47,50,53,56,59,62,65,68,71,74,77,80,83,86,89],[41,42,43],"p",{},"久没来了，把原因都推给时间，显然是托辞。",[41,45,46],{},"心情使然吧……没那么多牢骚了，或是牢骚更精深了。",[41,48,49],{},"今天拍了“大”戏结局的一场戏，我很喜欢。",[41,51,52],{},"“此情只待成追忆，但觉当时已惘然……”",[41,54,55],{},"命运总是如此，在你不相信的时候，它才不期而至……",[41,57,58],{},"现在发现，“唏嘘”这个词怕是对爱情，对人生，对所有过往最好的一个诠释。",[41,60,61],{},"世事万物，生不带来死不带去，所谓悲喜，浮光掠影……",[41,63,64],{},"对这戏的感觉是爱恨交织，如此“纯爱”倒是头次。",[41,66,67],{},"“萧清羽”又成了一个我自愧不如终生只能望其项背的人物……",[41,69,70],{},"或者那种为爱舍生忘死的感觉也曾有过？但何年何月不见的呢？回首来时路，没有答案……",[41,72,73],{},"如果真用古人对爱情的解释“情不知所起，一往情深，生者可以死，死可以生。生而不可与死，死而不可复生者，皆非情之至也！”那此刻，我们的身边又会有几个“爱情”呢？",[41,75,76],{},"这戏和桃花有缘。前几天，在“桃花庵”外想起唐伯虎的“桃花诗”，便即兴也随了一首只头尾的七言。",[41,78,79],{},"“桃花仙子桃花脸，桃花脸上桃花眼，桃花眼生桃花意，意到浓时万花浅。",[41,81,82],{},"莫言我心徒高远，他日许把乾坤转，待到寒风冷露时，笑傲独撑桃花伞。”",[41,84,85],{},"唐寅的心怀本是我一直神往的，但现在，我嗅到了他的痛苦。",[41,87,88],{},"看来，真正的笑傲江湖，不是在眼花耳热后义气素霓生之时，就只能在洗尽铅华冷眼了然浮生若梦以后了……",[41,90,91],{},"悲凉，有点点悲凉……",{"title":93,"searchDepth":94,"depth":94,"links":95},"",2,[],[6],"今天拍了《大丫鬟》结局的一场戏，我很喜欢。","md",{"date":100},"2009-10-10 21:56",true,"\u002Fblog\u002Fblog_4af9831b0100ffuh",{"title":36,"description":97},"blog_4af9831b0100ffuh","blog\u002Fblog_4af9831b0100ffuh",[107],"杂谈","6IYbBuaLHqTOtLDojDn6dJY9FApcRRVm6F0eWnXwkZ4",[110,115],{"title":111,"path":112,"stem":113,"children":-1,"slug":114},"疯魔","\u002Fblog\u002Fblog_4af9831b0100dur9","blog\u002Fblog_4af9831b0100dur9","blog_4af9831b0100dur9",{"title":116,"path":117,"stem":118,"children":-1,"slug":119},"尘缘","\u002Fblog\u002Fblog_4af9831b0100fyqi","blog\u002Fblog_4af9831b0100fyqi","blog_4af9831b0100fyqi",1794043804740]
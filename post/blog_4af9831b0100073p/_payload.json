[{"data":1,"prerenderedAt":154},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":73,"blog-post-slug-blog_4af9831b0100073p":90,"surround-blog_4af9831b0100073p":143},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":48,"navLinks":49,"perPage":16,"prevNextIsExcludeDate":69,"site_description":23,"site_name":70,"stem":71,"__hash__":72},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43,45],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{"href":46,"text":47},"https:\u002F\u002Fmzt999.github.io\u002Fportfolio-chensicheng1978","幕后作品集展示(2012-2026)",{},[50,55,59,63,67],{"path":51,"title":52,"target":53,"fa_class":54},"\u002F","博客首页","internal","fa-home",{"path":56,"title":57,"target":53,"fa_class":58},"\u002Fabout","关于","fa-user",{"path":60,"title":61,"target":53,"fa_class":62},"\u002Fpost","归档","fa-archive",{"path":64,"title":65,"target":53,"fa_class":66},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":68,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","LA_7Y82F2zjQ6-R2_tcWHl356krYL76uqQHBCIU8UZk",{"latestBlog":74},[75,78,81,84,87],{"title":76,"slug":77},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":79,"slug":80},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":82,"slug":83},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":85,"slug":86},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":88,"slug":89},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":91,"title":92,"body":93,"categories":132,"description":100,"extension":133,"meta":134,"navigation":136,"path":137,"seo":138,"slug":139,"stem":140,"tags":141,"__hash__":142},"blog\u002Fblog\u002Fblog_4af9831b0100073p.md","写给你们(标点符号版)",{"type":94,"value":95,"toc":128},"minimark",[96,101,104,107,110,113,116,119,122,125],[97,98,100],"p",{"style":99},"color:red;","这世界总有新的感动,也是让我们生存下去的重要动力之一!",[97,102,103],{"style":99},"谢谢你们:狼, 77, 猫, 燃燃,当然还有亲临现场的小鬼.你们让我觉得温暖......是的每个人都有孤单寂寞的时候,可是只要你们还在我身边我想走多远也不会太累吧......",[97,105,106],{"style":99},"我们一路向前走着,走着......被伤害着,被感动着,被打磨着,被温暖着......放下心情认真的回看自己走过的路,我们到底得到了多少又遗失了多少?",[97,108,109],{"style":99},"真的,自己真的是个很很很晚熟的人.晚熟到总是经历了挫折才清醒的面对,总是跌倒后才明白加速跑,就像我演的成才.男人的成长真是既漫长又痛苦,那是一次次血肉模糊的蜕变......很想回到17岁......",[97,111,112],{"style":99},"耳边有时会响起朴树的\"那些花儿\",会想起这一路被我抛弃或伤害的那些人.我不是想忏悔,但真的希望你们都好!生命一定要终结,或早或晚.但我深信某些记忆会随着灵魂转世到下一次轮回!!也许那是未来,也许回到古代?不知道.但我想,还是有故事会发生......今生的一次对眸谁说不是前生的一段缘?欠你们的,还吧......",[97,114,115],{"style":99},"我又长大了.因为更明白了感恩.懂了谁给你的爱都不是无缘由的,那些都是上天的恩赐.今生你不回馈来世也要偿还的.",[97,117,118],{"style":99},"你们,对!就是你们几个: 狼  77 猫 燃燃 芝麻 还有可爱的小鬼......以后的路我们彼此见证吧!一起成长吧!如果可以能彼此掺扶着高唱夕阳红登高远望追忆往昔不是很好?时间可以拿走我们的一切但别把这份最纯真的感动拿走吧!",[97,120,121],{"style":99},"怎么说呢?你们让感受到到了上初中时的感觉!......夏天,阳光明媚!空气远比现在清新,天更蓝树更绿!那时候的橙子是冲动的,会打架的!是不可一世的,会经常让人骂傻X的!是小聪明大抱负的,会把地球踩在脚下的理想挂在嘴边的!是相信爱情的,会见到喜欢的女孩脸红的......那时候的我真好!我要活回去.回去!那时的操场上应该是有你们的......  真想亲亲你们!真的!抱着头使劲的亲!!一个,一个.",[97,123,124],{"style":99},"我不会放弃,就算过了更年期!!也不允许你们!因为我们还要结伴后面的路,无论崎岖平坦.谁不认真都会掉队!!答应我,好吗?",[97,126,127],{"style":99},"我爱你们  我知道  没什么比这更好",{"title":129,"searchDepth":130,"depth":130,"links":131},"",2,[],[6],"md",{"date":135},"2007-02-03 00:58",true,"\u002Fblog\u002Fblog_4af9831b0100073p",{"title":92,"description":100},"blog_4af9831b0100073p","blog\u002Fblog_4af9831b0100073p",[],"_i5VFpCFw4H04Qzcujb0-mAE6S4i8z85H7wqdj7zMVI",[144,149],{"title":145,"path":146,"stem":147,"children":-1,"slug":148},"写给你们","\u002Fblog\u002Fblog_4af9831b0100073o","blog\u002Fblog_4af9831b0100073o","blog_4af9831b0100073o",{"title":150,"path":151,"stem":152,"children":-1,"slug":153},"2月2号发布会照片在相册中","\u002Fblog\u002Fblog_4af9831b01000740","blog\u002Fblog_4af9831b01000740","blog_4af9831b01000740",1794760532736]
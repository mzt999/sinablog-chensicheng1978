[{"data":1,"prerenderedAt":157},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":76,"blog-post-slug-blog_4af9831b0100073p":93,"surround-blog_4af9831b0100073p":146},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":38,"meta":50,"navLinks":51,"perPage":16,"prevNextIsExcludeDate":71,"site_description":72,"site_name":73,"stem":74,"__hash__":75},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,26,32],{"text":23},"粉丝自制非官方站点｜素材版权归原权利人所有",{"text":25},"仅兴趣交流、无商业用途｜如有侵权请联系删除",{"text":27,"link":28},"查看",{"href":29,"text":30,"fa_class":31},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":33,"link":34},"如有任何疑问，欢迎",{"href":35,"text":36,"fa_class":37},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[39,42,45,47],{"href":40,"text":41},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":43,"text":44},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":46},"新浪微博备份(2009-2026)",{"href":48,"text":49},"https:\u002F\u002Fmzt999.github.io\u002Fportfolio-chensicheng1978","幕后作品集展示(2012-2026)",{},[52,57,61,65,69],{"path":53,"title":54,"target":55,"fa_class":56},"\u002F","博客首页","internal","fa-home",{"path":58,"title":59,"target":55,"fa_class":60},"\u002Fabout","关于","fa-user",{"path":62,"title":63,"target":55,"fa_class":64},"\u002Fpost","归档","fa-archive",{"path":66,"title":67,"target":55,"fa_class":68},"\u002Fgallery","相册","fa-image",{"path":29,"title":30,"target":70,"fa_class":31},"otherSite",false,"新浪博客内容备份(粉丝自用)","陈思诚的博客","settings","5S7xKt0XLHpkjipbomx4I7pUu50Y7wqtD418LquZj5Q",{"latestBlog":77},[78,81,84,87,90],{"title":79,"slug":80},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":82,"slug":83},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":85,"slug":86},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":88,"slug":89},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":91,"slug":92},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":94,"title":95,"body":96,"categories":135,"description":103,"extension":136,"meta":137,"navigation":139,"path":140,"seo":141,"slug":142,"stem":143,"tags":144,"__hash__":145},"blog\u002Fblog\u002Fblog_4af9831b0100073p.md","写给你们(标点符号版)",{"type":97,"value":98,"toc":131},"minimark",[99,104,107,110,113,116,119,122,125,128],[100,101,103],"p",{"style":102},"color:red;","这世界总有新的感动,也是让我们生存下去的重要动力之一!",[100,105,106],{"style":102},"谢谢你们:狼, 77, 猫, 燃燃,当然还有亲临现场的小鬼.你们让我觉得温暖......是的每个人都有孤单寂寞的时候,可是只要你们还在我身边我想走多远也不会太累吧......",[100,108,109],{"style":102},"我们一路向前走着,走着......被伤害着,被感动着,被打磨着,被温暖着......放下心情认真的回看自己走过的路,我们到底得到了多少又遗失了多少?",[100,111,112],{"style":102},"真的,自己真的是个很很很晚熟的人.晚熟到总是经历了挫折才清醒的面对,总是跌倒后才明白加速跑,就像我演的成才.男人的成长真是既漫长又痛苦,那是一次次血肉模糊的蜕变......很想回到17岁......",[100,114,115],{"style":102},"耳边有时会响起朴树的\"那些花儿\",会想起这一路被我抛弃或伤害的那些人.我不是想忏悔,但真的希望你们都好!生命一定要终结,或早或晚.但我深信某些记忆会随着灵魂转世到下一次轮回!!也许那是未来,也许回到古代?不知道.但我想,还是有故事会发生......今生的一次对眸谁说不是前生的一段缘?欠你们的,还吧......",[100,117,118],{"style":102},"我又长大了.因为更明白了感恩.懂了谁给你的爱都不是无缘由的,那些都是上天的恩赐.今生你不回馈来世也要偿还的.",[100,120,121],{"style":102},"你们,对!就是你们几个: 狼  77 猫 燃燃 芝麻 还有可爱的小鬼......以后的路我们彼此见证吧!一起成长吧!如果可以能彼此掺扶着高唱夕阳红登高远望追忆往昔不是很好?时间可以拿走我们的一切但别把这份最纯真的感动拿走吧!",[100,123,124],{"style":102},"怎么说呢?你们让感受到到了上初中时的感觉!......夏天,阳光明媚!空气远比现在清新,天更蓝树更绿!那时候的橙子是冲动的,会打架的!是不可一世的,会经常让人骂傻X的!是小聪明大抱负的,会把地球踩在脚下的理想挂在嘴边的!是相信爱情的,会见到喜欢的女孩脸红的......那时候的我真好!我要活回去.回去!那时的操场上应该是有你们的......  真想亲亲你们!真的!抱着头使劲的亲!!一个,一个.",[100,126,127],{"style":102},"我不会放弃,就算过了更年期!!也不允许你们!因为我们还要结伴后面的路,无论崎岖平坦.谁不认真都会掉队!!答应我,好吗?",[100,129,130],{"style":102},"我爱你们  我知道  没什么比这更好",{"title":132,"searchDepth":133,"depth":133,"links":134},"",2,[],[6],"md",{"date":138},"2007-02-03 00:58",true,"\u002Fblog\u002Fblog_4af9831b0100073p",{"title":95,"description":103},"blog_4af9831b0100073p","blog\u002Fblog_4af9831b0100073p",[],"_i5VFpCFw4H04Qzcujb0-mAE6S4i8z85H7wqdj7zMVI",[147,152],{"title":148,"path":149,"stem":150,"children":-1,"slug":151},"写给你们","\u002Fblog\u002Fblog_4af9831b0100073o","blog\u002Fblog_4af9831b0100073o","blog_4af9831b0100073o",{"title":153,"path":154,"stem":155,"children":-1,"slug":156},"2月2号发布会照片在相册中","\u002Fblog\u002Fblog_4af9831b01000740","blog\u002Fblog_4af9831b01000740","blog_4af9831b01000740",1795162026414]
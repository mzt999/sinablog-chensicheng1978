[{"data":1,"prerenderedAt":139},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":58,"blog-post-slug-blog_4af9831b0100073p":75,"surround-blog_4af9831b0100073p":128},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":54,"site_description":55,"stem":56,"__hash__":57},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo",20,"新浪博客内容备份","settings","hh8X7X6SFDoeJrxIJ4yisZXSc3HwHM1zk206jiQX2XU",{"latestBlog":59},[60,63,66,69,72],{"title":61,"slug":62},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":64,"slug":65},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":67,"slug":68},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":70,"slug":71},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":73,"slug":74},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":76,"title":77,"body":78,"categories":117,"description":85,"extension":118,"meta":119,"navigation":121,"path":122,"seo":123,"slug":124,"stem":125,"tags":126,"__hash__":127},"blog\u002Fblog\u002Fblog_4af9831b0100073p.md","写给你们(标点符号版)",{"type":79,"value":80,"toc":113},"minimark",[81,86,89,92,95,98,101,104,107,110],[82,83,85],"p",{"style":84},"color:red;","这世界总有新的感动,也是让我们生存下去的重要动力之一!",[82,87,88],{"style":84},"谢谢你们:狼, 77, 猫, 燃燃,当然还有亲临现场的小鬼.你们让我觉得温暖......是的每个人都有孤单寂寞的时候,可是只要你们还在我身边我想走多远也不会太累吧......",[82,90,91],{"style":84},"我们一路向前走着,走着......被伤害着,被感动着,被打磨着,被温暖着......放下心情认真的回看自己走过的路,我们到底得到了多少又遗失了多少?",[82,93,94],{"style":84},"真的,自己真的是个很很很晚熟的人.晚熟到总是经历了挫折才清醒的面对,总是跌倒后才明白加速跑,就像我演的成才.男人的成长真是既漫长又痛苦,那是一次次血肉模糊的蜕变......很想回到17岁......",[82,96,97],{"style":84},"耳边有时会响起朴树的\"那些花儿\",会想起这一路被我抛弃或伤害的那些人.我不是想忏悔,但真的希望你们都好!生命一定要终结,或早或晚.但我深信某些记忆会随着灵魂转世到下一次轮回!!也许那是未来,也许回到古代?不知道.但我想,还是有故事会发生......今生的一次对眸谁说不是前生的一段缘?欠你们的,还吧......",[82,99,100],{"style":84},"我又长大了.因为更明白了感恩.懂了谁给你的爱都不是无缘由的,那些都是上天的恩赐.今生你不回馈来世也要偿还的.",[82,102,103],{"style":84},"你们,对!就是你们几个: 狼  77 猫 燃燃 芝麻 还有可爱的小鬼......以后的路我们彼此见证吧!一起成长吧!如果可以能彼此掺扶着高唱夕阳红登高远望追忆往昔不是很好?时间可以拿走我们的一切但别把这份最纯真的感动拿走吧!",[82,105,106],{"style":84},"怎么说呢?你们让感受到到了上初中时的感觉!......夏天,阳光明媚!空气远比现在清新,天更蓝树更绿!那时候的橙子是冲动的,会打架的!是不可一世的,会经常让人骂傻X的!是小聪明大抱负的,会把地球踩在脚下的理想挂在嘴边的!是相信爱情的,会见到喜欢的女孩脸红的......那时候的我真好!我要活回去.回去!那时的操场上应该是有你们的......  真想亲亲你们!真的!抱着头使劲的亲!!一个,一个.",[82,108,109],{"style":84},"我不会放弃,就算过了更年期!!也不允许你们!因为我们还要结伴后面的路,无论崎岖平坦.谁不认真都会掉队!!答应我,好吗?",[82,111,112],{"style":84},"我爱你们  我知道  没什么比这更好",{"title":114,"searchDepth":115,"depth":115,"links":116},"",2,[],[6],"md",{"date":120},"2007-02-03 00:58",true,"\u002Fblog\u002Fblog_4af9831b0100073p",{"title":77,"description":85},"blog_4af9831b0100073p","blog\u002Fblog_4af9831b0100073p",[],"_i5VFpCFw4H04Qzcujb0-mAE6S4i8z85H7wqdj7zMVI",[129,134],{"title":130,"path":131,"stem":132,"children":-1,"slug":133},"写给你们","\u002Fblog\u002Fblog_4af9831b0100073o","blog\u002Fblog_4af9831b0100073o","blog_4af9831b0100073o",{"title":135,"path":136,"stem":137,"children":-1,"slug":138},"2月2号发布会照片在相册中","\u002Fblog\u002Fblog_4af9831b01000740","blog\u002Fblog_4af9831b01000740","blog_4af9831b01000740",1794412501488]
[{"data":1,"prerenderedAt":154},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":57,"blog-post-slug-blog_4af9831b01000ba5":74,"surround-blog_4af9831b01000ba5":143},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":16,"site_description":54,"stem":55,"__hash__":56},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo","新浪博客内容备份(粉丝自用)","settings","jPD1QWrYwbaIixg6lntppEYe-T3ZGd3EJZxFBkbKY9E",{"latestBlog":58},[59,62,65,68,71],{"title":60,"slug":61},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":63,"slug":64},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":66,"slug":67},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":69,"slug":70},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":72,"slug":73},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":75,"title":76,"body":77,"categories":124,"description":125,"extension":126,"meta":127,"navigation":129,"path":130,"seo":131,"slug":132,"stem":133,"tags":134,"__hash__":142},"blog\u002Fblog\u002Fblog_4af9831b01000ba5.md","我们都是好孩子",{"type":78,"value":79,"toc":120},"minimark",[80,90,93,96,99,102,105,108,111,114,117],[81,82,83,87],"p",{},[84,85],"img",{"alt":76,"src":86},"\u002Fpic\u002F4af9831b02001736.jpg",[84,88],{"alt":76,"src":89},"\u002Fpic\u002F4af9831b02001735.jpg",[81,91,92],{},"  听过这首歌吗？“我们都是好孩子”？喜欢……",[81,94,95],{},"昨天，公主同学走了。她是个好孩子。是造物主留给这个世界的惊喜。林江国同学会陪我到最后，还好。",[81,97,98],{},"有的时候是这样，不知不觉，我们成了我们。 机缘巧合环境影响……一切措辞不过是命运留给这世界的一个托辞，其实我们都被安排了，早就注定了，善的恶的美的丑的功的罪的缘的孽的还的报的我们的你们的他们的……",[81,100,101],{},"我抹去一方灰尘，看到了里面，本质，那是一种光亮，未被侵染过多，未曾同化过久，我仿佛穿越了时空，看到了以往的自己……不！那明明就是自己。自己也曾有过的无邪的笑，孩子一样……白衣飘，高声歌，追逐着，跳跃着，手拉手，奔向，咖啡色的夕阳，那天边外……",[81,103,104],{},"身边的日子只是在静静溜走，没心没肺，从不停留，永不回头。我们随波逐流竭尽所有也只能随波逐流，远去，远去，再远去……直至被淹没……但不会没有一点痕迹吧，不会吧……",[81,106,107],{},"因为我们都是好孩子，我们都会感恩，都会流泪，都会用力去拥抱爱……我们都是宠儿，是不会被离弃的，坚强背后的柔是我们的共性，是泪眼后的笑，是我们的真……真的就不会不见……",[81,109,110],{},"又一段岁月即将结束，人们陆续离开，记载这一切的不该只是那些正版或盗版的音响制品吧，还会在我们的心里，至少。祝大家都好吧……",[81,112,113],{},"再次相见，何年何月何时何地？",[81,115,116],{},"我想你会笑着答。",[81,118,119],{},"你猜……",{"title":121,"searchDepth":122,"depth":122,"links":123},"",2,[],[6,9],"听过这首歌吗？“我们都是好孩子”？喜欢……","md",{"date":128},"2007-10-17 20:48",true,"\u002Fblog\u002Fblog_4af9831b01000ba5",{"title":76,"description":125},"blog_4af9831b01000ba5","blog\u002Fblog_4af9831b01000ba5",[135,136,137,138,139,140,141],"随笔\u002F感悟","美图","感悟随笔","亲情友情","戴娇倩","林江国","陈思成","Z387_o7RZgxKIbVHjmnojB9L1kEaDmiKgvY2aCjpCpc",[144,149],{"title":145,"path":146,"stem":147,"children":-1,"slug":148},"2 选择","\u002Fblog\u002Fblog_4af9831b01000b6f","blog\u002Fblog_4af9831b01000b6f","blog_4af9831b01000b6f",{"title":150,"path":151,"stem":152,"children":-1,"slug":153},"明天","\u002Fblog\u002Fblog_4af9831b01000bb0","blog\u002Fblog_4af9831b01000bb0","blog_4af9831b01000bb0",1794473705572]
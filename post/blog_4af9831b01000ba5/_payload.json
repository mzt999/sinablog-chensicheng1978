[{"data":1,"prerenderedAt":110},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b01000ba5":31,"surround-blog_4af9831b01000ba5":99},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",151,{"name":9,"len":10},"有图",34,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":81,"description":33,"extension":82,"meta":83,"navigation":85,"path":86,"seo":87,"slug":88,"stem":89,"tags":90,"__hash__":98},"blog\u002Fblog\u002Fblog_4af9831b01000ba5.md","我们都是好孩子",{"type":35,"value":36,"toc":77},"minimark",[37,47,50,53,56,59,62,65,68,71,74],[38,39,40,44],"p",{},[41,42],"img",{"alt":33,"src":43},"\u002Fpic\u002F4af9831b02001736.jpg",[41,45],{"alt":33,"src":46},"\u002Fpic\u002F4af9831b02001735.jpg",[38,48,49],{},"  听过这首歌吗？“我们都是好孩子”？喜欢……",[38,51,52],{},"昨天，公主同学走了。她是个好孩子。是造物主留给这个世界的惊喜。林江国同学会陪我到最后，还好。",[38,54,55],{},"有的时候是这样，不知不觉，我们成了我们。 机缘巧合环境影响……一切措辞不过是命运留给这世界的一个托辞，其实我们都被安排了，早就注定了，善的恶的美的丑的功的罪的缘的孽的还的报的我们的你们的他们的……",[38,57,58],{},"我抹去一方灰尘，看到了里面，本质，那是一种光亮，未被侵染过多，未曾同化过久，我仿佛穿越了时空，看到了以往的自己……不！那明明就是自己。自己也曾有过的无邪的笑，孩子一样……白衣飘，高声歌，追逐着，跳跃着，手拉手，奔向，咖啡色的夕阳，那天边外……",[38,60,61],{},"身边的日子只是在静静溜走，没心没肺，从不停留，永不回头。我们随波逐流竭尽所有也只能随波逐流，远去，远去，再远去……直至被淹没……但不会没有一点痕迹吧，不会吧……",[38,63,64],{},"因为我们都是好孩子，我们都会感恩，都会流泪，都会用力去拥抱爱……我们都是宠儿，是不会被离弃的，坚强背后的柔是我们的共性，是泪眼后的笑，是我们的真……真的就不会不见……",[38,66,67],{},"又一段岁月即将结束，人们陆续离开，记载这一切的不该只是那些正版或盗版的音响制品吧，还会在我们的心里，至少。祝大家都好吧……",[38,69,70],{},"再次相见，何年何月何时何地？",[38,72,73],{},"我想你会笑着答。",[38,75,76],{},"你猜……",{"title":78,"searchDepth":79,"depth":79,"links":80},"",2,[],[6,9],"md",{"date":84},"2007-10-17 20:48",true,"\u002Fblog\u002Fblog_4af9831b01000ba5",{"title":33,"description":33},"blog_4af9831b01000ba5","blog\u002Fblog_4af9831b01000ba5",[91,92,93,94,95,96,97],"随笔\u002F感悟","美图","感悟随笔","亲情友情","戴娇倩","林江国","陈思成","GtXACsqmHpIMxlEW4z1gcqqgcaO96EoHi3sX5Kv3Hes",[100,105],{"title":101,"path":102,"stem":103,"children":-1,"slug":104},"2 选择","\u002Fblog\u002Fblog_4af9831b01000b6f","blog\u002Fblog_4af9831b01000b6f","blog_4af9831b01000b6f",{"title":106,"path":107,"stem":108,"children":-1,"slug":109},"明天","\u002Fblog\u002Fblog_4af9831b01000bb0","blog\u002Fblog_4af9831b01000bb0","blog_4af9831b01000bb0",1793849574981]
[{"data":1,"prerenderedAt":167},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":70,"blog-post-slug-blog_4af9831b01000ba5":87,"surround-blog_4af9831b01000ba5":156},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":45,"navLinks":46,"perPage":16,"prevNextIsExcludeDate":66,"site_description":23,"site_name":67,"stem":68,"__hash__":69},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{},[47,52,56,60,64],{"path":48,"title":49,"target":50,"fa_class":51},"\u002F","博客首页","internal","fa-home",{"path":53,"title":54,"target":50,"fa_class":55},"\u002Fabout","关于","fa-user",{"path":57,"title":58,"target":50,"fa_class":59},"\u002Fpost","归档","fa-archive",{"path":61,"title":62,"target":50,"fa_class":63},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":65,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","jvZHccz2rT-wjVS5GCPgWyhl8WnBIvECPkE5KpKFKCU",{"latestBlog":71},[72,75,78,81,84],{"title":73,"slug":74},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":76,"slug":77},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":79,"slug":80},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":82,"slug":83},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":85,"slug":86},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":88,"title":89,"body":90,"categories":137,"description":138,"extension":139,"meta":140,"navigation":142,"path":143,"seo":144,"slug":145,"stem":146,"tags":147,"__hash__":155},"blog\u002Fblog\u002Fblog_4af9831b01000ba5.md","我们都是好孩子",{"type":91,"value":92,"toc":133},"minimark",[93,103,106,109,112,115,118,121,124,127,130],[94,95,96,100],"p",{},[97,98],"img",{"alt":89,"src":99},"\u002Fpic\u002F4af9831b02001736.jpg",[97,101],{"alt":89,"src":102},"\u002Fpic\u002F4af9831b02001735.jpg",[94,104,105],{},"  听过这首歌吗？“我们都是好孩子”？喜欢……",[94,107,108],{},"昨天，公主同学走了。她是个好孩子。是造物主留给这个世界的惊喜。林江国同学会陪我到最后，还好。",[94,110,111],{},"有的时候是这样，不知不觉，我们成了我们。 机缘巧合环境影响……一切措辞不过是命运留给这世界的一个托辞，其实我们都被安排了，早就注定了，善的恶的美的丑的功的罪的缘的孽的还的报的我们的你们的他们的……",[94,113,114],{},"我抹去一方灰尘，看到了里面，本质，那是一种光亮，未被侵染过多，未曾同化过久，我仿佛穿越了时空，看到了以往的自己……不！那明明就是自己。自己也曾有过的无邪的笑，孩子一样……白衣飘，高声歌，追逐着，跳跃着，手拉手，奔向，咖啡色的夕阳，那天边外……",[94,116,117],{},"身边的日子只是在静静溜走，没心没肺，从不停留，永不回头。我们随波逐流竭尽所有也只能随波逐流，远去，远去，再远去……直至被淹没……但不会没有一点痕迹吧，不会吧……",[94,119,120],{},"因为我们都是好孩子，我们都会感恩，都会流泪，都会用力去拥抱爱……我们都是宠儿，是不会被离弃的，坚强背后的柔是我们的共性，是泪眼后的笑，是我们的真……真的就不会不见……",[94,122,123],{},"又一段岁月即将结束，人们陆续离开，记载这一切的不该只是那些正版或盗版的音响制品吧，还会在我们的心里，至少。祝大家都好吧……",[94,125,126],{},"再次相见，何年何月何时何地？",[94,128,129],{},"我想你会笑着答。",[94,131,132],{},"你猜……",{"title":134,"searchDepth":135,"depth":135,"links":136},"",2,[],[6,9],"听过这首歌吗？“我们都是好孩子”？喜欢……","md",{"date":141},"2007-10-17 20:48",true,"\u002Fblog\u002Fblog_4af9831b01000ba5",{"title":89,"description":138},"blog_4af9831b01000ba5","blog\u002Fblog_4af9831b01000ba5",[148,149,150,151,152,153,154],"随笔\u002F感悟","美图","感悟随笔","亲情友情","戴娇倩","林江国","陈思成","Z387_o7RZgxKIbVHjmnojB9L1kEaDmiKgvY2aCjpCpc",[157,162],{"title":158,"path":159,"stem":160,"children":-1,"slug":161},"2 选择","\u002Fblog\u002Fblog_4af9831b01000b6f","blog\u002Fblog_4af9831b01000b6f","blog_4af9831b01000b6f",{"title":163,"path":164,"stem":165,"children":-1,"slug":166},"明天","\u002Fblog\u002Fblog_4af9831b01000bb0","blog\u002Fblog_4af9831b01000bb0","blog_4af9831b01000bb0",1794546769998]
[{"data":1,"prerenderedAt":114},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":17,"blog-post-slug-blog_4af9831b01000ba5":34,"surround-blog_4af9831b01000ba5":103},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"latestBlog":18},[19,22,25,28,31],{"title":20,"slug":21},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":23,"slug":24},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":26,"slug":27},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":29,"slug":30},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":32,"slug":33},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":35,"title":36,"body":37,"categories":84,"description":85,"extension":86,"meta":87,"navigation":89,"path":90,"seo":91,"slug":92,"stem":93,"tags":94,"__hash__":102},"blog\u002Fblog\u002Fblog_4af9831b01000ba5.md","我们都是好孩子",{"type":38,"value":39,"toc":80},"minimark",[40,50,53,56,59,62,65,68,71,74,77],[41,42,43,47],"p",{},[44,45],"img",{"alt":36,"src":46},"\u002Fpic\u002F4af9831b02001736.jpg",[44,48],{"alt":36,"src":49},"\u002Fpic\u002F4af9831b02001735.jpg",[41,51,52],{},"  听过这首歌吗？“我们都是好孩子”？喜欢……",[41,54,55],{},"昨天，公主同学走了。她是个好孩子。是造物主留给这个世界的惊喜。林江国同学会陪我到最后，还好。",[41,57,58],{},"有的时候是这样，不知不觉，我们成了我们。 机缘巧合环境影响……一切措辞不过是命运留给这世界的一个托辞，其实我们都被安排了，早就注定了，善的恶的美的丑的功的罪的缘的孽的还的报的我们的你们的他们的……",[41,60,61],{},"我抹去一方灰尘，看到了里面，本质，那是一种光亮，未被侵染过多，未曾同化过久，我仿佛穿越了时空，看到了以往的自己……不！那明明就是自己。自己也曾有过的无邪的笑，孩子一样……白衣飘，高声歌，追逐着，跳跃着，手拉手，奔向，咖啡色的夕阳，那天边外……",[41,63,64],{},"身边的日子只是在静静溜走，没心没肺，从不停留，永不回头。我们随波逐流竭尽所有也只能随波逐流，远去，远去，再远去……直至被淹没……但不会没有一点痕迹吧，不会吧……",[41,66,67],{},"因为我们都是好孩子，我们都会感恩，都会流泪，都会用力去拥抱爱……我们都是宠儿，是不会被离弃的，坚强背后的柔是我们的共性，是泪眼后的笑，是我们的真……真的就不会不见……",[41,69,70],{},"又一段岁月即将结束，人们陆续离开，记载这一切的不该只是那些正版或盗版的音响制品吧，还会在我们的心里，至少。祝大家都好吧……",[41,72,73],{},"再次相见，何年何月何时何地？",[41,75,76],{},"我想你会笑着答。",[41,78,79],{},"你猜……",{"title":81,"searchDepth":82,"depth":82,"links":83},"",2,[],[6,9],"听过这首歌吗？“我们都是好孩子”？喜欢……","md",{"date":88},"2007-10-17 20:48",true,"\u002Fblog\u002Fblog_4af9831b01000ba5",{"title":36,"description":85},"blog_4af9831b01000ba5","blog\u002Fblog_4af9831b01000ba5",[95,96,97,98,99,100,101],"随笔\u002F感悟","美图","感悟随笔","亲情友情","戴娇倩","林江国","陈思成","Z387_o7RZgxKIbVHjmnojB9L1kEaDmiKgvY2aCjpCpc",[104,109],{"title":105,"path":106,"stem":107,"children":-1,"slug":108},"2 选择","\u002Fblog\u002Fblog_4af9831b01000b6f","blog\u002Fblog_4af9831b01000b6f","blog_4af9831b01000b6f",{"title":110,"path":111,"stem":112,"children":-1,"slug":113},"明天","\u002Fblog\u002Fblog_4af9831b01000bb0","blog\u002Fblog_4af9831b01000bb0","blog_4af9831b01000bb0",1794130023774]
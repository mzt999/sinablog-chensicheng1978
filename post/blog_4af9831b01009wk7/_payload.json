[{"data":1,"prerenderedAt":164},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":76,"blog-post-slug-blog_4af9831b01009wk7":93,"surround-blog_4af9831b01009wk7":153},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":38,"meta":50,"navLinks":51,"perPage":16,"prevNextIsExcludeDate":71,"site_description":72,"site_name":73,"stem":74,"__hash__":75},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,26,32],{"text":23},"粉丝自制非官方站点｜素材版权归原权利人所有",{"text":25},"仅兴趣交流、无商业用途｜如有侵权请联系删除",{"text":27,"link":28},"查看",{"href":29,"text":30,"fa_class":31},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":33,"link":34},"如有任何疑问，欢迎",{"href":35,"text":36,"fa_class":37},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[39,42,45,47],{"href":40,"text":41},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":43,"text":44},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":46},"新浪微博备份(2009-2026)",{"href":48,"text":49},"https:\u002F\u002Fmzt999.github.io\u002Fportfolio-chensicheng1978","幕后作品集展示(2012-2026)",{},[52,57,61,65,69],{"path":53,"title":54,"target":55,"fa_class":56},"\u002F","博客首页","internal","fa-home",{"path":58,"title":59,"target":55,"fa_class":60},"\u002Fabout","关于","fa-user",{"path":62,"title":63,"target":55,"fa_class":64},"\u002Fpost","归档","fa-archive",{"path":66,"title":67,"target":55,"fa_class":68},"\u002Fgallery","相册","fa-image",{"path":29,"title":30,"target":70,"fa_class":31},"otherSite",false,"新浪博客内容备份(粉丝自用)","陈思诚的博客","settings","5S7xKt0XLHpkjipbomx4I7pUu50Y7wqtD418LquZj5Q",{"latestBlog":77},[78,81,84,87,90],{"title":79,"slug":80},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":82,"slug":83},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":85,"slug":86},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":88,"slug":89},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":91,"slug":92},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":94,"title":95,"body":96,"categories":140,"description":141,"extension":142,"meta":143,"navigation":145,"path":146,"seo":147,"slug":148,"stem":149,"tags":150,"__hash__":152},"blog\u002Fblog\u002Fblog_4af9831b01009wk7.md","橙汁",{"type":97,"value":98,"toc":136},"minimark",[99,106,109,112,115,118,121,124,127,130,133],[100,101,102],"p",{},[103,104,105],"em",{},"让那些孩子们都进来吧，别把他们拦在外面。因为在神国里，都是那样的人。——摘自《圣经》",[100,107,108],{},"依旧在现场。车里。用着超慢的无线网卡。等待。",[100,110,111],{},"仔细把上篇文章的留言读个遍，又想写点什么，给你们。",[100,113,114],{},"此时此刻，大部分的你们已经安睡，我想。可我在惦念，在为你们祈福。望这个夜有我的思念可使你们获得次深眠。",[100,116,117],{},"  你们说幸运是拥有我，其实能有你们这样说才是我的大幸！",[100,119,120],{},"每篇博文后的留言我都会仔细阅读，这样的互动让我受益良多，更能让我感受到自己存在的价值。我知道我曾在你的心里驻足，哪怕只是片刻……感动。",[100,122,123],{},"喜欢你们叫我橙子。更喜欢“橙汁”！因为没有汁液，橙子就是皮球。我不要做皮球。",[100,125,126],{},"尤其是看到“老芝麻”的一个留言，更是感动。",[100,128,129],{},"过了这么久，看到你还在，真好！谁说过会见证一世？谁愿意再和我拉钩？我从来就没有离开，因为我本来就是你们！那些名字…………那些面孔…………此刻，你们就在我的面前！一个一个那么生动……",[100,131,132],{},"睡吧，孩子们……我信善良如你定会有爱的眷顾，神的庇佑……",[100,134,135],{},"    记得，相守。感谢，拥有。",{"title":137,"searchDepth":138,"depth":138,"links":139},"",2,[],[6],"你们说幸运是拥有我，其实能有你们这样说才是我的大幸！","md",{"date":144},"2008-07-07 01:44",true,"\u002Fblog\u002Fblog_4af9831b01009wk7",{"title":95,"description":141},"blog_4af9831b01009wk7","blog\u002Fblog_4af9831b01009wk7",[151],"杂谈","aNGC9ixwA9ufhHLc1e4ov3Y2nbnsqtTjPGnJ_7zExTs",[154,159],{"title":155,"path":156,"stem":157,"children":-1,"slug":158},"注定","\u002Fblog\u002Fblog_4af9831b01009v9r","blog\u002Fblog_4af9831b01009v9r","blog_4af9831b01009v9r",{"title":160,"path":161,"stem":162,"children":-1,"slug":163},"写真：水泥森林里的刚毅柔情","\u002Fblog\u002Fblog_4af9831b01009zgq","blog\u002Fblog_4af9831b01009zgq","blog_4af9831b01009zgq",1795162025844]
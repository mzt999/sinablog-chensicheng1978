[{"data":1,"prerenderedAt":161},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":73,"blog-post-slug-blog_4af9831b01009wk7":90,"surround-blog_4af9831b01009wk7":150},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":48,"navLinks":49,"perPage":16,"prevNextIsExcludeDate":69,"site_description":23,"site_name":70,"stem":71,"__hash__":72},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43,45],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{"href":46,"text":47},"https:\u002F\u002Fmzt999.github.io\u002Fportfolio-chensicheng1978","幕后作品集展示(2012-2026)",{},[50,55,59,63,67],{"path":51,"title":52,"target":53,"fa_class":54},"\u002F","博客首页","internal","fa-home",{"path":56,"title":57,"target":53,"fa_class":58},"\u002Fabout","关于","fa-user",{"path":60,"title":61,"target":53,"fa_class":62},"\u002Fpost","归档","fa-archive",{"path":64,"title":65,"target":53,"fa_class":66},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":68,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","LA_7Y82F2zjQ6-R2_tcWHl356krYL76uqQHBCIU8UZk",{"latestBlog":74},[75,78,81,84,87],{"title":76,"slug":77},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":79,"slug":80},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":82,"slug":83},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":85,"slug":86},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":88,"slug":89},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":91,"title":92,"body":93,"categories":137,"description":138,"extension":139,"meta":140,"navigation":142,"path":143,"seo":144,"slug":145,"stem":146,"tags":147,"__hash__":149},"blog\u002Fblog\u002Fblog_4af9831b01009wk7.md","橙汁",{"type":94,"value":95,"toc":133},"minimark",[96,103,106,109,112,115,118,121,124,127,130],[97,98,99],"p",{},[100,101,102],"em",{},"让那些孩子们都进来吧，别把他们拦在外面。因为在神国里，都是那样的人。——摘自《圣经》",[97,104,105],{},"依旧在现场。车里。用着超慢的无线网卡。等待。",[97,107,108],{},"仔细把上篇文章的留言读个遍，又想写点什么，给你们。",[97,110,111],{},"此时此刻，大部分的你们已经安睡，我想。可我在惦念，在为你们祈福。望这个夜有我的思念可使你们获得次深眠。",[97,113,114],{},"  你们说幸运是拥有我，其实能有你们这样说才是我的大幸！",[97,116,117],{},"每篇博文后的留言我都会仔细阅读，这样的互动让我受益良多，更能让我感受到自己存在的价值。我知道我曾在你的心里驻足，哪怕只是片刻……感动。",[97,119,120],{},"喜欢你们叫我橙子。更喜欢“橙汁”！因为没有汁液，橙子就是皮球。我不要做皮球。",[97,122,123],{},"尤其是看到“老芝麻”的一个留言，更是感动。",[97,125,126],{},"过了这么久，看到你还在，真好！谁说过会见证一世？谁愿意再和我拉钩？我从来就没有离开，因为我本来就是你们！那些名字…………那些面孔…………此刻，你们就在我的面前！一个一个那么生动……",[97,128,129],{},"睡吧，孩子们……我信善良如你定会有爱的眷顾，神的庇佑……",[97,131,132],{},"    记得，相守。感谢，拥有。",{"title":134,"searchDepth":135,"depth":135,"links":136},"",2,[],[6],"你们说幸运是拥有我，其实能有你们这样说才是我的大幸！","md",{"date":141},"2008-07-07 01:44",true,"\u002Fblog\u002Fblog_4af9831b01009wk7",{"title":92,"description":138},"blog_4af9831b01009wk7","blog\u002Fblog_4af9831b01009wk7",[148],"杂谈","aNGC9ixwA9ufhHLc1e4ov3Y2nbnsqtTjPGnJ_7zExTs",[151,156],{"title":152,"path":153,"stem":154,"children":-1,"slug":155},"注定","\u002Fblog\u002Fblog_4af9831b01009v9r","blog\u002Fblog_4af9831b01009v9r","blog_4af9831b01009v9r",{"title":157,"path":158,"stem":159,"children":-1,"slug":160},"写真：水泥森林里的刚毅柔情","\u002Fblog\u002Fblog_4af9831b01009zgq","blog\u002Fblog_4af9831b01009zgq","blog_4af9831b01009zgq",1794760532057]
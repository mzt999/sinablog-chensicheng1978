[{"data":1,"prerenderedAt":98},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b01009wk7":31,"surround-blog_4af9831b01009wk7":87},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",151,{"name":9,"len":10},"有图",34,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":75,"description":33,"extension":76,"meta":77,"navigation":79,"path":80,"seo":81,"slug":82,"stem":83,"tags":84,"__hash__":86},"blog\u002Fblog\u002Fblog_4af9831b01009wk7.md","橙汁",{"type":35,"value":36,"toc":71},"minimark",[37,41,44,47,50,53,56,59,62,65,68],[38,39,40],"p",{},"让那些孩子们都进来吧，别把他们拦在外面。因为在神国里，都是那样的人。\n——摘自《圣经》",[38,42,43],{},"依旧在现场。车里。用着超慢的无线网卡。等待。",[38,45,46],{},"仔细把上篇文章的留言读个遍，又想写点什么，给你们。",[38,48,49],{},"此时此刻，大部分的你们已经安睡，我想。可我在惦念，在为你们祈福。望这个夜有我的思念可使你们获得次深眠。",[38,51,52],{},"你们说幸运是拥有我，其实能有你们这样说才是我的大幸！",[38,54,55],{},"每篇博文后的留言我都会仔细阅读，这样的互动让我受益良多，更能让我感受到自己存在的价值。我知道我曾在你的心里驻足，哪怕只是片刻……感动。",[38,57,58],{},"喜欢你们叫我橙子。更喜欢“橙汁”！因为没有汁液，橙子就是皮球。我不要做皮球。",[38,60,61],{},"尤其是看到“老芝麻”的一个留言，更是感动。",[38,63,64],{},"过了这么久，看到你还在，真好！谁说过会见证一世？谁愿意再和我拉钩？我从来就没有离开，因为我本来就是你们！那些名字…………那些面孔…………此刻，你们就在我的面前！一个一个那么生动……",[38,66,67],{},"睡吧，孩子们……我信善良如你定会有爱的眷顾，神的庇佑……",[38,69,70],{},"　　记得，相守。感谢，拥有。",{"title":72,"searchDepth":73,"depth":73,"links":74},"",2,[],[6],"md",{"date":78},"2008-07-07 01:44",true,"\u002Fblog\u002Fblog_4af9831b01009wk7",{"title":33,"description":33},"blog_4af9831b01009wk7","blog\u002Fblog_4af9831b01009wk7",[85],"杂谈","R0DUYiyJhW4c1b-3m0KC6R0fCn94n7xuJ8EwSG9aS74",[88,93],{"title":89,"path":90,"stem":91,"children":-1,"slug":92},"注定","\u002Fblog\u002Fblog_4af9831b01009v9r","blog\u002Fblog_4af9831b01009v9r","blog_4af9831b01009v9r",{"title":94,"path":95,"stem":96,"children":-1,"slug":97},"写真：水泥森林里的刚毅柔情","\u002Fblog\u002Fblog_4af9831b01009zgq","blog\u002Fblog_4af9831b01009zgq","blog_4af9831b01009zgq",1793773697822]
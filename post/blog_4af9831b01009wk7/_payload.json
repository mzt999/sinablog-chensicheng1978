[{"data":1,"prerenderedAt":146},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":58,"blog-post-slug-blog_4af9831b01009wk7":75,"surround-blog_4af9831b01009wk7":135},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":54,"site_description":55,"stem":56,"__hash__":57},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo",20,"新浪博客内容备份","settings","hh8X7X6SFDoeJrxIJ4yisZXSc3HwHM1zk206jiQX2XU",{"latestBlog":59},[60,63,66,69,72],{"title":61,"slug":62},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":64,"slug":65},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":67,"slug":68},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":70,"slug":71},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":73,"slug":74},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":76,"title":77,"body":78,"categories":122,"description":123,"extension":124,"meta":125,"navigation":127,"path":128,"seo":129,"slug":130,"stem":131,"tags":132,"__hash__":134},"blog\u002Fblog\u002Fblog_4af9831b01009wk7.md","橙汁",{"type":79,"value":80,"toc":118},"minimark",[81,88,91,94,97,100,103,106,109,112,115],[82,83,84],"p",{},[85,86,87],"em",{},"让那些孩子们都进来吧，别把他们拦在外面。因为在神国里，都是那样的人。——摘自《圣经》",[82,89,90],{},"依旧在现场。车里。用着超慢的无线网卡。等待。",[82,92,93],{},"仔细把上篇文章的留言读个遍，又想写点什么，给你们。",[82,95,96],{},"此时此刻，大部分的你们已经安睡，我想。可我在惦念，在为你们祈福。望这个夜有我的思念可使你们获得次深眠。",[82,98,99],{},"  你们说幸运是拥有我，其实能有你们这样说才是我的大幸！",[82,101,102],{},"每篇博文后的留言我都会仔细阅读，这样的互动让我受益良多，更能让我感受到自己存在的价值。我知道我曾在你的心里驻足，哪怕只是片刻……感动。",[82,104,105],{},"喜欢你们叫我橙子。更喜欢“橙汁”！因为没有汁液，橙子就是皮球。我不要做皮球。",[82,107,108],{},"尤其是看到“老芝麻”的一个留言，更是感动。",[82,110,111],{},"过了这么久，看到你还在，真好！谁说过会见证一世？谁愿意再和我拉钩？我从来就没有离开，因为我本来就是你们！那些名字…………那些面孔…………此刻，你们就在我的面前！一个一个那么生动……",[82,113,114],{},"睡吧，孩子们……我信善良如你定会有爱的眷顾，神的庇佑……",[82,116,117],{},"    记得，相守。感谢，拥有。",{"title":119,"searchDepth":120,"depth":120,"links":121},"",2,[],[6],"你们说幸运是拥有我，其实能有你们这样说才是我的大幸！","md",{"date":126},"2008-07-07 01:44",true,"\u002Fblog\u002Fblog_4af9831b01009wk7",{"title":77,"description":123},"blog_4af9831b01009wk7","blog\u002Fblog_4af9831b01009wk7",[133],"杂谈","aNGC9ixwA9ufhHLc1e4ov3Y2nbnsqtTjPGnJ_7zExTs",[136,141],{"title":137,"path":138,"stem":139,"children":-1,"slug":140},"注定","\u002Fblog\u002Fblog_4af9831b01009v9r","blog\u002Fblog_4af9831b01009v9r","blog_4af9831b01009v9r",{"title":142,"path":143,"stem":144,"children":-1,"slug":145},"写真：水泥森林里的刚毅柔情","\u002Fblog\u002Fblog_4af9831b01009zgq","blog\u002Fblog_4af9831b01009zgq","blog_4af9831b01009zgq",1794412500678]
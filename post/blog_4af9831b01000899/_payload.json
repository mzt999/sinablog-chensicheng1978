[{"data":1,"prerenderedAt":88},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b01000899":31,"surround-blog_4af9831b01000899":77},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",152,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":66,"description":33,"extension":67,"meta":68,"navigation":70,"path":71,"seo":72,"slug":73,"stem":74,"tags":75,"__hash__":76},"blog\u002Fblog\u002Fblog_4af9831b01000899.md","zhuan tie",{"type":35,"value":36,"toc":62},"minimark",[37,41,44,47,50,53,56,59],[38,39,40],"p",{},"[匿名] 业余弗洛伊德",[38,42,43],{},"2007-04-26 16:35:40",[38,45,46],{},"哈哈，你的梦境好象小说〈士兵突击〉的开始和结束的那场演习啊，连行文风格都象。我来试着解一解吧，全当捧场。",[38,48,49],{},"你前一篇博客说，《士兵突击》《民工》《子弹》是为数不多让你感动的戏。",[38,51,52],{},"弗洛伊德在《梦的解析》中说，印象最深用心最多希望最大，又不好表达出来的，往往作为梦的背景出现。",[38,54,55],{},"“火车”是交通工具，它联接着理想和现实，双鱼座的人往往在理想和现实间挣扎，虚幻不能沉迷的过久，于是逃回北京，是一种强制的理性行动，带走的美女象征着虚幻世界是割舍不下的东西，在梦中具化为人。表哥很可能象征着你心中的不安。你很明确做任何事都要付出代价，这个代价不确定又如影随行。在梦中，这个“表哥”更有象征意义。他是谁呢？",[38,57,58],{},"再大胆推测一下，你的新戏中有没有“火车或火车站的场景”？近两个月你的压力是不是很大？",[38,60,61],{},"捧场完毕，不必当真啊，哈哈！！",{"title":63,"searchDepth":64,"depth":64,"links":65},"",2,[],[6],"md",{"date":69},"2007-04-27 22:47",true,"\u002Fblog\u002Fblog_4af9831b01000899",{"title":33,"description":33},"blog_4af9831b01000899","blog\u002Fblog_4af9831b01000899",[],"dU1isce8zIMmb_iFgEN_yf1m_Vc47gE0c4joI85JBkE",[78,83],{"title":79,"path":80,"stem":81,"children":-1,"slug":82},"爱上梦中人","\u002Fblog\u002Fblog_4af9831b0100088s","blog\u002Fblog_4af9831b0100088s","blog_4af9831b0100088s",{"title":84,"path":85,"stem":86,"children":-1,"slug":87},"也许,放弃调侃,夭折了念头,在了,","\u002Fblog\u002Fblog_4
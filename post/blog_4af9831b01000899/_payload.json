[{"data":1,"prerenderedAt":92},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":17,"blog-post-slug-blog_4af9831b01000899":34,"surround-blog_4af9831b01000899":81},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"latestBlog":18},[19,22,25,28,31],{"title":20,"slug":21},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":23,"slug":24},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":26,"slug":27},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":29,"slug":30},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":32,"slug":33},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":35,"title":36,"body":37,"categories":69,"description":70,"extension":71,"meta":72,"navigation":74,"path":75,"seo":76,"slug":77,"stem":78,"tags":79,"__hash__":80},"blog\u002Fblog\u002Fblog_4af9831b01000899.md","zhuan tie",{"type":38,"value":39,"toc":65},"minimark",[40,44,47,50,53,56,59,62],[41,42,43],"p",{},"[匿名] 业余弗洛伊德",[41,45,46],{},"2007-04-26 16:35:40",[41,48,49],{},"哈哈，你的梦境好象小说〈士兵突击〉的开始和结束的那场演习啊，连行文风格都象。我来试着解一解吧，全当捧场。",[41,51,52],{},"你前一篇博客说，《士兵突击》《民工》《子弹》是为数不多让你感动的戏。",[41,54,55],{},"弗洛伊德在《梦的解析》中说，印象最深用心最多希望最大，又不好表达出来的，往往作为梦的背景出现。",[41,57,58],{},"“火车”是交通工具，它联接着理想和现实，双鱼座的人往往在理想和现实间挣扎，虚幻不能沉迷的过久，于是逃回北京，是一种强制的理性行动，带走的美女象征着虚幻世界是割舍不下的东西，在梦中具化为人。表哥很可能象征着你心中的不安。你很明确做任何事都要付出代价，这个代价不确定又如影随行。在梦中，这个“表哥”更有象征意义。他是谁呢？",[41,60,61],{},"再大胆推测一下，你的新戏中有没有“火车或火车站的场景”？近两个月你的压力是不是很大？",[41,63,64],{},"捧场完毕，不必当真啊，哈哈！！",{"title":66,"searchDepth":67,"depth":67,"links":68},"",2,[],[6],"业余弗洛伊德留言","md",{"date":73},"2007-04-27 22:47",true,"\u002Fblog\u002Fblog_4af9831b01000899",{"title":36,"description":70},"blog_4af9831b01000899","blog\u002Fblog_4af9831b01000899",[],"d3ZR7OGNHEbpyQlUsSxfAs5Vyw7CO5003wyaFClOphs",[82,87],{"title":83,"path":84,"stem":85,"children":-1,"slug":86},"爱上梦中人","\u002Fblog\u002Fblog_4af9831b0100088s","blog\u002Fblog_4af9831b0100088s","blog_4af9831b0100088s",{"title":88,"path":89,"stem":90,"children":-1,"slug":91
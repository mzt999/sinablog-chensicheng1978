":89,"body":90,"categories":122,"description":123,"extension":124,"meta":125,"navigation":127,"path":128,"seo":129,"slug":130,"stem":131,"tags":132,"__hash__":133},"blog\u002Fblog\u002Fblog_4af9831b01000899.md","zhuan tie",{"type":91,"value":92,"toc":118},"minimark",[93,97,100,103,106,109,112,115],[94,95,96],"p",{},"[匿名] 业余弗洛伊德",[94,98,99],{},"2007-04-26 16:35:40",[94,101,102],{},"哈哈，你的梦境好象小说〈士兵突击〉的开始和结束的那场演习啊，连行文风格都象。我来试着解一解吧，全当捧场。",[94,104,105],{},"你前一篇博客说，《士兵突击》《民工》《子弹》是为数不多让你感动的戏。",[94,107,108],{},"弗洛伊德在《梦的解析》中说，印象最深用心最多希望最大，又不好表达出来的，往往作为梦的背景出现。",[94,110,111],{},"“火车”是交通工具，它联接着理想和现实，双鱼座的人往往在理想和现实间挣扎，虚幻不能沉迷的过久，于是逃回北京，是一种强制的理性行动，带走的美女象征着虚幻世界是割舍不下的东西，在梦中具化为人。表哥很可能象征着你心中的不安。你很明确做任何事都要付出代价，这个代价不确定又如影随行。在梦中，这个“表哥”更有象征意义。他是谁呢？",[94,113,114],{},"再大胆推测一下，你的新戏中有没有“火车或火车站的场景”？近两个月你的压力是不是很大？",[94,116,117],{},"捧场完毕，不必当真啊，哈哈！！",{"title":119,"searchDepth":120,"depth":120,"links":121},"",2,[],[6],"业余弗洛伊德留言","md",{"date":126},"2007-04-27 22:47",true,"\u002Fblog\u002Fblog_4af9831b01000899",{"title":89,"description":123},"blog_4af9831b01000899","blog\u002Fblog_4af9831b01000899",[],"d3ZR7OGNHEbpyQlUsSxfAs5Vyw7CO5003wyaFClOphs",[135,140],{"title":136,"path":137,"stem":138,"children":-1,"slug":139},"爱上梦中人","\u002Fblog\u002Fblog_4af9831b0100088s","blog\u002Fblog_4af9831b0100088s","blog_4af9831b0100088s",{"title":141,"path":142,"stem":143,"children":-1,"slug":144},"也许,放弃调侃,夭折了念头,在了,","\u002Fblog\u002Fblog_4af9831b0100089a","blog\u002Fblog_4af9831b0100089a","blog_4af9831b0100089a",1794546770514]
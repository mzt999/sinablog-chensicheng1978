[{"data":1,"prerenderedAt":130},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":76,"blog-post-slug-blog_4af9831b01009v9r":93,"surround-blog_4af9831b01009v9r":119},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":38,"meta":50,"navLinks":51,"perPage":16,"prevNextIsExcludeDate":71,"site_description":72,"site_name":73,"stem":74,"__hash__":75},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,26,32],{"text":23},"粉丝自制非官方站点｜素材版权归原权利人所有",{"text":25},"仅兴趣交流、无商业用途｜如有侵权请联系删除",{"text":27,"link":28},"查看",{"href":29,"text":30,"fa_class":31},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":33,"link":34},"如有任何疑问，欢迎",{"href":35,"text":36,"fa_class":37},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[39,42,45,47],{"href":40,"text":41},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":43,"text":44},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":46},"新浪微博备份(2009-2026)",{"href":48,"text":49},"https:\u002F\u002Fmzt999.github.io\u002Fportfolio-chensicheng1978","幕后作品集展示(2012-2026)",{},[52,57,61,65,69],{"path":53,"title":54,"target":55,"fa_class":56},"\u002F","博客首页","internal","fa-home",{"path":58,"title":59,"target":55,"fa_class":60},"\u002Fabout","关于","fa-user",{"path":62,"title":63,"target":55,"fa_class":64},"\u002Fpost","归档","fa-archive",{"path":66,"title":67,"target":55,"fa_class":68},"\u002Fgallery","相册","fa-image",{"path":29,"title":30,"target":70,"fa_class":31},"otherSite",false,"新浪博客内容备份(粉丝自用)","陈思诚的博客","settings","5S7xKt0XLHpkjipbomx4I7pUu50Y7wqtD418LquZj5Q",{"latestBlog":77},[78,81,84,87,90],{"title":79,"slug":80},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":82,"slug":83},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":85,"slug":86},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":88,"slug":89},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":91,"slug":92},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":94,"title":95,"body":96,"categories":107,"description":95,"extension":108,"meta":109,"navigation":111,"path":112,"seo":113,"slug":114,"stem":115,"tags":116,"__hash__":118},"blog\u002Fblog\u002Fblog_4af9831b01009v9r.md","注定",{"type":97,"value":98,"toc":103},"minimark",[99],[100,101,102],"p",{},"在现场。这是我拍得最累的一部戏。主要是体力的透支和睡眠的不足！\n最近的一段时间，总如同在梦中行走。梦。\n四周都是浓雾。我在雾中疾走，仿佛有方向，又仿佛没有。那路仿佛是路，又仿佛不是……\n自己清楚为何会有这种感觉。因为，你离你的梦，如此近！\n决定存在于一个闪念！瞬间，便已是天地！如此近的时候就是那么远，远得仿佛隔世！远得这个梦只能在梦里空余一声微叹！\n今天，我得到。我觉得。\n感谢天赐的一个考验，让我重新自省，从心自省。自省的时候就是个涅磐。羽翼更丰厚的展翅！\n我信缘，这个你唯一不可不信的东西。所以，我开始安心等待。在认真做好当前的时候安心等待。\n于是，会有神对你审视。在这里，我们索性把一切未知都叫神。于是，便有了于是……\n于是，在某一个时刻。你会等到神迹于人形出现在你的时空，我们所能感知的三维，于是另一个考验开始……\n    另一个决定，左或右！     重要吗？\n    其实早有注定！其实你已经是个注定！\n其实，我只想说。\n是孽是缘，是好是坏，都只存在于我们的心中。我们自己便是那个你最该去认知，最该去理解甚至最该去崇拜的人！\n这样，也许，你便是你自己的快乐，你便是你自己的痛苦，你便是你自己的主宰，甚至，你便是你自己的…………\n    注定看得懂的人和注定看不懂的人们，注定你和这篇‘注定’是注定的……",{"title":104,"searchDepth":105,"depth":105,"links":106},"",2,[],[6],"md",{"date":110},"2008-07-03 09:53",true,"\u002Fblog\u002Fblog_4af9831b01009v9r",{"title":95,"description":95},"blog_4af9831b01009v9r","blog\u002Fblog_4af9831b01009v9r",[117],"杂谈","jsRDsKcrggNxTQXq4CazqsQwzdCWHmNPDHBG0HP2rpI",[120,125],{"title":121,"path":122,"stem":123,"children":-1,"slug":124},"女人","\u002Fblog\u002Fblog_4af9831b01009net","blog\u002Fblog_4af9831b01009net","blog_4af9831b01009net",{"title":126,"path":127,"stem":128,"children":-1,"slug":129},"橙汁","\u002Fblog\u002Fblog_4af9831b01009wk7","blog\u002Fblog_4af9831b01009wk7","blog_4af9831b01009wk7",1795162025849]
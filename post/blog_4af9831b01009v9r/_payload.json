[{"data":1,"prerenderedAt":124},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":70,"blog-post-slug-blog_4af9831b01009v9r":87,"surround-blog_4af9831b01009v9r":113},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":45,"navLinks":46,"perPage":16,"prevNextIsExcludeDate":66,"site_description":23,"site_name":67,"stem":68,"__hash__":69},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{},[47,52,56,60,64],{"path":48,"title":49,"target":50,"fa_class":51},"\u002F","博客首页","internal","fa-home",{"path":53,"title":54,"target":50,"fa_class":55},"\u002Fabout","关于","fa-user",{"path":57,"title":58,"target":50,"fa_class":59},"\u002Fpost","归档","fa-archive",{"path":61,"title":62,"target":50,"fa_class":63},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":65,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","jvZHccz2rT-wjVS5GCPgWyhl8WnBIvECPkE5KpKFKCU",{"latestBlog":71},[72,75,78,81,84],{"title":73,"slug":74},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":76,"slug":77},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":79,"slug":80},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":82,"slug":83},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":85,"slug":86},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":88,"title":89,"body":90,"categories":101,"description":89,"extension":102,"meta":103,"navigation":105,"path":106,"seo":107,"slug":108,"stem":109,"tags":110,"__hash__":112},"blog\u002Fblog\u002Fblog_4af9831b01009v9r.md","注定",{"type":91,"value":92,"toc":97},"minimark",[93],[94,95,96],"p",{},"在现场。这是我拍得最累的一部戏。主要是体力的透支和睡眠的不足！\n最近的一段时间，总如同在梦中行走。梦。\n四周都是浓雾。我在雾中疾走，仿佛有方向，又仿佛没有。那路仿佛是路，又仿佛不是……\n自己清楚为何会有这种感觉。因为，你离你的梦，如此近！\n决定存在于一个闪念！瞬间，便已是天地！如此近的时候就是那么远，远得仿佛隔世！远得这个梦只能在梦里空余一声微叹！\n今天，我得到。我觉得。\n感谢天赐的一个考验，让我重新自省，从心自省。自省的时候就是个涅磐。羽翼更丰厚的展翅！\n我信缘，这个你唯一不可不信的东西。所以，我开始安心等待。在认真做好当前的时候安心等待。\n于是，会有神对你审视。在这里，我们索性把一切未知都叫神。于是，便有了于是……\n于是，在某一个时刻。你会等到神迹于人形出现在你的时空，我们所能感知的三维，于是另一个考验开始……\n    另一个决定，左或右！     重要吗？\n    其实早有注定！其实你已经是个注定！\n其实，我只想说。\n是孽是缘，是好是坏，都只存在于我们的心中。我们自己便是那个你最该去认知，最该去理解甚至最该去崇拜的人！\n这样，也许，你便是你自己的快乐，你便是你自己的痛苦，你便是你自己的主宰，甚至，你便是你自己的…………\n    注定看得懂的人和注定看不懂的人们，注定你和这篇‘注定’是注定的……",{"title":98,"searchDepth":99,"depth":99,"links":100},"",2,[],[6],"md",{"date":104},"2008-07-03 09:53",true,"\u002Fblog\u002Fblog_4af9831b01009v9r",{"title":89,"description":89},"blog_4af9831b01009v9r","blog\u002Fblog_4af9831b01009v9r",[111],"杂谈","jsRDsKcrggNxTQXq4CazqsQwzdCWHmNPDHBG0HP2rpI",[114,119],{"title":115,"path":116,"stem":117,"children":-1,"slug":118},"女人","\u002Fblog\u002Fblog_4af9831b01009net","blog\u002Fblog_4af9831b01009net","blog_4af9831b01009net",{"title":120,"path":121,"stem":122,"children":-1,"slug":123},"橙汁","\u002Fblog\u002Fblog_4af9831b01009wk7","blog\u002Fblog_4af9831b01009wk7","blog_4af9831b01009wk7",1794544667677]
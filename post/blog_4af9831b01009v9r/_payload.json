[{"data":1,"prerenderedAt":112},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":58,"blog-post-slug-blog_4af9831b01009v9r":75,"surround-blog_4af9831b01009v9r":101},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":54,"site_description":55,"stem":56,"__hash__":57},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo",20,"新浪博客内容备份","settings","hh8X7X6SFDoeJrxIJ4yisZXSc3HwHM1zk206jiQX2XU",{"latestBlog":59},[60,63,66,69,72],{"title":61,"slug":62},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":64,"slug":65},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":67,"slug":68},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":70,"slug":71},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":73,"slug":74},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":76,"title":77,"body":78,"categories":89,"description":77,"extension":90,"meta":91,"navigation":93,"path":94,"seo":95,"slug":96,"stem":97,"tags":98,"__hash__":100},"blog\u002Fblog\u002Fblog_4af9831b01009v9r.md","注定",{"type":79,"value":80,"toc":85},"minimark",[81],[82,83,84],"p",{},"在现场。这是我拍得最累的一部戏。主要是体力的透支和睡眠的不足！\n最近的一段时间，总如同在梦中行走。梦。\n四周都是浓雾。我在雾中疾走，仿佛有方向，又仿佛没有。那路仿佛是路，又仿佛不是……\n自己清楚为何会有这种感觉。因为，你离你的梦，如此近！\n决定存在于一个闪念！瞬间，便已是天地！如此近的时候就是那么远，远得仿佛隔世！远得这个梦只能在梦里空余一声微叹！\n今天，我得到。我觉得。\n感谢天赐的一个考验，让我重新自省，从心自省。自省的时候就是个涅磐。羽翼更丰厚的展翅！\n我信缘，这个你唯一不可不信的东西。所以，我开始安心等待。在认真做好当前的时候安心等待。\n于是，会有神对你审视。在这里，我们索性把一切未知都叫神。于是，便有了于是……\n于是，在某一个时刻。你会等到神迹于人形出现在你的时空，我们所能感知的三维，于是另一个考验开始……\n    另一个决定，左或右！     重要吗？\n    其实早有注定！其实你已经是个注定！\n其实，我只想说。\n是孽是缘，是好是坏，都只存在于我们的心中。我们自己便是那个你最该去认知，最该去理解甚至最该去崇拜的人！\n这样，也许，你便是你自己的快乐，你便是你自己的痛苦，你便是你自己的主宰，甚至，你便是你自己的…………\n    注定看得懂的人和注定看不懂的人们，注定你和这篇‘注定’是注定的……",{"title":86,"searchDepth":87,"depth":87,"links":88},"",2,[],[6],"md",{"date":92},"2008-07-03 09:53",true,"\u002Fblog\u002Fblog_4af9831b01009v9r",{"title":77,"description":77},"blog_4af9831b01009v9r","blog\u002Fblog_4af9831b01009v9r",[99],"杂谈","jsRDsKcrggNxTQXq4CazqsQwzdCWHmNPDHBG0HP2rpI",[102,107],{"title":103,"path":104,"stem":105,"children":-1,"slug":106},"女人","\u002Fblog\u002Fblog_4af9831b01009net","blog\u002Fblog_4af9831b01009net","blog_4af9831b01009net",{"title":108,"path":109,"stem":110,"children":-1,"slug":111},"橙汁","\u002Fblog\u002Fblog_4af9831b01009wk7","blog\u002Fblog_4af9831b01009wk7","blog_4af9831b01009wk7",1794412500681]
[{"data":1,"prerenderedAt":71},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":17,"blog-post-slug-blog_4af9831b01009v9r":34,"surround-blog_4af9831b01009v9r":60},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"latestBlog":18},[19,22,25,28,31],{"title":20,"slug":21},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":23,"slug":24},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":26,"slug":27},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":29,"slug":30},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":32,"slug":33},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":35,"title":36,"body":37,"categories":48,"description":36,"extension":49,"meta":50,"navigation":52,"path":53,"seo":54,"slug":55,"stem":56,"tags":57,"__hash__":59},"blog\u002Fblog\u002Fblog_4af9831b01009v9r.md","注定",{"type":38,"value":39,"toc":44},"minimark",[40],[41,42,43],"p",{},"在现场。这是我拍得最累的一部戏。主要是体力的透支和睡眠的不足！\n最近的一段时间，总如同在梦中行走。梦。\n四周都是浓雾。我在雾中疾走，仿佛有方向，又仿佛没有。那路仿佛是路，又仿佛不是……\n自己清楚为何会有这种感觉。因为，你离你的梦，如此近！\n决定存在于一个闪念！瞬间，便已是天地！如此近的时候就是那么远，远得仿佛隔世！远得这个梦只能在梦里空余一声微叹！\n今天，我得到。我觉得。\n感谢天赐的一个考验，让我重新自省，从心自省。自省的时候就是个涅磐。羽翼更丰厚的展翅！\n我信缘，这个你唯一不可不信的东西。所以，我开始安心等待。在认真做好当前的时候安心等待。\n于是，会有神对你审视。在这里，我们索性把一切未知都叫神。于是，便有了于是……\n于是，在某一个时刻。你会等到神迹于人形出现在你的时空，我们所能感知的三维，于是另一个考验开始……\n    另一个决定，左或右！     重要吗？\n    其实早有注定！其实你已经是个注定！\n其实，我只想说。\n是孽是缘，是好是坏，都只存在于我们的心中。我们自己便是那个你最该去认知，最该去理解甚至最该去崇拜的人！\n这样，也许，你便是你自己的快乐，你便是你自己的痛苦，你便是你自己的主宰，甚至，你便是你自己的…………\n    注定看得懂的人和注定看不懂的人们，注定你和这篇‘注定’是注定的……",{"title":45,"searchDepth":46,"depth":46,"links":47},"",2,[],[6],"md",{"date":51},"2008-07-03 09:53",true,"\u002Fblog\u002Fblog_4af9831b01009v9r",{"title":36,"description":36},"blog_4af9831b01009v9r","blog\u002Fblog_4af9831b01009v9r",[58],"杂谈","jsRDsKcrggNxTQXq4CazqsQwzdCWHmNPDHBG0HP2rpI",[61,66],{"title":62,"path":63,"stem":64,"children":-1,"slug":65},"女人","\u002Fblog\u002Fblog_4af9831b01009net","blog\u002Fblog_4af9831b01009net","blog_4af9831b01009net",{"title":67,"path":68,"stem":69,"children":-1,"slug":70},"橙汁","\u002Fblog\u002Fblog_4af9831b01009wk7","blog\u002Fblog_4af9831b01009wk7","blog_4af9831b01009wk7",1794045953783]
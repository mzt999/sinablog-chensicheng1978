[{"data":1,"prerenderedAt":106},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b010006b2":31,"surround-blog_4af9831b010006b2":95},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",151,{"name":9,"len":10},"有图",34,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":84,"description":33,"extension":85,"meta":86,"navigation":88,"path":89,"seo":90,"slug":91,"stem":92,"tags":93,"__hash__":94},"blog\u002Fblog\u002Fblog_4af9831b010006b2.md","第四晚 心情",{"type":35,"value":36,"toc":80},"minimark",[37,51,59],[38,39,40,41,44,45,47,48,50],"p",{},"第四篇文章 让我想到还在上初中时的我的偶像",[42,43],"br",{},"\n郭富城 那时竭力模仿着他的一切我能为之模仿的东西 眼神 舞蹈",[42,46],{},"\n发型^^^^^^曾经在我最初的舞台上率领班里的几个文艺狂热份子翻版过他的",[42,49],{},"\n第四晚心情 从那时开始已经很享受台下的欢呼和尖叫了^^^^^^",[38,52,53,54,56,57],{},"今天有两件比较开心的事 一 我的狗 天下最帅的 皮特",[42,55],{},"\n终于有着落了 二 合约的事好象也开始明朗了",[42,58],{},[38,60,61,62,64,65,67,68,70,71,73,74,76,77,79],{},"奉俊浩的\"怪物\"没有超出我预想般精彩",[42,63],{},"\n和\"杀人的记忆\"相比还是逊色很多",[42,66],{},"\n但特技方面基本无懈可击  最让我感动的还是韩国民族的精神总会在不同的电影里闪现出来",[42,69],{},"\n国人真的要更加努力了 中国的精神到底是什么 难道永远停留在 跟风 模仿",[42,72],{},"\n翻版 复制中吗 靠 又开始忧国优民了 每个人都有毛病",[42,75],{},"\n可我最大的顽症却是总拿自己当 救世主",[42,78],{},"\n你说我是不是真的该喝水呛死自己呢",{"title":81,"searchDepth":82,"depth":82,"links":83},"",2,[],[6],"md",{"date":87},"2006-12-06 02:33",true,"\u002Fblog\u002Fblog_4af9831b010006b2",{"title":33,"description":33},"blog_4af9831b010006b2","blog\u002Fblog_4af9831b010006b2",[],"DJuJIM2IQq8LVzxYKJ4TwKDBQB3BcyEM5XWvLgtJkZ0",[96,101],{"title":97,"path":98,"stem":99,"children":-1,"slug":100},"想告别三心二意的岁月","\u002Fblog\u002Fblog_4af9831b0100068e","blog\u002Fblog_4af9831b0100068e","blog_4af9831b010006
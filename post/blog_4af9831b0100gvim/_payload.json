[{"data":1,"prerenderedAt":145},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":70,"blog-post-slug-blog_4af9831b0100gvim":87,"surround-blog_4af9831b0100gvim":134},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":45,"navLinks":46,"perPage":16,"prevNextIsExcludeDate":66,"site_description":23,"site_name":67,"stem":68,"__hash__":69},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{},[47,52,56,60,64],{"path":48,"title":49,"target":50,"fa_class":51},"\u002F","博客首页","internal","fa-home",{"path":53,"title":54,"target":50,"fa_class":55},"\u002Fabout","关于","fa-user",{"path":57,"title":58,"target":50,"fa_class":59},"\u002Fpost","归档","fa-archive",{"path":61,"title":62,"target":50,"fa_class":63},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":65,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","jvZHccz2rT-wjVS5GCPgWyhl8WnBIvECPkE5KpKFKCU",{"latestBlog":71},[72,75,78,81,84],{"title":73,"slug":74},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":76,"slug":77},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":79,"slug":80},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":82,"slug":83},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":85,"slug":86},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":88,"title":89,"body":90,"categories":122,"description":102,"extension":123,"meta":124,"navigation":126,"path":127,"seo":128,"slug":129,"stem":130,"tags":131,"__hash__":133},"blog\u002Fblog\u002Fblog_4af9831b0100gvim.md","李晨这个人",{"type":91,"value":92,"toc":118},"minimark",[93,97,100,103,106,109,112,115],[94,95,96],"p",{},"素来不关心娱乐新闻的我，对哥们的事也后知后觉。直到晨儿给我打了个电话。",[94,98,99],{},"外界一定众说纷纭，其实真没什么说的，演员就是人。人都吃五谷杂粮都有七情六欲，是人都他妈会愤怒！！",[94,101,102],{},"我相信晨儿，且一定力挺！全力挺！！",[94,104,105],{},"和晨儿相识于“士兵”，我们是最有的聊的两个人。渐渐，我开始了解他，这个我看着他演戏长大且比我小几个月的兄弟！",[94,107,108],{},"他一路走到今天不容易，很多人以为演员表面风风光光其实背后艰辛冷暖自知！真的，尤其是他！现在仍然不容易！",[94,110,111],{},"从“简宁”时的风光，一直到多年无戏可拍的蛰伏，再到现在的再次走到大家眼前……他的坚持隐忍和苦难我感受得到！这世道，真不是谁跌倒都能再爬得起来的！请大家爱护他，真的，爬起来不容易！",[94,113,114],{},"晨儿是个善良的孩子！是我的好兄弟，我相信在他周围的人都会这么说！“士兵”的其他兄弟也会说同样的话！",[94,116,117],{},"帮忙？咱要什么给什么！要钱给钱！要人给人！——电话这头，我说的！",{"title":119,"searchDepth":120,"depth":120,"links":121},"",2,[],[6],"md",{"date":125},"2010-01-29 23:06",true,"\u002Fblog\u002Fblog_4af9831b0100gvim",{"title":89,"description":102},"blog_4af9831b0100gvim","blog\u002Fblog_4af9831b0100gvim",[132],"杂谈","F2NuGKG__1L3TDuz_ybnul_EC6W6uv0181at74mXR-I",[135,140],{"title":136,"path":137,"stem":138,"children":-1,"slug":139},"人面桃花《大丫鬟》MV","\u002Fblog\u002Fblog_4af9831b0100gpvi","blog\u002Fblog_4af9831b0100gpvi","blog_4af9831b0100gpvi",{"title":141,"path":142,"stem":143,"children":-1,"slug":144},"仰视天堂","\u002Fblog\u002Fblog_4af9831b0100h0o9","blog\u002Fblog_4af9831b0100h0o9","blog_4af9831b0100h0o9",1794546769508]
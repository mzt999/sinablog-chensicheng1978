[{"data":1,"prerenderedAt":89},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b0100gvim":31,"surround-blog_4af9831b0100gvim":78},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",152,{"name":9,"len":10},"有图",34,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":66,"description":33,"extension":67,"meta":68,"navigation":70,"path":71,"seo":72,"slug":73,"stem":74,"tags":75,"__hash__":77},"blog\u002Fblog\u002Fblog_4af9831b0100gvim.md","李晨这个人",{"type":35,"value":36,"toc":62},"minimark",[37,41,44,47,50,53,56,59],[38,39,40],"p",{},"素来不关心娱乐新闻的我，对哥们的事也后知后觉。直到晨儿给我打了个电话。",[38,42,43],{},"外界一定众说纷纭，其实真没什么说的，演员就是人。人都吃五谷杂粮都有七情六欲，是人都他妈会愤怒！！",[38,45,46],{},"我相信晨儿，且一定力挺！全力挺！！",[38,48,49],{},"和晨儿相识于“士兵”，我们是最有的聊的两个人。渐渐，我开始了解他，这个我看着他演戏长大且比我小几个月的兄弟！",[38,51,52],{},"他一路走到今天不容易，很多人以为演员表面风风光光其实背后艰辛冷暖自知！真的，尤其是他！现在仍然不容易！",[38,54,55],{},"从“简宁”时的风光，一直到多年无戏可拍的蛰伏，再到现在的再次走到大家眼前……他的坚持隐忍和苦难我感受得到！这世道，真不是谁跌倒都能再爬得起来的！请大家爱护他，真的，爬起来不容易！",[38,57,58],{},"晨儿是个善良的孩子！是我的好兄弟，我相信在他周围的人都会这么说！“士兵”的其他兄弟也会说同样的话！",[38,60,61],{},"帮忙？咱要什么给什么！要钱给钱！要人给人！——电话这头，我说的！",{"title":63,"searchDepth":64,"depth":64,"links":65},"",2,[],[6],"md",{"date":69},"2010-01-29 23:06",true,"\u002Fblog\u002Fblog_4af9831b0100gvim",{"title":33,"description":33},"blog_4af9831b0100gvim","blog\u002Fblog_4af9831b0100gvim",[76],"杂谈","q0Ec0zMI6rA6moQBDA03XK20_UlK5Q-T8S2BqHBV8RM",[79,84],{"title":80,"path":81,"stem":82,"children":-1,"slug":83},"人面桃花《大丫鬟》MV","\u002Fblog\u002Fblog_4af9831b0100gpvi","blog\u002Fblog_4af9831b0100gpvi","blog_4af9831b0100gpvi",{"title":85,"path":86,"stem":87,"children":-1,"slug":88},"仰视天堂","\u002Fblog\u002Fblog_4af9831b0
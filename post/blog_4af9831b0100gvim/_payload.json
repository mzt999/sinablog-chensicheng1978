[{"data":1,"prerenderedAt":132},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":57,"blog-post-slug-blog_4af9831b0100gvim":74,"surround-blog_4af9831b0100gvim":121},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":16,"site_description":54,"stem":55,"__hash__":56},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo","新浪博客内容备份(粉丝自用)","settings","jPD1QWrYwbaIixg6lntppEYe-T3ZGd3EJZxFBkbKY9E",{"latestBlog":58},[59,62,65,68,71],{"title":60,"slug":61},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":63,"slug":64},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":66,"slug":67},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":69,"slug":70},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":72,"slug":73},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":75,"title":76,"body":77,"categories":109,"description":89,"extension":110,"meta":111,"navigation":113,"path":114,"seo":115,"slug":116,"stem":117,"tags":118,"__hash__":120},"blog\u002Fblog\u002Fblog_4af9831b0100gvim.md","李晨这个人",{"type":78,"value":79,"toc":105},"minimark",[80,84,87,90,93,96,99,102],[81,82,83],"p",{},"素来不关心娱乐新闻的我，对哥们的事也后知后觉。直到晨儿给我打了个电话。",[81,85,86],{},"外界一定众说纷纭，其实真没什么说的，演员就是人。人都吃五谷杂粮都有七情六欲，是人都他妈会愤怒！！",[81,88,89],{},"我相信晨儿，且一定力挺！全力挺！！",[81,91,92],{},"和晨儿相识于“士兵”，我们是最有的聊的两个人。渐渐，我开始了解他，这个我看着他演戏长大且比我小几个月的兄弟！",[81,94,95],{},"他一路走到今天不容易，很多人以为演员表面风风光光其实背后艰辛冷暖自知！真的，尤其是他！现在仍然不容易！",[81,97,98],{},"从“简宁”时的风光，一直到多年无戏可拍的蛰伏，再到现在的再次走到大家眼前……他的坚持隐忍和苦难我感受得到！这世道，真不是谁跌倒都能再爬得起来的！请大家爱护他，真的，爬起来不容易！",[81,100,101],{},"晨儿是个善良的孩子！是我的好兄弟，我相信在他周围的人都会这么说！“士兵”的其他兄弟也会说同样的话！",[81,103,104],{},"帮忙？咱要什么给什么！要钱给钱！要人给人！——电话这头，我说的！",{"title":106,"searchDepth":107,"depth":107,"links":108},"",2,[],[6],"md",{"date":112},"2010-01-29 23:06",true,"\u002Fblog\u002Fblog_4af9831b0100gvim",{"title":76,"description":89},"blog_4af9831b0100gvim","blog\u002Fblog_4af9831b0100gvim",[119],"杂谈","F2NuGKG__1L3TDuz_ybnul_EC6W6uv0181at74mXR-I",[122,127],{"title":123,"path":124,"stem":125,"children":-1,"slug":126},"人面桃花《大丫鬟》MV","\u002Fblog\u002Fblog_4af9831b0100gpvi","blog\u002Fblog_4af9831b0100gpvi","blog_4af9831b0100gpvi",{"title":128,"path":129,"stem":130,"children":-1,"slug":131},"仰视天堂","\u002Fblog\u002Fblog_4af9831b0100h0o9","blog\u002Fblog_4af9831b0100h0o9","blog_4af9831b0100h0o9",1794473705128]
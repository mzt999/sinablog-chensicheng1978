[{"data":1,"prerenderedAt":92},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":17,"blog-post-slug-blog_4af9831b0100gvim":34,"surround-blog_4af9831b0100gvim":81},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"latestBlog":18},[19,22,25,28,31],{"title":20,"slug":21},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":23,"slug":24},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":26,"slug":27},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":29,"slug":30},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":32,"slug":33},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":35,"title":36,"body":37,"categories":69,"description":49,"extension":70,"meta":71,"navigation":73,"path":74,"seo":75,"slug":76,"stem":77,"tags":78,"__hash__":80},"blog\u002Fblog\u002Fblog_4af9831b0100gvim.md","李晨这个人",{"type":38,"value":39,"toc":65},"minimark",[40,44,47,50,53,56,59,62],[41,42,43],"p",{},"素来不关心娱乐新闻的我，对哥们的事也后知后觉。直到晨儿给我打了个电话。",[41,45,46],{},"外界一定众说纷纭，其实真没什么说的，演员就是人。人都吃五谷杂粮都有七情六欲，是人都他妈会愤怒！！",[41,48,49],{},"我相信晨儿，且一定力挺！全力挺！！",[41,51,52],{},"和晨儿相识于“士兵”，我们是最有的聊的两个人。渐渐，我开始了解他，这个我看着他演戏长大且比我小几个月的兄弟！",[41,54,55],{},"他一路走到今天不容易，很多人以为演员表面风风光光其实背后艰辛冷暖自知！真的，尤其是他！现在仍然不容易！",[41,57,58],{},"从“简宁”时的风光，一直到多年无戏可拍的蛰伏，再到现在的再次走到大家眼前……他的坚持隐忍和苦难我感受得到！这世道，真不是谁跌倒都能再爬得起来的！请大家爱护他，真的，爬起来不容易！",[41,60,61],{},"晨儿是个善良的孩子！是我的好兄弟，我相信在他周围的人都会这么说！“士兵”的其他兄弟也会说同样的话！",[41,63,64],{},"帮忙？咱要什么给什么！要钱给钱！要人给人！——电话这头，我说的！",{"title":66,"searchDepth":67,"depth":67,"links":68},"",2,[],[6],"md",{"date":72},"2010-01-29 23:06",true,"\u002Fblog\u002Fblog_4af9831b0100gvim",{"title":36,"description":49},"blog_4af9831b0100gvim","blog\u002Fblog_4af9831b0100gvim",[79],"杂谈","F2NuGKG__1L3TDuz_ybnul_EC6W6uv0181at74mXR-I",[82,87],{"title":83,"path":84,"stem":85,"children":-1,"slug":86},"人面桃花《大丫鬟》MV","\u002Fblog\u002Fblog_4af9831b0100gpvi","blog\u002Fblog_4af9831b0100gpvi","blog_4af9831b0100gpvi",{"title":88,"path":89,"stem":90,"children":-1,"slug":91},"仰视天堂","\u002Fblog\u002Fblog_4af9831b0100h0o9","blog\u002Fblog_4af9831b0100h0o9","blog_4af9831b0100h0o9",1794049413142]
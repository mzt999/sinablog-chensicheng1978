[{"data":1,"prerenderedAt":164},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":17,"blog-post-slug-blog_4af9831b01000bok":34,"surround-blog_4af9831b01000bok":153},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"latestBlog":18},[19,22,25,28,31],{"title":20,"slug":21},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":23,"slug":24},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":26,"slug":27},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":29,"slug":30},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":32,"slug":33},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":35,"title":36,"body":37,"categories":137,"description":138,"extension":139,"meta":140,"navigation":142,"path":143,"seo":144,"slug":145,"stem":146,"tags":147,"__hash__":152},"blog\u002Fblog\u002Fblog_4af9831b01000bok.md","星梦奇缘",{"type":38,"value":39,"toc":133},"minimark",[40,49,55,61,67,73,76,81,84,87,90,93,96,99,102,105,108,111,114,117,122,125,130],[41,42,43],"p",{},[44,45],"a",{"href":46,"rel":47},"http:\u002F\u002Falbum.sina.com.cn\u002Fpic\u002F4af9831b43f6b3205b514",[48],"nofollow",[41,50,51],{},[44,52],{"href":53,"rel":54},"http:\u002F\u002Falbum.sina.com.cn\u002Fpic\u002F4af9831b43f6b32178b62",[48],[41,56,57],{},[44,58],{"href":59,"rel":60},"http:\u002F\u002Falbum.sina.com.cn\u002Fpic\u002F4af9831b43f6b322500f6",[48],[41,62,63],{},[44,64],{"href":65,"rel":66},"http:\u002F\u002Falbum.sina.com.cn\u002Fpic\u002F4af9831b43f6b43ee7f32",[48],[41,68,69],{},[70,71],"img",{"alt":36,"src":72},"\u002Fpic\u002F4af9831b43f6b31fef70d.jpg",[41,74,75],{},"在烟花浪漫的夜晚...我对你倍加的思念......",[41,77,78],{},[70,79],{"alt":36,"src":80},"\u002Fpic\u002F4af9831b43f6b43ee7f32.jpg",[41,82,83],{},"这个银...就是传说中的幕后黑手...4哥...",[41,85,86],{},"“星梦奇缘”——喜欢这个名字。因为，浪漫。",[41,88,89],{},"缘，妙不可言。世间万事万物皆能用一“缘”字解释个通透。你们与那些角色是缘，我与那些角色也是缘，我与你们更是缘……",[41,91,92],{},"终于爱上了演员这个职业。在今年。希望还不晚，应该还不晚。",[41,94,95],{},"从前的我抵触，觉得“被选择”不男人，“主动”才王者。所以我徘徊，忧郁，浮沉……",[41,97,98],{},"年初的一部戏，让我真正沦陷。那故事那爱情炙热得眩目，又残酷得血肉模糊。但那完整那纯粹那干净和我的理想勾芡的严丝合缝几乎没半点瑕疵。于是，我爱上了那故事，爱上了那剧中人……“成才”让我成长，这角色却更让我成熟。",[41,100,101],{},"经历后，我才算明白了点这个职业，明白了这个职业需要的坚信，艰辛，坚持，坚守……",[41,103,104],{},"我们是用自己塑造，全部的自己。这全部包括肉身，心灵和情感，你所有的全部，全部的全部。所以我们很难有自己，所以我们很容易被裹挟，所以我们才脆弱，易碎，矛盾，游移，情绪，任性，敏感，多疑，自律且自渎，自曝且自闭……我们唯一的工作是进步，唯一的进步是丰富，唯一的丰富是自己，唯一的自己是使命……",[41,106,107],{},"不断的自我认知，自我完善才是这个职业也或是这个人生的合理解读吧……明白后，便不再困惑，便更清了方向，更充沛了步伐……",[41,109,110],{},"接下来就遇到了你们，梦中的那部分……幸福来的促不及防，甚至如暴发户般的奢侈。放心，我们会珍惜，不会挥“金”如土！因为我们是“步兵”！是一步一步走出来的兵！就如帖吧里的一位朋友说：“五班——曾经成才口中那班长的坟墓",[41,112,113],{},"孬兵的天堂，却真正的才是成才的福地……”愿所有“士兵”的战友们，都早日找到各自的“五班”。因为7连好，老A易，5班才是我们对自我认知和成长的绝地……",[41,115,116],{},"“星梦奇缘”30年，祝愿大家从这一刻开始，真正迎来属于自己的30年……",[41,118,119],{},[70,120],{"alt":36,"src":121},"\u002Fpic\u002F4af9831b43f6b32178b62.jpg",[41,123,124],{},"两个说相声的……望30年后，依旧能如此“四目相对”“笑靥入花”……",[41,126,127],{},[70,128],{"alt":36,"src":129},"\u002Fpic\u002F4af9831b43f6b322500f6.jpg",[41,131,132],{},"“星梦”全家福……",{"title":134,"searchDepth":135,"depth":135,"links":136},"",2,[],[6,9],"终于爱上了演员这个职业。","md",{"date":141},"2007-11-21 14:02",true,"\u002Fblog\u002Fblog_4af9831b01000bok",{"title":36,"description":138},"blog_4af9831b01000bok","blog\u002Fblog_4af9831b01000bok",[148,149,150,151],"随笔\u002F感悟","士兵突击","星梦奇缘30年","新浪博客","PxaJOJ6ZD9ky0sk7a8I1bQ5Vm_EZyvmF5JLFDXg_V2Y",[154,159],{"title":155,"path":156,"stem":157,"children":-1,"slug":158},"勇往直前","\u002Fblog\u002Fblog_4af9831b01000bn0","blog\u002Fblog_4af9831b01000bn0","blog_4af9831b01000bn0",{"title":160,"path":161,"stem":162,"children":-1,"slug":163},"实话实说?","\u002Fblog\u002Fblog_4af9831b01000bs5","blog\u002Fblog_4af9831b01000bs5","blog_4af9831b01000bs5",1794397912917]
[{"data":1,"prerenderedAt":205},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":58,"blog-post-slug-blog_4af9831b01000bok":75,"surround-blog_4af9831b01000bok":194},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":54,"site_description":55,"stem":56,"__hash__":57},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo",20,"新浪博客内容备份","settings","hh8X7X6SFDoeJrxIJ4yisZXSc3HwHM1zk206jiQX2XU",{"latestBlog":59},[60,63,66,69,72],{"title":61,"slug":62},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":64,"slug":65},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":67,"slug":68},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":70,"slug":71},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":73,"slug":74},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":76,"title":77,"body":78,"categories":178,"description":179,"extension":180,"meta":181,"navigation":183,"path":184,"seo":185,"slug":186,"stem":187,"tags":188,"__hash__":193},"blog\u002Fblog\u002Fblog_4af9831b01000bok.md","星梦奇缘",{"type":79,"value":80,"toc":174},"minimark",[81,90,96,102,108,114,117,122,125,128,131,134,137,140,143,146,149,152,155,158,163,166,171],[82,83,84],"p",{},[85,86],"a",{"href":87,"rel":88},"http:\u002F\u002Falbum.sina.com.cn\u002Fpic\u002F4af9831b43f6b3205b514",[89],"nofollow",[82,91,92],{},[85,93],{"href":94,"rel":95},"http:\u002F\u002Falbum.sina.com.cn\u002Fpic\u002F4af9831b43f6b32178b62",[89],[82,97,98],{},[85,99],{"href":100,"rel":101},"http:\u002F\u002Falbum.sina.com.cn\u002Fpic\u002F4af9831b43f6b322500f6",[89],[82,103,104],{},[85,105],{"href":106,"rel":107},"http:\u002F\u002Falbum.sina.com.cn\u002Fpic\u002F4af9831b43f6b43ee7f32",[89],[82,109,110],{},[111,112],"img",{"alt":77,"src":113},"\u002Fpic\u002F4af9831b43f6b31fef70d.jpg",[82,115,116],{},"在烟花浪漫的夜晚...我对你倍加的思念......",[82,118,119],{},[111,120],{"alt":77,"src":121},"\u002Fpic\u002F4af9831b43f6b43ee7f32.jpg",[82,123,124],{},"这个银...就是传说中的幕后黑手...4哥...",[82,126,127],{},"“星梦奇缘”——喜欢这个名字。因为，浪漫。",[82,129,130],{},"缘，妙不可言。世间万事万物皆能用一“缘”字解释个通透。你们与那些角色是缘，我与那些角色也是缘，我与你们更是缘……",[82,132,133],{},"终于爱上了演员这个职业。在今年。希望还不晚，应该还不晚。",[82,135,136],{},"从前的我抵触，觉得“被选择”不男人，“主动”才王者。所以我徘徊，忧郁，浮沉……",[82,138,139],{},"年初的一部戏，让我真正沦陷。那故事那爱情炙热得眩目，又残酷得血肉模糊。但那完整那纯粹那干净和我的理想勾芡的严丝合缝几乎没半点瑕疵。于是，我爱上了那故事，爱上了那剧中人……“成才”让我成长，这角色却更让我成熟。",[82,141,142],{},"经历后，我才算明白了点这个职业，明白了这个职业需要的坚信，艰辛，坚持，坚守……",[82,144,145],{},"我们是用自己塑造，全部的自己。这全部包括肉身，心灵和情感，你所有的全部，全部的全部。所以我们很难有自己，所以我们很容易被裹挟，所以我们才脆弱，易碎，矛盾，游移，情绪，任性，敏感，多疑，自律且自渎，自曝且自闭……我们唯一的工作是进步，唯一的进步是丰富，唯一的丰富是自己，唯一的自己是使命……",[82,147,148],{},"不断的自我认知，自我完善才是这个职业也或是这个人生的合理解读吧……明白后，便不再困惑，便更清了方向，更充沛了步伐……",[82,150,151],{},"接下来就遇到了你们，梦中的那部分……幸福来的促不及防，甚至如暴发户般的奢侈。放心，我们会珍惜，不会挥“金”如土！因为我们是“步兵”！是一步一步走出来的兵！就如帖吧里的一位朋友说：“五班——曾经成才口中那班长的坟墓",[82,153,154],{},"孬兵的天堂，却真正的才是成才的福地……”愿所有“士兵”的战友们，都早日找到各自的“五班”。因为7连好，老A易，5班才是我们对自我认知和成长的绝地……",[82,156,157],{},"“星梦奇缘”30年，祝愿大家从这一刻开始，真正迎来属于自己的30年……",[82,159,160],{},[111,161],{"alt":77,"src":162},"\u002Fpic\u002F4af9831b43f6b32178b62.jpg",[82,164,165],{},"两个说相声的……望30年后，依旧能如此“四目相对”“笑靥入花”……",[82,167,168],{},[111,169],{"alt":77,"src":170},"\u002Fpic\u002F4af9831b43f6b322500f6.jpg",[82,172,173],{},"“星梦”全家福……",{"title":175,"searchDepth":176,"depth":176,"links":177},"",2,[],[6,9],"终于爱上了演员这个职业。","md",{"date":182},"2007-11-21 14:02",true,"\u002Fblog\u002Fblog_4af9831b01000bok",{"title":77,"description":179},"blog_4af9831b01000bok","blog\u002Fblog_4af9831b01000bok",[189,190,191,192],"随笔\u002F感悟","士兵突击","星梦奇缘30年","新浪博客","PxaJOJ6ZD9ky0sk7a8I1bQ5Vm_EZyvmF5JLFDXg_V2Y",[195,200],{"title":196,"path":197,"stem":198,"children":-1,"slug":199},"勇往直前","\u002Fblog\u002Fblog_4af9831b01000bn0","blog\u002Fblog_4af9831b01000bn0","blog_4af9831b01000bn0",{"title":201,"path":202,"stem":203,"children":-1,"slug":204},"实话实说?","\u002Fblog\u002Fblog_4af9831b01000bs5","blog\u002Fblog_4af9831b01000bs5","blog_4af9831b01000bs5",1794412500847]
[{"data":1,"prerenderedAt":217},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":70,"blog-post-slug-blog_4af9831b01000bok":87,"surround-blog_4af9831b01000bok":206},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":45,"navLinks":46,"perPage":16,"prevNextIsExcludeDate":66,"site_description":23,"site_name":67,"stem":68,"__hash__":69},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{},[47,52,56,60,64],{"path":48,"title":49,"target":50,"fa_class":51},"\u002F","博客首页","internal","fa-home",{"path":53,"title":54,"target":50,"fa_class":55},"\u002Fabout","关于","fa-user",{"path":57,"title":58,"target":50,"fa_class":59},"\u002Fpost","归档","fa-archive",{"path":61,"title":62,"target":50,"fa_class":63},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":65,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","jvZHccz2rT-wjVS5GCPgWyhl8WnBIvECPkE5KpKFKCU",{"latestBlog":71},[72,75,78,81,84],{"title":73,"slug":74},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":76,"slug":77},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":79,"slug":80},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":82,"slug":83},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":85,"slug":86},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":88,"title":89,"body":90,"categories":190,"description":191,"extension":192,"meta":193,"navigation":195,"path":196,"seo":197,"slug":198,"stem":199,"tags":200,"__hash__":205},"blog\u002Fblog\u002Fblog_4af9831b01000bok.md","星梦奇缘",{"type":91,"value":92,"toc":186},"minimark",[93,102,108,114,120,126,129,134,137,140,143,146,149,152,155,158,161,164,167,170,175,178,183],[94,95,96],"p",{},[97,98],"a",{"href":99,"rel":100},"http:\u002F\u002Falbum.sina.com.cn\u002Fpic\u002F4af9831b43f6b3205b514",[101],"nofollow",[94,103,104],{},[97,105],{"href":106,"rel":107},"http:\u002F\u002Falbum.sina.com.cn\u002Fpic\u002F4af9831b43f6b32178b62",[101],[94,109,110],{},[97,111],{"href":112,"rel":113},"http:\u002F\u002Falbum.sina.com.cn\u002Fpic\u002F4af9831b43f6b322500f6",[101],[94,115,116],{},[97,117],{"href":118,"rel":119},"http:\u002F\u002Falbum.sina.com.cn\u002Fpic\u002F4af9831b43f6b43ee7f32",[101],[94,121,122],{},[123,124],"img",{"alt":89,"src":125},"\u002Fpic\u002F4af9831b43f6b31fef70d.jpg",[94,127,128],{},"在烟花浪漫的夜晚...我对你倍加的思念......",[94,130,131],{},[123,132],{"alt":89,"src":133},"\u002Fpic\u002F4af9831b43f6b43ee7f32.jpg",[94,135,136],{},"这个银...就是传说中的幕后黑手...4哥...",[94,138,139],{},"“星梦奇缘”——喜欢这个名字。因为，浪漫。",[94,141,142],{},"缘，妙不可言。世间万事万物皆能用一“缘”字解释个通透。你们与那些角色是缘，我与那些角色也是缘，我与你们更是缘……",[94,144,145],{},"终于爱上了演员这个职业。在今年。希望还不晚，应该还不晚。",[94,147,148],{},"从前的我抵触，觉得“被选择”不男人，“主动”才王者。所以我徘徊，忧郁，浮沉……",[94,150,151],{},"年初的一部戏，让我真正沦陷。那故事那爱情炙热得眩目，又残酷得血肉模糊。但那完整那纯粹那干净和我的理想勾芡的严丝合缝几乎没半点瑕疵。于是，我爱上了那故事，爱上了那剧中人……“成才”让我成长，这角色却更让我成熟。",[94,153,154],{},"经历后，我才算明白了点这个职业，明白了这个职业需要的坚信，艰辛，坚持，坚守……",[94,156,157],{},"我们是用自己塑造，全部的自己。这全部包括肉身，心灵和情感，你所有的全部，全部的全部。所以我们很难有自己，所以我们很容易被裹挟，所以我们才脆弱，易碎，矛盾，游移，情绪，任性，敏感，多疑，自律且自渎，自曝且自闭……我们唯一的工作是进步，唯一的进步是丰富，唯一的丰富是自己，唯一的自己是使命……",[94,159,160],{},"不断的自我认知，自我完善才是这个职业也或是这个人生的合理解读吧……明白后，便不再困惑，便更清了方向，更充沛了步伐……",[94,162,163],{},"接下来就遇到了你们，梦中的那部分……幸福来的促不及防，甚至如暴发户般的奢侈。放心，我们会珍惜，不会挥“金”如土！因为我们是“步兵”！是一步一步走出来的兵！就如帖吧里的一位朋友说：“五班——曾经成才口中那班长的坟墓",[94,165,166],{},"孬兵的天堂，却真正的才是成才的福地……”愿所有“士兵”的战友们，都早日找到各自的“五班”。因为7连好，老A易，5班才是我们对自我认知和成长的绝地……",[94,168,169],{},"“星梦奇缘”30年，祝愿大家从这一刻开始，真正迎来属于自己的30年……",[94,171,172],{},[123,173],{"alt":89,"src":174},"\u002Fpic\u002F4af9831b43f6b32178b62.jpg",[94,176,177],{},"两个说相声的……望30年后，依旧能如此“四目相对”“笑靥入花”……",[94,179,180],{},[123,181],{"alt":89,"src":182},"\u002Fpic\u002F4af9831b43f6b322500f6.jpg",[94,184,185],{},"“星梦”全家福……",{"title":187,"searchDepth":188,"depth":188,"links":189},"",2,[],[6,9],"终于爱上了演员这个职业。","md",{"date":194},"2007-11-21 14:02",true,"\u002Fblog\u002Fblog_4af9831b01000bok",{"title":89,"description":191},"blog_4af9831b01000bok","blog\u002Fblog_4af9831b01000bok",[201,202,203,204],"随笔\u002F感悟","士兵突击","星梦奇缘30年","新浪博客","PxaJOJ6ZD9ky0sk7a8I1bQ5Vm_EZyvmF5JLFDXg_V2Y",[207,212],{"title":208,"path":209,"stem":210,"children":-1,"slug":211},"勇往直前","\u002Fblog\u002Fblog_4af9831b01000bn0","blog\u002Fblog_4af9831b01000bn0","blog_4af9831b01000bn0",{"title":213,"path":214,"stem":215,"children":-1,"slug":216},"实话实说?","\u002Fblog\u002Fblog_4af9831b01000bs5","blog\u002Fblog_4af9831b01000bs5","blog_4af9831b01000bs5",1794544667809]
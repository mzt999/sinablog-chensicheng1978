[{"data":1,"prerenderedAt":160},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b01000bok":31,"surround-blog_4af9831b01000bok":149},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",152,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":134,"description":33,"extension":135,"meta":136,"navigation":138,"path":139,"seo":140,"slug":141,"stem":142,"tags":143,"__hash__":148},"blog\u002Fblog\u002Fblog_4af9831b01000bok.md","星梦奇缘",{"type":35,"value":36,"toc":130},"minimark",[37,46,52,58,64,70,73,78,81,84,87,90,93,96,99,102,105,108,111,114,119,122,127],[38,39,40],"p",{},[41,42],"a",{"href":43,"rel":44},"http:\u002F\u002Falbum.sina.com.cn\u002Fpic\u002F4af9831b43f6b3205b514",[45],"nofollow",[38,47,48],{},[41,49],{"href":50,"rel":51},"http:\u002F\u002Falbum.sina.com.cn\u002Fpic\u002F4af9831b43f6b32178b62",[45],[38,53,54],{},[41,55],{"href":56,"rel":57},"http:\u002F\u002Falbum.sina.com.cn\u002Fpic\u002F4af9831b43f6b322500f6",[45],[38,59,60],{},[41,61],{"href":62,"rel":63},"http:\u002F\u002Falbum.sina.com.cn\u002Fpic\u002F4af9831b43f6b43ee7f32",[45],[38,65,66],{},[67,68],"img",{"alt":33,"src":69},"\u002Fpic\u002F4af9831b43f6b31fef70d.jpg",[38,71,72],{},"在烟花浪漫的夜晚...我对你倍加的思念......",[38,74,75],{},[67,76],{"alt":33,"src":77},"\u002Fpic\u002F4af9831b43f6b43ee7f32.jpg",[38,79,80],{},"这个银...就是传说中的幕后黑手...4哥...",[38,82,83],{},"“星梦奇缘”——喜欢这个名字。因为，浪漫。",[38,85,86],{},"缘，妙不可言。世间万事万物皆能用一“缘”字解释个通透。你们与那些角色是缘，我与那些角色也是缘，我与你们更是缘……",[38,88,89],{},"终于爱上了演员这个职业。在今年。希望还不晚，应该还不晚。",[38,91,92],{},"从前的我抵触，觉得“被选择”不男人，“主动”才王者。所以我徘徊，忧郁，浮沉……",[38,94,95],{},"年初的一部戏，让我真正沦陷。那故事那爱情炙热得眩目，又残酷得血肉模糊。但那完整那纯粹那干净和我的理想勾芡的严丝合缝几乎没半点瑕疵。于是，我爱上了那故事，爱上了那剧中人……“成才”让我成长，这角色却更让我成熟。",[38,97,98],{},"经历后，我才算明白了点这个职业，明白了这个职业需要的坚信，艰辛，坚持，坚守……",[38,100,101],{},"我们是用自己塑造，全部的自己。这全部包括肉身，心灵和情感，你所有的全部，全部的全部。所以我们很难有自己，所以我们很容易被裹挟，所以我们才脆弱，易碎，矛盾，游移，情绪，任性，敏感，多疑，自律且自渎，自曝且自闭……我们唯一的工作是进步，唯一的进步是丰富，唯一的丰富是自己，唯一的自己是使命……",[38,103,104],{},"不断的自我认知，自我完善才是这个职业也或是这个人生的合理解读吧……明白后，便不再困惑，便更清了方向，更充沛了步伐……",[38,106,107],{},"接下来就遇到了你们，梦中的那部分……幸福来的促不及防，甚至如暴发户般的奢侈。放心，我们会珍惜，不会挥“金”如土！因为我们是“步兵”！是一步一步走出来的兵！就如帖吧里的一位朋友说：“五班——曾经成才口中那班长的坟墓",[38,109,110],{},"孬兵的天堂，却真正的才是成才的福地……”愿所有“士兵”的战友们，都早日找到各自的“五班”。因为7连好，老A易，5班才是我们对自我认知和成长的绝地……",[38,112,113],{},"“星梦奇缘”30年，祝愿大家从这一刻开始，真正迎来属于自己的30年……",[38,115,116],{},[67,117],{"alt":33,"src":118},"\u002Fpic\u002F4af9831b43f6b32178b62.jpg",[38,120,121],{},"两个说相声的……望30年后，依旧能如此“四目相对”“笑靥入花”……",[38,123,124],{},[67,125],{"alt":33,"src":126},"\u002Fpic\u002F4af9831b43f6b322500f6.jpg",[38,128,129],{},"“星梦”全家福……",{"title":131,"searchDepth":132,"depth":132,"links":133},"",2,[],[6,9],"md",{"date":137},"2007-11-21 14:02",true,"\u002Fblog\u002Fblog_4af9831b01000bok",{"title":33,"description":33},"blog_4af9831b01000bok","blog\u002Fblog_4af9831b01000bok",[144,145,146,147],"随笔\u002F感悟","士兵突击","星梦奇缘30年","新浪博客","UAwclt17iJIu2fvTFNFbQ-Lex5-8Jp0y6gJkt-zbi88",[150,155],{"title":151,"path":152,"stem":153,"children":-1,"slug":154},"勇往直前","\u002Fblog\u002Fblog_4af9831b01000bn0","blog\u002Fblog_4af9831b01000bn0","blog_4af9831b01000bn0",{"title":156,"path":157,"stem":158,"children":-1,"slug":159},"实话实说?","\u002Fblog\u002Fblog_4af9831b01000bs5","blog\u002Fblog_4af9831b01000bs5","blog_4af9831b01000bs5",1793977670322]
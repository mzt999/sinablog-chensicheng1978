[{"data":1,"prerenderedAt":204},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":57,"blog-post-slug-blog_4af9831b01000bok":74,"surround-blog_4af9831b01000bok":193},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":16,"site_description":54,"stem":55,"__hash__":56},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo","新浪博客内容备份(粉丝自用)","settings","jPD1QWrYwbaIixg6lntppEYe-T3ZGd3EJZxFBkbKY9E",{"latestBlog":58},[59,62,65,68,71],{"title":60,"slug":61},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":63,"slug":64},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":66,"slug":67},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":69,"slug":70},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":72,"slug":73},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":75,"title":76,"body":77,"categories":177,"description":178,"extension":179,"meta":180,"navigation":182,"path":183,"seo":184,"slug":185,"stem":186,"tags":187,"__hash__":192},"blog\u002Fblog\u002Fblog_4af9831b01000bok.md","星梦奇缘",{"type":78,"value":79,"toc":173},"minimark",[80,89,95,101,107,113,116,121,124,127,130,133,136,139,142,145,148,151,154,157,162,165,170],[81,82,83],"p",{},[84,85],"a",{"href":86,"rel":87},"http:\u002F\u002Falbum.sina.com.cn\u002Fpic\u002F4af9831b43f6b3205b514",[88],"nofollow",[81,90,91],{},[84,92],{"href":93,"rel":94},"http:\u002F\u002Falbum.sina.com.cn\u002Fpic\u002F4af9831b43f6b32178b62",[88],[81,96,97],{},[84,98],{"href":99,"rel":100},"http:\u002F\u002Falbum.sina.com.cn\u002Fpic\u002F4af9831b43f6b322500f6",[88],[81,102,103],{},[84,104],{"href":105,"rel":106},"http:\u002F\u002Falbum.sina.com.cn\u002Fpic\u002F4af9831b43f6b43ee7f32",[88],[81,108,109],{},[110,111],"img",{"alt":76,"src":112},"\u002Fpic\u002F4af9831b43f6b31fef70d.jpg",[81,114,115],{},"在烟花浪漫的夜晚...我对你倍加的思念......",[81,117,118],{},[110,119],{"alt":76,"src":120},"\u002Fpic\u002F4af9831b43f6b43ee7f32.jpg",[81,122,123],{},"这个银...就是传说中的幕后黑手...4哥...",[81,125,126],{},"“星梦奇缘”——喜欢这个名字。因为，浪漫。",[81,128,129],{},"缘，妙不可言。世间万事万物皆能用一“缘”字解释个通透。你们与那些角色是缘，我与那些角色也是缘，我与你们更是缘……",[81,131,132],{},"终于爱上了演员这个职业。在今年。希望还不晚，应该还不晚。",[81,134,135],{},"从前的我抵触，觉得“被选择”不男人，“主动”才王者。所以我徘徊，忧郁，浮沉……",[81,137,138],{},"年初的一部戏，让我真正沦陷。那故事那爱情炙热得眩目，又残酷得血肉模糊。但那完整那纯粹那干净和我的理想勾芡的严丝合缝几乎没半点瑕疵。于是，我爱上了那故事，爱上了那剧中人……“成才”让我成长，这角色却更让我成熟。",[81,140,141],{},"经历后，我才算明白了点这个职业，明白了这个职业需要的坚信，艰辛，坚持，坚守……",[81,143,144],{},"我们是用自己塑造，全部的自己。这全部包括肉身，心灵和情感，你所有的全部，全部的全部。所以我们很难有自己，所以我们很容易被裹挟，所以我们才脆弱，易碎，矛盾，游移，情绪，任性，敏感，多疑，自律且自渎，自曝且自闭……我们唯一的工作是进步，唯一的进步是丰富，唯一的丰富是自己，唯一的自己是使命……",[81,146,147],{},"不断的自我认知，自我完善才是这个职业也或是这个人生的合理解读吧……明白后，便不再困惑，便更清了方向，更充沛了步伐……",[81,149,150],{},"接下来就遇到了你们，梦中的那部分……幸福来的促不及防，甚至如暴发户般的奢侈。放心，我们会珍惜，不会挥“金”如土！因为我们是“步兵”！是一步一步走出来的兵！就如帖吧里的一位朋友说：“五班——曾经成才口中那班长的坟墓",[81,152,153],{},"孬兵的天堂，却真正的才是成才的福地……”愿所有“士兵”的战友们，都早日找到各自的“五班”。因为7连好，老A易，5班才是我们对自我认知和成长的绝地……",[81,155,156],{},"“星梦奇缘”30年，祝愿大家从这一刻开始，真正迎来属于自己的30年……",[81,158,159],{},[110,160],{"alt":76,"src":161},"\u002Fpic\u002F4af9831b43f6b32178b62.jpg",[81,163,164],{},"两个说相声的……望30年后，依旧能如此“四目相对”“笑靥入花”……",[81,166,167],{},[110,168],{"alt":76,"src":169},"\u002Fpic\u002F4af9831b43f6b322500f6.jpg",[81,171,172],{},"“星梦”全家福……",{"title":174,"searchDepth":175,"depth":175,"links":176},"",2,[],[6,9],"终于爱上了演员这个职业。","md",{"date":181},"2007-11-21 14:02",true,"\u002Fblog\u002Fblog_4af9831b01000bok",{"title":76,"description":178},"blog_4af9831b01000bok","blog\u002Fblog_4af9831b01000bok",[188,189,190,191],"随笔\u002F感悟","士兵突击","星梦奇缘30年","新浪博客","PxaJOJ6ZD9ky0sk7a8I1bQ5Vm_EZyvmF5JLFDXg_V2Y",[194,199],{"title":195,"path":196,"stem":197,"children":-1,"slug":198},"勇往直前","\u002Fblog\u002Fblog_4af9831b01000bn0","blog\u002Fblog_4af9831b01000bn0","blog_4af9831b01000bn0",{"title":200,"path":201,"stem":202,"children":-1,"slug":203},"实话实说?","\u002Fblog\u002Fblog_4af9831b01000bs5","blog\u002Fblog_4af9831b01000bs5","blog_4af9831b01000bs5",1794473705533]
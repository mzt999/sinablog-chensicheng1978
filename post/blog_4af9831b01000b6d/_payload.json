[{"data":1,"prerenderedAt":104},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":17,"blog-post-slug-blog_4af9831b01000b6d":34,"surround-blog_4af9831b01000b6d":93},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"latestBlog":18},[19,22,25,28,31],{"title":20,"slug":21},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":23,"slug":24},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":26,"slug":27},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":29,"slug":30},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":32,"slug":33},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":35,"title":36,"body":37,"categories":81,"description":43,"extension":82,"meta":83,"navigation":85,"path":86,"seo":87,"slug":88,"stem":89,"tags":90,"__hash__":92},"blog\u002Fblog\u002Fblog_4af9831b01000b6d.md","1 等待",{"type":38,"value":39,"toc":77},"minimark",[40,44,47,50,53,56,59,62,65,68,71,74],[41,42,43],"p",{},"正常人们此刻都睡了。也有没睡的，都不正常，非常。",[41,45,46],{},"或非常态或非常人。",[41,48,49],{},"我们没睡，集体非常，整组个性！通宵的戏！",[41,51,52],{},"还好，就在宾馆楼下。我可以边上来说点梦话边候场。",[41,54,55],{},"你们爱不爱听无所谓，先爽了自己。",[41,57,58],{},"又闻到了一部戏即将杀青的味道。结束的味道。像黄昏的味道。",[41,60,61],{},"黄昏，是我一天中的最爱。最美。最温柔。夹杂着白日的清晰夜晚的混沌，如同夹杂着少女的清纯妇人的魅惑。这种不可调和又浑然一体的气质最诱人。",[41,63,64],{},"但是，离夜近了。",[41,66,67],{},"别离总是伤感的，匆匆太匆匆。无论好的坏的，到最后，只是快的。",[41,69,70],{},"现在的这些人中，个别也许此生再也难见了。他们不过是陪了你一程，谁安排的？",[41,72,73],{},"后面，新的人又要来。再相知相识再分别离散。我们的身体是一个客栈，不断的是新貌旧颜的客来客往，人走人留。",[41,75,76],{},"叫我了，先拍一场。回来再继续。",{"title":78,"searchDepth":79,"depth":79,"links":80},"",2,[],[6],"md",{"date":84},"2007-10-10 02:33",true,"\u002Fblog\u002Fblog_4af9831b01000b6d",{"title":36,"description":43},"blog_4af9831b01000b6d","blog\u002Fblog_4af9831b01000b6d",[91],"随笔\u002F感悟","o3YXLFd48dsgGTdGU245LRWmCdoGhmAsGcV8mffJec0",[94,99],{"title":95,"path":96,"stem":97,"children":-1,"slug":98},"《狭路相逢》剧照","\u002Fblog\u002Fblog_4af9831b01000b4u","blog\u002Fblog_4af9831b01000b4u","blog_4af9831b01000b4u",{"title":100,"path":101,"stem":102,"children":-1,"slug":103},"3 重轻","\u002Fblog\u002Fblog_4af9831b01000b6e","blog\u002Fblog_4af9831b01000b6e","blog_4af9831b01000b6e",1794043805661]
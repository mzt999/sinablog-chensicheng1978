[{"data":1,"prerenderedAt":157},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":70,"blog-post-slug-blog_4af9831b01000b6d":87,"surround-blog_4af9831b01000b6d":146},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":45,"navLinks":46,"perPage":16,"prevNextIsExcludeDate":66,"site_description":23,"site_name":67,"stem":68,"__hash__":69},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{},[47,52,56,60,64],{"path":48,"title":49,"target":50,"fa_class":51},"\u002F","博客首页","internal","fa-home",{"path":53,"title":54,"target":50,"fa_class":55},"\u002Fabout","关于","fa-user",{"path":57,"title":58,"target":50,"fa_class":59},"\u002Fpost","归档","fa-archive",{"path":61,"title":62,"target":50,"fa_class":63},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":65,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","jvZHccz2rT-wjVS5GCPgWyhl8WnBIvECPkE5KpKFKCU",{"latestBlog":71},[72,75,78,81,84],{"title":73,"slug":74},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":76,"slug":77},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":79,"slug":80},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":82,"slug":83},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":85,"slug":86},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":88,"title":89,"body":90,"categories":134,"description":96,"extension":135,"meta":136,"navigation":138,"path":139,"seo":140,"slug":141,"stem":142,"tags":143,"__hash__":145},"blog\u002Fblog\u002Fblog_4af9831b01000b6d.md","1 等待",{"type":91,"value":92,"toc":130},"minimark",[93,97,100,103,106,109,112,115,118,121,124,127],[94,95,96],"p",{},"正常人们此刻都睡了。也有没睡的，都不正常，非常。",[94,98,99],{},"或非常态或非常人。",[94,101,102],{},"我们没睡，集体非常，整组个性！通宵的戏！",[94,104,105],{},"还好，就在宾馆楼下。我可以边上来说点梦话边候场。",[94,107,108],{},"你们爱不爱听无所谓，先爽了自己。",[94,110,111],{},"又闻到了一部戏即将杀青的味道。结束的味道。像黄昏的味道。",[94,113,114],{},"黄昏，是我一天中的最爱。最美。最温柔。夹杂着白日的清晰夜晚的混沌，如同夹杂着少女的清纯妇人的魅惑。这种不可调和又浑然一体的气质最诱人。",[94,116,117],{},"但是，离夜近了。",[94,119,120],{},"别离总是伤感的，匆匆太匆匆。无论好的坏的，到最后，只是快的。",[94,122,123],{},"现在的这些人中，个别也许此生再也难见了。他们不过是陪了你一程，谁安排的？",[94,125,126],{},"后面，新的人又要来。再相知相识再分别离散。我们的身体是一个客栈，不断的是新貌旧颜的客来客往，人走人留。",[94,128,129],{},"叫我了，先拍一场。回来再继续。",{"title":131,"searchDepth":132,"depth":132,"links":133},"",2,[],[6],"md",{"date":137},"2007-10-10 02:33",true,"\u002Fblog\u002Fblog_4af9831b01000b6d",{"title":89,"description":96},"blog_4af9831b01000b6d","blog\u002Fblog_4af9831b01000b6d",[144],"随笔\u002F感悟","o3YXLFd48dsgGTdGU245LRWmCdoGhmAsGcV8mffJec0",[147,152],{"title":148,"path":149,"stem":150,"children":-1,"slug":151},"《狭路相逢》剧照","\u002Fblog\u002Fblog_4af9831b01000b4u","blog\u002Fblog_4af9831b01000b4u","blog_4af9831b01000b4u",{"title":153,"path":154,"stem":155,"children":-1,"slug":156},"3 重轻","\u002Fblog\u002Fblog_4af9831b01000b6e","blog\u002Fblog_4af9831b01000b6e","blog_4af9831b01000b6e",1794544667854]
[{"data":1,"prerenderedAt":144},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":57,"blog-post-slug-blog_4af9831b01000b6d":74,"surround-blog_4af9831b01000b6d":133},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":16,"site_description":54,"stem":55,"__hash__":56},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo","新浪博客内容备份(粉丝自用)","settings","jPD1QWrYwbaIixg6lntppEYe-T3ZGd3EJZxFBkbKY9E",{"latestBlog":58},[59,62,65,68,71],{"title":60,"slug":61},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":63,"slug":64},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":66,"slug":67},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":69,"slug":70},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":72,"slug":73},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":75,"title":76,"body":77,"categories":121,"description":83,"extension":122,"meta":123,"navigation":125,"path":126,"seo":127,"slug":128,"stem":129,"tags":130,"__hash__":132},"blog\u002Fblog\u002Fblog_4af9831b01000b6d.md","1 等待",{"type":78,"value":79,"toc":117},"minimark",[80,84,87,90,93,96,99,102,105,108,111,114],[81,82,83],"p",{},"正常人们此刻都睡了。也有没睡的，都不正常，非常。",[81,85,86],{},"或非常态或非常人。",[81,88,89],{},"我们没睡，集体非常，整组个性！通宵的戏！",[81,91,92],{},"还好，就在宾馆楼下。我可以边上来说点梦话边候场。",[81,94,95],{},"你们爱不爱听无所谓，先爽了自己。",[81,97,98],{},"又闻到了一部戏即将杀青的味道。结束的味道。像黄昏的味道。",[81,100,101],{},"黄昏，是我一天中的最爱。最美。最温柔。夹杂着白日的清晰夜晚的混沌，如同夹杂着少女的清纯妇人的魅惑。这种不可调和又浑然一体的气质最诱人。",[81,103,104],{},"但是，离夜近了。",[81,106,107],{},"别离总是伤感的，匆匆太匆匆。无论好的坏的，到最后，只是快的。",[81,109,110],{},"现在的这些人中，个别也许此生再也难见了。他们不过是陪了你一程，谁安排的？",[81,112,113],{},"后面，新的人又要来。再相知相识再分别离散。我们的身体是一个客栈，不断的是新貌旧颜的客来客往，人走人留。",[81,115,116],{},"叫我了，先拍一场。回来再继续。",{"title":118,"searchDepth":119,"depth":119,"links":120},"",2,[],[6],"md",{"date":124},"2007-10-10 02:33",true,"\u002Fblog\u002Fblog_4af9831b01000b6d",{"title":76,"description":83},"blog_4af9831b01000b6d","blog\u002Fblog_4af9831b01000b6d",[131],"随笔\u002F感悟","o3YXLFd48dsgGTdGU245LRWmCdoGhmAsGcV8mffJec0",[134,139],{"title":135,"path":136,"stem":137,"children":-1,"slug":138},"《狭路相逢》剧照","\u002Fblog\u002Fblog_4af9831b01000b4u","blog\u002Fblog_4af9831b01000b4u","blog_4af9831b01000b4u",{"title":140,"path":141,"stem":142,"children":-1,"slug":143},"3 重轻","\u002Fblog\u002Fblog_4af9831b01000b6e","blog\u002Fblog_4af9831b01000b6e","blog_4af9831b01000b6e",1794473705594]
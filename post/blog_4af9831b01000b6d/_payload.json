[{"data":1,"prerenderedAt":163},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":76,"blog-post-slug-blog_4af9831b01000b6d":93,"surround-blog_4af9831b01000b6d":152},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":38,"meta":50,"navLinks":51,"perPage":16,"prevNextIsExcludeDate":71,"site_description":72,"site_name":73,"stem":74,"__hash__":75},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,26,32],{"text":23},"粉丝自制非官方站点｜素材版权归原权利人所有",{"text":25},"仅兴趣交流、无商业用途｜如有侵权请联系删除",{"text":27,"link":28},"查看",{"href":29,"text":30,"fa_class":31},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":33,"link":34},"如有任何疑问，欢迎",{"href":35,"text":36,"fa_class":37},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[39,42,45,47],{"href":40,"text":41},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":43,"text":44},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":46},"新浪微博备份(2009-2026)",{"href":48,"text":49},"https:\u002F\u002Fmzt999.github.io\u002Fportfolio-chensicheng1978","幕后作品集展示(2012-2026)",{},[52,57,61,65,69],{"path":53,"title":54,"target":55,"fa_class":56},"\u002F","博客首页","internal","fa-home",{"path":58,"title":59,"target":55,"fa_class":60},"\u002Fabout","关于","fa-user",{"path":62,"title":63,"target":55,"fa_class":64},"\u002Fpost","归档","fa-archive",{"path":66,"title":67,"target":55,"fa_class":68},"\u002Fgallery","相册","fa-image",{"path":29,"title":30,"target":70,"fa_class":31},"otherSite",false,"新浪博客内容备份(粉丝自用)","陈思诚的博客","settings","5S7xKt0XLHpkjipbomx4I7pUu50Y7wqtD418LquZj5Q",{"latestBlog":77},[78,81,84,87,90],{"title":79,"slug":80},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":82,"slug":83},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":85,"slug":86},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":88,"slug":89},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":91,"slug":92},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":94,"title":95,"body":96,"categories":140,"description":102,"extension":141,"meta":142,"navigation":144,"path":145,"seo":146,"slug":147,"stem":148,"tags":149,"__hash__":151},"blog\u002Fblog\u002Fblog_4af9831b01000b6d.md","1 等待",{"type":97,"value":98,"toc":136},"minimark",[99,103,106,109,112,115,118,121,124,127,130,133],[100,101,102],"p",{},"正常人们此刻都睡了。也有没睡的，都不正常，非常。",[100,104,105],{},"或非常态或非常人。",[100,107,108],{},"我们没睡，集体非常，整组个性！通宵的戏！",[100,110,111],{},"还好，就在宾馆楼下。我可以边上来说点梦话边候场。",[100,113,114],{},"你们爱不爱听无所谓，先爽了自己。",[100,116,117],{},"又闻到了一部戏即将杀青的味道。结束的味道。像黄昏的味道。",[100,119,120],{},"黄昏，是我一天中的最爱。最美。最温柔。夹杂着白日的清晰夜晚的混沌，如同夹杂着少女的清纯妇人的魅惑。这种不可调和又浑然一体的气质最诱人。",[100,122,123],{},"但是，离夜近了。",[100,125,126],{},"别离总是伤感的，匆匆太匆匆。无论好的坏的，到最后，只是快的。",[100,128,129],{},"现在的这些人中，个别也许此生再也难见了。他们不过是陪了你一程，谁安排的？",[100,131,132],{},"后面，新的人又要来。再相知相识再分别离散。我们的身体是一个客栈，不断的是新貌旧颜的客来客往，人走人留。",[100,134,135],{},"叫我了，先拍一场。回来再继续。",{"title":137,"searchDepth":138,"depth":138,"links":139},"",2,[],[6],"md",{"date":143},"2007-10-10 02:33",true,"\u002Fblog\u002Fblog_4af9831b01000b6d",{"title":95,"description":102},"blog_4af9831b01000b6d","blog\u002Fblog_4af9831b01000b6d",[150],"随笔\u002F感悟","o3YXLFd48dsgGTdGU245LRWmCdoGhmAsGcV8mffJec0",[153,158],{"title":154,"path":155,"stem":156,"children":-1,"slug":157},"《狭路相逢》剧照","\u002Fblog\u002Fblog_4af9831b01000b4u","blog\u002Fblog_4af9831b01000b4u","blog_4af9831b01000b4u",{"title":159,"path":160,"stem":161,"children":-1,"slug":162},"3 重轻","\u002Fblog\u002Fblog_4af9831b01000b6e","blog\u002Fblog_4af9831b01000b6e","blog_4af9831b01000b6e",1795162026021]
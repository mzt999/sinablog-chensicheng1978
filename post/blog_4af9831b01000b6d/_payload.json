[{"data":1,"prerenderedAt":101},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b01000b6d":31,"surround-blog_4af9831b01000b6d":90},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",152,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":78,"description":33,"extension":79,"meta":80,"navigation":82,"path":83,"seo":84,"slug":85,"stem":86,"tags":87,"__hash__":89},"blog\u002Fblog\u002Fblog_4af9831b01000b6d.md","1 等待",{"type":35,"value":36,"toc":74},"minimark",[37,41,44,47,50,53,56,59,62,65,68,71],[38,39,40],"p",{},"正常人们此刻都睡了。也有没睡的，都不正常，非常。",[38,42,43],{},"或非常态或非常人。",[38,45,46],{},"我们没睡，集体非常，整组个性！通宵的戏！",[38,48,49],{},"还好，就在宾馆楼下。我可以边上来说点梦话边候场。",[38,51,52],{},"你们爱不爱听无所谓，先爽了自己。",[38,54,55],{},"又闻到了一部戏即将杀青的味道。结束的味道。像黄昏的味道。",[38,57,58],{},"黄昏，是我一天中的最爱。最美。最温柔。夹杂着白日的清晰夜晚的混沌，如同夹杂着少女的清纯妇人的魅惑。这种不可调和又浑然一体的气质最诱人。",[38,60,61],{},"但是，离夜近了。",[38,63,64],{},"别离总是伤感的，匆匆太匆匆。无论好的坏的，到最后，只是快的。",[38,66,67],{},"现在的这些人中，个别也许此生再也难见了。他们不过是陪了你一程，谁安排的？",[38,69,70],{},"后面，新的人又要来。再相知相识再分别离散。我们的身体是一个客栈，不断的是新貌旧颜的客来客往，人走人留。",[38,72,73],{},"叫我了，先拍一场。回来再继续。",{"title":75,"searchDepth":76,"depth":76,"links":77},"",2,[],[6],"md",{"date":81},"2007-10-10 02:33",true,"\u002Fblog\u002Fblog_4af9831b01000b6d",{"title":33,"description":33},"blog_4af9831b01000b6d","blog\u002Fblog_4af9831b01000b6d",[88],"随笔\u002F感悟","zDHMXFm0Hkcp7wMUTM7pXK7PWMsoDeXl4OfOjbfcYAA",[91,96],{"title":92,"path":93,"stem":94,"children":-1,"slug":95},"《狭路相逢》剧照","\u002Fblog\u002Fblog_4af9831b01000b4u","blog\u002Fblog_4af9831b01000b4u","blog_4af9831b01000b4u",{"title":97,"path":98,"stem":99,"children":-1,"slug":100},"3 重轻","\u002Fblog\u002Fblog_4af9831b01000b6e","blog\u002Fblog_4af9831b01000b6e","blog_4af9831b01000b6e",1793965555873]
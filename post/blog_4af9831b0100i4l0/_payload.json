[{"data":1,"prerenderedAt":170},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":76,"blog-post-slug-blog_4af9831b0100i4l0":93,"surround-blog_4af9831b0100i4l0":163},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":38,"meta":50,"navLinks":51,"perPage":16,"prevNextIsExcludeDate":71,"site_description":72,"site_name":73,"stem":74,"__hash__":75},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,26,32],{"text":23},"粉丝自制非官方站点｜素材版权归原权利人所有",{"text":25},"仅兴趣交流、无商业用途｜如有侵权请联系删除",{"text":27,"link":28},"查看",{"href":29,"text":30,"fa_class":31},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":33,"link":34},"如有任何疑问，欢迎",{"href":35,"text":36,"fa_class":37},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[39,42,45,47],{"href":40,"text":41},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":43,"text":44},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":46},"新浪微博备份(2009-2026)",{"href":48,"text":49},"https:\u002F\u002Fmzt999.github.io\u002Fportfolio-chensicheng1978","幕后作品集展示(2012-2026)",{},[52,57,61,65,69],{"path":53,"title":54,"target":55,"fa_class":56},"\u002F","博客首页","internal","fa-home",{"path":58,"title":59,"target":55,"fa_class":60},"\u002Fabout","关于","fa-user",{"path":62,"title":63,"target":55,"fa_class":64},"\u002Fpost","归档","fa-archive",{"path":66,"title":67,"target":55,"fa_class":68},"\u002Fgallery","相册","fa-image",{"path":29,"title":30,"target":70,"fa_class":31},"otherSite",false,"新浪博客内容备份(粉丝自用)","陈思诚的博客","settings","5S7xKt0XLHpkjipbomx4I7pUu50Y7wqtD418LquZj5Q",{"latestBlog":77},[78,81,84,87,90],{"title":79,"slug":80},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":82,"slug":83},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":85,"slug":86},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":88,"slug":89},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":91,"slug":92},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":94,"title":88,"body":95,"categories":151,"description":152,"extension":153,"meta":154,"navigation":156,"path":157,"seo":158,"slug":89,"stem":159,"tags":160,"__hash__":162},"blog\u002Fblog\u002Fblog_4af9831b0100i4l0.md",{"type":96,"value":97,"toc":147},"minimark",[98,102,105,108,111,114,117,120,123,126,129,132,135,138,141,144],[99,100,101],"p",{},"今天‘春哥’生日，此春非彼春……很开心，主创聚齐，举杯一醉……",[99,103,104],{},"“七小罗汉”是个挺特别的电影，允许我再一次的自卖自夸。就如同自己生的孩子，每一份牵挂你可以不接受但请你试着去理解！……看吧，反正这个电影我喜欢……",[99,106,107],{},"酒后，又来醒酒……",[99,109,110],{},"说点什么？今晚想说失去……",[99,112,113],{},"任谁都会有失去，不了解失去的苦一定不明白拥有的甜，反之亦然……",[99,115,116],{},"那晚的失去，至少有六个人可以见证……",[99,118,119],{},"胡哥，海军是第一时间的目击者。“梧桐”后我的新车“小宝”还被子弹无情的击中……海军陪我去了派出所折腾到了半夜。于那晚，我信，我们都会难忘……",[99,121,122],{},"接着迎接我的便是亚玲，大花，胖子张羽，胖子谭璇共同见证的一次酩酊……真的想对你们说声谢谢！",[99,124,125],{},"真的……在我想有人陪的时候你们总会准时的出现在我身边……我希望，在你们需要的时候……我也可以！",[99,127,128],{},"人生最玄妙在于……我们的承受……",[99,130,131],{},"那晚的失去，现在想来却是我最大的拥有……但那一夜，我却如同个失落的孩子……",[99,133,134],{},"所以，也许我们该感谢每一次的失去……因为……没有失去，便不会拥有……",[99,136,137],{},"对了，大家的留言，无论这里还是贴吧，我都会看……",[99,139,140],{},"每一条……",[99,142,143],{},"我不会回复，但在心里…………………………它们，都有答案……",[99,145,146],{},"都有。",{"title":148,"searchDepth":149,"depth":149,"links":150},"",2,[],[6],"今晚想说失去……","md",{"date":155},"2010-04-25 22:37",true,"\u002Fblog\u002Fblog_4af9831b0100i4l0",{"title":88,"description":152},"blog\u002Fblog_4af9831b0100i4l0",[161],"杂谈","k8G0rXWeKhxJgfNsy8aCdWlH3iU72Hy2XT-zL68BYpg",[164,167],{"title":91,"path":165,"stem":166,"children":-1,"slug":92},"\u002Fblog\u002Fblog_4af9831b0100i0mz","blog\u002Fblog_4af9831b0100i0mz",{"title":85,"path":168,"stem":169,"children":-1,"slug":86},"\u002Fblog\u002Fblog_4af9831b0100j000","blog\u002Fblog_4af9831b0100j000",1795162025018]
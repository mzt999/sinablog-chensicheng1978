[{"data":1,"prerenderedAt":164},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":70,"blog-post-slug-blog_4af9831b0100i4l0":87,"surround-blog_4af9831b0100i4l0":157},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":45,"navLinks":46,"perPage":16,"prevNextIsExcludeDate":66,"site_description":23,"site_name":67,"stem":68,"__hash__":69},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{},[47,52,56,60,64],{"path":48,"title":49,"target":50,"fa_class":51},"\u002F","博客首页","internal","fa-home",{"path":53,"title":54,"target":50,"fa_class":55},"\u002Fabout","关于","fa-user",{"path":57,"title":58,"target":50,"fa_class":59},"\u002Fpost","归档","fa-archive",{"path":61,"title":62,"target":50,"fa_class":63},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":65,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","jvZHccz2rT-wjVS5GCPgWyhl8WnBIvECPkE5KpKFKCU",{"latestBlog":71},[72,75,78,81,84],{"title":73,"slug":74},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":76,"slug":77},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":79,"slug":80},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":82,"slug":83},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":85,"slug":86},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":88,"title":82,"body":89,"categories":145,"description":146,"extension":147,"meta":148,"navigation":150,"path":151,"seo":152,"slug":83,"stem":153,"tags":154,"__hash__":156},"blog\u002Fblog\u002Fblog_4af9831b0100i4l0.md",{"type":90,"value":91,"toc":141},"minimark",[92,96,99,102,105,108,111,114,117,120,123,126,129,132,135,138],[93,94,95],"p",{},"今天‘春哥’生日，此春非彼春……很开心，主创聚齐，举杯一醉……",[93,97,98],{},"“七小罗汉”是个挺特别的电影，允许我再一次的自卖自夸。就如同自己生的孩子，每一份牵挂你可以不接受但请你试着去理解！……看吧，反正这个电影我喜欢……",[93,100,101],{},"酒后，又来醒酒……",[93,103,104],{},"说点什么？今晚想说失去……",[93,106,107],{},"任谁都会有失去，不了解失去的苦一定不明白拥有的甜，反之亦然……",[93,109,110],{},"那晚的失去，至少有六个人可以见证……",[93,112,113],{},"胡哥，海军是第一时间的目击者。“梧桐”后我的新车“小宝”还被子弹无情的击中……海军陪我去了派出所折腾到了半夜。于那晚，我信，我们都会难忘……",[93,115,116],{},"接着迎接我的便是亚玲，大花，胖子张羽，胖子谭璇共同见证的一次酩酊……真的想对你们说声谢谢！",[93,118,119],{},"真的……在我想有人陪的时候你们总会准时的出现在我身边……我希望，在你们需要的时候……我也可以！",[93,121,122],{},"人生最玄妙在于……我们的承受……",[93,124,125],{},"那晚的失去，现在想来却是我最大的拥有……但那一夜，我却如同个失落的孩子……",[93,127,128],{},"所以，也许我们该感谢每一次的失去……因为……没有失去，便不会拥有……",[93,130,131],{},"对了，大家的留言，无论这里还是贴吧，我都会看……",[93,133,134],{},"每一条……",[93,136,137],{},"我不会回复，但在心里…………………………它们，都有答案……",[93,139,140],{},"都有。",{"title":142,"searchDepth":143,"depth":143,"links":144},"",2,[],[6],"今晚想说失去……","md",{"date":149},"2010-04-25 22:37",true,"\u002Fblog\u002Fblog_4af9831b0100i4l0",{"title":82,"description":146},"blog\u002Fblog_4af9831b0100i4l0",[155],"杂谈","k8G0rXWeKhxJgfNsy8aCdWlH3iU72Hy2XT-zL68BYpg",[158,161],{"title":85,"path":159,"stem":160,"children":-1,"slug":86},"\u002Fblog\u002Fblog_4af9831b0100i0mz","blog\u002Fblog_4af9831b0100i0mz",{"title":79,"path":162,"stem":163,"children":-1,"slug":80},"\u002Fblog\u002Fblog_4af9831b0100j000","blog\u002Fblog_4af9831b0100j000",1794546768629]
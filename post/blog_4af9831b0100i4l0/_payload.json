[{"data":1,"prerenderedAt":107},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b0100i4l0":31,"surround-blog_4af9831b0100i4l0":100},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",152,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":26,"body":33,"categories":89,"description":26,"extension":90,"meta":91,"navigation":93,"path":94,"seo":95,"slug":27,"stem":96,"tags":97,"__hash__":99},"blog\u002Fblog\u002Fblog_4af9831b0100i4l0.md",{"type":34,"value":35,"toc":85},"minimark",[36,40,43,46,49,52,55,58,61,64,67,70,73,76,79,82],[37,38,39],"p",{},"今天‘春哥’生日，此春非彼春……很开心，主创聚齐，举杯一醉……",[37,41,42],{},"“七小罗汉”是个挺特别的电影，允许我再一次的自卖自夸。就如同自己生的孩子，每一份牵挂你可以不接受但请你试着去理解！……看吧，反正这个电影我喜欢……",[37,44,45],{},"酒后，又来醒酒……",[37,47,48],{},"说点什么？今晚想说失去……",[37,50,51],{},"任谁都会有失去，不了解失去的苦一定不明白拥有的甜，反之亦然……",[37,53,54],{},"那晚的失去，至少有六个人可以见证……",[37,56,57],{},"胡哥，海军是第一时间的目击者。“梧桐”后我的新车“小宝”还被子弹无情的击中……海军陪我去了派出所折腾到了半夜。于那晚，我信，我们都会难忘……",[37,59,60],{},"接着迎接我的便是亚玲，大花，胖子张羽，胖子谭璇共同见证的一次酩酊……真的想对你们说声谢谢！",[37,62,63],{},"真的……在我想有人陪的时候你们总会准时的出现在我身边……我希望，在你们需要的时候……我也可以！",[37,65,66],{},"人生最玄妙在于……我们的承受……",[37,68,69],{},"那晚的失去，现在想来却是我最大的拥有……但那一夜，我却如同个失落的孩子……",[37,71,72],{},"所以，也许我们该感谢每一次的失去……因为……没有失去，便不会拥有……",[37,74,75],{},"对了，大家的留言，无论这里还是贴吧，我都会看……",[37,77,78],{},"每一条……",[37,80,81],{},"我不会回复，但在心里…………………………它们，都有答案……",[37,83,84],{},"都有。",{"title":86,"searchDepth":87,"depth":87,"links":88},"",2,[],[6],"md",{"date":92},"2010-04-25 22:37",true,"\u002Fblog\u002Fblog_4af9831b0100i4l0",{"title":26,"description":26},"blog\u002Fblog_4af9831b0100i4l0",[98],"杂谈","D03c-EVPoCrfezZJIfl456h-ZOPW0_L7C0ikqLwyYd0",[101,104],{"title":29,"path":102,"stem":103,"children":-1,"slug":30},"\u002Fblog\u002Fblog_4af9831b0100i0mz","blog\u002Fblog_4af9831b0100i0mz",{"title":23,"path":105,"stem":106,"children":-1,"slug":24},"\u002Fblog\u002Fblog_4af9831b0100j000","blog\u002Fblog_4af9831b0100j000",1793972058418]
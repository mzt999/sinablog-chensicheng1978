[{"data":1,"prerenderedAt":151},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":57,"blog-post-slug-blog_4af9831b0100i4l0":74,"surround-blog_4af9831b0100i4l0":144},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":16,"site_description":54,"stem":55,"__hash__":56},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo","新浪博客内容备份(粉丝自用)","settings","jPD1QWrYwbaIixg6lntppEYe-T3ZGd3EJZxFBkbKY9E",{"latestBlog":58},[59,62,65,68,71],{"title":60,"slug":61},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":63,"slug":64},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":66,"slug":67},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":69,"slug":70},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":72,"slug":73},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":75,"title":69,"body":76,"categories":132,"description":133,"extension":134,"meta":135,"navigation":137,"path":138,"seo":139,"slug":70,"stem":140,"tags":141,"__hash__":143},"blog\u002Fblog\u002Fblog_4af9831b0100i4l0.md",{"type":77,"value":78,"toc":128},"minimark",[79,83,86,89,92,95,98,101,104,107,110,113,116,119,122,125],[80,81,82],"p",{},"今天‘春哥’生日，此春非彼春……很开心，主创聚齐，举杯一醉……",[80,84,85],{},"“七小罗汉”是个挺特别的电影，允许我再一次的自卖自夸。就如同自己生的孩子，每一份牵挂你可以不接受但请你试着去理解！……看吧，反正这个电影我喜欢……",[80,87,88],{},"酒后，又来醒酒……",[80,90,91],{},"说点什么？今晚想说失去……",[80,93,94],{},"任谁都会有失去，不了解失去的苦一定不明白拥有的甜，反之亦然……",[80,96,97],{},"那晚的失去，至少有六个人可以见证……",[80,99,100],{},"胡哥，海军是第一时间的目击者。“梧桐”后我的新车“小宝”还被子弹无情的击中……海军陪我去了派出所折腾到了半夜。于那晚，我信，我们都会难忘……",[80,102,103],{},"接着迎接我的便是亚玲，大花，胖子张羽，胖子谭璇共同见证的一次酩酊……真的想对你们说声谢谢！",[80,105,106],{},"真的……在我想有人陪的时候你们总会准时的出现在我身边……我希望，在你们需要的时候……我也可以！",[80,108,109],{},"人生最玄妙在于……我们的承受……",[80,111,112],{},"那晚的失去，现在想来却是我最大的拥有……但那一夜，我却如同个失落的孩子……",[80,114,115],{},"所以，也许我们该感谢每一次的失去……因为……没有失去，便不会拥有……",[80,117,118],{},"对了，大家的留言，无论这里还是贴吧，我都会看……",[80,120,121],{},"每一条……",[80,123,124],{},"我不会回复，但在心里…………………………它们，都有答案……",[80,126,127],{},"都有。",{"title":129,"searchDepth":130,"depth":130,"links":131},"",2,[],[6],"今晚想说失去……","md",{"date":136},"2010-04-25 22:37",true,"\u002Fblog\u002Fblog_4af9831b0100i4l0",{"title":69,"description":133},"blog\u002Fblog_4af9831b0100i4l0",[142],"杂谈","k8G0rXWeKhxJgfNsy8aCdWlH3iU72Hy2XT-zL68BYpg",[145,148],{"title":72,"path":146,"stem":147,"children":-1,"slug":73},"\u002Fblog\u002Fblog_4af9831b0100i0mz","blog\u002Fblog_4af9831b0100i0mz",{"title":66,"path":149,"stem":150,"children":-1,"slug":67},"\u002Fblog\u002Fblog_4af9831b0100j000","blog\u002Fblog_4af9831b0100j000",1794473704228]
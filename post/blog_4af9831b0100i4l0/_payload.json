[{"data":1,"prerenderedAt":152},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":58,"blog-post-slug-blog_4af9831b0100i4l0":75,"surround-blog_4af9831b0100i4l0":145},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":54,"site_description":55,"stem":56,"__hash__":57},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo",20,"新浪博客内容备份","settings","hh8X7X6SFDoeJrxIJ4yisZXSc3HwHM1zk206jiQX2XU",{"latestBlog":59},[60,63,66,69,72],{"title":61,"slug":62},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":64,"slug":65},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":67,"slug":68},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":70,"slug":71},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":73,"slug":74},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":76,"title":70,"body":77,"categories":133,"description":134,"extension":135,"meta":136,"navigation":138,"path":139,"seo":140,"slug":71,"stem":141,"tags":142,"__hash__":144},"blog\u002Fblog\u002Fblog_4af9831b0100i4l0.md",{"type":78,"value":79,"toc":129},"minimark",[80,84,87,90,93,96,99,102,105,108,111,114,117,120,123,126],[81,82,83],"p",{},"今天‘春哥’生日，此春非彼春……很开心，主创聚齐，举杯一醉……",[81,85,86],{},"“七小罗汉”是个挺特别的电影，允许我再一次的自卖自夸。就如同自己生的孩子，每一份牵挂你可以不接受但请你试着去理解！……看吧，反正这个电影我喜欢……",[81,88,89],{},"酒后，又来醒酒……",[81,91,92],{},"说点什么？今晚想说失去……",[81,94,95],{},"任谁都会有失去，不了解失去的苦一定不明白拥有的甜，反之亦然……",[81,97,98],{},"那晚的失去，至少有六个人可以见证……",[81,100,101],{},"胡哥，海军是第一时间的目击者。“梧桐”后我的新车“小宝”还被子弹无情的击中……海军陪我去了派出所折腾到了半夜。于那晚，我信，我们都会难忘……",[81,103,104],{},"接着迎接我的便是亚玲，大花，胖子张羽，胖子谭璇共同见证的一次酩酊……真的想对你们说声谢谢！",[81,106,107],{},"真的……在我想有人陪的时候你们总会准时的出现在我身边……我希望，在你们需要的时候……我也可以！",[81,109,110],{},"人生最玄妙在于……我们的承受……",[81,112,113],{},"那晚的失去，现在想来却是我最大的拥有……但那一夜，我却如同个失落的孩子……",[81,115,116],{},"所以，也许我们该感谢每一次的失去……因为……没有失去，便不会拥有……",[81,118,119],{},"对了，大家的留言，无论这里还是贴吧，我都会看……",[81,121,122],{},"每一条……",[81,124,125],{},"我不会回复，但在心里…………………………它们，都有答案……",[81,127,128],{},"都有。",{"title":130,"searchDepth":131,"depth":131,"links":132},"",2,[],[6],"今晚想说失去……","md",{"date":137},"2010-04-25 22:37",true,"\u002Fblog\u002Fblog_4af9831b0100i4l0",{"title":70,"description":134},"blog\u002Fblog_4af9831b0100i4l0",[143],"杂谈","k8G0rXWeKhxJgfNsy8aCdWlH3iU72Hy2XT-zL68BYpg",[146,149],{"title":73,"path":147,"stem":148,"children":-1,"slug":74},"\u002Fblog\u002Fblog_4af9831b0100i0mz","blog\u002Fblog_4af9831b0100i0mz",{"title":67,"path":150,"stem":151,"children":-1,"slug":68},"\u002Fblog\u002Fblog_4af9831b0100j000","blog\u002Fblog_4af9831b0100j000",1794412499640]
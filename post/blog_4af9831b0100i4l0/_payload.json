[{"data":1,"prerenderedAt":111},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":17,"blog-post-slug-blog_4af9831b0100i4l0":34,"surround-blog_4af9831b0100i4l0":104},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"latestBlog":18},[19,22,25,28,31],{"title":20,"slug":21},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":23,"slug":24},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":26,"slug":27},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":29,"slug":30},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":32,"slug":33},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":35,"title":29,"body":36,"categories":92,"description":93,"extension":94,"meta":95,"navigation":97,"path":98,"seo":99,"slug":30,"stem":100,"tags":101,"__hash__":103},"blog\u002Fblog\u002Fblog_4af9831b0100i4l0.md",{"type":37,"value":38,"toc":88},"minimark",[39,43,46,49,52,55,58,61,64,67,70,73,76,79,82,85],[40,41,42],"p",{},"今天‘春哥’生日，此春非彼春……很开心，主创聚齐，举杯一醉……",[40,44,45],{},"“七小罗汉”是个挺特别的电影，允许我再一次的自卖自夸。就如同自己生的孩子，每一份牵挂你可以不接受但请你试着去理解！……看吧，反正这个电影我喜欢……",[40,47,48],{},"酒后，又来醒酒……",[40,50,51],{},"说点什么？今晚想说失去……",[40,53,54],{},"任谁都会有失去，不了解失去的苦一定不明白拥有的甜，反之亦然……",[40,56,57],{},"那晚的失去，至少有六个人可以见证……",[40,59,60],{},"胡哥，海军是第一时间的目击者。“梧桐”后我的新车“小宝”还被子弹无情的击中……海军陪我去了派出所折腾到了半夜。于那晚，我信，我们都会难忘……",[40,62,63],{},"接着迎接我的便是亚玲，大花，胖子张羽，胖子谭璇共同见证的一次酩酊……真的想对你们说声谢谢！",[40,65,66],{},"真的……在我想有人陪的时候你们总会准时的出现在我身边……我希望，在你们需要的时候……我也可以！",[40,68,69],{},"人生最玄妙在于……我们的承受……",[40,71,72],{},"那晚的失去，现在想来却是我最大的拥有……但那一夜，我却如同个失落的孩子……",[40,74,75],{},"所以，也许我们该感谢每一次的失去……因为……没有失去，便不会拥有……",[40,77,78],{},"对了，大家的留言，无论这里还是贴吧，我都会看……",[40,80,81],{},"每一条……",[40,83,84],{},"我不会回复，但在心里…………………………它们，都有答案……",[40,86,87],{},"都有。",{"title":89,"searchDepth":90,"depth":90,"links":91},"",2,[],[6],"今晚想说失去……","md",{"date":96},"2010-04-25 22:37",true,"\u002Fblog\u002Fblog_4af9831b0100i4l0",{"title":29,"description":93},"blog\u002Fblog_4af9831b0100i4l0",[102],"杂谈","k8G0rXWeKhxJgfNsy8aCdWlH3iU72Hy2XT-zL68BYpg",[105,108],{"title":32,"path":106,"stem":107,"children":-1,"slug":33},"\u002Fblog\u002Fblog_4af9831b0100i0mz","blog\u002Fblog_4af9831b0100i0mz",{"title":26,"path":109,"stem":110,"children":-1,"slug":27},"\u002Fblog\u002Fblog_4af9831b0100j000","blog\u002Fblog_4af9831b0100j000",1794130303268]
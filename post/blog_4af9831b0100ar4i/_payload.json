[{"data":1,"prerenderedAt":110},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b0100ar4i":31,"surround-blog_4af9831b0100ar4i":99},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",151,{"name":9,"len":10},"有图",34,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":87,"description":33,"extension":88,"meta":89,"navigation":91,"path":92,"seo":93,"slug":94,"stem":95,"tags":96,"__hash__":98},"blog\u002Fblog\u002Fblog_4af9831b0100ar4i.md","痕迹",{"type":35,"value":36,"toc":83},"minimark",[37,41,44,47,50,53,56,59,62,65,68,71,74,77,80],[38,39,40],"p",{},"走过一条路，痕迹或近或远，趟过一条河，痕迹许浅许深，经过一个人呢？……",[38,42,43],{},"心中的痕迹该怎个测量？",[38,45,46],{},"发生了的就是故事，人们带着各自的故事穿梭游荡，等待下一个故事的降临……看似不相干的你我，交会于某个宿命的安排，努力编织个新的开始，彼此一番经历，然后，带着痕迹，离去……",[38,48,49],{},"  别说忘记。",[38,51,52],{},"  没有忘记。",[38,54,55],{},"故事早融进血液，你也许不再惦记，但在某个夜晚，它还是会毫无预兆不期而至……",[38,57,58],{},"  思念，突如其来。感动，排山倒海。刹那，让你心意阑珊让你沧海百年……那一刻，你该明白……",[38,60,61],{},"  无法忘记。",[38,63,64],{},"  因为，那不是一个谁，而是你的一段岁月……",[38,66,67],{},"而今，你来了，带着斑驳，传说满眼……",[38,69,70],{},"我感叹，怅然若失于造物弄人，你放下谁？谁丢了你……？",[38,72,73],{},"  从前……此刻，便是明日的从前……",[38,75,76],{},"  在你的眼中，我看到他们……",[38,78,79],{},"  其实，我们都不曾失去，也无法失去。",[38,81,82],{},"  因为，发生过……便有了痕迹…………",{"title":84,"searchDepth":85,"depth":85,"links":86},"",2,[],[6],"md",{"date":90},"2008-09-25 11:18",true,"\u002Fblog\u002Fblog_4af9831b0100ar4i",{"title":33,"description":33},"blog_4af9831b0100ar4i","blog\u002Fblog_4af9831b0100ar4i",[97],"杂谈","50YoPnHCAPMFj-pwsArwfawcvreRsqBm7On084PiPWU",[100,105],{"title":101,"path":102,"stem":103,"children":-1,"slug":104},"祝福 献给“命运”","\u002Fblog\u002Fblog_4af9831b0100aof0","blog\u002Fblog_
[{"data":1,"prerenderedAt":154},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":58,"blog-post-slug-blog_4af9831b0100ar4i":75,"surround-blog_4af9831b0100ar4i":143},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":54,"site_description":55,"stem":56,"__hash__":57},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo",20,"新浪博客内容备份","settings","hh8X7X6SFDoeJrxIJ4yisZXSc3HwHM1zk206jiQX2XU",{"latestBlog":59},[60,63,66,69,72],{"title":61,"slug":62},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":64,"slug":65},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":67,"slug":68},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":70,"slug":71},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":73,"slug":74},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":76,"title":77,"body":78,"categories":131,"description":87,"extension":132,"meta":133,"navigation":135,"path":136,"seo":137,"slug":138,"stem":139,"tags":140,"__hash__":142},"blog\u002Fblog\u002Fblog_4af9831b0100ar4i.md","痕迹",{"type":79,"value":80,"toc":127},"minimark",[81,85,88,91,94,97,100,103,106,109,112,115,118,121,124],[82,83,84],"p",{},"走过一条路，痕迹或近或远，趟过一条河，痕迹许浅许深，经过一个人呢？……",[82,86,87],{},"心中的痕迹该怎个测量？",[82,89,90],{},"发生了的就是故事，人们带着各自的故事穿梭游荡，等待下一个故事的降临……看似不相干的你我，交会于某个宿命的安排，努力编织个新的开始，彼此一番经历，然后，带着痕迹，离去……",[82,92,93],{},"  别说忘记。",[82,95,96],{},"  没有忘记。",[82,98,99],{},"故事早融进血液，你也许不再惦记，但在某个夜晚，它还是会毫无预兆不期而至……",[82,101,102],{},"  思念，突如其来。感动，排山倒海。刹那，让你心意阑珊让你沧海百年……那一刻，你该明白……",[82,104,105],{},"  无法忘记。",[82,107,108],{},"  因为，那不是一个谁，而是你的一段岁月……",[82,110,111],{},"而今，你来了，带着斑驳，传说满眼……",[82,113,114],{},"我感叹，怅然若失于造物弄人，你放下谁？谁丢了你……？",[82,116,117],{},"  从前……此刻，便是明日的从前……",[82,119,120],{},"  在你的眼中，我看到他们……",[82,122,123],{},"  其实，我们都不曾失去，也无法失去。",[82,125,126],{},"  因为，发生过……便有了痕迹…………",{"title":128,"searchDepth":129,"depth":129,"links":130},"",2,[],[6],"md",{"date":134},"2008-09-25 11:18",true,"\u002Fblog\u002Fblog_4af9831b0100ar4i",{"title":77,"description":87},"blog_4af9831b0100ar4i","blog\u002Fblog_4af9831b0100ar4i",[141],"杂谈","1JiqAjqhHIYFdvnq7dQ_-ruXwkvUEdq726AdjyFOiXA",[144,149],{"title":145,"path":146,"stem":147,"children":-1,"slug":148},"祝福 献给“命运”","\u002Fblog\u002Fblog_4af9831b0100aof0","blog\u002Fblog_4af9831b0100aof0","blog_4af9831b0100aof0",{"title":150,"path":151,"stem":152,"children":-1,"slug":153},"无言","\u002Fblog\u002Fblog_4af9831b0100aynz","blog\u002Fblog_4af9831b0100aynz","blog_4af9831b0100aynz",1794412500643]
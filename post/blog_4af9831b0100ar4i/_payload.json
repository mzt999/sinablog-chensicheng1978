[{"data":1,"prerenderedAt":166},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":70,"blog-post-slug-blog_4af9831b0100ar4i":87,"surround-blog_4af9831b0100ar4i":155},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":45,"navLinks":46,"perPage":16,"prevNextIsExcludeDate":66,"site_description":23,"site_name":67,"stem":68,"__hash__":69},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{},[47,52,56,60,64],{"path":48,"title":49,"target":50,"fa_class":51},"\u002F","博客首页","internal","fa-home",{"path":53,"title":54,"target":50,"fa_class":55},"\u002Fabout","关于","fa-user",{"path":57,"title":58,"target":50,"fa_class":59},"\u002Fpost","归档","fa-archive",{"path":61,"title":62,"target":50,"fa_class":63},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":65,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","jvZHccz2rT-wjVS5GCPgWyhl8WnBIvECPkE5KpKFKCU",{"latestBlog":71},[72,75,78,81,84],{"title":73,"slug":74},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":76,"slug":77},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":79,"slug":80},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":82,"slug":83},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":85,"slug":86},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":88,"title":89,"body":90,"categories":143,"description":99,"extension":144,"meta":145,"navigation":147,"path":148,"seo":149,"slug":150,"stem":151,"tags":152,"__hash__":154},"blog\u002Fblog\u002Fblog_4af9831b0100ar4i.md","痕迹",{"type":91,"value":92,"toc":139},"minimark",[93,97,100,103,106,109,112,115,118,121,124,127,130,133,136],[94,95,96],"p",{},"走过一条路，痕迹或近或远，趟过一条河，痕迹许浅许深，经过一个人呢？……",[94,98,99],{},"心中的痕迹该怎个测量？",[94,101,102],{},"发生了的就是故事，人们带着各自的故事穿梭游荡，等待下一个故事的降临……看似不相干的你我，交会于某个宿命的安排，努力编织个新的开始，彼此一番经历，然后，带着痕迹，离去……",[94,104,105],{},"  别说忘记。",[94,107,108],{},"  没有忘记。",[94,110,111],{},"故事早融进血液，你也许不再惦记，但在某个夜晚，它还是会毫无预兆不期而至……",[94,113,114],{},"  思念，突如其来。感动，排山倒海。刹那，让你心意阑珊让你沧海百年……那一刻，你该明白……",[94,116,117],{},"  无法忘记。",[94,119,120],{},"  因为，那不是一个谁，而是你的一段岁月……",[94,122,123],{},"而今，你来了，带着斑驳，传说满眼……",[94,125,126],{},"我感叹，怅然若失于造物弄人，你放下谁？谁丢了你……？",[94,128,129],{},"  从前……此刻，便是明日的从前……",[94,131,132],{},"  在你的眼中，我看到他们……",[94,134,135],{},"  其实，我们都不曾失去，也无法失去。",[94,137,138],{},"  因为，发生过……便有了痕迹…………",{"title":140,"searchDepth":141,"depth":141,"links":142},"",2,[],[6],"md",{"date":146},"2008-09-25 11:18",true,"\u002Fblog\u002Fblog_4af9831b0100ar4i",{"title":89,"description":99},"blog_4af9831b0100ar4i","blog\u002Fblog_4af9831b0100ar4i",[153],"杂谈","1JiqAjqhHIYFdvnq7dQ_-ruXwkvUEdq726AdjyFOiXA",[156,161],{"title":157,"path":158,"stem":159,"children":-1,"slug":160},"祝福 献给“命运”","\u002Fblog\u002Fblog_4af9831b0100aof0","blog\u002Fblog_4af9831b0100aof0","blog_4af9831b0100aof0",{"title":162,"path":163,"stem":164,"children":-1,"slug":165},"无言","\u002Fblog\u002Fblog_4af9831b0100aynz","blog\u002Fblog_4af9831b0100aynz","blog_4af9831b0100aynz",1794546769717]
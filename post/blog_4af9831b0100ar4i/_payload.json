[{"data":1,"prerenderedAt":113},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":17,"blog-post-slug-blog_4af9831b0100ar4i":34,"surround-blog_4af9831b0100ar4i":102},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"latestBlog":18},[19,22,25,28,31],{"title":20,"slug":21},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":23,"slug":24},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":26,"slug":27},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":29,"slug":30},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":32,"slug":33},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":35,"title":36,"body":37,"categories":90,"description":46,"extension":91,"meta":92,"navigation":94,"path":95,"seo":96,"slug":97,"stem":98,"tags":99,"__hash__":101},"blog\u002Fblog\u002Fblog_4af9831b0100ar4i.md","痕迹",{"type":38,"value":39,"toc":86},"minimark",[40,44,47,50,53,56,59,62,65,68,71,74,77,80,83],[41,42,43],"p",{},"走过一条路，痕迹或近或远，趟过一条河，痕迹许浅许深，经过一个人呢？……",[41,45,46],{},"心中的痕迹该怎个测量？",[41,48,49],{},"发生了的就是故事，人们带着各自的故事穿梭游荡，等待下一个故事的降临……看似不相干的你我，交会于某个宿命的安排，努力编织个新的开始，彼此一番经历，然后，带着痕迹，离去……",[41,51,52],{},"  别说忘记。",[41,54,55],{},"  没有忘记。",[41,57,58],{},"故事早融进血液，你也许不再惦记，但在某个夜晚，它还是会毫无预兆不期而至……",[41,60,61],{},"  思念，突如其来。感动，排山倒海。刹那，让你心意阑珊让你沧海百年……那一刻，你该明白……",[41,63,64],{},"  无法忘记。",[41,66,67],{},"  因为，那不是一个谁，而是你的一段岁月……",[41,69,70],{},"而今，你来了，带着斑驳，传说满眼……",[41,72,73],{},"我感叹，怅然若失于造物弄人，你放下谁？谁丢了你……？",[41,75,76],{},"  从前……此刻，便是明日的从前……",[41,78,79],{},"  在你的眼中，我看到他们……",[41,81,82],{},"  其实，我们都不曾失去，也无法失去。",[41,84,85],{},"  因为，发生过……便有了痕迹…………",{"title":87,"searchDepth":88,"depth":88,"links":89},"",2,[],[6],"md",{"date":93},"2008-09-25 11:18",true,"\u002Fblog\u002Fblog_4af9831b0100ar4i",{"title":36,"description":46},"blog_4af9831b0100ar4i","blog\u002Fblog_4af9831b0100ar4i",[100],"杂谈","1JiqAjqhHIYFdvnq7dQ_-ruXwkvUEdq726AdjyFOiXA",[103,108],{"title":104,"path":105,"stem":106,"children":-1,"slug":107},"祝福 献给“命运”","\u002Fblog\u002Fbl
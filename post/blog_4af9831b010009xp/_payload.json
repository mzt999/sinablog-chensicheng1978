":89,"body":90,"categories":122,"description":123,"extension":124,"meta":125,"navigation":127,"path":128,"seo":129,"slug":130,"stem":131,"tags":132,"__hash__":134},"blog\u002Fblog\u002Fblog_4af9831b010009xp.md","七夕",{"type":91,"value":92,"toc":118},"minimark",[93,97,100,103,106,109,112,115],[94,95,96],"p",{},"必须上来下!时间紧迫!还要出去!",[94,98,99],{},"狗狗已经到家了!是我从小到大见到的最可爱的一只!不是自夸是绝对!明天会发照片上来给大家看!!他太可爱了!!名字?帮我想想?可能就叫\"狗肉\"了小名\"肉肉\"(对不起,我要剽窃某个人的作品了)...或有更好的?",[94,101,102],{},"昨天,18号是小狼的生日.那个我没见过的在湖北上学的东北弟弟.那个\"最老\"的\"老人\".现在对你说生日快乐!真的要快乐!他会在天上看着你的...所以你要幸福给他看要努力给他看!",[94,104,105],{},"还有个老人\"小妮儿思\"同样快乐啊!我还记得!生日快乐,你和小狼很有缘分哦,当然同样和我们!",[94,107,108],{},"还有个新朋友\"小猫\"也对你说生日快乐!虽然你没等到我,但是同样在你明天醒来的那一刻就拥有了这个简单却真挚的祝福!",[94,110,111],{},"此刻,七夕!传说中的中国情人节!没错,该过!何时咱们过这个节比2月14更夸张了就证明咱国力是真的强盛了!",[94,113,114],{},"祝所有的你们身边有个陪伴的可以走更远更幸福...没有的马上就会有...",[94,116,117],{},"祝明年的自己此刻身边会有个人...",{"title":119,"searchDepth":120,"depth":120,"links":121},"",2,[],[6],"狗狗已经到家了!是我从小到大见到的最可爱的一只!","md",{"date":126},"2007-08-19 00:38",true,"\u002Fblog\u002Fblog_4af9831b010009xp",{"title":89,"description":123},"blog_4af9831b010009xp","blog\u002Fblog_4af9831b010009xp",[133],"随笔\u002F感悟","DQg9SRKdlw-fxzpOhoa9oakyee8xTz42jGmSdFokMw0",[136,141],{"title":137,"path":138,"stem":139,"children":-1,"slug":140},"记录昨天下午的打赌","\u002Fblog\u002Fblog_4af9831b010009xd","blog\u002Fblog_4af9831b010009xd","blog_4af9831b010009xd",{"title":142,"path":143,"stem":144,"children":-1,"slug":145},"狗肉永远突击!","\u002Fblog\u002Fblog_4af9831b010009yq","blog\u002Fblog_4af9831b010009yq","blog_4af9831b010009yq",1794544667964]
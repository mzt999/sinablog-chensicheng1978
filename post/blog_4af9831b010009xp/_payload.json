[{"data":1,"prerenderedAt":134},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":58,"blog-post-slug-blog_4af9831b010009xp":75,"surround-blog_4af9831b010009xp":123},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":54,"site_description":55,"stem":56,"__hash__":57},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo",20,"新浪博客内容备份","settings","hh8X7X6SFDoeJrxIJ4yisZXSc3HwHM1zk206jiQX2XU",{"latestBlog":59},[60,63,66,69,72],{"title":61,"slug":62},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":64,"slug":65},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":67,"slug":68},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":70,"slug":71},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":73,"slug":74},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":76,"title":77,"body":78,"categories":110,"description":111,"extension":112,"meta":113,"navigation":115,"path":116,"seo":117,"slug":118,"stem":119,"tags":120,"__hash__":122},"blog\u002Fblog\u002Fblog_4af9831b010009xp.md","七夕",{"type":79,"value":80,"toc":106},"minimark",[81,85,88,91,94,97,100,103],[82,83,84],"p",{},"必须上来下!时间紧迫!还要出去!",[82,86,87],{},"狗狗已经到家了!是我从小到大见到的最可爱的一只!不是自夸是绝对!明天会发照片上来给大家看!!他太可爱了!!名字?帮我想想?可能就叫\"狗肉\"了小名\"肉肉\"(对不起,我要剽窃某个人的作品了)...或有更好的?",[82,89,90],{},"昨天,18号是小狼的生日.那个我没见过的在湖北上学的东北弟弟.那个\"最老\"的\"老人\".现在对你说生日快乐!真的要快乐!他会在天上看着你的...所以你要幸福给他看要努力给他看!",[82,92,93],{},"还有个老人\"小妮儿思\"同样快乐啊!我还记得!生日快乐,你和小狼很有缘分哦,当然同样和我们!",[82,95,96],{},"还有个新朋友\"小猫\"也对你说生日快乐!虽然你没等到我,但是同样在你明天醒来的那一刻就拥有了这个简单却真挚的祝福!",[82,98,99],{},"此刻,七夕!传说中的中国情人节!没错,该过!何时咱们过这个节比2月14更夸张了就证明咱国力是真的强盛了!",[82,101,102],{},"祝所有的你们身边有个陪伴的可以走更远更幸福...没有的马上就会有...",[82,104,105],{},"祝明年的自己此刻身边会有个人...",{"title":107,"searchDepth":108,"depth":108,"links":109},"",2,[],[6],"狗狗已经到家了!是我从小到大见到的最可爱的一只!","md",{"date":114},"2007-08-19 00:38",true,"\u002Fblog\u002Fblog_4af9831b010009xp",{"title":77,"description":111},"blog_4af9831b010009xp","blog\u002Fblog_4af9831b010009xp",[121],"随笔\u002F感悟","DQg9SRKdlw-fxzpOhoa9oakyee8xTz42jGmSdFokMw0",[124,129],{"title":125,"path":126,"stem":127,"children":-1,"slug":128},"记录昨天下午的打赌","\u002Fblog\u002Fblog_4af9831b010009xd","blog\u002Fblog_4af9831b010009xd","blog_4af9831b010009xd",{"title":130,"path":131,"stem":132,"children":-1,"slug":133},"狗肉永远突击!","\u002Fblog\u002Fblog_4af9831b010009yq","blog\u002Fblog_4af9831b010009yq","blog_4af9831b010009yq",1794412501054]
[{"data":1,"prerenderedAt":148},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":70,"blog-post-slug-blog_4af9831b0100088s":87,"surround-blog_4af9831b0100088s":137},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":45,"navLinks":46,"perPage":16,"prevNextIsExcludeDate":66,"site_description":23,"site_name":67,"stem":68,"__hash__":69},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{},[47,52,56,60,64],{"path":48,"title":49,"target":50,"fa_class":51},"\u002F","博客首页","internal","fa-home",{"path":53,"title":54,"target":50,"fa_class":55},"\u002Fabout","关于","fa-user",{"path":57,"title":58,"target":50,"fa_class":59},"\u002Fpost","归档","fa-archive",{"path":61,"title":62,"target":50,"fa_class":63},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":65,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","jvZHccz2rT-wjVS5GCPgWyhl8WnBIvECPkE5KpKFKCU",{"latestBlog":71},[72,75,78,81,84],{"title":73,"slug":74},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":76,"slug":77},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":79,"slug":80},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":82,"slug":83},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":85,"slug":86},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":88,"title":89,"body":90,"categories":125,"description":126,"extension":127,"meta":128,"navigation":130,"path":131,"seo":132,"slug":133,"stem":134,"tags":135,"__hash__":136},"blog\u002Fblog\u002Fblog_4af9831b0100088s.md","爱上梦中人",{"type":91,"value":92,"toc":121},"minimark",[93,97,100,103,106,109,112,115,118],[94,95,96],"p",{},"昨晚再次梦见她.近两个月中的第4次吧.本来上午没戏,想多睡会补觉,可因为习惯和梦把自己弄得一如往常的早起.",[94,98,99],{},"大地震!高楼大厦相继坍塌!我们拉着手逃亡,太多的人死去,被湮灭在废墟中...好象还有另一个男人,是她的表哥...哈哈梦里的惊心动魄醒来后变做笑谈.后来我们逃走了!逃上了回北京的列车.我们还是活了下去...当然也带走了她的表哥...哈哈...还是想笑,但这梦是真的.那张脸也那般的生动鲜活...",[94,101,102],{},"越来越觉得梦是个奇怪的东西.它到底和现实有多少联系呢?谁会解梦帮我想想,这个梦是在预示什么?...",[94,104,105],{},"\"子弹\"拍得很好.继续下去一定是个牛X的东西...剧组血液之年轻应该全国罕见,导演摄影加全部主演的平均年龄在30岁以下.学院派的氛围浓重.昨天演员才算全部进组...掐指一算加上我居然有6个师兄妹.",[94,107,108],{},"今天外面的阳光充足,没带上网卡的我又流窜到另一个房间攀爬入室,实在要把这个梦写下,怕自己忘了,也留个纪念.",[94,110,111],{},"此刻,在我右侧15度的美女在看着\"安妮宝贝\"...窗外,皆是明媚...一阵风吹过却把一切静止住了,又定格成了画面...",[94,113,114],{},"\"现实和梦想到底有多远的距离?\"说这话让我想到了哈姆雷特\"活着还是不活\"",[94,116,117],{},"我还能坚持多久?不妥协?我到底该要怎样的生活?A还是B?",[94,119,120],{},"多远...?梦与你之间到底有多远........?",{"title":122,"searchDepth":123,"depth":123,"links":124},"",2,[],[6],"昨晚再次梦见她.近两个月中的第4次吧.","md",{"date":129},"2007-04-26 11:37",true,"\u002Fblog\u002Fblog_4af9831b0100088s",{"title":89,"description":126},"blog_4af9831b0100088s","blog\u002Fblog_4af9831b0100088s",[],"5D2BX-MM0aOj7CYFUEt9NfZLBuM2vckHVRtXHNLCnns",[138,143],{"title":139,"path":140,"stem":141,"children":-1,"slug":142},"无题","\u002Fblog\u002Fblog_4af9831b0100087z","blog\u002Fblog_4af9831b0100087z","blog_4af9831b0100087z",{"title":144,"path":145,"stem":146,"children":-1,"slug":147},"zhuan tie","\u002Fblog\u002Fblog_4af9831b01000899","blog\u002Fblog_4af9831b01000899","blog_4af9831b01000899",1794546770523]
[{"data":1,"prerenderedAt":91},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b0100088s":31,"surround-blog_4af9831b0100088s":80},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",152,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":69,"description":33,"extension":70,"meta":71,"navigation":73,"path":74,"seo":75,"slug":76,"stem":77,"tags":78,"__hash__":79},"blog\u002Fblog\u002Fblog_4af9831b0100088s.md","爱上梦中人",{"type":35,"value":36,"toc":65},"minimark",[37,41,44,47,50,53,56,59,62],[38,39,40],"p",{},"昨晚再次梦见她.近两个月中的第4次吧.本来上午没戏,想多睡会补觉,可因为习惯和梦把自己弄得一如往常的早起.",[38,42,43],{},"大地震!高楼大厦相继坍塌!我们拉着手逃亡,太多的人死去,被湮灭在废墟中...好象还有另一个男人,是她的表哥...哈哈梦里的惊心动魄醒来后变做笑谈.后来我们逃走了!逃上了回北京的列车.我们还是活了下去...当然也带走了她的表哥...哈哈...还是想笑,但这梦是真的.那张脸也那般的生动鲜活...",[38,45,46],{},"越来越觉得梦是个奇怪的东西.它到底和现实有多少联系呢?谁会解梦帮我想想,这个梦是在预示什么?...",[38,48,49],{},"\"子弹\"拍得很好.继续下去一定是个牛X的东西...剧组血液之年轻应该全国罕见,导演摄影加全部主演的平均年龄在30岁以下.学院派的氛围浓重.昨天演员才算全部进组...掐指一算加上我居然有6个师兄妹.",[38,51,52],{},"今天外面的阳光充足,没带上网卡的我又流窜到另一个房间攀爬入室,实在要把这个梦写下,怕自己忘了,也留个纪念.",[38,54,55],{},"此刻,在我右侧15度的美女在看着\"安妮宝贝\"...窗外,皆是明媚...一阵风吹过却把一切静止住了,又定格成了画面...",[38,57,58],{},"\"现实和梦想到底有多远的距离?\"说这话让我想到了哈姆雷特\"活着还是不活\"",[38,60,61],{},"我还能坚持多久?不妥协?我到底该要怎样的生活?A还是B?",[38,63,64],{},"多远...?梦与你之间到底有多远........?",{"title":66,"searchDepth":67,"depth":67,"links":68},"",2,[],[6],"md",{"date":72},"2007-04-26 11:37",true,"\u002Fblog\u002Fblog_4af9831b0100088s",{"title":33,"description":33},"blog_4af9831b0100088s","blog\u002Fblog_4af9831b0100088s",[],"SJ7geQPw7n-EDf6TG6lVfx3AIHvC7I2MavJAsbRq6Ts",[81,86],{"title":82,"path":83,"stem":84,"children":-1,"slug":85},"无题","\u002Fblog\u002Fblog_4af9831b0100087z","blog\u002Fblog_4af9831b0100087z","blog_4af9831b0100087z",{"title":87,"path":88,"stem":89,"children":-1,"slug":90},"zhuan tie","\u002Fblog\u002Fblog_4af9831b01000899","blog\u002Fblog_4af9831b01000899","blog_4af9831b01000899",1793979251146]
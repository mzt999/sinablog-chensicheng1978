[{"data":1,"prerenderedAt":136},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":58,"blog-post-slug-blog_4af9831b0100088s":75,"surround-blog_4af9831b0100088s":125},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":54,"site_description":55,"stem":56,"__hash__":57},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo",20,"新浪博客内容备份","settings","hh8X7X6SFDoeJrxIJ4yisZXSc3HwHM1zk206jiQX2XU",{"latestBlog":59},[60,63,66,69,72],{"title":61,"slug":62},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":64,"slug":65},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":67,"slug":68},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":70,"slug":71},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":73,"slug":74},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":76,"title":77,"body":78,"categories":113,"description":114,"extension":115,"meta":116,"navigation":118,"path":119,"seo":120,"slug":121,"stem":122,"tags":123,"__hash__":124},"blog\u002Fblog\u002Fblog_4af9831b0100088s.md","爱上梦中人",{"type":79,"value":80,"toc":109},"minimark",[81,85,88,91,94,97,100,103,106],[82,83,84],"p",{},"昨晚再次梦见她.近两个月中的第4次吧.本来上午没戏,想多睡会补觉,可因为习惯和梦把自己弄得一如往常的早起.",[82,86,87],{},"大地震!高楼大厦相继坍塌!我们拉着手逃亡,太多的人死去,被湮灭在废墟中...好象还有另一个男人,是她的表哥...哈哈梦里的惊心动魄醒来后变做笑谈.后来我们逃走了!逃上了回北京的列车.我们还是活了下去...当然也带走了她的表哥...哈哈...还是想笑,但这梦是真的.那张脸也那般的生动鲜活...",[82,89,90],{},"越来越觉得梦是个奇怪的东西.它到底和现实有多少联系呢?谁会解梦帮我想想,这个梦是在预示什么?...",[82,92,93],{},"\"子弹\"拍得很好.继续下去一定是个牛X的东西...剧组血液之年轻应该全国罕见,导演摄影加全部主演的平均年龄在30岁以下.学院派的氛围浓重.昨天演员才算全部进组...掐指一算加上我居然有6个师兄妹.",[82,95,96],{},"今天外面的阳光充足,没带上网卡的我又流窜到另一个房间攀爬入室,实在要把这个梦写下,怕自己忘了,也留个纪念.",[82,98,99],{},"此刻,在我右侧15度的美女在看着\"安妮宝贝\"...窗外,皆是明媚...一阵风吹过却把一切静止住了,又定格成了画面...",[82,101,102],{},"\"现实和梦想到底有多远的距离?\"说这话让我想到了哈姆雷特\"活着还是不活\"",[82,104,105],{},"我还能坚持多久?不妥协?我到底该要怎样的生活?A还是B?",[82,107,108],{},"多远...?梦与你之间到底有多远........?",{"title":110,"searchDepth":111,"depth":111,"links":112},"",2,[],[6],"昨晚再次梦见她.近两个月中的第4次吧.","md",{"date":117},"2007-04-26 11:37",true,"\u002Fblog\u002Fblog_4af9831b0100088s",{"title":77,"description":114},"blog_4af9831b0100088s","blog\u002Fblog_4af9831b0100088s",[],"5D2BX-MM0aOj7CYFUEt9NfZLBuM2vckHVRtXHNLCnns",[126,131],{"title":127,"path":128,"stem":129,"children":-1,"slug":130},"无题","\u002Fblog\u002Fblog_4af9831b0100087z","blog\u002Fblog_4af9831b0100087z","blog_4af9831b0100087z",{"title":132,"path":133,"stem":134,"children":-1,"slug":135},"zhuan tie","\u002Fblog\u002Fblog_4af9831b01000899","blog\u002Fblog_4af9831b01000899","blog_4af9831b01000899",1794412501272]
[{"data":1,"prerenderedAt":95},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":17,"blog-post-slug-blog_4af9831b0100088s":34,"surround-blog_4af9831b0100088s":84},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"latestBlog":18},[19,22,25,28,31],{"title":20,"slug":21},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":23,"slug":24},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":26,"slug":27},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":29,"slug":30},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":32,"slug":33},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":35,"title":36,"body":37,"categories":72,"description":73,"extension":74,"meta":75,"navigation":77,"path":78,"seo":79,"slug":80,"stem":81,"tags":82,"__hash__":83},"blog\u002Fblog\u002Fblog_4af9831b0100088s.md","爱上梦中人",{"type":38,"value":39,"toc":68},"minimark",[40,44,47,50,53,56,59,62,65],[41,42,43],"p",{},"昨晚再次梦见她.近两个月中的第4次吧.本来上午没戏,想多睡会补觉,可因为习惯和梦把自己弄得一如往常的早起.",[41,45,46],{},"大地震!高楼大厦相继坍塌!我们拉着手逃亡,太多的人死去,被湮灭在废墟中...好象还有另一个男人,是她的表哥...哈哈梦里的惊心动魄醒来后变做笑谈.后来我们逃走了!逃上了回北京的列车.我们还是活了下去...当然也带走了她的表哥...哈哈...还是想笑,但这梦是真的.那张脸也那般的生动鲜活...",[41,48,49],{},"越来越觉得梦是个奇怪的东西.它到底和现实有多少联系呢?谁会解梦帮我想想,这个梦是在预示什么?...",[41,51,52],{},"\"子弹\"拍得很好.继续下去一定是个牛X的东西...剧组血液之年轻应该全国罕见,导演摄影加全部主演的平均年龄在30岁以下.学院派的氛围浓重.昨天演员才算全部进组...掐指一算加上我居然有6个师兄妹.",[41,54,55],{},"今天外面的阳光充足,没带上网卡的我又流窜到另一个房间攀爬入室,实在要把这个梦写下,怕自己忘了,也留个纪念.",[41,57,58],{},"此刻,在我右侧15度的美女在看着\"安妮宝贝\"...窗外,皆是明媚...一阵风吹过却把一切静止住了,又定格成了画面...",[41,60,61],{},"\"现实和梦想到底有多远的距离?\"说这话让我想到了哈姆雷特\"活着还是不活\"",[41,63,64],{},"我还能坚持多久?不妥协?我到底该要怎样的生活?A还是B?",[41,66,67],{},"多远...?梦与你之间到底有多远........?",{"title":69,"searchDepth":70,"depth":70,"links":71},"",2,[],[6],"昨晚再次梦见她.近两个月中的第4次吧.","md",{"date":76},"2007-04-26 11:37",true,"\u002Fblog\u002Fblog_4af9831b0100088s",{"title":36,"description":73},"blog_4af9831b0100088s","blog\u002Fblog_4af9831b0100088s",[],"5D2BX-MM0aOj7CYFUEt9NfZLBuM2vckHVRtXHNLCnns",[85,90],{"title":86,"path":87,"stem":88,"children":-1,"slug":89},"无题","\u002Fblog\u002Fblog_4af9831b0100087z","blog\u002Fblog_4af9831b0100087z","blog_4af9831b0100087z",{"title":91,"path":92,"stem":93,"children":-1,"slug":94},"zhuan tie","\u002Fblog\u002Fblog_4af9831b01000899","blog\u002Fblog_4af9831b01000899","blog_4af9831b01000899",1794043806076]
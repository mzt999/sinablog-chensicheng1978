82,83],"p",{},[84,85],"img",{"alt":76,"src":86},"\u002Fpic\u002F4af9831b44061095342b6.jpg",[81,88,89],{},"实话实说,这两天够累的...",[81,91,92],{},"实话实说,那天这节目录的挺菜的...",[81,94,95],{},"实话实说,我发现自己还是不擅长\"娱乐\"的...",[81,97,98],{},"实话实说,还是觉得只有\"创作中\"才是最开心的...",[81,100,101],{},"实话实说,怎么如今感觉拍戏中的自己才是\"真实\"的?...",[81,103,104],{},"......................................",[81,106,107],{},"实话实说,昨夜...",[81,109,110],{},"飞机腾空的那个瞬间,灵魂也远离了地面,却愈发的和肉体背道而驰,甚至如同被谁用力的抛向了远处---投掷!!!......",[81,112,113],{},"失了力,我停下.那是一片夜空,空洞,久远,沉默...",[81,115,116],{},"我不奢求飞,却渴望漂浮...此刻,在夜色的寂静中鸟瞰苍生,就这样,凝视...",[81,118,119],{},"神昭示我们,却不指引,从来让我们自己找寻,自己判断,自己经历,自己磕碰,再自己为自己疗伤...青春真的很快苍老,因为我们开始等待.",[81,121,122],{},"谁的实话?谁在实说?一语成诘...",[81,124,125],{},"神的梦话,人在胡说......",{"title":127,"searchDepth":128,"depth":128,"links":129},"",2,[],[6,9],"md",{"date":133},"2007-12-03 20:07",true,"\u002Fblog\u002Fblog_4af9831b01000bs5",{"title":76,"description":89},"blog_4af9831b01000bs5","blog\u002Fblog_4af9831b01000bs5",[140,141,142,143,144],"随笔\u002F感悟","实话实说","新浪","博客","陈思成","rAcUUlE840ARv9Ct5HVIZCdoEUz9TeTJGANeNcCNQ3w",[147,152],{"title":148,"path":149,"stem":150,"children":-1,"slug":151},"星梦奇缘","\u002Fblog\u002Fblog_4af9831b01000bok","blog\u002Fblog_4af9831b01000bok","blog_4af9831b01000bok",{"title":153,"path":154,"stem":155,"children":-1,"slug":156},"温暖","\u002Fblog\u002Fblog_4af9831b01007ntv","blog\u002Fblog_4af9831b01007ntv","blog_4af9831b01007ntv",1794473705524]
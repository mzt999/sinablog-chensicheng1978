},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":88,"slug":89},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":91,"slug":92},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":94,"title":95,"body":96,"categories":149,"description":108,"extension":150,"meta":151,"navigation":153,"path":154,"seo":155,"slug":156,"stem":157,"tags":158,"__hash__":164},"blog\u002Fblog\u002Fblog_4af9831b01000bs5.md","实话实说?",{"type":97,"value":98,"toc":145},"minimark",[99,106,109,112,115,118,121,124,127,130,133,136,139,142],[100,101,102],"p",{},[103,104],"img",{"alt":95,"src":105},"\u002Fpic\u002F4af9831b44061095342b6.jpg",[100,107,108],{},"实话实说,这两天够累的...",[100,110,111],{},"实话实说,那天这节目录的挺菜的...",[100,113,114],{},"实话实说,我发现自己还是不擅长\"娱乐\"的...",[100,116,117],{},"实话实说,还是觉得只有\"创作中\"才是最开心的...",[100,119,120],{},"实话实说,怎么如今感觉拍戏中的自己才是\"真实\"的?...",[100,122,123],{},"......................................",[100,125,126],{},"实话实说,昨夜...",[100,128,129],{},"飞机腾空的那个瞬间,灵魂也远离了地面,却愈发的和肉体背道而驰,甚至如同被谁用力的抛向了远处---投掷!!!......",[100,131,132],{},"失了力,我停下.那是一片夜空,空洞,久远,沉默...",[100,134,135],{},"我不奢求飞,却渴望漂浮...此刻,在夜色的寂静中鸟瞰苍生,就这样,凝视...",[100,137,138],{},"神昭示我们,却不指引,从来让我们自己找寻,自己判断,自己经历,自己磕碰,再自己为自己疗伤...青春真的很快苍老,因为我们开始等待.",[100,140,141],{},"谁的实话?谁在实说?一语成诘...",[100,143,144],{},"神的梦话,人在胡说......",{"title":146,"searchDepth":147,"depth":147,"links":148},"",2,[],[6,9],"md",{"date":152},"2007-12-03 20:07",true,"\u002Fblog\u002Fblog_4af9831b01000bs5",{"title":95,"description":108},"blog_4af9831b01000bs5","blog\u002Fblog_4af9831b01000bs5",[159,160,161,162,163],"随笔\u002F感悟","实话实说","新浪","博客","陈思成","rAcUUlE840ARv9Ct5HVIZCdoEUz9TeTJGANeNcCNQ3w",[166,171],{"title":167,"path":168,"stem":169,"children":-1,"slug":170},"星梦奇缘","\u002Fblog\u002Fblog_4af9831b01000bok","blog\u002Fblog_4af9831b01000bok","blog_4af9831b01000bok",{"title":172,"path":173,"stem":174,"children":-1,"slug":175},"温暖","\u002Fblog\u002Fblog_4af9831b01007ntv","blog\u002Fblog_4af9831b01007ntv","blog_4af9831b01007ntv",1795162025959]
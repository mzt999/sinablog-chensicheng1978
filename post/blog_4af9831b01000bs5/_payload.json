,84],"p",{},[85,86],"img",{"alt":77,"src":87},"\u002Fpic\u002F4af9831b44061095342b6.jpg",[82,89,90],{},"实话实说,这两天够累的...",[82,92,93],{},"实话实说,那天这节目录的挺菜的...",[82,95,96],{},"实话实说,我发现自己还是不擅长\"娱乐\"的...",[82,98,99],{},"实话实说,还是觉得只有\"创作中\"才是最开心的...",[82,101,102],{},"实话实说,怎么如今感觉拍戏中的自己才是\"真实\"的?...",[82,104,105],{},"......................................",[82,107,108],{},"实话实说,昨夜...",[82,110,111],{},"飞机腾空的那个瞬间,灵魂也远离了地面,却愈发的和肉体背道而驰,甚至如同被谁用力的抛向了远处---投掷!!!......",[82,113,114],{},"失了力,我停下.那是一片夜空,空洞,久远,沉默...",[82,116,117],{},"我不奢求飞,却渴望漂浮...此刻,在夜色的寂静中鸟瞰苍生,就这样,凝视...",[82,119,120],{},"神昭示我们,却不指引,从来让我们自己找寻,自己判断,自己经历,自己磕碰,再自己为自己疗伤...青春真的很快苍老,因为我们开始等待.",[82,122,123],{},"谁的实话?谁在实说?一语成诘...",[82,125,126],{},"神的梦话,人在胡说......",{"title":128,"searchDepth":129,"depth":129,"links":130},"",2,[],[6,9],"md",{"date":134},"2007-12-03 20:07",true,"\u002Fblog\u002Fblog_4af9831b01000bs5",{"title":77,"description":90},"blog_4af9831b01000bs5","blog\u002Fblog_4af9831b01000bs5",[141,142,143,144,145],"随笔\u002F感悟","实话实说","新浪","博客","陈思成","rAcUUlE840ARv9Ct5HVIZCdoEUz9TeTJGANeNcCNQ3w",[148,153],{"title":149,"path":150,"stem":151,"children":-1,"slug":152},"星梦奇缘","\u002Fblog\u002Fblog_4af9831b01000bok","blog\u002Fblog_4af9831b01000bok","blog_4af9831b01000bok",{"title":154,"path":155,"stem":156,"children":-1,"slug":157},"温暖","\u002Fblog\u002Fblog_4af9831b01007ntv","blog\u002Fblog_4af9831b01007ntv","blog_4af9831b01007ntv",1794412500842]
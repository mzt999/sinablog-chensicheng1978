":89,"body":90,"categories":143,"description":102,"extension":144,"meta":145,"navigation":147,"path":148,"seo":149,"slug":150,"stem":151,"tags":152,"__hash__":158},"blog\u002Fblog\u002Fblog_4af9831b01000bs5.md","实话实说?",{"type":91,"value":92,"toc":139},"minimark",[93,100,103,106,109,112,115,118,121,124,127,130,133,136],[94,95,96],"p",{},[97,98],"img",{"alt":89,"src":99},"\u002Fpic\u002F4af9831b44061095342b6.jpg",[94,101,102],{},"实话实说,这两天够累的...",[94,104,105],{},"实话实说,那天这节目录的挺菜的...",[94,107,108],{},"实话实说,我发现自己还是不擅长\"娱乐\"的...",[94,110,111],{},"实话实说,还是觉得只有\"创作中\"才是最开心的...",[94,113,114],{},"实话实说,怎么如今感觉拍戏中的自己才是\"真实\"的?...",[94,116,117],{},"......................................",[94,119,120],{},"实话实说,昨夜...",[94,122,123],{},"飞机腾空的那个瞬间,灵魂也远离了地面,却愈发的和肉体背道而驰,甚至如同被谁用力的抛向了远处---投掷!!!......",[94,125,126],{},"失了力,我停下.那是一片夜空,空洞,久远,沉默...",[94,128,129],{},"我不奢求飞,却渴望漂浮...此刻,在夜色的寂静中鸟瞰苍生,就这样,凝视...",[94,131,132],{},"神昭示我们,却不指引,从来让我们自己找寻,自己判断,自己经历,自己磕碰,再自己为自己疗伤...青春真的很快苍老,因为我们开始等待.",[94,134,135],{},"谁的实话?谁在实说?一语成诘...",[94,137,138],{},"神的梦话,人在胡说......",{"title":140,"searchDepth":141,"depth":141,"links":142},"",2,[],[6,9],"md",{"date":146},"2007-12-03 20:07",true,"\u002Fblog\u002Fblog_4af9831b01000bs5",{"title":89,"description":102},"blog_4af9831b01000bs5","blog\u002Fblog_4af9831b01000bs5",[153,154,155,156,157],"随笔\u002F感悟","实话实说","新浪","博客","陈思成","rAcUUlE840ARv9Ct5HVIZCdoEUz9TeTJGANeNcCNQ3w",[160,165],{"title":161,"path":162,"stem":163,"children":-1,"slug":164},"星梦奇缘","\u002Fblog\u002Fblog_4af9831b01000bok","blog\u002Fblog_4af9831b01000bok","blog_4af9831b01000bok",{"title":166,"path":167,"stem":168,"children":-1,"slug":169},"温暖","\u002Fblog\u002Fblog_4af9831b01007ntv","blog\u002Fblog_4af9831b01007ntv","blog_4af9831b01007ntv",1794544667807]
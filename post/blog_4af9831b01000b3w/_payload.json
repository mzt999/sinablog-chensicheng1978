[{"data":1,"prerenderedAt":171},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":58,"blog-post-slug-blog_4af9831b01000b3w":75,"surround-blog_4af9831b01000b3w":160},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":54,"site_description":55,"stem":56,"__hash__":57},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo",20,"新浪博客内容备份","settings","hh8X7X6SFDoeJrxIJ4yisZXSc3HwHM1zk206jiQX2XU",{"latestBlog":59},[60,63,66,69,72],{"title":61,"slug":62},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":64,"slug":65},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":67,"slug":68},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":70,"slug":71},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":73,"slug":74},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":76,"title":77,"body":78,"categories":146,"description":147,"extension":148,"meta":149,"navigation":151,"path":152,"seo":153,"slug":154,"stem":155,"tags":156,"__hash__":159},"blog\u002Fblog\u002Fblog_4af9831b01000b3w.md","太阳照常升起……",{"type":79,"value":80,"toc":142},"minimark",[81,85,88,91,94,97,100,103,106,109,112,115,118,121,124,130,133,136,139],[82,83,84],"p",{},"昨天，终于看到了9年后的“太阳”照常升起。30岁，35岁，44岁。一个男人的三部电影。三段人生。",[82,86,87],{},"该说什么？好？坏？",[82,89,90],{},"反正别人看到的我可能没看到，别人没看到的我也许见了些……",[82,92,93],{},"那男人说：这电影是说生命中的“偶然”，一切偶然都是必然，一切必然也都是偶然……",[82,95,96],{},"那男人说：神话就是诋毁……",[82,98,99],{},"那男人还说：一个导演就看前三部……",[82,101,102],{},"14年，三部电影。",[82,104,105],{},"他和我们一样等得太久吧，等到了现在，等到了该等到的，却丧失了最单纯最原始的……",[82,107,108],{},"我只看到了一个人生路上的全美定格！一个不会放弃背叛的男人因为苍老因为妥协或真的是因为找到而做出的勇敢决定和宣言！一个男人给一个女人和一个他们一同创造的1\u002F2匀力新个体的一个庄严承诺！一个落寞的王者为曾经的辉煌的一个祭奠！一个用数十万尺胶片拍出来的三人全家福……",[82,110,111],{},"也许还有几个\"他\"或\"她\"梦中的画面……",[82,113,114],{},"该祝福他们，为爱情，为新生，为了我曾经的“太阳”？",[82,116,117],{},"还是该惋惜？该扼腕？该悲叹？为了不再回头的激情与迷茫？为了天才的陨落与坍塌？还是为了本该硕大无朋的中国电影舞台上却寥寥的几个孤寂背影？",[82,119,120],{},"别的，我没见。",[82,122,123],{},"是自己长大了？也不是。从前该感动的依旧感动。那就不是我变了，是别的谁变了？",[82,125,126],{},[127,128,129],"em",{},"一代人来，一代人走，大地永存。太阳升起，又匆忙回到原来的地方，太阳照常升起……（圣经旧约）",[82,131,132],{},"我也曾经认为太阳只有一个，可现在还真不这样看了！",[82,134,135],{},"太阳照常升起，没错，可谁知明天的太阳是怎样？",[82,137,138],{},"每天都会有一个太阳，每天的太阳在我们眼前却都不一样。",[82,140,141],{},"好吧，既然这个太阳已经快落山了，那么就让我们穿越短暂的黑暗和等待去静候下一个太阳吧……",{"title":143,"searchDepth":144,"depth":144,"links":145},"",2,[],[6],"昨天，终于看到了9年后的“太阳”照常升起。","md",{"date":150},"2007-10-02 00:00",true,"\u002Fblog\u002Fblog_4af9831b01000b3w",{"title":77,"description":147},"blog_4af9831b01000b3w","blog\u002Fblog_4af9831b01000b3w",[157,158],"随笔\u002F感悟","感悟随笔","Aow5GOZQZclon6gg0PxMyShjBDEYWM9Nt3VQmWaG2Ss",[161,166],{"title":162,"path":163,"stem":164,"children":-1,"slug":165},"回信1","\u002Fblog\u002Fblog_4af9831b01000acx","blog\u002Fblog_4af9831b01000acx","blog_4af9831b01000acx",{"title":167,"path":168,"stem":169,"children":-1,"slug":170},"《狭路相逢》剧照","\u002Fblog\u002Fblog_4af9831b01000b4u","blog\u002Fblog_4af9831b01000b4u","blog_4af9831b01000b4u",1794412500935]
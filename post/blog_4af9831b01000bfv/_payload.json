[{"data":1,"prerenderedAt":140},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":70,"blog-post-slug-blog_4af9831b01000bfv":87,"surround-blog_4af9831b01000bfv":129},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":45,"navLinks":46,"perPage":16,"prevNextIsExcludeDate":66,"site_description":23,"site_name":67,"stem":68,"__hash__":69},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{},[47,52,56,60,64],{"path":48,"title":49,"target":50,"fa_class":51},"\u002F","博客首页","internal","fa-home",{"path":53,"title":54,"target":50,"fa_class":55},"\u002Fabout","关于","fa-user",{"path":57,"title":58,"target":50,"fa_class":59},"\u002Fpost","归档","fa-archive",{"path":61,"title":62,"target":50,"fa_class":63},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":65,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","jvZHccz2rT-wjVS5GCPgWyhl8WnBIvECPkE5KpKFKCU",{"latestBlog":71},[72,75,78,81,84],{"title":73,"slug":74},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":76,"slug":77},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":79,"slug":80},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":82,"slug":83},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":85,"slug":86},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":88,"title":89,"body":90,"categories":116,"description":117,"extension":118,"meta":119,"navigation":121,"path":122,"seo":123,"slug":124,"stem":125,"tags":126,"__hash__":128},"blog\u002Fblog\u002Fblog_4af9831b01000bfv.md","北京的冬天",{"type":91,"value":92,"toc":112},"minimark",[93,97,100,103,106,109],[94,95,96],"p",{},"回到了北京.终于.今天是老爸的阴历生日,祝他生日快乐.生日礼物是一起陪他在香港挑选的\"帝陀\"表.他早带上了.",[94,98,99],{},"一会要到561同志家聚会,他家的乔迁之喜.康师傅249老7班长等在京无业人员均会参加.我晚点会发点照片来给大家.",[94,101,102],{},"北京入了深秋,冬意很明显了.萧瑟肃然.叶子早红了,更有些凋落了.",[94,104,105],{},"昨天一天的抖擞,换来了今天莫名的惆怅...其实也不莫名,总觉得灵魂该有个去处,本想找个地方寄居,却发现错了方向.",[94,107,108],{},"我喜欢此时的北京,这种温度没有冷到人窒息,冷得刚刚好,仿佛比初春更适合恋爱,因为这个温度是个适合拥抱的温度...身边总络绎不绝的朋友,但还是少了点什么,少了那个真正懂我的人?那个可以此刻牵着她的手一同登到香山顶去看红叶听秋风的红颜...风会抚过她的长发,她回头看我,她的眸子一定不会太透明,却又专注而痴迷,闪亮藏在梦一般的帘雾之后,她微微一笑,那笑会在瞬间融化我心中所有的冰雪.我牵起她的手,她靠在我的肩,在她发的香中,我们一同向斜阳...她真的存在吗?还是只存活于梦中?",[94,110,111],{},"北京的冬天就要来了,我却就要到另个城市去.唯一的行李是梦想,最后的宿命是孤独,一个人上路,一个人守侯,一个人拥有...",{"title":113,"searchDepth":114,"depth":114,"links":115},"",2,[],[6],"回到了北京.终于.今天是老爸的阴历生日,祝他生日快乐.","md",{"date":120},"2007-10-31 15:12",true,"\u002Fblog\u002Fblog_4af9831b01000bfv",{"title":89,"description":117},"blog_4af9831b01000bfv","blog\u002Fblog_4af9831b01000bfv",[127],"随笔\u002F感悟","V-inIURhQWqFU56Ry_PkqLTcaIq9anuzYmezUmL5Zi0",[130,135],{"title":131,"path":132,"stem":133,"children":-1,"slug":134},"明天","\u002Fblog\u002Fblog_4af9831b01000bb0","blog\u002Fblog_4af9831b01000bb0","blog_4af9831b01000bb0",{"title":136,"path":137,"stem":138,"children":-1,"slug":139},"士兵\"突击\"艺术人生","\u002Fblog\u002Fblog_4af9831b01000bjl","blog\u002Fblog_4af9831b01000bjl","blog_4af9831b01000bjl",1794546769980]
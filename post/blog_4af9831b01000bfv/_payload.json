[{"data":1,"prerenderedAt":83},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b01000bfv":31,"surround-blog_4af9831b01000bfv":72},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",152,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":60,"description":33,"extension":61,"meta":62,"navigation":64,"path":65,"seo":66,"slug":67,"stem":68,"tags":69,"__hash__":71},"blog\u002Fblog\u002Fblog_4af9831b01000bfv.md","北京的冬天",{"type":35,"value":36,"toc":56},"minimark",[37,41,44,47,50,53],[38,39,40],"p",{},"回到了北京.终于.今天是老爸的阴历生日,祝他生日快乐.生日礼物是一起陪他在香港挑选的\"帝陀\"表.他早带上了.",[38,42,43],{},"一会要到561同志家聚会,他家的乔迁之喜.康师傅249老7班长等在京无业人员均会参加.我晚点会发点照片来给大家.",[38,45,46],{},"北京入了深秋,冬意很明显了.萧瑟肃然.叶子早红了,更有些凋落了.",[38,48,49],{},"昨天一天的抖擞,换来了今天莫名的惆怅...其实也不莫名,总觉得灵魂该有个去处,本想找个地方寄居,却发现错了方向.",[38,51,52],{},"我喜欢此时的北京,这种温度没有冷到人窒息,冷得刚刚好,仿佛比初春更适合恋爱,因为这个温度是个适合拥抱的温度...身边总络绎不绝的朋友,但还是少了点什么,少了那个真正懂我的人?那个可以此刻牵着她的手一同登到香山顶去看红叶听秋风的红颜...风会抚过她的长发,她回头看我,她的眸子一定不会太透明,却又专注而痴迷,闪亮藏在梦一般的帘雾之后,她微微一笑,那笑会在瞬间融化我心中所有的冰雪.我牵起她的手,她靠在我的肩,在她发的香中,我们一同向斜阳...她真的存在吗?还是只存活于梦中?",[38,54,55],{},"北京的冬天就要来了,我却就要到另个城市去.唯一的行李是梦想,最后的宿命是孤独,一个人上路,一个人守侯,一个人拥有...",{"title":57,"searchDepth":58,"depth":58,"links":59},"",2,[],[6],"md",{"date":63},"2007-10-31 15:12",true,"\u002Fblog\u002Fblog_4af9831b01000bfv",{"title":33,"description":33},"blog_4af9831b01000bfv","blog\u002Fblog_4af9831b01000bfv",[70],"随笔\u002F感悟","LGPrXC8wlqGyl4BASxkXLKAROfz70jK5VWOWUnfQ-DY",[73,78],{"title":74,"path":75,"stem":76,"children":-1,"slug":77},"明天","\u002Fblog\u002Fblog_4af9831b01000bb0","blog\u002Fblog_4af9831b01000bb0","blog_4af9831b01000bb0",{"title":79,"path":80,"stem":81,"children":-1,"slug":82},"士兵\"突击\"艺术人生","\u002Fblog\u002Fblog_4af9831b01000bjl","blog\u002Fblog_4af9831b01000bjl","blog_4af9831b01000bjl",1793968391466]
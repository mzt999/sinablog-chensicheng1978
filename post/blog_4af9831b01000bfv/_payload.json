[{"data":1,"prerenderedAt":87},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":17,"blog-post-slug-blog_4af9831b01000bfv":34,"surround-blog_4af9831b01000bfv":76},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"latestBlog":18},[19,22,25,28,31],{"title":20,"slug":21},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":23,"slug":24},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":26,"slug":27},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":29,"slug":30},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":32,"slug":33},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":35,"title":36,"body":37,"categories":63,"description":64,"extension":65,"meta":66,"navigation":68,"path":69,"seo":70,"slug":71,"stem":72,"tags":73,"__hash__":75},"blog\u002Fblog\u002Fblog_4af9831b01000bfv.md","北京的冬天",{"type":38,"value":39,"toc":59},"minimark",[40,44,47,50,53,56],[41,42,43],"p",{},"回到了北京.终于.今天是老爸的阴历生日,祝他生日快乐.生日礼物是一起陪他在香港挑选的\"帝陀\"表.他早带上了.",[41,45,46],{},"一会要到561同志家聚会,他家的乔迁之喜.康师傅249老7班长等在京无业人员均会参加.我晚点会发点照片来给大家.",[41,48,49],{},"北京入了深秋,冬意很明显了.萧瑟肃然.叶子早红了,更有些凋落了.",[41,51,52],{},"昨天一天的抖擞,换来了今天莫名的惆怅...其实也不莫名,总觉得灵魂该有个去处,本想找个地方寄居,却发现错了方向.",[41,54,55],{},"我喜欢此时的北京,这种温度没有冷到人窒息,冷得刚刚好,仿佛比初春更适合恋爱,因为这个温度是个适合拥抱的温度...身边总络绎不绝的朋友,但还是少了点什么,少了那个真正懂我的人?那个可以此刻牵着她的手一同登到香山顶去看红叶听秋风的红颜...风会抚过她的长发,她回头看我,她的眸子一定不会太透明,却又专注而痴迷,闪亮藏在梦一般的帘雾之后,她微微一笑,那笑会在瞬间融化我心中所有的冰雪.我牵起她的手,她靠在我的肩,在她发的香中,我们一同向斜阳...她真的存在吗?还是只存活于梦中?",[41,57,58],{},"北京的冬天就要来了,我却就要到另个城市去.唯一的行李是梦想,最后的宿命是孤独,一个人上路,一个人守侯,一个人拥有...",{"title":60,"searchDepth":61,"depth":61,"links":62},"",2,[],[6],"回到了北京.终于.今天是老爸的阴历生日,祝他生日快乐.","md",{"date":67},"2007-10-31 15:12",true,"\u002Fblog\u002Fblog_4af9831b01000bfv",{"title":36,"description":64},"blog_4af9831b01000bfv","blog\u002Fblog_4af9831b01000bfv",[74],"随笔\u002F感悟","V-inIURhQWqFU56Ry_PkqLTcaIq9anuzYmezUmL5Zi0",[77,82],{"title":78,"path":79,"stem":80,"children":-1,"slug":81},"明天","\u002Fblog\u002Fblog_4af9831b01000bb0","blog\u002Fblog_4af9831b01000bb0","blog_4af9831b01000bb0",{"title":83,"path":84,"stem":85,"children":-1,"slug":86},"士兵\"突击\"艺术人生","\u002Fblog\u002Fblog_4af9831b01000bjl","blog\u002Fblog_4af9831b01000bjl","blog_4af9831b01000bjl",1794129445610]
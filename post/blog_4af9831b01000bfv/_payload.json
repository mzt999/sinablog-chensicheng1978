[{"data":1,"prerenderedAt":146},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":76,"blog-post-slug-blog_4af9831b01000bfv":93,"surround-blog_4af9831b01000bfv":135},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":38,"meta":50,"navLinks":51,"perPage":16,"prevNextIsExcludeDate":71,"site_description":72,"site_name":73,"stem":74,"__hash__":75},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,26,32],{"text":23},"粉丝自制非官方站点｜素材版权归原权利人所有",{"text":25},"仅兴趣交流、无商业用途｜如有侵权请联系删除",{"text":27,"link":28},"查看",{"href":29,"text":30,"fa_class":31},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":33,"link":34},"如有任何疑问，欢迎",{"href":35,"text":36,"fa_class":37},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[39,42,45,47],{"href":40,"text":41},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":43,"text":44},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":46},"新浪微博备份(2009-2026)",{"href":48,"text":49},"https:\u002F\u002Fmzt999.github.io\u002Fportfolio-chensicheng1978","幕后作品集展示(2012-2026)",{},[52,57,61,65,69],{"path":53,"title":54,"target":55,"fa_class":56},"\u002F","博客首页","internal","fa-home",{"path":58,"title":59,"target":55,"fa_class":60},"\u002Fabout","关于","fa-user",{"path":62,"title":63,"target":55,"fa_class":64},"\u002Fpost","归档","fa-archive",{"path":66,"title":67,"target":55,"fa_class":68},"\u002Fgallery","相册","fa-image",{"path":29,"title":30,"target":70,"fa_class":31},"otherSite",false,"新浪博客内容备份(粉丝自用)","陈思诚的博客","settings","5S7xKt0XLHpkjipbomx4I7pUu50Y7wqtD418LquZj5Q",{"latestBlog":77},[78,81,84,87,90],{"title":79,"slug":80},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":82,"slug":83},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":85,"slug":86},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":88,"slug":89},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":91,"slug":92},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":94,"title":95,"body":96,"categories":122,"description":123,"extension":124,"meta":125,"navigation":127,"path":128,"seo":129,"slug":130,"stem":131,"tags":132,"__hash__":134},"blog\u002Fblog\u002Fblog_4af9831b01000bfv.md","北京的冬天",{"type":97,"value":98,"toc":118},"minimark",[99,103,106,109,112,115],[100,101,102],"p",{},"回到了北京.终于.今天是老爸的阴历生日,祝他生日快乐.生日礼物是一起陪他在香港挑选的\"帝陀\"表.他早带上了.",[100,104,105],{},"一会要到561同志家聚会,他家的乔迁之喜.康师傅249老7班长等在京无业人员均会参加.我晚点会发点照片来给大家.",[100,107,108],{},"北京入了深秋,冬意很明显了.萧瑟肃然.叶子早红了,更有些凋落了.",[100,110,111],{},"昨天一天的抖擞,换来了今天莫名的惆怅...其实也不莫名,总觉得灵魂该有个去处,本想找个地方寄居,却发现错了方向.",[100,113,114],{},"我喜欢此时的北京,这种温度没有冷到人窒息,冷得刚刚好,仿佛比初春更适合恋爱,因为这个温度是个适合拥抱的温度...身边总络绎不绝的朋友,但还是少了点什么,少了那个真正懂我的人?那个可以此刻牵着她的手一同登到香山顶去看红叶听秋风的红颜...风会抚过她的长发,她回头看我,她的眸子一定不会太透明,却又专注而痴迷,闪亮藏在梦一般的帘雾之后,她微微一笑,那笑会在瞬间融化我心中所有的冰雪.我牵起她的手,她靠在我的肩,在她发的香中,我们一同向斜阳...她真的存在吗?还是只存活于梦中?",[100,116,117],{},"北京的冬天就要来了,我却就要到另个城市去.唯一的行李是梦想,最后的宿命是孤独,一个人上路,一个人守侯,一个人拥有...",{"title":119,"searchDepth":120,"depth":120,"links":121},"",2,[],[6],"回到了北京.终于.今天是老爸的阴历生日,祝他生日快乐.","md",{"date":126},"2007-10-31 15:12",true,"\u002Fblog\u002Fblog_4af9831b01000bfv",{"title":95,"description":123},"blog_4af9831b01000bfv","blog\u002Fblog_4af9831b01000bfv",[133],"随笔\u002F感悟","V-inIURhQWqFU56Ry_PkqLTcaIq9anuzYmezUmL5Zi0",[136,141],{"title":137,"path":138,"stem":139,"children":-1,"slug":140},"明天","\u002Fblog\u002Fblog_4af9831b01000bb0","blog\u002Fblog_4af9831b01000bb0","blog_4af9831b01000bb0",{"title":142,"path":143,"stem":144,"children":-1,"slug":145},"士兵\"突击\"艺术人生","\u002Fblog\u002Fblog_4af9831b01000bjl","blog\u002Fblog_4af9831b01000bjl","blog_4af9831b01000bjl",1795162025987]
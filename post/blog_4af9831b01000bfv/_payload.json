[{"data":1,"prerenderedAt":127},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":57,"blog-post-slug-blog_4af9831b01000bfv":74,"surround-blog_4af9831b01000bfv":116},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":16,"site_description":54,"stem":55,"__hash__":56},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo","新浪博客内容备份(粉丝自用)","settings","jPD1QWrYwbaIixg6lntppEYe-T3ZGd3EJZxFBkbKY9E",{"latestBlog":58},[59,62,65,68,71],{"title":60,"slug":61},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":63,"slug":64},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":66,"slug":67},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":69,"slug":70},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":72,"slug":73},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":75,"title":76,"body":77,"categories":103,"description":104,"extension":105,"meta":106,"navigation":108,"path":109,"seo":110,"slug":111,"stem":112,"tags":113,"__hash__":115},"blog\u002Fblog\u002Fblog_4af9831b01000bfv.md","北京的冬天",{"type":78,"value":79,"toc":99},"minimark",[80,84,87,90,93,96],[81,82,83],"p",{},"回到了北京.终于.今天是老爸的阴历生日,祝他生日快乐.生日礼物是一起陪他在香港挑选的\"帝陀\"表.他早带上了.",[81,85,86],{},"一会要到561同志家聚会,他家的乔迁之喜.康师傅249老7班长等在京无业人员均会参加.我晚点会发点照片来给大家.",[81,88,89],{},"北京入了深秋,冬意很明显了.萧瑟肃然.叶子早红了,更有些凋落了.",[81,91,92],{},"昨天一天的抖擞,换来了今天莫名的惆怅...其实也不莫名,总觉得灵魂该有个去处,本想找个地方寄居,却发现错了方向.",[81,94,95],{},"我喜欢此时的北京,这种温度没有冷到人窒息,冷得刚刚好,仿佛比初春更适合恋爱,因为这个温度是个适合拥抱的温度...身边总络绎不绝的朋友,但还是少了点什么,少了那个真正懂我的人?那个可以此刻牵着她的手一同登到香山顶去看红叶听秋风的红颜...风会抚过她的长发,她回头看我,她的眸子一定不会太透明,却又专注而痴迷,闪亮藏在梦一般的帘雾之后,她微微一笑,那笑会在瞬间融化我心中所有的冰雪.我牵起她的手,她靠在我的肩,在她发的香中,我们一同向斜阳...她真的存在吗?还是只存活于梦中?",[81,97,98],{},"北京的冬天就要来了,我却就要到另个城市去.唯一的行李是梦想,最后的宿命是孤独,一个人上路,一个人守侯,一个人拥有...",{"title":100,"searchDepth":101,"depth":101,"links":102},"",2,[],[6],"回到了北京.终于.今天是老爸的阴历生日,祝他生日快乐.","md",{"date":107},"2007-10-31 15:12",true,"\u002Fblog\u002Fblog_4af9831b01000bfv",{"title":76,"description":104},"blog_4af9831b01000bfv","blog\u002Fblog_4af9831b01000bfv",[114],"随笔\u002F感悟","V-inIURhQWqFU56Ry_PkqLTcaIq9anuzYmezUmL5Zi0",[117,122],{"title":118,"path":119,"stem":120,"children":-1,"slug":121},"明天","\u002Fblog\u002Fblog_4af9831b01000bb0","blog\u002Fblog_4af9831b01000bb0","blog_4af9831b01000bb0",{"title":123,"path":124,"stem":125,"children":-1,"slug":126},"士兵\"突击\"艺术人生","\u002Fblog\u002Fblog_4af9831b01000bjl","blog\u002Fblog_4af9831b01000bjl","blog_4af9831b01000bjl",1794473705560]
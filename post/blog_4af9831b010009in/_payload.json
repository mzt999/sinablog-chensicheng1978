[{"data":1,"prerenderedAt":145},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":70,"blog-post-slug-blog_4af9831b010009in":87,"surround-blog_4af9831b010009in":134},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":45,"navLinks":46,"perPage":16,"prevNextIsExcludeDate":66,"site_description":23,"site_name":67,"stem":68,"__hash__":69},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{},[47,52,56,60,64],{"path":48,"title":49,"target":50,"fa_class":51},"\u002F","博客首页","internal","fa-home",{"path":53,"title":54,"target":50,"fa_class":55},"\u002Fabout","关于","fa-user",{"path":57,"title":58,"target":50,"fa_class":59},"\u002Fpost","归档","fa-archive",{"path":61,"title":62,"target":50,"fa_class":63},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":65,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","jvZHccz2rT-wjVS5GCPgWyhl8WnBIvECPkE5KpKFKCU",{"latestBlog":71},[72,75,78,81,84],{"title":73,"slug":74},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":76,"slug":77},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":79,"slug":80},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":82,"slug":83},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":85,"slug":86},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":88,"title":89,"body":90,"categories":122,"description":123,"extension":124,"meta":125,"navigation":127,"path":128,"seo":129,"slug":130,"stem":131,"tags":132,"__hash__":133},"blog\u002Fblog\u002Fblog_4af9831b010009in.md","成才",{"type":91,"value":92,"toc":118},"minimark",[93,97,100,103,106,109,112,115],[94,95,96],"p",{},"昨天和今天，一直到月底，都会为＇士兵＇宣传．＇八一＇她要和全国见面了．一直没有谈论过＇士兵＇和＇成才＇．总觉得我已经超越了他，把他留在了身后．可刚刚到贴吧发现还有那么多朋友在议论着他的种种，才明白，＇成才＇也许真的溶进我的血脉，很难分离了．",[94,98,99],{},"  一直认为，艺术作品中，直用＇好人＇＇坏人＇来评判一个角色是幼稚的．没有＇好坏＇只有＇真假＇．当成才这样一个争议最多的人物展现在大家面前，总是有人爱有人恨．对于不同的评判和取向，同样没有对错．所以我不会用如此宝贵的时间为＇成才＇和＇自己＇辩驳．只是祭奠一下一年前的那个＇我＇罢了．．．",[94,101,102],{},"  记得有人说过（素未谋面的朋友），感觉思成和成才很像，听说生活里思成就是个成才那样的人种种．．．今答：是　也不是．",[94,104,105],{},"  透露个秘密：直至拍摄近了尾声，我们士兵的第一集的前半段，和最后一集的剧本还没有写出来．２４９龙哥也是煞费苦心改了又改．今天呈现给你们的，几乎都是老康的主意．（尽管有人不喜欢，总觉得没完．．．）但我个人很喜欢，因为我们的路本来就要延续下去，无论是三多还是成才，无论是老段还是晨儿，四个人一条船，驶向夕阳，驶向未知．．．前路如何，续集？戏外？未来？不重要，重要的是有了先前的经历，再大的风雨，我们能坚持！！还要说到哪呢？所有今生的我们无非一个结局，死去．感谢康导（认识他快四年，第一次肉麻）因为他明白我，明白成才以后的路，如果你们非要说我是成才，那不如说老康是袁朗更好．",[94,107,108],{},"  我明白成才的坚持，因为我同样没有放弃；我明白成才的锐利，因为我也多次伤害到别人；我明白成才的飞扬，因为今天或以后的我同样不会丧失激情；我明白成才的狡猾，因为这个世界实在不能没有这一点点小狡猾；我更明白的是成才的委屈！他目标明确，是错吗？真的该混沌？他上进他争取他积极都是错吗？但他确实错了．．．他不会不错，怎能不错？他错的只是走的太快，忽略了周遭的感受．．．不喜欢别人用＇精明＇油滑＇来评论成才，因为对于少年，这些词汇太世故太苍老．成才自以为是的＇心机＇展现人前，正是他的＇无心机＇．然原因只为一：少年错！",[94,110,111],{},"  真正的痛苦缘于孤独：五班的岁月，那如同＇华山思过崖＇般的面闭苦修，三多只一次，成才却有两回．．．总会在想戏外的成才在沙漠上面对漫天星斗，理想抱负却渐行渐远的苦闷与唏嘘，他是错，错在哪？谁无错？天地之大，只一人，自问自答．．．三多比成才幸运，在他身边一直有朋友，有班长有老马有５６１有老７，可成才有过谁？想想会心疼成才，如心疼自己．三多的成长，是爬楼梯．艰苦但难言惊险，而成才是过山车，几次的峰顶到谷底，死去又活来！后面无论峰回路转，柳暗花明还是风云再起，荆棘重生，不论成败，但求璀璨！  ",[94,113,114],{},"  我懂，因为我一样有过错．懂成才的人，是否都如成才般为人？",[94,116,117],{},"  成才？本已是才，方需打磨历练百忍成钢，饿其体肤苦其心智空乏其身．．．成才，说白了是承受承担成长和成熟．．．",{"title":119,"searchDepth":120,"depth":120,"links":121},"",2,[],[6],"昨天和今天，一直到月底，都会为＇士兵＇宣传．","md",{"date":126},"2007-07-24 13:24",true,"\u002Fblog\u002Fblog_4af9831b010009in",{"title":89,"description":123},"blog_4af9831b010009in","blog\u002Fblog_4af9831b010009in",[],"_fWvJh1rcHWFEH-4ZC6YsqEzohjMfBw5O1pSW7mJvwo",[135,140],{"title":136,"path":137,"stem":138,"children":-1,"slug":139},"答案","\u002Fblog\u002Fblog_4af9831b010009gx","blog\u002Fblog_4af9831b010009gx","blog_4af9831b010009gx",{"title":141,"path":142,"stem":143,"children":-1,"slug":144},"2046","\u002Fblog\u002Fblog_4af9831b010009j7","blog\u002Fblog_4af9831b010009j7","blog_4af9831b010009j7",1794546770391]
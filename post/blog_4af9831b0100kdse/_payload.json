[{"data":1,"prerenderedAt":162},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":58,"blog-post-slug-blog_4af9831b0100kdse":75,"surround-blog_4af9831b0100kdse":157},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":54,"site_description":55,"stem":56,"__hash__":57},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo",20,"新浪博客内容备份","settings","hh8X7X6SFDoeJrxIJ4yisZXSc3HwHM1zk206jiQX2XU",{"latestBlog":59},[60,63,66,69,72],{"title":61,"slug":62},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":64,"slug":65},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":67,"slug":68},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":70,"slug":71},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":73,"slug":74},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":76,"title":61,"body":77,"categories":145,"description":146,"extension":147,"meta":148,"navigation":150,"path":151,"seo":152,"slug":62,"stem":153,"tags":154,"__hash__":156},"blog\u002Fblog\u002Fblog_4af9831b0100kdse.md",{"type":78,"value":79,"toc":141},"minimark",[80,87,90,95,98,101,106,109,114,117,122,125,130,133,138],[81,82,83],"p",{},[84,85],"img",{"alt":61,"src":86},"\u002Fpic\u002F4af9831bh8c2264faa3cc.jpg",[81,88,89],{},"小罗汉23日上映来，各地反响不一，可见广告的力量之强大！！上海的上座率超高孩子们超爱，除片子本身质量外很大部分源于SMG的上海广告推广！剩下的城市“小罗汉”几乎被“大地震”吞噬了……",[81,91,92],{},[84,93],{"alt":61,"src":94},"\u002Fpic\u002F4af9831bh8c22600833bc.jpg",[81,96,97],{},"没错，小罗汉之“小”与大地震之“大”简直微不足道，但我相信我们所有主创对电影的热忱之心一点也不少！",[81,99,100],{},"小罗汉绝对是一部有诚意的电影！尽管除了褒奖外也不乏批评之音，但我在想，我们是不是真的该放下“高傲”的心，来平视一部这样的儿童影片呢？",[81,102,103],{},[84,104],{"alt":61,"src":105},"\u002Fpic\u002F4af9831bh8c2266efc270.jpg",[81,107,108],{},"中国电影（内地）刚刚起步，市场化刚刚开始，类型片刚刚露头，我们现在是否就要拿所有的片子去和好莱坞成熟多年的市场去比较？我们能否对中国的电影和电影人宽容一些呢？",[81,110,111],{},[84,112],{"alt":61,"src":113},"\u002Fpic\u002F4af9831bh8c225ed7081b.jpg",[81,115,116],{},"另，大地震的霸主味道无可厚非，但我们的“院线经理们”是否也该给些小片的空间？否则，长此以往，不怕无“小”就无“大”了吗？如果真有那么一天，才是华语电影的悲哀！",[81,118,119],{},[84,120],{"alt":61,"src":121},"\u002Fpic\u002F4af9831bh8c2260ed0155.jpg",[81,123,124],{},"为我所喜爱和投入了诸多热情的“小罗汉”加油！并再一次推销！这不是一部没有缺点的电影，但绝对是一部可以让你欢笑的电影！我们就用孩子般的心态去体会孩子般的经历在银幕前坐一个多小时的孩子吧，如果是这样你一定会和你周围的孩子们笑在一起，并深深地爱上这部电影……",[81,126,127],{},[84,128],{"alt":61,"src":129},"\u002Fpic\u002F4af9831bh8c22621e3a00.jpg",[81,131,132],{},"最后，呼吁社会——这是毕竟是暑期啊大哥，真正放假的是孩子们！咱们是不是真的应该想想多留些他们能看爱看的东西呢？？？除了让孩子们哭，也总得让孩子们笑吧……",[81,134,135],{},[84,136],{"alt":61,"src":137},"\u002Fpic\u002F4af9831bh8c22635e9c61.jpg",[81,139,140],{},"最后的最后，还是那句，观后您真的觉得无趣——找我来报销票价好了！",{"title":142,"searchDepth":143,"depth":143,"links":144},"",2,[],[6,9],"为我所喜爱和投入了诸多热情的“小罗汉”加油！","md",{"date":149},"2010-07-24 21:51",true,"\u002Fblog\u002Fblog_4af9831b0100kdse",{"title":61,"description":146},"blog\u002Fblog_4af9831b0100kdse",[155],"杂谈","OVUsR9JYSX2pRuQBcrvHEaCel9RtzRykJzhkPMwyREo",[158,161],{"title":64,"path":159,"stem":160,"children":-1,"slug":65},"\u002Fblog\u002Fblog_4af9831b0100kany","blog\u002Fblog_4af9831b0100kany",null,1794412499639]
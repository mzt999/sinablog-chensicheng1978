[{"data":1,"prerenderedAt":169},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":57,"blog-post-slug-blog_4af9831b010007ot":74,"surround-blog_4af9831b010007ot":159},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":16,"site_description":54,"stem":55,"__hash__":56},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo","新浪博客内容备份(粉丝自用)","settings","jPD1QWrYwbaIixg6lntppEYe-T3ZGd3EJZxFBkbKY9E",{"latestBlog":58},[59,62,65,68,71],{"title":60,"slug":61},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":63,"slug":64},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":66,"slug":67},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":69,"slug":70},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":72,"slug":73},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":75,"title":76,"body":77,"categories":148,"description":83,"extension":149,"meta":150,"navigation":152,"path":153,"seo":154,"slug":155,"stem":156,"tags":157,"__hash__":158},"blog\u002Fblog\u002Fblog_4af9831b010007ot.md","奇迹 5",{"type":78,"value":79,"toc":144},"minimark",[80,84,87,90,93,96,99,102,105,108,111,114,117,120,123,126,129,132,135,138,141],[81,82,83],"p",{},"晨曦，空荡的长安街上轻烟缭绕。一个男人的身影由远及近边跑步边煞有介事的挥动着拳头，那是大午。",[81,85,86],{},"不一会另一个身影超过了他。虽然身影有点跛，但速度却没有减弱。大午笑了一下，追了上去。",[81,88,89],{},"夕阳投射进院子里，斜斜的照射着绑在大杨树的沙袋上，留下长长的影子。",[81,91,92],{},"空荡的拳击台上，只站着两个人，他们全副武装的对峙着——",[81,94,95],{},"大午盯着小午‘出拳？！’",[81,97,98],{},"小午抬头，眼里光芒一闪！",[81,100,101],{},"出拳！！！！！",[81,103,104],{},"　\n故事写到这儿，说真的我还是没法告诉你们小午最后到底又回没回到拳台上！因为就像大午说的，其实这已经不重要了。他只是想看到小午再次站到生活的拳台上，他需要战胜的那个对手只是自己。仅此而已。",[81,106,107],{},"大午现在相信，经过这次失败小午以后不会再退缩于任何比赛了，因为毕竟‘赢不是一切，想赢才是一切’嘛！我只能告诉你我最后一次见到他们兄弟的时候竟然还是在后海……",[81,109,110],{},"　\n小午和大午的脸上各有一道清晰的红肿，又格外的对称。二人同样歪着头表情也如出一辙的呆滞，他们盯着前方——",[81,112,113],{},"大午“这也没什么好看的啊。”",[81,115,116],{},"　  小午“多好玩啊。”",[81,118,119],{},"　  大午“就这能让你了看一年？”",[81,121,122],{},"　  小午“啊……”",[81,124,125],{},"　  大午“你看给张瞎子得意的！”",[81,127,128],{},"　\n远处的鸟刚刚顺从的飞回张瞎子手持的木杆上，张瞎子正美滋滋的给周围的几个老头示范讲解加炫耀。",[81,130,131],{},"小午不出声，忽然用手指含在嘴里吹了一声巨响的哨子！那响哨仿佛划破长空，而张瞎子的那只刚飞回他的手中的鸟却受到了惊吓，扑棱棱的飞远了！只留下地上的张瞎子在哇哇狂追乱叫。而大午和小午笑作了一团……",[81,133,134],{},"小午从宽大的滑板裤兜里摸出一样东西，带在自己的头上。那是他红色的耳机，他按下了‘PLAY’键，里面的‘EMINMU’的‘lost\nyoursalf’骤然响起……",[81,136,137],{},"　\n那鸟飞得好高，它应该许久没有这样展翅高飞了。它不相信挣脱了束缚的自己原来还可以飞的如此高远自由！它眼里的后海逐渐变小，最后那片翠绿只剩下一个小点……它开始觉得不再循规蹈矩的自己也许创造了一个什么奇迹？又或这本不是什么奇迹，因为生命的本身就已经是个奇迹了……",[81,139,140],{},"（第一稿  结于 2004 9 6 沈阳）",[81,142,143],{},"（第二稿 修改稿  结于2005 7 15\n上海《饮食男女》剧组）",{"title":145,"searchDepth":146,"depth":146,"links":147},"",2,[],[15],"md",{"date":151},"2007-03-16 12:39",true,"\u002Fblog\u002Fblog_4af9831b010007ot",{"title":76,"description":83},"blog_4af9831b010007ot","blog\u002Fblog_4af9831b010007ot",[],"6bR87RdmEzK0B7XBvVZZNSSA3XS6Scb6umlPblNtvZU",[160,164],{"title":76,"path":161,"stem":162,"children":-1,"slug":163},"\u002Fblog\u002Fblog_4af9831b010007os","blog\u002Fblog_4af9831b010007os","blog_4af9831b010007os",{"title":165,"path":166,"stem":167,"children":-1,"slug":168},"最新的公告","\u002Fblog\u002Fblog_4af9831b010007ov","blog\u002Fblog_4af9831b010007ov","blog_4af9831b010007ov",1794473706038]
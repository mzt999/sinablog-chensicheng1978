[{"data":1,"prerenderedAt":129},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":17,"blog-post-slug-blog_4af9831b010007ot":34,"surround-blog_4af9831b010007ot":119},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"latestBlog":18},[19,22,25,28,31],{"title":20,"slug":21},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":23,"slug":24},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":26,"slug":27},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":29,"slug":30},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":32,"slug":33},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":35,"title":36,"body":37,"categories":108,"description":43,"extension":109,"meta":110,"navigation":112,"path":113,"seo":114,"slug":115,"stem":116,"tags":117,"__hash__":118},"blog\u002Fblog\u002Fblog_4af9831b010007ot.md","奇迹 5",{"type":38,"value":39,"toc":104},"minimark",[40,44,47,50,53,56,59,62,65,68,71,74,77,80,83,86,89,92,95,98,101],[41,42,43],"p",{},"晨曦，空荡的长安街上轻烟缭绕。一个男人的身影由远及近边跑步边煞有介事的挥动着拳头，那是大午。",[41,45,46],{},"不一会另一个身影超过了他。虽然身影有点跛，但速度却没有减弱。大午笑了一下，追了上去。",[41,48,49],{},"夕阳投射进院子里，斜斜的照射着绑在大杨树的沙袋上，留下长长的影子。",[41,51,52],{},"空荡的拳击台上，只站着两个人，他们全副武装的对峙着——",[41,54,55],{},"大午盯着小午‘出拳？！’",[41,57,58],{},"小午抬头，眼里光芒一闪！",[41,60,61],{},"出拳！！！！！",[41,63,64],{},"　\n故事写到这儿，说真的我还是没法告诉你们小午最后到底又回没回到拳台上！因为就像大午说的，其实这已经不重要了。他只是想看到小午再次站到生活的拳台上，他需要战胜的那个对手只是自己。仅此而已。",[41,66,67],{},"大午现在相信，经过这次失败小午以后不会再退缩于任何比赛了，因为毕竟‘赢不是一切，想赢才是一切’嘛！我只能告诉你我最后一次见到他们兄弟的时候竟然还是在后海……",[41,69,70],{},"　\n小午和大午的脸上各有一道清晰的红肿，又格外的对称。二人同样歪着头表情也如出一辙的呆滞，他们盯着前方——",[41,72,73],{},"大午“这也没什么好看的啊。”",[41,75,76],{},"　  小午“多好玩啊。”",[41,78,79],{},"　  大午“就这能让你了看一年？”",[41,81,82],{},"　  小午“啊……”",[41,84,85],{},"　  大午“你看给张瞎子得意的！”",[41,87,88],{},"　\n远处的鸟刚刚顺从的飞回张瞎子手持的木杆上，张瞎子正美滋滋的给周围的几个老头示范讲解加炫耀。",[41,90,91],{},"小午不出声，忽然用手指含在嘴里吹了一声巨响的哨子！那响哨仿佛划破长空，而张瞎子的那只刚飞回他的手中的鸟却受到了惊吓，扑棱棱的飞远了！只留下地上的张瞎子在哇哇狂追乱叫。而大午和小午笑作了一团……",[41,93,94],{},"小午从宽大的滑板裤兜里摸出一样东西，带在自己的头上。那是他红色的耳机，他按下了‘PLAY’键，里面的‘EMINMU’的‘lost\nyoursalf’骤然响起……",[41,96,97],{},"　\n那鸟飞得好高，它应该许久没有这样展翅高飞了。它不相信挣脱了束缚的自己原来还可以飞的如此高远自由！它眼里的后海逐渐变小，最后那片翠绿只剩下一个小点……它开始觉得不再循规蹈矩的自己也许创造了一个什么奇迹？又或这本不是什么奇迹，因为生命的本身就已经是个奇迹了……",[41,99,100],{},"（第一稿  结于 2004 9 6 沈阳）",[41,102,103],{},"（第二稿 修改稿  结于2005 7 15\n上海《饮食男女》剧组）",{"title":105,"searchDepth":106,"depth":106,"links":107},"",2,[],[15],"md",{"date":111},"2007-03-16 12:39",true,"\u002Fblog\u002Fblog_4af9831b010007ot",{"title":36,"description":43},"blog_4af9831b010007ot","blog\u002Fblog_4af9831b010007ot",[],"6bR87RdmEzK0B7XBvVZZNSSA3XS6Scb6umlPblNtvZU",[120,124],{"title":36,"path":121,"stem":122,"children":-1,"slug":123},"\u002Fblog\u002Fblog_4af9831b010007os","blog\u002Fblog_4af9831b010007os","blog_4af9831b010007os",{"title":125,"path":126,"stem":127,"children":-1,"slug":128},"最新的公告","\u002Fblog\u002Fblog_4af9831b010007ov","blog\u002Fblog_4af9831b010007ov","blog_4af9831b010007ov",1794130024277]
[{"data":1,"prerenderedAt":170},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":58,"blog-post-slug-blog_4af9831b010007ot":75,"surround-blog_4af9831b010007ot":160},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":54,"site_description":55,"stem":56,"__hash__":57},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo",20,"新浪博客内容备份","settings","hh8X7X6SFDoeJrxIJ4yisZXSc3HwHM1zk206jiQX2XU",{"latestBlog":59},[60,63,66,69,72],{"title":61,"slug":62},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":64,"slug":65},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":67,"slug":68},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":70,"slug":71},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":73,"slug":74},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":76,"title":77,"body":78,"categories":149,"description":84,"extension":150,"meta":151,"navigation":153,"path":154,"seo":155,"slug":156,"stem":157,"tags":158,"__hash__":159},"blog\u002Fblog\u002Fblog_4af9831b010007ot.md","奇迹 5",{"type":79,"value":80,"toc":145},"minimark",[81,85,88,91,94,97,100,103,106,109,112,115,118,121,124,127,130,133,136,139,142],[82,83,84],"p",{},"晨曦，空荡的长安街上轻烟缭绕。一个男人的身影由远及近边跑步边煞有介事的挥动着拳头，那是大午。",[82,86,87],{},"不一会另一个身影超过了他。虽然身影有点跛，但速度却没有减弱。大午笑了一下，追了上去。",[82,89,90],{},"夕阳投射进院子里，斜斜的照射着绑在大杨树的沙袋上，留下长长的影子。",[82,92,93],{},"空荡的拳击台上，只站着两个人，他们全副武装的对峙着——",[82,95,96],{},"大午盯着小午‘出拳？！’",[82,98,99],{},"小午抬头，眼里光芒一闪！",[82,101,102],{},"出拳！！！！！",[82,104,105],{},"　\n故事写到这儿，说真的我还是没法告诉你们小午最后到底又回没回到拳台上！因为就像大午说的，其实这已经不重要了。他只是想看到小午再次站到生活的拳台上，他需要战胜的那个对手只是自己。仅此而已。",[82,107,108],{},"大午现在相信，经过这次失败小午以后不会再退缩于任何比赛了，因为毕竟‘赢不是一切，想赢才是一切’嘛！我只能告诉你我最后一次见到他们兄弟的时候竟然还是在后海……",[82,110,111],{},"　\n小午和大午的脸上各有一道清晰的红肿，又格外的对称。二人同样歪着头表情也如出一辙的呆滞，他们盯着前方——",[82,113,114],{},"大午“这也没什么好看的啊。”",[82,116,117],{},"　  小午“多好玩啊。”",[82,119,120],{},"　  大午“就这能让你了看一年？”",[82,122,123],{},"　  小午“啊……”",[82,125,126],{},"　  大午“你看给张瞎子得意的！”",[82,128,129],{},"　\n远处的鸟刚刚顺从的飞回张瞎子手持的木杆上，张瞎子正美滋滋的给周围的几个老头示范讲解加炫耀。",[82,131,132],{},"小午不出声，忽然用手指含在嘴里吹了一声巨响的哨子！那响哨仿佛划破长空，而张瞎子的那只刚飞回他的手中的鸟却受到了惊吓，扑棱棱的飞远了！只留下地上的张瞎子在哇哇狂追乱叫。而大午和小午笑作了一团……",[82,134,135],{},"小午从宽大的滑板裤兜里摸出一样东西，带在自己的头上。那是他红色的耳机，他按下了‘PLAY’键，里面的‘EMINMU’的‘lost\nyoursalf’骤然响起……",[82,137,138],{},"　\n那鸟飞得好高，它应该许久没有这样展翅高飞了。它不相信挣脱了束缚的自己原来还可以飞的如此高远自由！它眼里的后海逐渐变小，最后那片翠绿只剩下一个小点……它开始觉得不再循规蹈矩的自己也许创造了一个什么奇迹？又或这本不是什么奇迹，因为生命的本身就已经是个奇迹了……",[82,140,141],{},"（第一稿  结于 2004 9 6 沈阳）",[82,143,144],{},"（第二稿 修改稿  结于2005 7 15\n上海《饮食男女》剧组）",{"title":146,"searchDepth":147,"depth":147,"links":148},"",2,[],[15],"md",{"date":152},"2007-03-16 12:39",true,"\u002Fblog\u002Fblog_4af9831b010007ot",{"title":77,"description":84},"blog_4af9831b010007ot","blog\u002Fblog_4af9831b010007ot",[],"6bR87RdmEzK0B7XBvVZZNSSA3XS6Scb6umlPblNtvZU",[161,165],{"title":77,"path":162,"stem":163,"children":-1,"slug":164},"\u002Fblog\u002Fblog_4af9831b010007os","blog\u002Fblog_4af9831b010007os","blog_4af9831b010007os",{"title":166,"path":167,"stem":168,"children":-1,"slug":169},"最新的公告","\u002Fblog\u002Fblog_4af9831b010007ov","blog\u002Fblog_4af9831b010007ov","blog_4af9831b010007ov",1794412501341]
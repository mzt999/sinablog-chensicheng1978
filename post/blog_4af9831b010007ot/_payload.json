[{"data":1,"prerenderedAt":182},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":70,"blog-post-slug-blog_4af9831b010007ot":87,"surround-blog_4af9831b010007ot":172},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":45,"navLinks":46,"perPage":16,"prevNextIsExcludeDate":66,"site_description":23,"site_name":67,"stem":68,"__hash__":69},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{},[47,52,56,60,64],{"path":48,"title":49,"target":50,"fa_class":51},"\u002F","博客首页","internal","fa-home",{"path":53,"title":54,"target":50,"fa_class":55},"\u002Fabout","关于","fa-user",{"path":57,"title":58,"target":50,"fa_class":59},"\u002Fpost","归档","fa-archive",{"path":61,"title":62,"target":50,"fa_class":63},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":65,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","jvZHccz2rT-wjVS5GCPgWyhl8WnBIvECPkE5KpKFKCU",{"latestBlog":71},[72,75,78,81,84],{"title":73,"slug":74},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":76,"slug":77},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":79,"slug":80},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":82,"slug":83},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":85,"slug":86},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":88,"title":89,"body":90,"categories":161,"description":96,"extension":162,"meta":163,"navigation":165,"path":166,"seo":167,"slug":168,"stem":169,"tags":170,"__hash__":171},"blog\u002Fblog\u002Fblog_4af9831b010007ot.md","奇迹 5",{"type":91,"value":92,"toc":157},"minimark",[93,97,100,103,106,109,112,115,118,121,124,127,130,133,136,139,142,145,148,151,154],[94,95,96],"p",{},"晨曦，空荡的长安街上轻烟缭绕。一个男人的身影由远及近边跑步边煞有介事的挥动着拳头，那是大午。",[94,98,99],{},"不一会另一个身影超过了他。虽然身影有点跛，但速度却没有减弱。大午笑了一下，追了上去。",[94,101,102],{},"夕阳投射进院子里，斜斜的照射着绑在大杨树的沙袋上，留下长长的影子。",[94,104,105],{},"空荡的拳击台上，只站着两个人，他们全副武装的对峙着——",[94,107,108],{},"大午盯着小午‘出拳？！’",[94,110,111],{},"小午抬头，眼里光芒一闪！",[94,113,114],{},"出拳！！！！！",[94,116,117],{},"　\n故事写到这儿，说真的我还是没法告诉你们小午最后到底又回没回到拳台上！因为就像大午说的，其实这已经不重要了。他只是想看到小午再次站到生活的拳台上，他需要战胜的那个对手只是自己。仅此而已。",[94,119,120],{},"大午现在相信，经过这次失败小午以后不会再退缩于任何比赛了，因为毕竟‘赢不是一切，想赢才是一切’嘛！我只能告诉你我最后一次见到他们兄弟的时候竟然还是在后海……",[94,122,123],{},"　\n小午和大午的脸上各有一道清晰的红肿，又格外的对称。二人同样歪着头表情也如出一辙的呆滞，他们盯着前方——",[94,125,126],{},"大午“这也没什么好看的啊。”",[94,128,129],{},"　  小午“多好玩啊。”",[94,131,132],{},"　  大午“就这能让你了看一年？”",[94,134,135],{},"　  小午“啊……”",[94,137,138],{},"　  大午“你看给张瞎子得意的！”",[94,140,141],{},"　\n远处的鸟刚刚顺从的飞回张瞎子手持的木杆上，张瞎子正美滋滋的给周围的几个老头示范讲解加炫耀。",[94,143,144],{},"小午不出声，忽然用手指含在嘴里吹了一声巨响的哨子！那响哨仿佛划破长空，而张瞎子的那只刚飞回他的手中的鸟却受到了惊吓，扑棱棱的飞远了！只留下地上的张瞎子在哇哇狂追乱叫。而大午和小午笑作了一团……",[94,146,147],{},"小午从宽大的滑板裤兜里摸出一样东西，带在自己的头上。那是他红色的耳机，他按下了‘PLAY’键，里面的‘EMINMU’的‘lost\nyoursalf’骤然响起……",[94,149,150],{},"　\n那鸟飞得好高，它应该许久没有这样展翅高飞了。它不相信挣脱了束缚的自己原来还可以飞的如此高远自由！它眼里的后海逐渐变小，最后那片翠绿只剩下一个小点……它开始觉得不再循规蹈矩的自己也许创造了一个什么奇迹？又或这本不是什么奇迹，因为生命的本身就已经是个奇迹了……",[94,152,153],{},"（第一稿  结于 2004 9 6 沈阳）",[94,155,156],{},"（第二稿 修改稿  结于2005 7 15\n上海《饮食男女》剧组）",{"title":158,"searchDepth":159,"depth":159,"links":160},"",2,[],[15],"md",{"date":164},"2007-03-16 12:39",true,"\u002Fblog\u002Fblog_4af9831b010007ot",{"title":89,"description":96},"blog_4af9831b010007ot","blog\u002Fblog_4af9831b010007ot",[],"6bR87RdmEzK0B7XBvVZZNSSA3XS6Scb6umlPblNtvZU",[173,177],{"title":89,"path":174,"stem":175,"children":-1,"slug":176},"\u002Fblog\u002Fblog_4af9831b010007os","blog\u002Fblog_4af9831b010007os","blog_4af9831b010007os",{"title":178,"path":179,"stem":180,"children":-1,"slug":181},"最新的公告","\u002Fblog\u002Fblog_4af9831b010007ov","blog\u002Fblog_4af9831b010007ov","blog_4af9831b010007ov",1794544668189]
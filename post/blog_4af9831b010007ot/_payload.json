[{"data":1,"prerenderedAt":126},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b010007ot":31,"surround-blog_4af9831b010007ot":116},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",151,{"name":9,"len":10},"有图",34,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":105,"description":33,"extension":106,"meta":107,"navigation":109,"path":110,"seo":111,"slug":112,"stem":113,"tags":114,"__hash__":115},"blog\u002Fblog\u002Fblog_4af9831b010007ot.md","奇迹 5",{"type":35,"value":36,"toc":101},"minimark",[37,41,44,47,50,53,56,59,62,65,68,71,74,77,80,83,86,89,92,95,98],[38,39,40],"p",{},"晨曦，空荡的长安街上轻烟缭绕。一个男人的身影由远及近边跑步边煞有介事的挥动着拳头，那是大午。",[38,42,43],{},"不一会另一个身影超过了他。虽然身影有点跛，但速度却没有减弱。大午笑了一下，追了上去。",[38,45,46],{},"夕阳投射进院子里，斜斜的照射着绑在大杨树的沙袋上，留下长长的影子。",[38,48,49],{},"空荡的拳击台上，只站着两个人，他们全副武装的对峙着——",[38,51,52],{},"大午盯着小午‘出拳？！’",[38,54,55],{},"小午抬头，眼里光芒一闪！",[38,57,58],{},"出拳！！！！！",[38,60,61],{},"　\n故事写到这儿，说真的我还是没法告诉你们小午最后到底又回没回到拳台上！因为就像大午说的，其实这已经不重要了。他只是想看到小午再次站到生活的拳台上，他需要战胜的那个对手只是自己。仅此而已。",[38,63,64],{},"大午现在相信，经过这次失败小午以后不会再退缩于任何比赛了，因为毕竟‘赢不是一切，想赢才是一切’嘛！我只能告诉你我最后一次见到他们兄弟的时候竟然还是在后海……",[38,66,67],{},"　\n小午和大午的脸上各有一道清晰的红肿，又格外的对称。二人同样歪着头表情也如出一辙的呆滞，他们盯着前方——",[38,69,70],{},"大午“这也没什么好看的啊。”",[38,72,73],{},"　  小午“多好玩啊。”",[38,75,76],{},"　  大午“就这能让你了看一年？”",[38,78,79],{},"　  小午“啊……”",[38,81,82],{},"　  大午“你看给张瞎子得意的！”",[38,84,85],{},"　\n远处的鸟刚刚顺从的飞回张瞎子手持的木杆上，张瞎子正美滋滋的给周围的几个老头示范讲解加炫耀。",[38,87,88],{},"小午不出声，忽然用手指含在嘴里吹了一声巨响的哨子！那响哨仿佛划破长空，而张瞎子的那只刚飞回他的手中的鸟却受到了惊吓，扑棱棱的飞远了！只留下地上的张瞎子在哇哇狂追乱叫。而大午和小午笑作了一团……",[38,90,91],{},"小午从宽大的滑板裤兜里摸出一样东西，带在自己的头上。那是他红色的耳机，他按下了‘PLAY’键，里面的‘EMINMU’的‘lost\nyoursalf’骤然响起……",[38,93,94],{},"　\n那鸟飞得好高，它应该许久没有这样展翅高飞了。它不相信挣脱了束缚的自己原来还可以飞的如此高远自由！它眼里的后海逐渐变小，最后那片翠绿只剩下一个小点……它开始觉得不再循规蹈矩的自己也许创造了一个什么奇迹？又或这本不是什么奇迹，因为生命的本身就已经是个奇迹了……",[38,96,97],{},"（第一稿  结于 2004 9 6 沈阳）",[38,99,100],{},"（第二稿 修改稿  结于2005 7 15\n上海《饮食男女》剧组）",{"title":102,"searchDepth":103,"depth":103,"links":104},"",2,[],[12],"md",{"date":108},"2007-03-16 12:39",true,"\u002Fblog\u002Fblog_4af9831b010007ot",{"title":33,"description":33},"blog_4af9831b010007ot","blog\u002Fblog_4af9831b010007ot",[],"M8ofIUVpf2pP4J1NCZp_S7tuYuspe7EByuD65Ii_iuM",[117,121],{"title":33,"path":118,"stem":119,"children":-1,"slug":120},"\u002Fblog\u002Fblog_4af9831b010007os","blog\u002Fblog_4af9831b010007os","blog_4af9831b010007os",{"title":122,"path":123,"stem":124,"children":-1,"slug":125},"最新的公告","\u002Fblog\u002Fblog_4af9831b010007ov","blog\u002Fblog_4af9831b010007ov","blog_4af9831b010007ov",1793849978519]
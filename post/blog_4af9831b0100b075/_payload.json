[{"data":1,"prerenderedAt":101},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b0100b075":31,"surround-blog_4af9831b0100b075":90},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",152,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":78,"description":33,"extension":79,"meta":80,"navigation":82,"path":83,"seo":84,"slug":85,"stem":86,"tags":87,"__hash__":89},"blog\u002Fblog\u002Fblog_4af9831b0100b075.md","那段岁月 那个人",{"type":35,"value":36,"toc":74},"minimark",[37,41,44,47,50,53,56,59,62,65,68,71],[38,39,40],"p",{},"最早告知我消息的依旧是中国移动。片刻黯然。",[38,42,43],{},"个把小时后，接到了老同学兼同乡秀东的电话……",[38,45,46],{},"1994年。第一次离家的我。上海。及和那个名字紧紧相连的一切。",[38,48,49],{},"那是我的16岁，市委党校郁郁葱的树荫，静谧的石子路，微澜的人工湖，湖面上绞颈而栖的白色天鹅石雕……食堂里糖醋小排的味道至今怀念，钦州南路的四川菜馆已经数次扩张……",[38,51,52],{},"那一幕幕，现在想起，仿佛别人的故事。又如同老电影，画面泛黄斑驳，音乐若隐若现，那些面孔时而清晰，时而浑浊，还有那个老人……那时，他已是老人，他给了40几个孩子一个梦，从而改变了他们的人生……",[38,54,55],{},"在那年，伴在我身边的日本女孩，现在该是母亲了……",[38,57,58],{},"还有我的朋友们，兄弟们。老王，雷子，安子，育明……此刻，借这寥寥数字，寄托对你们的想念。生活或许可以把一切改变，但有些故事早在风中被永远的定格了……",[38,60,61],{},"最近见到的同学是在广州“画皮”首映式上的大眼睛小赵……当天忘记问她可否记得中兴百货那顿她请的午餐和午餐上她对我们几个小兄弟的眼泪了……",[38,63,64],{},"今天，又因为那个名字，让我再念起过往的那段岁月，那段我生命中永无法取代的精彩，和那些人那些弥足珍贵的记忆……那年，太多的第一次让我铭心刻骨了……",[38,66,67],{},"老人，只剩给我们一个背影……",[38,69,70],{},"愿他一路走好……",[38,72,73],{},"  和您，算是有缘人了……",{"title":75,"searchDepth":76,"depth":76,"links":77},"",2,[],[6],"md",{"date":81},"2008-10-18 23:32",true,"\u002Fblog\u002Fblog_4af9831b0100b075",{"title":33,"description":33},"blog_4af9831b0100b075","blog\u002Fblog_4af9831b0100b075",[88],"杂谈","0oULC9DTiK5I0aNQKExmJKPtSekoDJFHXaM82_NsGPQ",[91,96],{"title":92,"path":93,"stem":94,"children":-1,"slug":95},"无言","\u002Fblog\u002Fblog_4af9831b0100aynz","blog\u002Fblog_4af9831b0100aynz","blog_4af9831b0100aynz",{"title":97,"path":98,"stem":99,"children":-1,"slug":100},"坚硬的柔软","\u002Fblog\u002Fblog_4af9831b0100b4mx","blog\u002Fblog_4af9831b0100b4mx","blog_4af9831b0100b4mx",1793971358237]
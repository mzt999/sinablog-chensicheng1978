[{"data":1,"prerenderedAt":138},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":58,"blog-post-slug-blog_4af9831b0100cdig":75,"surround-blog_4af9831b0100cdig":127},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":54,"site_description":55,"stem":56,"__hash__":57},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo",20,"新浪博客内容备份","settings","hh8X7X6SFDoeJrxIJ4yisZXSc3HwHM1zk206jiQX2XU",{"latestBlog":59},[60,63,66,69,72],{"title":61,"slug":62},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":64,"slug":65},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":67,"slug":68},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":70,"slug":71},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":73,"slug":74},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":76,"title":77,"body":78,"categories":115,"description":92,"extension":116,"meta":117,"navigation":119,"path":120,"seo":121,"slug":122,"stem":123,"tags":124,"__hash__":126},"blog\u002Fblog\u002Fblog_4af9831b0100cdig.md","失眠……",{"type":79,"value":80,"toc":111},"minimark",[81,84,87,90,93,96,99,102,105,108],[82,83,77],"p",{},[82,85,86],{},"上来写点什么。",[82,88,89],{},"写什么?不知道……",[82,91,92],{},"最近困惑我的是关于选择……选择后面的工作……",[82,94,95],{},"没有选择的时候困惑，有了也是同样。所以，困惑该是伴着我们一路的……",[82,97,98],{},"今天接到小鬼的信息，她后天领证。这丫头嫁人了，性质变了。祝福她，婚姻可真是个大赌注！愿她能赢到最后……",[82,100,101],{},"“团长”如今大火，今天和朋友们又聊起“士兵”的岁月，今时此刻，就更觉人生真如黄粱一梦了……",[82,103,104],{},"最近，身边的几个人都生了孩子……前两天还见了一个新鲜的小生命……我总会感叹，不禁唏嘘。怎么？如此匆匆，我的朋友们就已经是父母了呢？我们昨天不明明还是个孩子吗？……",[82,106,107],{},"牢骚，完全没内容的胡言乱语……困扰我的是失眠……我总会在深夜清醒……瞳孔在夜色的背后发亮，如光般穿透无边的深邃……无边是什么？无限有多大？每次思考这样的问题就让我痛不欲生……",[82,109,110],{},"不写了，干点别的……再睡。",{"title":112,"searchDepth":113,"depth":113,"links":114},"",2,[],[6],"md",{"date":118},"2009-03-15 03:52",true,"\u002Fblog\u002Fblog_4af9831b0100cdig",{"title":77,"description":92},"blog_4af9831b0100cdig","blog\u002Fblog_4af9831b0100cdig",[125],"杂谈","00CF_QimJ3DWBxsvSAsAWYcJxt8l0XAw2dRfUrVfpsQ",[128,133],{"title":129,"path":130,"stem":131,"children":-1,"slug":132},"“予文”——新春寄语","\u002Fblog\u002Fblog_4af9831b0100bx8c","blog\u002Fblog_4af9831b0100bx8c","blog_4af9831b0100bx8c",{"title":134,"path":135,"stem":136,"children":-1,"slug":137},"好的？坏的?","\u002Fblog\u002Fblog_4af9831b0100cmp6","blog\u002Fblog_4af9831b0100cmp6","blog_4af9831b0100cmp6",1794412500587]
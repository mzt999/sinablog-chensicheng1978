[{"data":1,"prerenderedAt":97},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":17,"blog-post-slug-blog_4af9831b0100cdig":34,"surround-blog_4af9831b0100cdig":86},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"latestBlog":18},[19,22,25,28,31],{"title":20,"slug":21},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":23,"slug":24},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":26,"slug":27},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":29,"slug":30},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":32,"slug":33},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":35,"title":36,"body":37,"categories":74,"description":51,"extension":75,"meta":76,"navigation":78,"path":79,"seo":80,"slug":81,"stem":82,"tags":83,"__hash__":85},"blog\u002Fblog\u002Fblog_4af9831b0100cdig.md","失眠……",{"type":38,"value":39,"toc":70},"minimark",[40,43,46,49,52,55,58,61,64,67],[41,42,36],"p",{},[41,44,45],{},"上来写点什么。",[41,47,48],{},"写什么?不知道……",[41,50,51],{},"最近困惑我的是关于选择……选择后面的工作……",[41,53,54],{},"没有选择的时候困惑，有了也是同样。所以，困惑该是伴着我们一路的……",[41,56,57],{},"今天接到小鬼的信息，她后天领证。这丫头嫁人了，性质变了。祝福她，婚姻可真是个大赌注！愿她能赢到最后……",[41,59,60],{},"“团长”如今大火，今天和朋友们又聊起“士兵”的岁月，今时此刻，就更觉人生真如黄粱一梦了……",[41,62,63],{},"最近，身边的几个人都生了孩子……前两天还见了一个新鲜的小生命……我总会感叹，不禁唏嘘。怎么？如此匆匆，我的朋友们就已经是父母了呢？我们昨天不明明还是个孩子吗？……",[41,65,66],{},"牢骚，完全没内容的胡言乱语……困扰我的是失眠……我总会在深夜清醒……瞳孔在夜色的背后发亮，如光般穿透无边的深邃……无边是什么？无限有多大？每次思考这样的问题就让我痛不欲生……",[41,68,69],{},"不写了，干点别的……再睡。",{"title":71,"searchDepth":72,"depth":72,"links":73},"",2,[],[6],"md",{"date":77},"2009-03-15 03:52",true,"\u002Fblog\u002Fblog_4af9831b0100cdig",{"title":36,"description":51},"blog_4af9831b0100cdig","blog\u002Fblog_4af9831b0100cdig",[84],"杂谈","00CF_QimJ3DWBxsvSAsAWYcJxt8l0XAw2dRfUrVfpsQ",[87,92],{"title":88,"path":89,"stem":90,"children":-1,"slug":91},"“予文”——新春寄语","\u002Fblog\u002Fblog_4af9831b0100bx8c","blog\u002Fblog_4af9831b0100bx8c","blog_4af9831b0100bx8c",{"title":93,"path":94,"stem":95,"children":-1,"slug":
[{"data":1,"prerenderedAt":94},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b0100cdig":31,"surround-blog_4af9831b0100cdig":83},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",151,{"name":9,"len":10},"有图",34,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":71,"description":33,"extension":72,"meta":73,"navigation":75,"path":76,"seo":77,"slug":78,"stem":79,"tags":80,"__hash__":82},"blog\u002Fblog\u002Fblog_4af9831b0100cdig.md","失眠……",{"type":35,"value":36,"toc":67},"minimark",[37,40,43,46,49,52,55,58,61,64],[38,39,33],"p",{},[38,41,42],{},"上来写点什么。",[38,44,45],{},"写什么?不知道……",[38,47,48],{},"最近困惑我的是关于选择……选择后面的工作……",[38,50,51],{},"没有选择的时候困惑，有了也是同样。所以，困惑该是伴着我们一路的……",[38,53,54],{},"今天接到小鬼的信息，她后天领证。这丫头嫁人了，性质变了。祝福她，婚姻可真是个大赌注！愿她能赢到最后……",[38,56,57],{},"“团长”如今大火，今天和朋友们又聊起“士兵”的岁月，今时此刻，就更觉人生真如黄粱一梦了……",[38,59,60],{},"最近，身边的几个人都生了孩子……前两天还见了一个新鲜的小生命……我总会感叹，不禁唏嘘。怎么？如此匆匆，我的朋友们就已经是父母了呢？我们昨天不明明还是个孩子吗？……",[38,62,63],{},"牢骚，完全没内容的胡言乱语……困扰我的是失眠……我总会在深夜清醒……瞳孔在夜色的背后发亮，如光般穿透无边的深邃……无边是什么？无限有多大？每次思考这样的问题就让我痛不欲生……",[38,65,66],{},"不写了，干点别的……再睡。",{"title":68,"searchDepth":69,"depth":69,"links":70},"",2,[],[6],"md",{"date":74},"2009-03-15 03:52",true,"\u002Fblog\u002Fblog_4af9831b0100cdig",{"title":33,"description":33},"blog_4af9831b0100cdig","blog\u002Fblog_4af9831b0100cdig",[81],"杂谈","hlQe2Nz3JuvecuNsrj1lIkWjQuqHvXWagvKtCGOVYB4",[84,89],{"title":85,"path":86,"stem":87,"children":-1,"slug":88},"“予文”——新春寄语","\u002Fblog\u002Fblog_4af9831b0100bx8c","blog\u002Fblog_4af9831b0100bx8c","blog_4af9831b0100bx8c",{"title":90,"path":91,"stem":92,"children":-1,"slug":93},"好的？坏的?","\u002Fblog\u002Fblog
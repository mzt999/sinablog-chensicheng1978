[{"data":1,"prerenderedAt":137},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":57,"blog-post-slug-blog_4af9831b0100cdig":74,"surround-blog_4af9831b0100cdig":126},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":16,"site_description":54,"stem":55,"__hash__":56},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo","新浪博客内容备份(粉丝自用)","settings","jPD1QWrYwbaIixg6lntppEYe-T3ZGd3EJZxFBkbKY9E",{"latestBlog":58},[59,62,65,68,71],{"title":60,"slug":61},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":63,"slug":64},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":66,"slug":67},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":69,"slug":70},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":72,"slug":73},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":75,"title":76,"body":77,"categories":114,"description":91,"extension":115,"meta":116,"navigation":118,"path":119,"seo":120,"slug":121,"stem":122,"tags":123,"__hash__":125},"blog\u002Fblog\u002Fblog_4af9831b0100cdig.md","失眠……",{"type":78,"value":79,"toc":110},"minimark",[80,83,86,89,92,95,98,101,104,107],[81,82,76],"p",{},[81,84,85],{},"上来写点什么。",[81,87,88],{},"写什么?不知道……",[81,90,91],{},"最近困惑我的是关于选择……选择后面的工作……",[81,93,94],{},"没有选择的时候困惑，有了也是同样。所以，困惑该是伴着我们一路的……",[81,96,97],{},"今天接到小鬼的信息，她后天领证。这丫头嫁人了，性质变了。祝福她，婚姻可真是个大赌注！愿她能赢到最后……",[81,99,100],{},"“团长”如今大火，今天和朋友们又聊起“士兵”的岁月，今时此刻，就更觉人生真如黄粱一梦了……",[81,102,103],{},"最近，身边的几个人都生了孩子……前两天还见了一个新鲜的小生命……我总会感叹，不禁唏嘘。怎么？如此匆匆，我的朋友们就已经是父母了呢？我们昨天不明明还是个孩子吗？……",[81,105,106],{},"牢骚，完全没内容的胡言乱语……困扰我的是失眠……我总会在深夜清醒……瞳孔在夜色的背后发亮，如光般穿透无边的深邃……无边是什么？无限有多大？每次思考这样的问题就让我痛不欲生……",[81,108,109],{},"不写了，干点别的……再睡。",{"title":111,"searchDepth":112,"depth":112,"links":113},"",2,[],[6],"md",{"date":117},"2009-03-15 03:52",true,"\u002Fblog\u002Fblog_4af9831b0100cdig",{"title":76,"description":91},"blog_4af9831b0100cdig","blog\u002Fblog_4af9831b0100cdig",[124],"杂谈","00CF_QimJ3DWBxsvSAsAWYcJxt8l0XAw2dRfUrVfpsQ",[127,132],{"title":128,"path":129,"stem":130,"children":-1,"slug":131},"“予文”——新春寄语","\u002Fblog\u002Fblog_4af9831b0100bx8c","blog\u002Fblog_4af9831b0100bx8c","blog_4af9831b0100bx8c",{"title":133,"path":134,"stem":135,"children":-1,"slug":136},"好的？坏的?","\u002Fblog\u002Fblog_4af9831b0100cmp6","blog\u002Fblog_4af9831b0100cmp6","blog_4af9831b0100cmp6",1794473705247]
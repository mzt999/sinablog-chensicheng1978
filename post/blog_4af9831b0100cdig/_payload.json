[{"data":1,"prerenderedAt":150},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":70,"blog-post-slug-blog_4af9831b0100cdig":87,"surround-blog_4af9831b0100cdig":139},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":45,"navLinks":46,"perPage":16,"prevNextIsExcludeDate":66,"site_description":23,"site_name":67,"stem":68,"__hash__":69},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{},[47,52,56,60,64],{"path":48,"title":49,"target":50,"fa_class":51},"\u002F","博客首页","internal","fa-home",{"path":53,"title":54,"target":50,"fa_class":55},"\u002Fabout","关于","fa-user",{"path":57,"title":58,"target":50,"fa_class":59},"\u002Fpost","归档","fa-archive",{"path":61,"title":62,"target":50,"fa_class":63},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":65,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","jvZHccz2rT-wjVS5GCPgWyhl8WnBIvECPkE5KpKFKCU",{"latestBlog":71},[72,75,78,81,84],{"title":73,"slug":74},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":76,"slug":77},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":79,"slug":80},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":82,"slug":83},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":85,"slug":86},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":88,"title":89,"body":90,"categories":127,"description":104,"extension":128,"meta":129,"navigation":131,"path":132,"seo":133,"slug":134,"stem":135,"tags":136,"__hash__":138},"blog\u002Fblog\u002Fblog_4af9831b0100cdig.md","失眠……",{"type":91,"value":92,"toc":123},"minimark",[93,96,99,102,105,108,111,114,117,120],[94,95,89],"p",{},[94,97,98],{},"上来写点什么。",[94,100,101],{},"写什么?不知道……",[94,103,104],{},"最近困惑我的是关于选择……选择后面的工作……",[94,106,107],{},"没有选择的时候困惑，有了也是同样。所以，困惑该是伴着我们一路的……",[94,109,110],{},"今天接到小鬼的信息，她后天领证。这丫头嫁人了，性质变了。祝福她，婚姻可真是个大赌注！愿她能赢到最后……",[94,112,113],{},"“团长”如今大火，今天和朋友们又聊起“士兵”的岁月，今时此刻，就更觉人生真如黄粱一梦了……",[94,115,116],{},"最近，身边的几个人都生了孩子……前两天还见了一个新鲜的小生命……我总会感叹，不禁唏嘘。怎么？如此匆匆，我的朋友们就已经是父母了呢？我们昨天不明明还是个孩子吗？……",[94,118,119],{},"牢骚，完全没内容的胡言乱语……困扰我的是失眠……我总会在深夜清醒……瞳孔在夜色的背后发亮，如光般穿透无边的深邃……无边是什么？无限有多大？每次思考这样的问题就让我痛不欲生……",[94,121,122],{},"不写了，干点别的……再睡。",{"title":124,"searchDepth":125,"depth":125,"links":126},"",2,[],[6],"md",{"date":130},"2009-03-15 03:52",true,"\u002Fblog\u002Fblog_4af9831b0100cdig",{"title":89,"description":104},"blog_4af9831b0100cdig","blog\u002Fblog_4af9831b0100cdig",[137],"杂谈","00CF_QimJ3DWBxsvSAsAWYcJxt8l0XAw2dRfUrVfpsQ",[140,145],{"title":141,"path":142,"stem":143,"children":-1,"slug":144},"“予文”——新春寄语","\u002Fblog\u002Fblog_4af9831b0100bx8c","blog\u002Fblog_4af9831b0100bx8c","blog_4af9831b0100bx8c",{"title":146,"path":147,"stem":148,"children":-1,"slug":149},"好的？坏的?","\u002Fblog\u002Fblog_4af9831b0100cmp6","blog\u002Fblog_4af9831b0100cmp6","blog_4af9831b0100cmp6",1794544667598]
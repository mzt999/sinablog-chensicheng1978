[{"data":1,"prerenderedAt":107},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b01009b6q":31,"surround-blog_4af9831b01009b6q":96},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",151,{"name":9,"len":10},"有图",34,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":84,"description":33,"extension":85,"meta":86,"navigation":88,"path":89,"seo":90,"slug":91,"stem":92,"tags":93,"__hash__":95},"blog\u002Fblog\u002Fblog_4af9831b01009b6q.md","做点什么？你们？",{"type":35,"value":36,"toc":80},"minimark",[37,41,44,47,50,53,56,59,62,65,68,71,74,77],[38,39,40],"p",{},"国家兴亡，匹夫有责！曾几何时，喜欢把国家，把担当，把责任挂在嘴边。",[38,42,43],{},"　　激扬文字，指点山河……",[38,45,46],{},"　　不知为何，最近没了此种激昂。现实打磨去了些许风华，与我，与大同……",[38,48,49],{},"　　此刻，那里的人们在受难。那是炼狱的一种，人间可见的极刑！",[38,51,52],{},"　　我想去，真的想！",[38,54,55],{},"　　那该是一种残忍的体验！却又该是最接近生命本质的一种透析！祝福所有在那里的人们！",[38,57,58],{},"　　中国，这个我们共有的名字。半个多世纪的沉沦，直至今天，刚又把滞重的腰板挺直，可又有这诸多的伤害不期而至……",[38,60,61],{},"　　可正因为这样，我们才更要把彼此抱得更紧！",[38,63,64],{},"　　是时候了，是时候向整个世界再次证明中国了！",[38,66,67],{},"　　中华民族，会在灾难面前显得更加强大！",[38,69,70],{},"　　用每一个人的力量，哪怕是绵薄之力，都要为这个国家做一点事！因为，有个事实无法改变：",[38,72,73],{},"　　我们都是，中国人。",[38,75,76],{},"　　————————————————————————　昨夜回京延误没来得及参加“同一首歌”赈灾义演，和“中央电台百名歌星抗灾义演”深表遗憾！今晚录制“华谊群星”赈灾歌曲“心中有爱”明日１６日赶赴福州录制东南卫视赈灾晚会，后天１７日赶赴郑州录制“重庆卫视”赈灾义演……………………",[38,78,79],{},"　　做点什么？你们？中国人？",{"title":81,"searchDepth":82,"depth":82,"links":83},"",2,[],[6],"md",{"date":87},"2008-05-15 16:08",true,"\u002Fblog\u002Fblog_4af9831b01009b6q",{"title":33,"description":33},"blog_4af9831b01009b6q","blog\u002Fblog_4af9831b01009b6q",[94],"杂谈","xJnTUJLCkh2JToFH5gXLG4-1CZ6VQ5KLelfdRfpkwbM",[97,102],{"title":98,"path":99,"st
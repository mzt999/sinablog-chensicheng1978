[{"data":1,"prerenderedAt":179},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":76,"blog-post-slug-blog_4af9831b0100dbqn":93,"surround-blog_4af9831b0100dbqn":168},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":38,"meta":50,"navLinks":51,"perPage":16,"prevNextIsExcludeDate":71,"site_description":72,"site_name":73,"stem":74,"__hash__":75},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,26,32],{"text":23},"粉丝自制非官方站点｜素材版权归原权利人所有",{"text":25},"仅兴趣交流、无商业用途｜如有侵权请联系删除",{"text":27,"link":28},"查看",{"href":29,"text":30,"fa_class":31},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":33,"link":34},"如有任何疑问，欢迎",{"href":35,"text":36,"fa_class":37},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[39,42,45,47],{"href":40,"text":41},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":43,"text":44},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":46},"新浪微博备份(2009-2026)",{"href":48,"text":49},"https:\u002F\u002Fmzt999.github.io\u002Fportfolio-chensicheng1978","幕后作品集展示(2012-2026)",{},[52,57,61,65,69],{"path":53,"title":54,"target":55,"fa_class":56},"\u002F","博客首页","internal","fa-home",{"path":58,"title":59,"target":55,"fa_class":60},"\u002Fabout","关于","fa-user",{"path":62,"title":63,"target":55,"fa_class":64},"\u002Fpost","归档","fa-archive",{"path":66,"title":67,"target":55,"fa_class":68},"\u002Fgallery","相册","fa-image",{"path":29,"title":30,"target":70,"fa_class":31},"otherSite",false,"新浪博客内容备份(粉丝自用)","陈思诚的博客","settings","5S7xKt0XLHpkjipbomx4I7pUu50Y7wqtD418LquZj5Q",{"latestBlog":77},[78,81,84,87,90],{"title":79,"slug":80},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":82,"slug":83},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":85,"slug":86},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":88,"slug":89},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":91,"slug":92},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":94,"title":95,"body":96,"categories":152,"description":153,"extension":154,"meta":155,"navigation":157,"path":158,"seo":159,"slug":160,"stem":161,"tags":162,"__hash__":167},"blog\u002Fblog\u002Fblog_4af9831b0100dbqn.md","春风沉醉嘎纳未醒 寒梅续放横店亦然",{"type":97,"value":98,"toc":148},"minimark",[99,103,106,109,112,115,118,121,124,127,130,133,136,139,142,145],[100,101,102],"p",{},"我是超人。这有吹牛的嫌疑。",[100,104,105],{},"我是战士。起码的。你也应该不会反对——",[100,107,108],{}," 昨天，16个小时的纯飞。加上其他交通工具的配合和等待时间，我从法国的嘎纳——尼斯机场——德国法兰科福——北京——杭州——横店总共花了25个小时。且我到达横店宾馆房间10分钟后，就开始化妆……因为，还有两场夜戏在等待着我……",[100,110,111],{},"   加上在嘎纳的最后一晚未睡，我拖着不知是谁的身体倒在床上的时候，粗粗一算，竟有50多个小时没有好好休息了…………",[100,113,114],{},"奇怪的是上床后——————我居然失眠了！",[100,116,117],{},"居然！！！！！！！！",[100,119,120],{},"然后，在翻来覆去的拧巴和一个电影的然后是——梦魇。",[100,122,123],{},"真的是梦魇。我被困在一个窘境，灵魂试图挣脱躯体……它仿佛成功了，却在未知的声音的指引下被困在了另一个更局促且不堪的境地……我奋力挣扎……",[100,125,126],{},"猛醒！原来是宾馆的床上……我的手停留在半空，呼吸急促。庆幸之余，是身体的过度疲惫和精神的奄奄一息。",[100,128,129],{},"一个梦前，是法国，是阳光沙滩美女，是关于电影的美梦成真和泡在香槟酒中的嘎纳。",[100,131,132],{},"一个梦醒，是横店，是宾馆景地宾馆，是关于拍摄的三点一线和此刻孤枕难眠的自己。",[100,134,135],{},"这才是生活……也许。",[100,137,138],{},"我苦笑了下，生活还要继续，拍摄必须顺利！明天的工作才是最不能马虎的……",[100,140,141],{},"强迫自己再睡下……",[100,143,144],{},"   也才有了。",[100,146,147],{},"结束今天的拍摄后，此刻的这篇文……",{"title":149,"searchDepth":150,"depth":150,"links":151},"",2,[],[6],"电影的美梦成真和泡在香槟酒中的嘎纳，拍摄的三点一线和此刻孤枕难眠的自己。","md",{"date":156},"2009-05-20 22:46",true,"\u002Fblog\u002Fblog_4af9831b0100dbqn",{"title":95,"description":153},"blog_4af9831b0100dbqn","blog\u002Fblog_4af9831b0100dbqn",[163,164,165,166],"62届嘎纳电影节","春风沉醉的晚上","一剪梅","杂谈","whUGe1B-6c9R9JeRRxBXA6X74EzjhpjryZUXk0HXQDo",[169,174],{"title":170,"path":171,"stem":172,"children":-1,"slug":173},"戛纳电影节的中国之夜","\u002Fblog\u002Fblog_4af9831b0100da82","blog\u002Fblog_4af9831b0100da82","blog_4af9831b0100da82",{"title":175,"path":176,"stem":177,"children":-1,"slug":178},"背影，前行……","\u002Fblog\u002Fblog_4af9831b0100de35","blog\u002Fblog_4af9831b0100de35","blog_4af9831b0100de35",1795162025726]
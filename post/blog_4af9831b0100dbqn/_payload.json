[{"data":1,"prerenderedAt":120},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":17,"blog-post-slug-blog_4af9831b0100dbqn":34,"surround-blog_4af9831b0100dbqn":109},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"latestBlog":18},[19,22,25,28,31],{"title":20,"slug":21},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":23,"slug":24},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":26,"slug":27},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":29,"slug":30},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":32,"slug":33},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":35,"title":36,"body":37,"categories":93,"description":94,"extension":95,"meta":96,"navigation":98,"path":99,"seo":100,"slug":101,"stem":102,"tags":103,"__hash__":108},"blog\u002Fblog\u002Fblog_4af9831b0100dbqn.md","春风沉醉嘎纳未醒 寒梅续放横店亦然",{"type":38,"value":39,"toc":89},"minimark",[40,44,47,50,53,56,59,62,65,68,71,74,77,80,83,86],[41,42,43],"p",{},"我是超人。这有吹牛的嫌疑。",[41,45,46],{},"我是战士。起码的。你也应该不会反对——",[41,48,49],{}," 昨天，16个小时的纯飞。加上其他交通工具的配合和等待时间，我从法国的嘎纳——尼斯机场——德国法兰科福——北京——杭州——横店总共花了25个小时。且我到达横店宾馆房间10分钟后，就开始化妆……因为，还有两场夜戏在等待着我……",[41,51,52],{},"   加上在嘎纳的最后一晚未睡，我拖着不知是谁的身体倒在床上的时候，粗粗一算，竟有50多个小时没有好好休息了…………",[41,54,55],{},"奇怪的是上床后——————我居然失眠了！",[41,57,58],{},"居然！！！！！！！！",[41,60,61],{},"然后，在翻来覆去的拧巴和一个电影的然后是——梦魇。",[41,63,64],{},"真的是梦魇。我被困在一个窘境，灵魂试图挣脱躯体……它仿佛成功了，却在未知的声音的指引下被困在了另一个更局促且不堪的境地……我奋力挣扎……",[41,66,67],{},"猛醒！原来是宾馆的床上……我的手停留在半空，呼吸急促。庆幸之余，是身体的过度疲惫和精神的奄奄一息。",[41,69,70],{},"一个梦前，是法国，是阳光沙滩美女，是关于电影的美梦成真和泡在香槟酒中的嘎纳。",[41,72,73],{},"一个梦醒，是横店，是宾馆景地宾馆，是关于拍摄的三点一线和此刻孤枕难眠的自己。",[41,75,76],{},"这才是生活……也许。",[41,78,79],{},"我苦笑了下，生活还要继续，拍摄必须顺利！明天的工作才是最不能马虎的……",[41,81,82],{},"强迫自己再睡下……",[41,84,85],{},"   也才有了。",[41,87,88],{},"结束今天的拍摄后，此刻的这篇文……",{"title":90,"searchDepth":91,"depth":91,"links":92},"",2,[],[6],"电影的美梦成真和泡在香槟酒中的嘎纳，拍摄的三点一线和此刻孤枕难眠的自己。","md",{"date":97},"2009-05-20 22:46",true,"\u002Fblog\u002Fblog_4af9831b0100dbqn",{"title":36,"description":94},"blog_4af9831b0100dbqn","blog\u002Fblog_4af9831b0100dbqn",[104,105,106,107],"62届嘎纳电影节","春风沉醉的晚上","一剪梅","杂谈","whUGe1B-6c9R9JeRRxBXA6X74EzjhpjryZUXk0HXQDo",[110,115],{"title":111,"path":112,"stem":113,"children":-1,"slug":114},"戛纳电影节的中国之夜","\u002Fblog\u002Fblog_4af9831b0100da82","blog\u002Fblog_4af9831b0100da82","blog_4af9831b0100da82",{"title":116,"path":117,"stem":118,"children":-1,"slug":119},"背影，前行……","\u002Fblog\u002Fblog_4af9831b0100de35","blog\u002Fblog_4af9831b0100de35","blog_4af9831b0100de35",1794130304228]
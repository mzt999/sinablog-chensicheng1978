[{"data":1,"prerenderedAt":173},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":70,"blog-post-slug-blog_4af9831b0100dbqn":87,"surround-blog_4af9831b0100dbqn":162},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":45,"navLinks":46,"perPage":16,"prevNextIsExcludeDate":66,"site_description":23,"site_name":67,"stem":68,"__hash__":69},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{},[47,52,56,60,64],{"path":48,"title":49,"target":50,"fa_class":51},"\u002F","博客首页","internal","fa-home",{"path":53,"title":54,"target":50,"fa_class":55},"\u002Fabout","关于","fa-user",{"path":57,"title":58,"target":50,"fa_class":59},"\u002Fpost","归档","fa-archive",{"path":61,"title":62,"target":50,"fa_class":63},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":65,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","jvZHccz2rT-wjVS5GCPgWyhl8WnBIvECPkE5KpKFKCU",{"latestBlog":71},[72,75,78,81,84],{"title":73,"slug":74},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":76,"slug":77},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":79,"slug":80},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":82,"slug":83},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":85,"slug":86},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":88,"title":89,"body":90,"categories":146,"description":147,"extension":148,"meta":149,"navigation":151,"path":152,"seo":153,"slug":154,"stem":155,"tags":156,"__hash__":161},"blog\u002Fblog\u002Fblog_4af9831b0100dbqn.md","春风沉醉嘎纳未醒 寒梅续放横店亦然",{"type":91,"value":92,"toc":142},"minimark",[93,97,100,103,106,109,112,115,118,121,124,127,130,133,136,139],[94,95,96],"p",{},"我是超人。这有吹牛的嫌疑。",[94,98,99],{},"我是战士。起码的。你也应该不会反对——",[94,101,102],{}," 昨天，16个小时的纯飞。加上其他交通工具的配合和等待时间，我从法国的嘎纳——尼斯机场——德国法兰科福——北京——杭州——横店总共花了25个小时。且我到达横店宾馆房间10分钟后，就开始化妆……因为，还有两场夜戏在等待着我……",[94,104,105],{},"   加上在嘎纳的最后一晚未睡，我拖着不知是谁的身体倒在床上的时候，粗粗一算，竟有50多个小时没有好好休息了…………",[94,107,108],{},"奇怪的是上床后——————我居然失眠了！",[94,110,111],{},"居然！！！！！！！！",[94,113,114],{},"然后，在翻来覆去的拧巴和一个电影的然后是——梦魇。",[94,116,117],{},"真的是梦魇。我被困在一个窘境，灵魂试图挣脱躯体……它仿佛成功了，却在未知的声音的指引下被困在了另一个更局促且不堪的境地……我奋力挣扎……",[94,119,120],{},"猛醒！原来是宾馆的床上……我的手停留在半空，呼吸急促。庆幸之余，是身体的过度疲惫和精神的奄奄一息。",[94,122,123],{},"一个梦前，是法国，是阳光沙滩美女，是关于电影的美梦成真和泡在香槟酒中的嘎纳。",[94,125,126],{},"一个梦醒，是横店，是宾馆景地宾馆，是关于拍摄的三点一线和此刻孤枕难眠的自己。",[94,128,129],{},"这才是生活……也许。",[94,131,132],{},"我苦笑了下，生活还要继续，拍摄必须顺利！明天的工作才是最不能马虎的……",[94,134,135],{},"强迫自己再睡下……",[94,137,138],{},"   也才有了。",[94,140,141],{},"结束今天的拍摄后，此刻的这篇文……",{"title":143,"searchDepth":144,"depth":144,"links":145},"",2,[],[6],"电影的美梦成真和泡在香槟酒中的嘎纳，拍摄的三点一线和此刻孤枕难眠的自己。","md",{"date":150},"2009-05-20 22:46",true,"\u002Fblog\u002Fblog_4af9831b0100dbqn",{"title":89,"description":147},"blog_4af9831b0100dbqn","blog\u002Fblog_4af9831b0100dbqn",[157,158,159,160],"62届嘎纳电影节","春风沉醉的晚上","一剪梅","杂谈","whUGe1B-6c9R9JeRRxBXA6X74EzjhpjryZUXk0HXQDo",[163,168],{"title":164,"path":165,"stem":166,"children":-1,"slug":167},"戛纳电影节的中国之夜","\u002Fblog\u002Fblog_4af9831b0100da82","blog\u002Fblog_4af9831b0100da82","blog_4af9831b0100da82",{"title":169,"path":170,"stem":171,"children":-1,"slug":172},"背影，前行……","\u002Fblog\u002Fblog_4af9831b0100de35","blog\u002Fblog_4af9831b0100de35","blog_4af9831b0100de35",1794544667546]
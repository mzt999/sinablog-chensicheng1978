[{"data":1,"prerenderedAt":116},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b0100dbqn":31,"surround-blog_4af9831b0100dbqn":105},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",151,{"name":9,"len":10},"有图",34,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":90,"description":33,"extension":91,"meta":92,"navigation":94,"path":95,"seo":96,"slug":97,"stem":98,"tags":99,"__hash__":104},"blog\u002Fblog\u002Fblog_4af9831b0100dbqn.md","春风沉醉嘎纳未醒 寒梅续放横店亦…",{"type":35,"value":36,"toc":86},"minimark",[37,41,44,47,50,53,56,59,62,65,68,71,74,77,80,83],[38,39,40],"p",{},"我是超人。这有吹牛的嫌疑。",[38,42,43],{},"我是战士。起码的。你也应该不会反对——",[38,45,46],{}," 昨天，16个小时的纯飞。加上其他交通工具的配合和等待时间，我从法国的嘎纳——尼斯机场——德国法兰科福——北京——杭州——横店总共花了25个小时。且我到达横店宾馆房间10分钟后，就开始化妆……因为，还有两场夜戏在等待着我……",[38,48,49],{},"   加上在嘎纳的最后一晚未睡，我拖着不知是谁的身体倒在床上的时候，粗粗一算，竟有50多个小时没有好好休息了…………",[38,51,52],{},"奇怪的是上床后——————我居然失眠了！",[38,54,55],{},"居然！！！！！！！！",[38,57,58],{},"然后，在翻来覆去的拧巴和一个电影的然后是——梦魇。",[38,60,61],{},"真的是梦魇。我被困在一个窘境，灵魂试图挣脱躯体……它仿佛成功了，却在未知的声音的指引下被困在了另一个更局促且不堪的境地……我奋力挣扎……",[38,63,64],{},"猛醒！原来是宾馆的床上……我的手停留在半空，呼吸急促。庆幸之余，是身体的过度疲惫和精神的奄奄一息。",[38,66,67],{},"一个梦前，是法国，是阳光沙滩美女，是关于电影的美梦成真和泡在香槟酒中的嘎纳。",[38,69,70],{},"一个梦醒，是横店，是宾馆景地宾馆，是关于拍摄的三点一线和此刻孤枕难眠的自己。",[38,72,73],{},"这才是生活……也许。",[38,75,76],{},"我苦笑了下，生活还要继续，拍摄必须顺利！明天的工作才是最不能马虎的……",[38,78,79],{},"强迫自己再睡下……",[38,81,82],{},"   也才有了。",[38,84,85],{},"结束今天的拍摄后，此刻的这篇文……",{"title":87,"searchDepth":88,"depth":88,"links":89},"",2,[],[6],"md",{"date":93},"2009-05-20 22:46",true,"\u002Fblog\u002Fblog_4af9831b0100dbqn",{"title":33,"description":33},"blog_4af9831b0100dbqn","blog\u002Fblog_4af9831b0100dbqn",[100,101,102,103],"62届嘎纳电影节","春风沉醉的晚上","一剪梅","杂谈","wbkgmSgzjs3StfXlvrgz-OE-OwRy9Bw1tiee44Q0ac0",[106,111],{"title":107,"path":108,"stem":109,"children":-1,"slug":110},"戛纳电影节的中国之夜","\u002Fblog\u002Fblog_4af9831b0100da82","blog\u002Fblog_4af9831b0100da82","blog_4af9831b0100da82",{"title":112,"path":113,"stem":114,"children":-1,"slug":115},"《春风》获奖印证华语电影的春天","\u002Fblog\u002Fblog_4af9831b0100dgqa","blog\u002Fblog_4af9831b0100dgqa","blog_4af9831b0100dgqa",1793777044656]
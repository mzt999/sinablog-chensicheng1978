[{"data":1,"prerenderedAt":160},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":57,"blog-post-slug-blog_4af9831b0100dbqn":74,"surround-blog_4af9831b0100dbqn":149},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":16,"site_description":54,"stem":55,"__hash__":56},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo","新浪博客内容备份(粉丝自用)","settings","jPD1QWrYwbaIixg6lntppEYe-T3ZGd3EJZxFBkbKY9E",{"latestBlog":58},[59,62,65,68,71],{"title":60,"slug":61},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":63,"slug":64},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":66,"slug":67},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":69,"slug":70},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":72,"slug":73},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":75,"title":76,"body":77,"categories":133,"description":134,"extension":135,"meta":136,"navigation":138,"path":139,"seo":140,"slug":141,"stem":142,"tags":143,"__hash__":148},"blog\u002Fblog\u002Fblog_4af9831b0100dbqn.md","春风沉醉嘎纳未醒 寒梅续放横店亦然",{"type":78,"value":79,"toc":129},"minimark",[80,84,87,90,93,96,99,102,105,108,111,114,117,120,123,126],[81,82,83],"p",{},"我是超人。这有吹牛的嫌疑。",[81,85,86],{},"我是战士。起码的。你也应该不会反对——",[81,88,89],{}," 昨天，16个小时的纯飞。加上其他交通工具的配合和等待时间，我从法国的嘎纳——尼斯机场——德国法兰科福——北京——杭州——横店总共花了25个小时。且我到达横店宾馆房间10分钟后，就开始化妆……因为，还有两场夜戏在等待着我……",[81,91,92],{},"   加上在嘎纳的最后一晚未睡，我拖着不知是谁的身体倒在床上的时候，粗粗一算，竟有50多个小时没有好好休息了…………",[81,94,95],{},"奇怪的是上床后——————我居然失眠了！",[81,97,98],{},"居然！！！！！！！！",[81,100,101],{},"然后，在翻来覆去的拧巴和一个电影的然后是——梦魇。",[81,103,104],{},"真的是梦魇。我被困在一个窘境，灵魂试图挣脱躯体……它仿佛成功了，却在未知的声音的指引下被困在了另一个更局促且不堪的境地……我奋力挣扎……",[81,106,107],{},"猛醒！原来是宾馆的床上……我的手停留在半空，呼吸急促。庆幸之余，是身体的过度疲惫和精神的奄奄一息。",[81,109,110],{},"一个梦前，是法国，是阳光沙滩美女，是关于电影的美梦成真和泡在香槟酒中的嘎纳。",[81,112,113],{},"一个梦醒，是横店，是宾馆景地宾馆，是关于拍摄的三点一线和此刻孤枕难眠的自己。",[81,115,116],{},"这才是生活……也许。",[81,118,119],{},"我苦笑了下，生活还要继续，拍摄必须顺利！明天的工作才是最不能马虎的……",[81,121,122],{},"强迫自己再睡下……",[81,124,125],{},"   也才有了。",[81,127,128],{},"结束今天的拍摄后，此刻的这篇文……",{"title":130,"searchDepth":131,"depth":131,"links":132},"",2,[],[6],"电影的美梦成真和泡在香槟酒中的嘎纳，拍摄的三点一线和此刻孤枕难眠的自己。","md",{"date":137},"2009-05-20 22:46",true,"\u002Fblog\u002Fblog_4af9831b0100dbqn",{"title":76,"description":134},"blog_4af9831b0100dbqn","blog\u002Fblog_4af9831b0100dbqn",[144,145,146,147],"62届嘎纳电影节","春风沉醉的晚上","一剪梅","杂谈","whUGe1B-6c9R9JeRRxBXA6X74EzjhpjryZUXk0HXQDo",[150,155],{"title":151,"path":152,"stem":153,"children":-1,"slug":154},"戛纳电影节的中国之夜","\u002Fblog\u002Fblog_4af9831b0100da82","blog\u002Fblog_4af9831b0100da82","blog_4af9831b0100da82",{"title":156,"path":157,"stem":158,"children":-1,"slug":159},"背影，前行……","\u002Fblog\u002Fblog_4af9831b0100de35","blog\u002Fblog_4af9831b0100de35","blog_4af9831b0100de35",1794473705188]
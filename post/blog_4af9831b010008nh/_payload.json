[{"data":1,"prerenderedAt":180},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":58,"blog-post-slug-blog_4af9831b010008nh":75,"surround-blog_4af9831b010008nh":169},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":54,"site_description":55,"stem":56,"__hash__":57},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo",20,"新浪博客内容备份","settings","hh8X7X6SFDoeJrxIJ4yisZXSc3HwHM1zk206jiQX2XU",{"latestBlog":59},[60,63,66,69,72],{"title":61,"slug":62},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":64,"slug":65},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":67,"slug":68},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":70,"slug":71},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":73,"slug":74},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":76,"title":77,"body":78,"categories":157,"description":158,"extension":159,"meta":160,"navigation":162,"path":163,"seo":164,"slug":165,"stem":166,"tags":167,"__hash__":168},"blog\u002Fblog\u002Fblog_4af9831b010008nh.md","变",{"type":79,"value":80,"toc":153},"minimark",[81,85,88,91,94,97,100,103,106,109,112,115,118,121,124,127,130,133,136,139,142,145,148,151],[82,83,84],"p",{},"等了7天\n努力爬上来",[82,86,87],{},"我笑着\n用冰凉的手   翻看新剧本",[82,89,90],{},"故事中太多措手不及",[82,92,93],{},"如同今天的阳光\n刺眼\n眩晕   刺眼",[82,95,96],{},"温度让我蒸发",[82,98,99],{},"没有信念的人",[82,101,102],{},"白天的地面\n会感同\n炼狱",[82,104,105],{},"还好\n此刻   夜晚",[82,107,108],{},"第二次\n从个名叫“爵士道”的地方走回",[82,110,111],{},"依旧汗津津的背后",[82,113,114],{},"却凭的多出道\n苍凉",[82,116,117],{},"看到身边的人如此执拗相爱",[82,119,120],{},"本是我的福   本是",[82,122,123],{},"就偷偷摒弃祝愿放任下嫉妒\n想谁都会原谅我的  透支",[82,125,126],{},"世事太多变数\n我们总无力的被席卷",[82,128,129],{},"还以为可抓得住一丝最后",[82,131,132],{},"依旧   是裹狭",[82,134,135],{},"只剩坚持",[82,137,138],{},"你明白自己必须成为\n战士",[82,140,141],{},"当自爱变做自恋\n自律变做自虐 自省变做自诩 自尊变做自渎",[82,143,144],{},"这世界怎会再有\n一尘不染",[82,146,147],{},"万物都会变\n我想",[82,149,150],{},"唯一不变的只剩",[82,152,77],{},{"title":154,"searchDepth":155,"depth":155,"links":156},"",2,[],[6],"等了7天 努力爬上来","md",{"date":161},"2007-05-30 00:58",true,"\u002Fblog\u002Fblog_4af9831b010008nh",{"title":77,"description":158},"blog_4af9831b010008nh","blog\u002Fblog_4af9831b010008nh",[],"Fz8VRzU7vUhIbsbnMPjNp12KYDZtZNsRXGVdLXiQI_U",[170,175],{"title":171,"path":172,"stem":173,"children":-1,"slug":174},"生日快乐","\u002Fblog\u002Fblog_4af9831b010008nf","blog\u002Fblog_4af9831b010008nf","blog_4af9831b010008nf",{"title":176,"path":177,"stem":178,"children":-1,"slug":179},"问好","\u002Fblog\u002Fblog_4af9831b010008ri","blog\u002Fblog_4af9831b010008ri","blog_4af9831b010008ri",1794412501215]
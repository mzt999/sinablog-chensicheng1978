},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":88,"slug":89},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":91,"slug":92},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":94,"title":95,"body":96,"categories":175,"description":176,"extension":177,"meta":178,"navigation":180,"path":181,"seo":182,"slug":183,"stem":184,"tags":185,"__hash__":186},"blog\u002Fblog\u002Fblog_4af9831b010008nh.md","变",{"type":97,"value":98,"toc":171},"minimark",[99,103,106,109,112,115,118,121,124,127,130,133,136,139,142,145,148,151,154,157,160,163,166,169],[100,101,102],"p",{},"等了7天\n努力爬上来",[100,104,105],{},"我笑着\n用冰凉的手   翻看新剧本",[100,107,108],{},"故事中太多措手不及",[100,110,111],{},"如同今天的阳光\n刺眼\n眩晕   刺眼",[100,113,114],{},"温度让我蒸发",[100,116,117],{},"没有信念的人",[100,119,120],{},"白天的地面\n会感同\n炼狱",[100,122,123],{},"还好\n此刻   夜晚",[100,125,126],{},"第二次\n从个名叫“爵士道”的地方走回",[100,128,129],{},"依旧汗津津的背后",[100,131,132],{},"却凭的多出道\n苍凉",[100,134,135],{},"看到身边的人如此执拗相爱",[100,137,138],{},"本是我的福   本是",[100,140,141],{},"就偷偷摒弃祝愿放任下嫉妒\n想谁都会原谅我的  透支",[100,143,144],{},"世事太多变数\n我们总无力的被席卷",[100,146,147],{},"还以为可抓得住一丝最后",[100,149,150],{},"依旧   是裹狭",[100,152,153],{},"只剩坚持",[100,155,156],{},"你明白自己必须成为\n战士",[100,158,159],{},"当自爱变做自恋\n自律变做自虐 自省变做自诩 自尊变做自渎",[100,161,162],{},"这世界怎会再有\n一尘不染",[100,164,165],{},"万物都会变\n我想",[100,167,168],{},"唯一不变的只剩",[100,170,95],{},{"title":172,"searchDepth":173,"depth":173,"links":174},"",2,[],[6],"等了7天 努力爬上来","md",{"date":179},"2007-05-30 00:58",true,"\u002Fblog\u002Fblog_4af9831b010008nh",{"title":95,"description":176},"blog_4af9831b010008nh","blog\u002Fblog_4af9831b010008nh",[],"Fz8VRzU7vUhIbsbnMPjNp12KYDZtZNsRXGVdLXiQI_U",[188,193],{"title":189,"path":190,"stem":191,"children":-1,"slug":192},"生日快乐","\u002Fblog\u002Fblog_4af9831b010008nf","blog\u002Fblog_4af9831b010008nf","blog_4af9831b010008nf",{"title":194,"path":195,"stem":196,"children":-1,"slug":197},"问好","\u002Fblog\u002Fblog_4af9831b010008ri","blog\u002Fblog_4af9831b010008ri","blog_4af9831b010008ri",1795162026224]
[{"data":1,"prerenderedAt":139},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":17,"blog-post-slug-blog_4af9831b010008nh":34,"surround-blog_4af9831b010008nh":128},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"latestBlog":18},[19,22,25,28,31],{"title":20,"slug":21},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":23,"slug":24},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":26,"slug":27},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":29,"slug":30},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":32,"slug":33},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":35,"title":36,"body":37,"categories":116,"description":117,"extension":118,"meta":119,"navigation":121,"path":122,"seo":123,"slug":124,"stem":125,"tags":126,"__hash__":127},"blog\u002Fblog\u002Fblog_4af9831b010008nh.md","变",{"type":38,"value":39,"toc":112},"minimark",[40,44,47,50,53,56,59,62,65,68,71,74,77,80,83,86,89,92,95,98,101,104,107,110],[41,42,43],"p",{},"等了7天\n努力爬上来",[41,45,46],{},"我笑着\n用冰凉的手   翻看新剧本",[41,48,49],{},"故事中太多措手不及",[41,51,52],{},"如同今天的阳光\n刺眼\n眩晕   刺眼",[41,54,55],{},"温度让我蒸发",[41,57,58],{},"没有信念的人",[41,60,61],{},"白天的地面\n会感同\n炼狱",[41,63,64],{},"还好\n此刻   夜晚",[41,66,67],{},"第二次\n从个名叫“爵士道”的地方走回",[41,69,70],{},"依旧汗津津的背后",[41,72,73],{},"却凭的多出道\n苍凉",[41,75,76],{},"看到身边的人如此执拗相爱",[41,78,79],{},"本是我的福   本是",[41,81,82],{},"就偷偷摒弃祝愿放任下嫉妒\n想谁都会原谅我的  透支",[41,84,85],{},"世事太多变数\n我们总无力的被席卷",[41,87,88],{},"还以为可抓得住一丝最后",[41,90,91],{},"依旧   是裹狭",[41,93,94],{},"只剩坚持",[41,96,97],{},"你明白自己必须成为\n战士",[41,99,100],{},"当自爱变做自恋\n自律变做自虐 自省变做自诩 自尊变做自渎",[41,102,103],{},"这世界怎会再有\n一尘不染",[41,105,106],{},"万物都会变\n我想",[41,108,109],{},"唯一不变的只剩",[41,111,36],{},{"title":113,"searchDepth":114,"depth":114,"links":115},"",2,[],[6],"等了7天 努力爬上来","md",{"date":120},"2007-05-30 00:58",true,"\u002Fblog\u002Fblog_4af9831b010008nh",{"title":36,"description":117},"blog_4af9831b010008nh","blog\u002Fblog_4af9831b010008nh",[],"Fz8VRzU7vUhIbsbn
[{"data":1,"prerenderedAt":135},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b010008nh":31,"surround-blog_4af9831b010008nh":124},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",152,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":113,"description":33,"extension":114,"meta":115,"navigation":117,"path":118,"seo":119,"slug":120,"stem":121,"tags":122,"__hash__":123},"blog\u002Fblog\u002Fblog_4af9831b010008nh.md","变",{"type":35,"value":36,"toc":109},"minimark",[37,41,44,47,50,53,56,59,62,65,68,71,74,77,80,83,86,89,92,95,98,101,104,107],[38,39,40],"p",{},"等了7天\n努力爬上来",[38,42,43],{},"我笑着\n用冰凉的手   翻看新剧本",[38,45,46],{},"故事中太多措手不及",[38,48,49],{},"如同今天的阳光\n刺眼\n眩晕   刺眼",[38,51,52],{},"温度让我蒸发",[38,54,55],{},"没有信念的人",[38,57,58],{},"白天的地面\n会感同\n炼狱",[38,60,61],{},"还好\n此刻   夜晚",[38,63,64],{},"第二次\n从个名叫“爵士道”的地方走回",[38,66,67],{},"依旧汗津津的背后",[38,69,70],{},"却凭的多出道\n苍凉",[38,72,73],{},"看到身边的人如此执拗相爱",[38,75,76],{},"本是我的福   本是",[38,78,79],{},"就偷偷摒弃祝愿放任下嫉妒\n想谁都会原谅我的  透支",[38,81,82],{},"世事太多变数\n我们总无力的被席卷",[38,84,85],{},"还以为可抓得住一丝最后",[38,87,88],{},"依旧   是裹狭",[38,90,91],{},"只剩坚持",[38,93,94],{},"你明白自己必须成为\n战士",[38,96,97],{},"当自爱变做自恋\n自律变做自虐 自省变做自诩 自尊变做自渎",[38,99,100],{},"这世界怎会再有\n一尘不染",[38,102,103],{},"万物都会变\n我想",[38,105,106],{},"唯一不变的只剩",[38,108,33],{},{"title":110,"searchDepth":111,"depth":111,"links":112},"",2,[],[6],"md",{"date":116},"2007-05-30 00:58",true,"\u002Fblog\u002Fblog_4af9831b010008nh",{"title":33,"description":33},"blog_4af9831b010008nh","blog\u002Fblog_4af9831b010008nh",[],"GNeUbvIJ3CSTET0Wn6GjOpyIksX1wRaIoUtUBC5ptvo",[125,130],{"title":126,
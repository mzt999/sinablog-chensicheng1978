[{"data":1,"prerenderedAt":179},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":57,"blog-post-slug-blog_4af9831b010008nh":74,"surround-blog_4af9831b010008nh":168},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":16,"site_description":54,"stem":55,"__hash__":56},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo","新浪博客内容备份(粉丝自用)","settings","jPD1QWrYwbaIixg6lntppEYe-T3ZGd3EJZxFBkbKY9E",{"latestBlog":58},[59,62,65,68,71],{"title":60,"slug":61},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":63,"slug":64},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":66,"slug":67},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":69,"slug":70},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":72,"slug":73},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":75,"title":76,"body":77,"categories":156,"description":157,"extension":158,"meta":159,"navigation":161,"path":162,"seo":163,"slug":164,"stem":165,"tags":166,"__hash__":167},"blog\u002Fblog\u002Fblog_4af9831b010008nh.md","变",{"type":78,"value":79,"toc":152},"minimark",[80,84,87,90,93,96,99,102,105,108,111,114,117,120,123,126,129,132,135,138,141,144,147,150],[81,82,83],"p",{},"等了7天\n努力爬上来",[81,85,86],{},"我笑着\n用冰凉的手   翻看新剧本",[81,88,89],{},"故事中太多措手不及",[81,91,92],{},"如同今天的阳光\n刺眼\n眩晕   刺眼",[81,94,95],{},"温度让我蒸发",[81,97,98],{},"没有信念的人",[81,100,101],{},"白天的地面\n会感同\n炼狱",[81,103,104],{},"还好\n此刻   夜晚",[81,106,107],{},"第二次\n从个名叫“爵士道”的地方走回",[81,109,110],{},"依旧汗津津的背后",[81,112,113],{},"却凭的多出道\n苍凉",[81,115,116],{},"看到身边的人如此执拗相爱",[81,118,119],{},"本是我的福   本是",[81,121,122],{},"就偷偷摒弃祝愿放任下嫉妒\n想谁都会原谅我的  透支",[81,124,125],{},"世事太多变数\n我们总无力的被席卷",[81,127,128],{},"还以为可抓得住一丝最后",[81,130,131],{},"依旧   是裹狭",[81,133,134],{},"只剩坚持",[81,136,137],{},"你明白自己必须成为\n战士",[81,139,140],{},"当自爱变做自恋\n自律变做自虐 自省变做自诩 自尊变做自渎",[81,142,143],{},"这世界怎会再有\n一尘不染",[81,145,146],{},"万物都会变\n我想",[81,148,149],{},"唯一不变的只剩",[81,151,76],{},{"title":153,"searchDepth":154,"depth":154,"links":155},"",2,[],[6],"等了7天 努力爬上来","md",{"date":160},"2007-05-30 00:58",true,"\u002Fblog\u002Fblog_4af9831b010008nh",{"title":76,"description":157},"blog_4af9831b010008nh","blog\u002Fblog_4af9831b010008nh",[],"Fz8VRzU7vUhIbsbnMPjNp12KYDZtZNsRXGVdLXiQI_U",[169,174],{"title":170,"path":171,"stem":172,"children":-1,"slug":173},"生日快乐","\u002Fblog\u002Fblog_4af9831b010008nf","blog\u002Fblog_4af9831b010008nf","blog_4af9831b010008nf",{"title":175,"path":176,"stem":177,"children":-1,"slug":178},"问好","\u002Fblog\u002Fblog_4af9831b010008ri","blog\u002Fblog_4af9831b010008ri","blog_4af9831b010008ri",1794473705902]
[{"data":1,"prerenderedAt":192},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":70,"blog-post-slug-blog_4af9831b010008nh":87,"surround-blog_4af9831b010008nh":181},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":45,"navLinks":46,"perPage":16,"prevNextIsExcludeDate":66,"site_description":23,"site_name":67,"stem":68,"__hash__":69},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{},[47,52,56,60,64],{"path":48,"title":49,"target":50,"fa_class":51},"\u002F","博客首页","internal","fa-home",{"path":53,"title":54,"target":50,"fa_class":55},"\u002Fabout","关于","fa-user",{"path":57,"title":58,"target":50,"fa_class":59},"\u002Fpost","归档","fa-archive",{"path":61,"title":62,"target":50,"fa_class":63},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":65,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","jvZHccz2rT-wjVS5GCPgWyhl8WnBIvECPkE5KpKFKCU",{"latestBlog":71},[72,75,78,81,84],{"title":73,"slug":74},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":76,"slug":77},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":79,"slug":80},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":82,"slug":83},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":85,"slug":86},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":88,"title":89,"body":90,"categories":169,"description":170,"extension":171,"meta":172,"navigation":174,"path":175,"seo":176,"slug":177,"stem":178,"tags":179,"__hash__":180},"blog\u002Fblog\u002Fblog_4af9831b010008nh.md","变",{"type":91,"value":92,"toc":165},"minimark",[93,97,100,103,106,109,112,115,118,121,124,127,130,133,136,139,142,145,148,151,154,157,160,163],[94,95,96],"p",{},"等了7天\n努力爬上来",[94,98,99],{},"我笑着\n用冰凉的手   翻看新剧本",[94,101,102],{},"故事中太多措手不及",[94,104,105],{},"如同今天的阳光\n刺眼\n眩晕   刺眼",[94,107,108],{},"温度让我蒸发",[94,110,111],{},"没有信念的人",[94,113,114],{},"白天的地面\n会感同\n炼狱",[94,116,117],{},"还好\n此刻   夜晚",[94,119,120],{},"第二次\n从个名叫“爵士道”的地方走回",[94,122,123],{},"依旧汗津津的背后",[94,125,126],{},"却凭的多出道\n苍凉",[94,128,129],{},"看到身边的人如此执拗相爱",[94,131,132],{},"本是我的福   本是",[94,134,135],{},"就偷偷摒弃祝愿放任下嫉妒\n想谁都会原谅我的  透支",[94,137,138],{},"世事太多变数\n我们总无力的被席卷",[94,140,141],{},"还以为可抓得住一丝最后",[94,143,144],{},"依旧   是裹狭",[94,146,147],{},"只剩坚持",[94,149,150],{},"你明白自己必须成为\n战士",[94,152,153],{},"当自爱变做自恋\n自律变做自虐 自省变做自诩 自尊变做自渎",[94,155,156],{},"这世界怎会再有\n一尘不染",[94,158,159],{},"万物都会变\n我想",[94,161,162],{},"唯一不变的只剩",[94,164,89],{},{"title":166,"searchDepth":167,"depth":167,"links":168},"",2,[],[6],"等了7天 努力爬上来","md",{"date":173},"2007-05-30 00:58",true,"\u002Fblog\u002Fblog_4af9831b010008nh",{"title":89,"description":170},"blog_4af9831b010008nh","blog\u002Fblog_4af9831b010008nh",[],"Fz8VRzU7vUhIbsbnMPjNp12KYDZtZNsRXGVdLXiQI_U",[182,187],{"title":183,"path":184,"stem":185,"children":-1,"slug":186},"生日快乐","\u002Fblog\u002Fblog_4af9831b010008nf","blog\u002Fblog_4af9831b010008nf","blog_4af9831b010008nf",{"title":188,"path":189,"stem":190,"children":-1,"slug":191},"问好","\u002Fblog\u002Fblog_4af9831b010008ri","blog\u002Fblog_4af9831b010008ri","blog_4af9831b010008ri",1794544668088]
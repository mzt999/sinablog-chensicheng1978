“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":88,"slug":89},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":91,"title":92,"body":93,"categories":172,"description":173,"extension":174,"meta":175,"navigation":177,"path":178,"seo":179,"slug":180,"stem":181,"tags":182,"__hash__":183},"blog\u002Fblog\u002Fblog_4af9831b010008nh.md","变",{"type":94,"value":95,"toc":168},"minimark",[96,100,103,106,109,112,115,118,121,124,127,130,133,136,139,142,145,148,151,154,157,160,163,166],[97,98,99],"p",{},"等了7天\n努力爬上来",[97,101,102],{},"我笑着\n用冰凉的手   翻看新剧本",[97,104,105],{},"故事中太多措手不及",[97,107,108],{},"如同今天的阳光\n刺眼\n眩晕   刺眼",[97,110,111],{},"温度让我蒸发",[97,113,114],{},"没有信念的人",[97,116,117],{},"白天的地面\n会感同\n炼狱",[97,119,120],{},"还好\n此刻   夜晚",[97,122,123],{},"第二次\n从个名叫“爵士道”的地方走回",[97,125,126],{},"依旧汗津津的背后",[97,128,129],{},"却凭的多出道\n苍凉",[97,131,132],{},"看到身边的人如此执拗相爱",[97,134,135],{},"本是我的福   本是",[97,137,138],{},"就偷偷摒弃祝愿放任下嫉妒\n想谁都会原谅我的  透支",[97,140,141],{},"世事太多变数\n我们总无力的被席卷",[97,143,144],{},"还以为可抓得住一丝最后",[97,146,147],{},"依旧   是裹狭",[97,149,150],{},"只剩坚持",[97,152,153],{},"你明白自己必须成为\n战士",[97,155,156],{},"当自爱变做自恋\n自律变做自虐 自省变做自诩 自尊变做自渎",[97,158,159],{},"这世界怎会再有\n一尘不染",[97,161,162],{},"万物都会变\n我想",[97,164,165],{},"唯一不变的只剩",[97,167,92],{},{"title":169,"searchDepth":170,"depth":170,"links":171},"",2,[],[6],"等了7天 努力爬上来","md",{"date":176},"2007-05-30 00:58",true,"\u002Fblog\u002Fblog_4af9831b010008nh",{"title":92,"description":173},"blog_4af9831b010008nh","blog\u002Fblog_4af9831b010008nh",[],"Fz8VRzU7vUhIbsbnMPjNp12KYDZtZNsRXGVdLXiQI_U",[185,190],{"title":186,"path":187,"stem":188,"children":-1,"slug":189},"生日快乐","\u002Fblog\u002Fblog_4af9831b010008nf","blog\u002Fblog_4af9831b010008nf","blog_4af9831b010008nf",{"title":191,"path":192,"stem":193,"children":-1,"slug":194},"问好","\u002Fblog\u002Fblog_4af9831b010008ri","blog\u002Fblog_4af9831b010008ri","blog_4af9831b010008ri",1794760532514]
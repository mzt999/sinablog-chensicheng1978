":89,"body":90,"categories":131,"description":132,"extension":133,"meta":134,"navigation":136,"path":137,"seo":138,"slug":139,"stem":140,"tags":141,"__hash__":143},"blog\u002Fblog\u002Fblog_4af9831b0100aof0.md","祝福 献给“命运”",{"type":91,"value":92,"toc":127},"minimark",[93,97,100,103,106,109,112,115,118,121,124],[94,95,96],"p",{},"散会了。很想说点什么。",[94,98,99],{},"但太想说，想说的又太多。索性，都不说了！",[94,101,102],{},"只当纪念，为了以后的日子可以回顾这个夜晚……",[94,104,105],{},"命运。很难有比这更大的戏了。",[94,107,108],{},"谁选择谁只是表象。",[94,110,111],{},"事实。我们早被安排了！",[94,113,114],{},"  我为能有今天的一切感恩，命运不仅让我有了体验，更让自己觉得终于有机会为国家民族做点什么了。",[94,116,117],{},"我为自己是一个中国人，尤其是此际的中国人骄傲。",[94,119,120],{},"活在当下，真好……",[94,122,123],{},"祝福你。命运！",[94,125,126],{},"祝福你。我的祖国！",{"title":128,"searchDepth":129,"depth":129,"links":130},"",2,[],[6],"命运不仅让我有了体验，更让自己觉得终于有机会为国家民族做点什么了。","md",{"date":135},"2008-09-17 21:18",true,"\u002Fblog\u002Fblog_4af9831b0100aof0",{"title":89,"description":132},"blog_4af9831b0100aof0","blog\u002Fblog_4af9831b0100aof0",[142],"杂谈","_AM8-65Fnki5dpuc4LW7nCS45PZ8Fh5He7VySvmmcfs",[145,150],{"title":146,"path":147,"stem":148,"children":-1,"slug":149},"命运","\u002Fblog\u002Fblog_4af9831b0100aiz0","blog\u002Fblog_4af9831b0100aiz0","blog_4af9831b0100aiz0",{"title":151,"path":152,"stem":153,"children":-1,"slug":154},"痕迹","\u002Fblog\u002Fblog_4af9831b0100ar4i","blog\u002Fblog_4af9831b0100ar4i","blog_4af9831b0100ar4i",1794544667647]
[{"data":1,"prerenderedAt":133},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":57,"blog-post-slug-blog_4af9831b010009we":74,"surround-blog_4af9831b010009we":122},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":16,"site_description":54,"stem":55,"__hash__":56},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo","新浪博客内容备份(粉丝自用)","settings","jPD1QWrYwbaIixg6lntppEYe-T3ZGd3EJZxFBkbKY9E",{"latestBlog":58},[59,62,65,68,71],{"title":60,"slug":61},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":63,"slug":64},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":66,"slug":67},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":69,"slug":70},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":72,"slug":73},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":75,"title":76,"body":77,"categories":109,"description":110,"extension":111,"meta":112,"navigation":114,"path":115,"seo":116,"slug":117,"stem":118,"tags":119,"__hash__":121},"blog\u002Fblog\u002Fblog_4af9831b010009we.md","男人和女人不一样我和别人不一样的就是生理周期表现方式不一样",{"type":78,"value":79,"toc":105},"minimark",[80,84,87,90,93,96,99,102],[81,82,83],"p",{},"不知何故纸条箱就是打不开,成了顽固的哑巴.又是夜深?越夜越美丽?没脸没皮才是我的天赋异禀.其实.",[81,85,86],{},"昨天看了\"妈妈咪呀\"还成.但也许是自己的长大,没了最初看\"美女与野兽\"时的激情?怎么仿佛离戏剧舞台越来越远?还是压根就没近过?",[81,88,89],{},"收到了两份不远的礼物,很开心,感动...觉得美好其实很简单,幸福真的离自己不远...",[81,91,92],{},"\"士兵\"好像真的开始被大家关注?谁的终点?谁的起程?谁的颠峰?谁的曲径?不重要,因为是\"因\"而不是\"果\",还没到真的最后,我们同在路上...",[81,94,95],{},"放上音乐只想分享,想你们懂,懂我的那部分柔软.温情放大数倍也许是滥情?也许不是.什么才是生命的名字?体验?也许不是...别人笑我太疯癫?但还是觉得看不穿的是多数是众人...",[81,97,98],{},"因为失去过些许,仰或是自愿放弃,或不是.才会越发觉得旧情弥足珍贵,就算灰尘在身上久了,也会侵入到肌肤深植与骨髓溶化进血脉...",[81,100,101],{},"我本是个天真的人,有颗孩子的心,却左脚踩到地狱,右手勾握天堂...所以选择非常的活,无法停驻只能漂流,追寻美好也迷恋罪恶.嗜血又童贞,冷酷且温柔...心知无用.还是忍不住竭力拥抱那份虚无......",[81,103,104],{},"每个月的生理周期我的表现形式就是胡说八道,所以又开始了梦呓...谅解.睡了.所有生灵...晚安!",{"title":106,"searchDepth":107,"depth":107,"links":108},"",2,[],[6],"不知何故纸条箱就是打不开,成了顽固的哑巴.","md",{"date":113},"2007-08-16 03:06",true,"\u002Fblog\u002Fblog_4af9831b010009we",{"title":76,"description":110},"blog_4af9831b010009we","blog\u002Fblog_4af9831b010009we",[120],"随笔\u002F感悟","4wyMWcR6PmhJLaevdq-7l6BaLVadqaetotjBv3tr1F8",[123,128],{"title":124,"path":125,"stem":126,"children":-1,"slug":127},"晚不安","\u002Fblog\u002Fblog_4af9831b010009t5","blog\u002Fblog_4af9831b010009t5","blog_4af9831b010009t5",{"title":129,"path":130,"stem":131,"children":-1,"slug":132},"记录昨天下午的打赌","\u002Fblog\u002Fblog_4af9831b010009xd","blog\u002Fblog_4af9831b010009xd","blog_4af9831b010009xd",1794473705756]
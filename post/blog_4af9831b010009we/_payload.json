[{"data":1,"prerenderedAt":89},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b010009we":31,"surround-blog_4af9831b010009we":78},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",151,{"name":9,"len":10},"有图",34,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":66,"description":33,"extension":67,"meta":68,"navigation":70,"path":71,"seo":72,"slug":73,"stem":74,"tags":75,"__hash__":77},"blog\u002Fblog\u002Fblog_4af9831b010009we.md","男人和女人不一样我和别人不一样的…",{"type":35,"value":36,"toc":62},"minimark",[37,41,44,47,50,53,56,59],[38,39,40],"p",{},"不知何故纸条箱就是打不开,成了顽固的哑巴.又是夜深?越夜越美丽?没脸没皮才是我的天赋异禀.其实.",[38,42,43],{},"昨天看了\"妈妈咪呀\"还成.但也许是自己的长大,没了最初看\"美女与野兽\"时的激情?怎么仿佛离戏剧舞台越来越远?还是压根就没近过?",[38,45,46],{},"收到了两份不远的礼物,很开心,感动...觉得美好其实很简单,幸福真的离自己不远...",[38,48,49],{},"\"士兵\"好像真的开始被大家关注?谁的终点?谁的起程?谁的颠峰?谁的曲径?不重要,因为是\"因\"而不是\"果\",还没到真的最后,我们同在路上...",[38,51,52],{},"放上音乐只想分享,想你们懂,懂我的那部分柔软.温情放大数倍也许是滥情?也许不是.什么才是生命的名字?体验?也许不是...别人笑我太疯癫?但还是觉得看不穿的是多数是众人...",[38,54,55],{},"因为失去过些许,仰或是自愿放弃,或不是.才会越发觉得旧情弥足珍贵,就算灰尘在身上久了,也会侵入到肌肤深植与骨髓溶化进血脉...",[38,57,58],{},"我本是个天真的人,有颗孩子的心,却左脚踩到地狱,右手勾握天堂...所以选择非常的活,无法停驻只能漂流,追寻美好也迷恋罪恶.嗜血又童贞,冷酷且温柔...心知无用.还是忍不住竭力拥抱那份虚无......",[38,60,61],{},"每个月的生理周期我的表现形式就是胡说八道,所以又开始了梦呓...谅解.睡了.所有生灵...晚安!",{"title":63,"searchDepth":64,"depth":64,"links":65},"",2,[],[6],"md",{"date":69},"2007-08-16 03:06",true,"\u002Fblog\u002Fblog_4af9831b010009we",{"title":33,"description":33},"blog_4af9831b010009we","blog\u002Fblog_4af9831b010009we",[76],"随笔\u002F感悟","N1jnkb5DCR3Er-7quo5mqKWcaK_DMvp3P7_3t9Wc7Ms",[79,84],{"title":80,"path":81,"stem":82,"children":-1,"slug":83},"晚不安","\u002Fblog\u002Fblog_4af9831b010009t5","blog\u002Fblog_4af9831b010009t5","blog_4af9831b010009t5",{"title":85,"path":86,"stem":87,"children":-1,"slug":88},"记录昨天下午的打赌","\u002Fblog\u002Fblog_4af9831b010009xd","blog\u002Fblog_4af9831b010009xd","blog_4af9831b010009xd",1793773698208]
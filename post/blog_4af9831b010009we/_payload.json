[{"data":1,"prerenderedAt":93},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":17,"blog-post-slug-blog_4af9831b010009we":34,"surround-blog_4af9831b010009we":82},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"latestBlog":18},[19,22,25,28,31],{"title":20,"slug":21},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":23,"slug":24},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":26,"slug":27},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":29,"slug":30},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":32,"slug":33},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":35,"title":36,"body":37,"categories":69,"description":70,"extension":71,"meta":72,"navigation":74,"path":75,"seo":76,"slug":77,"stem":78,"tags":79,"__hash__":81},"blog\u002Fblog\u002Fblog_4af9831b010009we.md","男人和女人不一样我和别人不一样的就是生理周期表现方式不一样",{"type":38,"value":39,"toc":65},"minimark",[40,44,47,50,53,56,59,62],[41,42,43],"p",{},"不知何故纸条箱就是打不开,成了顽固的哑巴.又是夜深?越夜越美丽?没脸没皮才是我的天赋异禀.其实.",[41,45,46],{},"昨天看了\"妈妈咪呀\"还成.但也许是自己的长大,没了最初看\"美女与野兽\"时的激情?怎么仿佛离戏剧舞台越来越远?还是压根就没近过?",[41,48,49],{},"收到了两份不远的礼物,很开心,感动...觉得美好其实很简单,幸福真的离自己不远...",[41,51,52],{},"\"士兵\"好像真的开始被大家关注?谁的终点?谁的起程?谁的颠峰?谁的曲径?不重要,因为是\"因\"而不是\"果\",还没到真的最后,我们同在路上...",[41,54,55],{},"放上音乐只想分享,想你们懂,懂我的那部分柔软.温情放大数倍也许是滥情?也许不是.什么才是生命的名字?体验?也许不是...别人笑我太疯癫?但还是觉得看不穿的是多数是众人...",[41,57,58],{},"因为失去过些许,仰或是自愿放弃,或不是.才会越发觉得旧情弥足珍贵,就算灰尘在身上久了,也会侵入到肌肤深植与骨髓溶化进血脉...",[41,60,61],{},"我本是个天真的人,有颗孩子的心,却左脚踩到地狱,右手勾握天堂...所以选择非常的活,无法停驻只能漂流,追寻美好也迷恋罪恶.嗜血又童贞,冷酷且温柔...心知无用.还是忍不住竭力拥抱那份虚无......",[41,63,64],{},"每个月的生理周期我的表现形式就是胡说八道,所以又开始了梦呓...谅解.睡了.所有生灵...晚安!",{"title":66,"searchDepth":67,"depth":67,"links":68},"",2,[],[6],"不知何故纸条箱就是打不开,成了顽固的哑巴.","md",{"date":73},"2007-08-16 03:06",true,"\u002Fblog\u002Fblog_4af9831b010009we",{"title":36,"description":70},"blog_4af9831b010009we","blog\u002Fblog_4af9831b010009we",[80],"随笔\u002F感悟","4wyMWcR6PmhJLaevdq-7l6BaLVadqaetotjBv3tr1F8",[83,88],{"title":84,"path":8
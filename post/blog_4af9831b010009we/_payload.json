[{"data":1,"prerenderedAt":152},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":76,"blog-post-slug-blog_4af9831b010009we":93,"surround-blog_4af9831b010009we":141},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":38,"meta":50,"navLinks":51,"perPage":16,"prevNextIsExcludeDate":71,"site_description":72,"site_name":73,"stem":74,"__hash__":75},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,26,32],{"text":23},"粉丝自制非官方站点｜素材版权归原权利人所有",{"text":25},"仅兴趣交流、无商业用途｜如有侵权请联系删除",{"text":27,"link":28},"查看",{"href":29,"text":30,"fa_class":31},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":33,"link":34},"如有任何疑问，欢迎",{"href":35,"text":36,"fa_class":37},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[39,42,45,47],{"href":40,"text":41},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":43,"text":44},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":46},"新浪微博备份(2009-2026)",{"href":48,"text":49},"https:\u002F\u002Fmzt999.github.io\u002Fportfolio-chensicheng1978","幕后作品集展示(2012-2026)",{},[52,57,61,65,69],{"path":53,"title":54,"target":55,"fa_class":56},"\u002F","博客首页","internal","fa-home",{"path":58,"title":59,"target":55,"fa_class":60},"\u002Fabout","关于","fa-user",{"path":62,"title":63,"target":55,"fa_class":64},"\u002Fpost","归档","fa-archive",{"path":66,"title":67,"target":55,"fa_class":68},"\u002Fgallery","相册","fa-image",{"path":29,"title":30,"target":70,"fa_class":31},"otherSite",false,"新浪博客内容备份(粉丝自用)","陈思诚的博客","settings","5S7xKt0XLHpkjipbomx4I7pUu50Y7wqtD418LquZj5Q",{"latestBlog":77},[78,81,84,87,90],{"title":79,"slug":80},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":82,"slug":83},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":85,"slug":86},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":88,"slug":89},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":91,"slug":92},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":94,"title":95,"body":96,"categories":128,"description":129,"extension":130,"meta":131,"navigation":133,"path":134,"seo":135,"slug":136,"stem":137,"tags":138,"__hash__":140},"blog\u002Fblog\u002Fblog_4af9831b010009we.md","男人和女人不一样我和别人不一样的就是生理周期表现方式不一样",{"type":97,"value":98,"toc":124},"minimark",[99,103,106,109,112,115,118,121],[100,101,102],"p",{},"不知何故纸条箱就是打不开,成了顽固的哑巴.又是夜深?越夜越美丽?没脸没皮才是我的天赋异禀.其实.",[100,104,105],{},"昨天看了\"妈妈咪呀\"还成.但也许是自己的长大,没了最初看\"美女与野兽\"时的激情?怎么仿佛离戏剧舞台越来越远?还是压根就没近过?",[100,107,108],{},"收到了两份不远的礼物,很开心,感动...觉得美好其实很简单,幸福真的离自己不远...",[100,110,111],{},"\"士兵\"好像真的开始被大家关注?谁的终点?谁的起程?谁的颠峰?谁的曲径?不重要,因为是\"因\"而不是\"果\",还没到真的最后,我们同在路上...",[100,113,114],{},"放上音乐只想分享,想你们懂,懂我的那部分柔软.温情放大数倍也许是滥情?也许不是.什么才是生命的名字?体验?也许不是...别人笑我太疯癫?但还是觉得看不穿的是多数是众人...",[100,116,117],{},"因为失去过些许,仰或是自愿放弃,或不是.才会越发觉得旧情弥足珍贵,就算灰尘在身上久了,也会侵入到肌肤深植与骨髓溶化进血脉...",[100,119,120],{},"我本是个天真的人,有颗孩子的心,却左脚踩到地狱,右手勾握天堂...所以选择非常的活,无法停驻只能漂流,追寻美好也迷恋罪恶.嗜血又童贞,冷酷且温柔...心知无用.还是忍不住竭力拥抱那份虚无......",[100,122,123],{},"每个月的生理周期我的表现形式就是胡说八道,所以又开始了梦呓...谅解.睡了.所有生灵...晚安!",{"title":125,"searchDepth":126,"depth":126,"links":127},"",2,[],[6],"不知何故纸条箱就是打不开,成了顽固的哑巴.","md",{"date":132},"2007-08-16 03:06",true,"\u002Fblog\u002Fblog_4af9831b010009we",{"title":95,"description":129},"blog_4af9831b010009we","blog\u002Fblog_4af9831b010009we",[139],"随笔\u002F感悟","4wyMWcR6PmhJLaevdq-7l6BaLVadqaetotjBv3tr1F8",[142,147],{"title":143,"path":144,"stem":145,"children":-1,"slug":146},"晚不安","\u002Fblog\u002Fblog_4af9831b010009t5","blog\u002Fblog_4af9831b010009t5","blog_4af9831b010009t5",{"title":148,"path":149,"stem":150,"children":-1,"slug":151},"记录昨天下午的打赌","\u002Fblog\u002Fblog_4af9831b010009xd","blog\u002Fblog_4af9831b010009xd","blog_4af9831b010009xd",1795162026129]
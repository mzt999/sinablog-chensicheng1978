[{"data":1,"prerenderedAt":146},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":70,"blog-post-slug-blog_4af9831b010009we":87,"surround-blog_4af9831b010009we":135},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":45,"navLinks":46,"perPage":16,"prevNextIsExcludeDate":66,"site_description":23,"site_name":67,"stem":68,"__hash__":69},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{},[47,52,56,60,64],{"path":48,"title":49,"target":50,"fa_class":51},"\u002F","博客首页","internal","fa-home",{"path":53,"title":54,"target":50,"fa_class":55},"\u002Fabout","关于","fa-user",{"path":57,"title":58,"target":50,"fa_class":59},"\u002Fpost","归档","fa-archive",{"path":61,"title":62,"target":50,"fa_class":63},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":65,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","jvZHccz2rT-wjVS5GCPgWyhl8WnBIvECPkE5KpKFKCU",{"latestBlog":71},[72,75,78,81,84],{"title":73,"slug":74},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":76,"slug":77},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":79,"slug":80},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":82,"slug":83},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":85,"slug":86},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":88,"title":89,"body":90,"categories":122,"description":123,"extension":124,"meta":125,"navigation":127,"path":128,"seo":129,"slug":130,"stem":131,"tags":132,"__hash__":134},"blog\u002Fblog\u002Fblog_4af9831b010009we.md","男人和女人不一样我和别人不一样的就是生理周期表现方式不一样",{"type":91,"value":92,"toc":118},"minimark",[93,97,100,103,106,109,112,115],[94,95,96],"p",{},"不知何故纸条箱就是打不开,成了顽固的哑巴.又是夜深?越夜越美丽?没脸没皮才是我的天赋异禀.其实.",[94,98,99],{},"昨天看了\"妈妈咪呀\"还成.但也许是自己的长大,没了最初看\"美女与野兽\"时的激情?怎么仿佛离戏剧舞台越来越远?还是压根就没近过?",[94,101,102],{},"收到了两份不远的礼物,很开心,感动...觉得美好其实很简单,幸福真的离自己不远...",[94,104,105],{},"\"士兵\"好像真的开始被大家关注?谁的终点?谁的起程?谁的颠峰?谁的曲径?不重要,因为是\"因\"而不是\"果\",还没到真的最后,我们同在路上...",[94,107,108],{},"放上音乐只想分享,想你们懂,懂我的那部分柔软.温情放大数倍也许是滥情?也许不是.什么才是生命的名字?体验?也许不是...别人笑我太疯癫?但还是觉得看不穿的是多数是众人...",[94,110,111],{},"因为失去过些许,仰或是自愿放弃,或不是.才会越发觉得旧情弥足珍贵,就算灰尘在身上久了,也会侵入到肌肤深植与骨髓溶化进血脉...",[94,113,114],{},"我本是个天真的人,有颗孩子的心,却左脚踩到地狱,右手勾握天堂...所以选择非常的活,无法停驻只能漂流,追寻美好也迷恋罪恶.嗜血又童贞,冷酷且温柔...心知无用.还是忍不住竭力拥抱那份虚无......",[94,116,117],{},"每个月的生理周期我的表现形式就是胡说八道,所以又开始了梦呓...谅解.睡了.所有生灵...晚安!",{"title":119,"searchDepth":120,"depth":120,"links":121},"",2,[],[6],"不知何故纸条箱就是打不开,成了顽固的哑巴.","md",{"date":126},"2007-08-16 03:06",true,"\u002Fblog\u002Fblog_4af9831b010009we",{"title":89,"description":123},"blog_4af9831b010009we","blog\u002Fblog_4af9831b010009we",[133],"随笔\u002F感悟","4wyMWcR6PmhJLaevdq-7l6BaLVadqaetotjBv3tr1F8",[136,141],{"title":137,"path":138,"stem":139,"children":-1,"slug":140},"晚不安","\u002Fblog\u002Fblog_4af9831b010009t5","blog\u002Fblog_4af9831b010009t5","blog_4af9831b010009t5",{"title":142,"path":143,"stem":144,"children":-1,"slug":145},"记录昨天下午的打赌","\u002Fblog\u002Fblog_4af9831b010009xd","blog\u002Fblog_4af9831b010009xd","blog_4af9831b010009xd",1794544667974]
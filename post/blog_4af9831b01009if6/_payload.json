[{"data":1,"prerenderedAt":170},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":70,"blog-post-slug-blog_4af9831b01009if6":87,"surround-blog_4af9831b01009if6":159},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":45,"navLinks":46,"perPage":16,"prevNextIsExcludeDate":66,"site_description":23,"site_name":67,"stem":68,"__hash__":69},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{},[47,52,56,60,64],{"path":48,"title":49,"target":50,"fa_class":51},"\u002F","博客首页","internal","fa-home",{"path":53,"title":54,"target":50,"fa_class":55},"\u002Fabout","关于","fa-user",{"path":57,"title":58,"target":50,"fa_class":59},"\u002Fpost","归档","fa-archive",{"path":61,"title":62,"target":50,"fa_class":63},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":65,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","jvZHccz2rT-wjVS5GCPgWyhl8WnBIvECPkE5KpKFKCU",{"latestBlog":71},[72,75,78,81,84],{"title":73,"slug":74},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":76,"slug":77},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":79,"slug":80},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":82,"slug":83},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":85,"slug":86},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":88,"title":89,"body":90,"categories":147,"description":96,"extension":148,"meta":149,"navigation":151,"path":152,"seo":153,"slug":154,"stem":155,"tags":156,"__hash__":158},"blog\u002Fblog\u002Fblog_4af9831b01009if6.md","节日快乐,孩子...",{"type":91,"value":92,"toc":143},"minimark",[93,97,100,103,106,109,112,115,118,121,124,127,134,137,140],[94,95,96],"p",{},"生平的第一次客串演出本作十足准备交给\"团长\",但碍于人情,明天至后面的一个星期要先交给另一个电视剧.所以说世事难料.",[94,98,99],{},"还好是在北京,不远.",[94,101,102],{},"还好是演别人儿子,不难.",[94,104,105],{},"第一次觉得今天这个节日尤其重要.所以一定要来看看你们,我爱的人们.",[94,107,108],{},"今天是我们的节日,对吧?",[94,110,111],{},"突想,以后每年的今天都该大操大办比新年比圣诞甚至比生日都该更甚!至死方休!",[94,113,114],{},"一个人,当过孩子不牛X,牛X的是永远当孩子,永远长不大,更牛X的是还永远有爸有妈有小朋友!永远有人陪,永远有人宠,永远有人爱!最最牛X的是还永远有梦想,永远打不败!永远拿童话当理想,拿现实当故事,拿游戏当生活,拿假当真.......长此以往,持之以恒,你就是,伟人!",[94,116,117],{},"我是个孩子.万幸,现在还是.",[94,119,120],{},"但也怕,也诚惶诚恐,怕那个孩子从我心里溜走...",[94,122,123],{},"一直觉得自己不够成熟,时间久了,才明白这本是天赋,是神赐.才会珍惜!但事情总是这样,明白可贵的时候,也就是离失去不远了...所以才,怕...",[94,125,126],{},"数天前,几个可爱的孩子作了件可爱的事,为了别的孩子.因为那里的孩子在遭受更多的苦难.虽然他们还是孩子,有的甚至还在上学,但是他们把感动留在了2008,留在了汶川孩子们的身边,更把感动留给了我...",[94,128,129,130],{},"他们的名字很怪很可爱,因为他们都是孩子:猫眼纽扣,HOUHOU999,恰恰,VIOLAC,唐唐,小水滴,阿飞,38,欣欣,YICHUNLSN,苹果爱思成,天上云海边花,183,霖霈,橙思思,炫之爱,惟橙家族...虽然由于组织的原因,仅三天的时间,这个活动就截止了.但是他们依旧用\"橙汁\"的名义给灾区的孩子募集了几千元钱,橙子在这里谢谢你们!感谢你们的爱心!更感谢你们如孩子般的赤子之情!为你敬一个军礼!!",[131,132],"img",{"alt":89,"src":133},"\u002Fpic\u002F001.gif",[94,135,136],{},"今天,是我们的节日,虽然它即将过去,但请为天下所有的孩子们祈福.因为,我相信,童心不仅是唯一可于岁月抗争的武器,更是真情所至的人类精神的理想家园.",[94,138,139],{},"此刻,如果,你的身体里还藏着个总喜欢踮起脚,闪动着好奇眼神四处翘盼喜欢小恶作剧却又脆弱善良如玻璃般透明的孩子...",[94,141,142],{},"那么,请好好爱他......",{"title":144,"searchDepth":145,"depth":145,"links":146},"",2,[],[6],"md",{"date":150},"2008-06-01 23:37",true,"\u002Fblog\u002Fblog_4af9831b01009if6",{"title":89,"description":96},"blog_4af9831b01009if6","blog\u002Fblog_4af9831b01009if6",[157],"杂谈","iqi3YQTDj9awThuTWUTYHgpFiNMngD9bg4zkMag3yYc",[160,165],{"title":161,"path":162,"stem":163,"children":-1,"slug":164},"做点什么？你们？","\u002Fblog\u002Fblog_4af9831b01009b6q","blog\u002Fblog_4af9831b01009b6q","blog_4af9831b01009b6q",{"title":166,"path":167,"stem":168,"children":-1,"slug":169},"女人","\u002Fblog\u002Fblog_4af9831b01009net","blog\u002Fblog_4af9831b01009net","blog_4af9831b01009net",1794546769778]
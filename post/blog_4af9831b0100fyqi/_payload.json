":89,"body":90,"categories":140,"description":105,"extension":141,"meta":142,"navigation":144,"path":145,"seo":146,"slug":147,"stem":148,"tags":149,"__hash__":151},"blog\u002Fblog\u002Fblog_4af9831b0100fyqi.md","尘缘",{"type":91,"value":92,"toc":136},"minimark",[93,97,100,103,106,109,112,115,118,121,124,127,130,133],[94,95,96],"p",{},"夜了。",[94,98,99],{},"搜狗的拼音无影无踪。",[94,101,102],{},"有点颓……",[94,104,105],{},"听着新歌“尘缘”，百感交集……",[94,107,108],{},"娱乐圈……！",[94,110,111],{},"但还是挺好听的……有画面的音乐。",[94,113,114],{},"此刻，我在海南。",[94,116,117],{},"见了几个故人，有张翻译。",[94,119,120],{},"其实没几年，怎么就成了故人了？",[94,122,123],{},"我们在路上，我们还没老……",[94,125,126],{},"告诉你一个秘密，我不是没有牢骚了，",[94,128,129],{},"我只是把牢骚化零为整准备整理出个故事了……",[94,131,132],{},"听着“尘缘”……",[94,134,135],{},"真的挺牛X的，就以她为题，做个纪念吧。",{"title":137,"searchDepth":138,"depth":138,"links":139},"",2,[],[12],"md",{"date":143},"2009-11-18 03:30",true,"\u002Fblog\u002Fblog_4af9831b0100fyqi",{"title":89,"description":105},"blog_4af9831b0100fyqi","blog\u002Fblog_4af9831b0100fyqi",[150],"杂谈","tUY1oDSXw_gwjYryMu8AHcRjTCeNz2PStxsU1ukHgb0",[153,158],{"title":154,"path":155,"stem":156,"children":-1,"slug":157},"无题1","\u002Fblog\u002Fblog_4af9831b0100ffuh","blog\u002Fblog_4af9831b0100ffuh","blog_4af9831b0100ffuh",{"title":159,"path":160,"stem":161,"children":-1,"slug":162},"光影话流年","\u002Fblog\u002Fblog_4af9831b0100gfnc","blog\u002Fblog_4af9831b0100gfnc","blog_4af9831b0100gfnc",1794546769548]
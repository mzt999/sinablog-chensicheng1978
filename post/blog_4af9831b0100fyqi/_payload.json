,"p",{},"夜了。",[82,86,87],{},"搜狗的拼音无影无踪。",[82,89,90],{},"有点颓……",[82,92,93],{},"听着新歌“尘缘”，百感交集……",[82,95,96],{},"娱乐圈……！",[82,98,99],{},"但还是挺好听的……有画面的音乐。",[82,101,102],{},"此刻，我在海南。",[82,104,105],{},"见了几个故人，有张翻译。",[82,107,108],{},"其实没几年，怎么就成了故人了？",[82,110,111],{},"我们在路上，我们还没老……",[82,113,114],{},"告诉你一个秘密，我不是没有牢骚了，",[82,116,117],{},"我只是把牢骚化零为整准备整理出个故事了……",[82,119,120],{},"听着“尘缘”……",[82,122,123],{},"真的挺牛X的，就以她为题，做个纪念吧。",{"title":125,"searchDepth":126,"depth":126,"links":127},"",2,[],[12],"md",{"date":131},"2009-11-18 03:30",true,"\u002Fblog\u002Fblog_4af9831b0100fyqi",{"title":77,"description":93},"blog_4af9831b0100fyqi","blog\u002Fblog_4af9831b0100fyqi",[138],"杂谈","tUY1oDSXw_gwjYryMu8AHcRjTCeNz2PStxsU1ukHgb0",[141,146],{"title":142,"path":143,"stem":144,"children":-1,"slug":145},"无题1","\u002Fblog\u002Fblog_4af9831b0100ffuh","blog\u002Fblog_4af9831b0100ffuh","blog_4af9831b0100ffuh",{"title":147,"path":148,"stem":149,"children":-1,"slug":150},"光影话流年","\u002Fblog\u002Fblog_4af9831b0100gfnc","blog\u002Fblog_4af9831b0100gfnc","blog_4af9831b0100gfnc",1794412500487]
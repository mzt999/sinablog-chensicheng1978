},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":88,"slug":89},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":91,"slug":92},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":94,"title":95,"body":96,"categories":146,"description":111,"extension":147,"meta":148,"navigation":150,"path":151,"seo":152,"slug":153,"stem":154,"tags":155,"__hash__":157},"blog\u002Fblog\u002Fblog_4af9831b0100fyqi.md","尘缘",{"type":97,"value":98,"toc":142},"minimark",[99,103,106,109,112,115,118,121,124,127,130,133,136,139],[100,101,102],"p",{},"夜了。",[100,104,105],{},"搜狗的拼音无影无踪。",[100,107,108],{},"有点颓……",[100,110,111],{},"听着新歌“尘缘”，百感交集……",[100,113,114],{},"娱乐圈……！",[100,116,117],{},"但还是挺好听的……有画面的音乐。",[100,119,120],{},"此刻，我在海南。",[100,122,123],{},"见了几个故人，有张翻译。",[100,125,126],{},"其实没几年，怎么就成了故人了？",[100,128,129],{},"我们在路上，我们还没老……",[100,131,132],{},"告诉你一个秘密，我不是没有牢骚了，",[100,134,135],{},"我只是把牢骚化零为整准备整理出个故事了……",[100,137,138],{},"听着“尘缘”……",[100,140,141],{},"真的挺牛X的，就以她为题，做个纪念吧。",{"title":143,"searchDepth":144,"depth":144,"links":145},"",2,[],[12],"md",{"date":149},"2009-11-18 03:30",true,"\u002Fblog\u002Fblog_4af9831b0100fyqi",{"title":95,"description":111},"blog_4af9831b0100fyqi","blog\u002Fblog_4af9831b0100fyqi",[156],"杂谈","tUY1oDSXw_gwjYryMu8AHcRjTCeNz2PStxsU1ukHgb0",[159,164],{"title":160,"path":161,"stem":162,"children":-1,"slug":163},"无题1","\u002Fblog\u002Fblog_4af9831b0100ffuh","blog\u002Fblog_4af9831b0100ffuh","blog_4af9831b0100ffuh",{"title":165,"path":166,"stem":167,"children":-1,"slug":168},"光影话流年","\u002Fblog\u002Fblog_4af9831b0100gfnc","blog\u002Fblog_4af9831b0100gfnc","blog_4af9831b0100gfnc",1795162025698]
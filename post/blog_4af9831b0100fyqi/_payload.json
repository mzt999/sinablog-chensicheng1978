3],"p",{},"夜了。",[81,85,86],{},"搜狗的拼音无影无踪。",[81,88,89],{},"有点颓……",[81,91,92],{},"听着新歌“尘缘”，百感交集……",[81,94,95],{},"娱乐圈……！",[81,97,98],{},"但还是挺好听的……有画面的音乐。",[81,100,101],{},"此刻，我在海南。",[81,103,104],{},"见了几个故人，有张翻译。",[81,106,107],{},"其实没几年，怎么就成了故人了？",[81,109,110],{},"我们在路上，我们还没老……",[81,112,113],{},"告诉你一个秘密，我不是没有牢骚了，",[81,115,116],{},"我只是把牢骚化零为整准备整理出个故事了……",[81,118,119],{},"听着“尘缘”……",[81,121,122],{},"真的挺牛X的，就以她为题，做个纪念吧。",{"title":124,"searchDepth":125,"depth":125,"links":126},"",2,[],[12],"md",{"date":130},"2009-11-18 03:30",true,"\u002Fblog\u002Fblog_4af9831b0100fyqi",{"title":76,"description":92},"blog_4af9831b0100fyqi","blog\u002Fblog_4af9831b0100fyqi",[137],"杂谈","tUY1oDSXw_gwjYryMu8AHcRjTCeNz2PStxsU1ukHgb0",[140,145],{"title":141,"path":142,"stem":143,"children":-1,"slug":144},"无题1","\u002Fblog\u002Fblog_4af9831b0100ffuh","blog\u002Fblog_4af9831b0100ffuh","blog_4af9831b0100ffuh",{"title":146,"path":147,"stem":148,"children":-1,"slug":149},"光影话流年","\u002Fblog\u002Fblog_4af9831b0100gfnc","blog\u002Fblog_4af9831b0100gfnc","blog_4af9831b0100gfnc",1794473705151]
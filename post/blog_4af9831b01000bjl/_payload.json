[{"data":1,"prerenderedAt":156},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":17,"blog-post-slug-blog_4af9831b01000bjl":34,"surround-blog_4af9831b01000bjl":145},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"latestBlog":18},[19,22,25,28,31],{"title":20,"slug":21},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":23,"slug":24},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":26,"slug":27},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":29,"slug":30},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":32,"slug":33},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":35,"title":36,"body":37,"categories":130,"description":75,"extension":131,"meta":132,"navigation":134,"path":135,"seo":136,"slug":137,"stem":138,"tags":139,"__hash__":144},"blog\u002Fblog\u002Fblog_4af9831b01000bjl.md","士兵\"突击\"艺术人生",{"type":38,"value":39,"toc":126},"minimark",[40,49,55,61,67,73,76,81,84,89,92,97,100,105,108,111,114,117,120,123],[41,42,43],"p",{},[44,45],"a",{"href":46,"rel":47},"http:\u002F\u002Falbum.sina.com.cn\u002Fpic\u002F4af9831b020018pw",[48],"nofollow",[41,50,51],{},[44,52],{"href":53,"rel":54},"http:\u002F\u002Falbum.sina.com.cn\u002Fpic\u002F4af9831b020018px",[48],[41,56,57],{},[44,58],{"href":59,"rel":60},"http:\u002F\u002Falbum.sina.com.cn\u002Fpic\u002F4af9831b020018py",[48],[41,62,63],{},[44,64],{"href":65,"rel":66},"http:\u002F\u002Falbum.sina.com.cn\u002Fpic\u002F4af9831b020018pz",[48],[41,68,69],{},[70,71],"img",{"alt":36,"src":72},"\u002Fpic\u002F4af9831b020018pv.jpg",[41,74,75],{},"对于我们此次的\"艺术\"绝不是\"人生\"的\"总结\"而是\"开始\"!",[41,77,78],{},[70,79],{"alt":36,"src":80},"\u002Fpic\u002F4af9831b020018pw.jpg",[41,82,83],{},"朱哥也是\"突迷\" + \"士兵之父\"笑得如此可爱的\"康师傅\"导演康红雷 +\n\"士兵之母\"鬼才编剧\"249\"兰小龙",[41,85,86],{},[70,87],{"alt":36,"src":88},"\u002Fpic\u002F4af9831b020018px.jpg",[41,90,91],{},"＂下榕树＂这两个老乡啊!一个苯得像猪,一个精得像鬼!",[41,93,94],{},[70,95],{"alt":36,"src":96},"\u002Fpic\u002F4af9831b020018py.jpg",[41,98,99],{},"不抛弃!不放弃!所以我们叫 - 钢七连!",[41,101,102],{},[70,103],{"alt":36,"src":104},"\u002Fpic\u002F4af9831b020018pz.jpg",[41,106,107],{},"老7在现场说得对!你们才是\"士兵\"的上帝!感谢所有全国的铁杆\"突迷\"!!!",[41,109,110],{},"　\n　从小我有一个伟大的理想！就是加入光荣的＂艺术人生＂！前晚（１１月７日）这个理想居然提前若干年到来了？！",[41,112,113],{},"　　　　＂艺术人生＂的重大战略调整，不只作总结性的感悟性的＂人生＂也作萌芽状态的正热正话题的＂人生＂！＂士兵＂有幸成为了第一个受惠者。",[41,115,116],{},"　　　　＂士兵突击＂真的火了。所有的身边的人亲戚朋友各行各业圈内圈外不分老幼性别阶级甚至种族的人都在谈论它。“凤凰卫视”称“士兵”为　“中国第一部上升到哲学与信仰层面的电视剧”！就连“台军”也称——如果剧情属实，那么“士兵”们让他们汗颜！",[41,118,119],{},"　　　　当然属实！通过拍摄和接触我甚至要说，其实我们所扮演的“士兵”还远不及我们中国真正的士兵更可爱！更勇敢！更奉献！他们！真的是当之无愧的“最可爱的人”！此刻的我们正在分享他们的荣耀，是我们的幸运！",[41,121,122],{},"　　　　兄弟们，加油吧！“士兵突击”是我们的起跑！导演和２４９只是为我们吹响了“集结号”打响了“号令枪”后面更长的路在等着我们！我们的竞赛也才刚刚开始！２８日播出的“艺术人生”是我们“人生”的新起点！期望若干年后，“士兵”们可以带着更多的好作品，更多的鲜活人物及更丰厚的阅历再次聚首“艺术人生”！携手“朱哥”和“众突迷”再次共回首，同笑谈，忆当年！那该是怎样的一翻光景？",[41,124,125],{},"　　　　恰同学少年，风华正茂……正是好时节！不抛弃！不放弃！“士兵”们请将“突击”进行到底！！！",{"title":127,"searchDepth":128,"depth":128,"links":129},"",2,[],[6,9],"md",{"date":133},"2007-11-09 13:40",true,"\u002Fblog\u002Fblog_4af9831b01000bjl",{"title":36,"description":75},"blog_4af9831b01000bjl","blog\u002Fblog_4af9831b01000bjl",[140,141,142,143],"影评\u002F乐评","士兵突击","电视剧","康红雷","QwCUYrLiy-1_nZdEspcHAYf5UKcKYITqIvhSo9dtrzg",[146,151],{"title":147,"path":148,"stem":149,"children":-1,"slug":150},"北京的冬天","\u002Fblog\u002Fblog_4af9831b01000bfv","blog\u002Fblog_4af9831b01000bfv","blog_4af9831b01000bfv",{"title":152,"path":153,"stem":154,"children":-1,"slug":155},"王婆卖瓜","\u002Fblog\u002Fblog_4af9831b01000blk","blog\u002Fblog_4af9831b01000blk","blog_4af9831b01000blk",1794059573920]
[{"data":1,"prerenderedAt":87},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b010007ba":31,"surround-blog_4af9831b010007ba":76},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",152,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":65,"description":33,"extension":66,"meta":67,"navigation":69,"path":70,"seo":71,"slug":72,"stem":73,"tags":74,"__hash__":75},"blog\u002Fblog\u002Fblog_4af9831b010007ba.md","顿悟",{"type":35,"value":36,"toc":61},"minimark",[37,42,45,48,51,58],[38,39,41],"p",{"style":40},"color:red;","新年马上就来了!还有不到一个小时!知道此刻所有的你们都在和家人团聚!那就祝愿所有看过这文章的人都在新年幸福安康吧!",[38,43,44],{"style":40},"火锅早吃过了,那天我们几个聊到了凌晨4点钟.我口中最多的一个词就该是\"顿悟\"吧!自己真的该长大了...",[38,46,47],{"style":40},"看到好多留言很开心很感动,谢谢你们我的朋友们!由于今天时间的原因没有一一回复请见谅!",[38,49,50],{"style":40},"能在2006年结识你们真的很好,希望明年的此刻还能再见你们...",[38,52,53,54],{"style":40},"新年的钟声就要响起,我们很快就要沦陷在烟花爆竹的声浪火海中,此刻的我有着从未有过的平静...着地了,这种感觉很好...我一直想飞,但忽略了走的重要...从新开始吧,就从这一刻...写给自己...",[55,56],"img",{"alt":33,"title":33,"src":57},"\u002Fpic\u002F001.gif",[38,59,60],{"style":40},"大家都要快乐啊!好好活着...活着挺好的...真的很好.",{"title":62,"searchDepth":63,"depth":63,"links":64},"",2,[],[6],"md",{"date":68},"2007-02-17 23:12",true,"\u002Fblog\u002Fblog_4af9831b010007ba",{"title":33,"description":33},"blog_4af9831b010007ba","blog\u002Fblog_4af9831b010007ba",[],"m8YK5cuXYq-sBektdUj-eCwBssxR872e_XIiRZ-T434",[77,82],{"title":78,"path":79,"stem":80,"children":-1,"slug":81},"部分影视作品片花","\u002Fblog\u002Fblog_4af9831b01000783","blog\u002Fblog_4af9831b01000783","blog_4af9831b01000783",{"title":83,"path":84,"stem":85,"children":-1,"slug":86},"拜年","\u002
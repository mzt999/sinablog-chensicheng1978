[{"data":1,"prerenderedAt":86},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b010007ba":31,"surround-blog_4af9831b010007ba":75},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",151,{"name":9,"len":10},"有图",34,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":64,"description":33,"extension":65,"meta":66,"navigation":68,"path":69,"seo":70,"slug":71,"stem":72,"tags":73,"__hash__":74},"blog\u002Fblog\u002Fblog_4af9831b010007ba.md","顿悟",{"type":35,"value":36,"toc":60},"minimark",[37,41,44,47,50,57],[38,39,40],"p",{},"新年马上就来了!还有不到一个小时!知道此刻所有的你们都在和家人团聚!那就祝愿所有看过这文章的人都在新年幸福安康吧!",[38,42,43],{},"火锅早吃过了,那天我们几个聊到了凌晨4点钟.我口中最多的一个词就该是\"顿悟\"吧!自己真的该长大了...",[38,45,46],{},"看到好多留言很开心很感动,谢谢你们我的朋友们!由于今天时间的原因没有一一回复请见谅!",[38,48,49],{},"能在2006年结识你们真的很好,希望明年的此刻还能再见你们...",[38,51,52,53],{},"新年的钟声就要响起,我们很快就要沦陷在烟花爆竹的声浪火海中,此刻的我有着从未有过的平静...着地了,这种感觉很好...我一直想飞,但忽略了走的重要...从新开始吧,就从这一刻...写给自己...",[54,55],"img",{"alt":33,"src":56},"\u002Fpic\u002F001.gif",[38,58,59],{},"大家都要快乐啊!好好活着...活着挺好的...真的很好.",{"title":61,"searchDepth":62,"depth":62,"links":63},"",2,[],[6],"md",{"date":67},"2007-02-17 23:12",true,"\u002Fblog\u002Fblog_4af9831b010007ba",{"title":33,"description":33},"blog_4af9831b010007ba","blog\u002Fblog_4af9831b010007ba",[],"NNcTNXA7CWD-GsFt3ANbIvirNScBLoQtWtO-pz_gx5E",[76,81],{"title":77,"path":78,"stem":79,"children":-1,"slug":80},"部分影视作品片花","\u002Fblog\u002Fblog_4af9831b01000783","blog\u002Fblog_4af9831b01000783","blog_4af9831b01000783",{"title":82,"path":83,"stem":84,"children":-1,"slug":85},"拜年","\u002Fblog\u002Fblog_4af9831b010007bf","blog\u002Fblog_4af9831b010007bf","blog_4af9831b01
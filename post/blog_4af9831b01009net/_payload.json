[{"data":1,"prerenderedAt":160},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":73,"blog-post-slug-blog_4af9831b01009net":90,"surround-blog_4af9831b01009net":149},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"footer":21,"friendSites":36,"meta":48,"navLinks":49,"perPage":16,"prevNextIsExcludeDate":69,"site_description":23,"site_name":70,"stem":71,"__hash__":72},"settings\u002Fsettings.yml","陈思诚","yml",[22,24,30],{"text":23},"新浪博客内容备份(粉丝自用)",{"text":25,"link":26},"查看",{"href":27,"text":28,"fa_class":29},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","微博备份","fa-weibo",{"text":31,"link":32},"如有任何疑问，欢迎",{"href":33,"text":34,"fa_class":35},"https:\u002F\u002Fwj.qq.com\u002Fs2\u002F14668810\u002Fd2da\u002F","联系我","fa-external-link",[37,40,43,45],{"href":38,"text":39},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":41,"text":42},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":27,"text":44},"新浪微博备份(2009-2026)",{"href":46,"text":47},"https:\u002F\u002Fmzt999.github.io\u002Fportfolio-chensicheng1978","幕后作品集展示(2012-2026)",{},[50,55,59,63,67],{"path":51,"title":52,"target":53,"fa_class":54},"\u002F","博客首页","internal","fa-home",{"path":56,"title":57,"target":53,"fa_class":58},"\u002Fabout","关于","fa-user",{"path":60,"title":61,"target":53,"fa_class":62},"\u002Fpost","归档","fa-archive",{"path":64,"title":65,"target":53,"fa_class":66},"\u002Fgallery","相册","fa-image",{"path":27,"title":28,"target":68,"fa_class":29},"otherSite",false,"陈思诚的博客","settings","LA_7Y82F2zjQ6-R2_tcWHl356krYL76uqQHBCIU8UZk",{"latestBlog":74},[75,78,81,84,87],{"title":76,"slug":77},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":79,"slug":80},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":82,"slug":83},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":85,"slug":86},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":88,"slug":89},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":91,"title":92,"body":93,"categories":137,"description":108,"extension":138,"meta":139,"navigation":141,"path":142,"seo":143,"slug":144,"stem":145,"tags":146,"__hash__":148},"blog\u002Fblog\u002Fblog_4af9831b01009net.md","女人",{"type":94,"value":95,"toc":133},"minimark",[96,100,103,106,109,112,115,118,121,124,127,130],[97,98,99],"p",{},"近期不冷静,综合因素导致.亢奋,浮躁,反正不靠谱,自己.",[97,101,102],{},"从一个博客连到另一个,音乐响起\u003C无底洞>.好听...",[97,104,105],{},"冲动缘自片刻,突然想说点什么...女人.",[97,107,108],{},"地球上最可爱动物=女人",[97,110,111],{},"今天又悟到了点什么,本人对女性最深度热爱的出处居然和王朔老师相同:那便是,女人:敏感,细腻,善良,感性多于男人,心计少于,受伤多于男人,伤人少于......我说的是概率,同类别急...这些话只说给她们,这世界最美的精灵...女人.",[97,113,114],{},"所以,和她们接触可以拥有的交流比较本质,总体透明,可以少于设防,多于侵略,可以用心言说多过用脑,用情交流大过用声...反正就是比较占便宜(人类阴暗心里的又一集中体现)...谁让你们好欺负?女人?",[97,116,117],{},"冲动,我写博客的唯一目的,宣泄?或者别的?感动?我今天比较感动,源自一个女人的博客.一个内外相悖形神不统的女人...明早三呆子约我去打靶,本该睡了,但还是想说点什么...女人?",[97,119,120],{},"真的有本事,要送你们每人一台时光机,女人!",[97,122,123],{},"可以在你们的婚前与婚后,少女与母亲,热恋与心碎,青春与孤寂中自如穿梭游走...喜欢吗?女人...",[97,125,126],{},"我的背景音乐该加上这\u003C无底洞>了,它和这片文出奇的贴配!奇怪,爱予你们真的是无底洞?女人?",[97,128,129],{},"生命本就是如此,任谁都是一样.所以别哭,女人.",[97,131,132],{},"祝福你们,女人.......",{"title":134,"searchDepth":135,"depth":135,"links":136},"",2,[],[6],"md",{"date":140},"2008-06-14 02:11",true,"\u002Fblog\u002Fblog_4af9831b01009net",{"title":92,"description":108},"blog_4af9831b01009net","blog\u002Fblog_4af9831b01009net",[147],"杂谈","0uYZZDheA76mCBKu2GIopdt2aNn2DPvOCvOvAOFBFsI",[150,155],{"title":151,"path":152,"stem":153,"children":-1,"slug":154},"节日快乐,孩子...","\u002Fblog\u002Fblog_4af9831b01009if6","blog\u002Fblog_4af9831b01009if6","blog_4af9831b01009if6",{"title":156,"path":157,"stem":158,"children":-1,"slug":159},"注定","\u002Fblog\u002Fblog_4af9831b01009v9r","blog\u002Fblog_4af9831b01009v9r","blog_4af9831b01009v9r",1794760532063]
[{"data":1,"prerenderedAt":104},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":17,"blog-post-slug-blog_4af9831b01009net":34,"surround-blog_4af9831b01009net":93},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"latestBlog":18},[19,22,25,28,31],{"title":20,"slug":21},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":23,"slug":24},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":26,"slug":27},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":29,"slug":30},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":32,"slug":33},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":35,"title":36,"body":37,"categories":81,"description":52,"extension":82,"meta":83,"navigation":85,"path":86,"seo":87,"slug":88,"stem":89,"tags":90,"__hash__":92},"blog\u002Fblog\u002Fblog_4af9831b01009net.md","女人",{"type":38,"value":39,"toc":77},"minimark",[40,44,47,50,53,56,59,62,65,68,71,74],[41,42,43],"p",{},"近期不冷静,综合因素导致.亢奋,浮躁,反正不靠谱,自己.",[41,45,46],{},"从一个博客连到另一个,音乐响起\u003C无底洞>.好听...",[41,48,49],{},"冲动缘自片刻,突然想说点什么...女人.",[41,51,52],{},"地球上最可爱动物=女人",[41,54,55],{},"今天又悟到了点什么,本人对女性最深度热爱的出处居然和王朔老师相同:那便是,女人:敏感,细腻,善良,感性多于男人,心计少于,受伤多于男人,伤人少于......我说的是概率,同类别急...这些话只说给她们,这世界最美的精灵...女人.",[41,57,58],{},"所以,和她们接触可以拥有的交流比较本质,总体透明,可以少于设防,多于侵略,可以用心言说多过用脑,用情交流大过用声...反正就是比较占便宜(人类阴暗心里的又一集中体现)...谁让你们好欺负?女人?",[41,60,61],{},"冲动,我写博客的唯一目的,宣泄?或者别的?感动?我今天比较感动,源自一个女人的博客.一个内外相悖形神不统的女人...明早三呆子约我去打靶,本该睡了,但还是想说点什么...女人?",[41,63,64],{},"真的有本事,要送你们每人一台时光机,女人!",[41,66,67],{},"可以在你们的婚前与婚后,少女与母亲,热恋与心碎,青春与孤寂中自如穿梭游走...喜欢吗?女人...",[41,69,70],{},"我的背景音乐该加上这\u003C无底洞>了,它和这片文出奇的贴配!奇怪,爱予你们真的是无底洞?女人?",[41,72,73],{},"生命本就是如此,任谁都是一样.所以别哭,女人.",[41,75,76],{},"祝福你们,女人.......",{"title":78,"searchDepth":79,"depth":79,"links":80},"",2,[],[6],"md",{"date":84},"2008-06-14 02:11",true,"\u002Fblog\u002Fblog_4af9831b01009net",{"title":36,"description":52},"blog_4af9831b01009net","blog\u002Fblog_4af9831b01009net",[91],"杂谈","0uYZZDheA76mCBKu2GIopdt2aNn2DPvOCvOvAOFBFsI",[94,99],{"title":95,"path":96,"stem":97,"children":-1,"slug":98},"节日快乐,孩子...","\u002Fblog\u002Fblog_4af9831b01009if6","blog\u002Fblog_4af9831b01009if6","blog_4af9831b01009if6",{"title":100,"path":101,"stem":102,"children":-1,"slug":103},"注定","\u002Fblog\u002Fblog_4af9831b01009v9r","blog\u002Fblog_4af9831b01009v9r","blog_4af9831b01009v9r",1794049610868]
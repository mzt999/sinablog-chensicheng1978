[{"data":1,"prerenderedAt":144},["ShallowReactive",2],{"aside-categories":3,"settings":17,"aside-latestBlog":57,"blog-post-slug-blog_4af9831b01009net":74,"surround-blog_4af9831b01009net":133},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"id":18,"author_name":19,"extension":20,"friendSites":21,"meta":31,"navLinks":32,"perPage":16,"site_description":54,"stem":55,"__hash__":56},"settings\u002Fsettings.yml","陈思诚","yml",[22,25,28],{"href":23,"text":24},"https:\u002F\u002Fblog.sina.com.cn\u002Fu\u002F1257866011","新浪博客(停更于2010年)",{"href":26,"text":27},"https:\u002F\u002Fweibo.com\u002Fu\u002F1257866011","新浪微博(半年可见)",{"href":29,"text":30},"https:\u002F\u002Fmzt999.github.io\u002Fweibo-chensicheng1978","新浪微博备份(2009-2026)",{},[33,38,42,46,50],{"path":34,"title":35,"target":36,"fa_class":37},"\u002F","博客首页","internal","fa-home",{"path":39,"title":40,"target":36,"fa_class":41},"\u002Fabout","关于","fa-user",{"path":43,"title":44,"target":36,"fa_class":45},"\u002Fpost","归档","fa-archive",{"path":47,"title":48,"target":36,"fa_class":49},"\u002Fgallery","相册","fa-image",{"path":29,"title":51,"target":52,"fa_class":53},"微博备份","otherSite","fa-weibo","新浪博客内容备份(粉丝自用)","settings","jPD1QWrYwbaIixg6lntppEYe-T3ZGd3EJZxFBkbKY9E",{"latestBlog":58},[59,62,65,68,71],{"title":60,"slug":61},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":63,"slug":64},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":66,"slug":67},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":69,"slug":70},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":72,"slug":73},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":75,"title":76,"body":77,"categories":121,"description":92,"extension":122,"meta":123,"navigation":125,"path":126,"seo":127,"slug":128,"stem":129,"tags":130,"__hash__":132},"blog\u002Fblog\u002Fblog_4af9831b01009net.md","女人",{"type":78,"value":79,"toc":117},"minimark",[80,84,87,90,93,96,99,102,105,108,111,114],[81,82,83],"p",{},"近期不冷静,综合因素导致.亢奋,浮躁,反正不靠谱,自己.",[81,85,86],{},"从一个博客连到另一个,音乐响起\u003C无底洞>.好听...",[81,88,89],{},"冲动缘自片刻,突然想说点什么...女人.",[81,91,92],{},"地球上最可爱动物=女人",[81,94,95],{},"今天又悟到了点什么,本人对女性最深度热爱的出处居然和王朔老师相同:那便是,女人:敏感,细腻,善良,感性多于男人,心计少于,受伤多于男人,伤人少于......我说的是概率,同类别急...这些话只说给她们,这世界最美的精灵...女人.",[81,97,98],{},"所以,和她们接触可以拥有的交流比较本质,总体透明,可以少于设防,多于侵略,可以用心言说多过用脑,用情交流大过用声...反正就是比较占便宜(人类阴暗心里的又一集中体现)...谁让你们好欺负?女人?",[81,100,101],{},"冲动,我写博客的唯一目的,宣泄?或者别的?感动?我今天比较感动,源自一个女人的博客.一个内外相悖形神不统的女人...明早三呆子约我去打靶,本该睡了,但还是想说点什么...女人?",[81,103,104],{},"真的有本事,要送你们每人一台时光机,女人!",[81,106,107],{},"可以在你们的婚前与婚后,少女与母亲,热恋与心碎,青春与孤寂中自如穿梭游走...喜欢吗?女人...",[81,109,110],{},"我的背景音乐该加上这\u003C无底洞>了,它和这片文出奇的贴配!奇怪,爱予你们真的是无底洞?女人?",[81,112,113],{},"生命本就是如此,任谁都是一样.所以别哭,女人.",[81,115,116],{},"祝福你们,女人.......",{"title":118,"searchDepth":119,"depth":119,"links":120},"",2,[],[6],"md",{"date":124},"2008-06-14 02:11",true,"\u002Fblog\u002Fblog_4af9831b01009net",{"title":76,"description":92},"blog_4af9831b01009net","blog\u002Fblog_4af9831b01009net",[131],"杂谈","0uYZZDheA76mCBKu2GIopdt2aNn2DPvOCvOvAOFBFsI",[134,139],{"title":135,"path":136,"stem":137,"children":-1,"slug":138},"节日快乐,孩子...","\u002Fblog\u002Fblog_4af9831b01009if6","blog\u002Fblog_4af9831b01009if6","blog_4af9831b01009if6",{"title":140,"path":141,"stem":142,"children":-1,"slug":143},"注定","\u002Fblog\u002Fblog_4af9831b01009v9r","blog\u002Fblog_4af9831b01009v9r","blog_4af9831b01009v9r",1794473705370]
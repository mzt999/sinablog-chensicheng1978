[{"data":1,"prerenderedAt":101},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":14,"blog-post-slug-blog_4af9831b01009net":31,"surround-blog_4af9831b01009net":90},{"categories":4},[5,8,11],{"name":6,"len":7},"默认",151,{"name":9,"len":10},"有图",34,{"name":12,"len":13},"我的小说",9,{"latestBlog":15},[16,19,22,25,28],{"title":17,"slug":18},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":20,"slug":21},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":23,"slug":24},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":26,"slug":27},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":29,"slug":30},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":32,"title":33,"body":34,"categories":78,"description":33,"extension":79,"meta":80,"navigation":82,"path":83,"seo":84,"slug":85,"stem":86,"tags":87,"__hash__":89},"blog\u002Fblog\u002Fblog_4af9831b01009net.md","女人",{"type":35,"value":36,"toc":74},"minimark",[37,41,44,47,50,53,56,59,62,65,68,71],[38,39,40],"p",{},"近期不冷静,综合因素导致.亢奋,浮躁,反正不靠谱,自己.",[38,42,43],{},"从一个博客连到另一个,音乐响起\u003C无底洞>.好听...",[38,45,46],{},"冲动缘自片刻,突然想说点什么...女人.",[38,48,49],{},"地球上最可爱动物=女人",[38,51,52],{},"今天又悟到了点什么,本人对女性最深度热爱的出处居然和王朔老师相同:那便是,女人:敏感,细腻,善良,感性多于男人,心计少于,受伤多于男人,伤人少于......我说的是概率,同类别急...这些话只说给她们,这世界最美的精灵...女人.",[38,54,55],{},"所以,和她们接触可以拥有的交流比较本质,总体透明,可以少于设防,多于侵略,可以用心言说多过用脑,用情交流大过用声...反正就是比较占便宜(人类阴暗心里的又一集中体现)...谁让你们好欺负?女人?",[38,57,58],{},"冲动,我写博客的唯一目的,宣泄?或者别的?感动?我今天比较感动,源自一个女人的博客.一个内外相悖形神不统的女人...明早三呆子约我去打靶,本该睡了,但还是想说点什么...女人?",[38,60,61],{},"真的有本事,要送你们每人一台时光机,女人!",[38,63,64],{},"可以在你们的婚前与婚后,少女与母亲,热恋与心碎,青春与孤寂中自如穿梭游走...喜欢吗?女人...",[38,66,67],{},"我的背景音乐该加上这\u003C无底洞>了,它和这片文出奇的贴配!奇怪,爱予你们真的是无底洞?女人?",[38,69,70],{},"生命本就是如此,任谁都是一样.所以别哭,女人.",[38,72,73],{},"祝福你们,女人.......",{"title":75,"searchDepth":76,"depth":76,"links":77},"",2,[],[6],"md",{"date":81},"2008-06-14 02:11",true,"\u002Fblog\u002Fblog_4af9831b01009net",{"title":33,"description":33},"blog_4af9831b01009net","blog\u002Fblog_4af9831b01009net",[88],"杂谈","i7CHDLBOTiW92wTxdq83N4AJBIMcKPPIomQjIG_9zCI",[91,96],{"title":92,"path":93,"stem":94,"children":-1,"slug":95},"节日快乐,孩子...","\u002Fblog\u002Fblog_4af9831b01009if6","blog\u002Fblog_4af9831b01009if6","blog_4af9831b01009if6",{"title":97,"path":98,"stem":99,"children":-1,"slug":100},"注定","\u002Fblog\u002Fblog_4af9831b01009v9r","blog\u002Fblog_4af9831b01009v9r","blog_4af9831b01009v9r",1793775558330]
[{"data":1,"prerenderedAt":138},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":17,"blog-post-slug-blog_4af9831b01000acv":34,"surround-blog_4af9831b01000acv":127},{"categories":4},[5,8,11,14],{"name":6,"len":7},"默认",146,{"name":9,"len":10},"有图",35,{"name":12,"len":13},"我的音乐",6,{"name":15,"len":16},"我的小说",10,{"latestBlog":18},[19,22,25,28,31],{"title":20,"slug":21},"请把暑期档留给快乐和孩子……","blog_4af9831b0100kdse",{"title":23,"slug":24},"所谓自由！！！！！！！！","blog_4af9831b0100kany",{"title":26,"slug":27},"爱，那颗幸福的子弹","blog_4af9831b0100j000",{"title":29,"slug":30},"为“失去”我曾难过的一晚……","blog_4af9831b0100i4l0",{"title":32,"slug":33},"“陈导”为华哥喝彩！","blog_4af9831b0100i0mz",{"id":35,"title":36,"body":37,"categories":114,"description":49,"extension":115,"meta":116,"navigation":118,"path":119,"seo":120,"slug":121,"stem":122,"tags":123,"__hash__":126},"blog\u002Fblog\u002Fblog_4af9831b01000acv.md","沈阳",{"type":38,"value":39,"toc":110},"minimark",[40,47,50,55,58,63,66,71,74,77,80,83,86,89,92,95,98,101,104,107],[41,42,43],"p",{},[44,45],"img",{"alt":36,"src":46},"\u002Fpic\u002F4af9831b020015rc.jpg",[41,48,49],{},"愿天庇佑沈阳……",[41,51,52],{},[44,53],{"alt":36,"src":54},"\u002Fpic\u002F4af9831b020015rf.jpg",[41,56,57],{},"下一站“何处”",[41,59,60],{},[44,61],{"alt":36,"src":62},"\u002Fpic\u002F4af9831b020015rd.jpg",[41,64,65],{},"妹妹的婚礼，祝她永远幸福……",[41,67,68],{},[44,69],{"alt":36,"src":70},"\u002Fpic\u002F4af9831b020015re.jpg",[41,72,73],{},"永远在路上……",[41,75,76],{},"外婆的离去几乎带走了我对沈阳的最后一丝留恋。",[41,78,79],{},"如同弃婴般对母体没有任何的感动，很奇怪我对生我养我的这座城市，总感觉语焉不详。",[41,81,82],{},"没有感觉，无关好坏。甚至下午在去机场的路上透过取景框中擦身景物的渐行渐远竟会感受种意外的恍惚：是否我真的在此生活了16年？",[41,84,85],{},"那些记忆，及记忆中的那些人都成了碎片飘散在风中。脱离了我的意志完全成了个体，飘荡在这城市的上空踪影难寻……",[41,87,88],{},"沈阳。我的城市。我的童年。我的梦。",[41,90,91],{},"印象中的沈阳，工厂林立，空中总是浮着薄雾般的灰质。全国的重工业中心，那时的沈阳人为此付出了全部的自己。",[41,93,94],{},"总有副画面出现眼前：那是冬天，天总是黑得早。妈妈下班的时候，天已漆黑。污雪制造的泥泞，深刺骨髓的寒冷……妈妈骑着她的单车穿梭于这个阴冷的城市，从工厂到家，日复一日……那时的她，总是我的温暖，我的港湾，我的坚强……",[41,96,97],{},"今天，妈妈苍老了。变得不再那么坚强，变得需要我去照顾……人总会老去，可脑海中那个画面永远清晰，因为那时的我总在企盼，盼望着那个风雪中的人快点回来，为我做饭。每次不管她的辛劳，总是第一时间的抢过她手里的包去翻里面是否存在惊喜……那个女人，我的妈妈，她已经和从前的沈阳紧紧地联系在一处，无从剥离。",[41,99,100],{},"如今，这城市变得面目全非。几乎再也找不到从前的影子。我在怀疑，是否我的那些故事真的曾上演在这里？那些人是否真的出现过？",[41,102,103],{},"总是觉得。",[41,105,106],{},"沈阳。不该是这个样子。该是我梦里的样子。",[41,108,109],{},"梦里的样子……",{"title":111,"searchDepth":112,"depth":112,"links":113},"",2,[],[6,9],"md",{"date":117},"2007-09-23 23:00",true,"\u002Fblog\u002Fblog_4af9831b01000acv",{"title":36,"description":49},"blog_4af9831b01000acv","blog\u002Fblog_4af9831b01000acv",[124,125],"随笔\u002F感悟","感悟随笔","JrDvVSkest5GqPqb3W7vOzgy5QicOfQOKK6tsLY95rw",[128,133],{"title":129,"path":130,"stem":131,"children":-1,"slug":132},"错爱","\u002Fblog\u002Fblog_4af9831b01000a9u","blog\u002Fblog_4af9831b01000a9u","blog_4af9831b01000a9u",{"title":134,"path":135,"stem":136,"children":-1,"slug":137},"回信1","\u002Fblog\u002Fblog_4af9831b01000acx","blog\u002Fblog_4af9831b01000acx","blog_4af9831b01000acx",1794059574027]